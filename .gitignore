# Browser release build outputs.
/dist/
# Downloaded originals already have canonical course sources; keep local imports and media out of Git.
/data/courses/*/imports/
/data/courses/*/repair/media/
# Generated bilingual .ass exports; rebuild with export_ass.py.
/data/courses/*/subtitles-ass/
# Scratch translation batches, zh maps and per-lecture result files; regenerate with the scripts.
/work/
/data/courses/*/work/
# Signed XPI output from web-ext; rebuild with `npx web-ext sign`.
/web-ext-artifacts/
# Local editor/agent checkpoints.
/.cursor/
