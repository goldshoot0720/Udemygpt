{
  "version": 1,
  "courseId": 4958062,
  "courseSlug": "remix-course",
  "courseTitle": "Remix.js - The Practical Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "34676092",
      "title": "Disabling JavaScript For Some Pages",
      "lectureOrder": 109,
      "videoOrder": 102,
      "sourceHash": "fdc3f67f23c47179960ca793c370eee81d8ab8abf43aface7231f2c563427981",
      "cues": [
        {
          "id": 1,
          "start": 2.04,
          "end": 4.74,
          "en": "So headers are another important topic",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.74,
          "end": 6.09,
          "en": "especially when it comes to",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.09,
          "end": 9.18,
          "en": "preparing your application for deployment.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.18,
          "end": 10.013,
          "en": "Now with that",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.013,
          "end": 13.08,
          "en": "we're now almost ready to deploy this application",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.08,
          "end": 15.69,
          "en": "and see the deployment process in action.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 15.69,
          "end": 16.89,
          "en": "But before we do that",
          "zh": ""
        },
        {
          "id": 8,
          "start": 16.89,
          "end": 19.39,
          "en": "there is one other thing we should take a look at.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 20.49,
          "end": 22.68,
          "en": "In the application we build thus far",
          "zh": ""
        },
        {
          "id": 10,
          "start": 22.68,
          "end": 25.47,
          "en": "we embraced many web standards.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 25.47,
          "end": 26.34,
          "en": "As you can tell",
          "zh": ""
        },
        {
          "id": 12,
          "start": 26.34,
          "end": 27.99,
          "en": "responses, requests,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 27.99,
          "end": 30.87,
          "en": "many things that are supported out of the box",
          "zh": ""
        },
        {
          "id": 14,
          "start": 30.87,
          "end": 33.99,
          "en": "by the browser and by note JS.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 33.99,
          "end": 37.44,
          "en": "And due to that many pages in our application",
          "zh": ""
        },
        {
          "id": 16,
          "start": 37.44,
          "end": 39.9,
          "en": "also work without JavaScript.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 39.9,
          "end": 41.46,
          "en": "For example home and pricing,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 41.46,
          "end": 43.62,
          "en": "we don't need to JavaScript on these pages",
          "zh": ""
        },
        {
          "id": 19,
          "start": 43.62,
          "end": 45.66,
          "en": "we have some static content here.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 45.66,
          "end": 46.95,
          "en": "And because that's the case",
          "zh": ""
        },
        {
          "id": 21,
          "start": 46.95,
          "end": 50.61,
          "en": "we could disable JavaScript for these pages.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 50.61,
          "end": 53.73,
          "en": "The advantage would be that if we visit those pages",
          "zh": ""
        },
        {
          "id": 23,
          "start": 53.73,
          "end": 56.07,
          "en": "and we take a look at our network tab again,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 56.07,
          "end": 59.52,
          "en": "we don't have to download all these JavaScript files",
          "zh": ""
        },
        {
          "id": 25,
          "start": 59.52,
          "end": 60.543,
          "en": "which you see here.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 61.41,
          "end": 62.94,
          "en": "These files are downloaded",
          "zh": ""
        },
        {
          "id": 27,
          "start": 62.94,
          "end": 65.04,
          "en": "because after the initial request,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 65.04,
          "end": 67.2,
          "en": "we're back in a single page application",
          "zh": ""
        },
        {
          "id": 29,
          "start": 67.2,
          "end": 68.64,
          "en": "and these files are needed",
          "zh": ""
        },
        {
          "id": 30,
          "start": 68.64,
          "end": 71.43,
          "en": "to run that single page application.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 71.43,
          "end": 73.53,
          "en": "But of course, if we would not load them",
          "zh": ""
        },
        {
          "id": 32,
          "start": 73.53,
          "end": 75.87,
          "en": "the page could be served even faster.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 75.87,
          "end": 78.78,
          "en": "We would avoid unnecessary downloads",
          "zh": ""
        },
        {
          "id": 34,
          "start": 78.78,
          "end": 81.75,
          "en": "and therefore ensure that users don't need",
          "zh": ""
        },
        {
          "id": 35,
          "start": 81.75,
          "end": 85.44,
          "en": "to download data they don't need right now.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 85.44,
          "end": 88.83,
          "en": "And best of all, the application would continue to work",
          "zh": ""
        },
        {
          "id": 37,
          "start": 88.83,
          "end": 93,
          "en": "at least on these pages because links would still work.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 93,
          "end": 95.34,
          "en": "They would just send a new request instead",
          "zh": ""
        },
        {
          "id": 39,
          "start": 95.34,
          "end": 98.34,
          "en": "of staying in the single page application world.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 98.34,
          "end": 100.62100000000001,
          "en": "So instead of navigating to a new page",
          "zh": ""
        },
        {
          "id": 41,
          "start": 100.62100000000001,
          "end": 105.09,
          "en": "without sending a new request for a new HTML document",
          "zh": ""
        },
        {
          "id": 42,
          "start": 105.09,
          "end": 107.22,
          "en": "we would simply send a request that leads",
          "zh": ""
        },
        {
          "id": 43,
          "start": 107.22,
          "end": 110.31,
          "en": "to a new HTML document being served back.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 110.31,
          "end": 112.2,
          "en": "But that's not the end of the world.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 112.2,
          "end": 113.4,
          "en": "And for those reasons,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 113.4,
          "end": 116.52000000000001,
          "en": "we might want to disable JavaScript for pages",
          "zh": ""
        },
        {
          "id": 47,
          "start": 116.52000000000001,
          "end": 117.75,
          "en": "where we don't need it",
          "zh": ""
        },
        {
          "id": 48,
          "start": 117.75,
          "end": 120.36,
          "en": "so that the unnecessary JavaScript to downloads",
          "zh": ""
        },
        {
          "id": 49,
          "start": 120.36,
          "end": 121.473,
          "en": "can be avoided.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 122.52,
          "end": 125.043,
          "en": "But how do we disable JavaScript?",
          "zh": ""
        },
        {
          "id": 51,
          "start": 126,
          "end": 129.3,
          "en": "Well, in your route JSX file, you got this main",
          "zh": ""
        },
        {
          "id": 52,
          "start": 129.3,
          "end": 133.2,
          "en": "document where you find this scripts component.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 133.2,
          "end": 135.51,
          "en": "This in the end is the place where Remix",
          "zh": ""
        },
        {
          "id": 54,
          "start": 135.51,
          "end": 138.06,
          "en": "in the end injects all these script tags",
          "zh": ""
        },
        {
          "id": 55,
          "start": 138.06,
          "end": 141.69,
          "en": "that lead to script files being downloaded.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 141.69,
          "end": 146.37,
          "en": "If you remove that and you save your project",
          "zh": ""
        },
        {
          "id": 57,
          "start": 146.37,
          "end": 148.59,
          "en": "you can therefore still visit those pages",
          "zh": ""
        },
        {
          "id": 58,
          "start": 148.59,
          "end": 150.27,
          "en": "and still navigate between them.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 150.27,
          "end": 152.46,
          "en": "But now you will simply have new requests",
          "zh": ""
        },
        {
          "id": 60,
          "start": 152.46,
          "end": 153.9,
          "en": "that are sent around.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 153.9,
          "end": 155.43,
          "en": "If I open my network tab",
          "zh": ""
        },
        {
          "id": 62,
          "start": 155.43,
          "end": 157.26,
          "en": "and I reload here on the homepage,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 157.26,
          "end": 159.72,
          "en": "we should see that we have no JavaScript files",
          "zh": ""
        },
        {
          "id": 64,
          "start": 159.72,
          "end": 161.37,
          "en": "being downloaded.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 161.37,
          "end": 163.68,
          "en": "Now, if I navigate to a different page like pricing",
          "zh": ""
        },
        {
          "id": 66,
          "start": 163.68,
          "end": 165.06,
          "en": "that might change",
          "zh": ""
        },
        {
          "id": 67,
          "start": 165.06,
          "end": 168.03,
          "en": "because we have a cached version of this page",
          "zh": ""
        },
        {
          "id": 68,
          "start": 168.03,
          "end": 168.99,
          "en": "in our browser,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 168.99,
          "end": 170.4,
          "en": "and that cached version still",
          "zh": ""
        },
        {
          "id": 70,
          "start": 170.4,
          "end": 173.46,
          "en": "includes all these JavaScript references",
          "zh": ""
        },
        {
          "id": 71,
          "start": 173.46,
          "end": 175.74,
          "en": "and therefore these files gets downloaded.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 175.74,
          "end": 179.01,
          "en": "But this did not happen for the initial homepage.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 179.01,
          "end": 181.05,
          "en": "So if we disable scripts here",
          "zh": ""
        },
        {
          "id": 74,
          "start": 181.05,
          "end": 183.69,
          "en": "that could save us these extra downloads.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 183.69,
          "end": 186,
          "en": "But of course, in general, we want scripts here",
          "zh": ""
        },
        {
          "id": 76,
          "start": 186,
          "end": 188.58,
          "en": "because we have pages that do rely",
          "zh": ""
        },
        {
          "id": 77,
          "start": 188.58,
          "end": 190.71,
          "en": "on client site java script code",
          "zh": ""
        },
        {
          "id": 78,
          "start": 190.71,
          "end": 193.83,
          "en": "because they need it for some client side logic.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 193.83,
          "end": 196.07999999999998,
          "en": "So generally removing scripts here",
          "zh": ""
        },
        {
          "id": 80,
          "start": 196.07999999999998,
          "end": 198.72,
          "en": "is probably not the solution.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 198.72,
          "end": 201.32999999999998,
          "en": "But what is a solution is to simply find out",
          "zh": ""
        },
        {
          "id": 82,
          "start": 201.32999999999998,
          "end": 206.22,
          "en": "on a per page basis whether a page needs JavaScript or not.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 206.22,
          "end": 207.84,
          "en": "And what is useful for that",
          "zh": ""
        },
        {
          "id": 84,
          "start": 207.84,
          "end": 212.84,
          "en": "is an extra value that you can export in your route files.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 212.85,
          "end": 217.85,
          "en": "So not a function, but a simple constant called handle.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 217.98,
          "end": 219.963,
          "en": "And it must be called handle.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 220.89,
          "end": 224.07,
          "en": "Handle then allows you to store arbitrary data",
          "zh": ""
        },
        {
          "id": 88,
          "start": 224.07,
          "end": 224.97,
          "en": "in this constant,",
          "zh": ""
        },
        {
          "id": 89,
          "start": 224.97,
          "end": 228.48,
          "en": "like for example an object with a disabled JS field",
          "zh": ""
        },
        {
          "id": 90,
          "start": 228.48,
          "end": 229.98,
          "en": "that's set to true.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 229.98,
          "end": 232.68,
          "en": "Now the value here is entirely up to you though",
          "zh": ""
        },
        {
          "id": 92,
          "start": 232.68,
          "end": 234.39,
          "en": "as is this name here.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 234.39,
          "end": 238.77,
          "en": "This could also be, do not use JavaScript.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 238.77,
          "end": 240.51,
          "en": "It's really up to you.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 240.51,
          "end": 243.21,
          "en": "But here I'll go with disabled JS.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 243.21,
          "end": 246.27,
          "en": "This is essentially some extra data which you can attach",
          "zh": ""
        },
        {
          "id": 97,
          "start": 246.27,
          "end": 247.47,
          "en": "to your routes",
          "zh": ""
        },
        {
          "id": 98,
          "start": 247.47,
          "end": 250.38,
          "en": "and I'll attach it here on the index JSX file",
          "zh": ""
        },
        {
          "id": 99,
          "start": 250.38,
          "end": 252.87,
          "en": "and on pricing JSX.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 252.87,
          "end": 255.72,
          "en": "So these two routes have this extra data attached.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 255.72,
          "end": 257.433,
          "en": "The other routes do not.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 258.78,
          "end": 261.12,
          "en": "Now, what's the use of this extra data?",
          "zh": ""
        },
        {
          "id": 103,
          "start": 261.12,
          "end": 263.19,
          "en": "Well, you can get access to it",
          "zh": ""
        },
        {
          "id": 104,
          "start": 263.19,
          "end": 266.46,
          "en": "with help of the useMatches hook.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 266.46,
          "end": 267.69,
          "en": "This gives you a list",
          "zh": ""
        },
        {
          "id": 106,
          "start": 267.69,
          "end": 269.94,
          "en": "of all the routes that are currently active",
          "zh": ""
        },
        {
          "id": 107,
          "start": 269.94,
          "end": 271.26,
          "en": "and for every route",
          "zh": ""
        },
        {
          "id": 108,
          "start": 271.26,
          "end": 274.26,
          "en": "it gives you not just a loader data of that route,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 274.26,
          "end": 277.413,
          "en": "but also this handle data if there is any.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 278.25,
          "end": 279.6,
          "en": "So in the root component,",
          "zh": ""
        },
        {
          "id": 111,
          "start": 279.6,
          "end": 282.33,
          "en": "we can for example go to this document here,",
          "zh": ""
        },
        {
          "id": 112,
          "start": 282.33,
          "end": 286.83,
          "en": "so to this document component and call useMatches here.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 286.83,
          "end": 289.803,
          "en": "Of course, we must import useMatches for that.",
          "zh": ""
        },
        {
          "id": 114,
          "start": 291.18,
          "end": 295.38,
          "en": "Then here we get our matches as we did in the expense form",
          "zh": ""
        },
        {
          "id": 115,
          "start": 295.38,
          "end": 298.17,
          "en": "and we can then write some simple code",
          "zh": ""
        },
        {
          "id": 116,
          "start": 298.17,
          "end": 300.39,
          "en": "where we used the built in some method",
          "zh": ""
        },
        {
          "id": 117,
          "start": 300.39,
          "end": 302.25,
          "en": "on this matches array",
          "zh": ""
        },
        {
          "id": 118,
          "start": 302.25,
          "end": 304.8,
          "en": "to look through all match entries",
          "zh": ""
        },
        {
          "id": 119,
          "start": 304.8,
          "end": 309.69,
          "en": "and find if any entry for the currently active route",
          "zh": ""
        },
        {
          "id": 120,
          "start": 309.69,
          "end": 311.55,
          "en": "has this handle data.",
          "zh": ""
        },
        {
          "id": 121,
          "start": 311.55,
          "end": 313.68,
          "en": "So has this handle data defined",
          "zh": ""
        },
        {
          "id": 122,
          "start": 313.68,
          "end": 316.83299999999997,
          "en": "and then has this disabled JS field.",
          "zh": ""
        },
        {
          "id": 123,
          "start": 318.09,
          "end": 321,
          "en": "And that disabled JS field also must be true",
          "zh": ""
        },
        {
          "id": 124,
          "start": 321,
          "end": 323.943,
          "en": "for this overall method to return true.",
          "zh": ""
        },
        {
          "id": 125,
          "start": 325.17,
          "end": 326.46,
          "en": "Then we can store this",
          "zh": ""
        },
        {
          "id": 126,
          "start": 326.46,
          "end": 329.85,
          "en": "in a constant that could be called disabled JS.",
          "zh": ""
        },
        {
          "id": 127,
          "start": 329.85,
          "end": 332.13,
          "en": "And now this constant will hold true",
          "zh": ""
        },
        {
          "id": 128,
          "start": 332.13,
          "end": 333.99,
          "en": "if we are on a page",
          "zh": ""
        },
        {
          "id": 129,
          "start": 333.99,
          "end": 337.86,
          "en": "where any child route has disabled JS set",
          "zh": ""
        },
        {
          "id": 130,
          "start": 337.86,
          "end": 342.33299999999997,
          "en": "in its handle object and has a value of true in this value.",
          "zh": ""
        },
        {
          "id": 131,
          "start": 343.38,
          "end": 346.95,
          "en": "If we are on our route that does not have this handle",
          "zh": ""
        },
        {
          "id": 132,
          "start": 346.95,
          "end": 350.97,
          "en": "or that has the handle with disabled JS set to false",
          "zh": ""
        },
        {
          "id": 133,
          "start": 350.97,
          "end": 352.40999999999997,
          "en": "this would also be false here.",
          "zh": ""
        },
        {
          "id": 134,
          "start": 352.40999999999997,
          "end": 354.57,
          "en": "It's only true if we are on our route",
          "zh": ""
        },
        {
          "id": 135,
          "start": 354.57,
          "end": 357.72,
          "en": "that has this handle and has it set to true",
          "zh": ""
        },
        {
          "id": 136,
          "start": 357.72,
          "end": 360.663,
          "en": "as it's the case for pricing and index.",
          "zh": ""
        },
        {
          "id": 137,
          "start": 361.83,
