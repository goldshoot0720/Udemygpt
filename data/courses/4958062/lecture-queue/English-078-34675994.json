  "lectures": [
    {
      "id": "34675994",
      "title": "Practice Time - Solution",
      "lectureOrder": 84,
      "videoOrder": 78,
      "sourceHash": "a0bf1bc942a4dce37ef6b4a7f8e9138ca99319ed80dc31ec4daff954bace4b2e",
      "cues": [
        {
          "id": 1,
          "start": 2.46,
          "end": 4.53,
          "en": "So did you succeed?",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.53,
          "end": 6.57,
          "en": "Let's now solve this together.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.57,
          "end": 10.35,
          "en": "And for this, in expenses analysis dot jsx,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.35,
          "end": 14.58,
          "en": "I'll start by adding an async function called loader",
          "zh": ""
        },
        {
          "id": 5,
          "start": 14.58,
          "end": 17.79,
          "en": "because we need to load expenses data.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.79,
          "end": 20.16,
          "en": "Now here, we can't use the data loaded",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.16,
          "end": 23.01,
          "en": "in some parent component or parent route",
          "zh": ""
        },
        {
          "id": 8,
          "start": 23.01,
          "end": 26.31,
          "en": "because this doesn't have the expenses jsx file",
          "zh": ""
        },
        {
          "id": 9,
          "start": 26.31,
          "end": 27.69,
          "en": "as a parent route.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.69,
          "end": 30.3,
          "en": "It's a sibling to expenses jsx instead.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 30.3,
          "end": 32.94,
          "en": "So the data loaded in expenses jsx,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.94,
          "end": 37.413,
          "en": "is not available in expenses dot analysis dot jsx.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 38.25,
          "end": 42.543,
          "en": "So we have to fetch our expenses again for this page here.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 43.41,
          "end": 46.457,
          "en": "And we can do this by calling the get expenses function",
          "zh": ""
        },
        {
          "id": 15,
          "start": 46.457,
          "end": 48.93,
          "en": "which we already defined before",
          "zh": ""
        },
        {
          "id": 16,
          "start": 48.93,
          "end": 52.509,
          "en": "in the expenses dot server js file.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 52.509,
          "end": 56.64,
          "en": "We can also get rid of the dummy expenses, now, bey the way.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 56.64,
          "end": 58.65,
          "en": "So, I called get expenses",
          "zh": ""
        },
        {
          "id": 19,
          "start": 58.65,
          "end": 62.01,
          "en": "and with that I get my expenses here",
          "zh": ""
        },
        {
          "id": 20,
          "start": 62.01,
          "end": 65.013,
          "en": "and we can then return those expenses.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 65.94,
          "end": 68.85,
          "en": "We can, of course, also return a response",
          "zh": ""
        },
        {
          "id": 22,
          "start": 68.85,
          "end": 71.07,
          "en": "that wraps those expenses if you want to.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 71.07,
          "end": 72.167,
          "en": "But as mentioned earlier,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 72.167,
          "end": 75.75,
          "en": "Remix will automatically wrap the data for us",
          "zh": ""
        },
        {
          "id": 25,
          "start": 75.75,
          "end": 76.893,
          "en": "if we don't do that.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 78.18,
          "end": 81.24,
          "en": "So with that, we return the expenses.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 81.24,
          "end": 82.68,
          "en": "I also mentioned, though,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 82.68,
          "end": 84.9,
          "en": "that we want to throw an error or response",
          "zh": ""
        },
        {
          "id": 29,
          "start": 84.9,
          "end": 86.73,
          "en": "if no expenses were found.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 86.73,
          "end": 89.52,
          "en": "So, if we don't have expenses",
          "zh": ""
        },
        {
          "id": 31,
          "start": 89.52,
          "end": 94.52000000000001,
          "en": "or if expenses dot length is equal to zero,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 95.55,
          "end": 100.55,
          "en": "then in that case, I want to throw a response",
          "zh": ""
        },
        {
          "id": 33,
          "start": 101.34,
          "end": 103.71000000000001,
          "en": "by using this JSON function,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 103.71000000000001,
          "end": 107.283,
          "en": "which is imported from Remix run node.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 109.32,
          "end": 114.32,
          "en": "And here, we can pass a message where we maybe say",
          "zh": ""
        },
        {
          "id": 36,
          "start": 114.457,
          "end": 119.457,
          "en": "\"Could not load expenses for the requested analysis\"",
          "zh": ""
        },
        {
          "id": 37,
          "start": 119.91,
          "end": 123.42,
          "en": "or anything like this as a message, and then",
          "zh": ""
        },
        {
          "id": 38,
          "start": 123.42,
          "end": 127.38,
          "en": "configure this response to have a status code of 4 0 4",
          "zh": ""
        },
        {
          "id": 39,
          "start": 127.38,
          "end": 131.67,
          "en": "and a status text of \"expenses not found,\"",
          "zh": ""
        },
        {
          "id": 40,
          "start": 131.67,
          "end": 132.693,
          "en": "something like this.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 134.4,
          "end": 136.53,
          "en": "With that, we then want to make sure",
          "zh": ""
        },
        {
          "id": 42,
          "start": 136.53,
          "end": 140.1,
          "en": "that we use the expenses, if we have them, in our component",
          "zh": ""
        },
        {
          "id": 43,
          "start": 140.1,
          "end": 143.4,
          "en": "and that we show an appropriate catch boundary.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 143.4,
          "end": 146.07,
          "en": "Now let's start by using the expenses.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 146.07,
          "end": 147.893,
          "en": "For that, we can get our expenses here",
          "zh": ""
        },
        {
          "id": 46,
          "start": 147.893,
          "end": 151.14,
          "en": "by calling useLoaderData",
          "zh": ""
        },
        {
          "id": 47,
          "start": 151.14,
          "end": 156.14,
          "en": "and that should be imported from Remix Run React like this.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 160.07999999999998,
          "end": 162.72,
          "en": "And then we pass those expenses",
          "zh": ""
        },
        {
          "id": 49,
          "start": 162.72,
          "end": 165.633,
          "en": "to the chart and the expense statistics.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 167.49,
          "end": 168.9,
          "en": "Now, you'll see one problem.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 168.9,
          "end": 171.99,
          "en": "If I remove this if check in the loader temporarily,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 171.99,
          "end": 175.32,
          "en": "then if we have no expenses,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 175.32,
          "end": 179.13,
          "en": "we see quite meaningless statistics here.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 179.13,
          "end": 181.5,
          "en": "That's why instead, in that scenario,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 181.5,
          "end": 184.08,
          "en": "I want to throw my response,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 184.08,
          "end": 187.53,
          "en": "so that instead, I see this page here.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 187.53,
          "end": 190.44,
          "en": "And that's our default catch boundary defined",
          "zh": ""
        },
        {
          "id": 58,
          "start": 190.44,
          "end": 192.153,
          "en": "in the route jsx file.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 193.47,
          "end": 196.1,
          "en": "However, this is not really what I want to show here",
          "zh": ""
        },
        {
          "id": 60,
          "start": 196.1,
          "end": 198.69,
          "en": "because this kind of breaks our application.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 198.69,
          "end": 200.64,
          "en": "Again, the entire navigation is gone",
          "zh": ""
        },
        {
          "id": 62,
          "start": 200.64,
          "end": 203.433,
          "en": "and this is not too helpful, therefore.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 204.75,
          "end": 206.79,
          "en": "Now, we could again handle it here",
          "zh": ""
        },
        {
          "id": 64,
          "start": 206.79,
          "end": 209.85,
          "en": "in the component and show some alternative UI.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 209.85,
          "end": 213.21,
          "en": "But since I'm fine with replacing the entire UI,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 213.21,
          "end": 215.97,
          "en": "for this page, if we're missing data,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 215.97,
          "end": 220.68,
          "en": "I rather export my own catch boundary here",
          "zh": ""
        },
        {
          "id": 68,
          "start": 220.68,
          "end": 223.353,
          "en": "in this expenses analysis dot jsx file.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 224.22,
          "end": 226.95,
          "en": "And that will then be rendered by Remix",
          "zh": ""
        },
        {
          "id": 70,
          "start": 226.95,
          "end": 230.52,
          "en": "if we throw an error response here in this loader",
          "zh": ""
        },
        {
          "id": 71,
          "start": 230.52,
          "end": 233.49,
          "en": "or in any other nested loader if we had one,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 233.49,
          "end": 237.81,
          "en": "or any other nested route in general, if we had one.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 237.81,
          "end": 240.69,
          "en": "So here in this catch boundary,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 240.69,
          "end": 242.58,
          "en": "I'll then return a main block",
          "zh": ""
        },
        {
          "id": 75,
          "start": 242.58,
          "end": 245.43,
          "en": "where I then use my own error component",
          "zh": ""
        },
        {
          "id": 76,
          "start": 245.43,
          "end": 247.95,
          "en": "which is defined in the component's util folder",
          "zh": ""
        },
        {
          "id": 77,
          "start": 247.95,
          "end": 249.633,
          "en": "and which is imported from there.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 250.71,
          "end": 252.551,
          "en": "And then on this error component",
          "zh": ""
        },
        {
          "id": 79,
          "start": 252.551,
          "end": 255.54,
          "en": "I want to output some information.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 255.54,
          "end": 257.76,
          "en": "For that, I'll get my cart response",
          "zh": ""
        },
        {
          "id": 81,
          "start": 257.76,
          "end": 259.8,
          "en": "with help of use catch,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 259.8,
          "end": 263.223,
          "en": "which is also imported from Remix Run React.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 264.39,
          "end": 266.49,
          "en": "And here we can then set the title to",
          "zh": ""
        },
        {
          "id": 84,
          "start": 266.49,
          "end": 269.67,
          "en": "cart response dot status text.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 269.67,
          "end": 272.90999999999997,
          "en": "And between the error component text,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 272.90999999999997,
          "end": 274.175,
          "en": "I'll output a paragraph",
          "zh": ""
        },
        {
          "id": 87,
          "start": 274.175,
          "end": 278.64,
          "en": "where I'll output cart response dot data",
          "zh": ""
        },
        {
          "id": 88,
          "start": 278.64,
          "end": 282.09000000000003,
          "en": "dot message and add a question mark,",
          "zh": ""
        },
        {
          "id": 89,
          "start": 282.09000000000003,
          "end": 283.95,
          "en": "so that we don't throw an error",
          "zh": ""
        },
        {
          "id": 90,
          "start": 283.95,
          "end": 286.14300000000003,
          "en": "if data should be undefined.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 287.1,
          "end": 289.897,
          "en": "And then, show a fallback message of,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 289.897,
          "end": 294.65999999999997,
          "en": "\"Something went wrong - could not load expenses,\"",
          "zh": ""
        },
        {
          "id": 93,
          "start": 294.65999999999997,
          "end": 296.103,
          "en": "or whatever you like.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 297.33,
          "end": 300.12,
          "en": "And now this catch boundary will be used instead.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 300.12,
          "end": 302.1,
          "en": "And therefore, now, we got a pretty nice",
          "zh": ""
        },
        {
          "id": 96,
          "start": 302.1,
          "end": 306.72,
          "en": "user interface where if we visit this page without expenses,",
          "zh": ""
        },
        {
          "id": 97,
          "start": 306.72,
          "end": 309.39,
          "en": "we got this error, but the rest of the application",
          "zh": ""
        },
        {
          "id": 98,
          "start": 309.39,
          "end": 311.43,
          "en": "is fully functional.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 311.43,
          "end": 312.485,
          "en": "And of course, as soon as I start",
          "zh": ""
        },
        {
          "id": 100,
          "start": 312.485,
          "end": 315.243,
          "en": "adding some expenses again,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 316.8,
          "end": 320.04,
          "en": "all the works and I see my expense data here.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 320.04,
          "end": 322.26,
          "en": "So that was a nice practice, again",
          "zh": ""
        },
        {
          "id": 103,
          "start": 322.26,
          "end": 325.413,
          "en": "using a loader and some error handling.",
          "zh": ""
        }
      ]
    }
  ],
