        {
          "id": 3,
          "start": 6.96,
          "end": 10.71,
          "en": "and my public folder and my prisma folder.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.71,
          "end": 13.98,
          "en": "And if I had made any changes to remix.config.js",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.98,
          "end": 15.72,
          "en": "that file as well,",
          "zh": ""
        },
