          "en": "and signup mode, and we use our search parameters",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.39,
          "end": 11.88,
          "en": "our query parameters for that.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.88,
          "end": 14.97,
          "en": "Now we wanna focus on the signup mode first",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.97,
          "end": 18.48,
          "en": "on the signup logic on creating a user.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.48,
          "end": 20.4,
          "en": "And I will actually put the code",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.4,
          "end": 23.67,
          "en": "for creating a user into a separate file",
          "zh": ""
        },
        {
          "id": 9,
          "start": 23.67,
          "end": 26.82,
          "en": "just to keep things organized and separated.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 26.82,
          "end": 29.61,
          "en": "And I'll add a file in that data folder,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.61,
          "end": 33.343,
          "en": "and I'll name it, \"auth.server.js\",",
          "zh": ""
        },
        {
          "id": 12,
          "start": 33.343,
