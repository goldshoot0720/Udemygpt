      "sourceHash": "cf31502ffe702d3ee4d2e621cbd54550610d81171e0a0a78693613a47ccab5e1",
      "cues": [
        {
          "id": 1,
          "start": 2.07,
          "end": 3.18,
          "en": "Now to get started",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.18,
          "end": 5.76,
          "en": "with building a Remix application,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.76,
          "end": 8.82,
          "en": "we must create a new Remix project.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.82,
          "end": 10.62,
          "en": "And we do that with a command",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.62,
          "end": 13.65,
          "en": "we execute in the command line, in the terminal.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.65,
          "end": 16.92,
          "en": "And it does not matter which operating system you're using,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 16.92,
          "end": 18.48,
          "en": "the command is always the same",
          "zh": ""
        },
        {
          "id": 8,
          "start": 18.48,
          "end": 22.32,
          "en": "and you'll always build Remix applications in the same way.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.32,
          "end": 25.47,
          "en": "Now for this command, which we're about to execute,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 25.47,
          "end": 28.32,
          "en": "you must have node.js installed.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 28.32,
          "end": 31.68,
          "en": "And in general, you must have node.js installed",
          "zh": ""
        },
        {
          "id": 12,
          "start": 31.68,
          "end": 33.81,
          "en": "because the Remix code you write",
          "zh": ""
        },
        {
          "id": 13,
          "start": 33.81,
          "end": 36.69,
          "en": "also includes node.js features.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 36.69,
          "end": 39.72,
          "en": "Therefore, you should visit nodejs.org",
          "zh": ""
        },
        {
          "id": 15,
          "start": 39.72,
          "end": 44.01,
          "en": "and there you can download this latest node.js version.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 44.01,
          "end": 46.17,
          "en": "In my case, it's version 19",
          "zh": ""
        },
        {
          "id": 17,
          "start": 46.17,
          "end": 47.52,
          "en": "but you should simply download",
          "zh": ""
        },
        {
          "id": 18,
          "start": 47.52,
          "end": 50.43,
          "en": "the latest version you are seeing when you are viewing this.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 50.43,
          "end": 52.8,
          "en": "And if that's a later version, that's perfectly fine,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 52.8,
          "end": 56.16,
          "en": "what you'll learn in this course will still apply.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 56.16,
          "end": 58.5,
          "en": "Now, after installing node.js,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 58.5,
          "end": 60.63,
          "en": "back in the terminal or command prompt,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 60.63,
          "end": 62.16,
          "en": "you are ready to run the command",
          "zh": ""
        },
        {
          "id": 24,
          "start": 62.16,
          "end": 64.44,
          "en": "to create a new Remix project.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 64.44,
          "end": 66.54,
          "en": "And that command is npx,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 66.54,
          "end": 70.23,
          "en": "which is a command made available by node.js,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 70.23,
          "end": 72.51,
          "en": "create-remix.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 72.51,
          "end": 75,
          "en": "And then to be safe that you're using",
          "zh": ""
        },
        {
          "id": 29,
          "start": 75,
          "end": 79.35,
          "en": "the latest version of this Remix project creation tool,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 79.35,
          "end": 82.233,
          "en": "you should @latest thereafter.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 83.52,
          "end": 86.52,
          "en": "Now, make sure by the way that you are running this command",
          "zh": ""
        },
        {
          "id": 32,
          "start": 86.52,
          "end": 90.39,
          "en": "in a folder where you want to create your Remix project.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 90.39,
          "end": 93.87,
          "en": "So you should navigate into such a folder in the terminal",
          "zh": ""
        },
        {
          "id": 34,
          "start": 93.87,
          "end": 96.57300000000001,
          "en": "in the command prompt before running that command.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 97.41,
          "end": 98.88,
          "en": "Then simply hit enter",
          "zh": ""
        },
        {
          "id": 36,
          "start": 98.88,
          "end": 102.12,
          "en": "and this will now take a short while until it gets started",
          "zh": ""
        },
        {
          "id": 37,
          "start": 102.12,
          "end": 104.85,
          "en": "and then it will ask you a couple of questions.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 104.85,
          "end": 108.36,
          "en": "For example, you must define the name of the project folder",
          "zh": ""
        },
        {
          "id": 39,
          "start": 108.36,
          "end": 110.88,
          "en": "that will hold the actual Remix project",
          "zh": ""
        },
        {
          "id": 40,
          "start": 110.88,
          "end": 112.41,
          "en": "that is about to be created.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 112.41,
          "end": 114.96000000000001,
          "en": "And here, I'll name it a remix-course.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 114.96000000000001,
          "end": 118.14,
          "en": "And this will create a new folder called remix-course",
          "zh": ""
        },
        {
          "id": 43,
          "start": 118.14,
          "end": 121.683,
          "en": "in the location where I'm currently at here in the terminal.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 122.58,
          "end": 123.63,
          "en": "After hitting enter,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 123.63,
          "end": 126.93,
          "en": "we then can choose whether we want a basic project",
          "zh": ""
        },
        {
          "id": 46,
          "start": 126.93,
          "end": 129.87,
          "en": "or some preconfigured stack",
          "zh": ""
        },
        {
          "id": 47,
          "start": 129.87,
          "end": 132.6,
          "en": "with more features already added in",
          "zh": ""
        },
        {
          "id": 48,
          "start": 132.6,
          "end": 135.03,
          "en": "and we'll stick to the basics here.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 135.03,
          "end": 138.32999999999998,
          "en": "Then we have to choose where we wanna deploy this app",
          "zh": ""
        },
        {
          "id": 50,
          "start": 138.32999999999998,
          "end": 140.4,
          "en": "though we can always change this later,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 140.4,
          "end": 143.37,
          "en": "and I will come back to this question later in the course",
          "zh": ""
        },
        {
          "id": 52,
          "start": 143.37,
          "end": 147.42000000000002,
          "en": "when we do talk about deploying Remix applications.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 147.42000000000002,
          "end": 149.13,
          "en": "To get started and for this course,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 149.13,
          "end": 151.833,
          "en": "you should stick to Remix app server here.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 153.75,
          "end": 155.04,
          "en": "Thereafter, you can choose",
          "zh": ""
        },
        {
          "id": 56,
          "start": 155.04,
          "end": 157.59,
          "en": "whether you wanna use TypeScript or JavaScript.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 157.59,
          "end": 160.38,
          "en": "And even though Remix is awesome with TypeScript,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 160.38,
          "end": 162.57,
          "en": "I'll stick to JavaScript here since of course",
          "zh": ""
        },
        {
          "id": 59,
          "start": 162.57,
          "end": 165.87,
          "en": "not every student watching this course knows TypeScript.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 165.87,
          "end": 168.93,
          "en": "And the general code you write is of course always the same",
          "zh": ""
        },
        {
          "id": 61,
          "start": 168.93,
          "end": 171.66,
          "en": "no matter if you're using JavaScript or Typescript.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 171.66,
          "end": 173.52,
          "en": "It's just the type annotations",
          "zh": ""
        },
        {
          "id": 63,
          "start": 173.52,
          "end": 175.623,
          "en": "that are missing with JavaScript.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 176.67000000000002,
          "end": 178.17000000000002,
          "en": "So here JavaScript it is.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 178.17000000000002,
          "end": 179.28,
          "en": "And then I'll choose yes,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 179.28,
          "end": 182.64,
          "en": "to make sure that NPM install is ran thereafter.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 182.64,
          "end": 184.92,
          "en": "And now this project is created,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 184.92,
          "end": 188.67,
          "en": "and all required dependencies are installed automatically.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 188.67,
          "end": 190.833,
          "en": "Now let's wait for that to finish here.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 192.54,
          "end": 194.37,
          "en": "And once the installation finished",
          "zh": ""
        },
        {
          "id": 71,
          "start": 194.37,
          "end": 196.56,
          "en": "and the project whilst therefore created",
          "zh": ""
        },
        {
          "id": 72,
          "start": 196.56,
          "end": 199.59,
          "en": "you can open it with your favorite code editor.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 199.59,
          "end": 201.66,
          "en": "In my case, that's Visual Studio Code",
          "zh": ""
        },
        {
          "id": 74,
          "start": 201.66,
          "end": 204.84,
          "en": "but you can use any code editor you want.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 204.84,
          "end": 206.7,
          "en": "And with that project created,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 206.7,
          "end": 208.53,
          "en": "it's now time to take a closer look",
          "zh": ""
        },
        {
          "id": 77,
          "start": 208.53,
          "end": 211.2,
          "en": "at all these files and folders that were created",
          "zh": ""
        },
        {
          "id": 78,
          "start": 211.2,
