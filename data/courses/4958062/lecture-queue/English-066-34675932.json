        },
        {
          "id": 39,
          "start": 112.32,
          "end": 113.7,
          "en": "and I'm using it down here.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 113.7,
          "end": 116.34,
          "en": "So here for the moment, I'll just set this to false",
