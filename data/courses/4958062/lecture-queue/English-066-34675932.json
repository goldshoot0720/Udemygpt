          "zh": ""
        },
        {
          "id": 16,
          "start": 46.44,
          "end": 50.43,
          "en": "if you console log expense data here, in this expense form.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 50.43,
          "end": 51.69,
          "en": "This is now undefined",
          "zh": ""
        },
        {
          "id": 18,
          "start": 51.69,
          "end": 54.87,
          "en": "because this detail page doesn't have a loader anymore.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 54.87,
          "end": 58.2,
          "en": "The parent route has one, but useLoaderData gives you access",
          "zh": ""
        },
        {
          "id": 20,
          "start": 58.2,
          "end": 61.17,
          "en": "to the closest loader of this route,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 61.17,
          "end": 62.73,
          "en": "which is currently active.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 62.73,
          "end": 64.62,
          "en": "And the main route that's currently active",
          "zh": ""
        },
        {
          "id": 23,
          "start": 64.62,
          "end": 66.63,
          "en": "is the ID route here.",
