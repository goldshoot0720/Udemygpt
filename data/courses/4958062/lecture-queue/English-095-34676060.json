          "end": 6.81,
          "en": "In this section, we added authentication",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.81,
          "end": 10.62,
          "en": "so that we can create users and log in with users,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.62,
