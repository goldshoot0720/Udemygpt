          "end": 24.633,
          "en": "to protected resources.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 25.53,
          "end": 28.83,
          "en": "In our project, we added some code for creating cookies",
          "zh": ""
        },
        {
          "id": 10,
          "start": 28.83,
          "end": 31.11,
          "en": "and sessions based on cookies.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 31.11,
          "end": 32.76,
          "en": "We made sure that these cookies",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.76,
          "end": 34.62,
          "en": "are sent back to the browser,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 34.62,
          "end": 38.01,
          "en": "that they can be cleared so that we can log out,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 38.01,
          "end": 40.62,
          "en": "and we added some code that allows us to check",
          "zh": ""
        },
        {
          "id": 15,
          "start": 40.62,
          "end": 43.8,
          "en": "whether a user is logged in or not,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 43.8,
          "end": 46.62,
          "en": "so that we can protect routes, for example,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 46.62,
          "end": 51.39,
          "en": "and redirect the user away if he or she is not logged in.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 51.39,
          "end": 56.39,
          "en": "But we also make sure that our expenses are linked to users",
          "zh": ""
        },
        {
          "id": 19,
          "start": 57.18,
          "end": 60.39,
          "en": "and that we then only retrieve the expenses",
          "zh": ""
        },
        {
          "id": 20,
          "start": 60.39,
