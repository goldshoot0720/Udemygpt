          "zh": ""
        },
        {
          "id": 68,
          "start": 198.36,
          "end": 201.99,
          "en": "So we get the mode that's encoded in the URL.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 201.99,
          "end": 205.17000000000002,
