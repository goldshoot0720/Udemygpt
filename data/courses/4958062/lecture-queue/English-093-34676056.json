  "lectures": [
    {
      "id": "34676056",
      "title": "More Route Protection",
      "lectureOrder": 100,
      "videoOrder": 93,
      "sourceHash": "ab3caaae541a101d6b5d4922fc62e6a95a5092b53abe9e1a541a9044a66a9881",
      "cues": [
        {
          "id": 1,
          "start": 2.16,
          "end": 4.71,
          "en": "So, we added this route protection",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.71,
          "end": 6.18,
          "en": "in the last lecture",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.18,
          "end": 10.17,
          "en": "and of course we have more routes that should be protected.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.17,
          "end": 12.936,
          "en": "To be precise, the expenses.analysis and",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.936,
          "end": 17.28,
          "en": "\"raw\" routes also should be protected.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.28,
          "end": 20.76,
          "en": "And for the reasons stated in the last lecture,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.76,
          "end": 24.42,
          "en": "we can't just wrap them all into one pathless route",
          "zh": ""
        },
        {
          "id": 8,
          "start": 24.42,
          "end": 28.47,
          "en": "and add our protection to the pathless route loader",
          "zh": ""
        },
        {
          "id": 9,
          "start": 28.47,
          "end": 31.413,
          "en": "because nested loaders would still get executed.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 32.25,
          "end": 35.1,
          "en": "So here in expenses.analysis.jsx,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 35.1,
          "end": 38.04,
          "en": "in the loader of that route here,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 38.04,
          "end": 41.52,
          "en": "we also call requireUserSession,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 41.52,
          "end": 45.723,
          "en": "which is of course imported from auth.server.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 46.59,
          "end": 49.413,
          "en": "And, we then get our request here",
          "zh": ""
        },
        {
          "id": 15,
          "start": 49.413,
          "end": 53.19,
          "en": "and pass that request to requireUserSession",
          "zh": ""
        },
        {
          "id": 16,
          "start": 53.19,
          "end": 55.17,
          "en": "and await this.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 55.17,
          "end": 60.17,
          "en": "So, we perform the same steps as we did in expenses.jsx.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 60.27,
          "end": 64.95,
          "en": "And we do the same thing here in expense.raw.jsx.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 64.95,
          "end": 67.26,
          "en": "There we also get our request that we call",
          "zh": ""
        },
        {
          "id": 20,
          "start": 67.26,
          "end": 71.43,
          "en": "requireUserSession, pass the request to it, and",
          "zh": ""
        },
        {
          "id": 21,
          "start": 71.43,
          "end": 74.85,
          "en": "await this to ensure that we don't return any expenses",
          "zh": ""
        },
        {
          "id": 22,
          "start": 74.85,
          "end": 76.893,
          "en": "if the user is not locked in.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 78.78,
          "end": 81.42,
          "en": "So with that, if we now save this",
          "zh": ""
        },
        {
          "id": 24,
          "start": 81.42,
          "end": 86.42,
          "en": "and I try to access expenses.analysis, I'm forwarded.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 87.03,
          "end": 90.93,
          "en": "And the same thing happens for expenses/raw.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 90.93,
          "end": 93.513,
          "en": "So, that's all working as it should.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
