        },
        {
          "id": 171,
          "start": 479.64,
          "end": 482.25,
          "en": "where I use object.values,",
          "zh": ""
        },
        {
          "id": 172,
          "start": 482.25,
          "end": 485.19,
          "en": "another utility method built into JavaScript,",
          "zh": ""
        },
        {
          "id": 173,
          "start": 485.19,
          "end": 487.5,
          "en": "on this object clause.",
          "zh": ""
        },
        {
          "id": 174,
          "start": 487.5,
          "end": 490.38,
