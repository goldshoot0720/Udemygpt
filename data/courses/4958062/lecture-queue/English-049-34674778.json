      "sourceHash": "647f481ea22f02cbd7d25472cadf6ea6ca802586ef2bfe63a0823634a352b466",
      "cues": [
        {
          "id": 1,
          "start": 2.19,
          "end": 4.8,
          "en": "Now that's it for all these route types.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.8,
          "end": 6.69,
          "en": "And throughout this section",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.69,
          "end": 9.21,
          "en": "and the Remix Essentials section, you learned",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.21,
          "end": 11.49,
          "en": "about a lot of different routes",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.49,
          "end": 15.72,
          "en": "and routing concepts that are supported by Remix.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.72,
          "end": 17.88,
          "en": "You learned about these basic routes where",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.88,
          "end": 20.07,
          "en": "the file name reflects the path",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.07,
          "end": 22.26,
          "en": "about nested routes with folders",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.26,
          "end": 26.16,
          "en": "these nested routes with dot delimiters, dynamic routes",
          "zh": ""
        },
        {
          "id": 10,
          "start": 26.16,
          "end": 29.37,
          "en": "with the dollar sign, and then some placeholder name",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.37,
          "end": 33.36,
          "en": "about splat routes, layout routes, a very important concept.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 33.36,
          "end": 37.17,
          "en": "And Pathless routes or pathless layout routes",
          "zh": ""
        },
        {
          "id": 13,
          "start": 37.17,
          "end": 39,
          "en": "as I called them.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 39,
          "end": 43.23,
          "en": "These are the different route types supported by Remix.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 43.23,
          "end": 46.26,
          "en": "They all solve different problems, and",
          "zh": ""
        },
        {
          "id": 16,
          "start": 46.26,
          "end": 48.96,
          "en": "as you can already see in this example application",
          "zh": ""
        },
        {
          "id": 17,
          "start": 48.96,
          "end": 51.9,
          "en": "which definitely isn't too fancy and complex",
          "zh": ""
        },
        {
          "id": 18,
          "start": 51.9,
          "end": 55.24,
          "en": "you do often need a lot of them working together",
          "zh": ""
        },
        {
          "id": 19,
          "start": 55.24,
          "end": 58.8,
          "en": "to implement the website you want to implement.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 58.8,
          "end": 60.9,
          "en": "Now to conclude this section,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 60.9,
          "end": 63.24,
          "en": "there is one last feature I wanna work on.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 63.24,
          "end": 66.24,
          "en": "One last thing I want to add, and that's related",
          "zh": ""
        },
        {
          "id": 23,
          "start": 66.24,
          "end": 67.533,
          "en": "to the AuthForm.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 68.49,
          "end": 69.87,
          "en": "There we have a link",
          "zh": ""
        },
        {
          "id": 25,
          "start": 69.87,
          "end": 71.43,
          "en": "with an anchor element instead",
          "zh": ""
        },
        {
          "id": 26,
          "start": 71.43,
          "end": 74.19,
          "en": "of the link component provided by Remix",
          "zh": ""
        },
        {
          "id": 27,
          "start": 74.19,
          "end": 76.47,
          "en": "which leads to slash off.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 76.47,
          "end": 80.1,
          "en": "Now actually I wanna get a bit fancy on this page.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 80.1,
          "end": 81.12,
          "en": "I wanna make sure",
          "zh": ""
        },
        {
          "id": 30,
          "start": 81.12,
          "end": 85.194,
          "en": "that this link does not always lead to just the login page",
          "zh": ""
        },
        {
          "id": 31,
          "start": 85.194,
          "end": 87.24,
          "en": "but instead it should allow me to switch",
          "zh": ""
        },
        {
          "id": 32,
          "start": 87.24,
          "end": 91.02,
          "en": "between login and signup mode.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 91.02,
          "end": 92.22,
          "en": "The difference being that",
          "zh": ""
        },
        {
          "id": 34,
          "start": 92.22,
          "end": 97.08,
          "en": "in signup mode we create a new user, whereas in login mode",
          "zh": ""
        },
        {
          "id": 35,
          "start": 97.08,
          "end": 98.03999999999999,
          "en": "we try to log in",
          "zh": ""
        },
        {
          "id": 36,
          "start": 98.03999999999999,
          "end": 100.05,
          "en": "with an existing user.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 100.05,
          "end": 102.06,
          "en": "And that's not just some fancy bonus,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 102.06,
          "end": 105.69,
          "en": "instead, that is a feature we absolutely need so that later",
          "zh": ""
        },
        {
          "id": 39,
          "start": 105.69,
          "end": 108.96000000000001,
          "en": "in this course, once we do add user authentication",
          "zh": ""
        },
        {
          "id": 40,
          "start": 108.96000000000001,
          "end": 112.72399999999999,
          "en": "we are able to create users or login",
          "zh": ""
        },
        {
          "id": 41,
          "start": 112.72399999999999,
          "end": 115.02000000000001,
          "en": "because we must be able to create users",
          "zh": ""
        },
        {
          "id": 42,
          "start": 115.02000000000001,
          "end": 116.523,
          "en": "before we can log in.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 117.45,
          "end": 120.81,
          "en": "So we need a way of switching between two different modes.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 120.81,
          "end": 124.2,
          "en": "And there are different ways of implementing such a switch.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 124.2,
          "end": 125.4,
          "en": "We could, for example",
          "zh": ""
        },
        {
          "id": 46,
          "start": 125.4,
          "end": 130.4,
          "en": "do it with use state, a standard React feature.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 130.5,
          "end": 132.3,
          "en": "We could have two different states",
          "zh": ""
        },
        {
          "id": 48,
          "start": 132.3,
          "end": 134.22,
          "en": "and turn this link into a button",
          "zh": ""
        },
        {
          "id": 49,
          "start": 134.22,
          "end": 136.863,
          "en": "which allows us to toggle between those states.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 137.7,
          "end": 139.7,
          "en": "This could be done, this wouldn't be bad",
          "zh": ""
        },
        {
          "id": 51,
          "start": 140.696,
          "end": 143.799,
          "en": "but there also is a very elegant way that allows us to",
          "zh": ""
        },
        {
          "id": 52,
          "start": 143.799,
          "end": 148.41,
          "en": "embrace Remix and browser defaults or web standards",
          "zh": ""
        },
        {
          "id": 53,
          "start": 148.41,
          "end": 149.97,
          "en": "to solve this problem.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 149.97,
          "end": 152.643,
          "en": "We can use URL search pairs.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 153.9,
          "end": 157.14,
          "en": "Now, URL search pairs are in the end",
          "zh": ""
        },
        {
          "id": 56,
          "start": 157.14,
          "end": 159.93,
          "en": "these special parameters you can append",
          "zh": ""
        },
        {
          "id": 57,
          "start": 159.93,
          "end": 164.46,
          "en": "at the end of your URL after a question mark.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 164.46,
          "end": 165.93,
          "en": "So you can add a question mark,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 165.93,
          "end": 168.96,
          "en": "and then for example, add mode equals login.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 168.96,
          "end": 171.903,
          "en": "This is also commonly called query parameters.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 172.92000000000002,
          "end": 175.8,
          "en": "So now we would add a mode query parameter",
          "zh": ""
        },
        {
          "id": 62,
          "start": 175.8,
          "end": 180.8,
          "en": "or search parameter with a value of login to this off route.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 181.71,
          "end": 183.69,
          "en": "This still loads the off route",
          "zh": ""
        },
        {
          "id": 64,
          "start": 183.69,
          "end": 186.51,
          "en": "it still loads the auth forum, therefore",
          "zh": ""
        },
        {
          "id": 65,
          "start": 186.51,
          "end": 190.08,
          "en": "but this extra data can be used in that route",
          "zh": ""
        },
        {
          "id": 66,
          "start": 190.08,
          "end": 193.68,
          "en": "and in that component that was being loaded to",
          "zh": ""
        },
        {
          "id": 67,
          "start": 193.68,
          "end": 197.4,
          "en": "manipulate the UI in some way.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 197.4,
          "end": 198.233,
          "en": "And in this case",
          "zh": ""
        },
        {
          "id": 69,
          "start": 198.233,
          "end": 202.38,
          "en": "I wanna manipulate it such that the button caption changes,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 202.38,
          "end": 204.63,
          "en": "that this links caption changes,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 204.63,
          "end": 206.91,
          "en": "and that this eye can changes.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 206.91,
          "end": 209.07,
          "en": "And later in the authentication section",
          "zh": ""
        },
        {
          "id": 73,
          "start": 209.07,
          "end": 212.34,
          "en": "we'll also use these parameters here",
          "zh": ""
        },
        {
          "id": 74,
          "start": 212.34,
          "end": 215.52,
          "en": "the query parameter here in the back and code to",
          "zh": ""
        },
        {
          "id": 75,
          "start": 215.52,
          "end": 218.973,
          "en": "either create a new user or log an existing user in.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 219.99,
          "end": 223.413,
          "en": "So how can we now add such a query parameter therefore?",
          "zh": ""
        },
        {
          "id": 77,
          "start": 224.28,
          "end": 225.76,
          "en": "Well, we can start",
          "zh": ""
        },
        {
          "id": 78,
          "start": 226.84,
          "end": 231.39,
          "en": "by importing the link component from at Remix run React",
          "zh": ""
        },
        {
          "id": 79,
          "start": 232.41,
          "end": 235.625,
          "en": "and I want to use that instead of the anchor element.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 235.625,
          "end": 238.078,
          "en": "So that's the same thing as I did before,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 238.078,
          "end": 240.96,
          "en": "And we also use the two prop instead of ref.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 240.96,
          "end": 244.11,
          "en": "But now I don't wanna load slash off here",
          "zh": ""
        },
        {
          "id": 83,
          "start": 244.11,
          "end": 247.86,
          "en": "but instead I simply wanna append a query parameter",
          "zh": ""
        },
        {
          "id": 84,
          "start": 247.86,
          "end": 250.44,
          "en": "a search parameter to the currently active page",
          "zh": ""
        },
        {
          "id": 85,
          "start": 250.44,
          "end": 252.87,
          "en": "which is slash off.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 252.87,
          "end": 255.09,
          "en": "So therefore I can create a relative path here",
          "zh": ""
        },
        {
          "id": 87,
          "start": 255.09,
          "end": 258.20799999999997,
          "en": "which is just question mark mode equals",
          "zh": ""
        },
        {
          "id": 88,
          "start": 258.20799999999997,
          "end": 262.47,
          "en": "and then either log in if we are currently in signup mode",
          "zh": ""
        },
        {
          "id": 89,
          "start": 262.47,
          "end": 265.688,
          "en": "because then we want to have a link that leads us",
          "zh": ""
        },
        {
          "id": 90,
          "start": 265.688,
          "end": 268.17,
          "en": "to the login mode, or it should be signup",
          "zh": ""
        },
        {
          "id": 91,
          "start": 268.17,
          "end": 270.54,
          "en": "if we currently are in login mode",
          "zh": ""
        },
        {
          "id": 92,
          "start": 270.54,
          "end": 273.419,
          "en": "because then we want to have a link that leads us",
          "zh": ""
        },
        {
          "id": 93,
          "start": 273.419,
          "end": 275.82,
          "en": "to the opposite mode to the signup mode.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 275.82,
          "end": 278.01,
          "en": "So we need to switch this dynamically",
          "zh": ""
        },
        {
          "id": 95,
          "start": 278.01,
          "end": 280.324,
          "en": "and we therefore, first of all",
          "zh": ""
        },
        {
          "id": 96,
          "start": 280.324,
          "end": 282.81,
          "en": "need to determine in which mode we currently are.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 282.81,
          "end": 284.61,
          "en": "And that is something we can do",
          "zh": ""
        },
        {
          "id": 98,
          "start": 284.61,
          "end": 286.77,
          "en": "with help of our React hook offered",
          "zh": ""
        },
        {
          "id": 99,
          "start": 286.77,
          "end": 287.763,
          "en": "by Remix run.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 288.93,
          "end": 291.81,
          "en": "They use SearchParams hook.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 291.81,
          "end": 294.741,
          "en": "This hook can be called to get hold",
          "zh": ""
        },
        {
          "id": 102,
          "start": 294.741,
          "end": 297.33,
          "en": "of two elements in an array.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 297.33,
          "end": 300.049,
          "en": "And I'm using array de-structuring here to",
          "zh": ""
        },
        {
          "id": 104,
          "start": 300.049,
          "end": 302.73,
          "en": "extract those elements from the array.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 302.73,
          "end": 305.58,
          "en": "We get the SearchParams that are currently set",
          "zh": ""
        },
        {
          "id": 106,
          "start": 305.58,
          "end": 309.21,
          "en": "and a set SearchParams function that would allow us to",
          "zh": ""
        },
        {
          "id": 107,
          "start": 309.21,
          "end": 311.986,
          "en": "update them. Though, we can also update them",
          "zh": ""
        },
        {
          "id": 108,
          "start": 311.986,
          "end": 314.37,
          "en": "with a link like this.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 314.37,
          "end": 315.99,
          "en": "Therefore here, I'm not interested",
          "zh": ""
        },
        {
          "id": 110,
          "start": 315.99,
          "end": 318.9,
          "en": "in that second element returned by use SearchParams",
          "zh": ""
        },
        {
          "id": 111,
          "start": 318.9,
          "end": 320.463,
          "en": "but only the first element.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 321.72,
          "end": 324.54,
          "en": "And then SearchParams is simply an object",
          "zh": ""
        },
        {
          "id": 113,
          "start": 324.54,
          "end": 328.62,
          "en": "that allows us to extract the currently set value",
          "zh": ""
        },
        {
          "id": 114,
          "start": 328.62,
          "end": 331.62,
          "en": "for a query parameter of our choice.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 331.62,
          "end": 334.26,
          "en": "In my case, I'll be looking for the mode parameter",
          "zh": ""
        },
        {
          "id": 116,
          "start": 334.26,
          "end": 337.353,
          "en": "because I will set that parameter on that link here.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 338.58,
          "end": 343.58,
          "en": "So therefore, what we can do here is we can get the current",
          "zh": ""
        },
        {
          "id": 118,
          "start": 343.65,
          "end": 347.994,
          "en": "off mode by using this SearchParams object returned",
          "zh": ""
        },
        {
          "id": 119,
          "start": 347.994,
          "end": 351.63,
          "en": "by this hook and calling the get method on it",
          "zh": ""
        },
        {
          "id": 120,
          "start": 351.63,
          "end": 354.99,
          "en": "which allows us to get the value for a certain parameter.",
          "zh": ""
        },
        {
          "id": 121,
          "start": 354.99,
          "end": 358.023,
          "en": "And here this is the mode parameter I'm interested in.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 359.43,
          "end": 361.86,
          "en": "Now this might not be set, for example",
          "zh": ""
        },
        {
          "id": 123,
          "start": 361.86,
          "end": 363.72,
          "en": "if we're just loading slash",
          "zh": ""
        },
        {
          "id": 124,
          "start": 363.72,
          "end": 366.9,
          "en": "off without any query parameter thereafter",
          "zh": ""
        },
        {
          "id": 125,
          "start": 366.9,
          "end": 369.42,
          "en": "then this query parameter won't be set.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 369.42,
          "end": 371.793,
          "en": "This mode parameter won't be set.",
          "zh": ""
        },
        {
          "id": 127,
          "start": 372.78,
          "end": 376.59,
          "en": "Therefore, I'll define an alternative value of login",
          "zh": ""
        },
        {
          "id": 128,
          "start": 376.59,
          "end": 377.58,
          "en": "which is my default",
          "zh": ""
        },
        {
          "id": 129,
          "start": 377.58,
          "end": 380.493,
          "en": "in case this mode query parameter shouldn't exist.",
          "zh": ""
        },
        {
          "id": 130,
          "start": 381.72,
          "end": 382.77,
          "en": "So with that",
          "zh": ""
        },
        {
          "id": 131,
          "start": 382.77,
          "end": 386.49,
          "en": "I now know in which mode I am and I can then",
          "zh": ""
        },
        {
          "id": 132,
          "start": 386.49,
          "end": 391.49,
          "en": "add my submit button caption where I check my off mode",
          "zh": ""
        },
        {
          "id": 133,
          "start": 392.04,
          "end": 394.56,
          "en": "and I check whether it's equal to log in.",
          "zh": ""
        },
        {
          "id": 134,
          "start": 394.56,
          "end": 396.24,
          "en": "And if that's the case",
          "zh": ""
        },
        {
          "id": 135,
          "start": 396.24,
          "end": 399.03,
