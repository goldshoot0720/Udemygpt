        },
        {
          "id": 16,
          "start": 37.7,
          "end": 40.79,
          "en": "which we are going to solve together though.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 40.79,
          "end": 44.37,
          "en": "Let's start with adding images to our Markdown content.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 44.37,
          "end": 46.27,
          "en": "Attached, you find an updated",
          "zh": ""
        },
        {
          "id": 19,
