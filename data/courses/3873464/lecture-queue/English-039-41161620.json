        },
        {
          "id": 33,
          "start": 97.53,
          "end": 98.75999999999999,
          "en": "into the routes folder",
          "zh": ""
        },
        {
          "id": 34,
          "start": 98.75999999999999,
          "end": 101.913,
          "en": "because this is also loaded as a route.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 103.08,
          "end": 106.2,
          "en": "So here we have this new post component here,",
