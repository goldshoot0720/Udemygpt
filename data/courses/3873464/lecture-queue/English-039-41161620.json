          "zh": ""
        },
        {
          "id": 16,
          "start": 45.51,
          "end": 49.743,
          "en": "this component function to posts, also in the export.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 50.85,
          "end": 53.97,
          "en": "And we can get rid of that main header import here as well.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 53.97,
          "end": 56.49,
          "en": "Now we can also get rid of the show modal handler",
          "zh": ""
        },
        {
          "id": 19,
          "start": 56.49,
          "end": 60.18,
          "en": "because that was previously used by the main header.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 60.18,
          "end": 62.55,
          "en": "And we can actually also already get rid",
          "zh": ""
        },
        {
          "id": 21,
          "start": 62.55,
          "end": 65.04,
          "en": "of hide modal handler here,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 65.04,
          "end": 69.75,
