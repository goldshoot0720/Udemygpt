          "zh": ""
        },
        {
          "id": 129,
          "start": 397.8,
          "end": 401.07,
          "en": "because NextJS is smart enough to understand",
          "zh": ""
        },
        {
          "id": 130,
          "start": 401.07,
          "end": 404.31,
          "en": "that if you are visiting slash meals slash share",
