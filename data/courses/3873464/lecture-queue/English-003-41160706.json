      "sourceHash": "67c6f7807ea27fb5d44152bc9d715f5f71840605df578c0d162da6c12de4899b",
      "cues": [
        {
          "id": 1,
          "start": 0.51,
          "end": 3,
          "en": "So NextJS allows you",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3,
          "end": 6.96,
          "en": "to build full stack applications with React.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.96,
          "end": 9.69,
          "en": "So to blend frontend and backend",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.69,
          "end": 13.44,
          "en": "and build more complex apps all in one project,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.44,
          "end": 17.19,
          "en": "and all with one programming language, JavaScript,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.19,
          "end": 20.19,
          "en": "and one framework or one library,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.19,
          "end": 23.73,
          "en": "so with React, enhanced by NextJS.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 23.73,
          "end": 25.35,
          "en": "And in this course you will see",
          "zh": ""
        },
        {
          "id": 9,
          "start": 25.35,
          "end": 27.813,
          "en": "that this can offer various advantages.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 28.773,
          "end": 29.606,
          "en": "For example, fetching",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.606,
          "end": 33.24,
          "en": "and rendering data can become easier and more efficient.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 33.24,
          "end": 37.08,
          "en": "Handling form submissions can become easier and more secure.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 37.08,
          "end": 40.71,
          "en": "So there are many advantages related to that.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 40.71,
          "end": 44.724,
          "en": "And whilst this is the main big thing,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 44.724,
          "end": 47.76,
          "en": "NextJS adds, that it allows you",
          "zh": ""
        },
        {
          "id": 16,
          "start": 47.76,
          "end": 50.28,
          "en": "to build such full stack applications,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 50.28,
          "end": 55.28,
          "en": "it's not the only benefit you gain when working with NextJS.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 55.35,
          "end": 58.5,
          "en": "And another advantage of NextJS is that",
          "zh": ""
        },
        {
          "id": 19,
          "start": 58.5,
          "end": 62.635,
          "en": "with it you set up your routes with help of the file system.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 62.635,
          "end": 65.67,
          "en": "Instead of configuring them in code,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 65.67,
          "end": 69.12,
          "en": "as you would typically do it in a vanilla JavaScript app,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 69.12,
          "end": 73.89,
          "en": "for example, with React Router, when working with NextJS,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 73.89,
          "end": 76.65,
          "en": "you configure them with help of the file system.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 76.65,
          "end": 78.81,
          "en": "So by setting up various folders",
          "zh": ""
        },
        {
          "id": 25,
          "start": 78.81,
          "end": 82.17,
          "en": "and files, which are then mapped into routes",
          "zh": ""
        },
        {
          "id": 26,
          "start": 82.17,
          "end": 84.53999999999999,
          "en": "that can be visited by users.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 84.53999999999999,
          "end": 86.78999999999999,
          "en": "The advantage of this approach is",
          "zh": ""
        },
        {
          "id": 28,
          "start": 86.78999999999999,
          "end": 89.312,
          "en": "that no extra code-based configuration",
          "zh": ""
        },
        {
          "id": 29,
          "start": 89.312,
          "end": 91.98,
          "en": "or extra packages are needed.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 91.98,
          "end": 94.263,
          "en": "Instead it's built into NextJS.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 95.49000000000001,
          "end": 97.47,
          "en": "And last but not least,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 97.47,
          "end": 101.55,
          "en": "but definitely not to be underestimated, is the fact",
          "zh": ""
        },
        {
          "id": 33,
          "start": 101.55,
          "end": 105.33,
          "en": "that NextJS actually renders all the content",
          "zh": ""
        },
        {
          "id": 34,
          "start": 105.33,
          "end": 107.75999999999999,
          "en": "that's visible on the screen, all the pages",
          "zh": ""
        },
        {
          "id": 35,
          "start": 107.75999999999999,
          "end": 110.16,
          "en": "and components on the server.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 110.16,
          "end": 114.33,
          "en": "And that means that the content that's sent over the wire,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 114.33,
          "end": 118.47,
          "en": "the HTML document, in the end already includes all the",
          "zh": ""
        },
        {
          "id": 38,
          "start": 118.47,
          "end": 121.62,
          "en": "content that should be presented on the screen instead",
          "zh": ""
        },
        {
          "id": 39,
          "start": 121.62,
          "end": 123.03,
          "en": "of being mostly empty",
          "zh": ""
        },
        {
          "id": 40,
          "start": 123.03,
          "end": 126.03,
          "en": "and populated on the client as is the case",
          "zh": ""
        },
        {
          "id": 41,
          "start": 126.03,
          "end": 127.62,
          "en": "with vanilla JavaScript.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 127.62,
          "end": 130.32,
          "en": "And the advantage here is that, for example,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 130.32,
          "end": 134.73,
          "en": "search engine crawlers see that finished content as well.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 134.73,
          "end": 136.53,
          "en": "But I'll get back to that point",
          "zh": ""
        },
        {
          "id": 45,
          "start": 136.53,
          "end": 138.84,
          "en": "in a couple of lectures again.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 138.84,
          "end": 142.38,
          "en": "And therefore, using NextJS gives you a couple",
          "zh": ""
        },
        {
          "id": 47,
          "start": 142.38,
          "end": 143.55,
          "en": "of key features",
          "zh": ""
        },
        {
          "id": 48,
          "start": 143.55,
          "end": 146.1,
          "en": "and benefits that are not to be underestimated.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 146.1,
          "end": 150.57,
          "en": "And that's of course the reason why NextJS is that popular",
          "zh": ""
        },
        {
          "id": 50,
          "start": 150.57,
          "end": 153.96,
          "en": "and why for building more complex React apps,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 153.96,
          "end": 158.313,
          "en": "you should strongly consider using a framework like NextJS.",
          "zh": ""
        }
      ]
    }
  ],
