  "lectures": [
    {
      "id": "25146464",
      "title": "Protecting API Routes",
      "lectureOrder": 410,
      "videoOrder": 378,
      "sourceHash": "9ac2cfeacfb58a02e9e18eeb5c0c1696b94c9ae49aa0dd72a13ec5387c49cad3",
      "cues": [
        {
          "id": 1,
          "start": 2.13,
          "end": 4.61,
          "en": "Now to take a closer look at API routes",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.61,
          "end": 6.31,
          "en": "and how we can protect those,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.31,
          "end": 9.52,
          "en": "I will take this change password example.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.52,
          "end": 13.62,
          "en": "This clearly is an operation that should be restricted.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.62,
          "end": 17.13,
          "en": "Not every user should be allowed to change a password.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.13,
          "end": 20.32,
          "en": "It only makes sense for authenticated users",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.32,
          "end": 22.88,
          "en": "and hence, I will add a new API route",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.88,
          "end": 26.11,
          "en": "and we can add it in the API auth folder,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 26.11,
          "end": 28.56,
          "en": "but we could also add it somewhere else,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 28.56,
          "end": 32.28,
          "en": "and to show that it does not have to be in the auth folder,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 32.28,
          "end": 36.62,
          "en": "I will create another folder, in the pages API folder,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 36.62,
          "end": 38.95,
          "en": "and that will be the user folder,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 38.95,
          "end": 41.57,
          "en": "but you could add it in auth, as well,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 41.57,
          "end": 45.67,
          "en": "and in there, I'll add the change-password.js file",
          "zh": ""
        },
        {
          "id": 15,
          "start": 45.67,
          "end": 47.87,
          "en": "because I want to create an API route,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 47.87,
          "end": 50.56,
          "en": "which can be reached by sending a request",
          "zh": ""
        },
        {
          "id": 17,
          "start": 50.56,
          "end": 54.87,
          "en": "to /api/user/change-password,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 54.87,
          "end": 56.783,
          "en": "that's reaching this file then.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 57.98,
          "end": 61.47,
          "en": "Now in this file, we're not going to use NextAuth,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 61.47,
          "end": 63,
          "en": "at least not as we did it",
          "zh": ""
        },
        {
          "id": 21,
          "start": 63,
          "end": 66.43,
          "en": "in this square bracket nextauth file.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 66.43,
          "end": 69.65,
          "en": "Instead, we're going to create our own API route,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 69.65,
          "end": 72.22,
          "en": "just as we learned it in this course.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 72.22,
          "end": 74.64,
          "en": "So I'll create a handler function here,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 74.64,
          "end": 77.17,
          "en": "which gets a request and a response,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 77.17,
          "end": 80.85300000000001,
          "en": "and I'll then export this as a default here,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 81.72,
          "end": 84.24,
          "en": "and now in this handler function,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 84.24,
          "end": 88.74,
          "en": "we want to extract the old and new password,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 88.74,
          "end": 90.293,
          "en": "which the user entered here.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 91.3,
          "end": 93.81,
          "en": "We want to verify that the request is coming",
          "zh": ""
        },
        {
          "id": 31,
          "start": 93.81,
          "end": 96.00999999999999,
          "en": "from an authenticated user",
          "zh": ""
        },
        {
          "id": 32,
          "start": 96.00999999999999,
          "end": 99.53999999999999,
          "en": "and deny for reaction, if it's not.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 99.53999999999999,
          "end": 101.47,
          "en": "We want to get the email address",
          "zh": ""
        },
        {
          "id": 34,
          "start": 101.47,
          "end": 103.86,
          "en": "of that authenticated user then,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 103.86,
          "end": 106.63,
          "en": "and then we want to look into the database,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 106.63,
          "end": 109,
          "en": "see if we find that user there,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 109,
          "end": 112.41,
          "en": "see if the old password that was entered matches",
          "zh": ""
        },
        {
          "id": 38,
          "start": 112.41,
          "end": 114.71000000000001,
          "en": "the current password in the database,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 114.71000000000001,
          "end": 116.00999999999999,
          "en": "and if that's the case,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 116.00999999999999,
          "end": 119.75999999999999,
          "en": "we want to replace that old password with the new password.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 119.75999999999999,
          "end": 121.34,
          "en": "So that's what we're now going to do",
          "zh": ""
        },
        {
          "id": 42,
          "start": 121.34,
          "end": 123.05,
          "en": "over the next minutes.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 123.05,
          "end": 125.14,
          "en": "Now for that, in the handler function,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 125.14,
          "end": 127.58,
          "en": "the change-password.js file here,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 127.58,
          "end": 130.49,
          "en": "let's first of all, check if the incoming request",
          "zh": ""
        },
        {
          "id": 46,
          "start": 130.49,
          "end": 133.57,
          "en": "has the right method, and for changing the password,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 133.57,
          "end": 138.16,
          "en": "a POST, or a PUT, or a PATCH request makes sense.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 138.16,
          "end": 141.87,
          "en": "These are the three kinds of requests that imply",
          "zh": ""
        },
        {
          "id": 49,
          "start": 141.87,
          "end": 146.07,
          "en": "that resources on the server should be created or changed,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 146.07,
          "end": 149.44,
          "en": "and you can argue whether changing a password",
          "zh": ""
        },
        {
          "id": 51,
          "start": 149.44,
          "end": 152.87,
          "en": "is creating a new resource, a new password,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 152.87,
          "end": 156.72,
          "en": "or changing an existing resource and existing user,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 156.72,
          "end": 159.91,
          "en": "and I will go for the latter argument,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 159.91,
          "end": 163.41,
          "en": "and I want to say that I only want to continue here,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 163.41,
          "end": 167.42000000000002,
          "en": "if the incoming request has a method of PATCH.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 167.42000000000002,
          "end": 171.22,
          "en": "So if it's not PATCH, then we will just return",
          "zh": ""
        },
        {
          "id": 57,
          "start": 171.22,
          "end": 173.37,
          "en": "and not continue at all.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 173.37,
          "end": 176.6,
          "en": "We will only continue for PATCH requests,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 176.6,
          "end": 179.04,
          "en": "which of course means that in the front-end,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 179.04,
          "end": 182.06,
          "en": "so in our client-side code, we'll have to make sure",
          "zh": ""
        },
        {
          "id": 61,
          "start": 182.06,
          "end": 187.06,
          "en": "that we do send a PATCH request to this API route later.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 188.25,
          "end": 189.723,
          "en": "So that's check number one.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 190.67,
          "end": 194.19,
          "en": "Check number two, is whether that request is coming",
          "zh": ""
        },
        {
          "id": 64,
          "start": 194.19,
          "end": 197.02,
          "en": "from an authenticated user or not,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 197.02,
          "end": 201.17000000000002,
          "en": "and if it's not, we also want to return with an error,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 201.17000000000002,
          "end": 203.54,
          "en": "and for this, we can again use",
          "zh": ""
        },
        {
          "id": 67,
          "start": 203.54,
          "end": 206.12,
          "en": "this getSession function here,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 206.12,
          "end": 209.17000000000002,
          "en": "which we already used on the profile page.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 209.17000000000002,
          "end": 213.29,
          "en": "There we are already using it in server-side code,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 213.29,
          "end": 214.873,
          "en": "inside of getServerSideProps.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 215.92000000000002,
          "end": 218.55,
          "en": "So we already see that it runs on the server,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 218.55,
          "end": 220.25,
          "en": "as well as on the client,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 220.25,
          "end": 222.49,
          "en": "and that of course means that we can again,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 222.49,
          "end": 227.13,
          "en": "use it in our API route, which also is server-side code.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 227.13,
          "end": 229.9,
          "en": "So therefore, in the change-password.js file,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 229.9,
          "end": 234.9,
          "en": "I will again, import getSession from next-auth/client.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 238.39,
          "end": 242.09,
          "en": "The /client can be confusing, but this does work",
          "zh": ""
        },
        {
          "id": 78,
          "start": 242.09,
          "end": 244.81,
          "en": "on the server, as well, as we saw,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 244.81,
          "end": 248.09,
          "en": "and then we want to check if we do get a session.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 248.09,
          "end": 251.18,
          "en": "For this we can store a session a constant,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 251.18,
          "end": 253.56,
          "en": "and we get it by calling getSession,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 253.56,
          "end": 256.2,
          "en": "and then as you learned, on the server-side,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 256.2,
          "end": 260.34,
          "en": "we can pass in an object where we set the req key",
          "zh": ""
        },
        {
          "id": 84,
          "start": 260.34,
          "end": 262.493,
          "en": "to the request we're getting here.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 263.9,
          "end": 265.96,
          "en": "GetSession needs that incoming request,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 265.96,
          "end": 268.27,
          "en": "because it will then look into that request,",
          "zh": ""
        },
        {
          "id": 87,
          "start": 268.27,
          "end": 271.78,
          "en": "see if a session token cookie is part of the request.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 271.78,
          "end": 274.83,
          "en": "If it is, it will validate and extract that data",
          "zh": ""
        },
        {
          "id": 89,
          "start": 274.83,
          "end": 277.83,
          "en": "from that cookie, and if that all then makes sense,",
          "zh": ""
        },
        {
          "id": 90,
          "start": 277.83,
          "end": 279.843,
          "en": "it will give us the session object.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 280.71,
          "end": 283.11,
          "en": "Now, getSession actually returns a promise,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 283.11,
          "end": 284.83,
          "en": "and to use async await,",
          "zh": ""
        },
        {
          "id": 93,
          "start": 284.83,
          "end": 287.29,
          "en": "I'll turn this into a async function",
          "zh": ""
        },
        {
          "id": 94,
          "start": 287.29,
          "end": 288.793,
          "en": "and I'll wait here.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 289.93,
          "end": 292.05,
          "en": "So now we get our session,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 292.05,
          "end": 295.18,
          "en": "or we don't get one if the user is not authenticated,",
          "zh": ""
        },
        {
          "id": 97,
          "start": 295.18,
          "end": 297.93,
          "en": "and therefore, we can check if not session,",
          "zh": ""
        },
        {
          "id": 98,
          "start": 297.93,
          "end": 299.29,
          "en": "if that's undefined,",
          "zh": ""
        },
        {
          "id": 99,
          "start": 299.29,
          "end": 302.42,
          "en": "which means the request is not authenticated,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 302.42,
          "end": 304.81,
          "en": "and in that case, we also want to return",
          "zh": ""
        },
        {
          "id": 101,
          "start": 304.81,
          "end": 308.22,
          "en": "and here, we may be also want to send back a response.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 308.22,
          "end": 311.32,
          "en": "We could send one back in this first if check as well,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 311.32,
          "end": 313.22,
          "en": "a special response,",
          "zh": ""
        },
        {
          "id": 104,
          "start": 313.22,
          "end": 315.44,
          "en": "but I don't care about that here, but here,",
          "zh": ""
        },
        {
          "id": 105,
          "start": 315.44,
          "end": 318.41,
          "en": "I actually do want to send back a response",
          "zh": ""
        },
        {
          "id": 106,
          "start": 318.41,
          "end": 321.69,
          "en": "with a status code of 401,",
          "zh": ""
        },
        {
          "id": 107,
          "start": 321.69,
          "end": 324.85,
          "en": "which basically is the standard status code",
          "zh": ""
        },
        {
          "id": 108,
          "start": 324.85,
          "end": 328.13,
          "en": "for saying that authentication is missing,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 328.13,
          "end": 330.52,
          "en": "and then possibly some extra data attached,",
          "zh": ""
        },
        {
          "id": 110,
          "start": 330.52,
          "end": 334.88,
          "en": "like a message of not authenticated,",
          "zh": ""
        },
        {
          "id": 111,
          "start": 334.88,
          "end": 335.97,
          "en": "but of course, it's up to you,",
          "zh": ""
        },
        {
          "id": 112,
          "start": 335.97,
          "end": 339.453,
          "en": "which kind of data, if any, you want to send back.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 340.79,
          "end": 342.398,
          "en": "So that's now another important check,",
          "zh": ""
        },
        {
          "id": 114,
          "start": 342.398,
          "end": 345.86,
          "en": "and that is the key check of this module,",
          "zh": ""
        },
        {
          "id": 115,
          "start": 345.86,
          "end": 347.79,
          "en": "of this course module,",
          "zh": ""
        },
        {
          "id": 116,
          "start": 347.79,
          "end": 351.3,
          "en": "because this line here or this block of code,",
          "zh": ""
        },
        {
          "id": 117,
          "start": 351.3,
          "end": 355.40999999999997,
          "en": "that's the code where we validate whether a request",
          "zh": ""
        },
        {
          "id": 118,
          "start": 355.40999999999997,
          "end": 357.88,
          "en": "is authenticated or not.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 357.88,
          "end": 362.22,
          "en": "This is the code with which we protect our API route",
          "zh": ""
        },
        {
          "id": 120,
          "start": 362.22,
          "end": 364.99,
          "en": "against unauthenticated access,",
          "zh": ""
        },
        {
          "id": 121,
          "start": 364.99,
          "end": 368.56,
          "en": "and every API route that does something",
          "zh": ""
        },
        {
          "id": 122,
          "start": 368.56,
          "end": 372.41,
          "en": "that should only be allowed to authenticated users,",
          "zh": ""
        },
        {
          "id": 123,
          "start": 372.41,
          "end": 374.8,
          "en": "needs code like this.",
          "zh": ""
        },
        {
          "id": 124,
          "start": 374.8,
          "end": 377.94,
          "en": "Everything else we're going to write in this API route",
          "zh": ""
        },
        {
          "id": 125,
          "start": 377.94,
          "end": 381.62,
          "en": "is not directly related to authentication.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 381.62,
          "end": 384.29,
          "en": "Yes, we're going to change the password of a user,",
          "zh": ""
        },
        {
          "id": 127,
          "start": 384.29,
          "end": 387.47,
          "en": "and that of course, has something to do with authentication,",
          "zh": ""
        },
        {
          "id": 128,
          "start": 387.47,
          "end": 390.26,
          "en": "but on the other hand, changing a password is really not",
          "zh": ""
        },
        {
          "id": 129,
          "start": 390.26,
          "end": 392.6,
          "en": "that different from creating a product.",
          "zh": ""
        },
        {
          "id": 130,
          "start": 392.6,
          "end": 395.503,
          "en": "We're just changing some data in the database in the end.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
