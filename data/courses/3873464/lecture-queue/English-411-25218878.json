          "zh": ""
        },
        {
          "id": 68,
          "start": 214.89,
          "end": 216.77,
          "en": "to avoid copying this,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 216.77,
          "end": 218.6,
          "en": "but here to be very explicit",
          "zh": ""
        },
        {
          "id": 70,
          "start": 218.6,
          "end": 220.86,
          "en": "about which code you can execute where,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 220.86,
          "end": 225.163,
          "en": "I will copy it and paste it here into getStaticProps.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 226.64,
          "end": 231.64,
          "en": "With that, we do connect here and then once we did connect,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 231.9,
          "end": 235.43,
          "en": "and once we did reach out to the meetupsCollection,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 235.43,
          "end": 236.98,
          "en": "we can use the meetupsCollection",
          "zh": ""
        },
        {
          "id": 75,
          "start": 236.98,
          "end": 239.27,
          "en": "to call the find method there",
          "zh": ""
        },
        {
          "id": 76,
          "start": 239.27,
