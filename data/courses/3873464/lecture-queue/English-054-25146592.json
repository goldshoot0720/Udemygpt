          "zh": ""
        },
        {
          "id": 4,
          "start": 12.64,
          "end": 15.81,
          "en": "I'll add another div and before that div a h1 tag",
          "zh": ""
        },
        {
          "id": 5,
          "start": 15.81,
          "end": 17.875,
          "en": "where I say My Todos, because that was also",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.875,
          "end": 20.75,
          "en": "some texts which we had there.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.75,
          "end": 24.41,
          "en": "And then, this other div next to the h1 tag",
          "zh": ""
        },
        {
          "id": 8,
          "start": 24.41,
          "end": 28.73,
          "en": "inside of the other div, that div will contain",
          "zh": ""
        },
        {
          "id": 9,
          "start": 28.73,
          "end": 31.78,
          "en": "that signal todo, that signal todo item",
          "zh": ""
        },
        {
          "id": 10,
