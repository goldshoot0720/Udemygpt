      "sourceHash": "806ee939b421f67410023adea8d9aeda1051f5cc109374506ae6b56feefe663f",
      "cues": [
        {
          "id": 1,
          "start": 0.48,
          "end": 1.86,
          "en": "Now one other thing",
          "zh": ""
        },
        {
          "id": 2,
          "start": 1.86,
          "end": 4.59,
          "en": "that's worth noting about using the image component",
          "zh": ""
        },
        {
          "id": 3,
          "start": 4.59,
          "end": 8.76,
          "en": "on this image is that, as mentioned by default,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.76,
          "end": 11.73,
          "en": "NextJS sets this loading attribute",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.73,
          "end": 14.52,
          "en": "on the native image element to lazy,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.52,
          "end": 16.35,
          "en": "and that's the attribute that's supported",
          "zh": ""
        },
        {
          "id": 7,
          "start": 16.35,
          "end": 18.93,
          "en": "by all modern browsers that will make sure",
          "zh": ""
        },
        {
          "id": 8,
          "start": 18.93,
          "end": 20.4,
          "en": "that the image only loaded",
          "zh": ""
        },
        {
          "id": 9,
          "start": 20.4,
          "end": 22.683,
          "en": "and displayed if it's visible on the screen.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 23.73,
          "end": 25.32,
          "en": "Now the problem we have here",
          "zh": ""
        },
        {
          "id": 11,
          "start": 25.32,
          "end": 27.9,
          "en": "is that this image here is in the header,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 27.9,
          "end": 31.5,
          "en": "and therefore it will always be visible on the screen",
          "zh": ""
        },
        {
          "id": 13,
          "start": 31.5,
          "end": 33.6,
          "en": "when the page loads,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 33.6,
          "end": 37.08,
          "en": "so lazy loading this image here doesn't make any sense.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 37.08,
          "end": 41.64,
          "en": "Instead, it's just an unnecessary check for the browser",
          "zh": ""
        },
        {
          "id": 16,
          "start": 41.64,
          "end": 44.55,
          "en": "to find out whether this image needs to be loaded or not,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 44.55,
          "end": 47.22,
          "en": "because we as a developer already know",
          "zh": ""
        },
        {
          "id": 18,
          "start": 47.22,
          "end": 49.563,
          "en": "that it always needs to be loaded.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 50.58,
          "end": 53.88,
          "en": "So therefore, what you should do if you have an image",
          "zh": ""
        },
        {
          "id": 20,
          "start": 53.88,
          "end": 55.86,
          "en": "where you know with certainty",
          "zh": ""
        },
        {
          "id": 21,
          "start": 55.86,
          "end": 60.27,
          "en": "that it will be displayed on the screen when the page loads,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 60.27,
          "end": 63,
          "en": "is you should add another special prop",
          "zh": ""
        },
        {
          "id": 23,
          "start": 63,
          "end": 66.843,
          "en": "to this image component, the priority prop.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 68.34,
          "end": 70.8,
          "en": "This tells NextJS,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 70.8,
          "end": 72.72,
          "en": "and therefore in the end, the browser,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 72.72,
          "end": 75.9,
          "en": "that this image will always be visible when the page loads",
          "zh": ""
        },
        {
          "id": 27,
          "start": 75.9,
          "end": 78.93,
          "en": "and therefore when navigating to that page,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 78.93,
          "end": 81.78,
          "en": "NextJS would preload the image",
          "zh": ""
        },
        {
          "id": 29,
          "start": 81.78,
          "end": 84.75,
          "en": "and lazy loading will also be disabled",
          "zh": ""
        },
        {
          "id": 30,
          "start": 84.75,
          "end": 87.42,
          "en": "so that the browser doesn't need to check",
          "zh": ""
        },
        {
          "id": 31,
          "start": 87.42,
          "end": 89.91,
          "en": "whether the image should be loaded or not,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 89.91,
          "end": 92.763,
          "en": "but that it will instead always load it.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 94.02000000000001,
          "end": 95.88,
          "en": "So after adding priority here",
          "zh": ""
        },
        {
          "id": 34,
          "start": 95.88,
          "end": 98.52000000000001,
          "en": "and saving that file, if I reload,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 98.52000000000001,
          "end": 101.85,
          "en": "you see that now this lazy loading attribute",
          "zh": ""
        },
        {
          "id": 36,
          "start": 101.85,
          "end": 102.87,
          "en": "has been removed,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 102.87,
          "end": 105.6,
          "en": "and instead this fetchpriority,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 105.6,
          "end": 108.513,
          "en": "which is set to high, attribute has been added.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 109.41,
          "end": 111.47999999999999,
          "en": "And therefore you want to consider",
          "zh": ""
        },
        {
          "id": 40,
          "start": 111.47999999999999,
          "end": 114.36,
          "en": "adding this priority prop here",
          "zh": ""
        },
        {
          "id": 41,
          "start": 114.36,
          "end": 117.87,
          "en": "to all images where you know with certainty",
          "zh": ""
        },
        {
          "id": 42,
          "start": 117.87,
          "end": 121.98,
          "en": "that they will be visible after the page has been loaded.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 121.98,
          "end": 125.13,
          "en": "That's definitely something you should consider.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 125.13,
          "end": 126.81,
          "en": "And of course, as mentioned,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 126.81,
          "end": 128.76,
          "en": "there is more you can configure",
          "zh": ""
        },
        {
          "id": 46,
          "start": 128.76,
          "end": 131.19,
          "en": "depending on the exact use case you have,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 131.19,
          "end": 135.12,
          "en": "and there are more optimizations you could perform",
          "zh": ""
        },
        {
          "id": 48,
          "start": 135.12,
          "end": 135.953,
          "en": "on images like this,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 135.953,
          "end": 139.62,
          "en": "and therefore you absolutely want to check out",
          "zh": ""
        },
        {
          "id": 50,
          "start": 139.62,
          "end": 142.02,
          "en": "the official image optimization guide",
          "zh": ""
        },
        {
          "id": 51,
          "start": 142.02,
          "end": 145.653,
          "en": "to learn all about that if you need more specific settings.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 146.73,
          "end": 148.41,
          "en": "However, I now wanna move on",
          "zh": ""
        },
        {
          "id": 53,
          "start": 148.41,
          "end": 151.95,
          "en": "to the other images we have on this site,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 151.95,
          "end": 154.53,
          "en": "which are regular images,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 154.53,
          "end": 159.51,
          "en": "but which are images that have not been added by us,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 159.51,
          "end": 161.94,
          "en": "the developer, during development,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 161.94,
          "end": 164.97,
