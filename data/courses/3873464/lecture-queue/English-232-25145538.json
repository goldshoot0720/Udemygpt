          "zh": ""
        },
        {
          "id": 22,
          "start": 68.25,
          "end": 71.15,
          "en": "where we loop through all the featured events",
          "zh": ""
        },
        {
          "id": 23,
          "start": 71.15,
          "end": 72.6,
          "en": "but I will actually create",
          "zh": ""
        },
        {
          "id": 24,
          "start": 72.6,
          "end": 76.45,
          "en": "a brand new standard react component for that",
          "zh": ""
        },
        {
          "id": 25,
          "start": 76.45,
          "end": 78.73,
          "en": "because it is generally a good practice",
          "zh": ""
        },
        {
          "id": 26,
          "start": 78.73,
          "end": 82.45,
          "en": "to split your application and your JSX code",
          "zh": ""
        },
        {
          "id": 27,
          "start": 82.45,
          "end": 85,
