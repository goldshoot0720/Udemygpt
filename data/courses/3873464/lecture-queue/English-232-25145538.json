          "zh": ""
        },
        {
          "id": 50,
          "start": 156.46,
          "end": 158.51,
          "en": "that of course makes sense I would argue.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 159.79,
          "end": 163.3,
          "en": "Now in there, I will add any events sub-folder",
          "zh": ""
        },
        {
          "id": 52,
          "start": 163.3,
          "end": 168.12,
          "en": "where I wanna store all my events related components.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 168.12,
          "end": 170.51,
          "en": "and then in this events sub-folder",
          "zh": ""
        },
        {
          "id": 54,
          "start": 170.51,
          "end": 175.51,
          "en": "I will add a file and event-list.js file",
          "zh": ""
        },
        {
          "id": 55,
          "start": 176.18,
          "end": 179.123,
