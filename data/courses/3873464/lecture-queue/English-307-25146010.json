      "sourceHash": "fa4f0903606e5ce6646897c79fc4292e9acd35072d15c79f826ad15ebe688b94",
      "cues": [
        {
          "id": 1,
          "start": 2.182,
          "end": 3.14,
          "en": "{Maximilian Schwarzmuller} Now we worked on",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.14,
          "end": 5.2,
          "en": "the newsletter registration.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.2,
          "end": 7.22,
          "en": "Let's now work on the comments area",
          "zh": ""
        },
        {
          "id": 4,
          "start": 7.22,
          "end": 9.56,
          "en": "for our individual events.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 9.56,
          "end": 12.541,
          "en": "Here the goal is to again add an API route",
          "zh": ""
        },
        {
          "id": 6,
          "start": 12.541,
          "end": 15.61,
          "en": "which accepts incoming data,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 15.61,
          "end": 17.42,
          "en": "this entered data.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 17.42,
          "end": 20.81,
          "en": "And then for the moment just logs it to the console",
          "zh": ""
        },
        {
          "id": 9,
          "start": 20.81,
          "end": 25.15,
          "en": "But which in addition, all's returns data for GET requests.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 25.15,
          "end": 28,
          "en": "And the API routes should be dynamic,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 28,
          "end": 31.83,
          "en": "because the ID of the event to which the comment belongs,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 31.83,
          "end": 33.383,
          "en": "should be encoded in the URL.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 34.48,
          "end": 37.19,
          "en": "That was part of the instructions.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 37.19,
          "end": 41.84,
          "en": "Hence, I'll add another API route in the pages API folder",
          "zh": ""
        },
        {
          "id": 15,
          "start": 41.84,
          "end": 45.09,
          "en": "and I'll use square brackets in the file name here",
          "zh": ""
        },
        {
          "id": 16,
          "start": 45.09,
          "end": 48.08,
          "en": "since it will be a dynamic API route.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 48.08,
          "end": 52.18,
          "en": "And I'll name my dynamic path segment identifier here",
          "zh": ""
        },
        {
          "id": 18,
          "start": 52.18,
          "end": 57.057,
          "en": "event ID, because that is what should be encoded in the URL.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 58.56,
          "end": 60.08,
          "en": "Now we could leave it here",
          "zh": ""
        },
        {
          "id": 20,
          "start": 60.08,
          "end": 63.93,
          "en": "but I will actually create that file in a comments folder,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 63.93,
          "end": 67.28,
          "en": "so that the full API route to reach that file",
          "zh": ""
        },
        {
          "id": 22,
          "start": 67.28,
          "end": 71.13,
          "en": "and to execute the code in that file will later",
          "zh": ""
        },
        {
          "id": 23,
          "start": 71.13,
          "end": 74.68299999999999,
          "en": "be slash comments, slash some event ID.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 75.71000000000001,
          "end": 77.83,
          "en": "Because I think that is easier to read",
          "zh": ""
        },
        {
          "id": 25,
          "start": 77.83,
          "end": 82.12,
          "en": "and makes more sense than just slash some event ID.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 82.12,
          "end": 84.93,
          "en": "There it's not clear that this refers to comments.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 84.93,
          "end": 89.73,
          "en": "If the full path is slash comments, slash some event ID",
          "zh": ""
        },
        {
          "id": 28,
          "start": 89.73,
          "end": 91.42,
          "en": "that makes more sense.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 91.42,
          "end": 94.583,
          "en": "And of course there's slash API in front of all of that.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 95.66,
          "end": 98.75,
          "en": "So they offer here we can again define our handler function",
          "zh": ""
        },
        {
          "id": 31,
          "start": 98.75,
          "end": 101.38,
          "en": "which gets a request and a response.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 101.38,
          "end": 105.53999999999999,
          "en": "And export that inside of this event ID file,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 105.53999999999999,
          "end": 106.513,
          "en": "like this.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 107.75,
          "end": 111.32,
          "en": "And now in there, we need to handle two different cases.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 111.32,
          "end": 114.8,
          "en": "The case that it's a post request which we get",
          "zh": ""
        },
        {
          "id": 36,
          "start": 114.8,
          "end": 117.97,
          "en": "and the case that it's a GET request.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 117.97,
          "end": 121.36,
          "en": "Hence again, we can check the request method here",
          "zh": ""
        },
        {
          "id": 38,
          "start": 121.36,
          "end": 124.43,
          "en": "and check if it's post and then do something.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 124.43,
          "end": 125.863,
          "en": "And then also check,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 126.93,
          "end": 129.9,
          "en": "else if or in another if statement thereafter,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 129.9,
          "end": 132.92,
          "en": "if request method is GET.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 132.92,
          "end": 135.7,
          "en": "And if it's something totally else, we do nothing.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 135.7,
          "end": 138.96,
          "en": "And therefore we don't return a valid response",
          "zh": ""
        },
        {
          "id": 44,
          "start": 138.96,
          "end": 141.26,
          "en": "but that's fine because for this application",
          "zh": ""
        },
        {
          "id": 45,
          "start": 141.26,
          "end": 144.48,
          "en": "we don't intend any other usage.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 144.48,
          "end": 147.85,
          "en": "So now here we support post and GET requests",
          "zh": ""
        },
        {
          "id": 47,
          "start": 147.85,
          "end": 150.88,
          "en": "and we can now implement the different logic.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 150.88,
          "end": 153.1,
          "en": "Now in both cases, we need to know",
          "zh": ""
        },
        {
          "id": 49,
          "start": 153.1,
          "end": 156.21,
          "en": "for which event we should add a comment",
          "zh": ""
        },
        {
          "id": 50,
          "start": 156.21,
          "end": 158.27,
          "en": "or return to comments.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 158.27,
          "end": 160.65,
          "en": "That's why we made this dynamic.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 160.65,
          "end": 163.57999999999998,
          "en": "And hence, before we dive into any if block,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 163.57999999999998,
          "end": 168.01,
          "en": "we can already retrieve the event ID from request query.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 168.01,
          "end": 170.51,
          "en": "That's what you learned in the last section.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 170.51,
          "end": 174.42000000000002,
          "en": "This is how you can get access to the concrete value entered",
          "zh": ""
        },
        {
          "id": 56,
          "start": 174.42000000000002,
          "end": 178.37,
          "en": "in the path, as a value for this placeholder.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 178.37,
          "end": 182.22,
          "en": "So here it's requests query.event ID,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 182.22,
          "end": 185.48,
          "en": "because I chose event ID written like this",
          "zh": ""
        },
        {
          "id": 59,
          "start": 185.48,
          "end": 187.38,
          "en": "between my square brackets.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 187.38,
          "end": 189.84,
          "en": "If you chose a different identifier here",
          "zh": ""
        },
        {
          "id": 61,
          "start": 189.84,
          "end": 192.603,
          "en": "you have to choose a different property here.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 193.61,
          "end": 195.96,
          "en": "Now with that, I get my event ID though.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 195.96,
          "end": 198.72,
          "en": "Now what we want to do differs on",
          "zh": ""
        },
        {
          "id": 64,
          "start": 198.72,
          "end": 201.43,
          "en": "which request method we have though.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 201.43,
          "end": 203.21,
          "en": "If it's a post request,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 203.21,
          "end": 205.85,
          "en": "we get data for a new comment.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 205.85,
          "end": 210.85,
          "en": "So then we want to add server side validation here",
          "zh": ""
        },
        {
          "id": 68,
          "start": 210.97,
          "end": 213.32999999999998,
          "en": "because I mentioned that you can't trust",
          "zh": ""
        },
        {
          "id": 69,
          "start": 213.32999999999998,
          "end": 215.984,
          "en": "client site validation.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 215.984,
          "end": 220.984,
          "en": "Therefore here, I will add server side validation",
          "zh": ""
        },
        {
          "id": 71,
          "start": 221.07,
          "end": 224.17000000000002,
          "en": "and check if the enter data is correct.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 224.17000000000002,
          "end": 227.81,
          "en": "For this we first of all need to extract the entered data.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 227.81,
          "end": 230.51,
          "en": "So the data, which is part of the incoming requests",
          "zh": ""
        },
        {
          "id": 74,
          "start": 230.51,
          "end": 232.5,
          "en": "from the request body.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 232.5,
          "end": 236.61,
          "en": "And here I expect to get free pieces of data,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 236.61,
          "end": 238.75,
          "en": "which I'll pull out of the request body",
          "zh": ""
        },
        {
          "id": 77,
          "start": 238.75,
          "end": 241.61,
          "en": "with object de-structuring.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 241.61,
          "end": 245.09,
          "en": "I expect to get the email address of the user,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 245.09,
          "end": 248.92,
          "en": "who left a comment, the name of the user",
          "zh": ""
        },
        {
          "id": 80,
          "start": 248.92,
          "end": 251.77,
          "en": "and then the comment text.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 251.77,
          "end": 253.13,
          "en": "And therefore of course",
          "zh": ""
        },
        {
          "id": 82,
          "start": 253.13,
          "end": 256.11,
          "en": "when we later sent a request from the client.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 256.11,
          "end": 259.13,
          "en": "So from the front-end code, we need to make sure",
          "zh": ""
        },
        {
          "id": 84,
          "start": 259.13,
          "end": 262.75,
          "en": "that we include exactly these free properties",
          "zh": ""
        },
        {
          "id": 85,
          "start": 262.75,
          "end": 264.8,
          "en": "into our request data.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 264.8,
          "end": 268.07,
          "en": "That's our responsibility later.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 268.07,
          "end": 270.7,
          "en": "With that we'll then be able to extract it like this",
          "zh": ""
        },
        {
          "id": 88,
          "start": 270.7,
          "end": 273.02,
          "en": "from the incoming request body.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 273.02,
          "end": 275.39,
          "en": "And then we can add validation logic.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 275.39,
          "end": 280.39,
          "en": "We can check if not the email address includes add symbol",
          "zh": ""
        },
        {
          "id": 91,
          "start": 280.40999999999997,
          "end": 283.9,
          "en": "or if we don't have a valid name",
          "zh": ""
        },
        {
          "id": 92,
          "start": 283.9,
          "end": 287.37,
          "en": "or if name if we trim it,",
          "zh": ""
        },
        {
          "id": 93,
          "start": 287.37,
          "end": 288.71,
          "en": "is equal to an empty string",
          "zh": ""
        },
        {
          "id": 94,
          "start": 288.71,
          "end": 290.96,
          "en": "which would also be invalid.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 290.96,
          "end": 294.21,
          "en": "Or if we don't have a text or if the text",
          "zh": ""
        },
        {
          "id": 96,
          "start": 294.21,
          "end": 296.863,
          "en": "if we trim it, is equal to an empty string.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 299.98,
          "end": 303.045,
          "en": "If any of those conditions here is met,",
          "zh": ""
        },
        {
          "id": 98,
          "start": 303.045,
          "end": 305.05,
          "en": "the input is invalid.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 305.05,
          "end": 306.57,
          "en": "And then I want to return.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 306.57,
          "end": 309.71,
          "en": "I don't want to continue with the function execution.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 309.71,
          "end": 313.28,
          "en": "And I then also want to send back a response.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 313.28,
          "end": 315.54,
          "en": "With a status code of 422,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 315.54,
          "end": 318.13,
          "en": "which stands for invalid input",
          "zh": ""
        },
        {
          "id": 104,
          "start": 318.13,
          "end": 320.18,
          "en": "and some message of our choice.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 320.18,
          "end": 324.44,
          "en": "For example, we could say invalid input",
          "zh": ""
        },
        {
          "id": 106,
          "start": 324.44,
          "end": 327.86,
          "en": "of course you could add a more elaborate validation",
          "zh": ""
        },
        {
          "id": 107,
          "start": 327.86,
          "end": 329.763,
          "en": "but that's good enough for now.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 330.6,
          "end": 334.19,
          "en": "So with that, we validate the user input",
          "zh": ""
        },
        {
          "id": 109,
          "start": 334.19,
          "end": 336.76,
          "en": "as a next step, after this if check",
          "zh": ""
        },
        {
          "id": 110,
          "start": 336.76,
          "end": 339.47,
          "en": "but still in the post method if check",
          "zh": ""
        },
        {
          "id": 111,
          "start": 339.47,
          "end": 342.36,
          "en": "we want to do something.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 342.36,
          "end": 343.59000000000003,
          "en": "And for the moment again",
          "zh": ""
        },
        {
          "id": 113,
          "start": 343.59000000000003,
          "end": 346.73,
          "en": "I'll just console log the data which we received.",
          "zh": ""
        },
        {
          "id": 114,
          "start": 346.73,
          "end": 349.28,
          "en": "So I will console log, email,",
          "zh": ""
        },
        {
          "id": 115,
          "start": 349.28,
          "end": 351.3,
          "en": "name and text here.",
          "zh": ""
        },
        {
          "id": 116,
          "start": 351.3,
          "end": 353.6,
          "en": "We will soon do something where useful",
          "zh": ""
        },
        {
          "id": 117,
          "start": 353.6,
          "end": 355.253,
          "en": "but for the moment, that's it.",
          "zh": ""
        },
        {
          "id": 118,
          "start": 357.01,
          "end": 359.87,
          "en": "Thereafter, I want to send back a response",
          "zh": ""
        },
        {
          "id": 119,
          "start": 359.87,
          "end": 362.67,
          "en": "with a status code of 201",
          "zh": ""
        },
        {
          "id": 120,
          "start": 362.67,
          "end": 365.87,
          "en": "because we will have created a new comment.",
          "zh": ""
        },
        {
          "id": 121,
          "start": 365.87,
          "end": 367.49,
          "en": "We don't actually do it here,",
          "zh": ""
        },
        {
          "id": 122,
          "start": 367.49,
          "end": 369.64,
          "en": "but we will soon do so",
          "zh": ""
        },
        {
          "id": 123,
          "start": 369.64,
          "end": 372.67,
          "en": "and sent back some data in Jason format",
          "zh": ""
        },
        {
          "id": 124,
          "start": 372.67,
          "end": 377.193,
          "en": "where we could send back a message of added comment.",
          "zh": ""
        },
        {
          "id": 125,
          "start": 378.04,
          "end": 383.04,
          "en": "And actually we can, create a new comment object here.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 383.75,
          "end": 385.89,
          "en": "A new JavaScript object,",
          "zh": ""
        },
        {
          "id": 127,
          "start": 385.89,
          "end": 388.03,
          "en": "with some random ID.",
          "zh": ""
        },
        {
          "id": 128,
          "start": 388.03,
          "end": 391.2,
          "en": "For the moment I'll just use the current date time stamp",
          "zh": ""
        },
        {
          "id": 129,
          "start": 391.2,
          "end": 393.49,
          "en": "to create a dummy ID.",
          "zh": ""
        },
        {
          "id": 130,
          "start": 393.49,
          "end": 395.8,
          "en": "We will also soon have a better ID",
          "zh": ""
        },
        {
          "id": 131,
          "start": 395.8,
          "end": 397.97,
          "en": "but for the moment that's good enough.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 397.97,
          "end": 401.58,
          "en": "And then add email, name and text here as fields",
          "zh": ""
        },
        {
          "id": 133,
          "start": 401.58,
          "end": 403.09000000000003,
          "en": "in that object.",
          "zh": ""
        },
        {
          "id": 134,
          "start": 403.09000000000003,
          "end": 406.26,
          "en": "And therefore then, as part of the response",
          "zh": ""
        },
        {
