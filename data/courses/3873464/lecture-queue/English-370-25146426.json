          "en": "and set it to false.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 94.41,
          "end": 96.09,
          "en": "You might remember that I said",
          "zh": ""
        },
        {
          "id": 33,
          "start": 96.09,
          "end": 99.75,
          "en": "that when nextauth is used here on the back-end,",
          "zh": ""
        },
        {
          "id": 34,
