        },
        {
          "id": 50,
          "start": 138.67000000000002,
          "end": 142.12,
          "en": "or a little text here below the inputs.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 142.12,
          "end": 145.14,
          "en": "And to avoid that we are redirected,",
          "zh": ""
        },
        {
          "id": 52,
