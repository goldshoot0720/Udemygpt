        },
        {
          "id": 68,
          "start": 183.63,
          "end": 185.74,
          "en": "So, this will never throw an Error.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 185.74,
          "end": 187.43,
          "en": "It will never be rejected.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 187.43,
          "end": 190.25,
          "en": "It's just a content of this result object,",
