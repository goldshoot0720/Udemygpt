        },
        {
          "id": 80,
          "start": 218.66,
          "end": 221.4,
          "en": "And here I'm trying to access an email",
          "zh": ""
        },
        {
          "id": 81,
          "start": 221.4,
          "end": 223.37,
          "en": "and a password field.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 223.37,
          "end": 226.1,
          "en": "And therefore to make sure that this works,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 226.1,
          "end": 230.44,
          "en": "in auth-form besides setting redirect to false.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 230.44,
          "end": 232.35,
          "en": "We should also add in the email",
          "zh": ""
        },
        {
          "id": 85,
          "start": 232.35,
          "end": 234.387,
          "en": "and set this to enteredEmail.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 235.48,
          "end": 239.107,
          "en": "And add a password key and set this to enteredPassword.",
