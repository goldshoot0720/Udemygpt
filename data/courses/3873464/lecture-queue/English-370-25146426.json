          "zh": ""
        },
        {
          "id": 21,
          "start": 65.02,
          "end": 67,
          "en": "with which we wanna signIn.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 67,
          "end": 69.36,
          "en": "Because we could have multiple providers,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 69.36,
          "end": 71.51,
          "en": "in the same application.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 71.51,
          "end": 75.86,
          "en": "Here, It's the credentials provider,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 75.86,
          "end": 78.41,
          "en": "and hence we should write it like this.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 78.41,
          "end": 81.97,
          "en": "Then we can also pass a second argument here.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 81.97,
          "end": 83.99,
          "en": "That is a configuration object.",
