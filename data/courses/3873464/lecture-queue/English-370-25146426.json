        },
        {
          "id": 88,
          "start": 243.25,
          "end": 246.983,
          "en": "and I'll now just log that result here.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 248.1,
          "end": 250.42,
          "en": "And that's all we have to do when it comes",
          "zh": ""
        },
        {
          "id": 90,
          "start": 250.42,
          "end": 252.5,
          "en": "to signing users in.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 252.5,
          "end": 254.78,
          "en": "If we now save everything,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 254.78,
          "end": 258.4,
          "en": "we go back to that login page and reload it.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 258.4,
          "end": 260.72,
          "en": "If I enter a valid email here,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 260.72,
          "end": 263.88,
          "en": "but invalid password and I click login.",
