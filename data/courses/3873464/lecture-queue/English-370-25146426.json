          "en": "of the signIn method.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 151.3,
          "end": 153.86,
          "en": "So, in this configuration object.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 153.86,
          "end": 157.15,
          "en": "Now when setting redirect to false,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 157.15,
          "end": 159.13,
          "en": "signIn we'll actually return up promise",
          "zh": ""
        },
        {
          "id": 57,
          "start": 159.13,
          "end": 162.17000000000002,
          "en": "which eventually yields us our result.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 162.17000000000002,
          "end": 164.4,
          "en": "The promise will always resolve.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 164.4,
          "end": 165.93,
          "en": "It will not be rejected.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 165.93,
          "end": 167.82,
          "en": "Even if we have an error",
          "zh": ""
        },
        {
          "id": 61,
          "start": 167.82,
          "end": 170.22,
          "en": "in our back-end authentication code.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 170.22,
          "end": 171.87,
          "en": "But if we had an error there,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 171.87,
          "end": 173.44,
          "en": "result would be an object",
          "zh": ""
        },
        {
          "id": 64,
          "start": 173.44,
          "end": 176.14,
          "en": "that contains information about the error.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 176.14,
          "end": 179.05,
          "en": "If we have no error during authentication,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 179.05,
          "end": 181.06,
          "en": "result is still an object,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 181.06,
          "end": 183.63,
          "en": "but without the error information.",
