          "zh": ""
        },
        {
          "id": 54,
          "start": 138.99,
          "end": 140.67000000000002,
          "en": "and navigate into this folder.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 140.67000000000002,
          "end": 142.98,
          "en": "And for that here I'm using the built-in terminal",
          "zh": ""
        },
        {
          "id": 56,
          "start": 142.98,
          "end": 145.05,
