          "zh": ""
        },
        {
          "id": 57,
          "start": 145.05,
          "end": 147.15,
          "en": "into that folder by default",
          "zh": ""
        },
        {
          "id": 58,
          "start": 147.15,
          "end": 148.56,
          "en": "And run \"npm install\"",
          "zh": ""
        },
        {
          "id": 59,
          "start": 148.56,
          "end": 151.5,
          "en": "to install any extra third party packages",
          "zh": ""
        },
        {
          "id": 60,
          "start": 151.5,
          "end": 154.47,
          "en": "that are needed to build and run and preview",
          "zh": ""
        },
        {
          "id": 61,
          "start": 154.47,
          "end": 157.11,
          "en": "your React application.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 157.11,
          "end": 159.54,
          "en": "Once that's done, you can run \"npm start\"",
          "zh": ""
        },
        {
          "id": 63,
          "start": 159.54,
          "end": 163.11,
          "en": "when using a project created with Create React App.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 163.11,
          "end": 165.69,
          "en": "And \"npm run dev\" when using Vite,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 165.69,
          "end": 167.34,
          "en": "which I do here.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 167.34,
          "end": 170.04,
          "en": "And then you can visit the website on this address,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 170.04,
          "end": 172.2,
          "en": "which should be output in the terminal",
