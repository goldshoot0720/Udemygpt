    {
      "id": "43341204",
      "title": "Triggering Different Server Actions via Query Parameters",
      "lectureOrder": 220,
      "videoOrder": 206,
      "sourceHash": "f623647e4b724288b1a942d1efb938974f9954a694802768e6f4a30383723888",
      "cues": [
        {
          "id": 1,
          "start": 0.48,
          "end": 1.77,
          "en": "So in the end here,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 1.77,
          "end": 6.603,
          "en": "I wanna set a different server action depending on the mode.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.5,
          "end": 10.32,
          "en": "And we can achieve this by going",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.32,
          "end": 13.14,
          "en": "to our auth actions file.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.14,
          "end": 17.64,
          "en": "And there I'll add a new third Server action,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.64,
          "end": 18.9,
          "en": "which I'll name auth.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.01,
          "end": 23.94,
          "en": "And here I expect to get my mode",
          "zh": ""
        },
        {
          "id": 8,
          "start": 23.94,
          "end": 28.44,
          "en": "as a parameter followed by the previous state",
          "zh": ""
        },
        {
          "id": 9,
          "start": 28.44,
          "end": 30.423,
          "en": "and the form data.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 32.22,
          "end": 37.22,
          "en": "And I then wanna check if the mode is equal to log in.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 37.32,
          "end": 41.31,
          "en": "And if that's the case, I want to call that log in function,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 41.31,
          "end": 44.8,
          "en": "that log in Server action and return that call",
          "zh": ""
        },
        {
          "id": 13,
          "start": 45.66,
          "end": 49.113,
          "en": "and pass that previous state and the form data to it.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 50.43,
          "end": 53.94,
          "en": "Otherwise, I'll return the result of calling signup",
          "zh": ""
        },
        {
          "id": 15,
          "start": 53.94,
          "end": 57.243,
          "en": "and passing previous state and form data to it.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 58.89,
          "end": 62.25,
          "en": "So that I use this as a helper Server action",
          "zh": ""
        },
        {
          "id": 17,
          "start": 62.25,
          "end": 66.063,
          "en": "to call the appropriate Server action depending on the mode.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 67.05,
          "end": 70.83,
          "en": "Now, it's now that auth Server action that I want",
          "zh": ""
        },
        {
          "id": 19,
          "start": 70.83,
          "end": 72.843,
          "en": "to use in my auth form.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 73.92,
          "end": 78.69,
          "en": "So here it's that auth Server action instead",
          "zh": ""
        },
        {
          "id": 21,
          "start": 78.69,
          "end": 80.343,
          "en": "of the signup Server action.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 81.33,
          "end": 85.47,
          "en": "However, this auth Server action now needs to get",
          "zh": ""
        },
        {
          "id": 23,
          "start": 85.47,
          "end": 88.833,
          "en": "that mode information, and by default it wouldn't.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 90.42,
          "end": 93.96000000000001,
          "en": "Now you can add extra data that will be added",
          "zh": ""
        },
        {
          "id": 25,
          "start": 93.96000000000001,
          "end": 95.7,
          "en": "to the Server action, though",
          "zh": ""
        },
        {
          "id": 26,
          "start": 95.7,
          "end": 100.173,
          "en": "by calling the bind method on this Server action function.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 101.28,
          "end": 103.5,
          "en": "The bind method is a default method",
          "zh": ""
        },
        {
          "id": 28,
          "start": 103.5,
          "end": 106.2,
          "en": "that exists in JavaScript, which you can use",
          "zh": ""
        },
        {
          "id": 29,
          "start": 106.2,
          "end": 109.47,
          "en": "to preconfigure functions",
          "zh": ""
        },
        {
          "id": 30,
          "start": 109.47,
          "end": 111.39,
          "en": "so that when they will be executed,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 111.39,
          "end": 114.47999999999999,
          "en": "they will be preconfigured in a certain way.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 114.47999999999999,
          "end": 116.58,
          "en": "And you can, for example, preconfigure",
          "zh": ""
        },
        {
          "id": 33,
          "start": 116.58,
          "end": 120.72,
          "en": "what this keyword in that function will refer to.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 120.72,
          "end": 122.1,
          "en": "And you do that with help",
          "zh": ""
        },
        {
          "id": 35,
          "start": 122.1,
          "end": 124.62,
          "en": "of the first argument you pass to bind.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 124.62,
          "end": 127.86,
          "en": "But I don't care about that here, so I'll set this to null,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 127.86,
          "end": 131.43,
          "en": "but any other extra argument you add thereafter",
          "zh": ""
        },
        {
          "id": 38,
          "start": 131.43,
          "end": 134.7,
          "en": "will actually be passed as a parameter",
          "zh": ""
        },
        {
          "id": 39,
          "start": 134.7,
          "end": 137.94,
          "en": "into this function when it's being called.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 137.94,
          "end": 140.94,
          "en": "And that will be that mode then.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 140.94,
          "end": 142.89,
          "en": "So that mode should be passed",
          "zh": ""
        },
        {
          "id": 42,
          "start": 142.89,
          "end": 146.67000000000002,
          "en": "as an extra argument into auth when it's being",
          "zh": ""
        },
        {
          "id": 43,
          "start": 146.67000000000002,
          "end": 147.933,
          "en": "called in the future.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 149.97,
          "end": 153.96,
          "en": "And that's one way of making sure",
          "zh": ""
        },
        {
          "id": 45,
          "start": 153.96,
          "end": 157.68,
          "en": "that different Server Actions will be called",
          "zh": ""
        },
        {
          "id": 46,
          "start": 157.68,
          "end": 159.03300000000002,
          "en": "depending on the mode.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 159.96,
          "end": 161.76,
          "en": "So if you save that and you reload",
          "zh": ""
        },
        {
          "id": 48,
          "start": 161.76,
          "end": 164.28,
          "en": "and you are in login mode,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 164.28,
          "end": 167.67000000000002,
          "en": "and you try to log in with a nonexisting user,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 167.67000000000002,
          "end": 171.36,
          "en": "which I here do, this is a user I have not created,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 171.36,
          "end": 174.273,
          "en": "if I click login, I get this error.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 175.65,
          "end": 179.79,
          "en": "If I on the other hand, use a valid email address",
          "zh": ""
        },
        {
          "id": 53,
          "start": 179.79,
          "end": 183.99,
          "en": "and a valid password, so the correct password for",
          "zh": ""
        },
        {
          "id": 54,
          "start": 183.99,
          "end": 188.01,
          "en": "that email address, I'm redirected to that training page",
          "zh": ""
        },
        {
          "id": 55,
          "start": 188.01,
          "end": 191.01,
          "en": "because now the user was logged in",
          "zh": ""
        },
        {
          "id": 56,
          "start": 191.01,
          "end": 194.28,
          "en": "and that off cookie was set.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 194.28,
          "end": 195.9,
          "en": "And that's therefore, now of course,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 195.9,
          "end": 198.27,
          "en": "another huge step forward",
          "zh": ""
        },
        {
          "id": 59,
          "start": 198.27,
          "end": 203.27,
          "en": "because this now is a working log in process.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 203.55,
          "end": 207.87,
          "en": "Now as a last step, I actually also wanna make sure",
          "zh": ""
        },
        {
          "id": 61,
          "start": 207.87,
          "end": 211.02,
          "en": "that we have a header here at the top if the user",
          "zh": ""
        },
        {
          "id": 62,
          "start": 211.02,
          "end": 212.19,
          "en": "is logged in.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 212.19,
          "end": 216.21,
          "en": "And that header should then contain a logout button,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 216.21,
          "end": 219.09,
          "en": "which we can press to clear that cookie",
          "zh": ""
        },
        {
          "id": 65,
          "start": 219.09,
          "end": 221.94299999999998,
          "en": "and to, well, lock the user out.",
          "zh": ""
        }
      ]
    }
