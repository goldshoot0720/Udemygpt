  "lectures": [
    {
      "id": "43340962",
      "title": "Setting Up Data Caching For Custom Data Sources",
      "lectureOrder": 190,
      "videoOrder": 176,
      "sourceHash": "2435978bd3f6fe4931f6bb4df325cb6a3e77bb4d2820796ede8b797046a666af",
      "cues": [
        {
          "id": 1,
          "start": 1.02,
          "end": 4.56,
          "en": "So having that request deduplication is nice.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.56,
          "end": 7.17,
          "en": "It would also be nice to have",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.17,
          "end": 10.08,
          "en": "that data cache functionality though,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.08,
          "end": 12.03,
          "en": "which we also get out of the box",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.03,
          "end": 13.623,
          "en": "when using the fetch function.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.55,
          "end": 18.72,
          "en": "Now for our own functions and our own data sources,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.72,
          "end": 23.55,
          "en": "we can enable caching by importing another function,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 23.55,
          "end": 28.55,
          "en": "this time, a function that must be imported from next/cache.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 30.57,
          "end": 33.63,
          "en": "And here it's the unstable_cache function.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 33.63,
          "end": 35.94,
          "en": "So another function called cache,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 35.94,
          "end": 40.02,
          "en": "though just as with the unstable_no_store function,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 40.02,
          "end": 43.08,
          "en": "at the point of time where you are viewing this,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 43.08,
          "end": 45.96,
          "en": "this might no longer be marked as unstable",
          "zh": ""
        },
        {
          "id": 14,
          "start": 45.96,
          "end": 49.2,
          "en": "and it might therefore just be called cache.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 49.2,
          "end": 50.91,
          "en": "And then to avoid name clashes,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 50.91,
          "end": 54.093,
          "en": "you might want to assign an alias here.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 55.29,
          "end": 58.23,
          "en": "Now, at the point of time where I'm recording this,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 58.23,
          "end": 60.72,
          "en": "it's still is marked as unstable.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 60.72,
          "end": 63.72,
          "en": "I'll still assign that alias here though,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 63.72,
          "end": 65.35,
          "en": "but we can still use it",
          "zh": ""
        },
        {
          "id": 21,
          "start": 66.57,
          "end": 69.03,
          "en": "and we use it in a kind of similar way",
          "zh": ""
        },
        {
          "id": 22,
          "start": 69.03,
          "end": 73.11,
          "en": "as we used this cache function provided by React.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 73.11,
          "end": 77.28,
          "en": "You wrap this unstable_cache function,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 77.28,
          "end": 80.223,
          "en": "or in my case since I renamed it nextCache,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 82.14,
          "end": 86.07,
          "en": "you wrap that around the function that should be cached,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 86.07,
          "end": 89.01,
          "en": "which can be a function that's already wrapped by cache,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 89.01,
          "end": 90.66,
          "en": "that's fine.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 90.66,
          "end": 93.72,
          "en": "So now I got multiple layers of wrapping going on here,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 93.72,
          "end": 96.47999999999999,
          "en": "but the inner cache wrapping here",
          "zh": ""
        },
        {
          "id": 30,
          "start": 96.47999999999999,
          "end": 98.75999999999999,
          "en": "is for a request deduplication.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 98.75999999999999,
          "end": 100.35,
          "en": "The outer wrapping,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 100.35,
          "end": 102.21000000000001,
          "en": "the nextCache function here,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 102.21000000000001,
          "end": 106.8,
          "en": "is for making this data that's returned by that function",
          "zh": ""
        },
        {
          "id": 34,
          "start": 106.8,
          "end": 109.803,
          "en": "cacheable by NextJS in its data cache.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 110.7,
          "end": 114.3,
          "en": "And with nextCache wrapped around this function,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 114.3,
          "end": 117.21000000000001,
          "en": "I will now get an error",
          "zh": ""
        },
        {
          "id": 37,
          "start": 117.21000000000001,
          "end": 120.33,
          "en": "when trying to load the messages page.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 120.33,
          "end": 121.65,
          "en": "The reason for that is",
          "zh": ""
        },
        {
          "id": 39,
          "start": 121.65,
          "end": 126.06,
          "en": "that nextCache actually always returns a promise.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 126.06,
          "end": 128.04,
          "en": "So it returns to cached data,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 128.04,
          "end": 129.813,
          "en": "but wrapped in a promise.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 131.25,
          "end": 134.01,
          "en": "Previously, get messages did not yield a promise.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 134.01,
          "end": 136.98,
          "en": "Now, because I wrapped it with nextCache.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 136.98,
          "end": 139.92000000000002,
          "en": "So with unstable_cache, it does,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 139.92000000000002,
          "end": 144.03,
          "en": "and hence we must bring back the async keyword here",
          "zh": ""
        },
        {
          "id": 46,
          "start": 144.03,
          "end": 146.34,
          "en": "on the components that use get messages",
          "zh": ""
        },
        {
          "id": 47,
          "start": 146.34,
          "end": 147.903,
          "en": "and add await here,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 149.76,
          "end": 152.37,
          "en": "and also do that in the layout",
          "zh": ""
        },
        {
          "id": 49,
          "start": 152.37,
          "end": 154.653,
          "en": "and have async await here as well.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 156.66,
          "end": 159.153,
          "en": "With that added, the application works again,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 160.07999999999998,
          "end": 163.86,
          "en": "and now you'll see that if I clear this",
          "zh": ""
        },
        {
          "id": 52,
          "start": 163.86,
          "end": 165.93,
          "en": "and restart the development server,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 165.93,
          "end": 170.883,
          "en": "that if I reload this messages page, I got no log here.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 171.93,
          "end": 176.07,
          "en": "So this log where I log that I'm fetching messages from",
          "zh": ""
        },
        {
          "id": 55,
          "start": 176.07,
          "end": 178.92000000000002,
          "en": "the database, I don't see that here",
          "zh": ""
        },
        {
          "id": 56,
          "start": 178.92000000000002,
          "end": 180.93,
          "en": "no matter how often I reload",
          "zh": ""
        },
        {
          "id": 57,
          "start": 180.93,
          "end": 183.12,
          "en": "because now indeed the data",
          "zh": ""
        },
        {
          "id": 58,
          "start": 183.12,
          "end": 185.13,
          "en": "that was retrieved from the database",
          "zh": ""
        },
        {
          "id": 59,
          "start": 185.13,
          "end": 187.083,
          "en": "is cached and is reused.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 188.22,
          "end": 193.17,
          "en": "Now the nextCache function actually has another argument,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 193.17,
          "end": 196.53,
          "en": "a second argument, which you should also specify,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 196.53,
          "end": 200.01,
          "en": "and that's an array of cache keys,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 200.01,
          "end": 204,
          "en": "which is then used internally to identify cached data.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 204,
          "end": 206.343,
          "en": "For example, messages, it's up to you.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 207.32999999999998,
          "end": 210.87,
          "en": "This is not to be confused with the tags you can assign.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 210.87,
          "end": 212.64,
          "en": "You will see how to assign tags",
          "zh": ""
        },
        {
          "id": 67,
          "start": 212.64,
          "end": 214.62,
          "en": "to your own cached data later.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 214.62,
          "end": 217.02,
          "en": "This is just used internally,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 217.02,
          "end": 220.68,
          "en": "but with that, you can then make NextJS cache data",
          "zh": ""
        },
        {
          "id": 70,
          "start": 220.68,
          "end": 222.153,
          "en": "from your own data source.",
          "zh": ""
        }
      ]
    }
