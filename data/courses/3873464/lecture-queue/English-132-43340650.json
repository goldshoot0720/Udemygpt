  "lectures": [
    {
      "id": "43340650",
      "title": "Configuring Catch-All Routes",
      "lectureOrder": 142,
      "videoOrder": 132,
      "sourceHash": "99ef3fefbc63ab0085107d07e875fb2ae2d549f07bcd35361bd1688e3108cb8f",
      "cues": [
        {
          "id": 1,
          "start": 0.48,
          "end": 3.27,
          "en": "At the moment in this application here,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.27,
          "end": 6.99,
          "en": "whenever I pick one of my years here,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.99,
          "end": 9.87,
          "en": "I see the articles that belong to the year,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.87,
          "end": 12.18,
          "en": "but of course my navigation here,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.18,
          "end": 16.65,
          "en": "these years disappear and I also can't dive in deeper",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.65,
          "end": 19.14,
          "en": "and, for example, pick a month",
          "zh": ""
        },
        {
          "id": 7,
          "start": 19.14,
          "end": 21.243,
          "en": "for which I want to view the news.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.77,
          "end": 24.9,
          "en": "Now, we could try to solve that",
          "zh": ""
        },
        {
          "id": 9,
          "start": 24.9,
          "end": 28.5,
          "en": "by adding some kind of layout here, some nested layout,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 28.5,
          "end": 31.23,
          "en": "that belongs to this parallel route,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 31.23,
          "end": 33.54,
          "en": "but I'll actually solve it by using",
          "zh": ""
        },
        {
          "id": 12,
          "start": 33.54,
          "end": 37.56,
          "en": "yet another feature NextJS offers.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 37.56,
          "end": 39.06,
          "en": "I'll fix this problem",
          "zh": ""
        },
        {
          "id": 14,
          "start": 39.06,
          "end": 41.58,
          "en": "by turning this dynamic route here",
          "zh": ""
        },
        {
          "id": 15,
          "start": 41.58,
          "end": 46.58,
          "en": "from a standard dynamic route into a catch all route.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 47.7,
          "end": 48.81,
          "en": "Now we can do that",
          "zh": ""
        },
        {
          "id": 17,
          "start": 48.81,
          "end": 51.66,
          "en": "by actually using two square brackets",
          "zh": ""
        },
        {
          "id": 18,
          "start": 51.66,
          "end": 54.93,
          "en": "instead of just one pair of square brackets",
          "zh": ""
        },
        {
          "id": 19,
          "start": 54.93,
          "end": 59.07,
          "en": "and by adding three dots here in front of some identifier",
          "zh": ""
        },
        {
          "id": 20,
          "start": 59.07,
          "end": 59.903,
          "en": "of your choice,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 59.903,
          "end": 62.793,
          "en": "and here I'll rename that identifier to filter.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 63.69,
          "end": 66.72,
          "en": "Now that might look a bit weird,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 66.72,
          "end": 70.28999999999999,
          "en": "but what this will actually do is it will make sure",
          "zh": ""
        },
        {
          "id": 24,
          "start": 70.28999999999999,
          "end": 72.39,
          "en": "that this page.js file",
          "zh": ""
        },
        {
          "id": 25,
          "start": 72.39,
          "end": 75.51,
          "en": "inside of that strangely named folder",
          "zh": ""
        },
        {
          "id": 26,
          "start": 75.51,
          "end": 80.51,
          "en": "will be activated for any path segments after archive",
          "zh": ""
        },
        {
          "id": 27,
          "start": 81.24,
          "end": 82.14,
          "en": "in this case.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 82.14,
          "end": 85.28999999999999,
          "en": "No matter how many segments we have there,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 85.28999999999999,
          "end": 88.14,
          "en": "and no matter how they're named.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 88.14,
          "end": 90.87,
          "en": "Inside of this page.js file,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 90.87,
          "end": 94.71000000000001,
          "en": "this params value there for also changes",
          "zh": ""
        },
        {
          "id": 32,
          "start": 94.71000000000001,
          "end": 97.59,
          "en": "or this property here changes.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 97.59,
          "end": 100.68,
          "en": "We no longer have a year property here",
          "zh": ""
        },
        {
          "id": 34,
          "start": 100.68,
          "end": 103.25999999999999,
          "en": "because I renamed this to filter.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 103.25999999999999,
          "end": 106.17,
          "en": "So even though we have these three dots in front of it,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 106.17,
          "end": 110.1,
          "en": "we can actually still access the actual value",
          "zh": ""
        },
        {
          "id": 37,
          "start": 110.1,
          "end": 112.41,
          "en": "that will be encoded in the URL,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 112.41,
          "end": 115.233,
          "en": "but the name is now filter because I changed the name.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 116.64,
          "end": 121.64,
          "en": "However, filter now also isn't a single value anymore.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 121.89,
          "end": 124.11,
          "en": "Instead it's a catch all route",
          "zh": ""
        },
        {
          "id": 41,
          "start": 124.11,
          "end": 129.11,
          "en": "and it catches all path segments after archive,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 129.12,
          "end": 132.5,
          "en": "which could be no segments at all if we just visited",
          "zh": ""
        },
        {
          "id": 43,
          "start": 132.5,
          "end": 137.1,
          "en": "/archive and then nothing after that,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 137.1,
          "end": 142.1,
          "en": "but it could be one segment if we visited /archive/2024.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 142.68,
          "end": 147.68,
          "en": "Or two segments if we visited /archive/2024/three",
          "zh": ""
        },
        {
          "id": 46,
          "start": 149.55,
          "end": 153.36,
          "en": "to show the news for the month March and so on.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 153.36,
          "end": 156.6,
          "en": "So filter will give us an array",
          "zh": ""
        },
        {
          "id": 48,
          "start": 156.6,
          "end": 160.05,
          "en": "of all the matched segments",
          "zh": ""
        },
        {
          "id": 49,
          "start": 160.05,
          "end": 164.19,
          "en": "and therefore I'll rename my constant here to filter.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 164.19,
          "end": 166.26,
          "en": "And to understand how it works,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 166.26,
          "end": 169.21,
          "en": "I will console.log(filter) here",
          "zh": ""
        },
        {
          "id": 52,
          "start": 170.31,
          "end": 173.67000000000002,
          "en": "and I will temporarily comment out this part here",
          "zh": ""
        },
        {
          "id": 53,
          "start": 173.67000000000002,
          "end": 175.82999999999998,
          "en": "because it won't work right now,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 175.82999999999998,
          "end": 179.28,
          "en": "and I'll instead return just some dummy paragraph",
          "zh": ""
        },
        {
          "id": 55,
          "start": 179.28,
          "end": 180.993,
          "en": "so that we return something.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 182.1,
          "end": 184.17,
          "en": "Now with those changes made,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 184.17,
          "end": 187.68,
          "en": "you should actually get an error here in the terminal",
          "zh": ""
        },
        {
          "id": 58,
          "start": 187.68,
          "end": 189.81,
          "en": "where you ran your development server,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 189.81,
          "end": 191.4,
          "en": "or at least you should get one,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 191.4,
          "end": 194.61,
          "en": "if you stop it and you try to restart it.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 194.61,
          "end": 198.18,
          "en": "You should get an error that you cannot define a route",
          "zh": ""
        },
        {
          "id": 62,
          "start": 198.18,
          "end": 203.013,
          "en": "with the same specificity as a optional catch all route.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 204.18,
          "end": 205.86,
          "en": "Now what this means in the end",
          "zh": ""
        },
        {
          "id": 64,
          "start": 205.86,
          "end": 210.86,
          "en": "is just that now we have two conflicting page.js files.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 211.02,
          "end": 213.54,
          "en": "Because I just mentioned this part here",
          "zh": ""
        },
        {
          "id": 66,
          "start": 213.54,
          "end": 217.29,
          "en": "and therefore this page will catch all the segments,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 217.29,
          "end": 220.713,
          "en": "all the path segments, after archive.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 222.06,
          "end": 227.06,
          "en": "But we try to load this page.js if we visit /archive,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 227.22,
          "end": 230.91,
          "en": "but we now also try to load this page.js file.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 230.91,
          "end": 232.44,
          "en": "And that won't work,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 232.44,
          "end": 237.42000000000002,
          "en": "therefore, I will actually grab this header here",
          "zh": ""
        },
        {
          "id": 72,
          "start": 237.42000000000002,
          "end": 240,
          "en": "and cut that from this page.js file,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 240,
          "end": 244.96,
          "en": "which is directly in at archive and get rid of it here",
          "zh": ""
        },
        {
          "id": 74,
          "start": 246.12,
          "end": 249.57,
          "en": "and instead go to my nested page.js file,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 249.57,
          "end": 251.7,
          "en": "which is in that filter folder",
          "zh": ""
        },
        {
          "id": 76,
          "start": 251.7,
          "end": 254.613,
          "en": "and output that there, this header.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 255.66,
          "end": 259.75,
          "en": "Of course, I still need to get my links here",
          "zh": ""
        },
        {
          "id": 78,
          "start": 260.82,
          "end": 263.793,
          "en": "and therefore I'll still call getavailableNewsYears.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 265.08,
          "end": 266.76,
          "en": "Just as before.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 266.76,
          "end": 268.08299999999997,
          "en": "That does not change.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 269.64,
          "end": 271.77,
          "en": "And we also still must make sure",
          "zh": ""
        },
        {
          "id": 82,
          "start": 271.77,
          "end": 275.253,
          "en": "that this link component from next link is imported.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 277.53,
          "end": 280.86,
          "en": "But with that, we now have just one page.js file",
          "zh": ""
        },
        {
          "id": 84,
          "start": 280.86,
          "end": 282.54,
          "en": "in this parallel route,",
          "zh": ""
        },
        {
          "id": 85,
          "start": 282.54,
          "end": 285.104,
          "en": "and it's that one file that will now be loaded",
          "zh": ""
        },
        {
          "id": 86,
          "start": 285.104,
          "end": 288.06,
          "en": "no matter which path segments",
          "zh": ""
        },
        {
          "id": 87,
          "start": 288.06,
          "end": 292.203,
          "en": "or how many path segments we have after /archive.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 293.73,
          "end": 295.05,
          "en": "With that change made,",
          "zh": ""
        },
        {
          "id": 89,
          "start": 295.05,
          "end": 300.05,
          "en": "if you now save this and you restart the development server,",
          "zh": ""
        },
        {
          "id": 90,
          "start": 300.63,
          "end": 304.14,
          "en": "it should now restart without an error again,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 304.14,
          "end": 306.06,
          "en": "and if you reload /archive,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 306.06,
          "end": 308.67,
          "en": "you should again see that list,",
          "zh": ""
        },
        {
          "id": 93,
          "start": 308.67,
          "end": 313.08,
          "en": "but you should now also see some log here,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 313.08,
          "end": 317.01,
          "en": "which at the moment says undefined in the terminal",
          "zh": ""
        },
        {
          "id": 95,
          "start": 317.01,
          "end": 319.98,
          "en": "where you started the development server,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 319.98,
          "end": 322.563,
          "en": "and that log is coming from this line here.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 323.58,
          "end": 326.13,
          "en": "Now it should say something else than undefined",
          "zh": ""
        },
        {
          "id": 98,
          "start": 326.13,
          "end": 328.77,
          "en": "if you visit 2024.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 328.77,
          "end": 331.62,
          "en": "Then you should actually get an array here,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 331.62,
          "end": 334.89,
          "en": "which includes the string 2024.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 334.89,
          "end": 338.55,
          "en": "Because I mentioned this filter property here",
          "zh": ""
        },
        {
          "id": 102,
          "start": 338.55,
          "end": 343.55,
          "en": "will now hold an array of all the matched path segments.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 343.56,
          "end": 346.23,
          "en": "And that's also why the page itself didn't change now",
          "zh": ""
        },
        {
          "id": 104,
          "start": 346.23,
          "end": 348.48,
          "en": "because it's now always the same page",
          "zh": ""
        },
        {
          "id": 105,
          "start": 348.48,
          "end": 351.54,
          "en": "we're showing for all these different segments.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 351.54,
          "end": 354.45,
          "en": "But of course we can now use that data,",
          "zh": ""
        },
        {
          "id": 107,
          "start": 354.45,
          "end": 359.223,
          "en": "that filter array data, to update what we see on the page.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
