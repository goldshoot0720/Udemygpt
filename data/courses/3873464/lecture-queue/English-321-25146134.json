          "end": 344.09000000000003,
          "en": "and it changes to success.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 344.09000000000003,
          "end": 346.81,
          "en": "It never disappears, we'll work on this later,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 346.81,
          "end": 349.09000000000003,
          "en": "for the moment it's always there.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 349.09000000000003,
          "end": 351.78,
          "en": "Now let's test it with an error,",
          "zh": ""
        },
        {
          "id": 111,
          "start": 351.78,
          "end": 356.4,
          "en": "and for this all dive into my db-util.js file",
          "zh": ""
        },
        {
          "id": 112,
          "start": 356.4,
          "end": 359.32,
          "en": "and break my mongodb credentials again,",
          "zh": ""
        },
        {
          "id": 113,
          "start": 359.32,
          "end": 361.64,
          "en": "so that connecting to the database",
          "zh": ""
        },
        {
          "id": 114,
          "start": 361.64,
          "end": 363.89,
          "en": "and inserting data will fail.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 363.89,
          "end": 366.86,
          "en": "If I do that and I try the same request again",
          "zh": ""
        },
        {
          "id": 116,
          "start": 366.86,
