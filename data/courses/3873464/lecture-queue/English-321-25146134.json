          "en": "we start with pending, but then we go to the error case",
          "zh": ""
        },
        {
          "id": 117,
          "start": 370.7,
          "end": 373.73,
          "en": "and we see that error message at the bottom.",
          "zh": ""
        },
        {
          "id": 118,
          "start": 373.73,
          "end": 374.85,
          "en": "Now it's of course up to you",
          "zh": ""
        },
        {
          "id": 119,
          "start": 374.85,
