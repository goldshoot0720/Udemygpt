          "start": 3.19,
          "end": 5.67,
          "en": "with the newsletter-registration.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.67,
          "end": 10.1,
          "en": "For this we have the newsletter-registration component",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.1,
          "end": 11.4,
          "en": "in the input folder",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.4,
          "end": 14.76,
          "en": "and there we're sending this HTTP request.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.76,
          "end": 17.48,
          "en": "Now I wanna show the pending notification",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.48,
          "end": 21.33,
