  "lectures": [
    {
      "id": "43341074",
      "title": "Understanding Layout Metadata",
      "lectureOrder": 204,
      "videoOrder": 190,
      "sourceHash": "2e45a0c58dfbd18bd1264dbfc88cbbc398f2cc3f04eb6c9b37f023f61409b424",
      "cues": [
        {
          "id": 1,
          "start": 0.51,
          "end": 2.31,
          "en": "So you can set metadata",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.31,
          "end": 4.59,
          "en": "in your NextJS applications",
          "zh": ""
        },
        {
          "id": 3,
          "start": 4.59,
          "end": 7.2,
          "en": "by either setting static metadata",
          "zh": ""
        },
        {
          "id": 4,
          "start": 7.2,
          "end": 9.09,
          "en": "with help of the metadata constant",
          "zh": ""
        },
        {
          "id": 5,
          "start": 9.09,
          "end": 11.67,
          "en": "or variable that's exported,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 11.67,
          "end": 14.67,
          "en": "or by dynamically setting metadata",
          "zh": ""
        },
        {
          "id": 7,
          "start": 14.67,
          "end": 17.25,
          "en": "with help of the generateMetadata function",
          "zh": ""
        },
        {
          "id": 8,
          "start": 17.25,
          "end": 20.103,
          "en": "that's exported by your page.js file.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 21.48,
          "end": 26.16,
          "en": "You cannot just set metadata in page.js files though,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 26.16,
          "end": 29.31,
          "en": "instead you can also set it in the layout.js files.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.31,
          "end": 33.63,
          "en": "And indeed, there you should already have a metadata object",
          "zh": ""
        },
        {
          "id": 12,
          "start": 33.63,
          "end": 36.24,
          "en": "that's being exported in the root layout here",
          "zh": ""
        },
        {
          "id": 13,
          "start": 36.24,
          "end": 38.733,
          "en": "in that project I provided to you.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 40.02,
          "end": 44.07,
          "en": "And the idea behind setting up metadata in layouts",
          "zh": ""
        },
        {
          "id": 15,
          "start": 44.07,
          "end": 48.54,
          "en": "is that this metadata will now be used for all the pages",
          "zh": ""
        },
        {
          "id": 16,
          "start": 48.54,
          "end": 51.69,
          "en": "that don't set their own metadata,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 51.69,
          "end": 53.16,
          "en": "or to be precise,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 53.16,
          "end": 57.57,
          "en": "the metadata you set up in your layout will be merged",
          "zh": ""
        },
        {
          "id": 19,
          "start": 57.57,
          "end": 60.51,
          "en": "with any metadata set up by a page.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 60.51,
          "end": 63.33,
          "en": "And if a page doesn't set up any metadata at all,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 63.33,
          "end": 66.18,
          "en": "it's this entire metadata object that will be used",
          "zh": ""
        },
        {
          "id": 22,
          "start": 66.18,
          "end": 68.16,
          "en": "for this specific page.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 68.16,
          "end": 70.89,
          "en": "But if you had a page that just sets a title",
          "zh": ""
        },
        {
          "id": 24,
          "start": 70.89,
          "end": 72.36,
          "en": "and not a description,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 72.36,
          "end": 76.8,
          "en": "the page title would override the layout metadata title,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 76.8,
          "end": 79.77,
          "en": "but the layout metadata description would be merged",
          "zh": ""
        },
        {
          "id": 27,
          "start": 79.77,
          "end": 82.53,
          "en": "with the page specific title.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 82.53,
          "end": 85.26,
          "en": "And therefore setting up metadata in layouts",
          "zh": ""
        },
        {
          "id": 29,
          "start": 85.26,
          "end": 87.69,
          "en": "can be useful for ensuring",
          "zh": ""
        },
        {
          "id": 30,
          "start": 87.69,
          "end": 91.5,
          "en": "that there is at least some metadata in all your pages,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 91.5,
          "end": 93.42,
          "en": "but you can then still override it",
          "zh": ""
        },
        {
          "id": 32,
          "start": 93.42,
          "end": 96.60300000000001,
          "en": "from inside some of your specific pages.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
