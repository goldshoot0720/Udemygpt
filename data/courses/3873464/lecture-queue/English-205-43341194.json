      "cues": [
        {
          "id": 1,
          "start": 0.51,
          "end": 3.57,
          "en": "So, let's in a log in server action.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.57,
          "end": 6.72,
          "en": "For that I'll go to auth-actions.js.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.72,
          "end": 9.78,
          "en": "And here at the bottom of the file, for example,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.78,
          "end": 13.983,
          "en": "I'll export a new async function called login.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 16.38,
          "end": 19.77,
          "en": "And here, I also expect to get a previous state",
          "zh": ""
        },
        {
          "id": 6,
          "start": 19.77,
          "end": 21.6,
          "en": "since this server action function",
          "zh": ""
        },
        {
          "id": 7,
          "start": 21.6,
          "end": 25.683,
          "en": "will also be set as a value for use form state.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 26.55,
          "end": 28.623,
          "en": "And I'll expect to get the formData,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 29.52,
          "end": 31.5,
          "en": "so exactly the same parameters",
          "zh": ""
        },
        {
          "id": 10,
          "start": 31.5,
          "end": 35.073,
          "en": "as we get on the signup server action.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 36.24,
          "end": 39.6,
          "en": "Therefore, we can of course also retrieve email",
          "zh": ""
        },
        {
          "id": 12,
          "start": 39.6,
          "end": 42.43,
          "en": "and password like this",
          "zh": ""
        },
        {
          "id": 13,
          "start": 43.56,
          "end": 45.39,
          "en": "and we could now validate them.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 45.39,
          "end": 47.37,
          "en": "But this is actually not required",
          "zh": ""
        },
        {
          "id": 15,
          "start": 47.37,
          "end": 50.73,
          "en": "since I'll verify these credentials anyways.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 50.73,
          "end": 53.58,
          "en": "I'll look for a user with this email",
          "zh": ""
        },
        {
          "id": 17,
          "start": 53.58,
          "end": 57.21,
          "en": "and I'll then verify whether the stored password for",
          "zh": ""
        },
        {
          "id": 18,
          "start": 57.21,
          "end": 59.43,
          "en": "that user is the one that was entered.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 59.43,
          "end": 63.18,
          "en": "So, we don't need to validate the values submitted",
          "zh": ""
        },
        {
          "id": 20,
          "start": 63.18,
          "end": 67.11,
          "en": "by the user because we'll check whether we find a valid user",
          "zh": ""
        },
        {
          "id": 21,
          "start": 67.11,
          "end": 69.003,
          "en": "for those values anyways.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 69.99,
          "end": 73.68,
          "en": "So, therefore, we'll need to get an existing user by looking",
          "zh": ""
        },
        {
          "id": 23,
          "start": 73.68,
          "end": 75.783,
          "en": "for a user with this email.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 77.01,
          "end": 78.72,
          "en": "Hence, in user.js,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 78.72,
          "end": 82.553,
          "en": "we can export a function called getUserByEmail,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 84.51,
          "end": 88.32,
          "en": "and I expect to get the email as a parameter.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 88.32,
          "end": 92.523,
          "en": "And here, I then wanna return db.prepare,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 93.39,
          "end": 97.583,
          "en": "select all columns from users,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 98.55,
          "end": 100.53,
          "en": "so from the user's table",
          "zh": ""
        },
        {
          "id": 30,
          "start": 100.53,
          "end": 105.24000000000001,
          "en": "where the email column has a value of question mark",
          "zh": ""
        },
        {
          "id": 31,
          "start": 105.24000000000001,
          "end": 108.42,
          "en": "and the concrete value will be inserted by calling Get",
          "zh": ""
        },
        {
          "id": 32,
          "start": 108.42,
          "end": 110.40299999999999,
          "en": "and by passing the email to it.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 112.56,
          "end": 116.03999999999999,
          "en": "And this will then return an object with the user data.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 116.03999999999999,
          "end": 119.37,
          "en": "So, the id, the email, and the hashed password",
          "zh": ""
        },
        {
          "id": 35,
          "start": 119.37,
          "end": 122.43299999999999,
          "en": "if we find one for the provided email.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 123.39,
          "end": 126.94,
          "en": "So, existing user is the result of calling getUserByEmail",
          "zh": ""
        },
        {
          "id": 37,
          "start": 128.7,
          "end": 131.313,
          "en": "and by passing the email to this function.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 133.17,
          "end": 137.43,
          "en": "Now, if we don't have an existing user, if that's undefined,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 137.43,
          "end": 141.81,
          "en": "I know that I didn't find a user for the provided email,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 141.81,
          "end": 145.443,
          "en": "and that of course means that some invalid data was entered.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 146.46,
          "end": 149.67000000000002,
          "en": "Now, since we're still on the auth form here,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 149.67000000000002,
          "end": 152.46,
          "en": "and since we're still using useFormState,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 152.46,
          "end": 156.09,
          "en": "we can take advantage of the way we output errors.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 156.09,
          "end": 158.55,
          "en": "And if we don't find a user,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 158.55,
          "end": 163.05,
          "en": "we can therefore return an object with an error key just",
          "zh": ""
        },
        {
          "id": 46,
          "start": 163.05,
          "end": 166.44,
          "en": "as we did it in the signup function, for example here,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 166.44,
          "end": 168.423,
          "en": "for an existing email address.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 170.34,
          "end": 173.94,
          "en": "And in that errors key, we can store an object",
          "zh": ""
        },
        {
          "id": 49,
          "start": 173.94,
          "end": 176.85,
          "en": "where I could add a key named email",
          "zh": ""
        },
        {
          "id": 50,
          "start": 176.85,
          "end": 180.06,
          "en": "where we could say, 'Could not authenticate user,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 180.06,
          "end": 184.587,
          "en": "please check your credentials.'",
          "zh": ""
        },
        {
          "id": 52,
          "start": 186.87,
          "end": 189.66,
          "en": "Now, if we make it past this, if check, we know",
          "zh": ""
        },
        {
          "id": 53,
          "start": 189.66,
          "end": 194.4,
          "en": "that we do have a user for the given email address,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 194.4,
          "end": 197.55,
          "en": "but of course the password might be wrong.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 197.55,
          "end": 201.42000000000002,
          "en": "But we can verify that password with help of a function",
          "zh": ""
        },
        {
          "id": 56,
          "start": 201.42000000000002,
          "end": 204.27,
          "en": "that's part of the hash.js file.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 204.27,
          "end": 207.003,
          "en": "This verifyPassword function,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 208.02,
          "end": 211.56,
          "en": "which will in the end return a boolean depending",
          "zh": ""
        },
        {
          "id": 59,
          "start": 211.56,
          "end": 213.6,
          "en": "on whether the password entered",
          "zh": ""
        },
        {
          "id": 60,
          "start": 213.6,
          "end": 218.6,
          "en": "by the user fits the hash password we have in our database.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 218.82,
          "end": 221.76,
          "en": "Of course, the user does not enter the password",
          "zh": ""
        },
        {
          "id": 62,
          "start": 221.76,
          "end": 225.96,
          "en": "in a hashed form, but we essentially recreate the hash here",
          "zh": ""
        },
        {
          "id": 63,
          "start": 225.96,
          "end": 229.68,
          "en": "and then compare the stored hashed password",
          "zh": ""
        },
        {
          "id": 64,
          "start": 229.68,
          "end": 233.28300000000002,
          "en": "to the rehashed supplied password.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 234.27,
          "end": 238.35,
          "en": "So, therefore, in auth-actions we can create a new constant,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 238.35,
          "end": 240.25,
          "en": "which could be called isValidPassword,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 241.2,
          "end": 244.473,
          "en": "which holds the result of calling verifyPassword,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 246.033,
          "end": 250.9,
          "en": "where we pass the existing user password as a first value,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 252.45,
          "end": 255.54,
          "en": "which is the hash password we found in the database",
          "zh": ""
        },
        {
          "id": 70,
          "start": 255.54,
          "end": 257.22,
          "en": "for the existing user,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 257.22,
          "end": 261.213,
          "en": "and then the entered password as a second parameter.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 263.1,
          "end": 268.1,
          "en": "Now, if we don't have a valid password, if this is false,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 268.2,
          "end": 272.67,
          "en": "then I wanna return that same error maybe",
          "zh": ""
        },
        {
          "id": 74,
          "start": 272.67,
          "end": 275.763,
          "en": "for a key name password, though that's up to you.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 278.37,
          "end": 281.90999999999997,
          "en": "But if we make it past the safe check, we know",
          "zh": ""
        },
        {
          "id": 76,
          "start": 281.90999999999997,
          "end": 285.42,
          "en": "that we found a user or the provided email address",
          "zh": ""
        },
        {
          "id": 77,
          "start": 285.42,
          "end": 289.29,
          "en": "and that the password of this user seems to be correct.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 289.29,
          "end": 291.09000000000003,
          "en": "So in that case,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 291.09000000000003,
          "end": 296.09000000000003,
          "en": "I wanna do what I also did before in the signup step.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 296.43,
          "end": 299.49,
          "en": "I want to create an auth session",
          "zh": ""
        },
        {
          "id": 81,
          "start": 299.49,
          "end": 302.583,
          "en": "and let's say redirect the user.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 303.66,
          "end": 305.94,
          "en": "So, I'll copy this code",
          "zh": ""
        },
        {
          "id": 83,
          "start": 305.94,
          "end": 308.19,
          "en": "and paste it down here at the end",
          "zh": ""
        },
        {
          "id": 84,
          "start": 308.19,
          "end": 310.533,
          "en": "of the login server action.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 312.06,
          "end": 316.593,
          "en": "Now, the ID here is the existingUser.id though,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 317.43,
          "end": 320.22,
          "en": "and with that we're creating a session",
          "zh": ""
        },
        {
          "id": 87,
          "start": 320.22,
          "end": 322.32,
          "en": "if we have a valid user.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 322.32,
          "end": 324.03,
          "en": "Otherwise, we don't.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 324.03,
          "end": 325.8,
          "en": "Now, we just need to make sure",
          "zh": ""
        },
        {
          "id": 90,
          "start": 325.8,
          "end": 330.15,
          "en": "that this login server action is actually getting used",
          "zh": ""
        },
        {
          "id": 91,
          "start": 330.15,
          "end": 332.373,
          "en": "in that AuthForm component.",
          "zh": ""
        }
      ]
