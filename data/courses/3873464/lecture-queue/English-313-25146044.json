  "lectures": [
    {
      "id": "25146044",
      "title": "Adding Error Handling",
      "lectureOrder": 337,
      "videoOrder": 313,
      "sourceHash": "c7aa7fc25b25b0f34a5c0a1f7305d046c8c3a8528597d182f2655c30d330057c",
      "cues": [
        {
          "id": 1,
          "start": 2.27,
          "end": 5.92,
          "en": "Now that we implemented our MongoDB logic,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 5.92,
          "end": 8.952,
          "en": "let's wrap up this course section",
          "zh": ""
        },
        {
          "id": 3,
          "start": 8.952,
          "end": 13.27,
          "en": "by adding some error handling to the API routes.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 13.27,
          "end": 17.04,
          "en": "Because data is also something you should know how to do.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 17.04,
          "end": 19.04,
          "en": "When you run server side code,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 19.04,
          "end": 21.47,
          "en": "things don't always go right.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 21.47,
          "end": 25.15,
          "en": "And at the moment we assume that everything works.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 25.15,
          "end": 25.983,
          "en": "Like here.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 25.983,
          "end": 27.6,
          "en": "When we store a newsletter.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.6,
          "end": 28.94,
          "en": "When we do that,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 28.94,
          "end": 30.75,
          "en": "we check the request method,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 30.75,
          "end": 32.278,
          "en": "check that it's a post method.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 32.278,
          "end": 36.84,
          "en": "And if it is, we basically just validate the input.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 36.84,
          "end": 38.08,
          "en": "That's one case",
          "zh": ""
        },
        {
          "id": 15,
          "start": 38.08,
          "end": 42.88,
          "en": "where we send back an error status code if it's not valid.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 42.88,
          "end": 47.49,
          "en": "But for working with the database we just assume that",
          "zh": ""
        },
        {
          "id": 17,
          "start": 47.49,
          "end": 49.11,
          "en": "everything works.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 49.11,
          "end": 51.01,
          "en": "And that's unrealistic.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 51.01,
          "end": 53.73,
          "en": "Things won't always work.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 53.73,
          "end": 56.11,
          "en": "Connecting to the database could fail",
          "zh": ""
        },
        {
          "id": 21,
          "start": 56.11,
          "end": 58.43,
          "en": "or even if we are connected,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 58.43,
          "end": 61.61,
          "en": "inserting data could fail for whatever reason.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 61.61,
          "end": 65.65,
          "en": "Because the database servers went down temporarily",
          "zh": ""
        },
        {
          "id": 24,
          "start": 65.65,
          "end": 68.46000000000001,
          "en": "just when we tried to insert data.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 68.46000000000001,
          "end": 70.28,
          "en": "Things can fail.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 70.28,
          "end": 73.67,
          "en": "No matter how unlikely that might be.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 73.67,
          "end": 76.2,
          "en": "So how do we deal with that then?",
          "zh": ""
        },
        {
          "id": 28,
          "start": 76.2,
          "end": 78.66,
          "en": "Well, since I'm using a single weight here,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 78.66,
          "end": 80.69,
          "en": "we can use, try catch",
          "zh": ""
        },
        {
          "id": 30,
          "start": 80.69,
          "end": 84.11,
          "en": "to try certain operations, catch errors",
          "zh": ""
        },
        {
          "id": 31,
          "start": 84.11,
          "end": 88.42,
          "en": "and then send back a response if things go wrong.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 88.42,
          "end": 90.44,
          "en": "And here I actually wanna work with",
          "zh": ""
        },
        {
          "id": 33,
          "start": 90.44,
          "end": 93.72999999999999,
          "en": "two different try catch blocks.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 93.72999999999999,
          "end": 95.49000000000001,
          "en": "I wanna try connecting.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 95.49000000000001,
          "end": 98.56,
          "en": "And if that fails, I wanna send back an error.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 98.56,
          "end": 101.6,
          "en": "But if it succeeds, I want to try this code.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 101.6,
          "end": 103.77000000000001,
          "en": "So inserting, I wanna try that.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 103.77000000000001,
          "end": 104.99000000000001,
          "en": "And if that fails,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 104.99000000000001,
          "end": 106.61,
          "en": "I want to send back an error,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 106.61,
          "end": 107.92,
          "en": "a different error.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 107.92,
          "end": 111.91,
          "en": "And I then also still wanna close the open connection.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 111.91,
          "end": 114.06,
          "en": "And to do this in an elegant way",
          "zh": ""
        },
        {
          "id": 43,
          "start": 114.06,
          "end": 116.473,
          "en": "I'll work with some helper functions.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 117.32,
          "end": 119.91,
          "en": "For that I'll add a new function,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 119.91,
          "end": 122.67,
          "en": "which will name, connect database.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 122.67,
          "end": 124.85,
          "en": "The name is up to you of course.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 124.85,
          "end": 127.5,
          "en": "And this function here,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 127.5,
          "end": 132.35,
          "en": "will just hold this code for establishing a connection.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 132.35,
          "end": 134.203,
          "en": "So I'll put that in here,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 135.16,
          "end": 138.28,
          "en": "and then just return the client.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 138.28,
          "end": 140,
          "en": "And I'll add another of function,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 140,
          "end": 144.68,
          "en": "which I'll name, insert document,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 144.68,
          "end": 147.91,
          "en": "where I expect to get access to the client.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 147.91,
          "end": 150.07999999999998,
          "en": "And where I get the document that should",
          "zh": ""
        },
        {
          "id": 55,
          "start": 150.07999999999998,
          "end": 152.87,
          "en": "be inserted as parameters.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 152.87,
          "end": 155.37,
          "en": "And inside of insert document,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 155.37,
          "end": 159.15,
          "en": "I then wanna run this code here.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 159.15,
          "end": 162.8,
          "en": "So copy that into insert document.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 162.8,
          "end": 164.78,
          "en": "And of course in order to use a weight",
          "zh": ""
        },
        {
          "id": 60,
          "start": 164.78,
          "end": 166.69,
          "en": "there should be an async function",
          "zh": ""
        },
        {
          "id": 61,
          "start": 166.69,
          "end": 170.53,
          "en": "and this here should be an async function as well.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 170.53,
          "end": 172.376,
          "en": "Connected database.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 172.376,
          "end": 177.17000000000002,
          "en": "Now, with that done down here in our main handler function,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 177.17000000000002,
          "end": 181.34,
          "en": "I get the client by calling connect database",
          "zh": ""
        },
        {
          "id": 65,
          "start": 182.53,
          "end": 186.243,
          "en": "and then I will call insert document,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 187.4,
          "end": 189.5,
          "en": "pass my client as a first argument.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 189.5,
          "end": 193.883,
          "en": "And that document here as a second argument.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 195.84,
          "end": 199.35,
          "en": "Now I wanna await connect database",
          "zh": ""
        },
        {
          "id": 69,
          "start": 199.35,
          "end": 201.43,
          "en": "because it is a async function",
          "zh": ""
        },
        {
          "id": 70,
          "start": 201.43,
          "end": 203.23,
          "en": "so it returns a promise",
          "zh": ""
        },
        {
          "id": 71,
          "start": 203.23,
          "end": 206.31,
          "en": "and we need to wait for disconnection to be established.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 206.31,
          "end": 207.67000000000002,
          "en": "And for the same reason",
          "zh": ""
        },
        {
          "id": 73,
          "start": 207.67000000000002,
          "end": 210.485,
          "en": "we also want to await inserted document",
          "zh": ""
        },
        {
          "id": 74,
          "start": 210.485,
          "end": 213.98,
          "en": "because that's also an async operation.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 213.98,
          "end": 216.53,
          "en": "Now with that outsourced to make this code",
          "zh": ""
        },
        {
          "id": 76,
          "start": 216.53,
          "end": 218.15,
          "en": "a bit more readable,",
          "zh": ""
        },
        {
          "id": 77,
          "start": 218.15,
          "end": 220.74,
          "en": "I will wrap connecting",
          "zh": ""
        },
        {
          "id": 78,
          "start": 220.74,
          "end": 225.74,
          "en": "with try and catch potential errors here.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 228.35,
          "end": 231.34,
          "en": "And I'll then do the same for inserting here.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 231.34,
          "end": 236.173,
          "en": "I'll also wrap this with try and catch errors here.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 238.85,
          "end": 240.68,
          "en": "Now I wanna call a client close",
          "zh": ""
        },
        {
          "id": 82,
          "start": 240.68,
          "end": 242.87,
          "en": "if we did connect successfully,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 242.87,
          "end": 245.74,
          "en": "but we failed to insert.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 245.74,
          "end": 248.74,
          "en": "So I wanna call client close instead",
          "zh": ""
        },
        {
          "id": 85,
          "start": 248.74,
          "end": 251.33,
          "en": "of this try block here as well.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 251.33,
          "end": 253.89,
          "en": "And to make sure that client is available here,",
          "zh": ""
        },
        {
          "id": 87,
          "start": 253.89,
          "end": 256.69,
          "en": "I'll set it as a variable here,",
          "zh": ""
        },
        {
          "id": 88,
          "start": 256.69,
          "end": 259.67,
          "en": "and set it to a value in the first try block.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 259.67,
          "end": 261.75,
          "en": "And if we make it past this block,",
          "zh": ""
        },
        {
          "id": 90,
          "start": 261.75,
          "end": 264.62,
          "en": "client will be the connected database.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 264.62,
          "end": 267.06,
          "en": "So calling close will work then.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 267.06,
          "end": 269.81,
          "en": "And then here we got the different errors.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 269.81,
          "end": 271.24,
          "en": "If we fail to connect,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 271.24,
          "end": 272.98,
          "en": "I wanna send back a response",
          "zh": ""
        },
        {
          "id": 95,
          "start": 272.98,
          "end": 275.74,
          "en": "where I set the status code to 500.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 275.74,
          "end": 278.86,
          "en": "Which indicates that something went wrong on this server.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 278.86,
          "end": 280.88,
          "en": "Which clearly is the case here.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 280.88,
          "end": 283.71,
          "en": "And I'll send back a object as json",
          "zh": ""
        },
        {
          "id": 99,
          "start": 283.71,
          "end": 285.569,
          "en": "which has a message where I say,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 285.569,
          "end": 290.569,
          "en": "connecting to the database failed.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 290.8,
          "end": 291.97,
          "en": "And if that failed,",
          "zh": ""
        },
        {
          "id": 102,
          "start": 291.97,
          "end": 295.11,
          "en": "I don't wanna continue with the other code.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 295.11,
          "end": 298.32,
          "en": "I don't want to continue with this try-catch block.",
          "zh": ""
        },
        {
          "id": 104,
          "start": 298.32,
          "end": 301.24,
          "en": "And I certainly don't want to send back this response.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 301.24,
          "end": 302.22,
          "en": "Eventually,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 302.22,
          "end": 304.2,
          "en": "hence here all returned in",
          "zh": ""
        },
        {
          "id": 107,
          "start": 304.2,
          "end": 307.133,
          "en": "to prevent fervor function execution.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 308.4,
          "end": 311.6,
          "en": "I'll do something similar here if we fail to insert.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 311.6,
          "end": 313.29,
          "en": "I'll copy that code",
          "zh": ""
        },
        {
          "id": 110,
          "start": 313.29,
          "end": 318.29,
          "en": "but I'll set the message to, inserting data failed.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 319.08,
          "end": 321.6,
          "en": "And that's how we can handle errors here.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 321.6,
          "end": 324.77,
          "en": "If we make it past both try-catch blocks.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 324.77,
          "end": 327.69,
          "en": "So if we don't go into any of these catch blocks,",
          "zh": ""
        },
        {
          "id": 114,
          "start": 327.69,
          "end": 328.93,
          "en": "to be precise,",
          "zh": ""
        },
        {
          "id": 115,
          "start": 328.93,
          "end": 331.83299999999997,
          "en": "we will still send back that success response.",
          "zh": ""
        },
        {
          "id": 116,
          "start": 333.64,
          "end": 335.09000000000003,
          "en": "Now to check whatever didn't works.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 335.09000000000003,
          "end": 339.58,
          "en": "We can temporarily break disconnect database function",
          "zh": ""
        },
        {
          "id": 118,
          "start": 340.58,
          "end": 343.01,
          "en": "by using incorrect credentials",
          "zh": ""
        },
        {
          "id": 119,
          "start": 343.01,
          "end": 345.85,
          "en": "like a username that doesn't exist.",
          "zh": ""
        },
        {
          "id": 120,
          "start": 345.85,
          "end": 346.72,
          "en": "We save that",
          "zh": ""
        },
        {
          "id": 121,
          "start": 346.72,
          "end": 350.27,
          "en": "and I go back to the newsletter part here.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 350.27,
          "end": 355.27,
          "en": "If I try to sign up with some dummy newsletter",
          "zh": ""
        },
        {
          "id": 123,
          "start": 355.49,
          "end": 357.54,
          "en": "we see that we get back an error here,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 357.54,
          "end": 359.86,
          "en": "in the network tab we also see it.",
          "zh": ""
        },
        {
          "id": 125,
          "start": 359.86,
          "end": 361.93,
          "en": "We see that we got back a response",
          "zh": ""
        },
        {
          "id": 126,
          "start": 361.93,
          "end": 364.24,
          "en": "with a status code of 500",
          "zh": ""
        },
        {
          "id": 127,
          "start": 364.24,
          "end": 367.45,
          "en": "where the message we get is connecting",
          "zh": ""
        },
        {
          "id": 128,
          "start": 367.45,
          "end": 369.77,
          "en": "to the database failed.",
          "zh": ""
        },
        {
          "id": 129,
          "start": 369.77,
          "end": 372.64,
          "en": "Now, as mentioned before, we don't have any feedback",
          "zh": ""
        },
        {
          "id": 130,
          "start": 372.64,
          "end": 375.2,
          "en": "on the user interface and you might of course",
          "zh": ""
        },
        {
          "id": 131,
          "start": 375.2,
          "end": 377.4,
          "en": "want to add such feedback also",
          "zh": ""
        },
        {
          "id": 132,
          "start": 377.4,
          "end": 379.37,
          "en": "for the loading states and on.",
          "zh": ""
        },
        {
          "id": 133,
          "start": 379.37,
          "end": 381.96,
          "en": "I just didn't focus on this at the moment",
          "zh": ""
        },
        {
          "id": 134,
          "start": 381.96,
          "end": 386.2,
          "en": "because I want to thoroughly dive into API routes.",
          "zh": ""
        },
        {
          "id": 135,
          "start": 386.2,
          "end": 389.8,
          "en": "And there we can see that our error handling works.",
          "zh": ""
        },
        {
          "id": 136,
          "start": 389.8,
          "end": 391.97,
          "en": "If I go back to a correct username",
          "zh": ""
