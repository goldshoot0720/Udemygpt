        },
        {
          "id": 140,
          "start": 405.837,
          "end": 408.273,
          "en": "this JSX code.",
          "zh": ""
        },
        {
          "id": 141,
          "start": 409.59000000000003,
          "end": 412.95,
          "en": "You can store JSX code in variables, as well.",
          "zh": ""
        },
        {
          "id": 142,
          "start": 412.95,
          "end": 415.38,
          "en": "You can not just return it in functions.",
          "zh": ""
        },
        {
          "id": 143,
          "start": 415.38,
          "end": 419.76,
          "en": "You can use it anywhere where a value is wanted.",
          "zh": ""
        },
        {
          "id": 144,
          "start": 419.76,
          "end": 423.107,
          "en": "And then down here in the JSX code we do return,",
          "zh": ""
        },
        {
          "id": 145,
          "start": 423.107,
          "end": 426.603,
          "en": "we could now just refer to modal content.",
          "zh": ""
        },
        {
          "id": 146,
          "start": 428.31,
          "end": 430.35,
          "en": "And this would now either be nothing,",
          "zh": ""
        },
        {
          "id": 147,
          "start": 430.35,
          "end": 432.611,
          "en": "undefined, which also leads to nothing",
          "zh": ""
        },
        {
          "id": 148,
          "start": 432.611,
          "end": 435.06,
          "en": "being output on the screen.",
          "zh": ""
        },
        {
          "id": 149,
          "start": 435.06,
          "end": 437.103,
          "en": "Or it's this content.",
          "zh": ""
        },
        {
          "id": 150,
          "start": 438.42,
          "end": 440.248,
          "en": "Now we are using a variable here,",
          "zh": ""
        },
        {
          "id": 151,
          "start": 440.248,
          "end": 442.86,
          "en": "but we'll see the updated content nonetheless,",
          "zh": ""
        },
        {
          "id": 152,
          "start": 442.86,
          "end": 445.68,
          "en": "because we are using a state value,",
          "zh": ""
        },
        {
          "id": 153,
          "start": 445.68,
          "end": 448.83,
          "en": "which is updated with our State updating function here",
          "zh": ""
        },
        {
          "id": 154,
          "start": 448.83,
          "end": 451.26,
          "en": "in the posts list component.",
          "zh": ""
        },
        {
          "id": 155,
          "start": 451.26,
          "end": 453.635,
          "en": "So this variable will only receive a new value",
          "zh": ""
        },
        {
          "id": 156,
          "start": 453.635,
          "end": 457.05,
          "en": "if the state was updated with that state",
