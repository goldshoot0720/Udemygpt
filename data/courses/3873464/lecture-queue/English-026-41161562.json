        },
        {
          "id": 186,
          "start": 526.744,
          "end": 528.303,
          "en": "that we can hide it.",
          "zh": ""
        },
        {
          "id": 187,
          "start": 529.32,
          "end": 531.404,
          "en": "And no matter which approach you prefer,",
          "zh": ""
        },
        {
          "id": 188,
          "start": 531.404,
          "end": 533.635,
          "en": "all three approaches are fine.",
