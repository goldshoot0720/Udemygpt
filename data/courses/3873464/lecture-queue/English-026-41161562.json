        },
        {
          "id": 167,
          "start": 479.928,
          "end": 482.349,
          "en": "you go back here in your JSX code,",
          "zh": ""
        },
        {
          "id": 168,
          "start": 482.349,
          "end": 485.123,
          "en": "and instead of writing a ternary expression",
          "zh": ""
        },
        {
          "id": 169,
          "start": 485.123,
          "end": 487.756,
          "en": "you use the modal is visible,",
          "zh": ""
        },
        {
          "id": 170,
          "start": 487.756,
          "end": 489.315,
          "en": "state value again,",
          "zh": ""
        },
        {
          "id": 171,
          "start": 489.315,
          "end": 492.035,
          "en": "and then the logical and operator here,",
          "zh": ""
        },
        {
          "id": 172,
          "start": 492.035,
          "end": 496.05,
          "en": "to then define the content that should be output.",
          "zh": ""
        },
        {
          "id": 173,
          "start": 496.05,
          "end": 498.36,
          "en": "If modal is visible, is truthy.",
          "zh": ""
        },
        {
          "id": 174,
          "start": 498.36,
          "end": 500.7,
          "en": "So if it's true, in this case.",
          "zh": ""
        },
        {
          "id": 175,
          "start": 500.7,
          "end": 502.403,
          "en": "Due to the way JavaScript works",
          "zh": ""
        },
        {
          "id": 176,
          "start": 502.403,
          "end": 504.534,
          "en": "it will now output this content only",
          "zh": ""
        },
        {
          "id": 177,
          "start": 504.534,
          "end": 508.44,
          "en": "if this value here is truthy, if it's true,",
          "zh": ""
        },
        {
          "id": 178,
          "start": 508.44,
          "end": 510.72,
