        },
        {
          "id": 86,
          "start": 250.78,
          "end": 252.63,
          "en": "since it's technically is one,",
          "zh": ""
        },
        {
          "id": 87,
          "start": 252.63,
          "end": 254.743,
          "en": "though it of course shouldn't change.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 256.06,
          "end": 259.22,
          "en": "So now, we can redirect if we are authenticated.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 259.22,
          "end": 262.14,
          "en": "Of course, I don't wanna show the AuthForm",
          "zh": ""
        },
        {
          "id": 90,
          "start": 262.14,
          "end": 263.8,
          "en": "whilst I'm still figuring out",
          "zh": ""
        },
        {
          "id": 91,
          "start": 263.8,
          "end": 266.22,
          "en": "whether we are authenticated or not.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 266.22,
          "end": 270.17,
          "en": "And therefore again we can use useState here,",
          "zh": ""
        },
        {
          "id": 93,
          "start": 270.17,
          "end": 274.15,
