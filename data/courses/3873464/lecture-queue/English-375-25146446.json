        },
        {
          "id": 63,
          "start": 183.41,
          "end": 184.463,
          "en": "And for that,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 184.463,
          "end": 186.663,
          "en": "we need to import { getSession } from 'next-auth/client':",
          "zh": ""
        },
        {
          "id": 65,
          "start": 192.34,
          "end": 193.88,
          "en": "and then here in useEffect,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 193.88,
          "end": 198.88,
          "en": "we have this effect function and our dependency array",
          "zh": ""
        },
        {
          "id": 67,
          "start": 199.3,
          "end": 201.22,
          "en": "without any dependencies here,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 201.22,
          "end": 203.95,
          "en": "since we have no special dependencies.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 203.95,
          "end": 206.4,
          "en": "And we call getSession,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 206.4,
          "end": 210.3,
