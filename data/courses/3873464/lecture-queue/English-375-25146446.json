          "zh": ""
        },
        {
          "id": 71,
          "start": 210.3,
          "end": 211.15,
          "en": "And then here,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 211.15,
          "end": 213.67000000000002,
          "en": "I wanna check if we do have a session,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 213.67000000000002,
          "end": 218.48,
          "en": "because here the problem is if we are authenticated already.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 218.48,
          "end": 220.51,
          "en": "And if we do have a session,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 220.51,
          "end": 223.5,
