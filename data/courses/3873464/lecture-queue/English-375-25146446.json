        },
        {
          "id": 82,
          "start": 238.31,
          "end": 241.43,
          "en": "useRouter like that.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 241.43,
          "end": 245.28,
          "en": "And then in here simply call router.replace",
