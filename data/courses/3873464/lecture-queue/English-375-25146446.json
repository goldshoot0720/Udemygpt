        },
        {
          "id": 58,
          "start": 169.89,
          "end": 170.91,
          "en": "doesn't really matter.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 170.91,
          "end": 173.31,
          "en": "Let's maybe do it here in the AuthPage.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 173.31,
          "end": 178.2,
          "en": "For this here, I want to use useEffect.",
