          "zh": ""
        },
        {
          "id": 117,
          "start": 398.22,
          "end": 400.983,
          "en": "because I will render that in my button.",
          "zh": ""
        },
        {
          "id": 118,
          "start": 402.4,
          "end": 404.75,
          "en": "Here in this button, I don't just want",
          "zh": ""
        },
        {
          "id": 119,
          "start": 404.75,
          "end": 407.8,
          "en": "to have this explore event text.",
          "zh": ""
        },
        {
          "id": 120,
          "start": 407.8,
          "end": 412.32,
          "en": "Instead, this text should sit side by side to an icon.",
