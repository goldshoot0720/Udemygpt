      "cues": [
        {
          "id": 1,
          "start": 2.09,
          "end": 4.53,
          "en": "So now that the Context is defined",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.53,
          "end": 9.41,
          "en": "and we wrap our components here with our Context provider,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 9.41,
          "end": 12.13,
          "en": "it's time to start using that Context.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 12.13,
          "end": 15.34,
          "en": "Now I mentioned that I wanna show the notification here",
          "zh": ""
        },
        {
          "id": 5,
          "start": 15.34,
          "end": 17.82,
          "en": "in this underscore App.js file.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.82,
          "end": 20.68,
          "en": "And I would actually have problems with that",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.68,
          "end": 22.82,
          "en": "because that's also the file",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.82,
          "end": 26.81,
          "en": "where we wrap with our Notification Context Provider.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 26.81,
          "end": 29.04,
          "en": "So this component itself,",
          "zh": ""
        },
        {
          "id": 10,
