        },
        {
          "id": 13,
          "start": 38.61,
          "end": 40.32,
          "en": "where we do the wrapping.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 40.32,
          "end": 43.45,
          "en": "Hence we can't tap into our Context here",
          "zh": ""
        },
        {
          "id": 15,
          "start": 43.45,
          "end": 46.29,
          "en": "inside of this component function.",
