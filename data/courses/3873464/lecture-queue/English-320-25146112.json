          "zh": ""
        },
        {
          "id": 11,
          "start": 32.15,
          "end": 36.11,
          "en": "is not wrapped by Notification Context Provider",
          "zh": ""
        },
        {
          "id": 12,
          "start": 36.11,
          "end": 38.61,
          "en": "because it's this component's JSX code",
