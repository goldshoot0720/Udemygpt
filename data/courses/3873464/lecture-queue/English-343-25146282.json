          "zh": ""
        },
        {
          "id": 3,
          "start": 7.87,
          "end": 9.61,
          "en": "but I'll again keep it simple",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.61,
          "end": 11.35,
          "en": "and create a separate component",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.35,
          "end": 15.53,
          "en": "which holds the actual content of this page.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.53,
          "end": 17.76,
          "en": "For this, in the components folder,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.76,
          "end": 20.29,
