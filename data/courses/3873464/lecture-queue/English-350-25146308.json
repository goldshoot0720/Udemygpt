        },
        {
          "id": 46,
          "start": 144.57999999999998,
          "end": 146.62,
          "en": "where it should be portaled to.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 146.62,
          "end": 150.92000000000002,
          "en": "And we use the native browser APIs for selecting that place.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 150.92000000000002,
          "end": 153.31,
          "en": "For example, with document",
          "zh": ""
        },
        {
          "id": 49,
          "start": 153.31,
