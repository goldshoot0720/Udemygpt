        {
          "id": 15,
          "start": 40.51,
          "end": 44.75,
          "en": "and it can make our page a bit more inaccessible as well.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 44.75,
          "end": 48.52,
          "en": "That's why we have this feature called React portals",
          "zh": ""
        },
        {
          "id": 17,
          "start": 48.52,
          "end": 52.38,
          "en": "which allows us to render a component anywhere",
          "zh": ""
        },
        {
          "id": 18,
          "start": 52.38,
          "end": 53.97,
          "en": "in our component tree.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 53.97,
          "end": 57.54,
          "en": "So to use it anywhere in our component tree,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 57.54,
          "end": 60.5,
          "en": "for example in the contact form JSX code",
          "zh": ""
        },
        {
          "id": 21,
          "start": 60.5,
          "end": 62.3,
          "en": "as we do it now,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 62.3,
          "end": 64.55,
          "en": "but technically injected",
          "zh": ""
        },
        {
          "id": 23,
          "start": 64.55,
          "end": 68.16,
          "en": "in a different place in the actual Dom tree.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 68.16,
          "end": 72.99,
          "en": "And that's then better for semantics and accessibility.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 72.99,
          "end": 75.78999999999999,
          "en": "Hence using a portal here would make sense",
