        },
        {
          "id": 9,
          "start": 30.39,
          "end": 34.41,
          "en": "And then this file also contains a second function,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 34.41,
          "end": 37.89,
          "en": "which allows us to check passwords",
          "zh": ""
        },
        {
          "id": 11,
