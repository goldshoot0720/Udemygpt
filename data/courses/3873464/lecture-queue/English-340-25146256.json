        },
        {
          "id": 22,
          "start": 54.96,
          "end": 57.94,
          "en": "right away, as a first step,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 57.94,
          "end": 61.57,
          "en": "by taking our post identifier,",
