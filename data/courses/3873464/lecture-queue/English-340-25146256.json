        },
        {
          "id": 24,
          "start": 61.57,
          "end": 63.41,
          "en": "and replacing the extension.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 63.41,
          "end": 64.57,
          "en": "And if it doesn't have",
