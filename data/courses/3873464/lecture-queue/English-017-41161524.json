  "courseSlug": "nextjs-react-the-complete-guide",
  "courseTitle": "Next.js & React - The Complete Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "41161524",
      "title": "Reusing Components",
      "lectureOrder": 19,
      "videoOrder": 17,
      "sourceHash": "880e4fa90186dea4afc60e862147c2bc5c4229ad48618e21fc55b8af67070129",
      "cues": [
        {
          "id": 1,
          "start": 0.27,
          "end": 2.7,
          "en": "Amazing.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.7,
          "end": 5.37,
          "en": "We get a component with some dynamic value",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.37,
          "end": 6.72,
          "en": "being output as part of it,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 6.72,
          "end": 8.64,
          "en": "and therefore as we reload this app,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 8.64,
          "end": 10.24,
          "en": "the names are changing here.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 10.24,
          "end": 12.811,
          "en": "As mentioned before it's probably not a feature",
          "zh": ""
        },
        {
          "id": 7,
          "start": 12.811,
          "end": 14.16,
          "en": "we'll need all the time,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 14.16,
          "end": 16.269,
          "en": "but it's a huge step forward.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 16.269,
          "end": 17.79,
          "en": "However, at the moment,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 17.79,
          "end": 20.97,
          "en": "we're using this post component just once",
          "zh": ""
        },
        {
          "id": 11,
          "start": 20.97,
          "end": 23.04,
          "en": "here in the app component.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 23.04,
          "end": 25.29,
          "en": "And that is indeed often the case.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 25.29,
          "end": 28.89,
          "en": "You'd find a component and in the entire application",
          "zh": ""
        },
        {
          "id": 14,
          "start": 28.89,
          "end": 30.486,
          "en": "you use it only once.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 30.486,
          "end": 31.376,
          "en": "For example",
          "zh": ""
        },
        {
          "id": 16,
          "start": 31.376,
          "end": 34.557,
          "en": "if you define a separate component for the main header",
          "zh": ""
        },
        {
          "id": 17,
          "start": 34.557,
          "end": 36.107,
          "en": "Of the application,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 36.107,
          "end": 39.408,
          "en": "the main navigation bar of your website, let's say",
          "zh": ""
        },
        {
          "id": 19,
          "start": 39.408,
          "end": 42.99,
          "en": "you typically only have one main navigation bar",
          "zh": ""
        },
        {
          "id": 20,
          "start": 42.99,
          "end": 45.39,
          "en": "on the entire website and you'll nonetheless",
          "zh": ""
        },
        {
          "id": 21,
          "start": 45.39,
          "end": 47.635,
          "en": "might want to put that into its own component",
          "zh": ""
        },
        {
          "id": 22,
          "start": 47.635,
          "end": 50.715,
          "en": "so that all the navigation logic",
          "zh": ""
        },
        {
          "id": 23,
          "start": 50.715,
          "end": 52.17,
          "en": "is in one in the same place.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 52.17,
          "end": 54.48,
          "en": "But whilst this is a common use case,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 54.48,
          "end": 55.443,
          "en": "it's all the very common",
          "zh": ""
        },
        {
          "id": 26,
          "start": 55.443,
          "end": 58.47,
          "en": "that you want to reuse a component.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 58.47,
          "end": 61.5,
          "en": "And the post component is a perfect example.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 61.5,
          "end": 63.54,
          "en": "Why just have one post?",
          "zh": ""
        },
        {
          "id": 29,
          "start": 63.54,
          "end": 67.23,
          "en": "We might have multiple posts on our website",
          "zh": ""
        },
        {
          "id": 30,
          "start": 67.23,
          "end": 69.42,
          "en": "not just one post.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 69.42,
          "end": 72.63,
          "en": "And indeed later we will have multiple posts.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 72.63,
          "end": 75.48,
          "en": "Users will be able to create multiple posts,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 75.48,
          "end": 77.01,
          "en": "and we want to output a grid",
          "zh": ""
        },
        {
          "id": 34,
          "start": 77.01,
          "end": 79.053,
          "en": "filled with all those posts.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 80.19,
          "end": 82.38,
          "en": "So how can we output multiple posts",
          "zh": ""
        },
        {
          "id": 36,
          "start": 82.38,
          "end": 84.53999999999999,
          "en": "based on that one component?",
          "zh": ""
        },
        {
          "id": 37,
          "start": 84.53999999999999,
          "end": 86.86,
          "en": "Well, that's also quite straightforward",
          "zh": ""
        },
        {
          "id": 38,
          "start": 86.86,
          "end": 89.379,
          "en": "In this app component here,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 89.379,
          "end": 92.598,
          "en": "let's say we output a main element,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 92.598,
          "end": 95.84899999999999,
          "en": "and that's a standard HTML element",
          "zh": ""
        },
        {
          "id": 41,
          "start": 95.84899999999999,
          "end": 99.18,
          "en": "supported by the browser out of the box.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 99.18,
          "end": 102.57,
          "en": "And you can tell that it's a standard HTML element",
          "zh": ""
        },
        {
          "id": 43,
          "start": 102.57,
          "end": 103.461,
          "en": "by the fact that we start with a lower case character",
          "zh": ""
        },
        {
          "id": 44,
          "start": 103.461,
          "end": 107.14500000000001,
          "en": "and that we're not importing it from anywhere",
          "zh": ""
        },
        {
          "id": 45,
          "start": 107.14500000000001,
          "end": 111.99000000000001,
          "en": "Because React supports all these standard HTML elements",
          "zh": ""
        },
        {
          "id": 46,
          "start": 111.99000000000001,
          "end": 115.203,
          "en": "that are supported by browsers out of the box.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 116.4,
          "end": 118.38,
          "en": "So I output this main element here",
          "zh": ""
        },
        {
          "id": 48,
          "start": 118.38,
          "end": 120.66,
          "en": "and then inside this main element",
          "zh": ""
        },
        {
          "id": 49,
          "start": 120.66,
          "end": 123.07,
          "en": "I output my post like before.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 123.07,
          "end": 125.64,
          "en": "But I don't just do this once,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 125.64,
          "end": 127.08,
          "en": "but instead twice",
          "zh": ""
        },
        {
          "id": 52,
          "start": 127.08,
          "end": 131.103,
          "en": "Or three times or four times how often you want.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 132.99,
          "end": 134.232,
          "en": "If you do that,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 134.232,
          "end": 138.12,
          "en": "you see a bunch of posts here and if you reload",
          "zh": ""
        },
        {
          "id": 55,
          "start": 138.12,
          "end": 141.09,
          "en": "you see that they all can have different names.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 141.09,
          "end": 143,
          "en": "Sometimes you have the same name in all those posts",
          "zh": ""
        },
        {
          "id": 57,
          "start": 143,
          "end": 146.82,
          "en": "but you have a high chance of having some variation.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 146.82,
          "end": 149.28,
          "en": "We do have some maximilians and some manuals",
          "zh": ""
        },
        {
          "id": 59,
          "start": 149.28,
          "end": 150.96,
          "en": "here in my case.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 150.96,
          "end": 155.04,
          "en": "This also shows us one important feature of components.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 155.04,
          "end": 157.35,
          "en": "Even though we use the same component function",
          "zh": ""
        },
        {
          "id": 62,
          "start": 157.35,
          "end": 161.22,
          "en": "multiple times, it's in the end executed multiple times",
          "zh": ""
        },
        {
          "id": 63,
          "start": 161.22,
          "end": 162.053,
          "en": "by React.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 162.053,
          "end": 163.152,
          "en": "So it's not just executed once",
          "zh": ""
        },
        {
          "id": 65,
          "start": 163.152,
          "end": 165.792,
          "en": "and the result is then reused",
          "zh": ""
        },
        {
          "id": 66,
          "start": 165.792,
          "end": 169.32,
          "en": "but instead it is executed multiple times,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 169.32,
          "end": 172.86,
          "en": "once per usage, so to say.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 172.86,
          "end": 175.17000000000002,
          "en": "That's why we have different names here",
          "zh": ""
        },
        {
          "id": 69,
          "start": 175.17000000000002,
          "end": 178.65,
          "en": "because the component function was executed multiple times",
          "zh": ""
        },
        {
          "id": 70,
          "start": 178.65,
          "end": 180.12,
          "en": "by React.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 180.12,
          "end": 182.97,
          "en": "And that's in the end how a component can be reused.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 182.97,
          "end": 186.24,
          "en": "You can simply use it multiple times in your JSX code.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 186.24,
          "end": 189.48,
          "en": "The same component used multiple times.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 189.48,
          "end": 191.85,
          "en": "Now there are a couple of important aspects",
          "zh": ""
        },
        {
          "id": 75,
          "start": 191.85,
          "end": 194.34,
          "en": "related to reusing components",
          "zh": ""
        },
        {
          "id": 76,
          "start": 194.34,
          "end": 197.76,
          "en": "and I want to start with one important restriction",
          "zh": ""
        },
        {
          "id": 77,
          "start": 197.76,
          "end": 201.32999999999998,
          "en": "that's the end and forced by React.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 201.32999999999998,
          "end": 204.93,
          "en": "When you have multiple elements side by side",
          "zh": ""
        },
        {
          "id": 79,
          "start": 204.93,
          "end": 207.93,
          "en": "as it's the case here with multiple posts",
          "zh": ""
        },
        {
          "id": 80,
          "start": 207.93,
          "end": 208.95,
          "en": "but the same would be true",
          "zh": ""
        },
        {
          "id": 81,
          "start": 208.95,
          "end": 211.44,
          "en": "if we had multiple built in components.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 211.44,
          "end": 212.7,
          "en": "You must make sure",
          "zh": ""
        },
        {
          "id": 83,
          "start": 212.7,
          "end": 216.18,
          "en": "that they're wrapped by another component.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 216.18,
          "end": 220.47,
          "en": "Put another words in places where you use JSX code.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 220.47,
          "end": 221.742,
          "en": "Like in the return statement here,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 221.742,
          "end": 226.742,
          "en": "you are only allowed to return one single element.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 226.95,
          "end": 229.05,
          "en": "And that element then in turn",
          "zh": ""
        },
        {
          "id": 88,
          "start": 229.05,
          "end": 232.35,
          "en": "might include multiple sibling elements",
          "zh": ""
        },
        {
          "id": 89,
          "start": 232.35,
          "end": 236.4,
          "en": "but we would not be allowed to return this JSX code.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 236.4,
          "end": 239.61,
          "en": "As you see, I'm already getting an error here.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 239.61,
          "end": 240.69,
          "en": "I'm getting an error",
          "zh": ""
        },
        {
          "id": 92,
          "start": 240.69,
          "end": 243.72,
          "en": "because in places where you use JSX",
          "zh": ""
        },
        {
          "id": 93,
          "start": 243.72,
          "end": 246.54,
          "en": "you must have one root JSX element",
          "zh": ""
        },
        {
          "id": 94,
          "start": 246.54,
          "end": 247.662,
          "en": "like this main element here.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 247.662,
          "end": 250.611,
          "en": "And then in there you can have as many sibling elements",
          "zh": ""
        },
        {
          "id": 96,
          "start": 250.611,
          "end": 255.12,
          "en": "as you'd like to have, but you must have one root element.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 255.12,
          "end": 257.302,
          "en": "So that's an important restriction to keep in mind.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 257.302,
          "end": 262.14,
          "en": "Now if there is no fitting HTML element that you want to use",
          "zh": ""
        },
        {
          "id": 99,
          "start": 262.14,
          "end": 265.56,
          "en": "you can also use empty opening and closing tags.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 265.56,
          "end": 269.49,
          "en": "And this syntax will actually be supported by React",
          "zh": ""
        },
        {
          "id": 101,
          "start": 269.49,
          "end": 273.72,
          "en": "but you must have one wrapping root element nonetheless.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 273.72,
          "end": 275.88,
          "en": "In this case, I'll use the main element though",
          "zh": ""
        },
        {
          "id": 103,
          "start": 275.88,
          "end": 277.65,
          "en": "because semantically it makes sense",
          "zh": ""
        },
        {
          "id": 104,
          "start": 277.65,
          "end": 281.19,
          "en": "to wrap the main page content into that element.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 281.19,
          "end": 283.89,
          "en": "And since we're already talking about JSX",
          "zh": ""
        },
        {
          "id": 106,
          "start": 283.89,
          "end": 287.7,
          "en": "and an important restriction enforced by React",
          "zh": ""
        },
        {
          "id": 107,
          "start": 287.7,
          "end": 290.351,
          "en": "there is another important rule you must follow.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 290.351,
          "end": 294.63,
          "en": "If you have elements that have no content",
          "zh": ""
        },
        {
          "id": 109,
          "start": 294.63,
          "end": 297.15,
          "en": "between their opening and closing tags",
          "zh": ""
        },
        {
          "id": 110,
          "start": 297.15,
          "end": 302.15,
          "en": "as it's the case for post, you may write them as such.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 302.46,
          "end": 305.929,
          "en": "So opening and closing tag without content between",
          "zh": ""
        },
        {
          "id": 112,
          "start": 305.929,
          "end": 309.9,
          "en": "but you can also write it as a self-closing tag.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 309.9,
          "end": 314.16,
          "en": "You however, are not allowed to write it as a void tag.",
          "zh": ""
        },
        {
          "id": 114,
          "start": 314.16,
          "end": 316.04,
          "en": "You see, I'm getting an error here.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 316.04,
          "end": 319.74,
          "en": "So you either must add a closing tag",
          "zh": ""
        },
        {
          "id": 116,
          "start": 319.74,
          "end": 322.65,
          "en": "or write it as a self-closing tag.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 322.65,
          "end": 324.87,
          "en": "And that's true for all elements",
          "zh": ""
        },
        {
          "id": 118,
          "start": 324.87,
          "end": 326.91,
          "en": "you're using in your JSX code.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 326.91,
          "end": 329.64,
          "en": "No matter if we're talking about custom components",
          "zh": ""
        },
        {
          "id": 120,
          "start": 329.64,
          "end": 331.86,
          "en": "or built-in components.",
          "zh": ""
        },
        {
          "id": 121,
          "start": 331.86,
          "end": 333.36,
          "en": "If they have no content",
          "zh": ""
        },
        {
          "id": 122,
          "start": 333.36,
          "end": 335.03,
          "en": "between the opening and closing tags,",
          "zh": ""
        },
        {
          "id": 123,
          "start": 335.03,
          "end": 336.96,
          "en": "they must be self-closing",
          "zh": ""
        },
        {
          "id": 124,
          "start": 336.96,
          "end": 339.68,
          "en": "or you must have opening and closing tags.",
          "zh": ""
        },
        {
          "id": 125,
          "start": 339.68,
          "end": 342.36,
          "en": "And if you have sibling elements",
          "zh": ""
        },
        {
          "id": 126,
          "start": 342.36,
          "end": 343.84000000000003,
          "en": "you must wrap them with a root element",
          "zh": ""
        },
        {
          "id": 127,
          "start": 343.84000000000003,
          "end": 347.73,
          "en": "because you can only return a single element",
          "zh": ""
        },
        {
          "id": 128,
          "start": 347.73,
          "end": 350.25,
          "en": "in your component functions.",
          "zh": ""
        },
        {
          "id": 129,
          "start": 350.25,
          "end": 351.81,
          "en": "So these are some important things",
          "zh": ""
        },
        {
          "id": 130,
          "start": 351.81,
          "end": 354.57,
          "en": "you should keep in mind when working with components,",
          "zh": ""
        },
        {
          "id": 131,
          "start": 354.57,
          "end": 355.89,
          "en": "including scenarios",
          "zh": ""
        },
        {
          "id": 132,
          "start": 355.89,
          "end": 359.013,
          "en": "where you are reusing your own components.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
