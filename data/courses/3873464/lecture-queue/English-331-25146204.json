          "zh": ""
        },
        {
          "id": 95,
          "start": 302.175,
          "end": 304.787,
          "en": "and this file is empty right now,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 304.787,
          "end": 306.77,
          "en": "but we will work on that soon,",
          "zh": ""
        },
        {
          "id": 97,
          "start": 306.77,
          "end": 308.748,
          "en": "and we'll also need some styling",
          "zh": ""
        },
        {
          "id": 98,
          "start": 308.748,
          "end": 310.652,
          "en": "so I'll import some classes from",
