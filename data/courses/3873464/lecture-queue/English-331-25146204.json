          "en": "into separate components",
          "zh": ""
        },
        {
          "id": 65,
          "start": 205.02,
          "end": 208.308,
          "en": "to keep every component lean and maintainable.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 208.308,
          "end": 211.95,
          "en": "Let's start working on the posts grid component though.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 211.95,
          "end": 215.785,
          "en": "In that posts grid file I'll add a function,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 215.785,
          "end": 218.929,
