          "zh": ""
        },
        {
          "id": 50,
          "start": 148.74,
          "end": 153.21,
          "en": "and this description tag I added in the last course section.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 153.21,
          "end": 155.81,
          "en": "Of course, there is more you might want to add.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 155.81,
          "end": 158.84,
          "en": "Favicons, images which are displayed",
          "zh": ""
        },
        {
          "id": 53,
          "start": 158.84,
          "end": 162.38,
          "en": "if you share a page through Facebook or Twitter.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 162.38,
          "end": 164.73,
          "en": "So these little preview images and so on.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 164.73,
          "end": 166.9,
          "en": "These are all extra kinds of data",
