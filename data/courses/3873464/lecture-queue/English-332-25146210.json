        },
        {
          "id": 130,
          "start": 437.75,
          "end": 441.23,
          "en": "but still will always produce good-looking images",
          "zh": ""
        },
        {
          "id": 131,
          "start": 441.23,
          "end": 443.21,
          "en": "with these settings.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 443.21,
          "end": 447.53,
