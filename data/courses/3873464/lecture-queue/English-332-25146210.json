        },
        {
          "id": 78,
          "start": 267.31,
          "end": 270.53,
          "en": "And that's the data with which we can break down there",
          "zh": ""
        },
        {
          "id": 79,
          "start": 270.53,
          "end": 271.363,
          "en": "for example,",
