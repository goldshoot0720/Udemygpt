          "zh": ""
        },
        {
          "id": 15,
          "start": 43.32,
          "end": 46,
          "en": "That's a simple presentational component",
          "zh": ""
        },
        {
          "id": 16,
          "start": 46,
          "end": 48.75,
          "en": "which will just output a title and a message",
          "zh": ""
        },
        {
          "id": 17,
          "start": 48.75,
          "end": 52.1,
          "en": "as a notification shown at the bottom of the screen",
          "zh": ""
        },
        {
          "id": 18,
          "start": 52.1,
          "end": 53.64,
          "en": "once we do show it.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 53.64,
          "end": 56.37,
          "en": "At the moment we have no code for showing it",
          "zh": ""
        },
        {
          "id": 20,
          "start": 56.37,
          "end": 60.14,
          "en": "but that's about to change throughout this course section.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 60.14,
          "end": 62.7,
          "en": "Now one important note first,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 62.7,
          "end": 65.13,
          "en": "you don't have to use React Context",
          "zh": ""
        },
        {
          "id": 23,
          "start": 65.13,
          "end": 67.33,
          "en": "for this course section.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 67.33,
          "end": 69.46000000000001,
          "en": "For giving the user some feedback",
          "zh": ""
        },
        {
          "id": 25,
          "start": 69.46000000000001,
          "end": 73.66,
          "en": "about the current status of the ongoing HTTP request,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 73.66,
          "end": 76.55,
          "en": "you could also just use Local State",
          "zh": ""
        },
        {
          "id": 27,
          "start": 76.55,
          "end": 80.03999999999999,
          "en": "and provide any feedback of your choice.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 80.03999999999999,
          "end": 83.15,
          "en": "My goal just is to show an overlay",
          "zh": ""
        },
        {
          "id": 29,
          "start": 83.15,
          "end": 85.93,
          "en": "a little notification at the bottom of the screen.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 85.93,
          "end": 90.93,
          "en": "And I wanna control that globally with the context API",
          "zh": ""
        },
        {
          "id": 31,
          "start": 90.95,
          "end": 93.59,
          "en": "so that we can trigger this notification",
          "zh": ""
        },
        {
          "id": 32,
          "start": 93.59,
          "end": 95.81,
          "en": "and control this notification",
          "zh": ""
        },
        {
          "id": 33,
          "start": 95.81,
          "end": 99.00999999999999,
          "en": "from anywhere in our application.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 99.00999999999999,
          "end": 101.06,
          "en": "That's my only goal here.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 101.06,
          "end": 104.8,
          "en": "Now, therefore, before we add react context",
          "zh": ""
        },
        {
          "id": 36,
          "start": 104.8,
          "end": 108.43,
          "en": "let's see how the end result is should look like.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 108.43,
          "end": 112.94,
          "en": "Let's go to the underscore app JS file in the pages folder.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 112.94,
          "end": 115.72999999999999,
          "en": "And there we have our layout.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 115.72999999999999,
          "end": 119.21000000000001,
          "en": "We have the head section with the general head data",
          "zh": ""
        },
        {
          "id": 40,
          "start": 119.21000000000001,
          "end": 121.26,
          "en": "and we got this component prop",
          "zh": ""
        },
        {
          "id": 41,
          "start": 121.26,
          "end": 124.48,
          "en": "which renders the actual page content.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 124.48,
          "end": 125.73,
          "en": "Now in here,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 125.73,
          "end": 129.58,
          "en": "I also wanna output the notification component.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 129.58,
          "end": 132.81,
          "en": "And for this, we need to import notification",
          "zh": ""
        },
        {
          "id": 45,
          "start": 132.81,
          "end": 135.72,
          "en": "from the components folder there",
          "zh": ""
        },
        {
          "id": 46,
          "start": 135.72,
          "end": 140.57,
          "en": "from UI and the notification JS file we just added.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 140.57,
          "end": 141.88,
          "en": "I'm just adding it here so",
          "zh": ""
        },
        {
          "id": 48,
          "start": 141.88,
          "end": 145.193,
          "en": "that you see what we will add from this section.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 146.06,
          "end": 150.46,
          "en": "This notification component takes three props",
          "zh": ""
        },
        {
          "id": 50,
          "start": 150.46,
          "end": 153.23,
          "en": "a title, a message, and a status.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 153.23,
          "end": 156.76,
          "en": "And therefore I'll set these three props here now.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 156.76,
          "end": 159.54,
          "en": "I'll set the title to test, the message",
          "zh": ""
        },
        {
          "id": 53,
          "start": 159.54,
          "end": 163.09,
          "en": "to this is a test, like this",
          "zh": ""
        },
        {
          "id": 54,
          "start": 163.09,
          "end": 166.023,
          "en": "and the status to pending, for a start.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 166.88,
          "end": 170.24,
          "en": "If we now save, we have this notification element",
          "zh": ""
        },
        {
          "id": 56,
          "start": 170.24,
          "end": 173.56,
          "en": "at the bottom, and the goal is to show this",
          "zh": ""
        },
        {
          "id": 57,
          "start": 173.56,
          "end": 176.03,
          "en": "once we did click the register button",
          "zh": ""
        },
        {
          "id": 58,
          "start": 176.03,
          "end": 178.85,
          "en": "and then once the request succeeded or failed",
          "zh": ""
        },
        {
          "id": 59,
          "start": 178.85,
          "end": 183.85,
          "en": "we wanna replace it with a proper error or success variant.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 185.06,
          "end": 187.29,
          "en": "Let me show you these variants here.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 187.29,
          "end": 189.39,
          "en": "If we changed as to success",
          "zh": ""
        },
        {
          "id": 62,
          "start": 189.39,
          "end": 193.02,
          "en": "if we change the status to success, this switches",
          "zh": ""
        },
        {
          "id": 63,
          "start": 193.02,
          "end": 197.25,
          "en": "to this success notification with a green background",
          "zh": ""
        },
        {
          "id": 64,
          "start": 197.25,
          "end": 200.71,
          "en": "and if on the other hand, we change it to error",
          "zh": ""
        },
        {
          "id": 65,
          "start": 200.71,
          "end": 203.493,
          "en": "this switches to this red notification.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 204.35,
          "end": 206.14,
          "en": "So that's the notification, but",
          "zh": ""
        },
        {
          "id": 67,
          "start": 206.14,
          "end": 209.07999999999998,
          "en": "of course it shouldn't be hard coded here.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 209.07999999999998,
          "end": 211.26,
          "en": "It shouldn't always show up.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 211.26,
          "end": 214.98,
          "en": "Instead it should only be shown when we want it",
          "zh": ""
        },
        {
          "id": 70,
          "start": 214.98,
          "end": 217.79,
          "en": "to show up when we have an ongoing request",
          "zh": ""
        },
        {
          "id": 71,
          "start": 217.79,
          "end": 221.97,
          "en": "or when we have a response from our request.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 221.97,
          "end": 225.53,
          "en": "And I wanna control it with the context API",
          "zh": ""
        },
        {
          "id": 73,
          "start": 225.53,
          "end": 228.93,
          "en": "because I want to render the notification component here",
          "zh": ""
        },
        {
          "id": 74,
          "start": 228.93,
          "end": 231.35,
          "en": "in underscore app JS,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 231.35,
          "end": 235.34,
          "en": "but I wanna trigger it from inside other components.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 235.34,
          "end": 236.42000000000002,
          "en": "For example, from",
          "zh": ""
        },
        {
          "id": 77,
          "start": 236.42000000000002,
          "end": 240,
          "en": "inside that newsletter registration component,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 240,
          "end": 244.14,
          "en": "where we also send this HTTP request.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 244.14,
          "end": 246.15,
          "en": "And because that's the case,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 246.15,
          "end": 248.58,
          "en": "because it is components should be triggered",
          "zh": ""
        },
        {
          "id": 81,
          "start": 248.58,
          "end": 251.88,
          "en": "from totally different components than the component",
          "zh": ""
        },
        {
          "id": 82,
          "start": 251.88,
          "end": 253.21,
          "en": "it's being rendered in,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 253.21,
          "end": 256.44,
          "en": "I wanna use app wide state management.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 256.44,
          "end": 258.93,
          "en": "I wanna use the context API",
          "zh": ""
        },
        {
          "id": 85,
          "start": 258.93,
          "end": 261.86,
          "en": "to a wide pointless prop drilling",
          "zh": ""
        },
        {
          "id": 86,
          "start": 261.86,
          "end": 266.49,
          "en": "and long prop chains across multiple components.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 266.49,
          "end": 270.283,
          "en": "And therefore let's now start using the context API.",
          "zh": ""
        }
      ]
    }
