          "zh": ""
        },
        {
          "id": 7,
          "start": 17.3,
          "end": 20.46,
          "en": "before you continue with this section.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.46,
          "end": 22.83,
          "en": "And with that out of the way attached",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.83,
          "end": 25.92,
          "en": "you'll find a notification component file",
          "zh": ""
        },
        {
          "id": 10,
          "start": 25.92,
          "end": 29.67,
          "en": "a sip file containing this notification JS",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.67,
          "end": 33.64,
          "en": "and this notification.module.css file.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 33.64,
          "end": 36.75,
          "en": "These two files are attached in this sip file",
