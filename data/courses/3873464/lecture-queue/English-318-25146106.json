          "zh": ""
        },
        {
          "id": 16,
          "start": 44.99,
          "end": 48.71,
          "en": "a new context for managing our notifications.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 48.71,
          "end": 52.89,
          "en": "Now we can provide an initialization object here,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 52.89,
          "end": 56.95,
          "en": "which defines the structure of this context",
          "zh": ""
        },
        {
          "id": 19,
          "start": 56.95,
          "end": 58.964,
          "en": "and the context so does object,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 58.964,
          "end": 63.35,
