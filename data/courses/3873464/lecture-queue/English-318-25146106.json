          "end": 6.79,
          "en": "which you don't have to do,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 6.79,
          "end": 10.81,
          "en": "but I wanna store my context related files",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.81,
          "end": 13.62,
          "en": "my application wide state related files",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.62,
          "end": 15.82,
          "en": "in a separate folder.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 15.82,
          "end": 18.17,
