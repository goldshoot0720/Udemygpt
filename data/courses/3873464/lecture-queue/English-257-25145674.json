      "sourceHash": "620227701a1a109438948e5db1910dc5fb91d2670212f91e21466118a559f73b",
      "cues": [
        {
          "id": 1,
          "start": 2.04,
          "end": 3.46,
          "en": "So let's solve this error",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.46,
          "end": 6.42,
          "en": "with the getStaticPaths function.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.42,
          "end": 9.72,
          "en": "For this in our pid.js file,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.72,
          "end": 12.48,
          "en": "I simply export another function.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.48,
          "end": 17.21,
          "en": "Another async function called getStaticPaths.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.21,
          "end": 19.3,
          "en": "And just like getStaticProps,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 19.3,
          "end": 22.44,
          "en": "you must make sure that you have no typo in there",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.44,
          "end": 26.113,
          "en": "because Next.js will look for this function specifically.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 27.14,
          "end": 29.55,
          "en": "Now the goal of this function",
          "zh": ""
        },
        {
          "id": 10,
          "start": 29.55,
          "end": 34.55,
          "en": "is to tell Next.js which instances of this dynamic page",
          "zh": ""
        },
        {
          "id": 11,
          "start": 35.14,
          "end": 37.09,
          "en": "should be generated.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 37.09,
          "end": 40,
          "en": "Therefore, this should return an object,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 40,
          "end": 42.42,
          "en": "just as getStaticProps does,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 42.42,
          "end": 45.79,
          "en": "but an object with different kinds of values.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 45.79,
          "end": 49.13,
          "en": "An object where you have a paths key.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 49.13,
          "end": 53.51,
          "en": "And that's now an array, an array full of objects.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 53.51,
          "end": 57.62,
          "en": "So that is a given structure, which you must return here.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 57.62,
          "end": 61.74,
          "en": "Now in this object, you must add a params key now,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 61.74,
          "end": 63.53,
          "en": "and that holds another object",
          "zh": ""
        },
        {
          "id": 20,
          "start": 63.53,
          "end": 66.47,
          "en": "where you have a bunch of key value pairs",
          "zh": ""
        },
        {
          "id": 21,
          "start": 66.47,
          "end": 68.7,
          "en": "where the keys are all the different",
          "zh": ""
        },
        {
          "id": 22,
          "start": 68.7,
          "end": 72.67,
          "en": "dynamic segment identifiers that might lead to this page.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 72.67,
          "end": 75.45,
          "en": "If that would be nested deeper in a folder",
          "zh": ""
        },
        {
          "id": 24,
          "start": 75.45,
          "end": 77.37,
          "en": "where the folder name is also dynamic,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 77.37,
          "end": 80.36,
          "en": "you could have multiple identifiers.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 80.36,
          "end": 81.53999999999999,
          "en": "Here it's only one.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 81.53999999999999,
          "end": 85.36,
          "en": "So pid, and the values are then the concrete values",
          "zh": ""
        },
        {
          "id": 28,
          "start": 85.36,
          "end": 87.483,
          "en": "for which this page should be generated.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 88.32,
          "end": 89.44,
          "en": "So here, for example,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 89.44,
          "end": 93.13,
          "en": "we know that we want to generate this page three times",
          "zh": ""
        },
        {
          "id": 31,
          "start": 93.13,
          "end": 95.75,
          "en": "for p one, p two, and p three",
          "zh": ""
        },
        {
          "id": 32,
          "start": 95.75,
          "end": 100.05,
          "en": "as values for this dynamic page identifier here.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 100.05,
          "end": 103.75,
          "en": "And therefore I'll set pid here to p one.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 103.75,
          "end": 106.53,
          "en": "And then I will repeat that.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 106.53,
          "end": 109.77000000000001,
          "en": "So now we just create another object",
          "zh": ""
        },
        {
          "id": 36,
          "start": 109.77000000000001,
          "end": 114.213,
          "en": "where params is set to another object with pid p two.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 115.25,
          "end": 118.87299999999999,
          "en": "And we now repeat this a third time here.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 120.13,
          "end": 123.01,
          "en": "So another object where params is then set",
          "zh": ""
        },
        {
          "id": 39,
          "start": 123.01,
          "end": 126.913,
          "en": "to p three, like this.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 128.25,
          "end": 133.25,
          "en": "Now this tells Next.js that this dynamic page here",
          "zh": ""
        },
        {
          "id": 41,
          "start": 133.29,
          "end": 138.29,
          "en": "should be pre-generated three times with these three values",
          "zh": ""
        },
        {
          "id": 42,
          "start": 138.73,
          "end": 142.023,
          "en": "as a value for this dynamic segment identifier.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 142.92000000000002,
          "end": 147.19,
          "en": "And then Next.js will call getStaticProps three times",
          "zh": ""
        },
        {
          "id": 44,
          "start": 147.19,
          "end": 149.01,
          "en": "for these different ideas.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 149.01,
          "end": 152.21,
          "en": "And we then can extract that ID like this",
          "zh": ""
        },
        {
          "id": 46,
          "start": 152.21,
          "end": 153.743,
          "en": "inside of this function.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 154.74,
          "end": 155.73,
          "en": "Now for this to work,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 155.73,
          "end": 159.55,
          "en": "we also need to add another key next to paths,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 159.55,
          "end": 161.98,
          "en": "and that's the fallback key,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 161.98,
          "end": 165.37,
          "en": "which for the moment should be set to false.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 165.37,
          "end": 166.79,
          "en": "I'll come back to that later.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 166.79,
          "end": 168.39,
          "en": "For the moment, set it to false.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 168.39,
          "end": 171.91,
          "en": "And then if you save everything, you will see",
          "zh": ""
        },
        {
          "id": 54,
          "start": 171.91,
          "end": 175.29,
          "en": "that if you will load local host 3000 slash p two,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 175.29,
          "end": 178.63,
          "en": "for example, you have the Product Two page.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 178.63,
          "end": 180.27,
          "en": "If I go back to the starting page",
          "zh": ""
        },
        {
          "id": 57,
          "start": 180.27,
          "end": 182.02,
          "en": "and I click on product three,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 182.02,
          "end": 184.72,
          "en": "I have product three data here.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 184.72,
          "end": 188.43,
          "en": "And now that is displayed correctly and successfully",
          "zh": ""
        },
        {
          "id": 60,
          "start": 188.43,
          "end": 193.43,
          "en": "because it was pre-generated successfully by Next.js.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 193.67,
          "end": 196.7,
          "en": "And therefore getStaticPaths is required",
          "zh": ""
        },
        {
          "id": 62,
          "start": 196.7,
          "end": 200.88,
          "en": "to tell Next.js which concrete instances",
          "zh": ""
        },
        {
          "id": 63,
          "start": 200.88,
          "end": 204.513,
          "en": "of this dynamic page must be pre-generated.",
          "zh": ""
        }
      ]
    }
