  "lectures": [
    {
      "id": "43341182",
      "title": "Protecting Routes Against Unauthenticated Access",
      "lectureOrder": 217,
      "videoOrder": 203,
      "sourceHash": "692e64cb494eef58ebf2038b94cdbd4611029eb4e101d71974348d387ea61f8a",
      "cues": [
        {
          "id": 1,
          "start": 0.3,
          "end": 4.29,
          "en": "So let's use verifyAuth to protect pages.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.29,
          "end": 6.27,
          "en": "And here in this basic demo app,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.27,
          "end": 9.48,
          "en": "I have just one page that should be protected.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.48,
          "end": 13.05,
          "en": "But of course you could now use this verifyAuth function",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.05,
          "end": 16.8,
          "en": "in any page, or in any API route,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.8,
          "end": 19.833,
          "en": "whatever it is that needs to be protected.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.91,
          "end": 23.43,
          "en": "So here it's that training page,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 23.43,
          "end": 28.43,
          "en": "where I will call verifyAuth before I do anything else.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 30.3,
          "end": 32.25,
          "en": "Because I don't wanna fetch training data",
          "zh": ""
        },
        {
          "id": 10,
          "start": 32.25,
          "end": 34.26,
          "en": "if the user is not logged in.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 34.26,
          "end": 36.933,
          "en": "So that's the first thing I'll call.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 37.92,
          "end": 41.37,
          "en": "Now we need to await this because that returns a promise,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 41.37,
          "end": 42.57,
          "en": "and as you learned,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 42.57,
          "end": 45.933,
          "en": "we'll get back an object here from verifyAuth,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 47.22,
          "end": 52.22,
          "en": "a result object, which has a user key and a session key.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 52.77,
          "end": 56.28,
          "en": "Though both user and session may be null",
          "zh": ""
        },
        {
          "id": 17,
          "start": 56.28,
          "end": 59.973,
          "en": "if we did not find a valid session for the user.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 61.17,
          "end": 65.55,
          "en": "So here we can check if not result.user,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 65.55,
          "end": 69.21000000000001,
          "en": "so if that result object contains no user data,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 69.21000000000001,
          "end": 70.47,
          "en": "in which case we know",
          "zh": ""
        },
        {
          "id": 21,
          "start": 70.47,
          "end": 74.133,
          "en": "that the request is coming from an unauthenticated user.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 75.69,
          "end": 76.56,
          "en": "And in that case,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 76.56,
          "end": 80.85,
          "en": "I wanna return here and not execute any other code.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 80.85,
          "end": 82.98,
          "en": "I don't wanna fetch training data,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 82.98,
          "end": 85.83,
          "en": "I don't wanna render and send back that page.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 85.83,
          "end": 89.31,
          "en": "Instead, I want to redirect the user",
          "zh": ""
        },
        {
          "id": 27,
          "start": 89.31,
          "end": 92.03999999999999,
          "en": "and send them to a different page.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 92.03999999999999,
          "end": 94.56,
          "en": "We can do that with help of the redirect function",
          "zh": ""
        },
        {
          "id": 29,
          "start": 94.56,
          "end": 96.663,
          "en": "provided by next navigation.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 98.58,
          "end": 101.49000000000001,
          "en": "And I wanna send the user to the starting page here",
          "zh": ""
        },
        {
          "id": 31,
          "start": 101.49000000000001,
          "end": 105.09,
          "en": "in this case, so that they can't visit this page.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 105.09,
          "end": 107.82,
          "en": "Whenever they try, if they're not logged in,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 107.82,
          "end": 110.223,
          "en": "they will be sent back to the starting page.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 111.53999999999999,
          "end": 116.1,
          "en": "Now keep in mind, here, in my case, I did log in before.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 116.1,
          "end": 119.16,
          "en": "So if I save everything and I go back",
          "zh": ""
        },
        {
          "id": 36,
          "start": 119.16,
          "end": 123.9,
          "en": "and I reload that training page, that works.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 123.9,
          "end": 126.99,
          "en": "Here, if I click that reload icon,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 126.99,
          "end": 131.1,
          "en": "I can visit this page as often as I want.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 131.1,
          "end": 133.23,
          "en": "But that will now change if I delete",
          "zh": ""
        },
        {
          "id": 40,
          "start": 133.23,
          "end": 135.54,
          "en": "that authentication cookie.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 135.54,
          "end": 138.63,
          "en": "So if I go to the application tab and the dev tools",
          "zh": ""
        },
        {
          "id": 42,
          "start": 138.63,
          "end": 143.463,
          "en": "and there I select this cookie, if I delete it,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 144.72,
          "end": 147.87,
          "en": "and I then try to reload, you see,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 147.87,
          "end": 150.48,
          "en": "I'm redirected back to that starting page.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 150.48,
          "end": 153.66,
          "en": "Because no valid authentication cookie",
          "zh": ""
        },
        {
          "id": 46,
          "start": 153.66,
          "end": 156.54,
          "en": "was attached to the request.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 156.54,
          "end": 158.1,
          "en": "And that's the offer.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 158.1,
          "end": 160.38,
          "en": "What we actually want to do automatically,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 160.38,
          "end": 162.84,
          "en": "if the user clicks a logout button,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 162.84,
          "end": 167.1,
          "en": "which we don't have on this page yet, we'll add one soon.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 167.1,
          "end": 168.75,
          "en": "But before we do that,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 168.75,
          "end": 172.02,
          "en": "I wanna make sure that we can actually log in",
          "zh": ""
        },
        {
          "id": 53,
          "start": 172.02,
          "end": 176.04,
          "en": "because thus far, we only support user creation,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 176.04,
          "end": 178.44,
          "en": "and that's of course not all we need.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 178.44,
          "end": 180.81,
          "en": "Instead, I also wanna allow users",
          "zh": ""
        },
        {
          "id": 56,
          "start": 180.81,
          "end": 183.36,
          "en": "to log in with existing accounts,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 183.36,
          "end": 185.223,
          "en": "and that's what we'll do next.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
