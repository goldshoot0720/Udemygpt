        },
        {
          "id": 107,
          "start": 349.61,
          "end": 351.51,
          "en": "passed between the text.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 351.51,
          "end": 356.51,
          "en": "And where we then set the onClick prop to props.onClick.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 356.909,
          "end": 360.133,
          "en": "So that can use our own button just as the built in button.",
