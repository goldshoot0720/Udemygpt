        },
        {
          "id": 3,
          "start": 8.24,
          "end": 10.29,
          "en": "above that list of events,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.29,
          "end": 14.88,
          "en": "where we can select a year and a month in dropdown menus.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 14.88,
          "end": 16.84,
          "en": "And when we selected a combination",
