        },
        {
          "id": 18,
          "start": 52.78,
          "end": 56.037,
          "en": "and I'll name it, events-search.js.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 56.037,
          "end": 58.85,
          "en": "Now this will hold functional component,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 58.85,
          "end": 62.318,
          "en": "the EventsSearch component,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 62.318,
          "end": 65.93,
          "en": "which receives props and which we, as always,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 65.93,
          "end": 67.453,
          "en": "export, of course.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 68.95,
          "end": 69.783,
          "en": "Like this.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 70.667,
          "end": 72.98,
          "en": "And then in here, we'll have a couple of things",
          "zh": ""
        },
        {
          "id": 25,
          "start": 72.98,
          "end": 74.53,
          "en": "which we need to do.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 74.53,
          "end": 77.06,
          "en": "First of all, I'll start with the JSX code",
          "zh": ""
        },
        {
          "id": 27,
          "start": 77.06,
          "end": 78.58,
          "en": "that should be returned.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 78.58,
          "end": 81.16,
