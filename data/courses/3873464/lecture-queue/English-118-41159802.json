  "lectures": [
    {
      "id": "41159802",
      "title": "Building For Production & Understanding NextJS Caching",
      "lectureOrder": 127,
      "videoOrder": 118,
      "sourceHash": "575181fe47e013220d6fe5504749aca54d422f84a7c099def9dce9ee9025b93f",
      "cues": [
        {
          "id": 1,
          "start": 0.48,
          "end": 3.66,
          "en": "So sharing meals works now,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.66,
          "end": 7.983,
          "en": "but there actually is one problem with our application.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 8.91,
          "end": 13.05,
          "en": "Everything works fine here during development when using",
          "zh": ""
        },
        {
          "id": 4,
          "start": 13.05,
          "end": 15.45,
          "en": "that development server,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 15.45,
          "end": 19.383,
          "en": "but things will change once we move to production.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 20.4,
          "end": 24.54,
          "en": "Now, to move from development to production, we should quit",
          "zh": ""
        },
        {
          "id": 7,
          "start": 24.54,
          "end": 26.14,
          "en": "that development server here",
          "zh": ""
        },
        {
          "id": 8,
          "start": 27.3,
          "end": 30.66,
          "en": "and then run another script in the terminal,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 30.66,
          "end": 33.333,
          "en": "navigate it into our project folder still.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 34.17,
          "end": 37.053,
          "en": "And that's the NPM Run build script.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 37.95,
          "end": 39.24,
          "en": "This will build",
          "zh": ""
        },
        {
          "id": 12,
          "start": 39.24,
          "end": 43.5,
          "en": "and prepare our NextJS application for production.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 43.5,
          "end": 46.14,
          "en": "It will essentially give us a project",
          "zh": ""
        },
        {
          "id": 14,
          "start": 46.14,
          "end": 49.083,
          "en": "that we could then deploy onto a server.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 50.19,
          "end": 53.58,
          "en": "Now you can run that production server",
          "zh": ""
        },
        {
          "id": 16,
          "start": 53.58,
          "end": 57.81,
          "en": "and that optimized code by then running NPM start.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 57.81,
          "end": 62.31,
          "en": "So first NPM run build, and then thereafter NPM start.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 62.31,
          "end": 64.32,
          "en": "This will start a server,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 64.32,
          "end": 66.96,
          "en": "but now not some development server,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 66.96,
          "end": 70.38,
          "en": "but instead the production server,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 70.38,
          "end": 73.44,
          "en": "which here is still served under the same address,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 73.44,
          "end": 77.37,
          "en": "but now it's serving that optimized code and so on.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 77.37,
          "end": 82.11,
          "en": "Now therefore you can revisit local host 3000",
          "zh": ""
        },
        {
          "id": 24,
          "start": 82.11,
          "end": 85.83,
          "en": "and you should, for example, still see your meals there,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 85.83,
          "end": 88.98,
          "en": "but you'll now notice something strange",
          "zh": ""
        },
        {
          "id": 26,
          "start": 88.98,
          "end": 90.57300000000001,
          "en": "when you add a new meal.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 91.47,
          "end": 96.42,
          "en": "For that, I'll again, going to enter some data",
          "zh": ""
        },
        {
          "id": 28,
          "start": 96.42,
          "end": 98.88300000000001,
          "en": "and I'll name my meal, tasty Bruschetta,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 99.78,
          "end": 101.313,
          "en": "Very delicious.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 102.27000000000001,
          "end": 106.06,
          "en": "Add my instructions like this",
          "zh": ""
        },
        {
          "id": 31,
          "start": 107.00999999999999,
          "end": 109.203,
          "en": "and pick the same image as always.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 110.67,
          "end": 113.43,
          "en": "If I now click share meal, I'm redirected.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 113.43,
          "end": 116.1,
          "en": "And this is now quicker, as I mentioned before.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 116.1,
          "end": 118.773,
          "en": "That's great, it's quicker, better user experience,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 119.7,
          "end": 121.233,
          "en": "but the meal is missing here.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 122.22,
          "end": 125.34,
          "en": "I see the three meals I submitted before,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 125.34,
          "end": 128.64,
          "en": "but this new meal is missing.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 128.64,
          "end": 132.33,
          "en": "Keep in mind that I added a text of very delicious to it",
          "zh": ""
        },
        {
          "id": 39,
          "start": 132.33,
          "end": 135.153,
          "en": "and I don't see that text anywhere here.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 136.11,
          "end": 137.73,
          "en": "And there's one other thing",
          "zh": ""
        },
        {
          "id": 41,
          "start": 137.73,
          "end": 140.643,
          "en": "that's pretty strange here on this site.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 141.48,
          "end": 145.38,
          "en": "If I go back to the starting page for example, and I reload",
          "zh": ""
        },
        {
          "id": 43,
          "start": 145.38,
          "end": 147.66,
          "en": "and I then go to browse meals,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 147.66,
          "end": 150.12,
          "en": "I'm there pretty much instantly.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 150.12,
          "end": 152.19,
          "en": "If I'm on this page and I reload,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 152.19,
          "end": 155.67000000000002,
          "en": "it also reloads pretty much instantly.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 155.67000000000002,
          "end": 160.29,
          "en": "You might recall that before, this took five seconds",
          "zh": ""
        },
        {
          "id": 48,
          "start": 160.29,
          "end": 165.29,
          "en": "because I added this extra delay here in the meals.js file,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 165.54,
          "end": 166.59300000000002,
          "en": "this delay.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 167.73,
          "end": 170.49,
          "en": "Why is this missing here in production",
          "zh": ""
        },
        {
          "id": 51,
          "start": 170.49,
          "end": 173.253,
          "en": "and why is this meal we added missing?",
          "zh": ""
        },
        {
          "id": 52,
          "start": 174.36,
          "end": 178.59,
          "en": "Well, because as mentioned earlier in this section,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 178.59,
          "end": 183.59,
          "en": "NextJS performs some pretty aggressive caching",
          "zh": ""
        },
        {
          "id": 54,
          "start": 183.66,
          "end": 187.86,
          "en": "and there is one extra step it performs",
          "zh": ""
        },
        {
          "id": 55,
          "start": 187.86,
          "end": 191.7,
          "en": "and goes through when preparing the app for production",
          "zh": ""
        },
        {
          "id": 56,
          "start": 191.7,
          "end": 194.25,
          "en": "that we didn't see when testing it",
          "zh": ""
        },
        {
          "id": 57,
          "start": 194.25,
          "end": 195.753,
          "en": "with the development server.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 197.04,
          "end": 201.78,
          "en": "Because when you run this NPM run build command",
          "zh": ""
        },
        {
          "id": 59,
          "start": 201.78,
          "end": 206.55,
          "en": "to prepare the app for production, NextJS goes ahead",
          "zh": ""
        },
        {
          "id": 60,
          "start": 206.55,
          "end": 211.55,
          "en": "and actually generates, pre-renders all the pages",
          "zh": ""
        },
        {
          "id": 61,
          "start": 211.68,
          "end": 215.13,
          "en": "of your app that can be pre-generated,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 215.13,
          "end": 218.463,
          "en": "so basically all non-dynamic pages.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 219.69,
          "end": 224.69,
          "en": "So it, for example, pre-generated the meals page.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 225,
          "end": 228.15,
          "en": "So this page.js file in the meals folder,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 228.15,
          "end": 231.03,
          "en": "this page here, which outputs some meals,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 231.03,
          "end": 236.03,
          "en": "it was pre-generated, so all that data was fetched",
          "zh": ""
        },
        {
          "id": 67,
          "start": 236.57999999999998,
          "end": 240.24,
          "en": "and rendered there during the build process.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 240.24,
          "end": 242.64,
          "en": "And NextJS is doing that",
          "zh": ""
        },
        {
          "id": 69,
          "start": 242.64,
          "end": 245.7,
          "en": "because by pre-rendering all these pages,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 245.7,
          "end": 248.79,
          "en": "it of course has those pages available right",
          "zh": ""
        },
        {
          "id": 71,
          "start": 248.79,
          "end": 251.55,
          "en": "from the start after being deployed.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 251.55,
          "end": 255.81,
          "en": "And so the very first visitor of your website is able",
          "zh": ""
        },
        {
          "id": 73,
          "start": 255.81,
          "end": 259.56,
          "en": "to instantly see the finished page without having to wait",
          "zh": ""
        },
        {
          "id": 74,
          "start": 259.56,
          "end": 261.36,
          "en": "for anything to render,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 261.36,
          "end": 264.723,
          "en": "which of course can be a great user experience.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 266.04,
          "end": 270.72,
          "en": "And NextJS then caches those pre-rendered pages so",
          "zh": ""
        },
        {
          "id": 77,
          "start": 270.72,
          "end": 273.543,
          "en": "that it's able to serve them to all visitors.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 274.38,
          "end": 276.63,
          "en": "But the downside of this approach, of course,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 276.63,
          "end": 280.11,
          "en": "is that it never re-fetches the meals",
          "zh": ""
        },
        {
          "id": 80,
          "start": 280.11,
          "end": 283.44,
          "en": "because this code here never executes again.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 283.44,
          "end": 288.42,
          "en": "Instead, it just uses those pre-generated pages.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 288.42,
          "end": 292.56,
          "en": "And I can prove that we can simply console log,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 292.56,
          "end": 296.31,
          "en": "fetching meals here in that meals component",
          "zh": ""
        },
        {
          "id": 84,
          "start": 296.31,
          "end": 298.383,
          "en": "that's being used by the meals page.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 300.12,
          "end": 304.98,
          "en": "And if I do that and I then rebuild my project",
          "zh": ""
        },
        {
          "id": 86,
          "start": 304.98,
          "end": 308.89,
          "en": "by running NPM run build again, you will see",
          "zh": ""
        },
        {
          "id": 87,
          "start": 309.81,
          "end": 313.44,
          "en": "that it generates all those pages",
          "zh": ""
        },
        {
          "id": 88,
          "start": 313.44,
          "end": 317.673,
          "en": "and then once it's done, if I start that production server,",
          "zh": ""
        },
        {
          "id": 89,
          "start": 318.75,
          "end": 323.553,
          "en": "if I reload the meals page, I don't see fetching meals here.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 324.6,
          "end": 326.28,
          "en": "I get some warning that we might want",
          "zh": ""
        },
        {
          "id": 91,
          "start": 326.28,
          "end": 328.59,
          "en": "to install some extra package when using",
          "zh": ""
        },
        {
          "id": 92,
          "start": 328.59,
          "end": 331.77,
          "en": "that image component, but we can ignore that here.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 331.77,
          "end": 332.82,
          "en": "The main thing is",
          "zh": ""
        },
        {
          "id": 94,
          "start": 332.82,
          "end": 335.90999999999997,
          "en": "that we don't see this message being logged,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 335.90999999999997,
          "end": 338.73,
          "en": "so that is not executing anymore",
          "zh": ""
        },
        {
          "id": 96,
          "start": 338.73,
          "end": 342.33299999999997,
          "en": "because those pages were pre-generated and cached.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 343.29,
          "end": 346.74,
          "en": "But that's of course a problem if the data that's visible on",
          "zh": ""
        },
        {
          "id": 98,
          "start": 346.74,
          "end": 350.49,
          "en": "that page changes as is the case for me here.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 350.49,
          "end": 353.67,
          "en": "Now you can see that latest meal I added earlier now",
          "zh": ""
        },
        {
          "id": 100,
          "start": 353.67,
          "end": 356.15999999999997,
          "en": "because I regenerated all the pages,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 356.15999999999997,
          "end": 358.5,
          "en": "but if I would add another new meal here,",
          "zh": ""
        },
        {
          "id": 102,
          "start": 358.5,
          "end": 360.48,
          "en": "it would again be missing.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 360.48,
          "end": 361.92,
          "en": "And that's of course",
          "zh": ""
        },
        {
          "id": 104,
          "start": 361.92,
          "end": 364.713,
          "en": "absolutely not the behavior we want here.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
