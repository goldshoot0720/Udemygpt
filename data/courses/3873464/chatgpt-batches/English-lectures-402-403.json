      "videoOrder": 370,
      "sourceHash": "f8e132b0f2f04f801c24bf76005edc2b7a7d163c9e73682fc3f1f46f7d7cb8cf",
      "cues": [
        {
          "id": 1,
          "start": 2.14,
          "end": 4.87,
          "en": "At the moment we only have the API route",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.87,
          "end": 6.42,
          "en": "for logging users in.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.42,
          "end": 10.92,
          "en": "We also need the front-end logic in the auth-form component.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.92,
          "end": 15.26,
          "en": "There, we have to check whether we are logging in,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 15.26,
          "end": 17.8,
          "en": "but we're not doing anything If we are.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.8,
          "end": 20.46,
          "en": "Well, here we need to sign the user in.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.46,
          "end": 25.46,
          "en": "And here we now don't need to send our own http request.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 25.46,
          "end": 27.73,
          "en": "We don't need to configure it ourselves.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 27.73,
          "end": 29.42,
          "en": "And we shouldn't.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 29.42,
          "end": 34.42,
          "en": "Instead here we'll again import from next dash auth,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 35.22,
          "end": 38.483,
          "en": "but now from next dash auth slash client.",
