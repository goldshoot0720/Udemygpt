          "en": "and let's submit our survey result here.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 299.93,
          "end": 301.4,
          "en": "Now, did it work?",
          "zh": ""
        },
        {
          "id": 102,
          "start": 301.4,
          "end": 303.72,
          "en": "Let's have a look at Firebase.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 303.72,
          "end": 304.92,
          "en": "It should have worked,",
          "zh": ""
        },
        {
          "id": 104,
          "start": 304.92,
