        },
        {
          "id": 51,
          "start": 145.82999999999998,
          "end": 148.42000000000002,
          "en": "And I'm doing that here so that we see it in action.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 148.42000000000002,
          "end": 151.51,
          "en": "I'm setting the active class to just active.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 151.51,
          "end": 153.95,
          "en": "And that means I need to change my styling here",
          "zh": ""
        },
        {
          "id": 54,
