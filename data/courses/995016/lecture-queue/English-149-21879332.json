          "end": 97.97999999999999,
          "en": "will be applied to any navigation item,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 97.97999999999999,
          "end": 101.25999999999999,
          "en": "which contains a part of the currently active route.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 101.25999999999999,
          "end": 103.22,
          "en": "At the moment, we have no situation",
          "zh": ""
        },
        {
          "id": 33,
          "start": 103.22,
          "end": 104.97,
          "en": "where we would have nested routes.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 104.97,
          "end": 107.25,
          "en": "So at the moment it's either both or nothing,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 107.25,
          "end": 109.733,
          "en": "but later we'll see the difference in action.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 110.91,
          "end": 112.41,
          "en": "For the moment, it's just important",
          "zh": ""
        },
        {
          "id": 37,
          "start": 112.41,
          "end": 114.15,
          "en": "to be aware of these classes,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 114.15,
          "end": 117.42,
          "en": "which helped you style your application.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 117.42,
          "end": 119.65,
          "en": "You can also change those default classes",
          "zh": ""
        },
        {
          "id": 40,
          "start": 119.65,
          "end": 121.48,
          "en": "in case you're not happy with them",
