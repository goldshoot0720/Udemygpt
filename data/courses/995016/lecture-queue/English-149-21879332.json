        },
        {
          "id": 42,
          "start": 124.64,
          "end": 126.57,
          "en": "you got more config options,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 126.57,
          "end": 127.49,
          "en": "and you've gotta linkActive",
          "zh": ""
        },
        {
          "id": 44,
          "start": 127.49,
          "end": 131,
          "en": "and a linkExactActiveClass option,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 131,
          "end": 134.53,
