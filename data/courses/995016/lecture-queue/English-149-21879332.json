          "end": 9.62,
          "en": "which are added by router-link to the created anchor tag.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 9.62,
          "end": 12.95,
          "en": "And for that here in TheNavigation.vue",
          "zh": ""
        },
        {
          "id": 4,
          "start": 12.95,
          "end": 16.57,
          "en": "I will actually add a new selector here",
          "zh": ""
        },
        {
          "id": 5,
          "start": 16.57,
          "end": 19.08,
          "en": "to this hover and active rule.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 19.08,
          "end": 21.11,
          "en": "And the that's anchor tag,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 21.11,
          "end": 25.54,
          "en": "which has the router-link-active class on it.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 25.54,
          "end": 29.34,
