          "end": 376.96,
          "en": "from dot slash components UI base dialogue dot view,",
          "zh": ""
        },
        {
          "id": 117,
          "start": 377.16,
          "end": 382.16,
          "en": "and then added with app component based dialogue",
          "zh": ""
        },
        {
          "id": 118,
          "start": 382.26,
          "end": 385.33299999999997,
          "en": "and point at my base dialogue config object.",
