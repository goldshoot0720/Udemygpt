      "cues": [
        {
          "id": 1,
          "start": 2.17,
          "end": 4.04,
          "en": "There's another feature",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.04,
          "end": 7.87,
          "en": "or aspect about components you should be aware of.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.87,
          "end": 11.99,
          "en": "In some components, like the header here,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.99,
          "end": 15.72,
          "en": "we have only one root HTML element,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 15.72,
          "end": 17.52,
          "en": "like the header element here,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.52,
          "end": 19.75,
          "en": "and all our elements, in this case,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 19.75,
          "end": 24.293,
          "en": "the only other element, h1, are child elements of that.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 25.72,
          "end": 29.29,
          "en": "In other components, like managed goals on the other hand,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 29.29,
          "end": 34.28,
          "en": "we theoretically have multiple top-level HTML elements,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 34.28,
          "end": 37.83,
          "en": "at least if I remove that div here.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 37.83,
          "end": 40.3,
          "en": "And it is important to know,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 40.3,
          "end": 43.33,
          "en": "to be aware of the fact that this is okay,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 43.33,
          "end": 46.91,
          "en": "and I'm highlighting this because in Vue two,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 46.91,
          "end": 48.85,
          "en": "this was actually not supported.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 48.85,
          "end": 52.9,
          "en": "In Vue.js version two, you were required",
          "zh": ""
        },
        {
          "id": 16,
          "start": 52.9,
          "end": 56.47,
          "en": "to have one root level element per template,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 56.47,
          "end": 57.94,
          "en": "and then, in there, you could have",
          "zh": ""
        },
        {
          "id": 18,
          "start": 57.94,
          "end": 60.75,
          "en": "as many sibling elements as you wanted to.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 60.75,
          "end": 63.84,
          "en": "In Vue free, this changed,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 63.84,
          "end": 65.6,
          "en": "and now, you can have as many",
          "zh": ""
        },
        {
          "id": 21,
          "start": 65.6,
          "end": 68.19,
          "en": "top-level elements as you want.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 68.19,
          "end": 71.01,
          "en": "So if you don't need a wrapping element for semantic",
          "zh": ""
        },
        {
          "id": 23,
          "start": 71.01,
          "end": 75.37,
          "en": "or styling reasons, there is no reason to keep one around.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 75.37,
          "end": 77.6,
          "en": "This is a feature called fragments.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 77.6,
          "end": 81.07300000000001,
          "en": "You are allowed to have multiple top-level elements now.",
          "zh": ""
        }
      ]
