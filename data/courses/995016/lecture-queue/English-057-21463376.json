      "cues": [
        {
          "id": 1,
          "start": 2.24,
          "end": 5.24,
          "en": "Now that we explored reactivity.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 5.24,
          "end": 6.89,
          "en": "I already want to leave it.",
          "zh": ""
        },
        {
          "id": 3,
