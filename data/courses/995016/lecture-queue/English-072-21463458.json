          "en": "because, well, my IDE does not understand",
          "zh": ""
        },
        {
          "id": 108,
          "start": 346.43,
          "end": 348.61,
          "en": "this .vue file at all.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 348.61,
          "end": 352.64,
          "en": "It's just a bunch of white text, no syntax highlighting.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 352.64,
