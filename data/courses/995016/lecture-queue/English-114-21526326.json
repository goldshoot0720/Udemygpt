        },
        {
          "id": 67,
          "start": 212.52,
          "end": 216.333,
          "en": "for this BaseCard component we're importing here.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 218.29,
          "end": 220.19,
          "en": "And with that if I saved this,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 220.19,
