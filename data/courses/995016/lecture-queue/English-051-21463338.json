        },
        {
          "id": 12,
          "start": 35.656,
          "end": 38.058,
          "en": "is below zero and so on.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 38.058,
          "end": 41.2,
          "en": "But we would have to repeat this check.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 41.2,
          "end": 43.31,
          "en": "We would have to repeat this check",
          "zh": ""
        },
        {
          "id": 15,
          "start": 43.31,
          "end": 45.67,
          "en": "in the special attack monster function,",
