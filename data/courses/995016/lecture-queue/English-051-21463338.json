        },
        {
          "id": 8,
          "start": 24.149,
          "end": 25.642,
          "en": "and the player got attacked.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 25.642,
          "end": 27.648,
          "en": "Here, we could check if this player health",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.648,
          "end": 31.981,
