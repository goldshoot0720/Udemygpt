        },
        {
          "id": 71,
          "start": 225.13,
          "end": 226.81,
          "en": "what we do with this information.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 226.81,
          "end": 229.07999999999998,
          "en": "We're just going to show something on the screen",
