        },
        {
          "id": 57,
          "start": 173.2,
          "end": 175.67000000000002,
          "en": "in the monster health watcher.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 175.67000000000002,
          "end": 180.4,
          "en": "There, indeed, I wanna check if the value.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 180.4,
          "end": 184.75,
          "en": "So now the monster health is smaller or equal than zero.",
