          "zh": ""
        },
        {
          "id": 4,
          "start": 12,
          "end": 14.8,
          "en": "the player and the monster health.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 14.8,
          "end": 16.96,
          "en": "That is what matters to us here.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.96,
          "end": 21.96,
