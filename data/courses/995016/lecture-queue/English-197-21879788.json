  "lectures": [
    {
      "id": "21879788",
      "title": "Understanding Local Module State",
      "lectureOrder": 224,
      "videoOrder": 197,
      "sourceHash": "04de56e72e106b0caa44026f07ef9df04af1e3c693c2498473bc13ab2fc5229d",
      "cues": [
        {
          "id": 1,
          "start": 1.498,
          "end": 3.87,
          "en": "I mentioned that modules",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.87,
          "end": 6.64,
          "en": "are merged into your main store",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.64,
          "end": 10.083,
          "en": "on the same level as all the other things in the store.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.95,
          "end": 12.57,
          "en": "You can change this behavior",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.57,
          "end": 13.98,
          "en": "and there is one place where",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.98,
          "end": 15.993,
          "en": "it actually already did change.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 16.89,
          "end": 18.457,
          "en": "Let's say inside of a mutation,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 18.457,
          "end": 22.89,
          "en": "inside of the increased mutation let's say ,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.89,
          "end": 25.83,
          "en": "we console.log, our state.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 25.83,
          "end": 27.777,
          "en": "So that's inside of the counter module now. .",
          "zh": ""
        },
        {
          "id": 11,
          "start": 27.777,
          "end": 29.863,
          "en": "Inside of the increased mutation.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 31.27,
          "end": 33.43,
          "en": "Well, let's have a look what happens",
          "zh": ""
        },
        {
          "id": 13,
          "start": 33.43,
          "end": 34.993,
          "en": "if we click add 10.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 36.2,
          "end": 39.56,
          "en": "This is the log here for our state.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 39.56,
          "end": 42.26,
          "en": "And if we have a look at this,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 42.26,
          "end": 44.32,
          "en": "we see something interesting.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 44.32,
          "end": 45.273,
          "en": "Do you notice it?",
          "zh": ""
        },
        {
          "id": 18,
          "start": 46.41,
          "end": 48.25,
          "en": "We see the counter in there.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 48.25,
          "end": 51.16,
          "en": "But there's one thing we don't see in here.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 51.16,
          "end": 53.42,
          "en": "Our authentication state,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 53.42,
          "end": 57.97,
          "en": "we don't see is locked in there,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 57.97,
          "end": 59.053,
          "en": "this state.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 59.91,
          "end": 63.49,
          "en": "Now I just said it would all be merged into one store.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 63.49,
          "end": 64.8,
          "en": "So why don't we see,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 64.8,
          "end": 67.383,
          "en": "is locked in here, in the state,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 68.72,
          "end": 70.913,
          "en": "of our counter module then.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 71.97,
          "end": 74.74,
          "en": "Because the state inside of a module,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 74.74,
          "end": 77.75,
          "en": "is actually treated as a local state,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 77.75,
          "end": 79.8,
          "en": "inside of the module.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 79.8,
          "end": 82.9,
          "en": "Mutations actions and getters are global,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 82.9,
          "end": 86.26,
          "en": "you can access them as before on the main store.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 86.26,
          "end": 89.56,
          "en": "But the state is local to this module.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 89.56,
          "end": 92.47999999999999,
          "en": "So anything you do on this state inside",
          "zh": ""
        },
        {
          "id": 34,
          "start": 92.47999999999999,
          "end": 94.83,
          "en": "of this module refers just",
          "zh": ""
        },
        {
          "id": 35,
          "start": 94.83,
          "end": 96.453,
          "en": "to this state module.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 97.44,
          "end": 99.5,
          "en": "So for example, in a getter,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 99.5,
          "end": 102.38,
          "en": "I would not be able to get the off status.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 102.38,
          "end": 104.95,
          "en": "If I add new getter,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 104.95,
          "end": 106.50999999999999,
          "en": "in the counter module,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 106.50999999999999,
          "end": 108.52000000000001,
          "en": "getters object, TestAuth",
          "zh": ""
        },
        {
          "id": 41,
          "start": 112.8,
          "end": 117.05,
          "en": "and I try to return state is locked in,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 117.05,
          "end": 118.55,
          "en": "this will not work.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 118.55,
          "end": 121.07,
          "en": "If I now try to access TestAuth,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 121.07,
          "end": 123.263,
          "en": "let's say in the UserAuth component,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 124.38,
          "end": 127.353,
          "en": "we had a number of computed property is TestAuth,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 128.21,
          "end": 129.97,
          "en": "where I returned is newly",
          "zh": ""
        },
        {
          "id": 47,
          "start": 129.97,
          "end": 131.573,
          "en": "added getter, TestAuth,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 133.17,
          "end": 136.25,
          "en": "which I just added to the counter module.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 136.25,
          "end": 138.2,
          "en": "If I access this here,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 138.2,
          "end": 140.79,
          "en": "and I then simply output the value,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 140.79,
          "end": 143.623,
          "en": "let's say in a paragraph, like this.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 144.93,
          "end": 147.62,
          "en": "So if I output this newly added computed property,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 147.62,
          "end": 150.4,
          "en": "which uses the new getter here,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 150.4,
          "end": 152.13,
          "en": "this will not work.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 152.13,
          "end": 152.963,
          "en": "First of all, though,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 152.963,
          "end": 154.373,
          "en": "I have to fix an error,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 155.41,
          "end": 158.65,
          "en": "in main.js in the new TestAuth getter.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 158.65,
          "end": 160.32,
          "en": "Of course, I should accept state",
          "zh": ""
        },
        {
          "id": 59,
          "start": 160.32,
          "end": 162.44299999999998,
          "en": "as a argument in order to use it.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 163.81,
          "end": 165.09,
          "en": "But even with that,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 165.09,
          "end": 168.04500000000002,
          "en": "you notice there's nothing below the button.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 168.04500000000002,
          "end": 170.75,
          "en": "And if we change it, there's still nothing",
          "zh": ""
        },
        {
          "id": 63,
          "start": 170.75,
          "end": 173.37,
          "en": "because it doesn't find is locked",
          "zh": ""
        },
        {
          "id": 64,
          "start": 173.37,
          "end": 175.156,
          "en": "in the getter here.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 175.156,
          "end": 176.68,
          "en": "In the state of this getter.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 176.68,
          "end": 179.76,
          "en": "Because this getter is in the counter module.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 179.76,
          "end": 182.47,
          "en": "And as As I mentioned, the state is local.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 182.47,
          "end": 184.05,
          "en": "So here we only have access",
          "zh": ""
        },
        {
          "id": 69,
          "start": 184.05,
          "end": 186.933,
          "en": "to the state that belongs to this module.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 187.86,
          "end": 190.01,
          "en": "So that's important to keep in mind.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 190.01,
          "end": 191.91,
          "en": "And it's similar for actions",
          "zh": ""
        },
        {
          "id": 72,
          "start": 191.91,
          "end": 194.75,
          "en": "and mutations there in context,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 194.75,
          "end": 197.132,
          "en": "for example, where you learned earlier,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 197.132,
          "end": 199.95,
          "en": "that you all have access to the state,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 199.95,
          "end": 201.23,
          "en": "in case you needed it,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 201.23,
          "end": 202.68,
          "en": "you also only have access",
          "zh": ""
        },
        {
          "id": 77,
          "start": 202.68,
          "end": 205.083,
          "en": "to the state of this module.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 206.81,
          "end": 208.85,
          "en": "Now in case you need to work around that,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 208.85,
          "end": 210.75,
          "en": "there are ways though.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 210.75,
          "end": 214.31,
          "en": "For example, in getters inside of a module,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 214.31,
          "end": 216.14,
          "en": "you now don't just get state",
          "zh": ""
        },
        {
          "id": 82,
          "start": 216.14,
          "end": 218.09,
          "en": "and getters as before,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 218.09,
          "end": 219.53,
          "en": "but you can now also get access",
          "zh": ""
        },
        {
          "id": 84,
          "start": 219.53,
          "end": 221.793,
          "en": "to a root state and root getters.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 223.09,
          "end": 224.37,
          "en": "And you might remember,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 224.37,
          "end": 227,
          "en": "that we saw similar properties",
          "zh": ""
        },
        {
          "id": 87,
          "start": 227,
          "end": 230.28300000000002,
          "en": "on this context object earlier in the module.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 231.75,
          "end": 233.69,
          "en": "This is your way of getting access",
          "zh": ""
        },
        {
          "id": 89,
          "start": 233.69,
          "end": 235.54,
          "en": "to the main state,",
          "zh": ""
        },
        {
          "id": 90,
          "start": 235.54,
          "end": 238.95,
          "en": "the main getters of the entire store instead",
          "zh": ""
        },
        {
          "id": 91,
          "start": 238.95,
          "end": 242.493,
          "en": "of just the state of this specific module.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 243.67,
          "end": 245.72,
          "en": "So this is your fallback way",
          "zh": ""
        },
        {
          "id": 93,
          "start": 245.72,
          "end": 248.62,
          "en": "of getting access to state that's not part",
          "zh": ""
        },
        {
          "id": 94,
          "start": 248.62,
          "end": 251.073,
          "en": "of this module, in case you needed.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 252.2,
          "end": 253.87,
          "en": "Typically, though, of course,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 253.87,
          "end": 255.2,
          "en": "inside of a module,",
          "zh": ""
        },
        {
          "id": 97,
          "start": 255.2,
          "end": 257.82,
          "en": "you tend to just work with the state",
          "zh": ""
        },
        {
          "id": 98,
          "start": 257.82,
          "end": 259.39,
          "en": "that belongs to the module.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 259.39,
          "end": 261.8,
          "en": "So you probably don't need this too often,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 261.8,
          "end": 264.28,
          "en": "but there can definitely be situations",
          "zh": ""
        },
        {
          "id": 101,
          "start": 264.28,
          "end": 265.563,
          "en": "where you do need it.",
          "zh": ""
        }
      ]
    }
