        },
        {
          "id": 140,
          "start": 415.6,
          "end": 420.43,
          "en": "when that one property, the message property here, changed.",
          "zh": ""
        },
        {
          "id": 141,
          "start": 420.43,
          "end": 423.04,
          "en": "And in a nutshell, and of course,",
