        },
        {
          "id": 152,
          "start": 454.14,
          "end": 456.436,
          "en": "when you're setting a new value.",
          "zh": ""
        },
        {
          "id": 153,
          "start": 456.436,
          "end": 458.93,
          "en": "That is how Vue works.",
          "zh": ""
        },
        {
          "id": 154,
          "start": 458.93,
          "end": 462.02,
          "en": "And of course, it has a way more complex way",
