      "sourceHash": "e7ddeb71d215b1392f7e3f62b95ed83ba4861d0f947cf1b0f69d6f8b39475e5e",
      "cues": [
        {
          "id": 1,
          "start": 2.14,
          "end": 3.91,
          "en": "Now, this was a long module",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.91,
          "end": 7.06,
          "en": "and this course's project is pretty much done,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.06,
          "end": 11.32,
          "en": "but there's one final tweak I wanna do or implement.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.32,
          "end": 14.45,
          "en": "At the moment in this app, we don't really need Vue X.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 14.45,
          "end": 16.04,
          "en": "Whenever we visit a page,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.04,
          "end": 18.573,
          "en": "we load all the data we need anyways.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 19.49,
          "end": 22.57,
          "en": "And especially here on the coaches page,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.57,
          "end": 24.28,
          "en": "I'm not sure about that.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 24.28,
          "end": 27.66,
          "en": "It's not likely that new coaches will be signing up",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.66,
          "end": 29.36,
          "en": "all the time and we therefore",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.36,
          "end": 31.46,
          "en": "always need to load the latest data,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 31.46,
          "end": 34.01,
          "en": "whenever we go back to this page.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 34.01,
          "end": 37.07,
          "en": "We could in stat cache data locally",
          "zh": ""
        },
        {
          "id": 14,
          "start": 37.07,
          "end": 41.62,
          "en": "and only refresh it after let's say a minute or so,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 41.62,
          "end": 44.63,
          "en": "or once we manually clicked the refresh button",
          "zh": ""
        },
        {
          "id": 16,
          "start": 45.72,
          "end": 48.76,
          "en": "and that's something we can easily implement with Vue X.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 48.76,
          "end": 52.21,
          "en": "And then again, all the shows us why we might need",
          "zh": ""
        },
        {
          "id": 18,
          "start": 52.21,
          "end": 54.22,
          "en": "locally managed state,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 54.22,
          "end": 55.79,
          "en": "which we do with Vue X",
          "zh": ""
        },
        {
          "id": 20,
          "start": 55.79,
          "end": 59.15,
          "en": "side by side with service side managed data.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 59.15,
          "end": 63.07,
          "en": "Because currently we almost replaced Vue X with Firebase",
          "zh": ""
        },
        {
          "id": 22,
          "start": 63.07,
          "end": 65.34,
          "en": "and that's not the idea.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 65.34,
          "end": 67.3,
          "en": "So what could we do here to not fetch",
          "zh": ""
        },
        {
          "id": 24,
          "start": 67.3,
          "end": 69.28,
          "en": "new coach data all the time.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 69.28,
          "end": 71.68299999999999,
          "en": "And instead reuse the existing data.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 72.6,
          "end": 75.6,
          "en": "In our coaches module in the state,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 75.6,
          "end": 77.76,
          "en": "besides managing the coaches,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 77.76,
          "end": 82.76,
          "en": "we could add a last fetch key, which initially is null.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 83.81,
          "end": 87.1,
          "en": "Now last fetch should hold a timestamp.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 87.1,
          "end": 89.01,
          "en": "It should save a timestamp.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 89.01,
          "end": 91.763,
          "en": "Whenever we fetched new data.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 92.64,
          "end": 94.993,
          "en": "For that, we can add a new mutation,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 96.00999999999999,
          "end": 101.00999999999999,
          "en": "which we name set Fetch Timestamp, for example,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 101.35,
          "end": 103.14,
          "en": "where I get access to my state.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 103.14,
          "end": 105.31,
          "en": "And where I then say, state last Fetch,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 105.31,
          "end": 108.27000000000001,
          "en": "which is this new data property we just added",
          "zh": ""
        },
        {
          "id": 37,
          "start": 108.27000000000001,
          "end": 111.5,
          "en": "equal to new Date.get Time.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 111.5,
          "end": 115.03,
          "en": "And this gives us the current time and date",
          "zh": ""
        },
        {
          "id": 39,
          "start": 115.03,
          "end": 117.41,
          "en": "as a timestamp, as a big number,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 117.41,
          "end": 120.15,
          "en": "basically the time in milliseconds",
          "zh": ""
        },
        {
          "id": 41,
          "start": 120.15,
          "end": 121.89,
          "en": "since the beginning of time,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 121.89,
          "end": 125.293,
          "en": "which in JavaScript is at the beginning of 1970.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 126.27,
          "end": 128.82,
          "en": "So now we store this time snapshot",
          "zh": ""
        },
        {
          "id": 44,
          "start": 128.82,
          "end": 131.093,
          "en": "this timestamp in last fetch.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 132,
          "end": 136.13,
          "en": "Now we can commit this action whenever we fetched data.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 136.13,
          "end": 138.41,
          "en": "So in our actions,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 138.41,
          "end": 140.13,
          "en": "here in load coaches,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 140.13,
          "end": 142.24,
          "en": "that's where we fetched data.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 142.24,
          "end": 146.45,
          "en": "There at the end, we can commit more than one mutation",
          "zh": ""
        },
        {
          "id": 50,
          "start": 146.45,
          "end": 148.63,
          "en": "and we can also commit",
          "zh": ""
        },
        {
          "id": 51,
          "start": 148.63,
          "end": 152.46,
          "en": "our new mutation set, fetch, timestamp,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 152.46,
          "end": 153.643,
          "en": "which we just added.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 155.03,
          "end": 158.17000000000002,
          "en": "And we don't need to provide any payload here",
          "zh": ""
        },
        {
          "id": 54,
          "start": 158.17000000000002,
          "end": 161.92000000000002,
          "en": "because set, fetch, timestamp doesn't need any.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 161.92000000000002,
          "end": 163.93,
          "en": "So now we store that timestamp",
          "zh": ""
        },
        {
          "id": 56,
          "start": 163.93,
          "end": 165.89,
          "en": "when we lost fetched the data.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 165.89,
          "end": 167.57,
          "en": "Why am I doing that?",
          "zh": ""
        },
        {
          "id": 58,
          "start": 167.57,
          "end": 171.14,
          "en": "Because now we can add a Getter to this coaches module,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 171.14,
          "end": 174.313,
          "en": "which we may be name, should Update.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 176.11,
          "end": 180.72,
          "en": "And here I in the end, want to get my last fetch timestamp",
          "zh": ""
        },
        {
          "id": 61,
          "start": 180.72,
          "end": 184.023,
          "en": "and find out if it is, let's say less than a minute ago.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 185.5,
          "end": 186.8,
          "en": "So here we get our state",
          "zh": ""
        },
        {
          "id": 63,
          "start": 188.03,
          "end": 189.948,
          "en": "and then we get last fetched by accessing",
          "zh": ""
        },
        {
          "id": 64,
          "start": 189.948,
          "end": 191.013,
          "en": "state.lastFetch.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 192.56,
          "end": 196.73,
          "en": "And we, first of all, check if last fetch is faulty.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 196.73,
          "end": 198.92000000000002,
          "en": "For example, at the beginning, it's null.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 198.92000000000002,
          "end": 200.65,
          "en": "If that's the case I return true",
          "zh": ""
        },
        {
          "id": 68,
          "start": 200.65,
          "end": 202.37,
          "en": "because then we should update.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 202.37,
          "end": 205.213,
          "en": "If we have no timestamp yet we should update.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 206.64,
          "end": 209.04,
          "en": "Else, if we do have a time stamp,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 209.04,
          "end": 211.69,
          "en": "I need to find out if it's more than a minute ago,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 211.69,
          "end": 214.19,
          "en": "so we can get a current timestamp now",
          "zh": ""
        },
        {
          "id": 73,
          "start": 215.23,
          "end": 218.44,
          "en": "by getting you date get time.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 218.44,
          "end": 221.163,
          "en": "So that's the timestamp when we use the Getter.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 222.81,
          "end": 224.76,
          "en": "And now we can return",
          "zh": ""
        },
        {
          "id": 76,
          "start": 224.76,
          "end": 227.23,
          "en": "the result of comparing the current timestamp",
          "zh": ""
        },
        {
          "id": 77,
          "start": 227.23,
          "end": 229.39,
          "en": "with the storage timestamp.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 229.39,
          "end": 234.39,
          "en": "We simply, deduct last fetch from the current timestamp,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 236.39,
          "end": 241.39,
          "en": "divide that by 1000 and check if that's greater than 60.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 242.3,
          "end": 245.04,
          "en": "That means that it's more than a minute ago.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 245.04,
          "end": 248.8,
          "en": "This will return true if it's more than a minute ago.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 248.8,
          "end": 252.29,
          "en": "So we then should update again, it returns false,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 252.29,
          "end": 253.97,
          "en": "so we shouldn't update again,",
          "zh": ""
        },
        {
          "id": 84,
          "start": 253.97,
          "end": 255.613,
          "en": "if it's less than a minute ago,",
          "zh": ""
        },
        {
          "id": 85,
          "start": 256.87,
          "end": 258.26,
          "en": "divided by 1000,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 258.26,
          "end": 261.013,
          "en": "because both these numbers are in milliseconds.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 262.16,
          "end": 263.75,
          "en": "So now it should update yields true.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 263.75,
          "end": 267.62,
          "en": "If we should fetch again and false otherwise.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 267.62,
          "end": 270.973,
          "en": "And where exactly do we use should update now?",
          "zh": ""
        },
        {
          "id": 90,
          "start": 272.31,
          "end": 275.36,
          "en": "Well, in the actions of the coaches module.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 275.36,
          "end": 279.32,
          "en": "Here in load coaches, before we send the request,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 279.32,
          "end": 282.83,
          "en": "I wanna check if we actually should fetch coaches.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 282.83,
          "end": 285.44,
          "en": "So we can check if context,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 285.44,
          "end": 286.373,
          "en": "Getters,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 288,
          "end": 289.42,
          "en": "should update",
          "zh": ""
        },
        {
          "id": 96,
          "start": 289.42,
          "end": 291.78,
          "en": "is true or to be precise,",
          "zh": ""
        },
        {
          "id": 97,
          "start": 291.78,
          "end": 293.343,
          "en": "if it's not true.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 294.2,
          "end": 297.03,
          "en": "If it's not true, I will just return here.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 297.03,
          "end": 299.34000000000003,
          "en": "I will not continue with the rest of the code",
          "zh": ""
        },
        {
          "id": 100,
          "start": 299.34000000000003,
          "end": 301.95,
          "en": "and therefore, we will not send the request.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 301.95,
          "end": 303.79,
          "en": "Instead, we'll stick to the data",
          "zh": ""
        },
        {
          "id": 102,
          "start": 303.79,
          "end": 306.68,
          "en": "which we currently have in our store.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 306.68,
          "end": 308.483,
          "en": "So we'll not fetch again then.",
          "zh": ""
        },
        {
          "id": 104,
          "start": 309.35,
          "end": 311.35,
          "en": "If should update is true.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 311.35,
          "end": 313.35,
          "en": "This if statement will be skipped",
          "zh": ""
        },
        {
          "id": 106,
          "start": 313.35,
          "end": 315.283,
          "en": "and we will fetch data again.",
          "zh": ""
        },
        {
          "id": 107,
          "start": 316.91,
          "end": 319.79,
          "en": "By doing that, if I saved it, if I reload,",
          "zh": ""
        },
        {
          "id": 108,
          "start": 319.79,
          "end": 323.3,
          "en": "we fetch data, but if I then go to requests and come back,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 323.3,
          "end": 327.5,
          "en": "you see no loading spinner, because now we don't load again.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 327.5,
          "end": 329.9,
          "en": "And after a minute you would see it again.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 329.9,
          "end": 331.21,
          "en": "Then it would fetch it again",
          "zh": ""
        },
        {
          "id": 112,
          "start": 331.21,
          "end": 332.923,
          "en": "and store it for another minute.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 334.33,
          "end": 337.26,
          "en": "But refreshing with the refresh button should work.",
          "zh": ""
        },
        {
          "id": 114,
          "start": 337.26,
          "end": 339.63,
          "en": "We should always be able to do that.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 339.63,
          "end": 341.59000000000003,
          "en": "So in order to implement that,",
          "zh": ""
        },
        {
          "id": 116,
          "start": 341.59000000000003,
          "end": 344.57,
          "en": "I will actually change this action a little bit",
          "zh": ""
        },
        {
          "id": 117,
          "start": 344.57,
          "end": 347.37,
          "en": "and expect a payload,",
          "zh": ""
        },
        {
          "id": 118,
          "start": 347.37,
          "end": 349.43,
          "en": "which holds a property that tells me",
          "zh": ""
        },
        {
          "id": 119,
          "start": 349.43,
          "end": 352.03,
          "en": "that I absolutely do have to fetch again.",
          "zh": ""
        },
        {
          "id": 120,
          "start": 352.03,
          "end": 355.32,
          "en": "So which overrides the scatter basically.",
          "zh": ""
        },
        {
          "id": 121,
          "start": 355.32,
          "end": 358.71,
          "en": "Here, we can simply add an additional check in this",
          "zh": ""
        },
        {
          "id": 122,
          "start": 358.71,
          "end": 361.07,
          "en": "if condition here, and check if",
          "zh": ""
        },
        {
          "id": 123,
          "start": 361.07,
          "end": 366.07,
          "en": "payload let's say has a false refresh property,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 367.46,
          "end": 369.26,
          "en": "and if it doesn't have that,",
          "zh": ""
        },
        {
          "id": 125,
          "start": 369.26,
          "end": 373.18,
          "en": "if that's false and we should not update,",
          "zh": ""
        },
        {
          "id": 126,
          "start": 373.18,
          "end": 375.08,
          "en": "then we skip this.",
          "zh": ""
        },
        {
          "id": 127,
          "start": 375.08,
          "end": 379.31,
          "en": "Otherwise, if either does is true or this true,",
          "zh": ""
        },
        {
          "id": 128,
          "start": 379.31,
          "end": 382.343,
          "en": "this if check will be skipped and we will fetch again.",
          "zh": ""
        },
        {
          "id": 129,
          "start": 383.66,
          "end": 388.37,
          "en": "So now we will be able to set a false refresh payload",
          "zh": ""
        },
        {
          "id": 130,
          "start": 388.37,
          "end": 389.42,
          "en": "to this action.",
          "zh": ""
        },
        {
          "id": 131,
          "start": 389.42,
          "end": 392.27,
          "en": "And if it's true, we will fetch again,",
          "zh": ""
        },
        {
          "id": 132,
          "start": 392.27,
          "end": 395.04,
          "en": "no matter if it's more or less than a minute ago,",
          "zh": ""
        },
        {
          "id": 133,
          "start": 395.04,
          "end": 396.283,
          "en": "since we last did it.",
          "zh": ""
        },
        {
          "id": 134,
          "start": 397.97,
          "end": 400.34000000000003,
