      "sourceHash": "2a36402067a02a8ac8d9fc6bb6cd1ec02d5e281d57b6fae74aee3c88623cd418",
      "cues": [
        {
          "id": 1,
          "start": 2.18,
          "end": 4.53,
          "en": "So let's add a default button,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.53,
          "end": 8.23,
          "en": "which we can use, and that will be another base component.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 8.23,
          "end": 10.43,
          "en": "So I will add it to the UI folder.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.43,
          "end": 13.683,
          "en": "And I'll name the file name BaseButton.vue.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 14.71,
          "end": 16.89,
          "en": "Now in there, of course we'll have a template",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.89,
          "end": 19.28,
          "en": "and there I'll have my button element,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 19.28,
          "end": 21.14,
          "en": "the default button element,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 21.14,
          "end": 23.94,
          "en": "but now it's all about having some default styling",
          "zh": ""
        },
        {
          "id": 9,
          "start": 23.94,
          "end": 25.45,
          "en": "for the button.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 25.45,
          "end": 29.44,
          "en": "So for that I'll add my style tag here",
          "zh": ""
        },
        {
          "id": 11,
          "start": 30.3,
          "end": 32.4,
          "en": "and of course scope it.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.4,
          "end": 35.47,
          "en": "And I'm providing some default styling you can take",
          "zh": ""
        },
        {
          "id": 13,
          "start": 35.47,
          "end": 39.12,
          "en": "attached to this lecture in the buttoned dot CSS file.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 39.12,
          "end": 42.01,
          "en": "I'm fully aware that this is probably not the styling",
          "zh": ""
        },
        {
          "id": 15,
          "start": 42.01,
          "end": 45.33,
          "en": "you came up with, but you can now use it.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 45.33,
          "end": 47.917,
          "en": "This sets up a general button style,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 47.917,
          "end": 50.84,
          "en": "also when it's hovered or active.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 50.84,
          "end": 52.84,
          "en": "But then I also have a CSS class,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 52.84,
          "end": 55.67,
          "en": "which we can add conditionally to give it",
          "zh": ""
        },
        {
          "id": 20,
          "start": 55.67,
          "end": 59.08,
          "en": "an alternative look so that we can actually have",
          "zh": ""
        },
        {
          "id": 21,
          "start": 59.08,
          "end": 61.058,
          "en": "one base button component,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 61.058,
          "end": 64.44,
          "en": "which can be configured to look differently",
          "zh": ""
        },
        {
          "id": 23,
          "start": 64.44,
          "end": 68.17,
          "en": "and it should be configurable with props.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 68.17,
          "end": 71.13,
          "en": "So for that I'll also add a script tag here",
          "zh": ""
        },
        {
          "id": 25,
          "start": 71.13,
          "end": 73.09,
          "en": "and add the props option.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 73.09,
          "end": 77.02,
          "en": "And the props I wanna accept here is let's say the type prop",
          "zh": ""
        },
        {
          "id": 27,
          "start": 77.02,
          "end": 79.7,
          "en": "so that we can set the type of the button",
          "zh": ""
        },
        {
          "id": 28,
          "start": 79.7,
          "end": 83.618,
          "en": "and bind the default type attribute to this type prop,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 83.618,
          "end": 86.57,
          "en": "but I'll always accept the mode prop,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 86.57,
          "end": 90.28999999999999,
          "en": "which I want to set as a CSS class here,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 90.28999999999999,
          "end": 94.763,
          "en": "so I'll bind to class attribute to this mode prop value.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 96.22999999999999,
          "end": 101.22999999999999,
          "en": "And my idea is that you can then use this base-button",
          "zh": ""
        },
        {
          "id": 33,
          "start": 102.22,
          "end": 107.22,
          "en": "with the mode of flat later, in another component of course.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 107.28,
          "end": 111.1,
          "en": "And if you do so, this flat text here",
          "zh": ""
        },
        {
          "id": 35,
          "start": 111.1,
          "end": 113.43,
          "en": "will be added as a CSS class.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 113.43,
          "end": 116.55,
          "en": "And we do have a selector for this class",
          "zh": ""
        },
        {
          "id": 37,
          "start": 116.55,
          "end": 119.063,
          "en": "giving this button an alternative look.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 120.37,
          "end": 122.65,
          "en": "And of course we could add more classes",
          "zh": ""
        },
        {
          "id": 39,
          "start": 122.65,
          "end": 125.163,
          "en": "to support more alternative looks.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 126.34,
          "end": 129.75,
          "en": "Now that's almost it, but one important thing is missing.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 129.75,
          "end": 132.59,
          "en": "And that's another slot because of course",
          "zh": ""
        },
        {
          "id": 42,
          "start": 132.59,
          "end": 136.24,
          "en": "the content inside of the button, the text for example,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 136.24,
          "end": 138.853,
          "en": "should be passed in from outside.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 140.09,
          "end": 143.23,
          "en": "We could also accept another prop for that, for example,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 143.23,
          "end": 146.698,
          "en": "a captioned prop and use that.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 146.698,
          "end": 149.95,
          "en": "But by using a slot, we give the user,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 149.95,
          "end": 153.81,
          "en": "the developer using our button a bit more flexibility",
          "zh": ""
        },
        {
          "id": 48,
          "start": 153.81,
          "end": 156.59,
          "en": "because now you can not just feed in text,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 156.59,
          "end": 159.46,
          "en": "but you could also pass in an icon,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 159.46,
          "end": 162.673,
          "en": "a SVG icon or any markup of your choice.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 164.07999999999998,
          "end": 167.42000000000002,
          "en": "Now that's the base button, just like the base card,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 167.42000000000002,
          "end": 170.65,
          "en": "I'm going to register it globally so that we can use it",
          "zh": ""
        },
        {
          "id": 53,
          "start": 170.65,
          "end": 173.16,
          "en": "anywhere in this application.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 173.16,
          "end": 176.144,
          "en": "So in main JS, I'm importing it from components,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 176.144,
          "end": 178.473,
          "en": "UI BaseButton.vue.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 179.78,
          "end": 183.42,
          "en": "And I will register it with the component method here",
          "zh": ""
        },
        {
          "id": 57,
          "start": 183.42,
          "end": 186.75,
          "en": "based dash button points at this imported",
          "zh": ""
        },
        {
          "id": 58,
          "start": 186.75,
          "end": 188.503,
          "en": "base-button, like this.",
          "zh": ""
        },
        {
          "id": 59,
