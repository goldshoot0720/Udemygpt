        },
        {
          "id": 10,
          "start": 21.033,
          "end": 23.633,
          "en": "so that we can still see it and compare it.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 23.633,
          "end": 26.033,
          "en": "Because now I wanna use Vue.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 26.033,
          "end": 28.533,
          "en": "For that we first of all need to add Vue.",
