        },
        {
          "id": 52,
          "start": 138.13,
          "end": 139.653,
          "en": "other components in the end.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 141.41,
          "end": 143.7,
          "en": "Well and then, I'm going to start by adding a",
          "zh": ""
        },
        {
          "id": 54,
          "start": 143.7,
          "end": 147.612,
          "en": "template here in App.vue and in that template",
          "zh": ""
        },
        {
          "id": 55,
          "start": 147.612,
          "end": 152.612,
          "en": "here, I want to start by out putting a list of",
