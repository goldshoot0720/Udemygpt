        },
        {
          "id": 27,
          "start": 73.69,
          "end": 75.51,
          "en": "in this module here.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 75.51,
          "end": 77.21000000000001,
          "en": "Now how do we get started",
          "zh": ""
        },
        {
          "id": 29,
          "start": 77.21000000000001,
          "end": 79.4,
          "en": "with this kind of project?",
          "zh": ""
        },
        {
          "id": 30,
