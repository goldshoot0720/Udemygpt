          "zh": ""
        },
        {
          "id": 31,
          "start": 82.59,
          "end": 85.95,
          "en": "project we built earlier in this course.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 85.95,
          "end": 89.76,
          "en": "And there I also just get started step by step",
          "zh": ""
        },
        {
          "id": 33,
          "start": 89.76,
          "end": 92.44,
          "en": "by adding feature after feature.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 92.44,
          "end": 94.14,
          "en": "I wanna do the same thing here",
          "zh": ""
        },
        {
          "id": 35,
          "start": 94.14,
          "end": 96.37,
          "en": "and we can always split our code",
          "zh": ""
        },
        {
          "id": 36,
          "start": 96.37,
          "end": 100.44,
          "en": "into more components when we get a feeling that",
          "zh": ""
        },
        {
          "id": 37,
          "start": 100.44,
          "end": 102.75999999999999,
          "en": "a component is getting too big and we might wanna",
