          "zh": ""
        },
        {
          "id": 21,
          "start": 57.29,
          "end": 60.53,
          "en": "output some information or the job could be to",
          "zh": ""
        },
        {
          "id": 22,
          "start": 60.53,
          "end": 63.81,
          "en": "fetch some user input, show a warning if that",
          "zh": ""
        },
        {
          "id": 23,
          "start": 63.81,
