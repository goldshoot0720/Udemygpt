        },
        {
          "id": 51,
          "start": 152.98,
          "end": 154.25,
          "en": "as we learned it.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 154.25,
          "end": 156.59,
          "en": "And in there have my friends, right?",
          "zh": ""
        },
        {
          "id": 53,
          "start": 156.59,
          "end": 157.95,
          "en": "Because that is what we had",
