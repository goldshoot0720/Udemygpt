        },
        {
          "id": 54,
          "start": 157.95,
          "end": 160.57,
          "en": "in the component intro module as well.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 160.57,
          "end": 163.26,
          "en": "And there we had two friend elements",
