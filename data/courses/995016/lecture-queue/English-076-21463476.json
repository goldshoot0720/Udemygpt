          "zh": ""
        },
        {
          "id": 24,
          "start": 69.53,
          "end": 72.84,
          "en": "and create a script tag, opening and closing.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 72.84,
          "end": 75.03999999999999,
          "en": "We don't need a style tag for the moment.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 75.03999999999999,
          "end": 76.493,
          "en": "We'll add it later.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 77.82,
          "end": 79.68,
          "en": "Now I will emphasize, again,",
