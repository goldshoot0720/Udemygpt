        },
        {
          "id": 62,
          "start": 187.5,
          "end": 190.49,
          "en": "a fictional email address.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 190.49,
          "end": 195.04,
          "en": "And then we can duplicate this to also have a second friend.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 195.04,
          "end": 197.43,
          "en": "And I used Julie before.",
