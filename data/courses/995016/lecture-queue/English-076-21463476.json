        },
        {
          "id": 19,
          "start": 55.67,
          "end": 57.36,
          "en": "you are going to build.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 57.36,
          "end": 59.46,
          "en": "So App.vue it is.",
          "zh": ""
        },
        {
          "id": 21,
