          "id": 47,
          "start": 143.85,
          "end": 146.68,
          "en": "Now for the moment, I don't need methods and computed,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 146.68,
          "end": 147.93,
          "en": "but here in my main app,",
