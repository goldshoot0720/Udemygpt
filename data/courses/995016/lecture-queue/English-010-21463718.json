        },
        {
          "id": 16,
          "start": 39.25,
          "end": 42.06,
          "en": "to catch up with me to code along,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 42.06,
          "end": 44.543,
          "en": "or as I just said, also code ahead.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 45.52,
          "end": 47.91,
