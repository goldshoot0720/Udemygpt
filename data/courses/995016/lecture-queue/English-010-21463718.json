      "cues": [
        {
          "id": 1,
          "start": 2.14,
          "end": 3.7,
          "en": "Now, since it is a huge course,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.7,
          "end": 6.87,
          "en": "I want to ensure that you get the most out of this course.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.87,
          "end": 10.06,
          "en": "And for that, I've got a couple of tips and tricks.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.06,
          "end": 12.89,
          "en": "Obviously I recommend that you watch the videos.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.89,
          "end": 15.89,
          "en": "It's a video-on-demand course, after all.",
