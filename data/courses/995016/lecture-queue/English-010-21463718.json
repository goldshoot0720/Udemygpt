        },
        {
          "id": 11,
          "start": 27.66,
          "end": 29.38,
          "en": "Try things on your own,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 29.38,
          "end": 33.08,
          "en": "and maybe pause the video and try writing the code,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 33.08,
          "end": 36.07,
          "en": "for what we're about to add on your own.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 36.07,
