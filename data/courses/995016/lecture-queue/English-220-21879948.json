        },
        {
          "id": 55,
          "start": 176.1,
          "end": 180.02,
          "en": "Here with an IF statement I'll check if the value is empty,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 180.02,
          "end": 182.25,
          "en": "keep in mind we're trimming it already,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 182.25,
          "end": 183.98,
          "en": "so therefore excess white space",
