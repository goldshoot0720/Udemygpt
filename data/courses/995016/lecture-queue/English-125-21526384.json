{
  "version": 1,
  "courseId": 995016,
  "courseSlug": "vuejs-2-the-complete-guide",
  "courseTitle": "Vue - The Complete Guide (incl. Router & Composition API)",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "21526384",
      "title": "Working with v-model Modifiers and Numbers",
      "lectureOrder": 144,
      "videoOrder": 125,
      "sourceHash": "86df484364efc01200928942c9bd6c5541025ad7069ad84f6b1055bda11d55b9",
      "cues": [
        {
          "id": 1,
          "start": 2.15,
          "end": 4.48,
          "en": "Let's continue with the age.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.48,
          "end": 7.673,
          "en": "The age input here is actually of type number.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 8.6,
          "end": 10.42,
          "en": "Now this can be confusing,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.42,
          "end": 13.63,
          "en": "just because it's of type number does not mean",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.63,
          "end": 14.9,
          "en": "what you entered here",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.9,
          "end": 18.3,
          "en": "will be treated as type number in code.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.3,
          "end": 20.02,
          "en": "It looks like a number",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.02,
          "end": 23.67,
          "en": "and you won't be able to enter anything but numbers here,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 23.67,
          "end": 26.17,
          "en": "but you will not automatically,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 26.17,
          "end": 29.44,
          "en": "get a value of type number in code.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.44,
          "end": 32.32,
          "en": "Sounds confusing, let me show you what I mean.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.32,
          "end": 36.213,
          "en": "Let's add a new data property userAge, maybe.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 37.07,
          "end": 39.41,
          "en": "Let's set this to an empty string as well,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 39.41,
          "end": 41.86,
          "en": "or maybe to a number, or maybe to null.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 41.86,
          "end": 45.85,
          "en": "Let's maybe use null because I don't wanna use zero.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 45.85,
          "end": 47.73,
          "en": "I also don't wanna use an empty string",
          "zh": ""
        },
        {
          "id": 17,
          "start": 47.73,
          "end": 49.32,
          "en": "because it should be a number.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 49.32,
          "end": 51.17,
          "en": "So I will use null to make it clear",
          "zh": ""
        },
        {
          "id": 19,
          "start": 51.17,
          "end": 53.633,
          "en": "that we have no value yet for this.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 55.58,
          "end": 60.58,
          "en": "Now let's bind userAge to this input here, to this input.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 62.1,
          "end": 65.56,
          "en": "We can do this with v-model that works on this input",
          "zh": ""
        },
        {
          "id": 22,
          "start": 65.56,
          "end": 67.57,
          "en": "just as it did on the first one",
          "zh": ""
        },
        {
          "id": 23,
          "start": 68.43,
          "end": 70.963,
          "en": "and here I can point at userAge now.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 72.56,
          "end": 77.56,
          "en": "Now with that, let's go down here, whoops, to the method",
          "zh": ""
        },
        {
          "id": 25,
          "start": 77.73,
          "end": 80.3,
          "en": "and I will console log userAge,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 81.95,
          "end": 85.71000000000001,
          "en": "and I will deliberately use two console logs now",
          "zh": ""
        },
        {
          "id": 27,
          "start": 85.71000000000001,
          "end": 89,
          "en": "so that I don't concatenate the user age with a string",
          "zh": ""
        },
        {
          "id": 28,
          "start": 89,
          "end": 93.363,
          "en": "to a longer string, but so that I keep the type of user age.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 95.53999999999999,
          "end": 99.52000000000001,
          "en": "Below that I will log a random number, in this case 31",
          "zh": ""
        },
        {
          "id": 30,
          "start": 100.95,
          "end": 103.96000000000001,
          "en": "and you'll see why I'm doing this in a second.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 103.96000000000001,
          "end": 107.5,
          "en": "I can then also of course, reset it back to null thereafter",
          "zh": ""
        },
        {
          "id": 32,
          "start": 107.5,
          "end": 109.693,
          "en": "to also reset it in the input fields.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 111.87,
          "end": 114.82,
          "en": "With all of that, if we go back,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 114.82,
          "end": 117.06,
          "en": "I can, of course still enter max here,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 117.06,
          "end": 121.84,
          "en": "but I can also enter 31, or 32, or whatever you want here.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 121.84,
          "end": 125.59,
          "en": "If I click save data, you see it was submitted",
          "zh": ""
        },
        {
          "id": 37,
          "start": 126.82,
          "end": 131.143,
          "en": "and you will see that 32 looks just like 31.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 133.58,
          "end": 135.95,
          "en": "So what's the special thing here.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 135.95,
          "end": 138,
          "en": "Well, watch what happens",
          "zh": ""
        },
        {
          "id": 40,
          "start": 138,
          "end": 141.44,
          "en": "if I retrieved the value not with v-model",
          "zh": ""
        },
        {
          "id": 41,
          "start": 141.44,
          "end": 145.543,
          "en": "or not only with v-model, but if I also add a ref here,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 146.682,
          "end": 149.023,
          "en": "ageInput could be the ref identifier.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 150.32,
          "end": 153.98,
          "en": "And with that ref added, let me go back here",
          "zh": ""
        },
        {
          "id": 44,
          "start": 153.98,
          "end": 156.88,
          "en": "and I will then console log the value",
          "zh": ""
        },
        {
          "id": 45,
          "start": 156.88,
          "end": 161.623,
          "en": "of this ref's ageInput.value.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 163.07,
          "end": 165.96,
          "en": "So I am accessing the native dom element",
          "zh": ""
        },
        {
          "id": 47,
          "start": 165.96,
          "end": 168.66,
          "en": "and I'm then getting access to the value property,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 168.66,
          "end": 170.113,
          "en": "and I'm outputting this here.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 171.17000000000002,
          "end": 175.23,
          "en": "If I do this and I enter 32 here,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 175.23,
          "end": 176.88,
          "en": "you'll see something interesting.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 177.76,
          "end": 182.62,
          "en": "This 32 is our internally managed data property,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 182.62,
          "end": 184.503,
          "en": "which is bound with v-model.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 185.46,
          "end": 189.773,
          "en": "This 31 is the dummy number I'm outputting here.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 190.74,
          "end": 194.337,
          "en": "The value, which I'm outputting with refs here is this 32",
          "zh": ""
        },
        {
          "id": 55,
          "start": 194.337,
          "end": 196.05,
          "en": "and the interesting thing is that",
          "zh": ""
        },
        {
          "id": 56,
          "start": 196.05,
          "end": 198.74,
          "en": "this is black and this is blue.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 198.74,
          "end": 201.43,
          "en": "Blue means it's of type number,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 201.43,
          "end": 204.62,
          "en": "black means it's of type string.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 204.62,
          "end": 206.81,
          "en": "So it's a different data type.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 206.81,
          "end": 208.43,
          "en": "Why does this matter?",
          "zh": ""
        },
        {
          "id": 61,
          "start": 208.43,
          "end": 210.68,
          "en": "Well, let's say you continue working",
          "zh": ""
        },
        {
          "id": 62,
          "start": 210.68,
          "end": 212.25,
          "en": "with that number you fetched.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 212.25,
          "end": 216.29,
          "en": "Maybe you add five, let me do this in both cases.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 216.29,
          "end": 218.77,
          "en": "For the property we're managing in our data",
          "zh": ""
        },
        {
          "id": 65,
          "start": 218.77,
          "end": 221.28300000000002,
          "en": "and for the property we're getting with refs.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 222.86,
          "end": 226.45,
          "en": "If I am doing that and I enter 32, again,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 226.45,
          "end": 229.44,
          "en": "we get 37 for the data property",
          "zh": ""
        },
        {
          "id": 68,
          "start": 229.44,
          "end": 233.373,
          "en": "but 325 for the ref property,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 234.53,
          "end": 236.46,
          "en": "and that's not a mathematical error.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 236.46,
          "end": 238.95,
          "en": "This is simply a concatenated string,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 238.95,
          "end": 242.433,
          "en": "32 and five combined to one string.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 243.69,
          "end": 247,
          "en": "So the interesting thing of what you should be aware here",
          "zh": ""
        },
        {
          "id": 73,
          "start": 247,
          "end": 248.8,
          "en": "is that v-model,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 248.8,
          "end": 252.11,
          "en": "if used on an input of type number",
          "zh": ""
        },
        {
          "id": 75,
          "start": 252.11,
          "end": 254.66,
          "en": "automatically fetches the user input",
          "zh": ""
        },
        {
          "id": 76,
          "start": 254.66,
          "end": 258.123,
          "en": "and converts it from a string to a number of data type.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 259.54,
          "end": 263.25,
          "en": "By default, if you would be using just JavaScript",
          "zh": ""
        },
        {
          "id": 78,
          "start": 263.25,
          "end": 265.25,
          "en": "or if you're using refs and therefore",
          "zh": ""
        },
        {
          "id": 79,
          "start": 265.25,
          "end": 268.88,
          "en": "the native JavaScript object representing this input.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 268.88,
          "end": 273.493,
          "en": "By default, what's stored in the value is always a string.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 274.85,
          "end": 279.85,
          "en": "It's an extra feature added by Vue and v-model that it sees",
          "zh": ""
        },
        {
          "id": 82,
          "start": 280.3,
          "end": 282.93,
          "en": "that this input is of type number",
          "zh": ""
        },
        {
          "id": 83,
          "start": 282.93,
          "end": 286.6,
          "en": "and that it therefore converts this string value",
          "zh": ""
        },
        {
          "id": 84,
          "start": 286.6,
          "end": 288.423,
          "en": "to a number of value for you.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 289.89,
          "end": 292.31,
          "en": "You can also force it to do that.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 292.31,
          "end": 295.35,
          "en": "For example, if you use another type here,",
          "zh": ""
        },
        {
          "id": 87,
          "start": 295.35,
          "end": 297.94,
          "en": "you can force Vue to do that conversion",
          "zh": ""
        },
        {
          "id": 88,
          "start": 297.94,
          "end": 300.75,
          "en": "by adding a modifier after v-model here,",
          "zh": ""
        },
        {
          "id": 89,
          "start": 300.75,
          "end": 303.03,
          "en": "the number modifier.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 303.03,
          "end": 305.13,
          "en": "This forces this conversion,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 305.13,
          "end": 307.69,
          "en": "which v-model does automatically here",
          "zh": ""
        },
        {
          "id": 92,
          "start": 307.69,
          "end": 309.283,
          "en": "in case of type number.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 311.41,
          "end": 314.44,
          "en": "Speaking off these modifiers, you might've seen it already,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 314.44,
          "end": 317.57,
          "en": "there are a couple of other modifiers as well.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 317.57,
          "end": 320.68,
          "en": "The lazy modifier allows you to change",
          "zh": ""
        },
        {
          "id": 96,
          "start": 320.68,
          "end": 323.71,
          "en": "how Vue updates the bound property.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 323.71,
          "end": 326.5,
          "en": "If it does this on every keystroke",
          "zh": ""
        },
        {
          "id": 98,
          "start": 326.5,
          "end": 331.5,
          "en": "or if for some inputs, it does this at a lower frequency.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 331.56,
          "end": 334.3,
          "en": "Trim allows you to tell Vue",
          "zh": ""
        },
        {
          "id": 100,
          "start": 334.3,
          "end": 337.02,
          "en": "that it should remove excess white space",
          "zh": ""
        },
        {
          "id": 101,
          "start": 337.02,
          "end": 340.763,
          "en": "at the beginning and end of the text that was entered.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 341.81,
          "end": 345.15,
          "en": "It's the equivalent to manually doing that",
          "zh": ""
        },
        {
          "id": 103,
          "start": 345.15,
          "end": 349.253,
          "en": "with the trim method on this string here.",
          "zh": ""
        },
        {
          "id": 104,
          "start": 350.43,
          "end": 354.56,
          "en": "So with trim added you ensure that you always get an input",
          "zh": ""
        },
        {
          "id": 105,
          "start": 354.56,
          "end": 357.71,
          "en": "with no leading or trailing white space at the end,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 357.71,
          "end": 360.46,
          "en": "which of course is also something that could be useful.",
          "zh": ""
        },
        {
          "id": 107,
          "start": 361.75,
          "end": 363.97,
          "en": "That was a lot of talking about v-model",
          "zh": ""
        },
        {
          "id": 108,
          "start": 363.97,
          "end": 366.42,
          "en": "and it's modifiers and numbers,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 366.42,
          "end": 368.63,
          "en": "but this can be a common bug,",
          "zh": ""
        },
        {
          "id": 110,
          "start": 368.63,
          "end": 370.75,
          "en": "which you add to an application.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 370.75,
          "end": 372.36,
          "en": "That you will think you've got a number",
          "zh": ""
        },
        {
          "id": 112,
          "start": 372.36,
          "end": 375.13,
          "en": "and actually you're working with a string.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 375.13,
          "end": 376.27,
          "en": "It's especially important",
          "zh": ""
        },
        {
          "id": 114,
          "start": 376.27,
          "end": 380.64,
          "en": "to be aware of this special behavior v-model offers to us",
          "zh": ""
        },
        {
          "id": 115,
          "start": 380.64,
          "end": 383.65,
          "en": "because I already mentioned earlier in the course",
          "zh": ""
        },
        {
          "id": 116,
          "start": 383.65,
          "end": 385.69,
          "en": "that you can either use v-model",
          "zh": ""
        },
        {
          "id": 117,
          "start": 385.69,
          "end": 389.06,
          "en": "for getting access to some data or a ref.",
          "zh": ""
        },
        {
          "id": 118,
          "start": 389.06,
          "end": 392.65999999999997,
          "en": "Well, turns out you can but behind the scenes",
          "zh": ""
        },
        {
          "id": 119,
          "start": 392.65999999999997,
          "end": 395.92,
          "en": "these two approaches have different behaviors",
          "zh": ""
        },
        {
          "id": 120,
          "start": 395.92,
          "end": 398.65999999999997,
          "en": "and if you use a ref, which is perfectly fine,",
          "zh": ""
        },
        {
          "id": 121,
          "start": 398.65999999999997,
          "end": 401.40999999999997,
          "en": "you should, for example, be aware of the fact",
          "zh": ""
        },
        {
          "id": 122,
          "start": 401.40999999999997,
          "end": 405.54,
          "en": "that no automatic type conversions take place.",
          "zh": ""
        },
        {
          "id": 123,
          "start": 405.54,
          "end": 407.96,
          "en": "That was enough of the talking about this.",
          "zh": ""
        },
        {
          "id": 124,
          "start": 407.96,
          "end": 410.40999999999997,
          "en": "With that, let's see how we can interact",
          "zh": ""
        },
        {
          "id": 125,
          "start": 410.40999999999997,
          "end": 412.713,
          "en": "with all the other inputs we got on this page.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
