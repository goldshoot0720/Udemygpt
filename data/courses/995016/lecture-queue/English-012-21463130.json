        },
        {
          "id": 93,
          "start": 274.09000000000003,
          "end": 276.033,
          "en": "which we created with createApp.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 277.24,
          "end": 279.78,
          "en": "Mount now wants a string.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 279.78,
          "end": 283.73,
          "en": "And that string should hold a CSS selector,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 283.73,
          "end": 287.44,
          "en": "which uniquely identifies the element",
          "zh": ""
        },
        {
          "id": 97,
          "start": 287.44,
          "end": 291.223,
          "en": "in our DOM in our HTML code, which we wanna control.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 292.1,
          "end": 295.5,
          "en": "Now here, this section has an ID of user goal.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 295.5,
          "end": 296.85,
          "en": "So we can use this ID.",
