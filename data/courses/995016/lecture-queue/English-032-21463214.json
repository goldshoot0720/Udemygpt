          "zh": ""
        },
        {
          "id": 4,
          "start": 11.2,
          "end": 13.87,
          "en": "They overrule all other styles,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.87,
          "end": 15.97,
          "en": "which sometimes is what you'll need,",
