        },
        {
          "id": 44,
          "start": 145.32999999999998,
          "end": 147.55,
          "en": "In this case, again, the App.vue file,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 147.55,
          "end": 152.48,
