          "zh": ""
        },
        {
          "id": 10,
          "start": 31.794,
          "end": 34.44,
          "en": "going to use throughout this course.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 34.44,
          "end": 38.752,
          "en": "Now, you can use any code editor or IDE of your choice.",
