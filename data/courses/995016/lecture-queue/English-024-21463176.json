        },
        {
          "id": 18,
          "start": 54.93,
          "end": 57.68,
          "en": "the starting counter never changes.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 57.68,
          "end": 60.67,
          "en": "And right now of course, since we reference counter,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 60.67,
          "end": 63.203,
          "en": "it will change whenever we change to counter.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 64.18,
          "end": 67.8,
          "en": "If you have such a scenario that you have some data",
          "zh": ""
        },
        {
          "id": 22,
          "start": 67.8,
          "end": 71.93,
          "en": "that changes and you want to preserve the initial state",
          "zh": ""
        },
        {
          "id": 23,
          "start": 71.93,
          "end": 74.35,
          "en": "and not reflect any other changes,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 74.35,
          "end": 77.49,
