        },
        {
          "id": 13,
          "start": 42.18,
          "end": 45.67,
          "en": "And we wanna point at the counter property",
          "zh": ""
        },
        {
          "id": 14,
          "start": 45.67,
          "end": 48.16,
          "en": "we're managing in our Vue instance, so that,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 48.16,
