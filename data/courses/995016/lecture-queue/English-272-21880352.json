        },
        {
          "id": 3,
          "start": 7.43,
          "end": 11.44,
          "en": "we haven't just learned about data and computed properties.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.44,
          "end": 12.4,
          "en": "We've for example,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.4,
          "end": 14.48,
          "en": "also learned about a routing",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.48,
          "end": 17.13,
          "en": "and attached you find a number starting project,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.13,
