          "en": "where they got a very simple application",
          "zh": ""
        },
        {
          "id": 8,
          "start": 19.59,
          "end": 22.157,
          "en": "that uses routing set up for you.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.157,
          "end": 24.47,
          "en": "Now if you load this application,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 24.47,
