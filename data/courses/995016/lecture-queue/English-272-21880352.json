        },
        {
          "id": 91,
          "start": 286.78,
          "end": 288.4,
          "en": "And with that,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 288.4,
          "end": 290.28,
          "en": "I can click on view details",
          "zh": ""
        },
        {
          "id": 93,
