  "lectures": [
    {
      "id": "21879376",
      "title": "Rendering Multiple Routes with Named Router Views",
      "lectureOrder": 183,
      "videoOrder": 159,
      "sourceHash": "712c31a16e56cd13987d11e3874c455664a5e5eea48217e56023790e3bfa0ed2",
      "cues": [
        {
          "id": 1,
          "start": 2.26,
          "end": 3.13,
          "en": "Now for the moment,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.13,
          "end": 6.63,
          "en": "that's it when it comes to navigating around",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.63,
          "end": 9.31,
          "en": "and building those two values",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.31,
          "end": 12.13,
          "en": "like that object here with the query parameter.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.13,
          "end": 14.24,
          "en": "I now wanna move on to another feature,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.24,
          "end": 17.08,
          "en": "which can be useful in some applications.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.08,
          "end": 21.453,
          "en": "And that would be multiple router views on the same level.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.33,
          "end": 25.9,
          "en": "We already have multiple router views in this demo app.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 25.9,
          "end": 27.78,
          "en": "We have one in App vue",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.78,
          "end": 30.66,
          "en": "and we have one in the team's list component",
          "zh": ""
        },
        {
          "id": 11,
          "start": 30.66,
          "end": 32.761,
          "en": "for the nested routes that belong to the route",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.761,
          "end": 35.323,
          "en": "that loads the team's list component.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 36.42,
          "end": 37.53,
          "en": "But you can also have",
          "zh": ""
        },
        {
          "id": 14,
          "start": 37.53,
          "end": 40.33,
          "en": "multiple router views on the same level.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 40.33,
          "end": 42.85,
          "en": "So for the same set of routes,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 42.85,
          "end": 45.003,
          "en": "for example, here in App vue,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 46.11,
          "end": 50.44,
          "en": "we could have a footer element let's see,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 50.44,
          "end": 51.92,
          "en": "but that's not mandatory.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 51.92,
          "end": 55.08,
          "en": "But in there we could have another router view.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 55.08,
          "end": 58.4,
          "en": "Now, of course, having two router views on the same level,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 58.4,
          "end": 60.64,
          "en": "which are there for dealing with the same routes",
          "zh": ""
        },
        {
          "id": 22,
          "start": 60.64,
          "end": 63.79,
          "en": "will not be too helpful just like that.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 63.79,
          "end": 66.69,
          "en": "If I saved that",
          "zh": ""
        },
        {
          "id": 24,
          "start": 66.69,
          "end": 67.523,
          "en": "and I reload,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 67.523,
          "end": 71.17,
          "en": "we now just see that every page has loaded twice.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 71.17,
          "end": 73.82,
          "en": "Of course, because we have two router views.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 73.82,
          "end": 76.543,
          "en": "That's probably not the behavior you want.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 77.66,
          "end": 80.42,
          "en": "But instead multiple router views on the same level,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 80.42,
          "end": 83.69,
          "en": "allow you to add another cool functionality.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 83.69,
          "end": 87.24,
          "en": "You can load multiple components per routes,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 87.24,
          "end": 91.06,
          "en": "and then sent them to different router views.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 91.06,
          "end": 92.6,
          "en": "Now for that let's say,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 92.6,
          "end": 97.43,
          "en": "we have a TeamsFooter.vue component,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 97.43,
          "end": 101.28999999999999,
          "en": "which has a simple template where it say Teams Footer,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 101.28999999999999,
          "end": 103.12299999999999,
          "en": "just so that we can recognize it.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 104.00999999999999,
          "end": 106.28999999999999,
          "en": "And then I copied that to the users folder,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 106.28999999999999,
          "end": 107.983,
          "en": "but name it UsersFooter.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 108.96000000000001,
          "end": 112.65299999999999,
          "en": "And in there, it should, of course say users footer.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 113.56,
          "end": 116.85,
          "en": "Now in reality, you would have more in there than just text.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 116.85,
          "end": 120.18,
          "en": "But the main thing is that you have two different components",
          "zh": ""
        },
        {
          "id": 41,
          "start": 120.18,
          "end": 123.05,
          "en": "that should be loaded as a footer,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 123.05,
          "end": 125.47,
          "en": "depending on whether you're in the teams area",
          "zh": ""
        },
        {
          "id": 43,
          "start": 125.47,
          "end": 127.783,
          "en": "or the users area of pages.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 128.87,
          "end": 131.1,
          "en": "And that could absolutely be a requirement",
          "zh": ""
        },
        {
          "id": 45,
          "start": 131.1,
          "end": 132.39,
          "en": "you have in your app.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 132.39,
          "end": 133.48,
          "en": "With the view router,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 133.48,
          "end": 135.53,
          "en": "that's easy to implement.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 135.53,
          "end": 137.4,
          "en": "In your route config,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 137.4,
          "end": 140.365,
          "en": "you can register more than one component per route.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 140.365,
          "end": 142.78,
          "en": "Here, for example, on teams,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 142.78,
          "end": 145.93,
          "en": "instead of just having one component here,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 145.93,
          "end": 148.683,
          "en": "we can add components.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 149.59,
          "end": 153.67000000000002,
          "en": "So plural. And this now takes an object.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 153.67000000000002,
          "end": 155.29,
          "en": "And in this object,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 155.29,
          "end": 159.8,
          "en": "you can now define key value piers where the keys",
          "zh": ""
        },
        {
          "id": 56,
          "start": 159.8,
          "end": 162.15,
          "en": "identify different router views,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 162.15,
          "end": 164.15,
          "en": "and the values are the components",
          "zh": ""
        },
        {
          "id": 58,
          "start": 164.15,
          "end": 167.04,
          "en": "that should be loaded into this router view.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 167.04,
          "end": 170.742,
          "en": "And that now works if you give those router views names,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 170.742,
          "end": 174.26,
          "en": "just as you can give names to slots.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 174.26,
          "end": 176.92000000000002,
          "en": "We could give this router view in the footer,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 176.92000000000002,
          "end": 179.84300000000002,
          "en": "a name of footer, but the name is up to you.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 180.72,
          "end": 183.13,
          "en": "We could also give this router view a name,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 183.13,
          "end": 184.83,
          "en": "but just as we have slots,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 184.83,
          "end": 189.11,
          "en": "you are allowed to have one unnamed router view",
          "zh": ""
        },
        {
          "id": 66,
          "start": 189.11,
          "end": 190.25,
          "en": "on the same level,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 190.25,
          "end": 192.403,
          "en": "which will then be the default router view.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 193.9,
          "end": 197.1,
          "en": "So now you're back in our route config.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 197.1,
          "end": 199.76,
          "en": "We can add a key off default",
          "zh": ""
        },
        {
          "id": 70,
          "start": 199.76,
          "end": 202.93,
          "en": "to point at this unnamed router view",
          "zh": ""
        },
        {
          "id": 71,
          "start": 202.93,
          "end": 206.12,
          "en": "and set up the component that should go into that default,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 206.12,
          "end": 207.92000000000002,
          "en": "which in this case is the TeamsList.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 209.122,
          "end": 212.26,
          "en": "But we can then also add a footer key here",
          "zh": ""
        },
        {
          "id": 74,
          "start": 212.26,
          "end": 215.84,
          "en": "pointing at that router view named footer",
          "zh": ""
        },
        {
          "id": 75,
          "start": 215.84,
          "end": 217.21,
          "en": "and set up the component",
          "zh": ""
        },
        {
          "id": 76,
          "start": 217.21,
          "end": 219.98,
          "en": "that should be rendered in this router view.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 219.98,
          "end": 223.01,
          "en": "And that's a component I have yet to import.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 223.01,
          "end": 226.42000000000002,
          "en": "That will be the teams footer component,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 226.42000000000002,
          "end": 227.253,
          "en": "which is imported",
          "zh": ""
        },
        {
          "id": 80,
          "start": 227.253,
          "end": 231.863,
          "en": "from components/teams/TeamsFooter.vue.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 232.72,
          "end": 234.71,
          "en": "And when we're already importing stuff,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 234.71,
          "end": 237.663,
          "en": "I can also already import UsersFooter",
          "zh": ""
        },
        {
          "id": 83,
          "start": 237.663,
          "end": 239.563,
          "en": "from components/users/UsersFooter.vue.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 243.69,
          "end": 245.55,
          "en": "And now it's the team's footer,",
          "zh": ""
        },
        {
          "id": 85,
          "start": 245.55,
          "end": 248.69,
          "en": "which I wanna set as a value for the footer outlet",
          "zh": ""
        },
        {
          "id": 86,
          "start": 248.69,
          "end": 250.113,
          "en": "on my components here.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 251.55,
          "end": 252.9,
          "en": "Now I don't need to change anything",
          "zh": ""
        },
        {
          "id": 88,
          "start": 252.9,
          "end": 255.14,
          "en": "about the nested child route here.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 255.14,
          "end": 257.8,
          "en": "Here I still only wanna load one component,",
          "zh": ""
        },
        {
          "id": 90,
          "start": 257.8,
          "end": 260.32,
          "en": "but the parent has more than one component here,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 260.32,
          "end": 261.283,
          "en": "as you can tell.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 262.7,
          "end": 265.55,
          "en": "Now we can also do the same here for the users.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 265.55,
          "end": 269.2,
          "en": "On the users route, instead of using component,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 269.2,
          "end": 271.41,
          "en": "we could use components,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 271.41,
          "end": 274,
          "en": "set the default to UsersList",
          "zh": ""
        },
        {
          "id": 96,
          "start": 274,
          "end": 278.723,
          "en": "and the footer outlet to UserFooter, UsersFooter, sorry.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 279.89,
          "end": 282.65999999999997,
          "en": "So now we're using these named router views",
          "zh": ""
        },
        {
          "id": 98,
          "start": 282.65999999999997,
          "end": 285.2,
          "en": "for users and teams.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 285.2,
          "end": 288.08,
          "en": "And for all the routes like this catch all route",
          "zh": ""
        },
        {
          "id": 100,
          "start": 288.08,
          "end": 289.96,
          "en": "where we just have one component,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 289.96,
          "end": 291.35,
          "en": "that one component",
          "zh": ""
        },
        {
          "id": 102,
          "start": 291.35,
          "end": 295.07,
          "en": "will always go into the default unnamed router view.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 295.07,
          "end": 297.06,
          "en": "So we don't need to set up components here",
          "zh": ""
        },
        {
          "id": 104,
          "start": 297.06,
          "end": 300.323,
          "en": "if we only have one router view we wanna support here.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 301.37,
          "end": 303.47,
          "en": "With that, whoever we can save that.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 303.47,
          "end": 306.84,
          "en": "And now you'll see our team items, our teams,",
          "zh": ""
        },
        {
          "id": 107,
          "start": 306.84,
          "end": 309.72,
          "en": "and then the teams footer for a user.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 309.72,
          "end": 313.84,
          "en": "You see the users footer and the users, of course.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 313.84,
          "end": 317.47,
          "en": "If I select a team, we see the team members",
          "zh": ""
        },
        {
          "id": 110,
          "start": 317.47,
          "end": 318.73,
          "en": "and then still",
          "zh": ""
        },
        {
          "id": 111,
          "start": 318.73,
          "end": 321.92,
          "en": "are two different teams components down there.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 321.92,
          "end": 324.63,
          "en": "And if I enter anything invalid,",
          "zh": ""
        },
        {
          "id": 113,
          "start": 324.63,
          "end": 327.26,
          "en": "we still just see one not found route,",
          "zh": ""
        },
        {
          "id": 114,
          "start": 327.26,
          "end": 328.36,
          "en": "because as I said,",
          "zh": ""
        },
        {
          "id": 115,
          "start": 328.36,
          "end": 332.563,
          "en": "that then goes into the default unnamed router view.",
          "zh": ""
        },
        {
          "id": 116,
          "start": 333.57,
          "end": 336.05,
          "en": "So named router views can be helpful",
          "zh": ""
        },
        {
          "id": 117,
          "start": 336.05,
          "end": 340.21,
          "en": "to allow you to construct more complex user interfaces",
          "zh": ""
        },
        {
          "id": 118,
          "start": 340.21,
          "end": 342.71,
          "en": "where you wanna load more than one component",
          "zh": ""
        },
        {
          "id": 119,
          "start": 342.71,
          "end": 344.15,
          "en": "for a given path.",
          "zh": ""
        },
        {
          "id": 120,
          "start": 344.15,
          "end": 347.88,
          "en": "For example, to not just have flexible main pages,",
          "zh": ""
        },
        {
          "id": 121,
          "start": 347.88,
          "end": 349.963,
          "en": "but all the flexible footers.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
