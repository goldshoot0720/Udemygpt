  "lectures": [
    {
      "id": "21879732",
      "title": "Introducing Getters - A Better Way Of Getting Data",
      "lectureOrder": 218,
      "videoOrder": 191,
      "sourceHash": "39d09f717ce27726a9df2d7c4f1deb0132c21152330564f68ba70c16f58465f9",
      "cues": [
        {
          "id": 1,
          "start": 2.06,
          "end": 5.51,
          "en": "So we use mutations to edit our data",
          "zh": ""
        },
        {
          "id": 2,
          "start": 5.51,
          "end": 6.5,
          "en": "in the state,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.5,
          "end": 8.13,
          "en": "in the store.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.13,
          "end": 11.35,
          "en": "Now just as we shouldn't directly edit the state,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.35,
          "end": 12.8,
          "en": "from inside components,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 12.8,
          "end": 16.28,
          "en": "we could also argue that directly reading the state,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 16.28,
          "end": 18.66,
          "en": "might not be ideal.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 18.66,
          "end": 21.133,
          "en": "Why could this be sub-optimal?",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.02,
          "end": 23.196,
          "en": "Well in this app we got the,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 23.196,
          "end": 24.65,
          "en": "TheCounter component,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 24.65,
          "end": 26.87,
          "en": "where I output to counter.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 26.87,
          "end": 28.46,
          "en": "Now lets say for whatever reason",
          "zh": ""
        },
        {
          "id": 13,
          "start": 28.46,
          "end": 30.203,
          "en": "we also have another component.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 31.09,
          "end": 33.91,
          "en": "Favoritevalue.vue",
          "zh": ""
        },
        {
          "id": 15,
          "start": 34.98,
          "end": 38.84,
          "en": "And in their we do the same thing as in the counter.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 38.84,
          "end": 40.21,
          "en": "But maybe we do more.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 40.21,
          "end": 42.43,
          "en": "That's why we have separate component.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 42.43,
          "end": 44.353,
          "en": "So we do more here.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 47.04,
          "end": 48.99,
          "en": "Now of course we can use this",
          "zh": ""
        },
        {
          "id": 20,
          "start": 48.99,
          "end": 49.96,
          "en": "component here,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 49.96,
          "end": 50.793,
          "en": "in AppVue,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 50.793,
          "end": 55.793,
          "en": "we can import FavoriteValue from components",
          "zh": ""
        },
        {
          "id": 23,
          "start": 56.15,
          "end": 57.727,
          "en": "FavoriteValue.vue",
          "zh": ""
        },
        {
          "id": 24,
          "start": 57.727,
          "end": 60.05,
          "en": "and register it here,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 60.05,
          "end": 63.1,
          "en": "and also add this here below the counter maybe.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 63.1,
          "end": 65.493,
          "en": "FavoriteValue like this.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 67.53,
          "end": 69.25,
          "en": "Now of course this will work.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 69.25,
          "end": 70.75,
          "en": "We got the counter twice now,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 70.75,
          "end": 73.63,
          "en": "and it updates in both components.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 73.63,
          "end": 75.35,
          "en": "Now lets say we decide",
          "zh": ""
        },
        {
          "id": 31,
          "start": 75.35,
          "end": 78.27,
          "en": "that actually we always want our output to counter",
          "zh": ""
        },
        {
          "id": 32,
          "start": 78.27,
          "end": 79.52,
          "en": "times two.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 79.52,
          "end": 82.34,
          "en": "So we update it here in FavoriteValue",
          "zh": ""
        },
        {
          "id": 34,
          "start": 82.34,
          "end": 84.713,
          "en": "and we update it in the counter.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 86.42,
          "end": 87.94,
          "en": "Do you see the problem?",
          "zh": ""
        },
        {
          "id": 36,
          "start": 87.94,
          "end": 91.36,
          "en": "We are again replicating logic here.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 91.36,
          "end": 93.06,
          "en": "We do have duplicate code.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 93.06,
          "end": 96.82,
          "en": "And again in bigger more realistic applications,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 96.82,
          "end": 98.67,
          "en": "this might absolutely happen.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 98.67,
          "end": 102,
          "en": "That we need the same kind of data in different components,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 102,
          "end": 104.97999999999999,
          "en": "and then we decide that we want to format",
          "zh": ""
        },
        {
          "id": 42,
          "start": 104.97999999999999,
          "end": 107.4,
          "en": "or calculate the data differently.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 107.4,
          "end": 109.69,
          "en": "And therefore we suddenly need to change it",
          "zh": ""
        },
        {
          "id": 44,
          "start": 109.69,
          "end": 111.283,
          "en": "in all the different places.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 112.49000000000001,
          "end": 117.12,
          "en": "This is why we might not want to directly talk to the state.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 117.12,
          "end": 120.73,
          "en": "Instead we can use a concept called Getters.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 120.73,
          "end": 121.93,
          "en": "Which in the end are,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 121.93,
          "end": 124.11,
          "en": "you could say computer properties",
          "zh": ""
        },
        {
          "id": 49,
          "start": 124.11,
          "end": 127.08,
          "en": "defined directly in the store,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 127.08,
          "end": 129.71,
          "en": "which we then can use from inside any component",
          "zh": ""
        },
        {
          "id": 51,
          "start": 129.71,
          "end": 131.64,
          "en": "of our choice.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 131.64,
          "end": 135.83,
          "en": "So here is how we add a getter to our Vuex store.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 135.83,
          "end": 137.76,
          "en": "Next to mutations,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 137.76,
          "end": 140.91,
          "en": "doesn't matter where exactly but in the same place as",
          "zh": ""
        },
        {
          "id": 55,
          "start": 140.91,
          "end": 142.51,
          "en": "State and Mutations,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 142.51,
          "end": 144.176,
          "en": "you add getters.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 144.176,
          "end": 146.046,
          "en": "This takes an object,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 146.046,
          "end": 149.59,
          "en": "and every getter is a method in this object now.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 149.59,
          "end": 152.81,
          "en": "So basically just like computer properties are methods",
          "zh": ""
        },
        {
          "id": 60,
          "start": 152.81,
          "end": 155.77,
          "en": "in the computed option of components.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 155.77,
          "end": 158.96,
          "en": "Here we could have the final counter getter",
          "zh": ""
        },
        {
          "id": 62,
          "start": 158.96,
          "end": 160.45,
          "en": "lets say.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 160.45,
          "end": 163.21,
          "en": "And the final Counter Getter method",
          "zh": ""
        },
        {
          "id": 64,
          "start": 163.21,
          "end": 165.397,
          "en": "like all getter method in Vuex,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 165.397,
          "end": 167.94,
          "en": "gets two arguments.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 167.94,
          "end": 169.49,
          "en": "The current State,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 169.49,
          "end": 171.847,
          "en": "which we need to get a value out of it,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 171.847,
          "end": 174.649,
          "en": "and other getters.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 174.649,
          "end": 177.55,
          "en": "Getting other getters in a getter",
          "zh": ""
        },
        {
          "id": 70,
          "start": 177.55,
          "end": 181.09,
          "en": "can be helpful if the value you wanna calculate here,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 181.09,
          "end": 184.14,
          "en": "depends on the result of an another getter.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 184.14,
          "end": 185.26,
          "en": "But lets ignore that for now,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 185.26,
          "end": 188.04,
          "en": "lets just work with the state argument.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 188.04,
          "end": 190.1,
          "en": "We wanna return a value here,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 190.1,
          "end": 192.098,
          "en": "a getter has to return a value.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 192.098,
          "end": 194.47,
          "en": "And the value here is our counter",
          "zh": ""
        },
        {
          "id": 77,
          "start": 194.47,
          "end": 196.29,
          "en": "which is manged in the state,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 196.29,
          "end": 197.823,
          "en": "times two lets say.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 199.31,
          "end": 201.76,
          "en": "And we can now use this getter",
          "zh": ""
        },
        {
          "id": 80,
          "start": 201.76,
          "end": 204.17000000000002,
          "en": "from any component of our choice.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 204.17000000000002,
          "end": 205.04,
          "en": "For example,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 205.04,
          "end": 208.12,
          "en": "from inside the counter.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 208.12,
          "end": 210.37,
          "en": "Here in this computed property,",
          "zh": ""
        },
        {
          "id": 84,
          "start": 210.37,
          "end": 211.54,
          "en": "which we keep,",
          "zh": ""
        },
        {
          "id": 85,
          "start": 211.54,
          "end": 214.32,
          "en": "we now access this $store,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 214.32,
          "end": 216.82999999999998,
          "en": "but no longer the state but instead",
          "zh": ""
        },
        {
          "id": 87,
          "start": 216.82999999999998,
          "end": 218.15,
          "en": "store.getters.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 219.57999999999998,
          "end": 221.71,
          "en": "And then the name of your getter.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 221.71,
          "end": 224.187,
          "en": "Which in this case was FinalCounter.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 225.19,
          "end": 227.73,
          "en": "So here it's also FinalCounter.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 227.73,
          "end": 229.07,
          "en": "And you don't call it,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 229.07,
          "end": 230.52,
          "en": "you don't execute it,",
          "zh": ""
        },
        {
          "id": 93,
          "start": 230.52,
          "end": 232.03300000000002,
          "en": "you just point at it.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 233.01,
          "end": 233.84300000000002,
          "en": "Like this.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 233.84300000000002,
          "end": 235.007,
          "en": "Like a property.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 235.007,
          "end": 239.23,
          "en": "And Vuex will execute this getter method for you then,",
          "zh": ""
        },
        {
          "id": 97,
          "start": 239.23,
          "end": 242.023,
          "en": "passing into current state into the getter.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 243.43,
          "end": 244.95,
          "en": "So we do this here,",
          "zh": ""
        },
        {
          "id": 99,
          "start": 244.95,
          "end": 246.19,
          "en": "in the counter,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 246.19,
          "end": 248.153,
          "en": "and also in FavoriteValue.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 249.33,
          "end": 252.83,
          "en": "And with that if we ever decide that the counter should be",
          "zh": ""
        },
        {
          "id": 102,
          "start": 252.83,
          "end": 255.36,
          "en": "lets say the Value times three,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 255.36,
          "end": 257.73,
          "en": "we just need to do this in one place,",
          "zh": ""
        },
        {
          "id": 104,
          "start": 257.73,
          "end": 259.733,
          "en": "instead of in two places.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 261.41,
          "end": 263.52,
          "en": "So with that,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 263.52,
          "end": 266.15,
          "en": "if we go back,",
          "zh": ""
        },
        {
          "id": 107,
          "start": 266.15,
          "end": 268.713,
          "en": "you see this works now.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 269.62,
          "end": 271.613,
          "en": "And this is the concept of getters.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 273.222,
          "end": 275.9,
          "en": "Now I mentioned that you can't have multiple getters,",
          "zh": ""
        },
        {
          "id": 110,
          "start": 275.9,
          "end": 279.34000000000003,
          "en": "and that getters can also depend on each other.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 279.34000000000003,
          "end": 280.173,
          "en": "Lets say,",
          "zh": ""
        },
        {
          "id": 112,
          "start": 280.173,
          "end": 282.12,
          "en": "besides our FinalCounter getter,",
          "zh": ""
        },
        {
          "id": 113,
          "start": 282.12,
          "end": 284.54,
          "en": "we have another getter",
          "zh": ""
        },
        {
          "id": 114,
          "start": 285.65,
          "end": 287.543,
          "en": "which is called normalizedCounter.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 289.558,
          "end": 291.17,
          "en": "And the idea here is simple,",
          "zh": ""
        },
        {
          "id": 116,
          "start": 291.17,
          "end": 294.03,
          "en": "I wanna use my counter value,",
          "zh": ""
        },
        {
          "id": 117,
          "start": 294.03,
          "end": 296.72,
          "en": "to be precise the FinalCounter value,",
          "zh": ""
        },
        {
          "id": 118,
          "start": 296.72,
          "end": 300.37,
          "en": "but I want to make sure it's greater than zero",
          "zh": ""
        },
        {
          "id": 119,
          "start": 300.37,
          "end": 302.353,
          "en": "and smaller than 100.",
          "zh": ""
        },
        {
          "id": 120,
          "start": 303.27,
          "end": 307.15,
          "en": "And I either output zero or 100 if one of this boundaries",
          "zh": ""
        },
        {
          "id": 121,
          "start": 307.15,
          "end": 308.77,
          "en": "is crossed.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 308.77,
          "end": 310.77,
          "en": "Now one way of building this,",
          "zh": ""
        },
        {
          "id": 123,
          "start": 310.77,
          "end": 311.94,
          "en": "would be,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 311.94,
          "end": 315.85,
          "en": "that we recalculate our counter times three here,",
          "zh": ""
        },
        {
          "id": 125,
          "start": 315.85,
          "end": 320.43,
          "en": "and then we have our FinalCounter here.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 320.43,
          "end": 324.01,
          "en": "We check if FinalCounter is smaller than zero,",
          "zh": ""
        },
        {
          "id": 127,
          "start": 324.01,
          "end": 327.33,
          "en": "which can't happen here but lets say we still check it.",
          "zh": ""
        },
        {
          "id": 128,
          "start": 327.33,
          "end": 329.6,
          "en": "In which case we return zero,",
          "zh": ""
        },
        {
          "id": 129,
          "start": 329.6,
          "end": 333.12,
          "en": "we check if FinalCounter is greater than 100,",
          "zh": ""
        },
        {
          "id": 130,
          "start": 333.12,
          "end": 335.173,
          "en": "in which case we return 100.",
          "zh": ""
        },
        {
          "id": 131,
          "start": 336.27,
          "end": 339.4,
          "en": "And only if neither of the two things is the case,",
          "zh": ""
        },
        {
          "id": 132,
          "start": 339.4,
          "end": 341.437,
          "en": "we return the FinalCounter.",
          "zh": ""
        },
        {
          "id": 133,
          "start": 342.68,
          "end": 343.55,
          "en": "As a side note,",
          "zh": ""
        },
        {
          "id": 134,
          "start": 343.55,
          "end": 346.15999999999997,
          "en": "this also shows us that you of course",
          "zh": ""
        },
        {
          "id": 135,
          "start": 346.15999999999997,
          "end": 348.99,
          "en": "can have more than one line of code in a getter.",
          "zh": ""
        },
        {
          "id": 136,
          "start": 348.99,
          "end": 351.61,
          "en": "That's another advantage of using getters.",
          "zh": ""
        },
        {
          "id": 137,
          "start": 351.61,
          "end": 353.35,
          "en": "You can move such code",
          "zh": ""
        },
        {
