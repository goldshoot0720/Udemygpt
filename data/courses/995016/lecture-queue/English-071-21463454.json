          "en": "don't delete it,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 274.34000000000003,
          "end": 277.85,
          "en": "that will all impact your application in a negative way.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 277.85,
          "end": 279.463,
          "en": "You should just leave it here.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 280.33,
          "end": 282.87,
          "en": "The public folder is a very simple folder.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 282.87,
          "end": 285.81,
          "en": "Here in the end, we got a HTML file.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 285.81,
          "end": 288.59000000000003,
          "en": "And this is a very simple looking file",
