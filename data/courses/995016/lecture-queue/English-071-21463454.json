          "end": 302.323,
          "en": "where our vue app will be mounted to.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 303.17,
          "end": 307.02,
          "en": "And we will only have one HTML file here,",
          "zh": ""
        },
        {
          "id": 120,
          "start": 307.02,
          "end": 310.57,
          "en": "since we're building a vue single-page application,",
          "zh": ""
        },
        {
          "id": 121,
          "start": 310.57,
          "end": 313.03,
          "en": "which means everything we see on the screen",
