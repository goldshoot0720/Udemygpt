        },
        {
          "id": 76,
          "start": 199.3,
          "end": 201.4,
          "en": "to bring up that development server again.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 202.3,
          "end": 203.133,
          "en": "And by the way,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 203.133,
          "end": 205.26,
          "en": "you should keep that server up and running,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 205.26,
          "end": 207.7,
          "en": "you should keep that process up and running.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 207.7,
          "end": 209.42000000000002,
          "en": "Because you can only test your app",
          "zh": ""
        },
        {
          "id": 81,
          "start": 209.42000000000002,
          "end": 211.48,
          "en": "as long as that is running.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 211.48,
          "end": 212.71,
          "en": "If you're done for the day,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 212.71,
          "end": 214.98,
          "en": "you can quit with Ctrl+C.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 214.98,
          "end": 217.82999999999998,
          "en": "But if you're starting to write code again in that project,",
