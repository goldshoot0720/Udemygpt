        },
        {
          "id": 102,
          "start": 258.77,
          "end": 260.67,
          "en": "It contains our dependencies,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 260.67,
          "end": 262.47,
          "en": "for example, the vue framework,",
          "zh": ""
        },
        {
          "id": 104,
          "start": 262.47,
          "end": 265.18,
          "en": "and also dependencies of dependencies.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 265.18,
          "end": 266.883,
          "en": "That's why it's so big.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 268.41,
          "end": 271.3,
          "en": "You should leave the node modules folder alone,",
