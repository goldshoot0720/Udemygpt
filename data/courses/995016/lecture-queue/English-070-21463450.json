        },
        {
          "id": 71,
          "start": 187.14,
          "end": 189.44,
          "en": "in front of this to get the right permissions.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 189.44,
          "end": 191.9,
          "en": "On Windows, this is not required",
          "zh": ""
        },
        {
          "id": 73,
          "start": 191.9,
          "end": 193.53,
          "en": "and actually also will not work.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 193.53,
          "end": 198.53,
          "en": "So on Windows, it's just npm install -g @vue/cli.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 198.96,
          "end": 202.72,
          "en": "Now, once you entered this command, hit Enter.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 202.72,
          "end": 206.69,
          "en": "Maybe enter your password if you're prompted for it.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 206.69,
          "end": 208.04,
          "en": "And now this will go ahead",
          "zh": ""
        },
        {
          "id": 78,
          "start": 208.04,
          "end": 213.04,
          "en": "and install this Vue CLI tool globally on your system",
          "zh": ""
        },
        {
          "id": 79,
          "start": 213.25,
          "end": 215.36,
          "en": "so that we can thereafter use it",
