          "end": 408.453,
          "en": "once this promise is done.",
          "zh": ""
        },
        {
          "id": 131,
          "start": 409.49,
          "end": 413.34000000000003,
          "en": "Or we use an alternative, a more modern syntax,",
          "zh": ""
        },
        {
          "id": 132,
          "start": 413.34000000000003,
          "end": 416.32,
          "en": "the async await syntax.",
          "zh": ""
