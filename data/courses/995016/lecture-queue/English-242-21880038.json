  "lectures": [
    {
      "id": "21880038",
      "title": "Updating the UI Based on Auth State",
      "lectureOrder": 271,
      "videoOrder": 242,
      "sourceHash": "43a1bdab8a90cef357e5544840b960588b0cb3475ff6b27423235b9ab6782b02",
      "cues": [
        {
          "id": 1,
          "start": 2.04,
          "end": 3.24,
          "en": "So for updating the UI,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.24,
          "end": 5.14,
          "en": "I got two main areas.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.14,
          "end": 7.28,
          "en": "And that's this register as coach button,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 7.28,
          "end": 9.9,
          "en": "which I wanna replace if we're not logged in.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 9.9,
          "end": 12.65,
          "en": "And requests also shouldn't be visible here",
          "zh": ""
        },
        {
          "id": 6,
          "start": 12.65,
          "end": 13.85,
          "en": "if we're not logged in.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 13.85,
          "end": 17.053,
          "en": "Instead, maybe we wanna show a login button.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 18.45,
          "end": 20.79,
          "en": "For that, I will start in my getters",
          "zh": ""
        },
        {
          "id": 9,
          "start": 20.79,
          "end": 23.65,
          "en": "in the auth module though.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 23.65,
          "end": 25.53,
          "en": "So, there in getters.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 25.53,
          "end": 28.273,
          "en": "I'll add a new getter isAuthenticated.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 29.98,
          "end": 34.58,
          "en": "And here, I wanna check if we are authenticated.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 34.58,
          "end": 38.23,
          "en": "And how can we tell whether we are authenticated or not?",
          "zh": ""
        },
        {
          "id": 14,
          "start": 38.23,
          "end": 42.03,
          "en": "Well, if we got a token, then we are authenticated.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 42.03,
          "end": 44.36,
          "en": "Because we start without one,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 44.36,
          "end": 46.41,
          "en": "and I will later reset it",
          "zh": ""
        },
        {
          "id": 17,
          "start": 46.41,
          "end": 48.89,
          "en": "once we added a log out functionality.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 48.89,
          "end": 52.18,
          "en": "So, if we have a token, we are authenticated.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 52.18,
          "end": 54.87,
          "en": "So, I will return state.token;",
          "zh": ""
        },
        {
          "id": 20,
          "start": 54.87,
          "end": 57.34,
          "en": "and convert this to a true Boolean",
          "zh": ""
        },
        {
          "id": 21,
          "start": 57.34,
          "end": 59.573,
          "en": "by adding the double exclamation mark again.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 61.49,
          "end": 64.11,
          "en": "Now, we can use the isAuthenticated getter",
          "zh": ""
        },
        {
          "id": 23,
          "start": 64.11,
          "end": 65.89,
          "en": "into different parts of this app.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 65.89,
          "end": 68.81,
          "en": "For example, under a coach's list.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 68.81,
          "end": 71.77,
          "en": "Here, we have this register as coach button,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 71.77,
          "end": 75.55,
          "en": "and that should not be visible if we're not even logged in.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 75.55,
          "end": 80.24,
          "en": "Instead, I wanna show a login button or link instead.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 80.24,
          "end": 82.67,
          "en": "So, therefore, we can add a new computed property",
          "zh": ""
        },
        {
          "id": 29,
          "start": 82.67,
          "end": 86.049,
          "en": "here to coach's list,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 86.049,
          "end": 91.049,
          "en": "the isLoggedIn computed property, for example,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 92.22,
          "end": 97.22,
          "en": "where I return this.$store.getters.isAuthenticated;",
          "zh": ""
        },
        {
          "id": 32,
          "start": 98.93,
          "end": 101.42,
          "en": "Since this module is not namespaced,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 101.42,
          "end": 103.57300000000001,
          "en": "we can access the getter just like this.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 104.86,
          "end": 106.24000000000001,
          "en": "Now, we can use isLoggedIn",
          "zh": ""
        },
        {
          "id": 35,
          "start": 107.09,
          "end": 110.47,
          "en": "and only show this register as coach button",
          "zh": ""
        },
        {
          "id": 36,
          "start": 110.47,
          "end": 112.09,
          "en": "if we're not a coach,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 112.09,
          "end": 116.72999999999999,
          "en": "we're not loading and we are logged in.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 116.72999999999999,
          "end": 119.55,
          "en": "So, if we are logged in and we're not a coach",
          "zh": ""
        },
        {
          "id": 39,
          "start": 119.55,
          "end": 120.78,
          "en": "and we're not loading,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 120.78,
          "end": 122.5,
          "en": "then I wanna show this button.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 122.5,
          "end": 124.33,
          "en": "And, of course, you could also put this all",
          "zh": ""
        },
        {
          "id": 42,
          "start": 124.33,
          "end": 126.18,
          "en": "into one computed property",
          "zh": ""
        },
        {
          "id": 43,
          "start": 126.18,
          "end": 128.613,
          "en": "to take this logic out of the template.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 129.77,
          "end": 132.71,
          "en": "Now, I will add a new base-button here,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 132.71,
          "end": 135.723,
          "en": "which will act as a link to=\"/auth\"",
          "zh": ""
        },
        {
          "id": 46,
          "start": 139.3,
          "end": 144.3,
          "en": "where I say login if we are not logged in.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 144.89,
          "end": 149.75,
          "en": "So, if we're not logged in,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 149.75,
          "end": 151.01,
          "en": "if we're not logged in,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 151.01,
          "end": 152.363,
          "en": "this button will be shown.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 153.98,
          "end": 155.45,
          "en": "Now, with that saved,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 155.45,
          "end": 157.56,
          "en": "here we see the login button.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 157.56,
          "end": 158.41,
          "en": "And we click it,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 158.41,
          "end": 160.78,
          "en": "we go to the login page.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 160.78,
          "end": 163.43,
          "en": "Now, for the navigation bar,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 163.43,
          "end": 167.633,
          "en": "that's TheHeader in the layout folder under components.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 168.63,
          "end": 171.56,
          "en": "And here, we now also need to add a script,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 171.56,
          "end": 173.11,
          "en": "to add a computed property",
          "zh": ""
        },
        {
          "id": 58,
          "start": 173.11,
          "end": 174.913,
          "en": "to get access to our getters.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 176.87,
          "end": 179.39,
          "en": "I will also add a isLoggedIn getter",
          "zh": ""
        },
        {
          "id": 60,
          "start": 179.39,
          "end": 181.72,
          "en": "at our computed property here",
          "zh": ""
        },
        {
          "id": 61,
          "start": 181.72,
          "end": 186.72,
          "en": "and return this.$store.getters.isAuthenticated;",
          "zh": ""
        },
        {
          "id": 62,
          "start": 186.92,
          "end": 189.343,
          "en": "That getter we added a couple of minutes ago.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 191.26,
          "end": 193.37,
          "en": "And I'll only show this list item",
          "zh": ""
        },
        {
          "id": 64,
          "start": 193.37,
          "end": 197.31,
          "en": "with the requests link if we are logged in.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 197.31,
          "end": 202.31,
          "en": "Otherwise, I'll show a different list item",
          "zh": ""
        },
        {
          "id": 66,
          "start": 202.45,
          "end": 206.393,
          "en": "with a <router-link to=\"/auth\"",
          "zh": ""
        },
        {
          "id": 67,
          "start": 208.64,
          "end": 212.003,
          "en": "where I say login.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 213.42000000000002,
          "end": 215.01,
          "en": "With that, if we save this,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 215.01,
          "end": 219.85,
          "en": "we now see login here as a navigation item.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 219.85,
          "end": 224.85,
          "en": "If I do log in, you see,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 225.03,
          "end": 227.31,
          "en": "we have requests instead,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 227.31,
          "end": 228.62,
          "en": "And on all coaches,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 228.62,
          "end": 231.09,
          "en": "we would see the register as coach button",
          "zh": ""
        },
        {
          "id": 74,
          "start": 231.09,
          "end": 233.92000000000002,
          "en": "if we wouldn't be registered already.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 233.92000000000002,
          "end": 236.09,
          "en": "So, now let's also add a log out button",
          "zh": ""
        },
        {
          "id": 76,
          "start": 236.09,
          "end": 238.12,
          "en": "and a log out functionality",
          "zh": ""
        },
        {
          "id": 77,
          "start": 238.12,
          "end": 240.34,
          "en": "and check a couple of other things we can do",
          "zh": ""
        },
        {
          "id": 78,
          "start": 240.34,
          "end": 242.073,
          "en": "here on our front end.",
          "zh": ""
        }
      ]
    }
  ],
