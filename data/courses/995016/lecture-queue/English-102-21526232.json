  "lectures": [
    {
      "id": "21526232",
      "title": "Dynamic Components",
      "lectureOrder": 119,
      "videoOrder": 102,
      "sourceHash": "305f8e6ecb22e2bbe6b8268e082108b4dfab3ec2db717911cdbe8357f99e19b0",
      "cues": [
        {
          "id": 1,
          "start": 2.19,
          "end": 5.01,
          "en": "Time to finally leave slots.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 5.01,
          "end": 8.973,
          "en": "In App.vue, I'm going to remove,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 10.41,
          "end": 12.72,
          "en": "all those components I've been using this far,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 12.72,
          "end": 14.55,
          "en": "except for TheHeader,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 14.55,
          "end": 16.21,
          "en": "because I now wanna clean up the UI.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.21,
          "end": 19.43,
          "en": "I will leave the files here though for reference.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 19.43,
          "end": 22.87,
          "en": "But now let me quickly create two brand new components here,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.87,
          "end": 24.16,
          "en": "which have nothing to do with",
          "zh": ""
        },
        {
          "id": 9,
          "start": 24.16,
          "end": 27.19,
          "en": "this dummy code we used before.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.19,
          "end": 30.57,
          "en": "Let's say we have a ManageGoals.vue file",
          "zh": ""
        },
        {
          "id": 11,
          "start": 30.57,
          "end": 33.413,
          "en": "and ActiveGoals.vue file.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 34.662,
          "end": 36.77,
          "en": "ManageGoals could be a component where",
          "zh": ""
        },
        {
          "id": 13,
          "start": 36.77,
          "end": 39,
          "en": "the user is able to add new course goals,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 39,
          "end": 40.87,
          "en": "and ActiveGoals is a component",
          "zh": ""
        },
        {
          "id": 15,
          "start": 40.87,
          "end": 44.16,
          "en": "where all added and active goals are displayed.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 44.16,
          "end": 46.65,
          "en": "We're not going to add all the logic for that though,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 46.65,
          "end": 48.53,
          "en": "because I wanna show you something else.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 48.53,
          "end": 49.96,
          "en": "Therefore, I'll keep it simple",
          "zh": ""
        },
        {
          "id": 19,
          "start": 49.96,
          "end": 52.64,
          "en": "and just say Active Goals here",
          "zh": ""
        },
        {
          "id": 20,
          "start": 52.64,
          "end": 55.12,
          "en": "in the template of the ActiveGoal component",
          "zh": ""
        },
        {
          "id": 21,
          "start": 55.12,
          "end": 57.403,
          "en": "so that we can recognize this component.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 58.74,
          "end": 60.28,
          "en": "And in ManageGoals,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 60.28,
          "end": 64.53,
          "en": "I'm going to add a template where I say Manage Goals.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 64.53,
          "end": 67.61,
          "en": "I'll not even add script tags here.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 67.61,
          "end": 70.53999999999999,
          "en": "I'll not export a default config object,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 70.53999999999999,
          "end": 73.26,
          "en": "because if it is empty, you don't even need to export it.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 73.26,
          "end": 75.24,
          "en": "It will so to say,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 75.24,
          "end": 77.82,
          "en": "be exported and created for you automatically",
          "zh": ""
        },
        {
          "id": 29,
          "start": 77.82,
          "end": 78.77,
          "en": "behind the scenes.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 78.77,
          "end": 80.62,
          "en": "You then don't need to define it",
          "zh": ""
        },
        {
          "id": 31,
          "start": 80.62,
          "end": 82.053,
          "en": "if it is empty anyways.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 83.03999999999999,
          "end": 86.45,
          "en": "So you can have components with just templates like here",
          "zh": ""
        },
        {
          "id": 33,
          "start": 86.45,
          "end": 90.53,
          "en": "and now we can add them as local components in App.vue.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 90.53,
          "end": 94.88900000000001,
          "en": "I'll import ActiveGoals from components",
          "zh": ""
        },
        {
          "id": 35,
          "start": 94.88900000000001,
          "end": 96.85,
          "en": "ActiveGoals.vue of course,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 96.85,
          "end": 99.31700000000001,
          "en": "and import ManageGoals from",
          "zh": ""
        },
        {
          "id": 37,
          "start": 99.31700000000001,
          "end": 104.313,
          "en": "./components/ManageGoals.vue like this.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 106.25999999999999,
          "end": 108.43,
          "en": "And then register both as",
          "zh": ""
        },
        {
          "id": 39,
          "start": 109.47999999999999,
          "end": 111.664,
          "en": "local components here in this case,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 111.664,
          "end": 113.997,
          "en": "ActiveGoals and ManageGoals.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 115.1,
          "end": 117.24000000000001,
          "en": "And now of course that shouldn't be a surprise.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 117.24000000000001,
          "end": 118.53,
          "en": "We can use them here",
          "zh": ""
        },
        {
          "id": 43,
          "start": 118.53,
          "end": 122.42,
          "en": "active-goals can be used like this",
          "zh": ""
        },
        {
          "id": 44,
          "start": 122.42,
          "end": 127.023,
          "en": "and manage-goals can also be used like this.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 128.76,
          "end": 131.1,
          "en": "And then now my build process here",
          "zh": ""
        },
        {
          "id": 46,
          "start": 131.1,
          "end": 132.84,
          "en": "is complaining about the fact",
          "zh": ""
        },
        {
          "id": 47,
          "start": 132.84,
          "end": 134.81,
          "en": "that I have components registered,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 134.81,
          "end": 137.57,
          "en": "which I'm not using so let me actually remove",
          "zh": ""
        },
        {
          "id": 49,
          "start": 137.57,
          "end": 140.41,
          "en": "BadgeList, UserInfo, and CourseGoals from here,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 140.41,
          "end": 144.873,
          "en": "and also comment out those imports then here.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 145.85,
          "end": 147.423,
          "en": "So now it is rebuilds.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 148.99,
          "end": 151.1,
          "en": "And now we can see Active Goals",
          "zh": ""
        },
        {
          "id": 53,
          "start": 151.1,
          "end": 152.73,
          "en": "and Manage Goals on the screen.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 152.73,
          "end": 154.67000000000002,
          "en": "Now that's certainly not too exciting,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 154.67000000000002,
          "end": 157.36,
          "en": "but here's the cool feature I wanna show you.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 157.36,
          "end": 161.01,
          "en": "Vue has this concept of dynamic components",
          "zh": ""
        },
        {
          "id": 57,
          "start": 161.01,
          "end": 163.4,
          "en": "and here's where this could be handy.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 163.4,
          "end": 166.81,
          "en": "Let's say we're building a component that has various tabs,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 166.81,
          "end": 168.2,
          "en": "so various buttons in the end,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 168.2,
          "end": 171.12,
          "en": "which we can press to show a different component",
          "zh": ""
        },
        {
          "id": 61,
          "start": 171.12,
          "end": 174.53,
          "en": "so that we either see Active Goals or Manage Goals,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 174.53,
          "end": 177.15,
          "en": "but not both at the same time.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 177.15,
          "end": 180.26,
          "en": "For that we could've our tab buttons here,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 180.26,
          "end": 184.91,
          "en": "Active Goals, and then another button where I say",
          "zh": ""
        },
        {
          "id": 65,
          "start": 184.91,
          "end": 188.12,
          "en": "Manage Goals so I have these two buttons",
          "zh": ""
        },
        {
          "id": 66,
          "start": 189.22,
          "end": 190.97,
          "en": "like tabs here.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 190.97,
          "end": 192.57,
          "en": "And when I press a button,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 192.57,
          "end": 194.65,
          "en": "the respective components should be shown",
          "zh": ""
        },
        {
          "id": 69,
          "start": 194.65,
          "end": 196.99,
          "en": "and the other components shouldn't.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 196.99,
          "end": 199.243,
          "en": "Now here's how we could implement this.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 200.1,
          "end": 203.827,
          "en": "We can manage some extra data here,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 203.827,
          "end": 206.75,
          "en": "selectedComponent, for example.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 206.75,
          "end": 210.05,
          "en": "And initially let's say that is active-goals.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 210.05,
          "end": 212.7,
          "en": "So the HTML tag name,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 212.7,
          "end": 215.22,
          "en": "which we are also using here in the Dum.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 215.22,
          "end": 216.913,
          "en": "active-goals.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 218.07,
          "end": 221.63,
          "en": "And then we add a method here.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 221.63,
          "end": 223.15,
          "en": "So we add the methods key",
          "zh": ""
        },
        {
          "id": 79,
          "start": 224.92000000000002,
          "end": 226.15,
          "en": "and in there add a method,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 226.15,
          "end": 227.15,
          "en": "setSelectedComponent",
          "zh": ""
        },
        {
          "id": 81,
          "start": 230.94,
          "end": 234.57999999999998,
          "en": "where I get the component as an argument,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 234.57999999999998,
          "end": 238.27,
          "en": "and then set this.selectedcomponent equal to the value",
          "zh": ""
        },
        {
          "id": 83,
          "start": 238.27,
          "end": 240.22,
          "en": "I'm getting here as an argument.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 240.22,
          "end": 243.91,
          "en": "And now we can bind this method here to the buttons.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 243.91,
          "end": 246.05,
          "en": "So here upon a click I wanna call",
          "zh": ""
        },
        {
          "id": 86,
          "start": 246.05,
          "end": 250.95,
          "en": "setSelectedComponent and pass in active-goals.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 250.95,
          "end": 254.78,
          "en": "And on the Manage Goals button upon a click,",
          "zh": ""
        },
        {
          "id": 88,
          "start": 254.78,
          "end": 259.04,
          "en": "I will call setSelectedComponent and pass in manage-goals",
          "zh": ""
        },
        {
          "id": 89,
          "start": 261.21,
          "end": 263.733,
          "en": "as a value for the parameter.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 265.16,
          "end": 266.86,
          "en": "So these are now the buttons,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 266.86,
          "end": 269.38,
          "en": "and now that we can change to selected the component,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 269.38,
          "end": 274.1,
          "en": "we can add v-if here on, these two components text",
          "zh": ""
        },
        {
          "id": 93,
          "start": 274.1,
          "end": 276.33,
          "en": "and check if selectedComponent is equal",
          "zh": ""
        },
        {
          "id": 94,
          "start": 276.33,
          "end": 280.65,
          "en": "to active-goals here or here on the second component,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 280.65,
          "end": 284.093,
          "en": "if selectedComponent is equal to manage-goals.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 285.98,
          "end": 287.17,
          "en": "And if I now save that",
          "zh": ""
        },
        {
          "id": 97,
          "start": 288.04,
          "end": 290.90999999999997,
          "en": "we can use this like tabs and we can switch",
          "zh": ""
        },
        {
          "id": 98,
          "start": 290.90999999999997,
          "end": 292.38,
          "en": "between these components.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 292.38,
          "end": 293.69,
          "en": "but that's nothing new.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 293.69,
          "end": 295.67,
          "en": "Here we're only using features",
          "zh": ""
        },
        {
          "id": 101,
          "start": 295.67,
          "end": 297.59000000000003,
          "en": "you already learned about.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 297.59000000000003,
          "end": 299.6,
          "en": "Now, whilst you can build it like this,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 299.6,
          "end": 301.87,
          "en": "if you have more and more components",
          "zh": ""
        },
        {
          "id": 104,
          "start": 301.87,
          "end": 303.73,
          "en": "between which you wanna circle",
          "zh": ""
        },
        {
          "id": 105,
          "start": 303.73,
          "end": 305.69,
          "en": "using v-if all the time",
          "zh": ""
        },
        {
          "id": 106,
          "start": 305.69,
          "end": 308.44,
          "en": "and repeating that v-if code all the time,",
          "zh": ""
        },
        {
          "id": 107,
          "start": 308.44,
          "end": 310.5,
          "en": "is pretty annoying.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 310.5,
          "end": 314.16,
          "en": "That's why Vue has an alternative way of doing that.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 314.16,
          "end": 316.12,
          "en": "So let's comment out this here",
          "zh": ""
        },
        {
          "id": 110,
          "start": 316.12,
          "end": 319.463,
          "en": "and let me introduce dynamic components to you.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 320.71,
          "end": 325.44,
          "en": "Vue offers you a special HTML element which you can use.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 325.44,
          "end": 327.323,
          "en": "The component element.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 328.85,
          "end": 333.22,
          "en": "This is an element, a component provided by Vue.",
          "zh": ""
        },
        {
          "id": 114,
          "start": 333.22,
          "end": 335.33,
          "en": "And the interesting thing is that",
          "zh": ""
        },
        {
          "id": 115,
          "start": 335.33,
          "end": 338.36,
          "en": "this component won't work like this stand alone.",
          "zh": ""
        },
        {
          "id": 116,
          "start": 338.36,
          "end": 340.94,
          "en": "It doesn't show anything on the screen.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 340.94,
          "end": 344.14,
          "en": "Instead, it needs one key property.",
          "zh": ""
        },
        {
          "id": 118,
          "start": 344.14,
          "end": 346.67,
          "en": "And that's the is property.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 346.67,
          "end": 350.04,
          "en": "The is property tells component,",
          "zh": ""
        },
        {
          "id": 120,
          "start": 350.04,
          "end": 353.15,
          "en": "which component of all the components you defined",
          "zh": ""
        },
        {
          "id": 121,
          "start": 353.15,
          "end": 356.18,
          "en": "should be shown in place of this component.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 356.18,
          "end": 359.023,
          "en": "So for example we could set this to active-goals,",
          "zh": ""
        },
        {
          "id": 123,
          "start": 360.05,
          "end": 362.07,
          "en": "but of course we don't wanna hard-code this",
          "zh": ""
        },
        {
          "id": 124,
          "start": 362.07,
          "end": 363.07,
          "en": "because if we did,",
          "zh": ""
        },
        {
          "id": 125,
          "start": 363.07,
          "end": 365.61,
          "en": "we could just use active-goals like that.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 365.61,
          "end": 369.193,
          "en": "If we would always show just that component.",
          "zh": ""
        },
        {
          "id": 127,
          "start": 369.193,
          "end": 371.38,
          "en": "Instead, what we wanna do here",
          "zh": ""
        },
        {
          "id": 128,
          "start": 371.38,
          "end": 375.57,
          "en": "is we wanna bind is dynamically with v-bind",
          "zh": ""
        },
        {
          "id": 129,
          "start": 375.57,
          "end": 377.76,
          "en": "or with the shorthand.",
          "zh": ""
        },
        {
          "id": 130,
          "start": 377.76,
          "end": 380.313,
          "en": "And then in this case point at selectedComponent,",
          "zh": ""
        },
        {
          "id": 131,
          "start": 381.36,
          "end": 385.54,
          "en": "which holds our component HTML tags as values.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 385.54,
          "end": 387.85,
          "en": "It's active-goals initially,",
          "zh": ""
        },
        {
          "id": 133,
          "start": 387.85,
          "end": 389.44,
          "en": "and in our method here,",
          "zh": ""
        },
        {
          "id": 134,
          "start": 389.44,
          "end": 393.12,
          "en": "in the end we switch between active-goals and manage-goals.",
          "zh": ""
        },
        {
