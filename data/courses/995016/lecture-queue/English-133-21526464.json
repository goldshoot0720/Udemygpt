      "cues": [
        {
          "id": 1,
          "start": 2.24,
          "end": 4.55,
          "en": "Attached you find another starting",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.55,
          "end": 7.013,
          "en": "application downloaded, extracted.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.013,
          "end": 10.639,
          "en": "Run, npm install followed by npm run serve",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.639,
          "end": 13.21,
          "en": "and this brings up another Vue app",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.21,
          "end": 14.803,
          "en": "which I prepared for you.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.09,
          "end": 17.84,
          "en": "It's a basic view app.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.84,
          "end": 19.967,
          "en": "This one, where you can",
          "zh": ""
        },
        {
          "id": 8,
          "start": 19.967,
          "end": 21.814,
          "en": "fill out this basic survey,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 21.814,
          "end": 25.03,
          "en": "provide your opinion on this learning experience",
          "zh": ""
        },
        {
          "id": 10,
          "start": 25.03,
          "end": 26.73,
          "en": "and then your data will be saved",
          "zh": ""
        },
        {
          "id": 11,
          "start": 26.73,
          "end": 28.596,
          "en": "and output down there.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 28.596,
          "end": 29.886,
          "en": "This application",
          "zh": ""
        },
        {
          "id": 13,
          "start": 29.886,
          "end": 32.862,
          "en": "uses features we already learned about.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 32.862,
          "end": 34.331,
          "en": "We have",
          "zh": ""
        },
        {
          "id": 15,
          "start": 34.331,
          "end": 37.64,
          "en": "two main components in the App.vue file.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 37.64,
          "end": 40.27,
          "en": "The survey component and the component",
          "zh": ""
        },
        {
          "id": 17,
          "start": 40.27,
          "end": 43.231,
          "en": "which outputs the submitted results in the end.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 43.231,
          "end": 45.27,
          "en": "I'm managing my list of",
          "zh": ""
        },
        {
          "id": 19,
          "start": 45.27,
          "end": 47.954,
          "en": "submitted survey results here in App.vue.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 47.954,
          "end": 50.921,
          "en": "Here I got a method for adding a new result",
          "zh": ""
        },
        {
          "id": 21,
          "start": 50.921,
          "end": 54.06,
          "en": "and the learning survey itself does component",
          "zh": ""
        },
        {
          "id": 22,
          "start": 54.06,
          "end": 57.202,
          "en": "holds this form with an input element,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 57.202,
          "end": 59.88,
          "en": "which is bound with the model",
          "zh": ""
        },
        {
          "id": 24,
          "start": 59.88,
          "end": 61.92,
          "en": "and with a bunch of radio buttons",
          "zh": ""
        },
        {
          "id": 25,
          "start": 61.92,
          "end": 64.208,
          "en": "which are also bound with v-model.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 64.208,
          "end": 66.4,
          "en": "And then this form is managed",
          "zh": ""
        },
        {
          "id": 27,
          "start": 66.4,
          "end": 69.45,
          "en": "just as you learned it in the forms module.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 69.45,
          "end": 70.92,
          "en": "Got a submit method.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 70.92,
          "end": 72.47,
          "en": "I'm validating the input,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 72.47,
          "end": 74.11,
          "en": "showing an error message",
          "zh": ""
        },
        {
          "id": 31,
          "start": 74.974,
          "end": 76.03,
          "en": "here.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 76.03,
          "end": 78.616,
          "en": "If one or more of the input fields are invalid,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 78.616,
          "end": 81.14,
          "en": "a custom event is emitted,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 81.14,
          "end": 83.16,
          "en": "the survey submit event",
          "zh": ""
        },
        {
          "id": 35,
          "start": 83.16,
          "end": 85.735,
          "en": "which holds the entered user name and rating",
          "zh": ""
        },
        {
          "id": 36,
          "start": 85.735,
          "end": 88.053,
          "en": "and that survey submit event",
          "zh": ""
        },
        {
          "id": 37,
          "start": 88.053,
          "end": 89.386,
          "en": "is then caught in",
          "zh": ""
        },
        {
          "id": 38,
          "start": 89.386,
          "end": 91.99,
          "en": "App.vue.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 91.99,
          "end": 94.7,
          "en": "Here on the learning survey component",
          "zh": ""
        },
        {
          "id": 40,
          "start": 94.7,
          "end": 97.89,
          "en": "and that then triggers the store survey method",
          "zh": ""
        },
        {
          "id": 41,
          "start": 97.89,
          "end": 100.65899999999999,
          "en": "where this survey data is enriched with an Id",
          "zh": ""
        },
        {
          "id": 42,
          "start": 100.65899999999999,
          "end": 102.337,
          "en": "and then stored in (mumbles).",
          "zh": ""
        },
        {
          "id": 43,
          "start": 103.655,
          "end": 107.05799999999999,
          "en": "And then we have the user experience's component.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 107.05799999999999,
          "end": 109.03999999999999,
          "en": "That's this component here,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 109.03999999999999,
          "end": 110.62,
          "en": "which simply outputs all",
          "zh": ""
        },
        {
          "id": 46,
          "start": 110.62,
          "end": 113.559,
          "en": "submitted survey results with v-for.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 113.559,
          "end": 115.64699999999999,
          "en": "I got another component in here,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 115.64699999999999,
          "end": 117.78999999999999,
          "en": "the survey result component,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 117.78999999999999,
          "end": 119.97,
          "en": "which is just responsible for outputting",
          "zh": ""
        },
        {
          "id": 50,
          "start": 119.97,
          "end": 121.98,
          "en": "the individual list items.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 121.98,
          "end": 124.14,
          "en": "Got some conditional styles in there,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 124.14,
          "end": 126.248,
          "en": "some conditional CSS classes.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 126.248,
          "end": 129.423,
          "en": "And overall, this is nothing too fancy.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 130.53,
          "end": 131.363,
          "en": "Now of course,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 131.363,
          "end": 133.55,
          "en": "this application has one problem.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 133.55,
          "end": 135.77100000000002,
          "en": "If I submit a bunch of data here,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 135.77100000000002,
          "end": 137.8,
          "en": "we see all that data here,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 137.8,
          "end": 140,
          "en": "but whenever we reload the page,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 140,
          "end": 141.504,
          "en": "all the data is lost.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 141.504,
          "end": 143.52,
          "en": "And this is not a bug,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 143.52,
          "end": 146.3,
          "en": "this is, well, the only way it can behave",
          "zh": ""
        },
        {
          "id": 62,
          "start": 146.3,
          "end": 147.95,
          "en": "because thus far,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 147.95,
          "end": 151.441,
          "en": "we always stored all the data just in Vue",
          "zh": ""
        },
        {
          "id": 64,
          "start": 151.441,
          "end": 154.61,
          "en": "and therefore just in the computer memory,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 154.61,
          "end": 156.18,
          "en": "that is what happened here.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 156.18,
          "end": 157.81,
          "en": "So all the data we create",
          "zh": ""
        },
        {
          "id": 67,
          "start": 157.81,
          "end": 159.34,
          "en": "with all those components",
          "zh": ""
        },
        {
          "id": 68,
          "start": 159.34,
          "end": 161.212,
          "en": "is just stored locally",
          "zh": ""
        },
        {
          "id": 69,
          "start": 161.212,
          "end": 163.587,
          "en": "in memory and therefore lost",
          "zh": ""
        },
        {
          "id": 70,
          "start": 163.587,
          "end": 166.44,
          "en": "whenever this website is reloaded",
          "zh": ""
        },
        {
          "id": 71,
          "start": 166.44,
          "end": 168.292,
          "en": "therefore the Vue app is dumped",
          "zh": ""
        },
        {
          "id": 72,
          "start": 168.292,
          "end": 171.28,
          "en": "and a new instance of the Vue app starts up",
          "zh": ""
        },
        {
          "id": 73,
          "start": 171.28,
          "end": 173.44,
          "en": "and therefore all the data attached",
          "zh": ""
        },
        {
          "id": 74,
          "start": 173.44,
          "end": 175.923,
          "en": "to the previously running Vue app is lost.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 177.02,
          "end": 179.19,
          "en": "This is just how browsers work.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 179.19,
          "end": 181.542,
          "en": "There's nothing you can do about that.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 181.542,
          "end": 183.215,
          "en": "But of course, in reality,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 183.215,
          "end": 185.554,
          "en": "you are often building applications",
          "zh": ""
        },
        {
          "id": 79,
          "start": 185.554,
          "end": 188.28,
          "en": "where data should be saved",
          "zh": ""
        },
        {
          "id": 80,
          "start": 188.28,
          "end": 190.16,
          "en": "and where it may be",
          "zh": ""
        },
        {
          "id": 81,
          "start": 190.16,
          "end": 192.329,
          "en": "should not just be saved locally",
          "zh": ""
        },
        {
          "id": 82,
          "start": 192.329,
          "end": 194.578,
          "en": "on the computer of your user",
          "zh": ""
        },
        {
          "id": 83,
          "start": 194.578,
          "end": 197.696,
          "en": "for example, in a file or anything like that",
          "zh": ""
        },
        {
          "id": 84,
          "start": 197.696,
          "end": 200.09,
          "en": "but instead where it should be stored",
          "zh": ""
        },
        {
          "id": 85,
          "start": 200.09,
          "end": 203.434,
          "en": "on a server, which you, as the developer own.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 203.434,
          "end": 206.377,
          "en": "Think of Amazon.com.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 206.377,
          "end": 208.785,
          "en": "All the products which are listed there,",
          "zh": ""
        },
        {
          "id": 88,
          "start": 208.785,
          "end": 210.22,
          "en": "they are of course,",
          "zh": ""
        },
        {
          "id": 89,
          "start": 210.22,
          "end": 212.59,
          "en": "stored on Amazon's servers",
          "zh": ""
        },
        {
          "id": 90,
          "start": 212.59,
          "end": 215.429,
          "en": "and shown to the users that visit Amazon.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 215.429,
          "end": 217.26,
          "en": "So it is quite common that you",
          "zh": ""
        },
        {
          "id": 92,
          "start": 217.26,
          "end": 219.6,
          "en": "need a server that holds data",
          "zh": ""
        },
        {
          "id": 93,
          "start": 219.6,
          "end": 221.89,
          "en": "and then the Vue applications running",
          "zh": ""
        },
        {
          "id": 94,
          "start": 221.89,
          "end": 223.97,
          "en": "on the computers of your users,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 223.97,
          "end": 226.2,
          "en": "running in the browsers of your users.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 226.2,
          "end": 228.77,
          "en": "Those Vue applications should connect",
          "zh": ""
        },
        {
          "id": 97,
          "start": 228.77,
          "end": 231.564,
          "en": "to your servers and fetch data from there",
          "zh": ""
        },
        {
          "id": 98,
          "start": 231.564,
          "end": 234.67000000000002,
          "en": "or send data to them.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 234.67000000000002,
          "end": 237.56,
          "en": "So here this survey application, for example,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 237.56,
          "end": 239.09,
          "en": "should probably not just",
          "zh": ""
        },
        {
          "id": 101,
          "start": 239.09,
          "end": 241.37,
          "en": "output survey results down there,",
          "zh": ""
        },
        {
          "id": 102,
          "start": 241.37,
          "end": 243.71,
          "en": "but instead the data should also be submitted",
          "zh": ""
        },
        {
          "id": 103,
          "start": 243.71,
          "end": 246.123,
          "en": "to your server where it's saved.",
          "zh": ""
        },
        {
          "id": 104,
          "start": 246.96,
          "end": 249.22,
          "en": "In a reality, this year might even",
          "zh": ""
        },
        {
          "id": 105,
          "start": 249.22,
          "end": 251.86,
          "en": "be two separate Vue applications",
          "zh": ""
        },
        {
          "id": 106,
          "start": 251.86,
          "end": 253.393,
          "en": "where the survey form",
          "zh": ""
        },
        {
          "id": 107,
          "start": 253.393,
          "end": 256.359,
          "en": "is the application you show to your users",
          "zh": ""
        },
        {
          "id": 108,
          "start": 256.359,
          "end": 258.447,
          "en": "and this dashboard here",
          "zh": ""
        },
        {
          "id": 109,
          "start": 258.447,
          "end": 261.1,
          "en": "where you see the submitted surveys.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 261.1,
          "end": 264.163,
          "en": "That might be a Vue application only you can visit.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 265.67,
          "end": 267.36,
          "en": "But here it's merged into one so",
          "zh": ""
        },
        {
          "id": 112,
          "start": 267.36,
          "end": 269.14,
          "en": "that we can see both in action.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 269.14,
          "end": 271.53,
          "en": "Nonetheless, we typically want a server",
          "zh": ""
        },
        {
          "id": 114,
          "start": 271.53,
          "end": 273.433,
          "en": "to which we can send our data.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 274.56,
          "end": 277.07,
          "en": "And that's exactly what a back end is.",
          "zh": ""
        },
        {
          "id": 116,
          "start": 277.07,
          "end": 278.46,
          "en": "It's the other end.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 278.46,
          "end": 280.73,
          "en": "It's the part that does not run",
          "zh": ""
        },
        {
          "id": 118,
          "start": 280.73,
          "end": 282.57,
          "en": "in the browser of your users",
          "zh": ""
        },
        {
          "id": 119,
          "start": 282.57,
          "end": 284.15,
          "en": "like your Vue app does",
          "zh": ""
        },
        {
          "id": 120,
          "start": 284.15,
          "end": 287.4,
          "en": "but instead it's about code running on a server,",
          "zh": ""
        },
        {
          "id": 121,
          "start": 287.4,
          "end": 289.18,
          "en": "you as a developer own.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 289.18,
          "end": 291.08,
          "en": "It's about a database you",
          "zh": ""
        },
        {
          "id": 123,
          "start": 291.08,
          "end": 292.68,
          "en": "as a developer might own.",
          "zh": ""
        },
        {
          "id": 124,
          "start": 292.68,
          "end": 295.256,
          "en": "And that database would also be",
          "zh": ""
        },
        {
          "id": 125,
          "start": 295.256,
          "end": 297.097,
          "en": "on that server which you own.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 297.097,
          "end": 298.78,
          "en": "So it's detached from the Vue app.",
          "zh": ""
        },
        {
          "id": 127,
          "start": 298.78,
          "end": 300.713,
          "en": "Nonetheless, we want to communicate,",
          "zh": ""
        },
        {
          "id": 128,
          "start": 301.692,
          "end": 303.363,
          "en": "and that's what this module is about.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
