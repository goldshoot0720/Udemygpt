  "lectures": [
    {
      "id": "21879328",
      "title": "Navigating with router-link",
      "lectureOrder": 171,
      "videoOrder": 148,
      "sourceHash": "38f1e51784624df59ed7e96adcce77034249deaac3f4091588f8d0fdb3905226",
      "cues": [
        {
          "id": 1,
          "start": 2.389,
          "end": 4.32,
          "en": "(Narrator)So now with our routes registered,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.32,
          "end": 6.47,
          "en": "let's make sure we can also reach those routes",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.47,
          "end": 8.96,
          "en": "from inside our application.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.96,
          "end": 12.61,
          "en": "And we got this that navigation.vue file",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.61,
          "end": 14.55,
          "en": "where I got two buttons,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.55,
          "end": 16.42,
          "en": "where I emit a custom event",
          "zh": ""
        },
        {
          "id": 7,
          "start": 16.42,
          "end": 19.73,
          "en": "to which I previously listened to hear in an app view.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 19.73,
          "end": 21.12,
          "en": "I'm still listening to it.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 21.12,
          "end": 24.4,
          "en": "But actually, now we're not going to navigate like this,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 24.4,
          "end": 27.57,
          "en": "we now don't need to manage manually",
          "zh": ""
        },
        {
          "id": 11,
          "start": 27.57,
          "end": 29.8,
          "en": "which page should be loaded,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 29.8,
          "end": 33.83,
          "en": "we can get rid of the active page data property in app view,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 33.83,
          "end": 36.87,
          "en": "we can get rid of this event listener here",
          "zh": ""
        },
        {
          "id": 14,
          "start": 36.87,
          "end": 40.51,
          "en": "on then navigation, and therefore we can also get rid",
          "zh": ""
        },
        {
          "id": 15,
          "start": 40.51,
          "end": 44.41,
          "en": "of this set active page method here of course,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 44.41,
          "end": 47.403,
          "en": "we can get rid of the entire methods block therefore.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 48.41,
          "end": 52.52,
          "en": "In the navigation we no longer emit set page",
          "zh": ""
        },
        {
          "id": 18,
          "start": 54.4,
          "end": 58.42,
          "en": "and we therefore no longer have to set active page method",
          "zh": ""
        },
        {
          "id": 19,
          "start": 58.42,
          "end": 60.97,
          "en": "and we can hence get rid of the entire methods here.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 60.97,
          "end": 63.254,
          "en": "And therefore actually, we can get rid of",
          "zh": ""
        },
        {
          "id": 21,
          "start": 63.254,
          "end": 64.1,
          "en": "of the entire script block since",
          "zh": ""
        },
        {
          "id": 22,
          "start": 64.1,
          "end": 67.75,
          "en": "we got no specific component configuration in there anyways",
          "zh": ""
        },
        {
          "id": 23,
          "start": 69.26,
          "end": 71.71000000000001,
          "en": "Instead, we'll now navigate differently",
          "zh": ""
        },
        {
          "id": 24,
          "start": 71.71000000000001,
          "end": 73.7,
          "en": "and will not use a button anymore,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 73.7,
          "end": 76.846,
          "en": "instead we will use another built-in component that comes",
          "zh": ""
        },
        {
          "id": 26,
          "start": 76.846,
          "end": 79.4,
          "en": "with the view router.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 79.4,
          "end": 83.71000000000001,
          "en": "And that is the router link component.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 83.71000000000001,
          "end": 87.72,
          "en": "It's a little bit like the built-in anchor tag,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 87.72,
          "end": 89.92,
          "en": "HTML element, you could say,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 89.92,
          "end": 92.33,
          "en": "but it's a special anchor tag,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 92.33,
          "end": 93.68,
          "en": "A special anchor tag,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 93.68,
          "end": 97.00999999999999,
          "en": "which actually will not load a different page",
          "zh": ""
        },
        {
          "id": 33,
          "start": 97.00999999999999,
          "end": 98.005,
          "en": "and reload the entire app,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 98.005,
          "end": 100.63,
          "en": "and hence loose the current state.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 100.63,
          "end": 104.28,
          "en": "But instead a special anchor tag where the browser default",
          "zh": ""
        },
        {
          "id": 36,
          "start": 104.28,
          "end": 106.72,
          "en": "of loading a different page is prevented.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 106.72,
          "end": 109.3,
          "en": "and instead, the view router takes over,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 109.3,
          "end": 111.717,
          "en": "analyzes the link the user clicked",
          "zh": ""
        },
        {
          "id": 39,
          "start": 111.717,
          "end": 114.41,
          "en": "and that downloads the appropriate component",
          "zh": ""
        },
        {
          "id": 40,
          "start": 114.41,
          "end": 115.443,
          "en": "and updates the URL.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 116.4,
          "end": 119.66,
          "en": "Things like that are handled by router link.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 119.66,
          "end": 122.44,
          "en": "You can still pass your text between there,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 122.44,
          "end": 125.305,
          "en": "you can actually pass any HTML element in there,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 125.305,
          "end": 128.01,
          "en": "which you might need because",
          "zh": ""
        },
        {
          "id": 45,
          "start": 128.01,
          "end": 130.85,
          "en": "router link internally uses slots.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 130.85,
          "end": 133.24,
          "en": "But here I just want some text.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 133.24,
          "end": 136.43,
          "en": "And now of course, we need to configure router link.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 136.43,
          "end": 140.46,
          "en": "And the most important configuration here is the to prop,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 140.46,
          "end": 142.01,
          "en": "which it expects.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 142.01,
          "end": 145.49,
          "en": "The to prop takes various different values.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 145.49,
          "end": 148.95,
          "en": "and the simple way of using it is to provide a string to it",
          "zh": ""
        },
        {
          "id": 52,
          "start": 148.95,
          "end": 151.11,
          "en": "which holds the path you want to go to.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 151.11,
          "end": 154.04,
          "en": "So in this case, slash teams.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 154.04,
          "end": 156.2,
          "en": "So of course, that should be one of the routes",
          "zh": ""
        },
        {
          "id": 55,
          "start": 156.2,
          "end": 159.423,
          "en": "you are supporting in your routes configuration.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 161.25,
          "end": 163.07999999999998,
          "en": "And that's already all then",
          "zh": ""
        },
        {
          "id": 57,
          "start": 163.07999999999998,
          "end": 165.47,
          "en": "we can also replace the second button",
          "zh": ""
        },
        {
          "id": 58,
          "start": 165.47,
          "end": 167.98,
          "en": "with such a router link.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 167.98,
          "end": 171.26,
          "en": "Here, I want to go to my users,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 171.26,
          "end": 173.863,
          "en": "and hence the two probe points at users.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 175.46,
          "end": 177.82999999999998,
          "en": "Now we'll get some problems with styling here",
          "zh": ""
        },
        {
          "id": 62,
          "start": 177.82999999999998,
          "end": 179.53,
          "en": "because previously I used a button",
          "zh": ""
        },
        {
          "id": 63,
          "start": 179.53,
          "end": 181.337,
          "en": "now it's a Link hence I will replace the",
          "zh": ""
        },
        {
          "id": 64,
          "start": 181.337,
          "end": 185.76,
          "en": "button CSS selector down there with an anchor tag,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 185.76,
          "end": 189.17,
          "en": "because router link under the hood will render",
          "zh": ""
        },
        {
          "id": 66,
          "start": 189.17,
          "end": 192.683,
          "en": "an anchor tag so we can style an anchor tag here,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 194.36,
          "end": 198.19,
          "en": "and I'll delete this font CSS property.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 198.19,
          "end": 199.84,
          "en": "Keep the rest though,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 199.84,
          "end": 202.99,
          "en": "and also replace button hover and button active",
          "zh": ""
        },
        {
          "id": 70,
          "start": 202.99,
          "end": 206.61,
          "en": "with an anchor tag,also add a new CSS property",
          "zh": ""
        },
        {
          "id": 71,
          "start": 206.61,
          "end": 211.213,
          "en": "to the anchor tag rule here and set text decoration to none.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 214.44,
          "end": 218.68,
          "en": "With that styling updated, if we save this and reload,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 218.68,
          "end": 221.21,
          "en": "we get the same buttons as before,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 221.21,
          "end": 223.28,
          "en": "but now these are actually links",
          "zh": ""
        },
        {
          "id": 75,
          "start": 223.28,
          "end": 224.8,
          "en": "and if we click them,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 224.8,
          "end": 228,
          "en": "we switch between these different routes.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 228,
          "end": 230.04,
          "en": "And if we inspect these elements,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 230.04,
          "end": 233.06,
          "en": "we see what I just explained in theory.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 233.06,
          "end": 234.98,
          "en": "We got anchor tax here,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 234.98,
          "end": 237.29,
          "en": "which has href attribute but",
          "zh": ""
        },
        {
          "id": 81,
          "start": 237.29,
          "end": 241.37,
          "en": "this router link component actually makes sure that,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 241.37,
          "end": 243.43,
          "en": "the browser default is prevented,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 243.43,
          "end": 245.54,
          "en": "and the browser doesn't really try",
          "zh": ""
        },
        {
          "id": 84,
          "start": 245.54,
          "end": 248.32,
          "en": "to load a different HTML file.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 248.32,
          "end": 250.98,
          "en": "But instead, the router then analyzes",
          "zh": ""
        },
        {
          "id": 86,
          "start": 250.98,
          "end": 253.15,
          "en": "the value in the ref attribute",
          "zh": ""
        },
        {
          "id": 87,
          "start": 253.15,
          "end": 255.22,
          "en": "and checks your routing config",
          "zh": ""
        },
        {
          "id": 88,
          "start": 255.22,
          "end": 257.58,
          "en": "to find the appropriate view component",
          "zh": ""
        },
        {
          "id": 89,
          "start": 257.58,
          "end": 258.68,
          "en": "that should be loaded.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 259.53,
          "end": 263.28,
          "en": "In addition, you see that some CSS classes were added here,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 263.28,
          "end": 266.94,
          "en": "router link active and router link exact active.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 266.94,
          "end": 269.83,
          "en": "And we only have this on teams at the moment.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 269.83,
          "end": 271.219,
          "en": "If I inspect the upper list item,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 271.219,
          "end": 273.77,
          "en": "we don't have the classes there.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 273.77,
          "end": 277.32,
          "en": "These classes are added automatically by view router",
          "zh": ""
        },
        {
          "id": 96,
          "start": 277.32,
          "end": 279.71,
          "en": "on the link which is currently selected.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 279.71,
          "end": 282.01,
          "en": "So for the route that's currently active,",
          "zh": ""
        },
        {
          "id": 98,
          "start": 282.01,
          "end": 285.07,
          "en": "so that you can actually style these links based",
          "zh": ""
        },
        {
          "id": 99,
          "start": 285.07,
          "end": 288.2,
          "en": "on the selection to give the user a feedback",
          "zh": ""
        },
        {
          "id": 100,
          "start": 288.2,
          "end": 291.38,
          "en": "regarding the route he or she is currently on.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 291.38,
          "end": 292.61,
          "en": "Now, that's something we're going",
          "zh": ""
        },
        {
          "id": 102,
          "start": 292.61,
          "end": 293.803,
          "en": "to explore next.",
          "zh": ""
        }
      ]
    }
  ],
