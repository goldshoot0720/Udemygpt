  "courseTitle": "Vue - The Complete Guide (incl. Router & Composition API)",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "21526478",
      "title": "Getting Data (GET Request) & Transforming Response Data",
      "lectureOrder": 159,
      "videoOrder": 137,
      "sourceHash": "13d8fca48477ea0c002c33945a456e3c57b3dd251ae3640da03c51a2b051c732",
      "cues": [
        {
          "id": 1,
          "start": 2.26,
          "end": 4.21,
          "en": "We now wanna get the data",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.21,
          "end": 7.01,
          "en": "that is stored on this server.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.01,
          "end": 9.15,
          "en": "And for that I wanna connect this load",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.15,
          "end": 11.47,
          "en": "submitted experiences button.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.47,
          "end": 14.49,
          "en": "So in the UserExperiences component,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.49,
          "end": 17.03,
          "en": "we previously received results as a prop.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.03,
          "end": 19.13,
          "en": "That will no longer be the case,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 19.13,
          "end": 20.87,
          "en": "so we can remove that.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 20.87,
          "end": 21.92,
          "en": "Instead now,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 21.92,
          "end": 23.99,
          "en": "I wanna manage some data in here",
          "zh": ""
        },
        {
          "id": 11,
          "start": 24.87,
          "end": 27.903,
          "en": "and have my results as a data key.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 28.87,
          "end": 30.62,
          "en": "And initially, it's an empty array.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 32.04,
          "end": 34.98,
          "en": "Now, I also wanna add some methods here though,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 34.98,
          "end": 37.72,
          "en": "or one method to be precise,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 37.72,
          "end": 39.51,
          "en": "a method that should be triggered",
          "zh": ""
        },
        {
          "id": 16,
          "start": 39.51,
          "end": 41.053,
          "en": "when this button is clicked.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 42.6,
          "end": 44.54,
          "en": "So here, I wanna add a click",
          "zh": ""
        },
        {
          "id": 18,
          "start": 44.54,
          "end": 46.78,
          "en": "listener to the space button",
          "zh": ""
        },
        {
          "id": 19,
          "start": 46.78,
          "end": 50.033,
          "en": "and trigger the LoadExperiences method.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 52,
          "end": 54.32,
          "en": "Now that's a method we need to add now.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 54.32,
          "end": 56.94,
          "en": "So make sure you add it under that same name",
          "zh": ""
        },
        {
          "id": 22,
          "start": 56.94,
          "end": 57.863,
          "en": "to methods,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 58.76,
          "end": 60.04,
          "en": "and in here",
          "zh": ""
        },
        {
          "id": 24,
          "start": 60.04,
          "end": 63.18,
          "en": "we now wanna send another HTTP request",
          "zh": ""
        },
        {
          "id": 25,
          "start": 63.18,
          "end": 66.39,
          "en": "to the server we previously sent our data to.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 66.39,
          "end": 68.333,
          "en": "But now to get data.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 69.62,
          "end": 72.53,
          "en": "For that, we can of course copy this request",
          "zh": ""
        },
        {
          "id": 28,
          "start": 72.53,
          "end": 74.56,
          "en": "from Learning Survey.vue,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 74.56,
          "end": 77.623,
          "en": "and bring it over to this new LoadExperiences method.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 78.84,
          "end": 82.3,
          "en": "Now here, I wanna send a request to this same address,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 82.3,
          "end": 84.5,
          "en": "which i used for storing the data.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 84.5,
          "end": 86.81,
          "en": "But now it should be a GET request",
          "zh": ""
        },
        {
          "id": 33,
          "start": 86.81,
          "end": 88.18,
          "en": "instead of a POST request,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 88.18,
          "end": 89.703,
          "en": "because you wanna get data.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 91.03,
          "end": 91.92,
          "en": "The good thing is,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 91.92,
          "end": 93.16,
          "en": "that would be the default,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 93.16,
          "end": 95.42,
          "en": "so we don't even need to set this.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 95.42,
          "end": 96.9,
          "en": "Now since we're getting data",
          "zh": ""
        },
        {
          "id": 39,
          "start": 96.9,
          "end": 99.41,
          "en": "we'll also not have any body.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 99.41,
          "end": 101.22,
          "en": "So we can remove that as well,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 101.22,
          "end": 104.543,
          "en": "because a GET request does not carry any data.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 105.93,
          "end": 107.63,
          "en": "And now here for the headers,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 107.63,
          "end": 108.75999999999999,
          "en": "since there is no body",
          "zh": ""
        },
        {
          "id": 44,
          "start": 108.75999999999999,
          "end": 110.32300000000001,
          "en": "we also don't need the headers.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 111.38,
          "end": 113.4,
          "en": "So we have a empty conflict object",
          "zh": ""
        },
        {
          "id": 46,
          "start": 113.4,
          "end": 116.87,
          "en": "and therefore we are also allowed to delete it.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 116.87,
          "end": 119.663,
          "en": "This will now send a request to get the data.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 120.74,
          "end": 122.79,
          "en": "But we'll face a problem with that.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 122.79,
          "end": 124.665,
          "en": "When we send this request,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 124.665,
          "end": 127.2,
          "en": "how do we get access to the data",
          "zh": ""
        },
        {
          "id": 51,
          "start": 127.2,
          "end": 128.963,
          "en": "that will eventually be loaded?",
          "zh": ""
        },
        {
          "id": 52,
          "start": 130.44,
          "end": 134.07,
          "en": "Well, fetch returns a so called promise.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 134.07,
          "end": 135.13,
          "en": "Now, what's a promise?",
          "zh": ""
        },
        {
          "id": 54,
          "start": 135.13,
          "end": 137.77,
          "en": "And why do we need that?",
          "zh": ""
        },
        {
          "id": 55,
          "start": 137.77,
          "end": 139.2,
          "en": "Well as I just said,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 139.2,
          "end": 141.76,
          "en": "the data will be loaded eventually.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 141.76,
          "end": 142.89,
          "en": "As you can imagine,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 142.89,
          "end": 145.27,
          "en": "if you're sending an HTTP request,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 145.27,
          "end": 149.16,
          "en": "that can take a couple of milliseconds or seconds.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 149.16,
          "end": 151.09,
          "en": "Firebase is super fast",
          "zh": ""
        },
        {
          "id": 61,
          "start": 151.09,
          "end": 153.4,
          "en": "and my local internet is pretty fast",
          "zh": ""
        },
        {
          "id": 62,
          "start": 153.4,
          "end": 155.1,
          "en": "so it should be pretty quick.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 155.1,
          "end": 159.1,
          "en": "But still, it might take 100 200 500 milliseconds",
          "zh": ""
        },
        {
          "id": 64,
          "start": 159.1,
          "end": 161.32,
          "en": "for the data to arrive.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 161.32,
          "end": 163.62,
          "en": "And JavaScript is a language",
          "zh": ""
        },
        {
          "id": 66,
          "start": 163.62,
          "end": 168.05,
          "en": "that will not pause and wait with the other code execution",
          "zh": ""
        },
        {
          "id": 67,
          "start": 168.05,
          "end": 170.37,
          "en": "until that result is there.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 170.37,
          "end": 171.203,
          "en": "That is good,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 171.203,
          "end": 173.258,
          "en": "because it would mean if it would pause",
          "zh": ""
        },
        {
          "id": 70,
          "start": 173.258,
          "end": 176.51,
          "en": "that our web apps would freeze all the time",
          "zh": ""
        },
        {
          "id": 71,
          "start": 176.51,
          "end": 179.72,
          "en": "waiting for some behind the scenes HTTP requests",
          "zh": ""
        },
        {
          "id": 72,
          "start": 179.72,
          "end": 180.583,
          "en": "to finish.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 181.5,
          "end": 183.53,
          "en": "So that's the idea behind promises.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 183.53,
          "end": 185.76,
          "en": "Fetch returns an object",
          "zh": ""
        },
        {
          "id": 75,
          "start": 185.76,
          "end": 188.16,
          "en": "on which we can listen for the data",
          "zh": ""
        },
        {
          "id": 76,
          "start": 188.16,
          "end": 189.47,
          "en": "once it is there,",
          "zh": ""
        },
        {
          "id": 77,
          "start": 189.47,
          "end": 190.89,
          "en": "to then set up code",
          "zh": ""
        },
        {
          "id": 78,
          "start": 190.89,
          "end": 194.24,
          "en": "that will be executed when that data is there.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 194.24,
          "end": 197.91,
          "en": "And we set up such a listener by adding a then method here",
          "zh": ""
        },
        {
          "id": 80,
          "start": 197.91,
          "end": 200.183,
          "en": "on the result of fetch.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 201.49,
          "end": 202.74,
          "en": "The then method",
          "zh": ""
        },
        {
          "id": 82,
          "start": 202.74,
          "end": 204.41,
          "en": "takes a function",
          "zh": ""
        },
        {
          "id": 83,
          "start": 204.41,
          "end": 207.36,
          "en": "which will be executed once the result is there.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 207.36,
          "end": 209.07999999999998,
          "en": "It will be executed automatically",
          "zh": ""
        },
        {
          "id": 85,
          "start": 209.07999999999998,
          "end": 212.34,
          "en": "by the browser once the data is there.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 212.34,
          "end": 213.173,
          "en": "And in here,",
          "zh": ""
        },
        {
          "id": 87,
          "start": 213.173,
          "end": 215.11,
          "en": "we'll also get an argument automatically",
          "zh": ""
        },
        {
          "id": 88,
          "start": 215.11,
          "end": 218.07,
          "en": "and that will be the response of this request.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 218.07,
          "end": 221.913,
          "en": "So the response sent back by the server to the browser.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 223.17000000000002,
          "end": 225.57999999999998,
          "en": "Now here we can then work with that response",
          "zh": ""
        },
        {
          "id": 91,
          "start": 225.57999999999998,
          "end": 228.063,
          "en": "and try to parse it.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 228.063,
          "end": 231.81,
          "en": "It can for example check if the response is okay.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 231.81,
          "end": 233.24,
          "en": "This response object",
          "zh": ""
        },
        {
          "id": 94,
          "start": 233.24,
          "end": 235.3,
          "en": "which we get automatically by the browser",
          "zh": ""
        },
        {
          "id": 95,
          "start": 235.3,
          "end": 236.977,
          "en": "has an okay property",
          "zh": ""
        },
        {
          "id": 96,
          "start": 236.977,
          "end": 240.96,
          "en": "that indicates whether it was a successful request or not.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 240.96,
          "end": 241.8,
          "en": "So for example,",
          "zh": ""
        },
        {
          "id": 98,
          "start": 241.8,
          "end": 245.01,
          "en": "if the server sends back a 404 code,",
          "zh": ""
        },
        {
          "id": 99,
          "start": 245.01,
          "end": 246.433,
          "en": "this would not be okay.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 247.4,
          "end": 248.76,
          "en": "If it is okay however,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 248.76,
          "end": 250.87,
          "en": "we can continue with the response",
          "zh": ""
        },
        {
          "id": 102,
          "start": 250.87,
          "end": 253.78,
          "en": "and try to read the data that's in there.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 253.78,
          "end": 257.56,
          "en": "For that the response has various methods.",
          "zh": ""
        },
        {
          "id": 104,
          "start": 257.56,
          "end": 260.79,
          "en": "For example, it has a JSON method, which we can call,",
          "zh": ""
        },
        {
          "id": 105,
          "start": 260.79,
          "end": 263.19,
          "en": "which will parse the data",
          "zh": ""
        },
        {
          "id": 106,
          "start": 263.19,
          "end": 266.413,
          "en": "that's part of the response if it's in JSON format.",
          "zh": ""
        },
        {
          "id": 107,
          "start": 267.41,
          "end": 271.51,
          "en": "And JSON is the de facto standard for exchanging data.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 271.51,
          "end": 275.82,
          "en": "And therefore, not only do we send data in JSON format,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 275.82,
          "end": 277.82,
          "en": "when we send the request,",
          "zh": ""
        },
        {
          "id": 110,
          "start": 277.82,
          "end": 281.36,
          "en": "Firebase also replies with JSON data",
          "zh": ""
        },
        {
          "id": 111,
          "start": 281.36,
          "end": 283.09000000000003,
          "en": "when we get data from it.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 283.09000000000003,
          "end": 284.14,
          "en": "So the JSON method",
          "zh": ""
        },
        {
          "id": 113,
          "start": 284.14,
          "end": 285.71,
          "en": "is the method we wanna use",
          "zh": ""
        },
        {
          "id": 114,
          "start": 285.71,
          "end": 288.913,
          "en": "for parsing the data that's part of the response.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 290.24,
          "end": 293.90999999999997,
          "en": "Now, this also turns out to yield a promise.",
          "zh": ""
        },
        {
          "id": 116,
          "start": 293.90999999999997,
          "end": 295.95,
          "en": "And therefore what we can do here",
          "zh": ""
        },
        {
          "id": 117,
          "start": 295.95,
          "end": 298.77,
          "en": "inside of such a then block here,",
          "zh": ""
        },
        {
          "id": 118,
          "start": 298.77,
          "end": 303.77,
          "en": "is we can return this response JSON call here.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 303.9,
          "end": 307.33,
          "en": "So we can return the promise yielded by that.",
          "zh": ""
        },
        {
          "id": 120,
          "start": 307.33,
          "end": 309.76,
          "en": "And we can add another then method",
          "zh": ""
        },
        {
          "id": 121,
          "start": 309.76,
          "end": 311.95,
          "en": "after the first then method.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 311.95,
          "end": 314.83,
          "en": "And this then method will be triggered",
          "zh": ""
        },
        {
          "id": 123,
          "start": 314.83,
          "end": 317.08299999999997,
          "en": "when this return promise is done.",
          "zh": ""
        },
        {
          "id": 124,
          "start": 318.2,
          "end": 320.18,
          "en": "So here we have another function,",
          "zh": ""
        },
        {
          "id": 125,
          "start": 320.18,
          "end": 322.72,
          "en": "but here we'll get the actual data,",
          "zh": ""
        },
        {
          "id": 126,
          "start": 322.72,
          "end": 324.993,
          "en": "which response JSON yielded.",
          "zh": ""
        },
        {
          "id": 127,
          "start": 326.73,
          "end": 330.17,
          "en": "And that's now the place where we have access to the data.",
          "zh": ""
        },
        {
          "id": 128,
          "start": 330.17,
          "end": 331.77,
          "en": "And therefore here for the moment,",
          "zh": ""
        },
        {
          "id": 129,
          "start": 331.77,
          "end": 333.063,
          "en": "I will just log it.",
          "zh": ""
        },
        {
          "id": 130,
          "start": 335.65999999999997,
          "end": 338.43,
          "en": "We'll take care about error handling later,",
          "zh": ""
        },
        {
          "id": 131,
          "start": 338.43,
          "end": 341.86,
          "en": "for the moment let's just see if we can get that data.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 341.86,
          "end": 343.58,
          "en": "So let's save everything.",
          "zh": ""
        },
        {
          "id": 133,
          "start": 343.58,
          "end": 346.14,
          "en": "Open up the developer tools,",
          "zh": ""
        },
        {
          "id": 134,
          "start": 346.14,
          "end": 346.973,
          "en": "reload,",
          "zh": ""
        },
        {
          "id": 135,
          "start": 347.87,
          "end": 350.253,
          "en": "and click Load submitted experiences.",
          "zh": ""
        },
        {
          "id": 136,
          "start": 351.1,
          "end": 354.13,
          "en": "And after half a second or a second,",
          "zh": ""
        },
        {
          "id": 137,
          "start": 354.13,
          "end": 356.55,
