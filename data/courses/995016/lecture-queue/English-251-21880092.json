        },
        {
          "id": 43,
          "start": 133.29,
          "end": 137.71,
          "en": "in package.json, you find all the scripts you can execute.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 137.71,
          "end": 141.05,
