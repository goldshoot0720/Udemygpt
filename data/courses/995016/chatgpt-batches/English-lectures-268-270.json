      "videoOrder": 240,
      "sourceHash": "87dca5f54c9763a908820e323176f29c222e9c18318328d0ada0deedf84c2e2c",
      "cues": [
        {
          "id": 1,
          "start": 2.09,
          "end": 3.88,
          "en": "So, to make \"Log in\" work,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.88,
          "end": 6.2,
          "en": "we can go back to our Vuex actions.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.2,
          "end": 8.72,
          "en": "And here, the \"Login\" action.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.72,
          "end": 10.12,
          "en": "We can already add \"Async.\"",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.12,
          "end": 13.03,
          "en": "Because, we will definitely also send that HTTP request",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.03,
          "end": 14.14,
          "en": "in here.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 14.14,
          "end": 16.94,
          "en": "We can copy this code from \"Signup.\"",
          "zh": ""
        },
        {
          "id": 8,
          "start": 16.94,
          "end": 19.4,
          "en": "Because, we sent the same kind of data.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 19.4,
          "end": 21.14,
          "en": "We also send a post request.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 21.14,
          "end": 23.89,
          "en": "But, the URL will be different.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 23.89,
          "end": 27.65,
          "en": "If we have a look at the Firebase Auth REST API docs.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 27.65,
          "end": 30.48,
          "en": "Here, under \"Sign in\"; which is \"Log in.\"",
          "zh": ""
        },
        {
          "id": 13,
          "start": 30.48,
          "end": 33.073,
          "en": "It's this URL, which we need now.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 35.21,
          "end": 38.15,
          "en": "It has the same request body payload though.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 38.15,
          "end": 41.373,
          "en": "So, grab this URL and replace it.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 42.84,
          "end": 45.883,
          "en": "Here, up to your API key. Which is the same.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 46.91,
          "end": 49.36,
          "en": "And with that, this should work.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 49.36,
          "end": 52.76,
          "en": "Of course, you could also refactor this into some function,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 52.76,
          "end": 54.7,
          "en": "to have less code duplication.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 54.7,
          "end": 56.43,
          "en": "But, I like to be explicit here.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 56.43,
          "end": 57.913,
          "en": "So I will keep it like this.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 59.02,
          "end": 62,
          "en": "Now, we still wanna get the response data,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 62,
          "end": 65.11,
          "en": "check for errors, and commit some action at the end.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 65.11,
          "end": 67.18299999999999,
          "en": "So, we can copy all of that, as well.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 69.28,
          "end": 71.9,
          "en": "And with that, we should be pretty good!",
