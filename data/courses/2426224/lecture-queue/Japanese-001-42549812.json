      "cues": [
        {
          "id": 1,
          "start": 0,
          "end": 4.239,
          "en": "まずはVue.jsとは何かについて説明していきます",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.239,
          "end": 12.84,
          "en": "結論Vue.jsとはWebのユーザーインターフェースを簡単に作るためのJavaScriptフレームワークになります",
          "zh": ""
        },
        {
          "id": 3,
          "start": 12.84,
          "end": 17.379,
          "en": "どういうことかというとまずこのWebのユーザーインターフェースって何なのかというと",
          "zh": ""
        },
        {
          "id": 4,
          "start": 17.379,
          "end": 23.059,
          "en": "このWebってのはブラウザを使っていろんなページを見ることを指すんですけれども",
          "zh": ""
        },
        {
          "id": 5,
          "start": 23.059,
          "end": 27.52,
          "en": "じゃあこのユーザーインターフェースって何なのかというと",
          "zh": ""
        },
        {
          "id": 6,
          "start": 27.52,
          "end": 32.22,
          "en": "これですね頭文字を取ってUIと呼ばれることもあるんですけれども",
          "zh": ""
        },
        {
          "id": 7,
          "start": 32.22,
          "end": 38.86,
          "en": "インターフェースというものが日本語で接点接している場所みたいな意味になりまして",
          "zh": ""
        },
        {
          "id": 8,
          "start": 38.86,
          "end": 47.9,
          "en": "ユーザーと接している場所もっと言うとWebなのでブラウザ上でのユーザーと接している場所",
          "zh": ""
        },
        {
          "id": 9,
          "start": 47.9,
          "end": 50.639,
          "en": "これがWebのユーザーインターフェースになります",
          "zh": ""
        },
        {
          "id": 10,
          "start": 50.639,
          "end": 56.479,
          "en": "だから例えば単純なブラウザ上の見た目の部分だったりクリックした時の動き",
          "zh": ""
        },
        {
          "id": 11,
          "start": 56.479,
          "end": 63.799,
          "en": "ユーザーが何かクリックした時とかの処理とかそういうものがWebのユーザーインターフェースになります",
          "zh": ""
        },
        {
          "id": 12,
          "start": 63.799,
          "end": 73.44,
          "en": "このWebのユーザーインターフェースを簡単に作るためここまでがですね Vue.jsの目的になります",
          "zh": ""
        },
        {
          "id": 13,
          "start": 73.44,
          "end": 76.599,
          "en": "Vue.jsはWebのユーザーインターフェースを簡単に作るためにあるんだと",
          "zh": ""
        },
        {
          "id": 14,
          "start": 76.599,
          "end": 80.879,
          "en": "じゃあどうやってそんな簡単にUIを作れるようにしてるんですか",
          "zh": ""
        },
        {
          "id": 15,
          "start": 81.44,
          "end": 89.48,
          "en": "それがJavaScriptフレームワークとしてVue.jsを提供することで実現させているわけです",
          "zh": ""
        },
        {
          "id": 16,
          "start": 89.48,
          "end": 91.279,
          "en": "JavaScriptフレームワークとは何なのか",
          "zh": ""
