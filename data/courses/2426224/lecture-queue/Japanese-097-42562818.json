      "cues": [
        {
          "id": 1,
          "start": 0,
          "end": 6,
          "en": "前回CSSトランジションとCSSアニメーションについて復習しました",
          "zh": ""
        },
        {
          "id": 2,
          "start": 6,
          "end": 13,
          "en": "Vue.jsではVFディレクティブなどで要素が表示されたり消えたりするときに",
          "zh": ""
        },
        {
          "id": 3,
          "start": 13,
          "end": 21,
          "en": "アニメーションをつけるための機能が用意されているんですね 今回はそれについて紹介します 結論から言うと",
          "zh": ""
        },
        {
          "id": 4,
          "start": 21,
          "end": 26,
          "en": "トランジションというコンポーネントになります",
          "zh": ""
        },
        {
          "id": 5,
          "start": 26,
          "end": 29,
          "en": "これはKeepaliveとかと同じで",
          "zh": ""
        },
        {
          "id": 6,
          "start": 29,
          "end": 35,
          "en": "こんなふうにいきなり使えるデフォルトで内蔵されているコンポーネントになります",
          "zh": ""
        },
        {
          "id": 7,
          "start": 35,
          "end": 46,
          "en": "このコンポーネントが本セクションを通してメインで説明する内容になります ではこれをどうやって使うのか",
          "zh": ""
        },
        {
          "id": 8,
          "start": 46,
          "end": 55,
          "en": "まずこのトランジションコンポーネントは内部的にスロットを使っていまして",
          "zh": ""
        },
        {
          "id": 9,
          "start": 55,
          "end": 61,
          "en": "中にこんなふうにテンプレートを入れることができるようになっています",
          "zh": ""
        },
        {
          "id": 10,
          "start": 61,
          "end": 68,
          "en": "その上でもしここの中のテンプレートに2つ以上の要素があると",
          "zh": ""
        },
        {
          "id": 11,
          "start": 68,
          "end": 71,
          "en": "こんなふうにエラーになってしまいます",
          "zh": ""
        },
        {
          "id": 12,
          "start": 71,
          "end": 74,
          "en": "なのでトランジションコンポーネントの中は",
          "zh": ""
        },
        {
          "id": 13,
          "start": 74,
          "end": 79,
          "en": "常に1つだけの要素を置く必要があるんですね",
          "zh": ""
        },
        {
          "id": 14,
          "start": 79,
          "end": 84,
          "en": "ただしもちろんNestを押されていたりしたらこれはOKです",
          "zh": ""
        },
        {
          "id": 15,
          "start": 84,
          "end": 90,
          "en": "あくまでも一番外側のトランジションコンポーネントの直下にある要素が",
          "zh": ""
        },
        {
          "id": 16,
          "start": 90,
          "end": 93,
          "en": "1つだけになっている必要があります",
          "zh": ""
        },
        {
          "id": 17,
          "start": 93,
          "end": 99,
          "en": "ただし例えばですけれどもVFディレクティブとかがあった場合は",
          "zh": ""
        },
        {
          "id": 18,
          "start": 99,
          "end": 103,
          "en": "これですねもし2つ目の要素のVFディレクティブが",
          "zh": ""
        },
        {
          "id": 19,
          "start": 103,
          "end": 109,
          "en": "例えばフォルスとかになっていた場合でもこれはダメなんですけれども",
          "zh": ""
        },
        {
          "id": 20,
          "start": 109,
          "end": 116,
          "en": "もしここがVFじゃなくてVLSとかVLS-IFとかになっている場合は",
          "zh": ""
        },
        {
          "id": 21,
          "start": 116,
          "end": 122,
          "en": "これは常に1つだけしか要素が表示されないことが保証されますので",
          "zh": ""
        },
        {
          "id": 22,
          "start": 122,
          "end": 126,
          "en": "この時はエラーは出ないようになっていたりします",
          "zh": ""
        },
        {
          "id": 23,
          "start": 126,
          "end": 132,
          "en": "またこの中に別のコンポーネントを置いた場合も",
          "zh": ""
        },
        {
          "id": 24,
          "start": 132,
          "end": 137,
          "en": "そのコンポーネントのテンプレートの一番外側のタグは",
          "zh": ""
        },
        {
          "id": 25,
          "start": 137,
          "end": 142,
          "en": "1つだけになっている必要があります 複数置いてはいけません",
          "zh": ""
        },
        {
          "id": 26,
          "start": 142,
          "end": 145,
          "en": "なのでトランジションコンポーネントの直下には",
          "zh": ""
        },
        {
          "id": 27,
          "start": 145,
          "end": 151,
          "en": "常に1つの要素だけが存在することが保証されているわけですね",
          "zh": ""
        },
        {
          "id": 28,
          "start": 151,
          "end": 154,
          "en": "その上でこのトランジションコンポーネントは",
          "zh": ""
        },
        {
          "id": 29,
          "start": 154,
          "end": 161,
          "en": "この直下の要素が表示されたり消えたりしない限りは何もしません",
          "zh": ""
        },
        {
          "id": 30,
          "start": 161,
          "end": 166,
          "en": "もう少し厳密に言うとこの直下の要素にVFディレクティブ",
