      "sourceHash": "bd2310b0db898f706aec1e48921193eb912f0b079131eb758e087bfb18ba8135",
      "cues": [
        {
          "id": 1,
          "start": 0,
          "end": 10.64,
          "en": "一度シンプルなホームとブログのページだけにしました でアップロードビューでルータリンクを使って",
          "zh": ""
        },
        {
          "id": 2,
          "start": 10.64,
          "end": 17.799,
          "en": "ホームとブログのIDが3のページに飛ぶようにしました こんな感じですね",
          "zh": ""
        },
        {
          "id": 3,
          "start": 17.799,
          "end": 23.879,
          "en": "ブログのページには next のボタンを用意して",
          "zh": ""
        },
        {
          "id": 4,
          "start": 23.879,
          "end": 37.599,
          "en": "このですね next をクリックすると次の ID のページに移動するというふうにしました その上で今回はこれらのページの移動時に",
          "zh": ""
        },
        {
          "id": 5,
          "start": 37.599,
          "end": 49,
          "en": "アニメーションを適用させる方法について見たいと思います Vue.js でコンポーネントが切り替わった時とかにアニメーションをつける場合って",
          "zh": ""
        },
        {
          "id": 6,
          "start": 49,
          "end": 54.159,
          "en": "どうしていましたか トランジションコンポーネントを使っていましたよね",
          "zh": ""
        },
        {
          "id": 7,
          "start": 54.159,
          "end": 66.959,
          "en": "なので今回もトランジションコンポーネントを使っていきたいと思います 実際にコンポーネントが切り替わる部分はルータVueですので",
          "zh": ""
        },
        {
          "id": 8,
          "start": 66.959,
          "end": 76.599,
          "en": "それをですねこんな風にトランジションコンポーネントで囲いたいと思います 今回はネーム属性をつけてFadeとして",
          "zh": ""
        },
        {
          "id": 9,
          "start": 76.599,
          "end": 85.68,
          "en": "このページが移動する時にFadeをするアニメーションを作りたいと思います なのでクラスも用意しますね",
          "zh": ""
        },
        {
          "id": 10,
          "start": 85.68,
          "end": 97.87899999999999,
          "en": "スタイルとしてScorePodにします FadeEnterFromでオパシティを0にします",
          "zh": ""
        },
        {
          "id": 11,
          "start": 97.87899999999999,
          "end": 109.36,
          "en": "オパシティが0のものはFadeEnterFromの他にもFadeLeaveToもそうでしたよね CSSではこんな風にカンマを区切って",
          "zh": ""
        },
        {
          "id": 12,
          "start": 109.36,
          "end": 121.319,
          "en": "同時にCSSを適用することもできますのでこんな風に書くこともできます 同じようにFadeEnterActive",
          "zh": ""
        },
        {
          "id": 13,
          "start": 121.319,
          "end": 126.68,
          "en": "と FadeLeaveActive",
          "zh": ""
        },
        {
          "id": 14,
          "start": 126.68,
          "end": 137.039,
          "en": "に対してトランジションでオパシティに対して1秒のトランジションを適用させたいと思います",
          "zh": ""
        },
        {
          "id": 15,
          "start": 137.039,
          "end": 148.07999999999998,
          "en": "FadeEnterToとFadeLeaveFromに対してはオパシティ1を設定したいんですけれども CSSではオパシティはデフォルトで1になりますので",
          "zh": ""
        },
        {
          "id": 16,
          "start": 148.07999999999998,
          "end": 157.32,
          "en": "実は設定しなくても ok ですのでまぁこんな風にしておきますね そうすると今の段階ではこんな風に",
          "zh": ""
        },
        {
          "id": 17,
          "start": 157.32,
          "end": 165.839,
          "en": "ちょっとガタガタとしたアニメーションが起きます 今ですね実はこのブログに対してアニメーションが起きていません",
          "zh": ""
        },
        {
          "id": 18,
          "start": 165.839,
          "end": 173.039,
          "en": "これなんでかっていうと トランジションの中は必ず一つのタグでないとダメですよね",
          "zh": ""
        },
        {
          "id": 19,
          "start": 173.039,
          "end": 182.52,
          "en": "ただこのブログビューが今2つのタグがありますのでちょっとディブタグで囲いますね そうするとこんな風に",
          "zh": ""
        },
        {
          "id": 20,
          "start": 182.52,
          "end": 191.839,
          "en": "アニメーションが両方に起こっているのがわかると思います ただし今ですね実はこれ消えるときのアニメーションは起こっていないんですね",
          "zh": ""
        },
        {
          "id": 21,
          "start": 191.839,
          "end": 200.6,
          "en": "ちょっとわかりやすいようにモードをつけてアウトインとしますね これで見てみてもこんな風に",
          "zh": ""
        },
        {
          "id": 22,
          "start": 200.6,
          "end": 210,
          "en": "本来モードアウトインをつけたら不安と消えて不安と現れますが 今だったらすぐにパッと消えて現れる時だけ不安と現れる",
          "zh": ""
        },
        {
          "id": 23,
          "start": 210,
          "end": 221.6,
          "en": "パッと消えて不安と現れるという風になっていて消える時のアニメーションが起こっていません これなぜかというとモードについて紹介した時に説明したんですが",
          "zh": ""
        },
        {
          "id": 24,
          "start": 221.6,
          "end": 234.119,
          "en": "トランジションコンポーネントでは今みたいに複数の要素を切り替えるときはその切り替えの処理 例えばVGIFとかVCOとか動的コンポーネントとか",
          "zh": ""
        },
        {
          "id": 25,
          "start": 234.119,
          "end": 243.88,
          "en": "そういうものを明示的にこのトランジションコンポーネントの中に直接同じテンプレート内に 書かないといけないんですね",
          "zh": ""
        },
        {
          "id": 26,
          "start": 243.88,
          "end": 255.88,
          "en": "この中身の部分を別のコンポーネントとして切り出したりしてはいけないんですね もしそうした場合は要素が消えるときのアニメーションが起こらなくなります",
          "zh": ""
        },
        {
          "id": 27,
          "start": 255.88,
          "end": 267.559,
          "en": "だから今だとこのルータービューは内部的に動的コンポーネントのような機能にはなっていますが それが切り出されて一つのコンポーネントとして扱われていますよね",
          "zh": ""
        },
        {
          "id": 28,
          "start": 267.559,
          "end": 276.15999999999997,
          "en": "なので消えるときのアニメーションが現在行われないわけです でじゃあこれ消えるときのアニメーションもちゃんとつけたい場合どうしたらいいのか",
          "zh": ""
        },
        {
          "id": 29,
          "start": 276.15999999999997,
          "end": 284.799,
          "en": "これですねちゃんと解決方法が用意されています ただ少しややこしいのでちょっと順番に一つずつ説明しますね",
          "zh": ""
        },
        {
          "id": 30,
          "start": 284.799,
          "end": 292.64,
          "en": "まず このルータービューは実は内部的にスロットを使っていまして",
          "zh": ""
        },
        {
          "id": 31,
          "start": 292.64,
          "end": 297.92,
          "en": "中にこんな風に スロットコンテンツを取ることができます",
          "zh": ""
        },
        {
          "id": 32,
          "start": 297.92,
          "end": 309.92,
          "en": "でもしそうした場合はこのルータービューは一切こっちの クリエイトルーターの設定とかは無視して",
          "zh": ""
        },
        {
          "id": 33,
          "start": 309.92,
          "end": 318.92,
          "en": "その渡されたスロットコンテンツをそのまま表示するようになります でもうこれパスとか一切関係ありません",
          "zh": ""
        },
        {
          "id": 34,
          "start": 318.92,
          "end": 331.48,
          "en": "常に渡されたスロットコンテンツを表示するようになるんですね その上でスロットプロプスもこのルータービューは渡すようになっていまして",
          "zh": ""
        },
        {
          "id": 35,
          "start": 331.48,
          "end": 342.119,
          "en": "ここで v スロットとしてスロットプロプスを受け取ることができます ここはオブジェクトになっているんですけれどもそのプロパティには",
          "zh": ""
        },
        {
          "id": 36,
          "start": 342.119,
          "end": 350.279,
          "en": "ちょっと分割在入のような書き方をするんですけれども コンポーネントというものとルートというもの",
          "zh": ""
        },
        {
          "id": 37,
          "start": 350.279,
          "end": 357.799,
          "en": "この2つのプロパティが入るようになります なのでコンポーネントやルートをここで受け取ることができるんですね",
          "zh": ""
        },
        {
          "id": 38,
          "start": 357.799,
          "end": 366.279,
          "en": "でこのルートに関しては虹並み括弧で見てみるとわかるんですけれども 普通の$ルートと同じような内容がここに入ります",
          "zh": ""
        },
        {
          "id": 39,
          "start": 366.279,
          "end": 371.72,
          "en": "だからページの情報ですね 大切なのはこっちですねこのコンポーネントの方です",
          "zh": ""
        },
        {
          "id": 40,
          "start": 371.72,
          "end": 386.239,
          "en": "このコンポーネントには本来そのパスで表示するべきコンポーネント 普通にルータービューとして使ったときに表示するべきコンポーネントが入ります なので ここに",
          "zh": ""
        },
        {
          "id": 41,
          "start": 386.239,
          "end": 392.48,
          "en": "動的コンポーネントをそのまま置いちゃうんですね こんな風に",
          "zh": ""
        },
        {
          "id": 42,
          "start": 392.48,
          "end": 400.359,
          "en": "でここに is 属性でこのコンポーネントを直接指定すると",
          "zh": ""
        },
        {
          "id": 43,
          "start": 400.359,
          "end": 407.32,
          "en": "もう さっきと同じように普通にページの移動ができるようになります",
          "zh": ""
        },
        {
          "id": 44,
          "start": 407.32,
          "end": 415.959,
          "en": "なのでこの書き方と特に何も指定していない最初のこの書き方は同じ意味になるんですね",
          "zh": ""
        },
        {
          "id": 45,
          "start": 415.959,
          "end": 423.48,
          "en": "だからこれを書き換えたのがこれです ルートはなくても ok ですねこういう書き方でもできるわけです",
          "zh": ""
        },
        {
          "id": 46,
          "start": 423.48,
          "end": 432.799,
          "en": "でこんな風に書き換えられると何がいいのかというと 明示的に動的コンポーネントが出てきましたよね",
          "zh": ""
        },
        {
          "id": 47,
          "start": 432.799,
          "end": 447.16,
          "en": "なので この動的コンポーネントをこのトランジションコンポーネントで囲ってあげるんですね そうすると こんな風に",
          "zh": ""
        },
        {
          "id": 48,
          "start": 447.16,
          "end": 457.88,
          "en": "正しく消える時のアニメーションも行われるようになります だからページの移動時にアニメーションをさせたい場合は",
          "zh": ""
        },
        {
          "id": 49,
          "start": 457.88,
          "end": 469.64,
          "en": "こういう風にルータービューを書き直す必要があります これですね結構ややこしいんですけれどもぜひこの方法で書くようにしてください",
          "zh": ""
        },
        {
          "id": 50,
          "start": 469.72,
          "end": 482.839,
          "en": "ちなみに今だったらこのブログのページの next のボタンを押した時 この時は同じコンポーネントが使い回されますので特にアニメーションは起こりません",
          "zh": ""
        },
        {
          "id": 51,
          "start": 482.839,
          "end": 491.76,
          "en": "もしこれどうしてもアニメーションをつけたい場合は 動的コンポーネント以外の方法で要素をつけたり消したりする必要があります",
          "zh": ""
        },
        {
          "id": 52,
          "start": 491.76,
          "end": 502.359,
          "en": "今回の場合だとキー属性を使うのがいいですね これ v-bind で動的にした上で今回だったらパスが変わった時に",
          "zh": ""
        },
        {
          "id": 53,
          "start": 502.359,
          "end": 510.88,
          "en": "コンポーネントを違うものとして認識させたいので ちょっとこっちのコンポーネントじゃないもう一つのルートの方を使いますね",
          "zh": ""
        },
        {
          "id": 54,
          "start": 510.88,
          "end": 523.28,
          "en": "これにはパスプロパティがありますのでこれを指定します そうすると next でパスが変わったら違うキー属性として認識されて違うキー属性なので",
          "zh": ""
        },
        {
          "id": 55,
          "start": 523.28,
          "end": 530.88,
          "en": "違うコンポーネントとして認識されてトランジションコンポーネントはちゃんとアニメーションをしてくれるようになります",
          "zh": ""
        },
        {
          "id": 56,
          "start": 530.88,
          "end": 544.52,
          "en": "以上がトランジションをビュールーターと一緒に使う方法です では次はページのスクロールの振る舞いについて話したいと思います",
          "zh": ""
        }
      ],
      "sourceLanguage": "ja"
    }
  ]
