      "cues": [
        {
          "id": 1,
          "start": 0,
          "end": 5.079,
          "en": "改めてシンプルなホームとブログのページにしました",
          "zh": ""
        },
        {
          "id": 2,
          "start": 5.079,
          "end": 11.8,
          "en": "今回はViewRouterにおけるスクロールの振る舞いについて説明したいと思います",
          "zh": ""
        },
        {
          "id": 3,
          "start": 11.8,
          "end": 16.26,
          "en": "今ちょっとスクロールしていないのでスクロールするようにしますね",
          "zh": ""
        },
        {
          "id": 4,
          "start": 16.26,
          "end": 21.899,
          "en": "このホームとブログのリンクを一番下に持ってきて",
          "zh": ""
        },
        {
          "id": 5,
          "start": 21.899,
          "end": 26.92,
          "en": "間にですねPタグで適当にボトムという文字を入れます",
          "zh": ""
        },
        {
          "id": 6,
          "start": 26.92,
          "end": 35.799,
          "en": "でここにスタイルタグでマージントップに1000ピクセルとしたいと思います",
          "zh": ""
        },
        {
          "id": 7,
          "start": 35.799,
          "end": 42.959,
          "en": "そうするとこんな風にスクロールができて下の方にボトムとリンクが来るのが分かると思います",
          "zh": ""
        },
        {
          "id": 8,
          "start": 42.959,
          "end": 50.919,
          "en": "で今ですねここをクリックしてもうこんな風に一切スクロールの振る舞いは行われずに",
          "zh": ""
        },
        {
          "id": 9,
          "start": 50.919,
          "end": 54.36,
          "en": "単純にUIだけが変わるようになるんですね",
          "zh": ""
        },
        {
          "id": 10,
          "start": 54.36,
          "end": 64.16,
          "en": "ただこれ従来のウェブページであればページを開いたら普通一番上にきますよね 新しいページであれば",
          "zh": ""
        },
        {
          "id": 11,
          "start": 64.16,
          "end": 71.03999999999999,
          "en": "ただそういう振る舞いはデフォルトではViewRouterでは行われないんですね",
          "zh": ""
        },
        {
          "id": 12,
          "start": 71.03999999999999,
          "end": 80.36,
          "en": "なぜならViewRouterはあくまでも擬似的に新しいページを作っているように見せているだけで",
          "zh": ""
        },
        {
          "id": 13,
          "start": 80.36,
          "end": 87.68,
          "en": "本当はJavaScriptでUIやURLを変えているだけなので",
          "zh": ""
        },
        {
          "id": 14,
          "start": 87.68,
          "end": 92.239,
          "en": "ただもちろん普通のウェブページのようにスクロールの振る舞いをさせたいですよね",
          "zh": ""
        },
        {
          "id": 15,
          "start": 92.239,
          "end": 104.919,
          "en": "ということでViewRouterはそのスクロールの位置を操作する機能を用意してくれています 今回そこについて紹介しますね でいきなり結論なんですけれども",
          "zh": ""
        },
        {
          "id": 16,
          "start": 104.919,
          "end": 110.47999999999999,
          "en": "このクリエイトルーターの設定のところに",
          "zh": ""
        },
        {
          "id": 17,
          "start": 110.47999999999999,
          "end": 116.63900000000001,
          "en": "スクロールBehaviourというメソッドを置くんですね",
          "zh": ""
        },
        {
          "id": 18,
          "start": 116.63900000000001,
          "end": 124.919,
          "en": "そうするとこのメソッドはページが表示されるたびに毎回実行されるようになります",
          "zh": ""
        },
        {
          "id": 19,
          "start": 124.919,
          "end": 135.399,
          "en": "でここに帰り地でオブジェクトを返してその中にトップというプロパティを指定します",
          "zh": ""
        },
        {
          "id": 20,
          "start": 135.399,
          "end": 138.47899999999998,
          "en": "でも値は数字であれば何でもいいです",
          "zh": ""
        },
        {
          "id": 21,
          "start": 138.47899999999998,
          "end": 146.52,
          "en": "こうするとこんな風にページを表示するときに毎回",
          "zh": ""
        },
        {
          "id": 22,
          "start": 146.52,
          "end": 155.75900000000001,
          "en": "今だったら100と書いているので上から100ピクセル分移動した位置にスクロールされるようになります",
          "zh": ""
        },
        {
          "id": 23,
          "start": 155.75900000000001,
          "end": 160.8,
          "en": "なのでどこのページに行っても常に上から100ピクセル分移動するわけですね",
          "zh": ""
        },
        {
          "id": 24,
          "start": 160.8,
          "end": 170.399,
          "en": "なのでここを100じゃなくて0にすることで常にページの移動時に一番上に移動するようになるわけです",
          "zh": ""
        },
        {
          "id": 25,
          "start": 170.399,
          "end": 177.8,
          "en": "またこれもしですね横にスクロールしている場合はトップの他にもleftというプロパティを指定することもできまして",
          "zh": ""
        },
        {
          "id": 26,
          "start": 177.8,
          "end": 186.559,
          "en": "こうすることで左から何ピクセル分スクロールするかというのも指定することができます こういう機能があるんですね",
          "zh": ""
        },
        {
          "id": 27,
          "start": 186.559,
          "end": 191.08,
          "en": "ちなみにもしこれ何もリターンしなければ特に何も起こりません",
          "zh": ""
        },
        {
          "id": 28,
          "start": 191.08,
          "end": 199.36,
          "en": "あくまでもこういう帰り地の値によってスクロールの振る舞いを決めることができるわけです",
          "zh": ""
        },
        {
          "id": 29,
          "start": 199.36,
          "end": 207.96,
          "en": "またここのですねオブジェクトにはトップやレフト以外にもELというプロパティを置くことができまして",
          "zh": ""
        },
        {
          "id": 30,
          "start": 207.96,
          "end": 218.52,
          "en": "その場合は値には文字列でCSSセレクターを取るかもしくは直接DOM要素を指定することができます",
          "zh": ""
        },
        {
          "id": 31,
          "start": 218.52,
          "end": 222.16,
          "en": "なので今回だったら例えばハッシュブログとかとしますね",
          "zh": ""
        },
        {
          "id": 32,
          "start": 222.16,
          "end": 224.44,
          "en": "IDがブログの要素という意味です",
          "zh": ""
        },
        {
          "id": 33,
          "start": 224.44,
          "end": 231.36,
          "en": "そうするとそれが示す要素のところまでスクロールしてくれるようになります",
          "zh": ""
        },
        {
          "id": 34,
          "start": 231.36,
          "end": 237.96,
          "en": "だからちょっと今IDがブログというのがないのでここのh2タグのところとかにIDブログとしますね",
          "zh": ""
        },
        {
          "id": 35,
          "start": 237.96,
          "end": 247.75900000000001,
          "en": "そうすると今ブログのページに行くとこんな風にIDがブログのところまでスクロールしてくれるようになります",
          "zh": ""
        },
        {
          "id": 36,
          "start": 247.75900000000001,
          "end": 254.199,
          "en": "このELプロパティは実はトップやレフトと一緒に使うこともできまして",
          "zh": ""
        },
        {
          "id": 37,
          "start": 254.199,
          "end": 264.32,
          "en": "例えばトップ20とするとページの移動時に上に20px分余白をつけてくれるようになります",
          "zh": ""
        },
        {
          "id": 38,
          "start": 264.32,
          "end": 268.92,
          "en": "もしこれトップが0とか何もなかったらこの一番上にくるわけですね",
          "zh": ""
        },
        {
          "id": 39,
          "start": 268.92,
          "end": 275.55899999999997,
          "en": "ただトップが20だとトップに上に今だったら20px分余白をつけてくれるようになります",
          "zh": ""
        },
        {
          "id": 40,
          "start": 275.55899999999997,
          "end": 281.2,
          "en": "あとこのスクロールビヘイビアのメソッドには引数が入るようになっていまして",
          "zh": ""
        },
        {
          "id": 41,
          "start": 281.2,
          "end": 286.119,
          "en": "名前は何でもいいんですけれども一般的にtoやfromと書くことが多いんですけれども",
          "zh": ""
        },
        {
          "id": 42,
          "start": 286.119,
          "end": 288.679,
          "en": "こんな風に引数を取ることができます",
          "zh": ""
        },
        {
          "id": 43,
          "start": 288.679,
          "end": 299.88,
          "en": "このtoやfromにはそのページの移動先と移動前の$root、rootオブジェクトですね",
          "zh": ""
        },
        {
          "id": 44,
          "start": 299.88,
          "end": 304.64,
          "en": "そのページの情報が入ったデータレスが入るようになっています",
          "zh": ""
        },
        {
          "id": 45,
          "start": 304.64,
          "end": 307.6,
          "en": "なのでちょっとconsole.logで見たいんですけれども",
          "zh": ""
        },
        {
          "id": 46,
          "start": 307.6,
          "end": 315.399,
          "en": "toとfromとして見てみると例えばブログのページからホームのページに行ったら",
          "zh": ""
        },
        {
          "id": 47,
          "start": 315.399,
          "end": 323.959,
          "en": "こんな風にパラムズとかハッシュとかがあったりするように両方ですね",
          "zh": ""
        },
        {
          "id": 48,
          "start": 323.959,
          "end": 327.72,
          "en": "rootオブジェクトになっていて第一引数の方ですね",
          "zh": ""
        },
        {
          "id": 49,
          "start": 327.72,
          "end": 332.519,
          "en": "toの方には移動先のデータつまり今だったらブログからホームに行ったので",
          "zh": ""
        },
        {
          "id": 50,
          "start": 332.519,
          "end": 335.239,
          "en": "ホームに関するデータが入っていて",
          "zh": ""
        },
        {
          "id": 51,
          "start": 335.239,
          "end": 341.88,
          "en": "fromの方には移動前のブログのページの情報が入っていると こういうのがわかると思います",
          "zh": ""
        },
        {
          "id": 52,
          "start": 341.88,
          "end": 345.76,
          "en": "こういうデータをスクロールビヘイビアで受け取ることができるんですね",
          "zh": ""
        },
        {
          "id": 53,
          "start": 345.76,
          "end": 350.72,
          "en": "なので例えばですけれどもページ移動先のtoのデータの中に",
          "zh": ""
        },
        {
          "id": 54,
          "start": 350.72,
          "end": 361.239,
          "en": "ハッシュがあった時だけリターンでそのハッシュのところに行く",
          "zh": ""
        },
        {
          "id": 55,
          "start": 361.239,
          "end": 363.76,
          "en": "みたいに書くこともできるわけです",
          "zh": ""
        },
        {
          "id": 56,
          "start": 363.76,
          "end": 367.399,
          "en": "ではハッシュがなかったら普通にトップに行くということで",
          "zh": ""
        },
        {
          "id": 57,
          "start": 367.399,
          "end": 371.359,
          "en": "top0でleftも書いておきますね",
          "zh": ""
        },
        {
          "id": 58,
          "start": 371.359,
          "end": 375.799,
          "en": "こうするとページを移動するリンクのところで",
          "zh": ""
        },
        {
          "id": 59,
          "start": 375.799,
          "end": 382.799,
          "en": "ルータリンクに対してハッシュでハッシュブログとかとすると",
          "zh": ""
        },
        {
          "id": 60,
          "start": 382.799,
          "end": 393.519,
          "en": "ちゃんとページを移動するときにハッシュブログがついて ハッシュブログがついているので toハッシュがちゃんとあるので",
          "zh": ""
        },
        {
          "id": 61,
          "start": 393.519,
          "end": 397.679,
          "en": "そこの要素まで移動するという書き方ができます",
          "zh": ""
        },
        {
          "id": 62,
          "start": 397.679,
          "end": 405.519,
          "en": "もしハッシュがなかったりすると普通に一番トップに行くと こういうふうになります だからこんなふうにすることで",
          "zh": ""
        },
        {
          "id": 63,
          "start": 405.519,
          "end": 411.399,
          "en": "普通のwebでの動きと同じような動きが再現できるんですね ただしこれですね",
          "zh": ""
        },
        {
          "id": 64,
          "start": 411.399,
          "end": 413.959,
          "en": "まだ一つ未完成な部分がありまして",
          "zh": ""
        },
        {
          "id": 65,
          "start": 413.959,
          "end": 417.679,
          "en": "それが戻るボタンとか進むボタンです",
          "zh": ""
        },
        {
          "id": 66,
          "start": 417.679,
          "end": 420.239,
          "en": "これ普通のブラウザの挙動であれば",
          "zh": ""
        },
        {
          "id": 67,
          "start": 420.239,
          "end": 425.88,
          "en": "例えばスクロールした上でブログのページに行って で戻るボタンを押したら",
          "zh": ""
        },
        {
          "id": 68,
          "start": 425.88,
          "end": 431.279,
          "en": "さっきまで見ていたスクロールされた状態のページを表示するんですね",
          "zh": ""
        },
        {
          "id": 69,
          "start": 431.279,
          "end": 438.32,
          "en": "ただ今だとこんなふうにスクロールビヘイビアの処理を書いているので 問答無用でハッシュがなければ",
          "zh": ""
        },
        {
          "id": 70,
          "start": 438.32,
          "end": 443.399,
          "en": "トップゼロの先頭にスクロールされてしまいます でこれどうしたらいいのか",
          "zh": ""
        },
        {
          "id": 71,
          "start": 443.399,
          "end": 446.399,
          "en": "実はちゃんとこれも対処することができまして",
          "zh": ""
        },
        {
          "id": 72,
          "start": 446.399,
          "end": 450.679,
          "en": "スクロールビヘイビアの第3引数に",
          "zh": ""
        },
        {
          "id": 73,
          "start": 450.679,
          "end": 454.15999999999997,
          "en": "進むや戻るのボタンが押された時の",
          "zh": ""
        },
        {
          "id": 74,
          "start": 454.15999999999997,
          "end": 459.399,
          "en": "その前回のスクロールの情報を渡してくれるようになっているんですね",
          "zh": ""
        },
        {
          "id": 75,
          "start": 459.399,
          "end": 461.88,
          "en": "なので引数名は何でもいいんですけれども",
          "zh": ""
        },
        {
          "id": 76,
          "start": 461.88,
          "end": 467.959,
          "en": "一般的にセーブドポジションとすることが多いですね これを使用します",
          "zh": ""
        },
        {
          "id": 77,
          "start": 467.959,
          "end": 474.239,
          "en": "でちょっとこれ中身どういうふうになっているのか見たいので console.logで見ると",
          "zh": ""
        },
        {
          "id": 78,
          "start": 474.239,
          "end": 478.44,
          "en": "最初はですねこんなふうにオブジェクトになっていて",
          "zh": ""
        },
        {
          "id": 79,
          "start": 478.44,
          "end": 480.359,
          "en": "でレフトとトップのプロパティがあって",
          "zh": ""
        },
        {
          "id": 80,
          "start": 480.359,
          "end": 483.32,
          "en": "値がゼロになっているというふうになります",
          "zh": ""
        },
        {
          "id": 81,
          "start": 483.32,
          "end": 486.119,
          "en": "基本的にこのセーブドポジションは",
          "zh": ""
        },
        {
          "id": 82,
          "start": 486.119,
          "end": 492.16,
          "en": "最初以外はこんな風にヌルが返るようになります",
          "zh": ""
        },
        {
          "id": 83,
          "start": 492.16,
          "end": 495.72,
          "en": "だから普通にページを移動する場合はヌルが返るんですね",
          "zh": ""
        },
        {
          "id": 84,
          "start": 495.72,
          "end": 501.079,
          "en": "ただしこれもし戻るボタンを押した時は",
          "zh": ""
        },
        {
          "id": 85,
          "start": 501.079,
          "end": 509.399,
          "en": "はいこんな風に前回このページにいた時に スクロールしていた位置の情報を",
          "zh": ""
        },
        {
          "id": 86,
          "start": 509.399,
          "end": 515.679,
          "en": "レフトとトップのオブジェクトで返してくれるようになります これは進むも同じですね",
          "zh": ""
        },
        {
          "id": 87,
          "start": 515.679,
          "end": 518.039,
          "en": "進むボタンを押した時もこんな風に",
          "zh": ""
        },
        {
          "id": 88,
          "start": 518.039,
          "end": 523.799,
          "en": "レフトとトップでスクロールしている位置の情報を返してくれるようになります",
          "zh": ""
        },
        {
          "id": 89,
          "start": 523.799,
          "end": 529.08,
          "en": "こういう情報を第三引数に渡してくれているんですね",
          "zh": ""
        },
        {
          "id": 90,
          "start": 529.08,
          "end": 532.4,
          "en": "なのでもう一度if文とかを置いて",
          "zh": ""
        },
        {
          "id": 91,
          "start": 532.4,
          "end": 537.64,
          "en": "セーブドポジションがヌルじゃなかった時は",
          "zh": ""
        },
        {
          "id": 92,
          "start": 537.64,
          "end": 539.919,
          "en": "普通にオブジェクトになっていますので",
          "zh": ""
        },
        {
          "id": 93,
          "start": 539.919,
          "end": 546.52,
          "en": "そのデータを返すというふうにすると ちゃんとホームのページに行って",
          "zh": ""
        },
        {
          "id": 94,
          "start": 546.52,
          "end": 551.52,
          "en": "スクロールした上でブログのページに行って もう一度戻るボタンを押すと",
          "zh": ""
        },
        {
          "id": 95,
          "start": 551.52,
          "end": 559.119,
          "en": "こんな風にスクロールされた状態のままのページが表示されます で進むを押しても同じように",
          "zh": ""
        },
        {
          "id": 96,
          "start": 559.119,
          "end": 561.28,
          "en": "スクロールされた状態になるわけですね",
          "zh": ""
        },
        {
          "id": 97,
          "start": 561.28,
          "end": 565.359,
          "en": "ちょっと分かりにくいので少しずらして戻って進みますね",
          "zh": ""
        },
        {
          "id": 98,
          "start": 565.359,
          "end": 568.919,
          "en": "そうするとこんな風に前回の状態を保ってくれるわけです",
          "zh": ""
        },
        {
          "id": 99,
          "start": 568.919,
          "end": 572.359,
          "en": "なので最終的にこんな風に書くことで",
          "zh": ""
        },
        {
          "id": 100,
          "start": 572.359,
          "end": 577.039,
          "en": "本来のwebのスクロールの振る舞いと同じようにすることができます",
          "zh": ""
        },
        {
          "id": 101,
