      "cues": [
        {
          "id": 1,
          "start": 0,
          "end": 5.599,
          "en": "さあVue.jsとDOMとの関係性についていろいろと見てきました",
          "zh": ""
        },
        {
          "id": 2,
          "start": 5.599,
          "end": 15.199,
          "en": "基本的に本物のDOMに対してはVue.jsが内部的に操作してくれますので",
          "zh": ""
        },
        {
          "id": 3,
          "start": 15.199,
          "end": 23.68,
          "en": "Vue.jsを使う上ではそこまで本物のDOMを意識する必要はないんですけれども",
          "zh": ""
        },
        {
          "id": 4,
          "start": 23.68,
          "end": 31.479,
          "en": "時には直接本物のDOMにアクセスしたいという時もあると思います",
          "zh": ""
        },
        {
          "id": 5,
          "start": 31.479,
          "end": 40.4,
          "en": "そういう時にですね実は簡単にその本物のDOMの要素にアクセスする方法を",
          "zh": ""
        },
        {
          "id": 6,
          "start": 40.4,
          "end": 43.319,
          "en": "Vue.jsは用意してくれてるんですね",
          "zh": ""
        },
        {
          "id": 7,
          "start": 43.319,
          "end": 46.52,
          "en": "今回その方法について紹介したいと思います",
          "zh": ""
        },
        {
          "id": 8,
          "start": 46.52,
          "end": 53.119,
          "en": "でどうするかっていうと実際に操作したいDOMの要素のタグ",
          "zh": ""
        },
        {
          "id": 9,
          "start": 53.119,
          "end": 62.639,
          "en": "今回ちょっとインプットタグを用意しますね に追加でREF属性という",
