  "lectures": [
    {
      "id": "42563046",
      "title": "ライフサイクルフックはOptions APIではこうなっている",
      "lectureOrder": 171,
      "videoOrder": 170,
      "sourceHash": "f0a4838cdb6fa95139fa910444f3efa03a38b2457610e93bb52e85e01fc0a741",
      "cues": [
        {
          "id": 1,
          "start": 0,
          "end": 10.279,
          "en": "ライフサイクルフック、つまりオンマウンティットとかオンアンマウンティットとか、そういうものをオプションズAPIで定義する方法について見たいと思います。",
          "zh": ""
        },
        {
          "id": 2,
          "start": 10.279,
          "end": 22.76,
          "en": "で、いきなり結論から言うと、このWatcherやMethodsとかと同じ階層のところに、いきなりMountedというメソッドを入れます。",
          "zh": ""
        },
        {
          "id": 3,
          "start": 22.76,
          "end": 33.36,
          "en": "こうすることで、このコンポーネントのMount時に、ここのメソッドが実行されます。",
          "zh": ""
        },
        {
          "id": 4,
          "start": 33.36,
          "end": 46.159,
          "en": "他にも、Mount以外にも、Unmountedや Before Mountとか",
          "zh": ""
        },
        {
          "id": 5,
          "start": 46.759,
          "end": 53.56,
          "en": "Before Unmountのライフサイクルフックもこんな風に定義します。",
          "zh": ""
        },
        {
          "id": 6,
          "start": 53.56,
          "end": 60.4,
          "en": "あと他にも、アップデート系ですね。Updatedと",
          "zh": ""
        },
        {
          "id": 7,
          "start": 61.799,
          "end": 66.48,
          "en": "Before Updateもこんな風に定義します。",
          "zh": ""
        },
        {
          "id": 8,
          "start": 66.48,
          "end": 84.239,
          "en": "オプションズAPIには、スクリプトセットアップの処理がないので、そのスクリプトセットアップの処理が実行されるのと同じ、一番最初のタイミングで実行されるライフサイクルフックもありまして、それが",
          "zh": ""
        },
        {
          "id": 9,
          "start": 84.239,
          "end": 92.72,
          "en": "Createdというものになります。 また、さらにそのCreatedの直前に実行されるという",
          "zh": ""
        },
        {
          "id": 10,
          "start": 92.72,
          "end": 99.559,
          "en": "Before Createdというものもあったりします。 こんな風にライフサイクルフックは直接書くんですね。",
          "zh": ""
        },
        {
          "id": 11,
          "start": 99.559,
          "end": 109.839,
          "en": "こうすることで、コンソールを見るとわかるんですけれども、まず最初にBefore Created、Created、Before Mount、Mountedが実行されて、画面が更新されると前回の",
          "zh": ""
        },
        {
          "id": 12,
          "start": 109.839,
          "end": 119.319,
          "en": "カウンターウォッチャーがありますが、その後にBefore Update、Updatedが実行されます。 今ないんですけれども、このコンポーネントがUnmountされたら",
          "zh": ""
        },
        {
          "id": 13,
          "start": 119.319,
          "end": 131.399,
          "en": "Before UnmountとUnmountedが実行されます。 では次はPropsとEmitをOptions APIでどう書くかについて見たいと思います。",
          "zh": ""
        }
      ],
      "sourceLanguage": "ja"
    }
  ]
}
