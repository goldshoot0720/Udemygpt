      "sourceHash": "0b3b22c686d28aa6b89f6684927cfdaf63c2341569c0dcf90d2edd70c23b701b",
      "cues": [
        {
          "id": 1,
          "start": 0.68,
          "end": 12.41,
          "en": "ディレクティブの引数の部分だから、こういうキーアップとかですねをスクリプトのデータを使って指定する方法について見ていきたいと思います。",
          "zh": ""
        },
        {
          "id": 2,
          "start": 12.41,
          "end": 25.25,
          "en": "なので、例えばですけれども、イベントNAMEとしてでここにキーアップとかとしてこの定数をここで指定したいということですね。",
          "zh": ""
        },
        {
          "id": 3,
          "start": 25.28,
          "end": 29.36,
          "en": "これどうするのかというと、実は角括弧を使うんですね。",
          "zh": ""
        },
        {
          "id": 4,
          "start": 29.36,
          "end": 31.55,
          "en": "で、その中にイベントNAMEを入れます。",
          "zh": ""
        },
        {
          "id": 5,
          "start": 31.58,
          "end": 42.38,
          "en": "こうすることで、このキーアップの文字列がここに入ったという扱いになって、キーアップイベントに対してハンドラが追加されますので、スペース",
          "zh": ""
        },
        {
          "id": 6,
          "start": 42.38,
          "end": 46.34,
          "en": "とか撃つとちゃんとカウントアップされるような処理になります。",
          "zh": ""
        },
        {
          "id": 7,
          "start": 46.43,
          "end": 52.7,
          "en": "こういうですね、角括弧を使うことで動的にデータを指定することができるということを知っておいてください。",
          "zh": ""
        },
        {
          "id": 8,
          "start": 52.79,
          "end": 62.96,
          "en": "これはVONディレクティブだけじゃなくて、他の引数を取るディレクティブに対しても全て同じように使うことができますし、省略記法ですね。",
          "zh": ""
        },
        {
          "id": 9,
          "start": 62.99,
          "end": 71.87,
          "en": "じゃなかったとしても、同じように引数を指定するところに角括弧を使って、その中にデータを入れることで同じように使うことが出来ます。",
          "zh": ""
        },
        {
          "id": 10,
          "start": 71.9,
          "end": 75.59,
          "en": "もちろんVBINDとかも同じように使用できます。",
          "zh": ""
        },
        {
          "id": 11,
          "start": 75.74,
          "end": 87.77,
          "en": "では、次はVMODELディレクティブというインプットとかで入力されたデータをスクリプトでも使うためのディレクティブについて紹介したいと思います。",
          "zh": ""
        }
