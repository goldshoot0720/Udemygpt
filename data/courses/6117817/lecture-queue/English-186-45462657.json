          "id": 76,
          "start": 306.06,
          "end": 308.37,
          "en": "This is your friend's device.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 308.4,
          "end": 309.15,
          "en": "Okay.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 309.87,
          "end": 312.78,
          "en": "So for make a connection, establish connection.",
          "zh": ""
        },
