        },
        {
          "id": 11,
          "start": 44.63,
          "end": 45.86,
          "en": "So look at here.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 45.86,
          "end": 48.53,
          "en": "I'm currently at the official documentation of Laravel.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 48.53,
          "end": 51.98,
          "en": "So from the sidebar go to the eloquent ORM getting start.",
