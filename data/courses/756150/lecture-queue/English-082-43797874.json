{
  "version": 1,
  "courseId": 756150,
  "courseSlug": "the-complete-guide-to-angular-2",
  "courseTitle": "Angular - The Complete Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "43797874",
      "title": "Using a Service for Cross-Component Communication",
      "lectureOrder": 88,
      "videoOrder": 82,
      "sourceHash": "3b05b9d431c16ad6e34b7998d60f0cfe54c7c6634f35ffcfed15367e5708fc70",
      "cues": [
        {
          "id": 1,
          "start": 0.54,
          "end": 3.42,
          "en": "So how could we use a service",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.42,
          "end": 5.493,
          "en": "in this application to improve it?",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.54,
          "end": 9.54,
          "en": "Well, at the moment we are using this AppComponent",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.54,
          "end": 11.43,
          "en": "to derive the investment results,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.43,
          "end": 12.72,
          "en": "and that, of course, means",
          "zh": ""
        },
        {
          "id": 6,
          "start": 12.72,
          "end": 17.04,
          "en": "that data must be passed up from the UserInputComponent",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.04,
          "end": 19.44,
          "en": "through a custom event,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 19.44,
          "end": 22.555,
          "en": "through an output to the AppComponent.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.555,
          "end": 26.52,
          "en": "And it then must be passed down to the InvestmentResults",
          "zh": ""
        },
        {
          "id": 10,
          "start": 26.52,
          "end": 29.28,
          "en": "through an input from that component,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.28,
          "end": 31.447,
          "en": "so from that AppComponent.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.43,
          "end": 34.8,
          "en": "There's nothing wrong with this approach,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 34.8,
          "end": 37.47,
          "en": "but it's some extra code we have to write.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 37.47,
          "end": 40.53,
          "en": "Both the output as well as the input",
          "zh": ""
        },
        {
          "id": 15,
          "start": 40.53,
          "end": 43.44,
          "en": "could actually be avoided if we used a service.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 43.44,
          "end": 45.6,
          "en": "And that's, therefore, what I'll do now.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 45.6,
          "end": 48.24,
          "en": "So what I'll do here is I'll add a service",
          "zh": ""
        },
        {
          "id": 18,
          "start": 48.24,
          "end": 50.01,
          "en": "maybe next to the AppComponent.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 50.01,
          "end": 52.95,
          "en": "The exact position is not too important here,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 52.95,
          "end": 56.04,
          "en": "and I'll name it investment service.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 56.04,
          "end": 59.733,
          "en": "So the file is named investment.service.ts.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 60.99,
          "end": 63.06,
          "en": "And in there as you learned it,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 63.06,
          "end": 67.233,
          "en": "we can and should export a class called InvestmentService,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 68.1,
          "end": 70.28999999999999,
          "en": "which should be decorated",
          "zh": ""
        },
        {
          "id": 25,
          "start": 70.28999999999999,
          "end": 73.14,
          "en": "with the @Injectable decorator,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 73.14,
          "end": 75.903,
          "en": "which is imported from @angular/core.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 78,
          "end": 81.63,
          "en": "And to that decorator, you pass a configuration object",
          "zh": ""
        },
        {
          "id": 28,
          "start": 81.63,
          "end": 85.053,
          "en": "where you should set providedIn to root.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 86.64,
          "end": 89.19,
          "en": "This will make sure that Angular is able",
          "zh": ""
        },
        {
          "id": 30,
          "start": 89.19,
          "end": 91.38,
          "en": "to inject that service,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 91.38,
          "end": 96.38,
          "en": "and that components can request that service to be injected.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 96.75,
          "end": 99.09,
          "en": "Now inside of this service,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 99.09,
          "end": 103.02000000000001,
          "en": "I now wanna gather the data entered by the user",
          "zh": ""
        },
        {
          "id": 34,
          "start": 103.02000000000001,
          "end": 105.96000000000001,
          "en": "and derive those results.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 105.96000000000001,
          "end": 110.1,
          "en": "So what we could do here in this service is",
          "zh": ""
        },
        {
          "id": 36,
          "start": 110.1,
          "end": 113.37299999999999,
          "en": "take that code from our AppComponent,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 113.37299999999999,
          "end": 117.453,
          "en": "this onCalculateInvestmentResults method here,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 118.68,
          "end": 121.473,
          "en": "cut it and remove it from the AppComponent,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 122.67,
          "end": 126.12,
          "en": "and add it to the InvestmentService.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 126.12,
          "end": 128.67,
          "en": "Though I'll rename it to calculateInvestmentResults",
          "zh": ""
        },
        {
          "id": 41,
          "start": 129.75,
          "end": 134.75,
          "en": "since it will no longer be directly bound to a custom event.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 134.94,
          "end": 136.653,
          "en": "But that's just a naming thing.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 138,
          "end": 139.44,
          "en": "Now I wanna still use",
          "zh": ""
        },
        {
          "id": 44,
          "start": 139.44,
          "end": 143.04,
          "en": "that custom InvestmentInput data type,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 143.04,
          "end": 147.513,
          "en": "which is imported from that model file like this.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 149.61,
          "end": 151.47,
          "en": "And of course we must make sure",
          "zh": ""
        },
        {
          "id": 47,
          "start": 151.47,
          "end": 155.49,
          "en": "that we still store the results data either with a signal",
          "zh": ""
        },
        {
          "id": 48,
          "start": 155.49,
          "end": 157.53,
          "en": "or with a regular property.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 157.53,
          "end": 159.84,
          "en": "And again, I'll show you both.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 159.84,
          "end": 162.21,
          "en": "Now let's start by not using a signal,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 162.21,
          "end": 164.823,
          "en": "but instead by using a regular property.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 165.87,
          "end": 170.04,
          "en": "For that, we can add a property to that InvestmentService",
          "zh": ""
        },
        {
          "id": 53,
          "start": 170.04,
          "end": 173.553,
          "en": "and we could name it resultData just as before.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 174.93,
          "end": 177.27,
          "en": "So of course then, we should also go back",
          "zh": ""
        },
        {
          "id": 55,
          "start": 177.27,
          "end": 180.753,
          "en": "to the AppComponent and grab this data type here.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 182.19,
          "end": 184.89,
          "en": "And now we can and should also get rid of this signal here,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 184.89,
          "end": 186.72,
          "en": "of this resultsData signal,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 186.72,
          "end": 190.8,
          "en": "and get rid of all these imports which we no longer need,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 190.8,
          "end": 192.27,
          "en": "so that the app.component",
          "zh": ""
        },
        {
          "id": 60,
          "start": 192.27,
          "end": 195.213,
          "en": "or this entire file is now much leaner again.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 196.95,
          "end": 198.63,
          "en": "In the InvestmentService,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 198.63,
          "end": 201.42000000000002,
          "en": "we should set the type of resultData",
          "zh": ""
        },
        {
          "id": 63,
          "start": 201.42000000000002,
          "end": 205.35,
          "en": "to this type here, though it can initially be undefined.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 205.35,
          "end": 206.973,
          "en": "Hence, this question mark.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 208.26,
          "end": 211.32,
          "en": "And now of course, in this method,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 211.32,
          "end": 213.87,
          "en": "in this calculateInvestmentResults method,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 213.87,
          "end": 215.88,
          "en": "we should set this resultData",
          "zh": ""
        },
        {
          "id": 68,
          "start": 215.88,
          "end": 218.613,
          "en": "to this annualData that is derived here.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 220.29,
          "end": 223.11,
          "en": "So with that, we now got this method in this service",
          "zh": ""
        },
        {
          "id": 70,
          "start": 223.11,
          "end": 227.4,
          "en": "and we got a property which will eventually hold the result",
          "zh": ""
        },
        {
          "id": 71,
          "start": 227.4,
          "end": 230.553,
          "en": "of this method here, of this calculation.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 232.07999999999998,
          "end": 235.44,
          "en": "Now we can and should use this InvestmentService",
          "zh": ""
        },
        {
          "id": 73,
          "start": 235.44,
          "end": 238.86,
          "en": "in the files that need to interact with it,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 238.86,
          "end": 242.853,
          "en": "for example, in the user-input.component TypeScript file.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 243.99,
          "end": 247.32,
          "en": "There, instead of setting up this output,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 247.32,
          "end": 250.59,
          "en": "which should be removed therefore, and hence, you can",
          "zh": ""
        },
        {
          "id": 77,
          "start": 250.59,
          "end": 253.593,
          "en": "and should also remove this output function import,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 254.52,
          "end": 257.553,
          "en": "and this unneeded import.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 258.39,
          "end": 261.03,
          "en": "Instead of using that output, we can",
          "zh": ""
        },
        {
          "id": 80,
          "start": 261.03,
          "end": 265.563,
          "en": "and should now reach out to that service here in onSubmit.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 267.20799999999997,
          "end": 270.18,
          "en": "Therefore, of course, we must make that service available.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 270.18,
          "end": 272.37,
          "en": "And one way of doing that is with help",
          "zh": ""
        },
        {
          "id": 83,
          "start": 272.37,
          "end": 275.04,
          "en": "of this constructor function,",
          "zh": ""
        },
        {
          "id": 84,
          "start": 275.04,
          "end": 279.33,
          "en": "where you can inject that service with help of Angular",
          "zh": ""
        },
        {
          "id": 85,
          "start": 279.33,
          "end": 283.05,
          "en": "by adding a parameter with any name of your choice,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 283.05,
          "end": 285.927,
          "en": "for example, investmentService,",
          "zh": ""
        },
        {
          "id": 87,
          "start": 287.58,
          "end": 291.33,
          "en": "and by setting the type two InvestmentService.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 291.33,
          "end": 293.793,
          "en": "So to your service class name.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 294.99,
          "end": 298.65,
          "en": "And for that of course, you must import this service class",
          "zh": ""
        },
        {
          "id": 90,
          "start": 298.65,
          "end": 301.803,
          "en": "from this investment.service TypeScript file.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 304.59,
          "end": 308.003,
          "en": "This syntax here, this code, will tell Angular",
          "zh": ""
        },
        {
          "id": 92,
          "start": 308.003,
          "end": 312.48,
          "en": "that it should inject an instance of this InvestmentService",
          "zh": ""
        },
        {
          "id": 93,
          "start": 312.48,
          "end": 315.63,
          "en": "as a value for this InvestmentService parameter",
          "zh": ""
        },
        {
          "id": 94,
          "start": 315.63,
          "end": 318,
          "en": "into this constructor function.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 318,
          "end": 320.94,
          "en": "And since I need access to that injected service here",
          "zh": ""
        },
        {
          "id": 96,
          "start": 320.94,
          "end": 322.74,
          "en": "in this onSubmit method,",
          "zh": ""
        },
        {
          "id": 97,
          "start": 322.74,
          "end": 325.2,
          "en": "we then need to store this parameter",
          "zh": ""
        },
        {
          "id": 98,
          "start": 325.2,
          "end": 327.87,
          "en": "in a property of this class.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 327.87,
          "end": 330.72,
          "en": "And you can easily do this by using a shortcut",
          "zh": ""
        },
        {
          "id": 100,
          "start": 330.72,
          "end": 332.52,
          "en": "that's provided by TypeScript.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 332.52,
          "end": 335.58,
          "en": "By simply adding the public or private keyword",
          "zh": ""
        },
        {
          "id": 102,
          "start": 335.58,
          "end": 337.53,
          "en": "in front of this parameter,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 337.53,
          "end": 341.28,
          "en": "a new property with that name will be created",
          "zh": ""
        },
        {
          "id": 104,
          "start": 341.28,
          "end": 342.573,
          "en": "in this component.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 343.98,
          "end": 345.54,
          "en": "And here we can use private,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 345.54,
          "end": 348.87,
          "en": "because I don't need to use this service anywhere else.",
          "zh": ""
        },
        {
          "id": 107,
          "start": 348.87,
          "end": 351.57,
          "en": "I don't need to access it in the template",
          "zh": ""
        },
        {
          "id": 108,
          "start": 351.57,
          "end": 352.83299999999997,
          "en": "or anything like that.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 354.27,
          "end": 358.08,
          "en": "So with that, a property of this name here will be created",
          "zh": ""
        },
        {
          "id": 110,
          "start": 358.08,
          "end": 359.64,
          "en": "and added to the class",
          "zh": ""
        },
        {
          "id": 111,
          "start": 359.64,
          "end": 362.103,
          "en": "and it will hold such a service instance.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 363.21,
          "end": 365.49,
          "en": "Therefore, here in onSubmit, we can",
          "zh": ""
        },
        {
          "id": 113,
          "start": 365.49,
          "end": 368.97,
          "en": "and should now use this investmentService property",
          "zh": ""
        },
        {
          "id": 114,
          "start": 368.97,
          "end": 372.18,
          "en": "and then reach out to that service class instance",
          "zh": ""
        },
        {
          "id": 115,
          "start": 372.18,
          "end": 373.98,
          "en": "and call calculateInvestmentResults.",
          "zh": ""
        },
        {
          "id": 116,
          "start": 376.53,
          "end": 377.94,
          "en": "Well and now we can",
          "zh": ""
        },
        {
          "id": 117,
          "start": 377.94,
          "end": 380.46,
          "en": "and should pass this data object here",
          "zh": ""
        },
        {
          "id": 118,
          "start": 380.46,
          "end": 381.96,
          "en": "to calculateInvestmentResults.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 384,
          "end": 385.65,
          "en": "And we can and should get rid",
          "zh": ""
        },
        {
          "id": 120,
          "start": 385.65,
          "end": 388.413,
          "en": "of this calculate.emit call here.",
          "zh": ""
        },
        {
          "id": 121,
          "start": 389.61,
          "end": 392.61,
          "en": "So that's how we now trigger this service method",
          "zh": ""
        },
        {
          "id": 122,
          "start": 392.61,
          "end": 394.14,
          "en": "when the form is submitted",
          "zh": ""
        },
        {
          "id": 123,
          "start": 394.14,
          "end": 396.837,
          "en": "from inside this UserInputComponent.",
          "zh": ""
        },
        {
          "id": 124,
          "start": 398.7,
          "end": 402.39,
          "en": "Now we're interested in our calculation result,",
          "zh": ""
        },
        {
          "id": 125,
          "start": 402.39,
          "end": 404.73,
          "en": "so in that resultData here",
          "zh": ""
        },
        {
          "id": 126,
          "start": 404.73,
          "end": 407.67,
          "en": "in the investment-results.component.",
          "zh": ""
        },
        {
          "id": 127,
          "start": 407.67,
          "end": 412.353,
          "en": "So in this file we should now actually remove this input,",
          "zh": ""
        },
        {
          "id": 128,
          "start": 413.22,
          "end": 416.043,
          "en": "and remove this input import,",
          "zh": ""
        },
        {
          "id": 129,
          "start": 417.33,
          "end": 420.9,
          "en": "and also inject that service here, so that we get access",
          "zh": ""
        },
        {
          "id": 130,
          "start": 420.9,
          "end": 424.35,
          "en": "to the same service class instance that we used",
          "zh": ""
        },
        {
          "id": 131,
          "start": 424.35,
          "end": 427.86,
          "en": "for calculating the results here in this component",
          "zh": ""
        },
        {
          "id": 132,
          "start": 427.86,
          "end": 429.543,
          "en": "to get the results.",
          "zh": ""
        },
        {
          "id": 133,
          "start": 431.19,
          "end": 433.92,
          "en": "Now we can again inject this service instance",
          "zh": ""
        },
        {
          "id": 134,
          "start": 433.92,
          "end": 435.48,
          "en": "with help of the constructor",
          "zh": ""
        },
        {
          "id": 135,
          "start": 435.48,
          "end": 438.42,
