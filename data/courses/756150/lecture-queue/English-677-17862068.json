        },
        {
          "id": 155,
          "start": 406.53,
          "end": 409.29,
          "en": "which extend this base configuration file",
          "zh": ""
        },
        {
          "id": 156,
          "start": 409.29,
          "end": 411.57,
          "en": "for testing, for the testing environment",
          "zh": ""
        },
        {
          "id": 157,
          "start": 411.57,
          "end": 414,
          "en": "and for the real app compilation.",
          "zh": ""
        },
        {
          "id": 158,
          "start": 414,
          "end": 417.27,
          "en": "And there's some detailed settings can be set",
