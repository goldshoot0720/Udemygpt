        },
        {
          "id": 162,
          "start": 425.58,
          "end": 428.22,
          "en": "And that's the Angular compiler options.",
          "zh": ""
        },
        {
          "id": 163,
          "start": 428.22,
          "end": 430.68,
          "en": "This is picked up by the Angular compiler",
          "zh": ""
        },
        {
          "id": 164,
          "start": 430.68,
          "end": 432.72,
          "en": "which is not the TypeScript compiler",
          "zh": ""
        },
        {
          "id": 165,
          "start": 432.72,
          "end": 434.85,
          "en": "which is the compiler that kicks in",
