        },
        {
          "id": 18,
          "start": 48.12,
          "end": 48.953,
          "en": "of course.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 48.953,
          "end": 51.06,
          "en": "Well then we still have this in line",
          "zh": ""
        },
        {
          "id": 20,
          "start": 51.06,
          "end": 54.57,
