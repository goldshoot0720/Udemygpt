      "sourceHash": "46f4b38e812e4ff779e243d5e1cf7c6e7d7e79e8e740c399718f1582f4090987",
      "cues": [
        {
          "id": 1,
          "start": 0.6,
          "end": 3.18,
          "en": "So now we learned about static",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.18,
          "end": 6.93,
          "en": "and dynamic data that can be provided to routes",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.93,
          "end": 8.94,
          "en": "and their components.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.94,
          "end": 11.82,
          "en": "Now you can get access to both the static",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.82,
          "end": 16.71,
          "en": "and the dynamic data, either through inputs",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.71,
          "end": 19.533,
          "en": "if you have the appropriate configuration,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.37,
          "end": 23.37,
          "en": "or also in another way,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 23.37,
          "end": 25.38,
          "en": "which I also wanna show you here",
          "zh": ""
        },
        {
          "id": 9,
          "start": 25.38,
          "end": 27.69,
          "en": "since you of course should know about it.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.69,
          "end": 31.95,
          "en": "And for that I'll bring back OnInit here",
          "zh": ""
        },
        {
          "id": 11,
          "start": 31.95,
          "end": 36.414,
          "en": "to demonstrate you that other way and re add NG OnInit",
          "zh": ""
        },
        {
          "id": 12,
          "start": 36.414,
          "end": 41.414,
          "en": "because that other way relies on the injected",
          "zh": ""
        },
        {
          "id": 13,
          "start": 41.88,
          "end": 45.7,
          "en": "activated route just as we did it",
          "zh": ""
        },
        {
          "id": 14,
          "start": 46.759,
          "end": 48.03,
          "en": "before for the route parameter.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 48.03,
          "end": 51.66,
          "en": "So here I'll inject the activated route again",
          "zh": ""
        },
        {
          "id": 16,
          "start": 51.66,
          "end": 53.77,
          "en": "into this user tasks component",
          "zh": ""
        },
        {
          "id": 17,
          "start": 54.63,
          "end": 57.27,
          "en": "because it's now this activated route",
          "zh": ""
        },
        {
          "id": 18,
          "start": 57.27,
          "end": 61.17,
          "en": "that does not just have this paramMap property,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 61.17,
          "end": 65.343,
          "en": "which we used before, but that also has a data property.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 66.39,
          "end": 71.34,
          "en": "And that data property holds the merged static",
          "zh": ""
        },
        {
          "id": 21,
          "start": 71.34,
          "end": 75.436,
          "en": "and dynamically resolved data, or to be precise,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 75.436,
          "end": 77.981,
          "en": "it provides an observable that in the end",
          "zh": ""
        },
        {
          "id": 23,
          "start": 77.981,
          "end": 82.981,
          "en": "gives you that merged data and that will re-emit a value",
          "zh": ""
        },
        {
          "id": 24,
          "start": 83.94,
          "end": 88.173,
          "en": "whenever that route changes and the data therefore changes.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 89.13,
          "end": 91.143,
          "en": "So you could subscribe here,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 92.52000000000001,
          "end": 95.91,
          "en": "and set up that next function where you get that data.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 95.91,
          "end": 98.7,
          "en": "And then if I log that data here,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 98.7,
          "end": 102.39,
          "en": "you will see that what we log here will be an object",
          "zh": ""
        },
        {
          "id": 29,
          "start": 102.39,
          "end": 105.66,
          "en": "that contains both that message and the username,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 105.66,
          "end": 109.90899999999999,
          "en": "which will change every time we change the user.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 109.90899999999999,
          "end": 113.75999999999999,
          "en": "Of course, we should also clean up that subscription here.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 113.75999999999999,
          "end": 115.95,
          "en": "But to keep things simple here",
          "zh": ""
        },
        {
          "id": 33,
          "start": 115.95,
          "end": 118.083,
          "en": "and just focus on this feature,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 119.30199999999999,
          "end": 120.593,
          "en": "I'll leave it like this for now.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 121.488,
          "end": 122.37,
          "en": "And if you then save everything,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 122.37,
          "end": 124.71,
          "en": "you'll see that I got this object",
          "zh": ""
        },
        {
          "id": 37,
          "start": 124.71,
          "end": 126.6,
          "en": "being logged here initially,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 126.6,
          "end": 129.99,
          "en": "and it contains the static data, the message,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 129.99,
          "end": 133.115,
          "en": "and the dynamically resolved username.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 133.115,
          "end": 137.46,
          "en": "And if I switch to a different user, I got a new object",
          "zh": ""
        },
        {
          "id": 41,
          "start": 137.46,
          "end": 140.469,
          "en": "that contains the updated data,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 140.469,
          "end": 143.403,
          "en": "the static one, and the dynamically resolved one.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 144.57,
          "end": 148.11,
          "en": "And here I will not use this approach.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 148.11,
          "end": 149.43,
          "en": "I'll comment this out",
          "zh": ""
        },
        {
          "id": 45,
          "start": 149.43,
          "end": 152.52,
          "en": "because I will instead use this input here",
          "zh": ""
        },
        {
          "id": 46,
          "start": 152.52,
          "end": 155.286,
          "en": "since it's leaner and simpler.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 155.286,
          "end": 157.32,
          "en": "But of course, you should also know about this approach",
          "zh": ""
        },
        {
          "id": 48,
          "start": 157.32,
          "end": 160.07999999999998,
          "en": "because you might encounter it in other projects",
          "zh": ""
        },
        {
          "id": 49,
          "start": 160.07999999999998,
          "end": 162.57,
          "en": "and it simply is an alternative way",
          "zh": ""
        },
        {
          "id": 50,
          "start": 162.57,
          "end": 164.463,
          "en": "of getting hold of that data.",
          "zh": ""
        }
      ]
    }
