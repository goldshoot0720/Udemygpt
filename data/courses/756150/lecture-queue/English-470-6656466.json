  "lectures": [
    {
      "id": "6656466",
      "title": "TD: Understanding Form State",
      "lectureOrder": 513,
      "videoOrder": 470,
      "sourceHash": "8f0406cba899c182152466be6e29418ce3772d9383c82a27fb6196d928a7c0a5",
      "cues": [
        {
          "id": 1,
          "start": 2.43,
          "end": 3.57,
          "en": "-: In the last lecture.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.57,
          "end": 5.31,
          "en": "we learned how we can submit a form",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.31,
          "end": 6.93,
          "en": "created by Angular,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 6.93,
          "end": 9.15,
          "en": "and how we can access to this",
          "zh": ""
        },
        {
          "id": 5,
          "start": 9.15,
          "end": 12.6,
          "en": "object Angular created for us.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 12.6,
          "end": 14.79,
          "en": "Now, we had a look at the value property",
          "zh": ""
        },
        {
          "id": 7,
          "start": 14.79,
          "end": 18.96,
          "en": "which stores the input of the user in key value pairs.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 18.96,
          "end": 22.44,
          "en": "We see that we always have a lot of our properties.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.44,
          "end": 25.35,
          "en": "And that's pretty cool about this JavaScript object",
          "zh": ""
        },
        {
          "id": 10,
          "start": 25.35,
          "end": 28.62,
          "en": "about the form handling by Angular.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 28.62,
          "end": 32.94,
          "en": "It allows us to really understand the state of our form.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.94,
          "end": 35.7,
          "en": "We can see which controls we registered here",
          "zh": ""
        },
        {
          "id": 13,
          "start": 35.7,
          "end": 38.52,
          "en": "on the controls object, email, secret, and username",
          "zh": ""
        },
        {
          "id": 14,
          "start": 38.52,
          "end": 41.19,
          "en": "and each controls of type form control.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 41.19,
          "end": 44.13,
          "en": "Of course, a type made available by Angular",
          "zh": ""
        },
        {
          "id": 16,
          "start": 44.13,
          "end": 46.77,
          "en": "where each control then has a couple of properties,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 46.77,
          "end": 48.51,
          "en": "mostly the same properties we have",
          "zh": ""
        },
        {
          "id": 18,
          "start": 48.51,
          "end": 50.685,
          "en": "on the overall form though,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 50.685,
          "end": 53.55,
          "en": "and therefore let's go back to the overall form.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 53.55,
          "end": 56.16,
          "en": "For example, properties like dirty,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 56.16,
          "end": 59.16,
          "en": "disabled, enabled, errors",
          "zh": ""
        },
        {
          "id": 22,
          "start": 59.16,
          "end": 60.24,
          "en": "and most of the properties",
          "zh": ""
        },
        {
          "id": 23,
          "start": 60.24,
          "end": 62.52,
          "en": "should be pretty self-explanatory.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 62.52,
          "end": 64.35,
          "en": "Dirty for example, is true",
          "zh": ""
        },
        {
          "id": 25,
          "start": 64.35,
          "end": 67.59,
          "en": "because we changed something about that form.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 67.59,
          "end": 70.98,
          "en": "If I reload the page and submit it now,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 70.98,
          "end": 73.2,
          "en": "you will see the dirty is false",
          "zh": ""
        },
        {
          "id": 28,
          "start": 73.2,
          "end": 75.53999999999999,
          "en": "because I didn't type into any input.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 75.53999999999999,
          "end": 79.35,
          "en": "So therefore of course, dirty is false.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 79.35,
          "end": 82.44,
          "en": "Disabled would be true if the form was disabled",
          "zh": ""
        },
        {
          "id": 31,
          "start": 82.44,
          "end": 83.7,
          "en": "for some reason.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 83.7,
          "end": 85.26,
          "en": "Invalid is false",
          "zh": ""
        },
        {
          "id": 33,
          "start": 85.26,
          "end": 87.81,
          "en": "because we haven't added any validators.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 87.81,
          "end": 89.25,
          "en": "So it isn't invalid.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 89.25,
          "end": 90.6,
          "en": "It is indeed valid.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 90.6,
          "end": 92.64,
          "en": "You do have the valid property down here too,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 92.64,
          "end": 94.5,
          "en": "so the form is valid right now.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 94.5,
          "end": 96.78,
          "en": "We will later learn how to add validators",
          "zh": ""
        },
        {
          "id": 39,
          "start": 96.78,
          "end": 97.613,
          "en": "to make sure that",
          "zh": ""
        },
        {
          "id": 40,
          "start": 97.613,
          "end": 101.043,
          "en": "a valid email address has to be entered, for example.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 102.18,
          "end": 105.18,
          "en": "And we also have touched for example,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 105.18,
          "end": 108.09,
          "en": "to see did we click into some of the fields?",
          "zh": ""
        },
        {
          "id": 43,
          "start": 108.09,
          "end": 109.68,
          "en": "The difference to dirty would be that",
          "zh": ""
        },
        {
          "id": 44,
          "start": 109.68,
          "end": 112.32,
          "en": "for dirty we have to change the field,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 112.32,
          "end": 114.63,
          "en": "have to change the value of a field.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 114.63,
          "end": 116.91,
          "en": "For touch, we simply have to click into it",
          "zh": ""
        },
        {
          "id": 47,
          "start": 116.91,
          "end": 118.5,
          "en": "and now it will be touched.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 118.5,
          "end": 119.88,
          "en": "And you will later learn",
          "zh": ""
        },
        {
          "id": 49,
          "start": 119.88,
          "end": 123.45,
          "en": "how these properties can be helpful in",
          "zh": ""
        },
        {
          "id": 50,
          "start": 123.45,
          "end": 125.88,
          "en": "while changing the user experience.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 125.88,
          "end": 128.34,
          "en": "For example, disabling the submit button",
          "zh": ""
        },
        {
          "id": 52,
          "start": 128.34,
          "end": 130.35,
          "en": "if the form is not valid.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 130.35,
          "end": 132.39,
          "en": "I will come back to this later.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 132.39,
          "end": 133.53,
          "en": "It's important to understand",
          "zh": ""
        },
        {
          "id": 55,
          "start": 133.53,
          "end": 135.27,
          "en": "that you have all these properties,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 135.27,
          "end": 137.22,
          "en": "and definitely feel free to dive",
          "zh": ""
        },
        {
          "id": 57,
          "start": 137.22,
          "end": 139.95,
          "en": "into the output we logged here",
          "zh": ""
        },
        {
          "id": 58,
          "start": 139.95,
          "end": 142.05,
          "en": "and understand which properties you have,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 142.05,
          "end": 143.34,
          "en": "how they change,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 143.34,
          "end": 145.95,
          "en": "which properties the individual controls have,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 145.95,
          "end": 147.063,
          "en": "and so on.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
