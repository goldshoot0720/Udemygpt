  "courseSlug": "the-complete-guide-to-angular-2",
  "courseTitle": "Angular - The Complete Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "17862114",
      "title": "Understanding \"Differential Loading\"",
      "lectureOrder": 745,
      "videoOrder": 685,
      "sourceHash": "c1273e3dbaf55e0a394a60384abb2682c2de5afa5ac2d69a9c87b30abd29dd0c",
      "cues": [
        {
          "id": 1,
          "start": 2.25,
          "end": 4.35,
          "en": "Speaker 1: So now that we talked about deployment,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.35,
          "end": 6.3,
          "en": "let me come back to the browsers list.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.3,
          "end": 7.71,
          "en": "I mentioned that this is important",
          "zh": ""
        },
        {
          "id": 4,
          "start": 7.71,
          "end": 10.11,
          "en": "for telling Angular which browsers you want to support,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.11,
          "end": 10.943,
          "en": "and this of course,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 10.943,
          "end": 12.66,
          "en": "is related to deployment.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 12.66,
          "end": 14.97,
          "en": "Angular will take the information here,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 14.97,
          "end": 18.09,
          "en": "to auto-prefix your CSS code correctly,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 18.09,
          "end": 22.401,
          "en": "but also so that it knows which polyfills to load",
          "zh": ""
        },
        {
          "id": 10,
          "start": 22.401,
          "end": 26.94,
          "en": "and which different versions of bundles it should generate,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 26.94,
          "end": 28.83,
          "en": "and what do I mean by that?",
          "zh": ""
        },
        {
          "id": 12,
          "start": 28.83,
          "end": 30.33,
          "en": "Angular has a built-in feature",
          "zh": ""
        },
        {
          "id": 13,
          "start": 30.33,
          "end": 32.1,
          "en": "called \"differential loading\".",
          "zh": ""
        },
        {
          "id": 14,
          "start": 32.1,
          "end": 32.933,
          "en": "Now,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 32.933,
          "end": 33.84,
          "en": "we have our Angular app,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 33.84,
          "end": 34.71,
          "en": "and we're hosting this,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 34.71,
          "end": 37.47,
          "en": "let's say on Firebase or AWS S3",
          "zh": ""
        },
        {
          "id": 18,
          "start": 37.47,
          "end": 39.15,
          "en": "or any other hosting provider,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 39.15,
          "end": 41.46,
          "en": "no matter if we used engine deploy or not.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 41.46,
          "end": 43.29,
          "en": "We're hosting it somewhere.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 43.29,
          "end": 44.123,
          "en": "And now,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 44.123,
          "end": 47.16,
          "en": "our app hopefully gets visited by users.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 47.16,
          "end": 48.45,
          "en": "We might have User A,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 48.45,
          "end": 49.77,
          "en": "who has a modern browser,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 49.77,
          "end": 50.603,
          "en": "and User B,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 50.603,
          "end": 51.54,
          "en": "who has a legacy,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 51.54,
          "end": 53.55,
          "en": "so an older browser.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 53.55,
          "end": 54.6,
          "en": "Now the thing is,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 54.6,
          "end": 56.46,
          "en": "User A with a modern browser,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 56.46,
          "end": 59.34,
          "en": "let's say the latest version of Chrome or Firefox,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 59.34,
          "end": 61.86,
          "en": "needs no or less polyfills.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 61.86,
          "end": 64.229,
          "en": "All the features we use will work there just fine,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 64.229,
          "end": 65.062,
          "en": "and therefore,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 65.062,
          "end": 68.85,
          "en": "we could ship a smaller code bundle to the user",
          "zh": ""
        },
        {
          "id": 35,
          "start": 68.85,
          "end": 71.78999999999999,
          "en": "because our code doesn't have to be compiled down",
          "zh": ""
        },
        {
          "id": 36,
          "start": 71.78999999999999,
          "end": 74.03999999999999,
          "en": "to super-old versions of JavaScript,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 74.03999999999999,
          "end": 77.46000000000001,
          "en": "and we might not need any or all polyfills,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 77.46000000000001,
          "end": 79.86,
          "en": "so these packages which enable certain features",
          "zh": ""
        },
        {
          "id": 39,
          "start": 79.86,
          "end": 81.15,
          "en": "in a browser.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 81.15,
          "end": 81.983,
          "en": "User B,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 81.983,
          "end": 83.07,
          "en": "on the other hand,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 83.07,
          "end": 85.5,
          "en": "needs a version which is compiled down",
          "zh": ""
        },
        {
          "id": 43,
          "start": 85.5,
          "end": 86.753,
          "en": "to way older code,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 86.753,
          "end": 89.31,
          "en": "and he or she needs all,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 89.31,
          "end": 90.307,
          "en": "or at least more,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 90.307,
          "end": 91.59,
          "en": "polyfills added,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 91.59,
          "end": 93.6,
          "en": "so a bigger bundle needs to be shipped.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 93.6,
          "end": 95.16,
          "en": "It is what it is.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 95.16,
          "end": 96,
          "en": "The problem is,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 96,
          "end": 96.833,
          "en": "of course,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 96.833,
          "end": 98.61,
          "en": "we can always ship a bigger bundle",
          "zh": ""
        },
        {
          "id": 52,
          "start": 98.61,
          "end": 101.16,
          "en": "so that we support both B and A.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 101.16,
          "end": 103.44,
          "en": "If we always ship the most optimized",
          "zh": ""
        },
        {
          "id": 54,
          "start": 103.44,
          "end": 105.36,
          "en": "and smallest bundle possible,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 105.36,
          "end": 106.65,
          "en": "we ignore User B.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 106.65,
          "end": 107.483,
          "en": "There,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 107.483,
          "end": 108.63,
          "en": "this just won't run.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 108.63,
          "end": 109.86,
          "en": "With differential loading,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 109.86,
          "end": 110.705,
          "en": "we do both.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 110.705,
          "end": 114.47999999999999,
          "en": "The Angular CLI actually produces multiple versions",
          "zh": ""
        },
        {
          "id": 61,
          "start": 114.47999999999999,
          "end": 115.313,
          "en": "of your app",
          "zh": ""
        },
        {
          "id": 62,
          "start": 115.313,
          "end": 116.43,
          "en": "when it builds it for production,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 116.43,
          "end": 117.93,
          "en": "you could say,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 117.93,
          "end": 120.18,
          "en": "and it produces a small code file",
          "zh": ""
        },
        {
          "id": 65,
          "start": 120.18,
          "end": 122.91,
          "en": "which runs first when a user visits your page",
          "zh": ""
        },
        {
          "id": 66,
          "start": 122.91,
          "end": 125.79,
          "en": "to identify which browser this user is using,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 125.79,
          "end": 129.21,
          "en": "and then this small initial code file determines",
          "zh": ""
        },
        {
          "id": 68,
          "start": 129.21,
          "end": 131.73,
          "en": "which bundle gets served to the user.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 131.73,
          "end": 133.71,
          "en": "So with differential loading,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 133.71,
          "end": 137.76,
          "en": "a user using a modern browser has to download less code",
          "zh": ""
        },
        {
          "id": 71,
          "start": 137.76,
          "end": 140.01,
          "en": "than a user using an older browser,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 140.01,
          "end": 142.2,
          "en": "and this gives you the best of both worlds.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 142.2,
          "end": 144.12,
          "en": "You support all users,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 144.12,
          "end": 146.52,
          "en": "but you make sure that every user just has",
          "zh": ""
        },
        {
          "id": 75,
          "start": 146.52,
          "end": 149.04,
          "en": "to download the code it really needs,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 149.04,
          "end": 151.164,
          "en": "and this is built into Angular.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 151.164,
          "end": 153.27,
          "en": "In our \"dist\" folder,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 153.27,
          "end": 155.977,
          "en": "we actually see two versions of every file,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 155.977,
          "end": 156.81,
          "en": "right,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 156.81,
          "end": 157.643,
          "en": "two \"main\",",
          "zh": ""
        },
        {
          "id": 81,
          "start": 157.643,
          "end": 158.476,
          "en": "two \"polyfills\",",
          "zh": ""
        },
        {
          "id": 82,
          "start": 158.476,
          "end": 159.39,
          "en": "and two \"runtime\" files,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 159.39,
          "end": 161.317,
          "en": "and you see the names are different.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 161.317,
          "end": 163.257,
          "en": "\"Es5\" basically is the version",
          "zh": ""
        },
        {
          "id": 85,
          "start": 163.257,
          "end": 165.247,
          "en": "for the users with the older browsers.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 165.247,
          "end": 166.98,
          "en": "\"Es2015\",",
          "zh": ""
        },
        {
          "id": 87,
          "start": 166.98,
          "end": 168.99,
          "en": "sounds similar but it's totally different,",
          "zh": ""
        },
        {
          "id": 88,
          "start": 168.99,
          "end": 171.24,
          "en": "uses way more recent JavaScript,",
          "zh": ""
        },
        {
          "id": 89,
          "start": 171.24,
          "end": 172.073,
          "en": "and therefore,",
          "zh": ""
        },
        {
          "id": 90,
          "start": 172.073,
          "end": 173.76,
          "en": "all of it will be smaller.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 173.76,
          "end": 174.69,
          "en": "For \"polyfills\",",
          "zh": ""
        },
        {
          "id": 92,
          "start": 174.69,
          "end": 175.62,
          "en": "it's the same.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 175.62,
          "end": 176.453,
          "en": "Of course here,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 176.453,
          "end": 178.32,
          "en": "they both look very triptic and large,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 178.32,
          "end": 179.153,
          "en": "but actually,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 179.153,
          "end": 181.2,
          "en": "the more modern version will be smaller,",
          "zh": ""
        },
        {
          "id": 97,
          "start": 181.2,
          "end": 183.51,
          "en": "and the same for the \"runtime\" here.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 183.51,
          "end": 186.3,
          "en": "So these are all files that you deploy,",
          "zh": ""
        },
        {
          "id": 99,
          "start": 186.3,
          "end": 188.97,
          "en": "and they will be executed automatically.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 188.97,
          "end": 190.17,
          "en": "In index.html,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 190.17,
          "end": 191.003,
          "en": "indeed,",
          "zh": ""
        },
        {
          "id": 102,
          "start": 191.003,
          "end": 192.75,
          "en": "the \"runtime\" file executes first,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 192.75,
          "end": 193.86,
          "en": "and there,",
          "zh": ""
        },
        {
          "id": 104,
          "start": 193.86,
          "end": 196.98,
          "en": "it then decides which other files it needs to load,",
          "zh": ""
        },
        {
          "id": 105,
          "start": 196.98,
          "end": 198.69,
          "en": "so that's how this works.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 198.69,
          "end": 200.73,
          "en": "So this is the differential loading feature",
          "zh": ""
        },
        {
          "id": 107,
          "start": 200.73,
          "end": 202.41,
          "en": "which you get out of the box,",
          "zh": ""
        },
        {
          "id": 108,
          "start": 202.41,
          "end": 205.2,
          "en": "and you do partly configure it here",
          "zh": ""
        },
        {
          "id": 109,
          "start": 205.2,
          "end": 206.91,
          "en": "with the browser list.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 206.91,
          "end": 207.743,
          "en": "There,",
          "zh": ""
        },
        {
          "id": 111,
          "start": 207.743,
          "end": 210.36,
          "en": "you tell Angular which browsers you want to support,",
          "zh": ""
        },
        {
          "id": 112,
          "start": 210.36,
          "end": 213.39,
          "en": "and this tells Angular how it should build",
          "zh": ""
        },
        {
          "id": 113,
          "start": 213.39,
          "end": 215.91,
          "en": "and optimize these different bundles.",
          "zh": ""
        },
        {
          "id": 114,
          "start": 215.91,
          "end": 216.743,
          "en": "In addition,",
          "zh": ""
        },
        {
          "id": 115,
          "start": 216.743,
          "end": 219.39,
          "en": "you have a setting in tsconfig.json",
          "zh": ""
        },
        {
          "id": 116,
          "start": 219.39,
          "end": 222.06,
          "en": "where you specify the target JavaScript version",
          "zh": ""
        },
        {
          "id": 117,
          "start": 222.06,
          "end": 223.227,
          "en": "you wanna compile for,",
          "zh": ""
        },
        {
          "id": 118,
          "start": 223.227,
          "end": 224.06,
          "en": "and here,",
          "zh": ""
        },
        {
          "id": 119,
          "start": 224.06,
          "end": 226.44,
          "en": "it's compiling for modern JavaScript.",
          "zh": ""
        },
        {
          "id": 120,
          "start": 226.44,
          "end": 228.87,
          "en": "If you set this to an older one,",
          "zh": ""
        },
        {
          "id": 121,
          "start": 228.87,
          "end": 232.23,
          "en": "then you force all users to use this older one.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 232.23,
          "end": 234.93,
          "en": "So differential loading really just is a feature",
          "zh": ""
        },
        {
          "id": 123,
          "start": 234.93,
          "end": 236.01,
          "en": "to be aware of,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 236.01,
          "end": 238.17000000000002,
          "en": "not something where you need to do much.",
          "zh": ""
        },
        {
          "id": 125,
          "start": 238.17000000000002,
          "end": 240.15,
          "en": "You have it out of the box,",
          "zh": ""
        },
        {
          "id": 126,
          "start": 240.15,
          "end": 242.7,
          "en": "and this allows you to ship code",
          "zh": ""
        },
        {
          "id": 127,
          "start": 242.7,
          "end": 244.44,
          "en": "that works for all users",
          "zh": ""
        },
        {
          "id": 128,
          "start": 244.44,
          "end": 246.179,
          "en": "but does not force all users",
          "zh": ""
        },
        {
          "id": 129,
          "start": 246.179,
          "end": 248.97,
          "en": "to download all available code.",
          "zh": ""
        },
        {
          "id": 130,
          "start": 248.97,
          "end": 249.803,
          "en": "Also,",
          "zh": ""
        },
        {
          "id": 131,
          "start": 249.803,
          "end": 250.8,
          "en": "one word about polyfills,",
          "zh": ""
        },
        {
          "id": 132,
          "start": 250.8,
          "end": 252.488,
          "en": "you've got this polyfills.ts file.",
          "zh": ""
        },
        {
          "id": 133,
          "start": 252.488,
          "end": 254.31,
          "en": "Now crucial polyfills,",
          "zh": ""
        },
        {
          "id": 134,
          "start": 254.31,
          "end": 255.143,
          "en": "like this one,",
          "zh": ""
        },
        {
          "id": 135,
          "start": 255.143,
          "end": 257.37,
          "en": "are included by default.",
          "zh": ""
        },
        {
          "id": 136,
          "start": 257.37,
          "end": 259.5,
          "en": "Simply by having this import statement here,",
          "zh": ""
        },
        {
          "id": 137,
          "start": 259.5,
          "end": 261.18,
          "en": "Angular will do the rest.",
          "zh": ""
        },
        {
          "id": 138,
          "start": 261.18,
          "end": 263.64,
          "en": "If you are using certain features like,",
          "zh": ""
        },
        {
          "id": 139,
          "start": 263.64,
          "end": 265.56,
