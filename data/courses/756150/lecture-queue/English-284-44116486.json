      "sourceHash": "fee40cd2377ec66a140d3b0f36ccc363aa29efa2388e9ee6cb5bf408594372c4",
      "cues": [
        {
          "id": 1,
          "start": 0.51,
          "end": 2.85,
          "en": "So at this point,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.85,
          "end": 6,
          "en": "this application is pretty much finished,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6,
          "end": 9.15,
          "en": "but now with all those resolvers",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.15,
          "end": 13.296,
          "en": "and guards we added, there are parts of this application",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.296,
          "end": 14.913,
          "en": "that are broken.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.75,
          "end": 20.75,
          "en": "For example, if I add a new task here",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.85,
          "end": 22.95,
          "en": "and I click create,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.95,
          "end": 26.67,
          "en": "I also get this confirmation pop-up here.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 26.67,
          "end": 29.13,
          "en": "And that should not be the case.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 29.13,
          "end": 32.49,
          "en": "It should only appear if we're leaving this page",
          "zh": ""
        },
        {
          "id": 11,
          "start": 32.49,
          "end": 34.41,
          "en": "because we're clicking cancel",
          "zh": ""
        },
        {
          "id": 12,
          "start": 34.41,
          "end": 36.783,
          "en": "or because we're using the back button.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 38.46,
          "end": 41.73,
          "en": "Therefore, what we might want to do",
          "zh": ""
        },
        {
          "id": 14,
          "start": 41.73,
          "end": 44.73,
          "en": "in our new task component file",
          "zh": ""
        },
        {
          "id": 15,
          "start": 44.73,
          "end": 47.53,
          "en": "and there in the CanLeaveEditPage CanDeactivateGuard",
          "zh": ""
        },
        {
          "id": 16,
          "start": 50.37,
          "end": 53.013,
          "en": "is that we might wanna change our condition here.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 54.09,
          "end": 58.2,
          "en": "And what I'll do is I'll add a new Signal here,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 58.2,
          "end": 60.57,
          "en": "which we could call submitted.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 60.57,
          "end": 62.4,
          "en": "Obviously the name is up to you.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 62.4,
          "end": 66.873,
          "en": "And I'll give it an initial value of false.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 68.55,
          "end": 71.19,
          "en": "And then here in onSubmit,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 71.19,
          "end": 73.92,
          "en": "before I try to navigate away,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 73.92,
          "end": 76.26,
          "en": "I'll actually set my Signal,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 76.26,
          "end": 78.963,
          "en": "my submitted Signal, here to True.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 80.37,
          "end": 82.02,
          "en": "And now we can simply use",
          "zh": ""
        },
        {
          "id": 26,
          "start": 82.02,
          "end": 85.173,
          "en": "that Signal here in CanLeaveEditPage.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 86.85,
          "end": 89.03999999999999,
          "en": "And actually for my purpose here,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 89.03999999999999,
          "end": 90.66,
          "en": "I don't even need a Signal.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 90.66,
          "end": 94.53,
          "en": "I can just use a regular property",
          "zh": ""
        },
        {
          "id": 30,
          "start": 94.53,
          "end": 96.9,
          "en": "and simply set that to true",
          "zh": ""
        },
        {
          "id": 31,
          "start": 96.9,
          "end": 100.5,
          "en": "because I'm not doing any reactive data binding here.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 100.5,
          "end": 103.77000000000001,
          "en": "I'm not trying to use it in the template.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 103.77000000000001,
          "end": 105.96000000000001,
          "en": "I don't need a subscription.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 105.96000000000001,
          "end": 109.32,
          "en": "I don't need to be informed about changes",
          "zh": ""
        },
        {
          "id": 35,
          "start": 109.32,
          "end": 111.81,
          "en": "to this submitted property value.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 111.81,
          "end": 114,
          "en": "Instead, I'm only adding it here",
          "zh": ""
        },
        {
          "id": 37,
          "start": 114,
          "end": 116.88,
          "en": "so that in CanLeaveEditPage,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 116.88,
          "end": 118.89,
          "en": "I can add a new check",
          "zh": ""
        },
        {
          "id": 39,
          "start": 118.89,
          "end": 123.15,
          "en": "and check if component.submitted is true.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 123.15,
          "end": 125.07,
          "en": "And if that's the case,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 125.07,
          "end": 128.223,
          "en": "I will simply return true here.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 131.25,
          "end": 132.63,
          "en": "So put in other words,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 132.63,
          "end": 134.25,
          "en": "I'll only run this check",
          "zh": ""
        },
        {
          "id": 44,
          "start": 134.25,
          "end": 137.613,
          "en": "if the form has not been marked as submitted.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 139.14,
          "end": 143.7,
          "en": "And with this simple yet helpful workaround here,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 143.7,
          "end": 147.9,
          "en": "we could go back and enter some data here",
          "zh": ""
        },
        {
          "id": 47,
          "start": 147.9,
          "end": 149.49,
          "en": "into this form.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 149.49,
          "end": 152.76,
          "en": "And if I click cancel, I get this popup.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 152.76,
          "end": 155.67000000000002,
          "en": "If I press the back button,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 155.67000000000002,
          "end": 158.253,
          "en": "I get this popup as intended.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 159.69,
          "end": 161.55,
          "en": "But if I click create,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 161.55,
          "end": 163.35,
          "en": "you see I did not get it.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 163.35,
          "end": 166.203,
          "en": "And instead this was created and added.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 167.1,
          "end": 170.28,
          "en": "And that's now the behavior I want here.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 170.28,
          "end": 172.92000000000002,
          "en": "So that's one thing fixed.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 172.92000000000002,
          "end": 175.29,
          "en": "But there also is another problem",
          "zh": ""
        },
        {
          "id": 57,
          "start": 175.29,
          "end": 177.213,
          "en": "with this application here.",
          "zh": ""
        }
      ]
    }
