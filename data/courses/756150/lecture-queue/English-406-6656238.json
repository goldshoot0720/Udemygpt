        },
        {
          "id": 63,
          "start": 159.45,
          "end": 163.29,
          "en": "Now, with this trick, or with this approach,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 163.29,
          "end": 165.99,
          "en": "we can go to the recipe list component,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 165.99,
          "end": 167.7,
          "en": "and remove this listener,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 167.7,
          "end": 171.45,
          "en": "where we listened to whether we did select it or not.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 171.45,
          "end": 174.39,
          "en": "We can get rid of the on recipe selected code,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 174.39,
          "end": 177.24,
          "en": "and get rid of our own admitted event here.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 177.24,
          "end": 179.4,
          "en": "So we're already saving a lot of of code,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 179.4,
          "end": 182.79,
          "en": "get rid of all these imports which we don't need anymore.",
