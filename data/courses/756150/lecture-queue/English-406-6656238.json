        },
        {
          "id": 26,
          "start": 59.55,
          "end": 62.76,
          "en": "inform the recipe detail component.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 62.76,
          "end": 65.85,
          "en": "So, in on click, what I actually want to do here is,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 65.85,
          "end": 68.7,
          "en": "I want to not emit an event here.",
