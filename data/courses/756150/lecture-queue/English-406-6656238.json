        },
        {
          "id": 29,
          "start": 68.7,
          "end": 69.93,
          "en": "I will get rid of it here,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 69.93,
          "end": 72.57,
          "en": "and therefore I can remove the imports from,",
