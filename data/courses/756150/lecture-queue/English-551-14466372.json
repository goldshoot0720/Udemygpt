  "lectures": [
    {
      "id": "14466372",
      "title": "Manipulating Request Objects",
      "lectureOrder": 598,
      "videoOrder": 551,
      "sourceHash": "2f79577f39219ab8888f5d3d1b2442edfa6682dba105602087432def24a347d1",
      "cues": [
        {
          "id": 1,
          "start": 2.25,
          "end": 3.63,
          "en": "-: Inside of a Interceptor,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.63,
          "end": 5.22,
          "en": "you can not only log data.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.22,
          "end": 9.39,
          "en": "You can also modify the request object.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.39,
          "end": 12.87,
          "en": "However, the request object itself is immutable.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.87,
          "end": 16.71,
          "en": "So you cancel request URL to a new URL.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.71,
          "end": 19.68,
          "en": "That will not work and you'll also get an error here.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 19.68,
          "end": 21.69,
          "en": "Instead, if you want to modify the request,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 21.69,
          "end": 23.07,
          "en": "you have to create a new one.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 23.07,
          "end": 25.08,
          "en": "Like, modified request, sounds like a",
          "zh": ""
        },
        {
          "id": 10,
          "start": 25.08,
          "end": 26.64,
          "en": "fitting name for the constant.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 26.64,
          "end": 29.16,
          "en": "Where you call request clone.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 29.16,
          "end": 31.548,
          "en": "Inside of clone you pass into java script object,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 31.548,
          "end": 35.22,
          "en": "where you now can override all the core things.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 35.22,
          "end": 36.873,
          "en": "You can set a new URL here.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 39.15,
          "end": 42.09,
          "en": "Or you could add new headers.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 42.09,
          "end": 43.41,
          "en": "If you want to keep the old headers,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 43.41,
          "end": 44.779,
          "en": "by the way then you simply do that by",
          "zh": ""
        },
        {
          "id": 18,
          "start": 44.779,
          "end": 48.12,
          "en": "using the request headers.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 48.12,
          "end": 49.95,
          "en": "And calling append.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 49.95,
          "end": 51.66,
          "en": "Or you add new params",
          "zh": ""
        },
        {
          "id": 21,
          "start": 51.66,
          "end": 52.8,
          "en": "or whatever you want.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 52.8,
          "end": 55.29,
          "en": "Now, I wanted to add a header here.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 55.29,
          "end": 57.33,
          "en": "So indeed I will exes my headers.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 57.33,
          "end": 58.77,
          "en": "Then we'll exes the old headers",
          "zh": ""
        },
        {
          "id": 25,
          "start": 58.77,
          "end": 61.26,
          "en": "on the original request object.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 61.26,
          "end": 62.76,
          "en": "And then simply call append.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 62.76,
          "end": 65.7,
          "en": "As you learn this will return a new headers object,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 65.7,
          "end": 67.47,
          "en": "where I then have all the old headers,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 67.47,
          "end": 69.06,
          "en": "but all the new headers.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 69.06,
          "end": 71.58,
          "en": "These will then be set here as headers",
          "zh": ""
        },
        {
          "id": 31,
          "start": 71.58,
          "end": 73.353,
          "en": "for this modified request.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 74.34,
          "end": 77.43,
          "en": "Here, I'll have my off key,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 77.43,
          "end": 79.98,
          "en": "let's say with xyz as a value.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 79.98,
          "end": 81.9,
          "en": "Of course, this is just some made up header.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 81.9,
          "end": 83.85,
          "en": "Which doesn't really do anything.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 83.85,
          "end": 85.71000000000001,
          "en": "Now, the important thing here is,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 85.71000000000001,
          "end": 88.83,
          "en": "I do not forward the original request,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 88.83,
          "end": 91.62,
          "en": "but my modified request.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 91.62,
          "end": 94.05,
          "en": "That of course, is a typical use case",
          "zh": ""
        },
        {
          "id": 40,
          "start": 94.05,
          "end": 95.31,
          "en": "for an Interceptor.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 95.31,
          "end": 97.92,
          "en": "You change the the request and then you forward",
          "zh": ""
        },
        {
          "id": 42,
          "start": 97.92,
          "end": 99.53999999999999,
          "en": "that modified request.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 99.53999999999999,
          "end": 102.27000000000001,
          "en": "If you only wanted to append the off header",
          "zh": ""
        },
        {
          "id": 44,
          "start": 102.27000000000001,
          "end": 105.39,
          "en": "for a certain urls, then you could use an if check",
          "zh": ""
        },
        {
          "id": 45,
          "start": 105.39,
          "end": 108.87299999999999,
          "en": "with the request URL key, for example.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 110.78999999999999,
          "end": 113.07,
          "en": "Here, I will indeed log request URL",
          "zh": ""
        },
        {
          "id": 47,
          "start": 113.07,
          "end": 115.14,
          "en": "so that we really see for which request",
          "zh": ""
        },
        {
          "id": 48,
          "start": 115.14,
          "end": 117.06,
          "en": "the interceptor ran.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 117.06,
          "end": 118.95,
          "en": "Now let's go back.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 118.95,
          "end": 120.18,
          "en": "And",
          "zh": ""
        },
        {
          "id": 51,
          "start": 120.18,
          "end": 121.89,
          "en": "let's fetch some post for example.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 121.89,
          "end": 124.59,
          "en": "You see the URL is being logged.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 124.59,
          "end": 126.33,
          "en": "If we have a look at the network,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 126.33,
          "end": 127.383,
          "en": "I fetch again.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 128.22,
          "end": 130.05,
          "en": "We inspect that request.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 130.05,
          "end": 132.36,
          "en": "You see that there on the request headers,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 132.36,
          "end": 135.09,
          "en": "off xyz was indeed edited.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 135.09,
          "end": 136.68,
          "en": "We should see the same,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 136.68,
          "end": 138.78,
          "en": "if I now add a post.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 138.78,
          "end": 141.48,
          "en": "There, if we have a look at the request headers.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 141.48,
          "end": 142.74,
          "en": "We also see this.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 142.74,
          "end": 145.40800000000002,
          "en": "So our Interceptor is editing that for all",
          "zh": ""
        },
        {
          "id": 63,
          "start": 145.40800000000002,
          "end": 146.85,
          "en": "outgoing requests.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 146.85,
          "end": 149.43,
          "en": "Therefore, Interceptors are super important",
          "zh": ""
        },
        {
          "id": 65,
          "start": 149.43,
          "end": 150.633,
          "en": "and useful feature.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
