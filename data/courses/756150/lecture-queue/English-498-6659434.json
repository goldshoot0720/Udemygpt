      "sourceHash": "e77ae211347c0bf0ac89eee4c34e4f7a3f570a50142f8fa09a2dee0ed165bc4a",
      "cues": [
        {
          "id": 1,
          "start": 2.34,
          "end": 3.32,
          "en": "Instructor: So let's start working",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.32,
          "end": 5.04,
          "en": "on that shopping list form.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.04,
          "end": 8.01,
          "en": "As mentioned, I want to use the template driven approach.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.01,
          "end": 11.46,
          "en": "So in the shopping list added component here,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.46,
          "end": 14.76,
          "en": "we already got our form element up here.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.76,
          "end": 18.42,
          "en": "Now Angular will already take control over this.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.42,
          "end": 21.48,
          "en": "And we already got the forms module added",
          "zh": ""
        },
        {
          "id": 8,
          "start": 21.48,
          "end": 22.313,
          "en": "in app module.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.313,
          "end": 25.924,
          "en": "By default, we, of course, will need this too.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 25.924,
          "end": 28.92,
          "en": "So with the form here,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 28.92,
          "end": 33.72,
          "en": "we now can start working on our form controls.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 33.72,
          "end": 36.75,
          "en": "I will get rid of these local references.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 36.75,
          "end": 39.45,
          "en": "I will no longer use that approach.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 39.45,
          "end": 41.61,
          "en": "I will also get rid of the click Listener",
          "zh": ""
        },
        {
          "id": 15,
          "start": 41.61,
          "end": 43.41,
          "en": "on the add button.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 43.41,
          "end": 46.71,
          "en": "Instead, I want to use ngsubmit,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 46.71,
          "end": 48.12,
          "en": "to submit the form.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 48.12,
          "end": 51.24,
          "en": "And then call onadditem here.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 51.24,
          "end": 55.23,
          "en": "I also will get access to the form created by Angular.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 55.23,
          "end": 56.91,
          "en": "And as you learn, we can get access",
          "zh": ""
        },
        {
          "id": 21,
          "start": 56.91,
          "end": 60.57,
          "en": "by placing a local reference on the form element.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 60.57,
          "end": 62.01,
          "en": "And now this would give us access",
          "zh": ""
        },
        {
          "id": 23,
          "start": 62.01,
          "end": 64.23,
          "en": "to the form element itself.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 64.23,
          "end": 66.84,
          "en": "But by setting this equal to ngform,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 66.84,
          "end": 69.42,
          "en": "we get access to this JavaScript object,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 69.42,
          "end": 72.09,
          "en": "Angular created behind the scenes.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 72.09,
          "end": 74.82,
          "en": "And now we can simply pass this object",
          "zh": ""
        },
        {
          "id": 28,
          "start": 74.82,
          "end": 77.73,
          "en": "to this onadditem method.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 77.73,
          "end": 80.22,
          "en": "So that is how we can submit the form,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 80.22,
          "end": 83.19,
          "en": "but we also should register some controls.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 83.19,
          "end": 84.99,
          "en": "We got a couple of controls here.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 84.99,
          "end": 86.97,
          "en": "Let's start with the first one.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 86.97,
          "end": 89.43,
          "en": "Here on the name control,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 89.43,
          "end": 93.33,
          "en": "I will assign a name, so the name attribute of, name,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 93.33,
          "end": 94.71000000000001,
          "en": "so a lot of names here, but,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 94.71000000000001,
          "end": 98.00800000000001,
          "en": "of course, the name between quotation marks is the name",
          "zh": ""
        },
        {
          "id": 37,
          "start": 98.00800000000001,
          "end": 100.53,
          "en": "of the property we'll later have",
          "zh": ""
        },
        {
          "id": 38,
          "start": 100.53,
          "end": 104.64,
          "en": "in this form object Angular created.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 104.64,
          "end": 106.38,
          "en": "And I will assign ngmodel",
          "zh": ""
        },
        {
          "id": 40,
          "start": 106.38,
          "end": 109.59,
          "en": "to this input, so that we register it",
          "zh": ""
        },
        {
          "id": 41,
          "start": 109.59,
          "end": 112.773,
          "en": "as a control in our template driven form.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 113.75999999999999,
          "end": 118.75999999999999,
          "en": "Now for the second input, the name will be, amount.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 119.25,
          "end": 121.53,
          "en": "And then I'll also add ngmodel.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 121.53,
          "end": 124.26,
          "en": "And make sure that you import it from forms module.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 124.26,
          "end": 126.78,
          "en": "Otherwise, this is not available.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 126.78,
          "end": 128.82,
          "en": "So we should have this control added",
          "zh": ""
        },
        {
          "id": 47,
          "start": 128.82,
          "end": 130.65,
          "en": "to our form too.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 130.65,
          "end": 133.35,
          "en": "And the add button, here, will submit the form,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 133.35,
          "end": 135.9,
          "en": "because it's the only button of type, submit.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 135.9,
          "end": 138.273,
          "en": "The other two buttons are of type, button.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 139.38,
          "end": 143.55,
          "en": "So in, onadditem, in this type scripts file now,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 143.55,
          "end": 147.15,
          "en": "I no longer will use my element refs here.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 147.15,
          "end": 150.42000000000002,
          "en": "So I can remove these declarations here.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 150.42000000000002,
          "end": 153.87,
          "en": "I can get rid of the view child and element ref import.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 153.87,
          "end": 154.74,
          "en": "And I can get rid",
          "zh": ""
        },
        {
          "id": 56,
          "start": 154.74,
          "end": 157.77,
          "en": "of these two lines, where I extract the data.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 157.77,
          "end": 159.9,
          "en": "I still want to create a new ingredient,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 159.9,
          "end": 162.72,
          "en": "but now, we will simply get the form here",
          "zh": ""
        },
        {
          "id": 59,
          "start": 162.72,
          "end": 164.19,
          "en": "and it will be of ngform.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 164.19,
          "end": 166.11,
          "en": "So of this type.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 166.11,
          "end": 169.02,
          "en": "Since this is the form, we will get the value",
          "zh": ""
        },
        {
          "id": 62,
          "start": 169.02,
          "end": 174.02,
          "en": "of the form on the value property.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 174.18,
          "end": 179.18,
          "en": "Now we can simply use the value and access name",
          "zh": ""
        },
        {
          "id": 64,
          "start": 179.22,
          "end": 183.21,
          "en": "to get the name of the ingredient and value amount,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 183.21,
          "end": 184.32,
          "en": "to get the amount.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 184.32,
          "end": 185.7,
          "en": "Because name and amount,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 185.7,
          "end": 187.74,
          "en": "were names, we specified here",
          "zh": ""
        },
        {
          "id": 68,
          "start": 187.74,
          "end": 190.593,
          "en": "in our template on these input elements.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 191.67,
          "end": 193.38,
          "en": "Well, let's see if this works.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 193.38,
          "end": 195.84,
          "en": "If I save this and we go back",
          "zh": ""
        },
        {
          "id": 71,
          "start": 195.84,
          "end": 199.413,
          "en": "to the shopping list, ngserve is still running.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 201,
          "end": 204.21,
          "en": "Here, If I add Bread, 1.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 204.21,
          "end": 205.29,
          "en": "That looks good.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 205.29,
          "end": 209.61,
          "en": "Works like before, but now using the better approach",
          "zh": ""
        },
        {
          "id": 75,
          "start": 209.61,
          "end": 212.67000000000002,
          "en": "of using the built in tools and, therefore,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 212.67000000000002,
          "end": 214.624,
          "en": "building a better form.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 214.624,
          "end": 216.51,
          "en": "Now, we can also take advantage",
          "zh": ""
        },
        {
          "id": 78,
          "start": 216.51,
          "end": 217.89,
          "en": "of validation and so on.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 217.89,
          "end": 220.803,
          "en": "And that is something I will do in the next lecture.",
          "zh": ""
        }
      ]
    }
