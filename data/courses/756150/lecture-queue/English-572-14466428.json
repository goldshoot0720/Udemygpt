          "zh": ""
        },
        {
          "id": 86,
          "start": 252.51,
          "end": 254.13,
          "en": "because the error we're getting",
          "zh": ""
        },
        {
          "id": 87,
          "start": 254.13,
          "end": 255.6,
          "en": "seems to be in a different format,",
          "zh": ""
        },
        {
          "id": 88,
          "start": 255.6,
          "end": 256.71,
          "en": "and, therefore, in this case,",
          "zh": ""
        },
        {
          "id": 89,
          "start": 256.71,
          "end": 260.25,
          "en": "I immediately want to return throwError",
          "zh": ""
        },
        {
          "id": 90,
          "start": 260.25,
          "end": 263.94,
          "en": "and wrap my error message here so that we'll throw",
          "zh": ""
        },
        {
          "id": 91,
