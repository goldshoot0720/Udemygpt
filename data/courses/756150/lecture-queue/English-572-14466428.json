          "zh": ""
        },
        {
          "id": 64,
          "start": 186.15,
          "end": 189.63,
          "en": "we previously got in the subscribe function,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 189.63,
          "end": 191.85,
          "en": "and, therefore, in here, we can switch on",
          "zh": ""
        },
        {
          "id": 66,
