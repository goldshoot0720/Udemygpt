        },
        {
          "id": 26,
          "start": 77.86,
          "end": 81,
          "en": "Now we do start with this app component",
          "zh": ""
        },
        {
          "id": 27,
          "start": 81,
          "end": 82.53,
          "en": "the root component you should say",
