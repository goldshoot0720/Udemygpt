  "lectures": [
    {
      "id": "43788568",
      "title": "We Need Custom Events!",
      "lectureOrder": 34,
      "videoOrder": 30,
      "sourceHash": "f72cf376420f37938191ebd50e5f43dcfa1cb5fbfcebd13ad9337a2d45969945",
      "cues": [
        {
          "id": 1,
          "start": 0.51,
          "end": 2.64,
          "en": "Now, being able to accept inputs",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.64,
          "end": 7.64,
          "en": "is one important feature and concept in Angular components,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.65,
          "end": 10.71,
          "en": "because it allows you to reuse components",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.71,
          "end": 12.63,
          "en": "with different data.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.63,
          "end": 17.63,
          "en": "But custom components also often need to emit custom events",
          "zh": ""
        },
        {
          "id": 6,
          "start": 18.15,
          "end": 21.15,
          "en": "and not just accept inputs.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 21.15,
          "end": 25.59,
          "en": "So they need to produce outputs as well you could say.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 25.59,
          "end": 27.99,
          "en": "And that's actually the situation we have",
          "zh": ""
        },
        {
          "id": 9,
          "start": 27.99,
          "end": 30.18,
          "en": "in our app here as well.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 30.18,
          "end": 32.34,
          "en": "When I click a user,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 32.34,
          "end": 36.39,
          "en": "I want to soon show the tasks",
          "zh": ""
        },
        {
          "id": 12,
          "start": 36.39,
          "end": 38.91,
          "en": "for that user here on the right.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 38.91,
          "end": 43.91,
          "en": "Now of course, that tasks list or whatever it will be,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 44.55,
          "end": 47.76,
          "en": "will not show up inside of the user component,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 47.76,
          "end": 50.91,
          "en": "because the user component is really only responsible",
          "zh": ""
        },
        {
          "id": 16,
          "start": 50.91,
          "end": 54.153,
          "en": "for outputting this user element.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 54.99,
          "end": 59.04,
          "en": "Therefor, the information that a user was clicked",
          "zh": ""
        },
        {
          "id": 18,
          "start": 59.04,
          "end": 62.91,
          "en": "must get out of that user component",
          "zh": ""
        },
        {
          "id": 19,
          "start": 62.91,
          "end": 67.91,
          "en": "and must be passed on to the app component in this app here,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 68.4,
          "end": 71.7,
          "en": "because it's the app component that's outputting the user",
          "zh": ""
        },
        {
          "id": 21,
          "start": 71.7,
          "end": 75.03,
          "en": "and it's the app component that could then output",
          "zh": ""
        },
        {
          "id": 22,
          "start": 75.03,
          "end": 80.03,
          "en": "the tasks of that user next to that unordered list",
          "zh": ""
        },
        {
          "id": 23,
          "start": 81.06,
          "end": 82.443,
          "en": "here for example.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 83.43,
          "end": 85.74,
          "en": "So we need to let the app component know",
          "zh": ""
        },
        {
          "id": 25,
          "start": 85.74,
          "end": 87.21000000000001,
          "en": "when a user is clicked,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 87.21000000000001,
          "end": 90.48,
          "en": "so when the button in the user component is clicked",
          "zh": ""
        },
        {
          "id": 27,
          "start": 90.48,
          "end": 92.37,
          "en": "and we already have a click listener",
          "zh": ""
        },
        {
          "id": 28,
          "start": 92.37,
          "end": 93.50999999999999,
          "en": "on that button of course,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 93.50999999999999,
          "end": 96.72,
          "en": "but now we need to output the information",
          "zh": ""
        },
        {
          "id": 30,
          "start": 96.72,
          "end": 98.523,
          "en": "that this button was clicked,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 99.45,
          "end": 102.33,
          "en": "and this can be done with help of another feature",
          "zh": ""
        },
        {
          "id": 32,
          "start": 102.33,
          "end": 106.293,
          "en": "provided by Angular, output properties.",
          "zh": ""
        }
      ]
    }
