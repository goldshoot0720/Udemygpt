          "start": 147.84,
          "end": 149.7,
          "en": "the latest version of Angular.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 149.7,
          "end": 151.77,
          "en": "Indeed, the opposite is the case.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 151.77,
          "end": 156.77,
          "en": "Quite a big chunk of teams and companies still use older",
          "zh": ""
        },
        {
          "id": 47,
          "start": 158.52,
          "end": 161.07,
