{
  "version": 1,
  "courseId": 756150,
  "courseSlug": "the-complete-guide-to-angular-2",
  "courseTitle": "Angular - The Complete Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "38137548",
      "title": "Introducing Actions & State Changing Reducers",
      "lectureOrder": 691,
      "videoOrder": 636,
      "sourceHash": "bd26012f7ed02519e6f053364e2bbce6a8176bb1fa94451a054310a2a1025d62",
      "cues": [
        {
          "id": 1,
          "start": 2.22,
          "end": 3.66,
          "en": "So at this point we're able",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.66,
          "end": 5.97,
          "en": "to read data from the store,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.97,
          "end": 9,
          "en": "we're able to add data to the store,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9,
          "end": 10.26,
          "en": "at least some initial data;",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.26,
          "end": 12.87,
          "en": "and we can output that data on the screen.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 12.87,
          "end": 14.46,
          "en": "That's of course all great,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 14.46,
          "end": 16.2,
          "en": "but now of course we also wanna make sure",
          "zh": ""
        },
        {
          "id": 8,
          "start": 16.2,
          "end": 20.61,
          "en": "that these buttons work and that this data can be changed.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 20.61,
          "end": 23.16,
          "en": "And for that we need actions",
          "zh": ""
        },
        {
          "id": 10,
          "start": 23.16,
          "end": 25.05,
          "en": "because when using NgRx,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 25.05,
          "end": 28.14,
          "en": "you don't call reducers yourself.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 28.14,
          "end": 30.45,
          "en": "Instead, you dispatch actions,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 30.45,
          "end": 32.76,
          "en": "for example, from inside your Components",
          "zh": ""
        },
        {
          "id": 14,
          "start": 32.76,
          "end": 36.48,
          "en": "so that NgRx can call those reducers for you,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 36.48,
          "end": 38.64,
          "en": "so that those reducers can then",
          "zh": ""
        },
        {
          "id": 16,
          "start": 38.64,
          "end": 40.62,
          "en": "work on that latest state",
          "zh": ""
        },
        {
          "id": 17,
          "start": 40.62,
          "end": 44.583,
          "en": "that is managed by NgRx and updated accordingly.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 45.66,
          "end": 48.18,
          "en": "Therefore, here, back in our application",
          "zh": ""
        },
        {
          "id": 19,
          "start": 48.18,
          "end": 51.57,
          "en": "I will add a new file in this store folder.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 51.57,
          "end": 54.75,
          "en": "And I'll name it \"counter dot actions dot TS.\"",
          "zh": ""
        },
        {
          "id": 21,
          "start": 54.75,
          "end": 57.18,
          "en": "And of course, it's technically not required",
          "zh": ""
        },
        {
          "id": 22,
          "start": 57.18,
          "end": 60.611,
          "en": "to split your code across files like this,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 60.611,
          "end": 63.48,
          "en": "but it is something you'll see a lot",
          "zh": ""
        },
        {
          "id": 24,
          "start": 63.48,
          "end": 67.11,
          "en": "in all those applications that use NgRx;",
          "zh": ""
        },
        {
          "id": 25,
          "start": 67.11,
          "end": 70.2,
          "en": "that you put your Reducer in a separate file,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 70.2,
          "end": 73.53,
          "en": "that you put your actions into a separate file,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 73.53,
          "end": 75.12,
          "en": "and that you put other things",
          "zh": ""
        },
        {
          "id": 28,
          "start": 75.12,
          "end": 78.723,
          "en": "about which you will learn later into yet other files.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 80.03999999999999,
          "end": 82.59,
          "en": "So this actions TS file is all about",
          "zh": ""
        },
        {
          "id": 30,
          "start": 82.59,
          "end": 85.47,
          "en": "defining the actions that can be",
          "zh": ""
        },
        {
          "id": 31,
          "start": 85.47,
          "end": 88.11,
          "en": "dispatched in this application.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 88.11,
          "end": 89.78999999999999,
          "en": "And here in this application,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 89.78999999999999,
          "end": 91.38,
          "en": "we might want an action",
          "zh": ""
        },
        {
          "id": 34,
          "start": 91.38,
          "end": 93.47999999999999,
          "en": "for incrementing the counter,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 93.47999999999999,
          "end": 95.493,
          "en": "for increasing it by one.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 96.63,
          "end": 99.24000000000001,
          "en": "Therefore, in this counteractions file,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 99.24000000000001,
          "end": 101.07,
          "en": "we can create a new constant",
          "zh": ""
        },
        {
          "id": 38,
          "start": 101.07,
          "end": 104.4,
          "en": "because a action is again, a value in the end,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 104.4,
          "end": 108,
          "en": "an identifier of a certain action you could say.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 108,
          "end": 111.66,
          "en": "And I'll name my constant here, \"Increment.\"",
          "zh": ""
        },
        {
          "id": 41,
          "start": 111.66,
          "end": 114.24000000000001,
          "en": "And then such a action thing,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 114.24000000000001,
          "end": 116.94,
          "en": "such a action value is created",
          "zh": ""
        },
        {
          "id": 43,
          "start": 116.94,
          "end": 119.28,
          "en": "by calling \"Create Action,\"",
          "zh": ""
        },
        {
          "id": 44,
          "start": 119.28,
          "end": 122.61,
          "en": "which is a function provided by NgRx store;",
          "zh": ""
        },
        {
          "id": 45,
          "start": 122.61,
          "end": 125.487,
          "en": "though just as with \"Create Reducer,\"",
          "zh": ""
        },
        {
          "id": 46,
          "start": 125.487,
          "end": 129.57,
          "en": "there also is an alternative to calling create action,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 129.57,
          "end": 131.463,
          "en": "which I'll show you later.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 132.48,
          "end": 134.61,
          "en": "Now, create action is a function",
          "zh": ""
        },
        {
          "id": 49,
          "start": 134.61,
          "end": 137.49,
          "en": "that needs one or two arguments,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 137.49,
          "end": 139.98,
          "en": "and at least one argument is always required.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 139.98,
          "end": 143.43,
          "en": "And that argument is the type of the action,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 143.43,
          "end": 146.1,
          "en": "the identifier of the action.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 146.1,
          "end": 149.01,
          "en": "And when using NgRx, this identifier,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 149.01,
          "end": 152.25,
          "en": "this type in the end is simply a string.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 152.25,
          "end": 153.99,
          "en": "For example, \"Increment.\"",
          "zh": ""
        },
        {
          "id": 56,
          "start": 153.99,
          "end": 155.57999999999998,
          "en": "Though the content of the string",
          "zh": ""
        },
        {
          "id": 57,
          "start": 155.57999999999998,
          "end": 157.56,
          "en": "is totally up to you of course,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 157.56,
          "end": 160.47,
          "en": "it just must be some unique identifier",
          "zh": ""
        },
        {
          "id": 59,
          "start": 160.47,
          "end": 163.35,
          "en": "so that in your Angular application",
          "zh": ""
        },
        {
          "id": 60,
          "start": 163.35,
          "end": 167.22,
          "en": "you don't use the same identifier for different actions.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 167.22,
          "end": 169.38,
          "en": "That's something that should be avoided.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 169.38,
          "end": 172.38,
          "en": "And to avoid it, it's quite common to add",
          "zh": ""
        },
        {
          "id": 63,
          "start": 172.38,
          "end": 175.35,
          "en": "kind of a prefix to this identifier;",
          "zh": ""
        },
        {
          "id": 64,
          "start": 175.35,
          "end": 177.09,
          "en": "typically in square brackets,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 177.09,
          "end": 179.01,
          "en": "though, these are all just",
          "zh": ""
        },
        {
          "id": 66,
          "start": 179.01,
          "end": 182.34,
          "en": "conventions and not technical requirements,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 182.34,
          "end": 185.67,
          "en": "but still it is a convention you might wanna follow.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 185.67,
          "end": 187.8,
          "en": "And the convention here is to put",
          "zh": ""
        },
        {
          "id": 69,
          "start": 187.8,
          "end": 190.89,
          "en": "the name of the feature of the app",
          "zh": ""
        },
        {
          "id": 70,
          "start": 190.89,
          "end": 192.57,
          "en": "to which this action belongs",
          "zh": ""
        },
        {
          "id": 71,
          "start": 192.57,
          "end": 195,
          "en": "between those square brackets.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 195,
          "end": 197.22,
          "en": "So here, for example, \"counter,\"",
          "zh": ""
        },
        {
          "id": 73,
          "start": 197.22,
          "end": 199.29,
          "en": "and if you instead had an action",
          "zh": ""
        },
        {
          "id": 74,
          "start": 199.29,
          "end": 202.77,
          "en": "that belongs to the user authentication area,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 202.77,
          "end": 205.65,
          "en": "you could use \"auth\" instead.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 205.65,
          "end": 207.63,
          "en": "So that you have an identifier",
          "zh": ""
        },
        {
          "id": 77,
          "start": 207.63,
          "end": 211.56,
          "en": "for the feature of the app to which the action belongs,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 211.56,
          "end": 212.88,
          "en": "and then after that,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 212.88,
          "end": 215.4,
          "en": "the actual action identifier,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 215.4,
          "end": 218.28,
          "en": "for example, \"increment\" here.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 218.28,
          "end": 221.43,
          "en": "So that's the overall action identifier.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 221.43,
          "end": 223.65,
          "en": "And with that action to find here",
          "zh": ""
        },
        {
          "id": 83,
          "start": 223.65,
          "end": 227.43,
          "en": "you can export this action object,",
          "zh": ""
        },
        {
          "id": 84,
          "start": 227.43,
          "end": 229.26,
          "en": "which it is under the hood,",
          "zh": ""
        },
        {
          "id": 85,
          "start": 229.26,
          "end": 232.945,
          "en": "and then use it somewhere else in your application",
          "zh": ""
        },
        {
          "id": 86,
          "start": 232.945,
          "end": 237.42000000000002,
          "en": "to execute different logic for different actions.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 237.42000000000002,
          "end": 239.16,
          "en": "So the question therefore is",
          "zh": ""
        },
        {
          "id": 88,
          "start": 239.16,
          "end": 242.07,
          "en": "where you would use this action.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 242.07,
          "end": 245.46,
          "en": "And the answer is in the Reducer,",
          "zh": ""
        },
        {
          "id": 90,
          "start": 245.46,
          "end": 246.96,
          "en": "because that's, in the end,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 246.96,
          "end": 248.85,
          "en": "where the state should be updated.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 248.85,
          "end": 251.1,
          "en": "So it's in this Reducer function",
          "zh": ""
        },
        {
          "id": 93,
          "start": 251.1,
          "end": 253.863,
          "en": "where you want to listen to the action.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 255.12,
          "end": 257.49,
          "en": "Now, here I'll switch back to the approach",
          "zh": ""
        },
        {
          "id": 95,
          "start": 257.49,
          "end": 259.83,
          "en": "that uses \"Create Reducer.\"",
          "zh": ""
        },
        {
          "id": 96,
          "start": 259.83,
          "end": 261.66,
          "en": "And when using this approach,",
          "zh": ""
        },
        {
          "id": 97,
          "start": 261.66,
          "end": 263.28,
          "en": "listening to actions",
          "zh": ""
        },
        {
          "id": 98,
          "start": 263.28,
          "end": 265.088,
          "en": "and executing different pieces",
          "zh": ""
        },
        {
          "id": 99,
          "start": 265.088,
          "end": 266.962,
          "en": "of code for different actions",
          "zh": ""
        },
        {
          "id": 100,
          "start": 266.962,
          "end": 269.37,
          "en": "is quite straightforward",
          "zh": ""
        },
        {
          "id": 101,
          "start": 269.37,
          "end": 271.62,
          "en": "because you can pass a second argument",
          "zh": ""
        },
        {
          "id": 102,
          "start": 271.62,
          "end": 274.91700000000003,
          "en": "to \"Create Reducer\" after the initial state.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 274.91700000000003,
          "end": 278.28,
          "en": "And that argument should be a value",
          "zh": ""
        },
        {
          "id": 104,
          "start": 278.28,
          "end": 281.55,
          "en": "that is created with help of another function",
          "zh": ""
        },
        {
          "id": 105,
          "start": 281.55,
          "end": 284.4,
          "en": "provided by NgRx store.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 284.4,
          "end": 288.51,
          "en": "And that other function is the \"on\" function.",
          "zh": ""
        },
        {
          "id": 107,
          "start": 288.51,
          "end": 289.74,
          "en": "Though, as mentioned,",
          "zh": ""
        },
        {
          "id": 108,
          "start": 289.74,
          "end": 291.84000000000003,
          "en": "in the next lecture I will show you",
          "zh": ""
        },
        {
          "id": 109,
          "start": 291.84000000000003,
          "end": 293.64,
          "en": "what happens under the hood",
          "zh": ""
        },
        {
          "id": 110,
          "start": 293.64,
          "end": 296.46,
          "en": "if you are not using Create Reducer.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 296.46,
          "end": 297.78,
          "en": "But here, when using it,",
          "zh": ""
        },
        {
          "id": 112,
          "start": 297.78,
          "end": 299.82,
          "en": "you now use the \"on\" function",
          "zh": ""
        },
        {
          "id": 113,
          "start": 299.82,
          "end": 304.82,
          "en": "and execute this as a second value for create Reducer.",
          "zh": ""
        },
        {
          "id": 114,
          "start": 305.07,
          "end": 309.45,
          "en": "And this on function then itself needs some arguments.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 309.45,
          "end": 312.45,
          "en": "It needs two arguments to be precise.",
          "zh": ""
        },
        {
          "id": 116,
          "start": 312.45,
          "end": 315.39,
          "en": "And the first argument is the action",
          "zh": ""
        },
        {
          "id": 117,
          "start": 315.39,
          "end": 316.62,
          "en": "to which you wanna listen.",
          "zh": ""
        },
        {
          "id": 118,
          "start": 316.62,
          "end": 320.22,
          "en": "So in this case, this increment action, which I created.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 320.22,
          "end": 322.8,
          "en": "And for this, you simply import",
          "zh": ""
        },
        {
          "id": 120,
          "start": 322.8,
          "end": 325.86,
          "en": "this action from your actions file,",
          "zh": ""
        },
        {
          "id": 121,
          "start": 325.86,
          "end": 329.037,
          "en": "and you then use it as a value for \"on.\"",
          "zh": ""
        },
        {
          "id": 122,
          "start": 330.63,
          "end": 331.5,
          "en": "But that's not all,",
          "zh": ""
        },
        {
          "id": 123,
          "start": 331.5,
          "end": 335.49,
          "en": "you now also must pass a second value to \"on.\"",
          "zh": ""
        },
        {
          "id": 124,
          "start": 335.49,
          "end": 339.65999999999997,
          "en": "And that second value must be a function itself.",
          "zh": ""
        },
        {
          "id": 125,
          "start": 339.65999999999997,
          "end": 343.62,
          "en": "A function that will be executed by NgRx",
          "zh": ""
        },
        {
          "id": 126,
          "start": 343.62,
          "end": 346.14,
          "en": "whenever this action occurs,",
          "zh": ""
        },
        {
          "id": 127,
          "start": 346.14,
          "end": 349.44,
          "en": "whenever this action is dispatched.",
          "zh": ""
        },
        {
          "id": 128,
          "start": 349.44,
          "end": 354.06,
          "en": "And this function here, then, will be executed by NgRx,",
          "zh": ""
        },
        {
          "id": 129,
          "start": 354.06,
          "end": 355.40999999999997,
          "en": "and this is the function",
          "zh": ""
        },
        {
          "id": 130,
          "start": 355.40999999999997,
          "end": 358.323,
          "en": "that should contain the logic that updates the state.",
          "zh": ""
        },
        {
          "id": 131,
          "start": 359.15999999999997,
          "end": 361.53,
          "en": "For this, this function will automatically",
          "zh": ""
        },
        {
          "id": 132,
          "start": 361.53,
          "end": 364.2,
          "en": "receive the current state as an input,",
          "zh": ""
        },
        {
          "id": 133,
          "start": 364.2,
          "end": 367.59,
          "en": "NgRx will pass the current state value",
          "zh": ""
        },
        {
          "id": 134,
          "start": 367.59,
          "end": 370.11,
          "en": "for this Reducer into this function",
          "zh": ""
        },
        {
          "id": 135,
          "start": 370.11,
          "end": 372.84,
          "en": "here whenever this action occurs,",
          "zh": ""
        },
        {
          "id": 136,
          "start": 372.84,
