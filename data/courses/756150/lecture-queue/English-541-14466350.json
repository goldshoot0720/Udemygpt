        },
        {
          "id": 53,
          "start": 138.51,
          "end": 142.59,
          "en": "about the result of our request or of the response",
          "zh": ""
        },
        {
          "id": 54,
          "start": 142.59,
          "end": 144.27,
          "en": "but I know that this function here",
          "zh": ""
        },
        {
          "id": 55,
          "start": 144.27,
          "end": 146.19,
          "en": "will only run if it's succeeded",
          "zh": ""
