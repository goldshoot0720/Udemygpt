{
  "version": 1,
  "courseId": 756150,
  "courseSlug": "the-complete-guide-to-angular-2",
  "courseTitle": "Angular - The Complete Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "14466492",
      "title": "Splitting Modules Correctly",
      "lectureOrder": 649,
      "videoOrder": 597,
      "sourceHash": "9f4cf6f738c8051e0e93ce3b76607ae261de181ddb398981833cadaa5dad4b05",
      "cues": [
        {
          "id": 1,
          "start": 2.22,
          "end": 4.89,
          "en": "Instructor: Now to fix that, there are a couple of ways.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.89,
          "end": 8.22,
          "en": "One way would be that we simply import the",
          "zh": ""
        },
        {
          "id": 3,
          "start": 8.22,
          "end": 11.52,
          "en": "router module like this without for root,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.52,
          "end": 13.05,
          "en": "just like that.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.05,
          "end": 15.18,
          "en": "It adds the import step up there",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.18,
          "end": 17.43,
          "en": "into our recipes module.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.43,
          "end": 20.46,
          "en": "If we do that and we go back to our application,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.46,
          "end": 24,
          "en": "now we still fail because of app recipe item",
          "zh": ""
        },
        {
          "id": 9,
          "start": 24,
          "end": 27.96,
          "en": "that uses ngFor and doesn't have access to that.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.96,
          "end": 30.3,
          "en": "But we don't get that routing error anymore.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 30.3,
          "end": 32.13,
          "en": "Now, still we get an error.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.13,
          "end": 34.59,
          "en": "This error is related to ngFor.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 34.59,
          "end": 37.59,
          "en": "Here the same logic as with the routing applies.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 37.59,
          "end": 39.84,
          "en": "You don't magically have access to all these",
          "zh": ""
        },
        {
          "id": 15,
          "start": 39.84,
          "end": 41.43,
          "en": "core angular features.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 41.43,
          "end": 44.19,
          "en": "You did, thus far, because we had everything",
          "zh": ""
        },
        {
          "id": 17,
          "start": 44.19,
          "end": 45.15,
          "en": "in the app module.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 45.15,
          "end": 47.97,
          "en": "We declare all components in the app module",
          "zh": ""
        },
        {
          "id": 19,
          "start": 47.97,
          "end": 51.45,
          "en": "and we have imports here in the app module",
          "zh": ""
        },
        {
          "id": 20,
          "start": 51.45,
          "end": 54.93,
          "en": "that import core angular features into the app module",
          "zh": ""
        },
        {
          "id": 21,
          "start": 54.93,
          "end": 57.24,
          "en": "and therefore, any component declared here",
          "zh": ""
        },
        {
          "id": 22,
          "start": 57.24,
          "end": 59.01,
          "en": "has access to these features.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 59.01,
          "end": 62.13,
          "en": "Components declared in other modules don't.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 62.13,
          "end": 64.23,
          "en": "For example, ngIf and ngFor",
          "zh": ""
        },
        {
          "id": 25,
          "start": 64.23,
          "end": 66.27,
          "en": "are provided by the browser module.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 66.27,
          "end": 67.71,
          "en": "All the forms related things",
          "zh": ""
        },
        {
          "id": 27,
          "start": 67.71,
          "end": 69.3,
          "en": "are provided by the forms module",
          "zh": ""
        },
        {
          "id": 28,
          "start": 69.3,
          "end": 71.34,
          "en": "or the reactive forms module.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 71.34,
          "end": 76.34,
          "en": "Http related stuff is imported by the HttpClientModule",
          "zh": ""
        },
        {
          "id": 30,
          "start": 76.74,
          "end": 78.72,
          "en": "though this is kind of an exception.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 78.72,
          "end": 82.89,
          "en": "This only provides services and no directives or components.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 82.89,
          "end": 84.66,
          "en": "Services work differently and therefore,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 84.66,
          "end": 87.06,
          "en": "are indeed a way of application wide",
          "zh": ""
        },
        {
          "id": 34,
          "start": 87.06,
          "end": 89.7,
          "en": "even in modules where you don't add this.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 89.7,
          "end": 92.52000000000001,
          "en": "As soon as you use something that is not a service,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 92.52000000000001,
          "end": 95.1,
          "en": "I'll come back to that services thing later,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 95.1,
          "end": 97.59,
          "en": "as soon as you use something that is not a service",
          "zh": ""
        },
        {
          "id": 38,
          "start": 97.59,
          "end": 100.32,
          "en": "but that offers real directives or any features",
          "zh": ""
        },
        {
          "id": 39,
          "start": 100.32,
          "end": 103.181,
          "en": "you use in templates, as soon as that's the case,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 103.181,
          "end": 106.351,
          "en": "you only have access to what you import.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 106.351,
          "end": 111.09,
          "en": "To be able to use ngFor in the recipes module,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 111.09,
          "end": 112.97999999999999,
          "en": "besides the router module,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 112.97999999999999,
          "end": 115.62,
          "en": "we probable also need the browser module.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 115.62,
          "end": 117.84,
          "en": "However, this is now just a special case",
          "zh": ""
        },
        {
          "id": 45,
          "start": 117.84,
          "end": 120.21,
          "en": "and the only special case.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 120.21,
          "end": 122.82,
          "en": "The browser module must only be used once",
          "zh": ""
        },
        {
          "id": 47,
          "start": 122.82,
          "end": 124.8,
          "en": "and that is in the app module",
          "zh": ""
        },
        {
          "id": 48,
          "start": 124.8,
          "end": 128.01,
          "en": "because it does more than just add ngIf and ngFor.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 128.01,
          "end": 131.61,
          "en": "It does some general application start up work",
          "zh": ""
        },
        {
          "id": 50,
          "start": 131.61,
          "end": 133.98,
          "en": "that only has to run once.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 133.98,
          "end": 135.63,
          "en": "Instead of the browser module,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 135.63,
          "end": 138.63,
          "en": "use the common module in all other places,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 138.63,
          "end": 141.21,
          "en": "in all other modules where you want to get access",
          "zh": ""
        },
        {
          "id": 54,
          "start": 141.21,
          "end": 143.31,
          "en": "to ngIf and ngFor.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 143.31,
          "end": 145.07999999999998,
          "en": "Here you add the common module",
          "zh": ""
        },
        {
          "id": 56,
          "start": 145.07999999999998,
          "end": 149.253,
          "en": "and that is imported from @angular/common.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 150.27,
          "end": 154.05,
          "en": "With that imported, we unlock ngIf and ngFor.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 154.05,
          "end": 155.31,
          "en": "Therefore, now if we save this",
          "zh": ""
        },
        {
          "id": 59,
          "start": 155.31,
          "end": 157.77,
          "en": "we can get an error but a different error.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 157.77,
          "end": 160.86,
          "en": "This time, the problem is the form group directive.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 160.86,
          "end": 164.04,
          "en": "As I mentioned, you only have access to what you import.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 164.04,
          "end": 166.17000000000002,
          "en": "We're not importing the forms module",
          "zh": ""
        },
        {
          "id": 63,
          "start": 166.17000000000002,
          "end": 169.92000000000002,
          "en": "or here actually, the reactive forms module",
          "zh": ""
        },
        {
          "id": 64,
          "start": 169.92000000000002,
          "end": 172.911,
          "en": "because we're using reactive forms in the recipes area.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 172.911,
          "end": 174.96,
          "en": "As soon as we do add it, though,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 174.96,
          "end": 176.76,
          "en": "of course for that you also need to add",
          "zh": ""
        },
        {
          "id": 67,
          "start": 176.76,
          "end": 179.553,
          "en": "the import statement up here from @angularforms.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 180.84,
          "end": 182.703,
          "en": "As soon as we do add this,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 183.84,
          "end": 186.87,
          "en": "we can save this and now we see that it finally",
          "zh": ""
        },
        {
          "id": 70,
          "start": 186.87,
          "end": 189.39,
          "en": "loads again and our application runs again.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 189.39,
          "end": 192.84,
          "en": "If I log in, I can indeed go to my recipes.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 192.84,
          "end": 196.65,
          "en": "I can fetch my data here and that all works.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 196.65,
          "end": 199.62,
          "en": "Now, we outsource this into a separate module.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 199.62,
          "end": 203.55,
          "en": "The core takeaway you absolutely have to understand is",
          "zh": ""
        },
        {
          "id": 75,
          "start": 203.55,
          "end": 205.2,
          "en": "whatever you declare here,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 205.2,
          "end": 208.05,
          "en": "whatever you use in the template of these components",
          "zh": ""
        },
        {
          "id": 77,
          "start": 208.05,
          "end": 211.26,
          "en": "has to be imported in that module.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 211.26,
          "end": 213.81,
          "en": "It's not enough if you import it in the app module.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 213.81,
          "end": 216.6,
          "en": "The only exception to the rule are services.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 216.6,
          "end": 218.63,
          "en": "These only need to be set up once",
          "zh": ""
        },
        {
          "id": 81,
          "start": 218.63,
          "end": 220.82999999999998,
          "en": "in the app module and you can access them",
          "zh": ""
        },
        {
          "id": 82,
          "start": 220.82999999999998,
          "end": 223.47,
          "en": "in your whole application even in components",
          "zh": ""
        },
        {
          "id": 83,
          "start": 223.47,
          "end": 225.75,
          "en": "which you added to feature modules.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 225.75,
          "end": 227.56900000000002,
          "en": "Anything that's used in a template,",
          "zh": ""
        },
        {
          "id": 85,
          "start": 227.56900000000002,
          "end": 229.98,
          "en": "components, directives, pipes,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 229.98,
          "end": 233.31,
          "en": "these things need to be declared or imported",
          "zh": ""
        },
        {
          "id": 87,
          "start": 233.31,
          "end": 235.62,
          "en": "into the module where you plan on using them.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 235.62,
          "end": 238.38,
          "en": "It's not enough to use them in another module",
          "zh": ""
        },
        {
          "id": 89,
          "start": 238.38,
          "end": 241.68,
          "en": "even if you export your things to that other module.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 241.68,
          "end": 243.3,
          "en": "Even then, it's not enough.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 243.3,
          "end": 247.533,
          "en": "Angular, treats and parts of every ng module stand alone.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
