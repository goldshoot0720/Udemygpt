{
  "version": 1,
  "courseId": 756150,
  "courseSlug": "the-complete-guide-to-angular-2",
  "courseTitle": "Angular - The Complete Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "44116624",
      "title": "Static Site Generation (SSG) Introduction",
      "lectureOrder": 325,
      "videoOrder": 307,
      "sourceHash": "8a0f8abaa83be7b97a3fc514221807f63f66d4514c35dc669cc9fd5e58463463",
      "cues": [
        {
          "id": 1,
          "start": 0.75,
          "end": 2.58,
          "en": "Now before we'll take a look",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.58,
          "end": 6.84,
          "en": "at how you could deploy server-side rendered apps,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.84,
          "end": 10.41,
          "en": "I wanna explore the last main option you have",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.41,
          "end": 13.95,
          "en": "when it comes to building Angular applications.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.95,
          "end": 18.84,
          "en": "And that option is about Static Site Generation, SSG.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 21.3,
          "end": 22.14,
          "en": "And in the end,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 22.14,
          "end": 26.19,
          "en": "this option is a combination of the two other options,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 26.19,
          "end": 27.12,
          "en": "you could say,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 27.12,
          "end": 28.59,
          "en": "because the idea here",
          "zh": ""
        },
        {
          "id": 10,
          "start": 28.59,
          "end": 33.48,
          "en": "is that you do have some server-side rendered application,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 33.48,
          "end": 37.5,
          "en": "but that Angular routes are also pre-rendered",
          "zh": ""
        },
        {
          "id": 12,
          "start": 37.5,
          "end": 38.74,
          "en": "at build time",
          "zh": ""
        },
        {
          "id": 13,
          "start": 39.81,
          "end": 43.47,
          "en": "so that when a user visits a certain page,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 43.47,
          "end": 46.65,
          "en": "that page might already exist",
          "zh": ""
        },
        {
          "id": 15,
          "start": 46.65,
          "end": 50.22,
          "en": "because it was pre-rendered during the build process,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 50.22,
          "end": 54.24,
          "en": "and it doesn't need to be rendered dynamically on the server",
          "zh": ""
        },
        {
          "id": 17,
          "start": 54.24,
          "end": 57.06,
          "en": "when the user sends their request.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 57.06,
          "end": 59.67,
          "en": "Therefore, that page can be served quicker",
          "zh": ""
        },
        {
          "id": 19,
          "start": 59.67,
          "end": 63.45,
          "en": "than if it would be pre-rendered on demand on the server,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 63.45,
          "end": 67.47,
          "en": "which is what we have with just server-side rendered apps.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 67.47,
          "end": 71.58,
          "en": "There, every page is rendered on demand on the server",
          "zh": ""
        },
        {
          "id": 22,
          "start": 71.58,
          "end": 73.47,
          "en": "when a request comes in.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 73.47,
          "end": 75.09,
          "en": "With this third option,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 75.09,
          "end": 79.5,
          "en": "at least some pages are pre-rendered at build time instead.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 79.5,
          "end": 83.76,
          "en": "Now the browser still receives the finished page, therefore,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 83.76,
          "end": 85.65,
          "en": "no matter if it was pre-rendered",
          "zh": ""
        },
        {
          "id": 27,
          "start": 85.65,
          "end": 88.28999999999999,
          "en": "or if it's a page that was not pre-rendered",
          "zh": ""
        },
        {
          "id": 28,
          "start": 88.28999999999999,
          "end": 92.72999999999999,
          "en": "and that was therefore dynamically rendered on the server.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 92.72999999999999,
          "end": 96.27000000000001,
          "en": "And then just as before, this application,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 96.27000000000001,
          "end": 100.32,
          "en": "this page is in the end hydrated on the client site",
          "zh": ""
        },
        {
          "id": 31,
          "start": 100.32,
          "end": 103.92,
          "en": "in the browser and becomes a single-page application",
          "zh": ""
        },
        {
          "id": 32,
          "start": 103.92,
          "end": 107.07,
          "en": "after it was received by the browser.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 107.07,
          "end": 110.13,
          "en": "Now, when using Static Site Generation,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 110.13,
          "end": 113.28,
          "en": "you still need a dynamic web server,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 113.28,
          "end": 117.93,
          "en": "unless you really pre-render all your application pages.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 117.93,
          "end": 120.45,
          "en": "But if you have a mixture of some pre-rendered",
          "zh": ""
        },
        {
          "id": 37,
          "start": 120.45,
          "end": 122.7,
          "en": "and some dynamically rendered pages,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 122.7,
          "end": 125.46,
          "en": "you need a dynamic web server.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 125.46,
          "end": 128.16,
          "en": "Now, a potential disadvantage of this approach",
          "zh": ""
        },
        {
          "id": 40,
          "start": 128.16,
          "end": 132.39,
          "en": "is that if you pre-render a page that fetches data,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 132.39,
          "end": 136.14,
          "en": "that data is, of course, fetched during the build process",
          "zh": ""
        },
        {
          "id": 42,
          "start": 136.14,
          "end": 137.94,
          "en": "and never thereafter.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 137.94,
          "end": 142.32,
          "en": "So you might be showing some outdated data on your website",
          "zh": ""
        },
        {
          "id": 44,
          "start": 142.32,
          "end": 144.6,
          "en": "until the application is built again,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 144.6,
          "end": 147.32999999999998,
          "en": "and the pages are pre-rendered again.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 147.32999999999998,
          "end": 149.7,
          "en": "Now for some data that might not matter,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 149.7,
          "end": 152.4,
          "en": "some data might not change that often,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 152.4,
          "end": 153.233,
          "en": "but of course,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 153.233,
          "end": 156,
          "en": "depending on which kind of application you are building,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 156,
          "end": 158.19,
          "en": "you also might be dealing with data",
          "zh": ""
        },
        {
          "id": 51,
          "start": 158.19,
          "end": 161.01,
          "en": "that must be as up-to-date as possible,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 161.01,
          "end": 163.47,
          "en": "and in that case, pre-rendering pages",
          "zh": ""
        },
        {
          "id": 53,
          "start": 163.47,
          "end": 166.47,
          "en": "that rely on such data is a bad idea.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 166.47,
          "end": 167.97,
          "en": "But with that out of the way,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 167.97,
          "end": 171.3,
          "en": "let's see how you could add pre-rendering",
          "zh": ""
        },
        {
          "id": 56,
          "start": 171.3,
          "end": 173.403,
          "en": "to your Angular application.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
