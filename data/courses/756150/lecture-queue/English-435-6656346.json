{
  "version": 1,
  "courseId": 756150,
  "courseSlug": "the-complete-guide-to-angular-2",
  "courseTitle": "Angular - The Complete Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "6656346",
      "title": "Controlling Navigation with canDeactivate",
      "lectureOrder": 474,
      "videoOrder": 435,
      "sourceHash": "ab96c8e9efe7719b48b5fc67a95ec5216988711a806a2941aeeaecc2d514f7d8",
      "cues": [
        {
          "id": 1,
          "start": 2.61,
          "end": 3.93,
          "en": "Instructor: In the last lectures,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.93,
          "end": 5.67,
          "en": "we learned how to use CanActivate",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.67,
          "end": 7.86,
          "en": "to control access to a route.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 7.86,
          "end": 10.59,
          "en": "Now I wanna focus on the control",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.59,
          "end": 13.59,
          "en": "of whether you are allowed to leave a route or not.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.59,
          "end": 15.45,
          "en": "We can control this too,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 15.45,
          "end": 17.22,
          "en": "and we might want to control this",
          "zh": ""
        },
        {
          "id": 8,
          "start": 17.22,
          "end": 18.84,
          "en": "if we are locked in,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 18.84,
          "end": 21.27,
          "en": "once we do edit a server.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 21.27,
          "end": 22.35,
          "en": "Now we, for example,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 22.35,
          "end": 25.35,
          "en": "are allowed to edit the Devserver.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 25.35,
          "end": 29.01,
          "en": "And here if we actually changed something,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 29.01,
          "end": 30.93,
          "en": "I want to ask the user",
          "zh": ""
        },
        {
          "id": 14,
          "start": 30.93,
          "end": 33.78,
          "en": "if he accidentally clicks back or somewhere else,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 33.78,
          "end": 35.85,
          "en": "if you really want to leave,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 35.85,
          "end": 39.51,
          "en": "or if you maybe forgot to click update server first.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 39.51,
          "end": 43.02,
          "en": "So this convenience method of keeping the user",
          "zh": ""
        },
        {
          "id": 18,
          "start": 43.02,
          "end": 45.48,
          "en": "from accidentally navigating away.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 45.48,
          "end": 47.37,
          "en": "How can we implement this?",
          "zh": ""
        },
        {
          "id": 20,
          "start": 47.37,
          "end": 50.73,
          "en": "Let's go to the edit-server.component for this.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 50.73,
          "end": 51.9,
          "en": "Here.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 51.9,
          "end": 55.233,
          "en": "And let's add a new property below allowEdit.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 56.13,
          "end": 58.68,
          "en": "I'll add a changesSaved property,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 58.68,
          "end": 61.17,
          "en": "which is false by default.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 61.17,
          "end": 63.48,
          "en": "And which I want to change,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 63.48,
          "end": 65.94,
          "en": "whenever we click onUpdateServer.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 65.94,
          "end": 69.09,
          "en": "Here of course, we did update the server.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 69.09,
          "end": 71.58,
          "en": "So I want to call changesSaved,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 71.58,
          "end": 73.83,
          "en": "and set this to true here.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 73.83,
          "end": 76.59,
          "en": "Because now the changes were indeed saved.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 76.59,
          "end": 78.45,
          "en": "After the changes were saved here,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 78.45,
          "end": 80.28,
          "en": "I want to navigate away.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 80.28,
          "end": 84.45,
          "en": "So I will inject the router here, of type Router.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 84.45,
          "end": 87.36,
          "en": "Make sure to add the import at the top, as always,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 87.36,
          "end": 90.15,
          "en": "from the @angular/router package.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 90.15,
          "end": 93.84,
          "en": "And then here after we saved our changes,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 93.84,
          "end": 97.17,
          "en": "I want to navigate away.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 97.17,
          "end": 101.43,
          "en": "I want to go up one level to the last loaded server.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 101.43,
          "end": 105.53999999999999,
          "en": "And for this I will pass the relativeTo configuration,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 105.53999999999999,
          "end": 109.02000000000001,
          "en": "and want to navigate relativeTo the currently active route.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 109.02000000000001,
          "end": 109.97999999999999,
          "en": "So far so good.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 109.97999999999999,
          "end": 113.91,
          "en": "We're changing this changesSaved property here.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 113.91,
          "end": 114.93,
          "en": "Now let's make sure",
          "zh": ""
        },
        {
          "id": 44,
          "start": 114.93,
          "end": 118.62,
          "en": "that whenever the user tries to accidentally navigate away,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 118.62,
          "end": 120.18,
          "en": "that we prevent him from doing so,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 120.18,
          "end": 123.78,
          "en": "or at least ask if he really wants to leave.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 123.78,
          "end": 126.96,
          "en": "Now we somehow need to execute this code",
          "zh": ""
        },
        {
          "id": 48,
          "start": 126.96,
          "end": 128.25,
          "en": "in this component here,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 128.25,
          "end": 131.7,
          "en": "because we will need access to this changesSaved method,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 131.7,
          "end": 133.05,
          "en": "which informs us",
          "zh": ""
        },
        {
          "id": 51,
          "start": 133.05,
          "end": 134.97,
          "en": "on whether this update button",
          "zh": ""
        },
        {
          "id": 52,
          "start": 134.97,
          "end": 136.68,
          "en": "was clicked or not.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 136.68,
          "end": 141.09,
          "en": "However, a guard always needs to be a service,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 141.09,
          "end": 142.56,
          "en": "because we need to provide it",
          "zh": ""
        },
        {
          "id": 55,
          "start": 142.56,
          "end": 145.17000000000002,
          "en": "just like we provided the off guard.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 145.17000000000002,
          "end": 146.94,
          "en": "So somehow this doesn't fit.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 146.94,
          "end": 149.28,
          "en": "We need to access the code in our component",
          "zh": ""
        },
        {
          "id": 58,
          "start": 149.28,
          "end": 150.39,
          "en": "and have a service.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 150.39,
          "end": 152.82,
          "en": "And that sounds like a complicated setup,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 152.82,
          "end": 153.653,
          "en": "but it isn't.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 153.653,
          "end": 155.55,
          "en": "It's actually really simple.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 155.55,
          "end": 157.5,
          "en": "In my edit-server folder here,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 157.5,
          "end": 159.45,
          "en": "I'll add a new file.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 159.45,
          "end": 163.41,
          "en": "I'll name it can-deactivate-guard.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 163.41,
          "end": 164.243,
          "en": "And as again,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 164.243,
          "end": 166.863,
          "en": "will also be a service as all guards are.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 169.14,
          "end": 170.82,
          "en": "And in here,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 170.82,
          "end": 174.36,
          "en": "I first of all now want to export an interface.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 174.36,
          "end": 176.61,
          "en": "An interface simply is a contract",
          "zh": ""
        },
        {
          "id": 70,
          "start": 176.61,
          "end": 178.68,
          "en": "which can be imported by some our class.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 178.68,
          "end": 183.15,
          "en": "Let's say, which forces this class to provide some logic.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 183.15,
          "end": 188.13,
          "en": "So here I will name this CanComponentDeactivate.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 188.13,
          "end": 190.44,
          "en": "And this interface will require one thing",
          "zh": ""
        },
        {
          "id": 74,
          "start": 190.44,
          "end": 192.93,
          "en": "from the component which implements it.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 192.93,
          "end": 196.833,
          "en": "This component should have a canDeactivate method.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 197.7,
          "end": 198.53300000000002,
          "en": "This method,",
          "zh": ""
        },
        {
          "id": 77,
          "start": 198.53300000000002,
          "end": 199.86,
          "en": "and this is simply how I define",
          "zh": ""
        },
        {
          "id": 78,
          "start": 199.86,
          "end": 202.11,
          "en": "the type of this canDeactivate method,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 202.11,
          "end": 203.52,
          "en": "since this is only an interface,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 203.52,
          "end": 205.07,
          "en": "it won't contain the actual logic.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 205.07,
          "end": 208.11,
          "en": "It will only contain information how it should look like.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 208.11,
          "end": 210.96,
          "en": "So this method should take no arguments,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 210.96,
          "end": 213.3,
          "en": "but in the end it should return an Observable,",
          "zh": ""
        },
        {
          "id": 84,
          "start": 213.3,
          "end": 216.63,
          "en": "which therefore needs to be imported in this file here",
          "zh": ""
        },
        {
          "id": 85,
          "start": 216.63,
          "end": 219.12,
          "en": "from rxjs/observable,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 219.12,
          "end": 222.69,
          "en": "which will resolve to a boolean in the end.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 222.69,
          "end": 224.37,
          "en": "Or a Promise,",
          "zh": ""
        },
        {
          "id": 88,
          "start": 224.37,
          "end": 227.97,
          "en": "which will resolve to a boolean in the end.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 227.97,
          "end": 229.68,
          "en": "Or just a boolean.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 229.68,
          "end": 231.93,
          "en": "You might recognize this pattern here,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 231.93,
          "end": 234,
          "en": "from the canActivate guard.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 234,
          "end": 236.91,
          "en": "These guards share the same structure.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 236.91,
          "end": 239.433,
          "en": "So that is my interface.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 241.11,
          "end": 242.01,
          "en": "Nice to have it.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 242.01,
          "end": 244.56,
          "en": "But that alone won't do the trick.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 244.56,
          "end": 246.18,
          "en": "Now let's come to the important thing.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 246.18,
          "end": 247.77,
          "en": "The meat of this class,",
          "zh": ""
        },
        {
          "id": 98,
          "start": 247.77,
          "end": 249.24,
          "en": "of the service here, I should say.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 249.24,
          "end": 250.83,
          "en": "The service itself.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 250.83,
          "end": 252.843,
          "en": "So I'll name it CanDeactivateGuard.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 254.653,
          "end": 258.48,
          "en": "And this guard will implement CanDeactivate.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 258.48,
          "end": 261.66,
          "en": "This is a interface provided by the @angular/router.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 261.66,
          "end": 264.36,
          "en": "So we need to import it from there.",
          "zh": ""
        },
        {
          "id": 104,
          "start": 264.36,
          "end": 266.31,
          "en": "This actually is a generic type,",
          "zh": ""
        },
        {
          "id": 105,
          "start": 266.31,
          "end": 269.13,
          "en": "and it will wrap our own interface.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 269.13,
          "end": 271.05,
          "en": "So it will wrap an interface",
          "zh": ""
        },
        {
          "id": 107,
          "start": 271.05,
          "end": 274.32,
          "en": "which forces some component or some class",
          "zh": ""
        },
        {
          "id": 108,
          "start": 274.32,
          "end": 276.93,
          "en": "to implement the CanDeactivate method.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 276.93,
          "end": 278.58,
          "en": "Might sound complicated,",
          "zh": ""
        },
        {
          "id": 110,
          "start": 278.58,
          "end": 281.15999999999997,
          "en": "but this is the setup which will make sure",
          "zh": ""
        },
        {
          "id": 111,
          "start": 281.15999999999997,
          "end": 284.7,
          "en": "that we later can easily connect a component",
          "zh": ""
        },
        {
          "id": 112,
          "start": 284.7,
          "end": 287.82,
          "en": "to our CanDeactivateGuard here.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 287.82,
          "end": 290.88,
          "en": "So for now, let's just go with that piece of information.",
          "zh": ""
        },
        {
          "id": 114,
          "start": 290.88,
          "end": 293.85,
          "en": "And now this class here, this guard,",
          "zh": ""
        },
        {
          "id": 115,
          "start": 293.85,
          "end": 297.3,
          "en": "will also need to have a CanDeactivate method.",
          "zh": ""
        },
        {
          "id": 116,
          "start": 297.3,
          "end": 299.25,
          "en": "This is the CanDeactivate method,",
          "zh": ""
        },
        {
          "id": 117,
          "start": 299.25,
          "end": 301.92,
          "en": "which will be called by the @angular/router,",
          "zh": ""
        },
        {
          "id": 118,
          "start": 301.92,
          "end": 304.17,
          "en": "once we try to leave a route.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 304.17,
          "end": 306.96,
          "en": "Therefore, this will have the component,",
          "zh": ""
        },
        {
          "id": 120,
          "start": 306.96,
          "end": 308.97,
          "en": "on which we're currently on as an argument.",
          "zh": ""
        },
        {
          "id": 121,
          "start": 308.97,
          "end": 310.26,
          "en": "And this component",
          "zh": ""
        },
        {
          "id": 122,
          "start": 310.26,
          "end": 312.78,
          "en": "needs to be of type CanComponentDeactivate,",
          "zh": ""
        },
        {
          "id": 123,
          "start": 312.78,
          "end": 314.67,
          "en": "which means it needs to be a component,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 314.67,
          "end": 317.64,
          "en": "which has this interface here implemented.",
          "zh": ""
        },
        {
          "id": 125,
          "start": 317.64,
          "end": 321.24,
          "en": "Therefore a component which has a CanDeactivate method.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 321.24,
          "end": 323.553,
          "en": "This will become super important in a second.",
          "zh": ""
        },
        {
          "id": 127,
          "start": 324.75,
          "end": 328.41,
          "en": "We also will receive the currentRoute as an argument.",
          "zh": ""
        },
        {
          "id": 128,
          "start": 328.41,
          "end": 331.92,
          "en": "So that is a ActivatedRouteSnapshot.",
          "zh": ""
        },
        {
          "id": 129,
          "start": 331.92,
          "end": 334.47,
          "en": "Need to make sure to import this too.",
          "zh": ""
        },
        {
          "id": 130,
          "start": 334.47,
          "end": 336.45,
          "en": "It will have the currentState,",
          "zh": ""
        },
        {
          "id": 131,
          "start": 336.45,
          "end": 339.27,
          "en": "so that is a RouterStateSnapshot.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 339.27,
          "end": 341.04,
          "en": "Import this too.",
          "zh": ""
        },
        {
          "id": 133,
          "start": 341.04,
          "end": 344.25,
          "en": "And the nextState, so where do you want to go?",
          "zh": ""
        },
        {
          "id": 134,
          "start": 344.25,
          "end": 346.53,
          "en": "Because remember this will be called at the end,",
          "zh": ""
        },
        {
          "id": 135,
          "start": 346.53,
          "end": 348.69,
          "en": "when we want to leave a route.",
          "zh": ""
        },
        {
          "id": 136,
          "start": 348.69,
          "end": 351.84000000000003,
          "en": "So nextState is an optional argument though.",
          "zh": ""
        },
        {
