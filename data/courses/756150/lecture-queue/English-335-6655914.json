{
  "version": 1,
  "courseId": 756150,
  "courseSlug": "the-complete-guide-to-angular-2",
  "courseTitle": "Angular - The Complete Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "6655914",
      "title": "Styling Elements Dynamically with ngStyle",
      "lectureOrder": 361,
      "videoOrder": 335,
      "sourceHash": "37cf7709ac1fe88c3ff35d19b4607f0e85778188ba20f2151719ab7f6afed6d9",
      "cues": [
        {
          "id": 1,
          "start": 2.665,
          "end": 6.84,
          "en": "-: In the last lecture we saw NGF, super useful directive.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 6.84,
          "end": 9.84,
          "en": "And NGF was a structural directive.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 9.84,
          "end": 13.59,
          "en": "The other type of directives are attribute directives,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 13.59,
          "end": 14.73,
          "en": "which are called like this",
          "zh": ""
        },
        {
          "id": 5,
          "start": 14.73,
          "end": 18.3,
          "en": "because they really just look like normal HTML attributes",
          "zh": ""
        },
        {
          "id": 6,
          "start": 18.3,
          "end": 20.85,
          "en": "without a star, basically.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.85,
          "end": 21.99,
          "en": "Let's add one.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 21.99,
          "end": 24.3,
          "en": "On these server component here,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 24.3,
          "end": 26.07,
          "en": "we output the server status, right?",
          "zh": ""
        },
        {
          "id": 10,
          "start": 26.07,
          "end": 28.98,
          "en": "And the server status always is offline.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 28.98,
          "end": 30.51,
          "en": "Let's mix this up.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 30.51,
          "end": 34.5,
          "en": "Let's say we want to dynamically create this.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 34.5,
          "end": 36.18,
          "en": "So add the constructor,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 36.18,
          "end": 38.22,
          "en": "which is just a built in method.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 38.22,
          "end": 40.05,
          "en": "Each types group class has,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 40.05,
          "end": 43.05,
          "en": "which is called once this component is created.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 43.05,
          "end": 47.82,
          "en": "And here I will set the service status to a random value.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 47.82,
          "end": 50.46,
          "en": "I will use the math random function,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 50.46,
          "end": 53.7,
          "en": "and this gives us a random number between zero and one,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 53.7,
          "end": 55.5,
          "en": "a floating point number.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 55.5,
          "end": 58.71,
          "en": "And if this is greater than 0.5,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 58.71,
          "end": 61.38,
          "en": "I want to set the status to online,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 61.38,
          "end": 64.5,
          "en": "otherwise I will set it to offline.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 64.5,
          "end": 68.61,
          "en": "So with that, we shouldn't get the same status all the time.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 68.61,
          "end": 71.25,
          "en": "And now let's check this.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 71.25,
          "end": 72.78,
          "en": "We see indeed online and offline.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 72.78,
          "end": 73.613,
          "en": "That's lucky.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 73.613,
          "end": 75.57,
          "en": "Could have of course also been both offline",
          "zh": ""
        },
        {
          "id": 29,
          "start": 75.57,
          "end": 78,
          "en": "since we have a 50% chance.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 78,
          "end": 80.28,
          "en": "Now we have two different statuses here.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 80.28,
          "end": 82.89,
          "en": "And now let's say we want to change",
          "zh": ""
        },
        {
          "id": 32,
          "start": 82.89,
          "end": 87.06,
          "en": "the background color of this component",
          "zh": ""
        },
        {
          "id": 33,
          "start": 87.06,
          "end": 89.253,
          "en": "depending on the service status.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 90.12,
          "end": 92.72999999999999,
          "en": "For this we can use a number directive.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 92.72999999999999,
          "end": 96.72,
          "en": "On this wrapping paragraph here, I can add it.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 96.72,
          "end": 98.793,
          "en": "And it's called ngStyle.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 100.277,
          "end": 101.4,
          "en": "Now that's a built in directive.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 101.4,
          "end": 105.57,
          "en": "You can recognize this on the NG at the beginning.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 105.57,
          "end": 108.03,
          "en": "An NG style, that's the directive,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 108.03,
          "end": 110.22,
          "en": "is pretty useless like this.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 110.22,
          "end": 113.88,
          "en": "We need to give it some configuration to do something.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 113.88,
          "end": 117.53999999999999,
          "en": "That is why we will use property binding on this directive.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 117.53999999999999,
          "end": 119.72999999999999,
          "en": "And it's super important to understand",
          "zh": ""
        },
        {
          "id": 44,
          "start": 119.72999999999999,
          "end": 121.47,
          "en": "that the square brackets here",
          "zh": ""
        },
        {
          "id": 45,
          "start": 121.47,
          "end": 124.2,
          "en": "are not part of the directive name.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 124.2,
          "end": 125.95,
          "en": "The directive name is just ngStyle.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 127.057,
          "end": 128.61,
          "en": "The square brackets indicate",
          "zh": ""
        },
        {
          "id": 48,
          "start": 128.61,
          "end": 132.21,
          "en": "that we want to bind to some property on this directive.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 132.21,
          "end": 136.173,
          "en": "And this property name happens to also be ngStyle.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 137.31,
          "end": 141.12,
          "en": "We will see this in practice on our own directives",
          "zh": ""
        },
        {
          "id": 51,
          "start": 141.12,
          "end": 142.98,
          "en": "in the directive section later.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 142.98,
          "end": 145.53,
          "en": "But super important to understand that property binding",
          "zh": ""
        },
        {
          "id": 53,
          "start": 145.53,
          "end": 147,
          "en": "is not the same as a directive.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 147,
          "end": 148.23,
          "en": "It's totally different.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 148.23,
          "end": 152.07,
          "en": "We are binding to a property of the directive.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 152.07,
          "end": 157.07,
          "en": "This ngStyle property expects to get a JavaScript object.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 157.26,
          "end": 160.07999999999998,
          "en": "And here we define key value pairs",
          "zh": ""
        },
        {
          "id": 58,
          "start": 160.07999999999998,
          "end": 162.45,
          "en": "of the style name, as the key,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 162.45,
          "end": 165.45,
          "en": "and the value of the style as the well value.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 165.45,
          "end": 169.02,
          "en": "So for example, we could find background color,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 169.02,
          "end": 171.24,
          "en": "and if you want to use this notation with the dash",
          "zh": ""
        },
        {
          "id": 62,
          "start": 171.24,
          "end": 173.64,
          "en": "you have to wrap it in single quotation marks",
          "zh": ""
        },
        {
          "id": 63,
          "start": 173.64,
          "end": 176.85,
          "en": "to make it a valid JavaScript property name.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 176.85,
          "end": 180.63,
          "en": "Or you use the Camel case notation background color,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 180.63,
          "end": 181.92,
          "en": "like this.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 181.92,
          "end": 185.22,
          "en": "And then you could set this to red",
          "zh": ""
        },
        {
          "id": 67,
          "start": 185.22,
          "end": 186.63,
          "en": "but I don't want to set it to red.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 186.63,
          "end": 187.68,
          "en": "I want to set it to something",
          "zh": ""
        },
        {
          "id": 69,
          "start": 187.68,
          "end": 189.99,
          "en": "depending on the server status.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 189.99,
          "end": 194.1,
          "en": "So here we could simply call a method,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 194.1,
          "end": 195.903,
          "en": "get color.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 196.8,
          "end": 199.53,
          "en": "So that is really mixing now all the things",
          "zh": ""
        },
        {
          "id": 73,
          "start": 199.53,
          "end": 202.14,
          "en": "and make it clear that between liquidation marks",
          "zh": ""
        },
        {
          "id": 74,
          "start": 202.14,
          "end": 204.48,
          "en": "we are executing types of code here.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 204.48,
          "end": 207.63,
          "en": "So therefore we can of course call a method.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 207.63,
          "end": 211.59,
          "en": "Now get color is a method we can add here.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 211.59,
          "end": 214.71,
          "en": "And get color should now, let's say return green",
          "zh": ""
        },
        {
          "id": 78,
          "start": 214.71,
          "end": 218.25,
          "en": "if the status is online, and red otherwise.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 218.25,
          "end": 221.04,
          "en": "So I will return something.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 221.04,
          "end": 223.05,
          "en": "First I check the server status.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 223.05,
          "end": 225.21,
          "en": "So this server status.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 225.21,
          "end": 228.32999999999998,
          "en": "And if this is equal to online,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 228.32999999999998,
          "end": 230.43,
          "en": "using ternary expression here,",
          "zh": ""
        },
        {
          "id": 84,
          "start": 230.43,
          "end": 233.433,
          "en": "I will return green,",
          "zh": ""
        },
        {
          "id": 85,
          "start": 234.48,
          "end": 237.36,
          "en": "otherwise I will return red.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 237.36,
          "end": 240.3,
          "en": "So get color, will return green or red.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 240.3,
          "end": 242.79,
          "en": "And this is then assigned as the background color",
          "zh": ""
        },
        {
          "id": 88,
          "start": 242.79,
          "end": 244.56,
          "en": "with ngStyle.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 244.56,
          "end": 247.773,
          "en": "If we now save this, let's have a look at the result.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 248.82,
          "end": 252.96,
          "en": "We see indeed the running server has a green background",
          "zh": ""
        },
        {
          "id": 91,
          "start": 252.96,
          "end": 255.63,
          "en": "and the offline server has a red one.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 255.63,
          "end": 256.98,
          "en": "So that is working.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 256.98,
          "end": 260.52,
          "en": "NGStyle allows us to dynamically update that.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 260.52,
          "end": 263.76,
          "en": "If I reload, you'll see now both are offline,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 263.76,
          "end": 265.17,
          "en": "so both are red now.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 265.17,
          "end": 267.66,
          "en": "And that is the big advantage of ngStyle.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 267.66,
          "end": 270.66,
          "en": "It allows you to dynamically update the styles.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 270.66,
          "end": 274.62,
          "en": "And of course if the service status here did change",
          "zh": ""
        },
        {
          "id": 99,
          "start": 274.62,
          "end": 275.82,
          "en": "over time,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 275.82,
          "end": 278.82,
          "en": "it would update the styling respectively.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 278.82,
          "end": 283.8,
          "en": "So this binding we set up here still is working.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 283.8,
          "end": 286.92,
          "en": "If the service data is here,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 286.92,
          "end": 290.1,
          "en": "which is responsible for choosing the right color, changes,",
          "zh": ""
        },
        {
          "id": 104,
          "start": 290.1,
          "end": 291.42,
          "en": "it updates the style.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 291.42,
          "end": 293.073,
          "en": "So that's ngStyle.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 293.073,
          "end": 295.89,
          "en": "An attribute directive added like a attribute.",
          "zh": ""
        },
        {
          "id": 107,
          "start": 295.89,
          "end": 298.68,
          "en": "And in this case also using property binding",
          "zh": ""
        },
        {
          "id": 108,
          "start": 298.68,
          "end": 299.703,
          "en": "to configure it.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
