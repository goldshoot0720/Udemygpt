        },
        {
          "id": 20,
          "start": 68.91,
          "end": 70.98,
          "en": "outside of this component.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 70.98,
          "end": 75.78,
          "en": "So srvElement could be added here and now from the outside,",
