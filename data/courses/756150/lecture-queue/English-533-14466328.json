          "id": 174,
          "start": 485.13,
          "end": 488.85,
          "en": "get a feeling for whether that works and what we get here.",
          "zh": ""
        },
        {
          "id": 175,
          "start": 488.85,
          "end": 490.56,
          "en": "So let's save this.",
          "zh": ""
        },
        {
          "id": 176,
          "start": 490.56,
          "end": 492.3,
          "en": "And now with the subscription set up and",
          "zh": ""
        },
        {
          "id": 177,
          "start": 492.3,
          "end": 494.94,
          "en": "with us subscribing here, by the way, you don't need to",
          "zh": ""
        },
        {
          "id": 178,
          "start": 494.94,
          "end": 497.46,
          "en": "manage the subscription and unsubscribe because",
          "zh": ""
        },
        {
          "id": 179,
          "start": 497.46,
          "end": 499.8,
          "en": "it will complete after being done anyways.",
          "zh": ""
        },
        {
          "id": 180,
          "start": 499.8,
          "end": 502.11,
          "en": "And it's an observable provided by Angular",
          "zh": ""
        },
        {
          "id": 181,
          "start": 502.11,
