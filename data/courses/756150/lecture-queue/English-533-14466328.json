        },
        {
          "id": 84,
          "start": 240.66,
          "end": 243.15,
          "en": "with a REST API provided by Firebase.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 243.15,
          "end": 245.788,
          "en": "They just translate your path, you're sending it",
          "zh": ""
        },
        {
          "id": 86,
          "start": 245.788,
          "end": 248.94,
          "en": "to to a folder structure in your database.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 248.94,
          "end": 251.97,
          "en": "You are not communicating directly with a database here.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 251.97,
          "end": 254.73,
          "en": "And I'm stressing this because it is important to keep",
          "zh": ""
        },
        {
          "id": 89,
          "start": 254.73,
          "end": 256.892,
          "en": "in mind that you never communicate directly",
          "zh": ""
        },
        {
          "id": 90,
          "start": 256.892,
          "end": 260.76,
          "en": "with a database from inside your Angular app.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 260.76,
          "end": 264.3,
          "en": "So let's say here we wanna have a note, a folder",
