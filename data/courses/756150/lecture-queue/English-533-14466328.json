        },
        {
          "id": 38,
          "start": 105.47999999999999,
          "end": 108.75,
          "en": "and you import the HTTP client module.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 108.75,
          "end": 112.53,
          "en": "Now you add that HTTP client module here",
          "zh": ""
        },
        {
          "id": 40,
          "start": 112.53,
          "end": 114.033,
          "en": "in your imports array.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 115.02000000000001,
          "end": 116.25,
          "en": "Just like that.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 116.25,
          "end": 119.7,
          "en": "This now unlocks the HTTP client Angular offers",
          "zh": ""
        },
        {
          "id": 43,
          "start": 119.7,
          "end": 121.65,
          "en": "in your whole project.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 121.65,
          "end": 124.14,
          "en": "And with that, we can now start sending requests",
          "zh": ""
        },
        {
          "id": 45,
          "start": 124.14,
          "end": 127.32,
          "en": "in our app component here in there",
          "zh": ""
        },
        {
          "id": 46,
          "start": 127.32,
          "end": 130.11,
