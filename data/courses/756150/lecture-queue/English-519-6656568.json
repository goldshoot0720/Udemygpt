          "zh": ""
        },
        {
          "id": 25,
          "start": 51.96,
          "end": 55.89,
          "en": "medium, large, small, and we get this date.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 55.89,
          "end": 58.47,
          "en": "Now you could, for example,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 58.47,
          "end": 60.48,
          "en": "put this instance type",
          "zh": ""
        },
        {
          "id": 28,
          "start": 60.48,
          "end": 64.02,
          "en": "to be all upper case and the date.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 64.02,
          "end": 66.75,
          "en": "I'd like to change something about the date too",
          "zh": ""
        },
        {
          "id": 30,
          "start": 66.75,
          "end": 68.82,
