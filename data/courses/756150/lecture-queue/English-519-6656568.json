          "id": 21,
          "start": 43.02,
          "end": 44.94,
          "en": "of things we could fix here.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 44.94,
          "end": 46.47,
          "en": "Now, for example,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 46.47,
          "end": 49.11,
