          "end": 166.17000000000002,
          "en": "Now let's move on to the date.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 166.17000000000002,
          "end": 169.86,
          "en": "And for this we got another pipe we could use.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 169.86,
          "end": 173.4,
          "en": "So if we have a look at the HTML code here",
          "zh": ""
        },
        {
          "id": 75,
          "start": 173.4,
          "end": 175.82999999999998,
          "en": "these servers started output here is responsible",
          "zh": ""
        },
        {
          "id": 76,
          "start": 175.82999999999998,
          "end": 177.45,
          "en": "for rendering the date.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 177.45,
          "end": 179.867,
          "en": "Well, if we add the pipe symbol here too,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 179.867,
          "end": 181.95,
          "en": "we could add the date pipe,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 181.95,
          "end": 183.63,
          "en": "and now we're built in type.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 183.63,
          "end": 184.92,
          "en": "And I will come back to where",
