          "end": 141.51,
          "en": "have been converted to be upper case.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 141.51,
          "end": 143.64,
          "en": "So without changing anything else,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 143.64,
          "end": 145.35,
          "en": "without, and that's important,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 145.35,
          "end": 148.82999999999998,
          "en": "changing the property itself here",
          "zh": ""
        },
        {
          "id": 66,
          "start": 148.82999999999998,
          "end": 151.92000000000002,
          "en": "the statuses, excuse me, the instance types are",
          "zh": ""
        },
        {
          "id": 67,
          "start": 151.92000000000002,
          "end": 153.69,
          "en": "still lowercase.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 153.69,
          "end": 155.7,
          "en": "Without changing anything here,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 155.7,
          "end": 157.86,
          "en": "we change the way users can view it",
          "zh": ""
        },
        {
          "id": 70,
          "start": 157.86,
          "end": 160.68,
          "en": "simply by adding a pipe here.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 160.68,
          "end": 162.84,
          "en": "That looks pretty good to me.",
          "zh": ""
        },
        {
          "id": 72,
