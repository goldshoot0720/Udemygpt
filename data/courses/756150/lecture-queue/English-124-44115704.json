          "zh": ""
        },
        {
          "id": 12,
          "start": 40.65,
          "end": 43.203,
          "en": "and also log the ticketText.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 45.81,
          "end": 48.27,
          "en": "Now, of course, we would have to change the template,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 48.27,
          "end": 50.85,
          "en": "because currently, I'm passing the entire",
          "zh": ""
        },
        {
          "id": 15,
          "start": 50.85,
          "end": 53.94,
          "en": "DOM object and not just a title.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 53.94,
          "end": 55.8,
          "en": "But of course, since title input",
          "zh": ""
        },
        {
          "id": 17,
          "start": 55.8,
          "end": 59.19,
          "en": "is that underlying input element object,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 59.19,
          "end": 61.5,
          "en": "we can also access .value here,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 61.5,
          "end": 64.5,
          "en": "and therefore, pass just the entered value",
          "zh": ""
        },
        {
          "id": 20,
          "start": 64.5,
          "end": 67.053,
          "en": "to onSubmit when the form is submitted.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 68.28,
          "end": 70.35,
          "en": "And to also get the text",
          "zh": ""
        },
        {
          "id": 22,
          "start": 70.35,
          "end": 72.6,
          "en": "that was entered into the text area,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 72.6,
          "end": 76.53,
          "en": "we can also add a template variable to that text area",
          "zh": ""
        },
        {
          "id": 24,
          "start": 76.53,
