          "zh": ""
        },
        {
          "id": 61,
          "start": 193.74,
          "end": 195.87,
          "en": "setup steps thereafter.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 195.87,
          "end": 198.54,
          "en": "So here I'll confirm with yes",
          "zh": ""
        },
        {
          "id": 63,
