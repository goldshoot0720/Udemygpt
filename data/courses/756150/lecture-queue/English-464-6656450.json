        {
          "id": 2,
          "start": 4.38,
          "end": 6.81,
          "en": "This course module is about forms,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.81,
          "end": 9.39,
          "en": "so forms on your HTML page,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.39,
          "end": 12.9,
          "en": "and how Angular can help you with those forms.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.9,
          "end": 15.96,
          "en": "Now, on first sight it might be strange,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.96,
          "end": 17.88,
          "en": "why you would need that help, right?",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.88,
          "end": 19.68,
          "en": "Because a form is something you can",
          "zh": ""
        },
        {
          "id": 8,
