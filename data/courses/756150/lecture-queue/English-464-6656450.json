          "end": 64.47,
          "en": "put some red borders around invalid controls.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 64.47,
          "end": 67.83,
          "en": "So Angular really ships with some powerful tools",
          "zh": ""
        },
        {
          "id": 24,
