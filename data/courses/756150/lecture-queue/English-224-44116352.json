        },
        {
          "id": 62,
          "start": 194.1,
          "end": 195.723,
          "en": "and false otherwise.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 196.8,
          "end": 199.92000000000002,
          "en": "So here I'll check if in my previous places",
          "zh": ""
        },
        {
          "id": 64,
          "start": 199.92000000000002,
          "end": 202.11,
          "en": "I have at least some place",
          "zh": ""
        },
        {
          "id": 65,
          "start": 202.11,
          "end": 204.81,
