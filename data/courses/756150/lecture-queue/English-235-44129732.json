  "lectures": [
    {
      "id": "44129732",
      "title": "Using the Form Validation Status To Provide User Feedback",
      "lectureOrder": 247,
      "videoOrder": 235,
      "sourceHash": "3e47eb48a248134b8077a66a3494fc7ce9a43121730c41304006e43812a33b87",
      "cues": [
        {
          "id": 1,
          "start": 0.93,
          "end": 2.88,
          "en": "Now getting this information",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.88,
          "end": 6.36,
          "en": "that the form is invalid is nice,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.36,
          "end": 7.89,
          "en": "but of course it would be nicer",
          "zh": ""
        },
        {
          "id": 4,
          "start": 7.89,
          "end": 11.1,
          "en": "if we could also show the user some error message",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.1,
          "end": 14.013,
          "en": "if an invalid form was submitted.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.36,
          "end": 19.14,
          "en": "And therefore what we might wanna do here is",
          "zh": ""
        },
        {
          "id": 7,
          "start": 19.14,
          "end": 21.42,
          "en": "go back to our template.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 21.42,
          "end": 24.24,
          "en": "And then maybe below this div here,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 24.24,
          "end": 29.093,
          "en": "we could add a paragraph with a class of control-error,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 30.72,
          "end": 34.293,
          "en": "which is a class I prepared in advance, a CSS class.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 35.25,
          "end": 38.52,
          "en": "And we might wanna output some error message here.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 38.52,
          "end": 43.14,
          "en": "We could for example, say invalid values detected.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 43.14,
          "end": 46.743,
          "en": "Please check your input.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 48.69,
          "end": 50.13,
          "en": "We can then add a if check",
          "zh": ""
        },
        {
          "id": 15,
          "start": 50.13,
          "end": 54.99,
          "en": "and check if form.form.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 54.99,
          "end": 58.98,
          "en": "So now I'm using this form template variable,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 58.98,
          "end": 62.07,
          "en": "which has a nested form object as you saw",
          "zh": ""
        },
        {
          "id": 18,
          "start": 62.07,
          "end": 63.99,
          "en": "before in the TypeScript code.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 63.99,
          "end": 67.413,
          "en": "And I can check if that is invalid.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 68.46000000000001,
          "end": 73.26,
          "en": "And in that case I will show this error message.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 73.26,
          "end": 76.68299999999999,
          "en": "I'll output this paragraph with this error message.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 78.39,
          "end": 82.053,
          "en": "So if save I that, I can see this error message here.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 83.64,
          "end": 87.57,
          "en": "And it will go away if I do enter valid values",
          "zh": ""
        },
        {
          "id": 24,
          "start": 87.57,
          "end": 89.613,
          "en": "in both inputs, as you can tell.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 90.53999999999999,
          "end": 92.72999999999999,
          "en": "But of course I see it right from the start,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 92.72999999999999,
          "end": 96.15,
          "en": "which is not the best possible user experience,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 96.15,
          "end": 98.94,
          "en": "because the user didn't have any chance",
          "zh": ""
        },
        {
          "id": 28,
          "start": 98.94,
          "end": 100.863,
          "en": "of changing that input.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 102.53999999999999,
          "end": 106.35,
          "en": "So what we might wanna do instead is use some other piece",
          "zh": ""
        },
        {
          "id": 30,
          "start": 106.35,
          "end": 111.27000000000001,
          "en": "of information and make our if check a bit more complex.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 111.27000000000001,
          "end": 113.72999999999999,
          "en": "I don't just wanna check whether the form is invalid.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 113.72999999999999,
          "end": 117.693,
          "en": "I also wanna check if touched is true,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 118.65,
          "end": 123.153,
          "en": "which means the user did at least touch one input.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 124.86,
          "end": 126.63,
          "en": "This will make sure",
          "zh": ""
        },
        {
          "id": 35,
          "start": 126.63,
          "end": 129.87,
          "en": "that initially the error message is not visible,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 129.87,
          "end": 133.68,
          "en": "and only if I at least selected one input",
          "zh": ""
        },
        {
          "id": 37,
          "start": 133.68,
          "end": 137.73,
          "en": "and deselected it, this error message will appear.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 137.73,
          "end": 140.913,
          "en": "It's still not perfect, but better therefore.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 141.96,
          "end": 144.9,
          "en": "Of course it would be better if we would make sure",
          "zh": ""
        },
        {
          "id": 40,
          "start": 144.9,
          "end": 147.39,
          "en": "that both inputs have been touched.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 147.39,
          "end": 151.53300000000002,
          "en": "So we might wanna access form.form.controls.email.touched,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 152.61,
          "end": 157.61,
          "en": "and also ensure that the password control has been touched.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 161.25,
          "end": 163.38,
          "en": "And now this is getting a bit more complex here",
          "zh": ""
        },
        {
          "id": 44,
          "start": 163.38,
          "end": 166.8,
          "en": "and I'll soon show you how to make it simpler.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 166.8,
          "end": 168.15,
          "en": "We are also getting an error,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 168.15,
          "end": 171.63,
          "en": "because Angular is not convinced here",
          "zh": ""
        },
        {
          "id": 47,
          "start": 171.63,
          "end": 174.42000000000002,
          "en": "that this email property exists.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 174.42000000000002,
          "end": 176.57999999999998,
          "en": "Instead, you should use a slightly different way",
          "zh": ""
        },
        {
          "id": 49,
          "start": 176.57999999999998,
          "end": 181.023,
          "en": "of accessing it, as this error message also tells you.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 182.88,
          "end": 183.713,
          "en": "Like this.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 184.65,
          "end": 187.08,
          "en": "With that it's still pretty complex,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 187.08,
          "end": 189.99,
          "en": "and again, we will improve that soon,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 189.99,
          "end": 192.003,
          "en": "but it should do its job now.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 193.11,
          "end": 195.06,
          "en": "With that, I check whether both the email",
          "zh": ""
        },
        {
          "id": 55,
          "start": 195.06,
          "end": 197.22,
          "en": "and password have at least been touched,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 197.22,
          "end": 201.21,
          "en": "so the user at least tried to enter something valid",
          "zh": ""
        },
        {
          "id": 57,
          "start": 201.21,
          "end": 203.973,
          "en": "and if the form then still is invalid.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 204.84,
          "end": 208.62,
          "en": "Nonetheless, if I try to run this code, you'll see",
          "zh": ""
        },
        {
          "id": 59,
          "start": 208.62,
          "end": 210.84,
          "en": "that I get an error here,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 210.84,
          "end": 214.5,
          "en": "that in the end we can't read from an undefined value",
          "zh": ""
        },
        {
          "id": 61,
          "start": 214.5,
          "end": 218.493,
          "en": "when trying to access this touched property on a control.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 219.81,
          "end": 221.13,
          "en": "The reason for that is",
          "zh": ""
        },
        {
          "id": 63,
          "start": 221.13,
          "end": 224.57999999999998,
          "en": "that when using this template driven approach,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 224.57999999999998,
          "end": 228.42000000000002,
          "en": "this entire Angular form object isn't available,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 228.42000000000002,
          "end": 231.513,
          "en": "the first time this template is being rendered.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 232.44,
          "end": 236.07,
          "en": "Instead, this template defines the form structure,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 236.07,
          "end": 238.65,
          "en": "so it's only available thereafter.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 238.65,
          "end": 242.49,
          "en": "So if I try to access some control specific information",
          "zh": ""
        },
        {
          "id": 69,
          "start": 242.49,
          "end": 245.43,
          "en": "inside of the template, that won't work,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 245.43,
          "end": 247.38,
          "en": "because the first time it's being rendered,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 247.38,
          "end": 249.54,
          "en": "that form won't have been set up yet",
          "zh": ""
        },
        {
          "id": 72,
          "start": 249.54,
          "end": 252.993,
          "en": "and the controls won't have been registered yet.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 254.64,
          "end": 257.61,
          "en": "Therefore, this approach actually won't work here,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 257.61,
          "end": 259.26,
          "en": "but that's also no problem,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 259.26,
          "end": 262.98,
          "en": "because it was a bit too verbose anyways.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 262.98,
          "end": 265.02,
          "en": "Instead, we can use a more efficient way",
          "zh": ""
        },
        {
          "id": 77,
          "start": 265.02,
          "end": 269.55,
          "en": "of accessing control specific information in the template",
          "zh": ""
        },
        {
          "id": 78,
          "start": 269.55,
          "end": 271.053,
          "en": "as I wanna do it here.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 272.4,
          "end": 275.58,
          "en": "What we can do when using the template driven approach,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 275.58,
          "end": 278.97,
          "en": "if we wanna get information about one of our controls,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 278.97,
          "end": 282.54,
          "en": "is we can add a template variable to that control,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 282.54,
          "end": 286.53,
          "en": "like email or emailCtrl for email control,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 286.53,
          "end": 288.57,
          "en": "whatever you wanna do here.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 288.57,
          "end": 290.613,
          "en": "I'll just go for email.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 291.78,
          "end": 293.67,
          "en": "And then if you would add it like this,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 293.67,
          "end": 296.7,
          "en": "you would again get access to the underlying DOM object,",
          "zh": ""
        },
        {
          "id": 87,
          "start": 296.7,
          "end": 298.35,
          "en": "which is not what I want here.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 298.35,
          "end": 302.25,
          "en": "Instead, I wanna get access to this control object",
          "zh": ""
        },
        {
          "id": 89,
          "start": 302.25,
          "end": 304.383,
          "en": "that's created by Angular.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 305.28,
          "end": 306.63,
          "en": "And I can get hold of that",
          "zh": ""
        },
        {
          "id": 91,
          "start": 306.63,
          "end": 310.44,
          "en": "by again using this special syntax we saw up here,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 310.44,
          "end": 314.253,
          "en": "but now it's not equals ngForm, but equals ngModel.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 316.26,
          "end": 319.17,
          "en": "This is some syntax that is supported",
          "zh": ""
        },
        {
          "id": 94,
          "start": 319.17,
          "end": 323.1,
          "en": "by the ngModel directive, which in the end tells Angular",
          "zh": ""
        },
        {
          "id": 95,
          "start": 323.1,
          "end": 326.7,
          "en": "that we wanna store this control object",
          "zh": ""
        },
        {
          "id": 96,
          "start": 326.7,
          "end": 329.4,
          "en": "that's created under the hood by Angular",
          "zh": ""
        },
        {
          "id": 97,
          "start": 329.4,
          "end": 333.273,
          "en": "for this input in this email template variable.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 334.62,
          "end": 338.64,
          "en": "And if I hover over email I that it's now of type ngModel,",
          "zh": ""
        },
        {
          "id": 99,
          "start": 338.64,
          "end": 341.133,
          "en": "which in the end is this form control type.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 342.464,
          "end": 345.27,
          "en": "And we can do the same for the password,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 345.27,
          "end": 348.03,
          "en": "and give this a template variable named password",
          "zh": ""
        },
        {
          "id": 102,
          "start": 348.03,
          "end": 349.923,
          "en": "which is equal to ngModel.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 351.24,
          "end": 353.58,
          "en": "With that down here in this if check,",
          "zh": ""
        },
        {
          "id": 104,
          "start": 353.58,
          "end": 357.813,
          "en": "we can now use these variables, email for example.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 359.55,
          "end": 363.06,
          "en": "And there we also got touched",
          "zh": ""
        },
        {
          "id": 106,
          "start": 363.06,
          "end": 367.02,
          "en": "as one possible field we can get access to,",
          "zh": ""
        },
        {
          "id": 107,
          "start": 367.02,
          "end": 369.12,
          "en": "because in the end, here we can now get access",
          "zh": ""
        },
        {
          "id": 108,
          "start": 369.12,
          "end": 371.97,
          "en": "to those control specific properties.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 371.97,
          "end": 376.89300000000003,
          "en": "And now with that, the error does go away and this does run.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 378.09,
          "end": 382.05,
          "en": "So that's the easier way and the working way here",
          "zh": ""
        },
        {
          "id": 111,
          "start": 382.05,
          "end": 387.03,
          "en": "of getting access to control specific information",
          "zh": ""
        },
        {
          "id": 112,
          "start": 387.03,
          "end": 389.163,
          "en": "inside of your template.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 391.11,
          "end": 394.26,
          "en": "With that, if we go back, you'll see",
          "zh": ""
        },
        {
          "id": 114,
          "start": 394.26,
          "end": 395.90999999999997,
          "en": "that if I tap into the email",
          "zh": ""
        },
        {
          "id": 115,
          "start": 395.90999999999997,
          "end": 398.34000000000003,
          "en": "and I tap out of it, nothing happens.",
          "zh": ""
        },
        {
          "id": 116,
          "start": 398.34000000000003,
          "end": 400.89,
          "en": "But if I then also tap into the password field",
          "zh": ""
        },
        {
          "id": 117,
          "start": 400.89,
          "end": 405,
          "en": "and I tap out of it, this error message appears,",
          "zh": ""
        },
        {
          "id": 118,
          "start": 405,
          "end": 407.55,
          "en": "because now I did touch both inputs",
          "zh": ""
        },
        {
          "id": 119,
          "start": 407.55,
          "end": 409.98,
          "en": "and the form is invalid thereafter.",
          "zh": ""
        },
        {
          "id": 120,
          "start": 409.98,
          "end": 412.623,
          "en": "And that's exactly what we're checking for here.",
          "zh": ""
        },
        {
          "id": 121,
          "start": 413.46,
          "end": 415.95,
          "en": "And that's the kind of information we can get",
          "zh": ""
        },
        {
          "id": 122,
          "start": 415.95,
          "end": 420.95,
          "en": "and use when using this template driven forms approach.",
          "zh": ""
        },
        {
          "id": 123,
          "start": 421.77,
          "end": 425.13,
          "en": "We get this form specific information,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 425.13,
          "end": 426.69,
          "en": "the overall form value,",
          "zh": ""
        },
        {
          "id": 125,
          "start": 426.69,
          "end": 429.72,
          "en": "and whether the form is valid or invalid,",
          "zh": ""
        },
        {
          "id": 126,
          "start": 429.72,
          "end": 433.35,
          "en": "and we can get this control specific information",
          "zh": ""
        },
        {
          "id": 127,
          "start": 433.35,
          "end": 435.57,
          "en": "either through this form",
          "zh": ""
        },
        {
          "id": 128,
          "start": 435.57,
          "end": 438.39,
          "en": "or, as required here in the template,",
          "zh": ""
        },
        {
          "id": 129,
          "start": 438.39,
          "end": 441.903,
          "en": "through these special variables we can add here.",
          "zh": ""
        },
        {
          "id": 130,
          "start": 443.25,
          "end": 444.66,
          "en": "Under the LoginComponent,",
          "zh": ""
        },
        {
          "id": 131,
          "start": 444.66,
          "end": 446.64,
          "en": "we can extract and use that information",
          "zh": ""
        },
        {
          "id": 132,
          "start": 446.64,
          "end": 448.2,
          "en": "as you learned it before.",
          "zh": ""
        },
        {
          "id": 133,
          "start": 448.2,
          "end": 451.533,
          "en": "And that's therefore, another important step forward.",
          "zh": ""
        }
