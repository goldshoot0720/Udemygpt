      "sourceHash": "2f2683ce4f5bd8d45f8e068643efe518039a9231b02b2000e901c26850484e56",
      "cues": [
        {
          "id": 1,
          "start": 3.09,
          "end": 4.59,
          "en": "-: In last lectures, we learned a lot",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.59,
          "end": 7.38,
          "en": "about how we can use property binding",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.38,
          "end": 9.39,
          "en": "and string interpolation to output data",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.39,
          "end": 10.62,
          "en": "in the template.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.62,
          "end": 12.09,
          "en": "Let's now react to events.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 12.09,
          "end": 13.98,
          "en": "For example, we have a button here,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 13.98,
          "end": 16.65,
          "en": "and after two seconds this button is enabled.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 16.65,
          "end": 19.11,
          "en": "So would be nice if we could do something.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 19.11,
          "end": 21.06,
          "en": "Once we click the button.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 21.06,
          "end": 23.22,
          "en": "Now I will soon show you how we can, actually,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 23.22,
          "end": 26.85,
          "en": "add a new server, how we can add a new replication",
          "zh": ""
        },
        {
          "id": 12,
          "start": 26.85,
          "end": 28.74,
          "en": "of our server selector",
          "zh": ""
        },
        {
          "id": 13,
          "start": 28.74,
          "end": 30.84,
          "en": "of our server component here.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 30.84,
          "end": 33.06,
          "en": "For now, what I want to do is,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 33.06,
          "end": 35.34,
          "en": "I want to output something.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 35.34,
          "end": 37.38,
          "en": "I will remove this text here.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 37.38,
          "end": 39.42,
          "en": "And instead, here, I want to output the value",
          "zh": ""
        },
        {
          "id": 18,
          "start": 39.42,
          "end": 40.35,
          "en": "of a property.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 40.35,
          "end": 42.51,
          "en": "I'll create this property, and again,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 42.51,
          "end": 44.25,
          "en": "you may ignore, ngoninit, for now.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 44.25,
          "end": 45.63,
          "en": "I will come back to this.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 45.63,
          "end": 48.93,
          "en": "I will name it, serverCreationStatus.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 48.93,
          "end": 50.37,
          "en": "And initially, I will set it to,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 50.37,
          "end": 54.453,
          "en": "no server was created, like this.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 55.53,
          "end": 58.775,
          "en": "Now this property can be output wires, string interpolation,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 58.775,
          "end": 60.54,
          "en": "serverCreationStatus.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 60.54,
          "end": 62.31,
          "en": "And I just told you I don't want",
          "zh": ""
        },
        {
          "id": 28,
          "start": 62.31,
          "end": 63.87,
          "en": "to continue outputting data.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 63.87,
          "end": 65.25,
          "en": "We want to listen to events.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 65.25,
          "end": 67.74,
          "en": "So I promised it, we'll do it.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 67.74,
          "end": 70.68,
          "en": "I will add another method, below here.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 70.68,
          "end": 73.757,
          "en": "And I will name this method, onCreateServer.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 75.03,
          "end": 77.94,
          "en": "The, on, at the beginning to, kind of, make clear",
          "zh": ""
        },
        {
          "id": 34,
          "start": 77.94,
          "end": 79.35,
          "en": "that this will be triggered",
          "zh": ""
        },
        {
          "id": 35,
          "start": 79.35,
          "end": 80.67,
          "en": "from within my template.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 80.67,
          "end": 83.16,
          "en": "You don't have to name it, on something,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 83.16,
          "end": 85.08,
          "en": "but it, kind of, makes it easier",
          "zh": ""
        },
        {
          "id": 38,
          "start": 85.08,
          "end": 87.69,
          "en": "to understand who will call this method.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 87.69,
          "end": 90.3,
          "en": "Well the user will, basically, by doing something.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 90.3,
          "end": 91.92,
          "en": "Some event will call it.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 91.92,
          "end": 94.38,
          "en": "That is what I want to symbolize with that.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 94.38,
          "end": 96.63,
          "en": "So in here, I will set these, serverCreationStatus,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 96.63,
          "end": 100.14,
          "en": "to server was created.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 100.14,
          "end": 103.47,
          "en": "So the missing piece, of course, is to call this method.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 103.47,
          "end": 107.28,
          "en": "And now, here is where event binding comes into play.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 107.28,
          "end": 110.31,
          "en": "We want to listen to this, click event, here.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 110.31,
          "end": 111.66,
          "en": "And typically, you have the",
          "zh": ""
        },
        {
          "id": 48,
          "start": 111.66,
          "end": 115.02000000000001,
          "en": "on click attribute on the HTML element,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 115.02000000000001,
          "end": 117.57,
          "en": "where you can now execute some JavaScript code.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 117.57,
          "end": 119.7,
          "en": "We won't use that with Angular, though.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 119.7,
          "end": 122.19,
          "en": "Here, we have the syntax,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 122.19,
          "end": 125.1,
          "en": "Angular offers us, event binding.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 125.1,
          "end": 126.827,
          "en": "Which uses parentheses,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 126.827,
          "end": 130.65,
          "en": "like property binding used square brackets",
          "zh": ""
        },
        {
          "id": 55,
          "start": 130.65,
          "end": 131.7,
          "en": "for events.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 131.7,
          "end": 135.21,
          "en": "Parentheses are the signal that we're using event binding.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 135.21,
          "end": 137.82,
          "en": "And here, we have to specify the name",
          "zh": ""
        },
        {
          "id": 58,
          "start": 137.82,
          "end": 139.62,
          "en": "of the event between the parentheses.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 139.62,
          "end": 141.69,
          "en": "For example, click.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 141.69,
          "end": 143.25,
          "en": "And you can basically bind",
          "zh": ""
        },
        {
          "id": 61,
          "start": 143.25,
          "end": 145.92000000000002,
          "en": "to all the events made available",
          "zh": ""
        },
        {
          "id": 62,
          "start": 145.92000000000002,
          "end": 149.7,
          "en": "by the HTML attribute, you're placing this on.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 149.7,
          "end": 150.54,
          "en": "So if you have,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 150.54,
          "end": 152.477,
          "en": "on click, on mouse enter, you could bind",
          "zh": ""
        },
        {
          "id": 65,
          "start": 152.477,
          "end": 154.44,
          "en": "to click mouse enter,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 154.44,
          "end": 157.47,
          "en": "without the, on, at the beginning.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 157.47,
          "end": 159.99,
          "en": "So we bind to the click event.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 159.99,
          "end": 162.15,
          "en": "And now between quotation marks",
          "zh": ""
        },
        {
          "id": 69,
          "start": 162.15,
          "end": 163.89,
          "en": "we put the code we want",
          "zh": ""
        },
        {
          "id": 70,
          "start": 163.89,
          "end": 166.662,
          "en": "to execute, once this event occurs.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 166.662,
          "end": 170.19,
          "en": "Now, oftentimes, you will call a method here.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 170.19,
          "end": 171.45,
          "en": "So let's do this.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 171.45,
          "end": 174.69,
          "en": "Let's point to the method we want to execute,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 174.69,
          "end": 178.68,
          "en": "which is, onCreateServer, with parentheses.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 178.68,
          "end": 180.96,
          "en": "So this method will now get executed,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 180.96,
          "end": 183.12,
          "en": "whenever we click the button.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 183.12,
          "end": 184.8,
          "en": "As a side note, you don't have",
          "zh": ""
        },
        {
          "id": 78,
          "start": 184.8,
          "end": 186.33,
          "en": "to execute a method here.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 186.33,
          "end": 188.19,
          "en": "You could also put the code you want",
          "zh": ""
        },
        {
          "id": 80,
          "start": 188.19,
          "end": 191.04,
          "en": "to execute right between quotation marks.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 191.04,
          "end": 194.01,
          "en": "Oftentimes, this is not very good,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 194.01,
          "end": 196.44,
          "en": "because you want to execute more code",
          "zh": ""
        },
        {
          "id": 83,
          "start": 196.44,
          "end": 198,
          "en": "if some event happens,",
          "zh": ""
        },
        {
          "id": 84,
          "start": 198,
          "end": 201.3,
          "en": "but if all you want to do is set some bullion property",
          "zh": ""
        },
        {
          "id": 85,
          "start": 201.3,
          "end": 202.95,
          "en": "to true, for example.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 202.95,
          "end": 206.16,
          "en": "Well, you can definitely do it as in line the template.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 206.16,
          "end": 208.02,
          "en": "As a general rule, though,",
          "zh": ""
        },
        {
          "id": 88,
          "start": 208.02,
          "end": 210.06,
          "en": "you shouldn't put too much logic",
          "zh": ""
        },
        {
          "id": 89,
          "start": 210.06,
          "end": 212.1,
          "en": "into your templates, though.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 212.1,
          "end": 215.147,
          "en": "So now we're binding the, click, event",
          "zh": ""
        },
        {
          "id": 91,
          "start": 215.147,
          "end": 219.15,
          "en": "and we execute the onCreateServer method when it occurs.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 219.15,
          "end": 221.04,
          "en": "So let's see this in action.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 221.04,
          "end": 223.38,
          "en": "In our application, let's reload the page.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 223.38,
          "end": 225.54,
          "en": "The button gets enabled.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 225.54,
          "end": 227.46,
          "en": "And now watch this part here.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 227.46,
          "end": 229.98,
          "en": "If I click the button, it changes",
          "zh": ""
        },
        {
          "id": 97,
          "start": 229.98,
          "end": 231.54,
          "en": "to server was created,",
          "zh": ""
        },
        {
          "id": 98,
          "start": 231.54,
          "end": 235.62,
          "en": "because we are triggering our own method here.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 235.62,
          "end": 237.547,
          "en": "And this is how simply event binding works.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 237.547,
          "end": 240.6,
          "en": "Use parentheses, the event name",
          "zh": ""
        },
        {
          "id": 101,
          "start": 240.6,
          "end": 243.3,
          "en": "in between and then between quotation marks,",
          "zh": ""
        },
        {
          "id": 102,
          "start": 243.3,
          "end": 244.133,
          "en": "the code you want",
          "zh": ""
        },
        {
          "id": 103,
          "start": 244.133,
          "end": 246.663,
          "en": "to execute, when this event occurs.",
          "zh": ""
        }
      ]
    }
  ],
