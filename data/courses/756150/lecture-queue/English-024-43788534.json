  "lectures": [
    {
      "id": "43788534",
      "title": "A Look Behind The Scenes Of Angular's Change Detection Mechanism",
      "lectureOrder": 28,
      "videoOrder": 24,
      "sourceHash": "2a5fdd5630666c53f24dfd74b996e4ed328bdaaed6526feb1d656f9fd8ee42c6",
      "cues": [
        {
          "id": 1,
          "start": 0,
          "end": 2.58,
          "en": "[Maximilian Schwarzmüller] In the previous lecture,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.58,
          "end": 4.5,
          "en": "you learned about state,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 4.5,
          "end": 8.49,
          "en": "so about data stored in properties here,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.49,
          "end": 12.033,
          "en": "which when changed, has an impact on the UI.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.08,
          "end": 17.43,
          "en": "And that data change has an impact on the UI",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.43,
          "end": 22.43,
          "en": "due to how Angular's change detection mechanism works.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 22.47,
          "end": 26.46,
          "en": "Because Angular automatically detects and finds out",
          "zh": ""
        },
        {
          "id": 8,
          "start": 26.46,
          "end": 28.41,
          "en": "when data changes",
          "zh": ""
        },
        {
          "id": 9,
          "start": 28.41,
          "end": 30.78,
          "en": "and it then simply takes a look at",
          "zh": ""
        },
        {
          "id": 10,
          "start": 30.78,
          "end": 33.66,
          "en": "the template of the component",
          "zh": ""
        },
        {
          "id": 11,
          "start": 33.66,
          "end": 36.87,
          "en": "and verifies whether that template,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 36.87,
          "end": 38.91,
          "en": "now that the data changed,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 38.91,
          "end": 43.14,
          "en": "maybe produces a different DOM snapshot.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 43.14,
          "end": 47.73,
          "en": "And if that's the case, it goes ahead and updates the UI",
          "zh": ""
        },
        {
          "id": 15,
          "start": 47.73,
          "end": 51.18,
          "en": "so that changes are reflected there.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 51.18,
          "end": 54.21,
          "en": "Angular does all of that automatically,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 54.21,
          "end": 56.94,
          "en": "and it does all of that automatically",
          "zh": ""
        },
        {
          "id": 18,
          "start": 56.94,
          "end": 60.06,
          "en": "with help of a part of the Angular framework",
          "zh": ""
        },
        {
          "id": 19,
          "start": 60.06,
          "end": 63,
          "en": "that's called zone.js.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 63,
          "end": 67.65,
          "en": "Now, Angular is using this zone.js thing under the hood.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 67.65,
          "end": 71.46000000000001,
          "en": "You don't need to use it yourself as an Angular developer,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 71.46000000000001,
          "end": 74.91,
          "en": "but it is interesting to understand how it works",
          "zh": ""
        },
        {
          "id": 23,
          "start": 74.91,
          "end": 78.24,
          "en": "because what this zone.js thing,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 78.24,
          "end": 81.53999999999999,
          "en": "this part of the Angular framework does",
          "zh": ""
        },
        {
          "id": 25,
          "start": 81.53999999999999,
          "end": 86.53999999999999,
          "en": "is that it automatically listens to all possible user events",
          "zh": ""
        },
        {
          "id": 26,
          "start": 87.84,
          "end": 90.78,
          "en": "that could occur on a website, for example,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 90.78,
          "end": 94.8,
          "en": "as well as some other possible events that could occur,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 94.8,
          "end": 98.19,
          "en": "like a timer expiring or anything like that.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 98.19,
          "end": 100.28999999999999,
          "en": "And when such an event occurs,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 100.28999999999999,
          "end": 105.28999999999999,
          "en": "it checks the Angular application for possible changes.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 105.36,
          "end": 109.71000000000001,
          "en": "That's how change detection works in Angular in a nutshell.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 109.71000000000001,
          "end": 113.49000000000001,
          "en": "And that's why we got this almost magic behavior",
          "zh": ""
        },
        {
          "id": 33,
          "start": 113.49000000000001,
          "end": 116.43,
          "en": "where we can simply change some data,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 116.43,
          "end": 119.16,
          "en": "some value stored in a property here,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 119.16,
          "end": 121.53,
          "en": "and the UI updates automatically",
          "zh": ""
        },
        {
          "id": 36,
          "start": 121.53,
          "end": 124.923,
          "en": "without any extra work being required from our site.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
