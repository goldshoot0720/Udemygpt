        },
        {
          "id": 32,
          "start": 103.22999999999999,
          "end": 105.24000000000001,
          "en": "we have in the TypeScript object.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 105.24000000000001,
          "end": 110.24000000000001,
          "en": "And on this diff, we place the FormGroup name directive.",
