          "zh": ""
        },
        {
          "id": 30,
          "start": 98.13,
          "end": 100.74000000000001,
          "en": "So the email and username would be the two controls",
          "zh": ""
        },
        {
          "id": 31,
          "start": 100.74000000000001,
