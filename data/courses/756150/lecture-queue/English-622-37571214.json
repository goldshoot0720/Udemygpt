      "sourceHash": "b82cd4a5e68891898ca79a0dec5f1070df18d1bc92fe2b56aadb3edacceb87f3",
      "cues": [
        {
          "id": 1,
          "start": 2.1,
          "end": 4.47,
          "en": "Well, let's stick to this application",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.47,
          "end": 6.45,
          "en": "for exploring Signals.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.45,
          "end": 9.81,
          "en": "And you'll find this starting project attached.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.81,
          "end": 12.09,
          "en": "The important thing about this project",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.09,
          "end": 15.93,
          "en": "is that it uses at least Angular version 16.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.93,
          "end": 20.58,
          "en": "Older Angular versions don't have that Signal feature,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.58,
          "end": 23.34,
          "en": "so you need 16 or higher.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 23.34,
          "end": 26.79,
          "en": "And with that, I'll copy that default folder",
          "zh": ""
        },
        {
          "id": 9,
          "start": 26.79,
          "end": 30.87,
          "en": "and name it signals, so that in there I'll rebuild",
          "zh": ""
        },
        {
          "id": 10,
          "start": 30.87,
          "end": 34.86,
          "en": "that default component, but now with my signals,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 34.86,
          "end": 37.23,
          "en": "and therefore, these files can be renamed",
          "zh": ""
        },
        {
          "id": 12,
          "start": 37.23,
          "end": 38.86,
          "en": "to signals component",
          "zh": ""
        },
        {
          "id": 13,
          "start": 40.65,
          "end": 43.77,
          "en": "like this, though of course the file names",
          "zh": ""
        },
        {
          "id": 14,
          "start": 43.77,
          "end": 46.26,
          "en": "don't really matter, I'm just doing this",
          "zh": ""
        },
        {
          "id": 15,
          "start": 46.26,
          "end": 47.79,
          "en": "here for this video.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 47.79,
          "end": 51.33,
          "en": "You don't have to rename the files to use this new feature,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 51.33,
          "end": 53.4,
          "en": "just to be clear about that.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 53.4,
          "end": 55.44,
          "en": "And in this signals component file,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 55.44,
          "end": 58.98,
          "en": "I'll also rename this component to signals component,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 58.98,
          "end": 61.68,
          "en": "though of course this is also optional.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 61.68,
          "end": 64.143,
          "en": "The naming does not matter at all.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 66,
          "end": 69.09,
          "en": "With that, though, I got this all set up.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 69.09,
          "end": 71.85,
          "en": "And now in app component ts,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 71.85,
          "end": 75.78,
          "en": "I'll add my signals component here to the imports array,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 75.78,
          "end": 78.303,
          "en": "since I'm using standalone components here.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 81.75,
          "end": 84.99,
          "en": "And in app component, I'll use app signals",
          "zh": ""
        },
        {
          "id": 27,
          "start": 84.99,
          "end": 86.913,
          "en": "instead of app default.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 88.2,
          "end": 91.89,
          "en": "And with that, we're ready to get started with signals.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 91.89,
          "end": 95.61,
          "en": "Now let's start by migrating this counter to signals.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 95.61,
          "end": 98.16,
          "en": "And that's, by the way, also a great advantage",
          "zh": ""
        },
        {
          "id": 31,
          "start": 98.16,
          "end": 100.44,
          "en": "of this new signals feature.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 100.44,
          "end": 103.35,
          "en": "You can start using it step by step.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 103.35,
          "end": 105.96000000000001,
          "en": "You don't have to migrate your entire app",
          "zh": ""
        },
        {
          "id": 34,
          "start": 105.96000000000001,
          "end": 109.05,
          "en": "and all your data in one step to signals.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 109.05,
          "end": 112.25999999999999,
          "en": "Instead, you can add small pieces here and there",
          "zh": ""
        },
        {
          "id": 36,
          "start": 112.25999999999999,
          "end": 114.75,
          "en": "and migrate parts of your application,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 114.75,
          "end": 118.053,
          "en": "like this counter state here, this counter data.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 119.25,
          "end": 121.41,
          "en": "To turn this into a signal,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 121.41,
          "end": 123.96,
          "en": "and to use this new signal feature,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 123.96,
          "end": 127.65,
          "en": "we first of all have to import from Angular core,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 127.65,
          "end": 131.283,
          "en": "and from there, we have to import the signal function.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 133.02,
          "end": 137.37,
          "en": "With that imported, we now create such a signal here",
          "zh": ""
        },
        {
          "id": 43,
          "start": 137.37,
          "end": 140.4,
          "en": "as a value for this counter property,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 140.4,
          "end": 143.85,
          "en": "by calling the signal function like this.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 143.85,
          "end": 147.32999999999998,
          "en": "This creates a new signal object,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 147.32999999999998,
          "end": 150.6,
          "en": "and these signal objects, in the end, are simply",
          "zh": ""
        },
        {
          "id": 47,
          "start": 150.6,
          "end": 155.6,
          "en": "wrappers around data, objects that can tell Angular",
          "zh": ""
        },
        {
          "id": 48,
          "start": 155.67000000000002,
          "end": 157.89,
          "en": "once you changed the data",
          "zh": ""
        },
        {
          "id": 49,
          "start": 157.89,
          "end": 160.38,
          "en": "and that can be used by Angular",
          "zh": ""
        },
        {
          "id": 50,
          "start": 160.38,
          "end": 164.49,
          "en": "to find out where in your application and your UI",
          "zh": ""
        },
        {
          "id": 51,
          "start": 164.49,
          "end": 167.01,
          "en": "you might be using those values",
          "zh": ""
        },
        {
          "id": 52,
          "start": 167.01,
          "end": 170.583,
          "en": "so that Angular knows which parts need updating.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 171.81,
          "end": 175.14,
          "en": "So here, to set an initial value for this counter,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 175.14,
          "end": 178.29,
          "en": "we now just pass the initial value to signal.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 178.29,
          "end": 180.39,
          "en": "In this case here, the number is zero,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 180.39,
          "end": 183.15,
          "en": "though any kind of data could be a signal.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 183.15,
          "end": 186.06,
          "en": "You could also pass a string as a signal value,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 186.06,
          "end": 189.21,
          "en": "or a boolean, or an object,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 189.21,
          "end": 191.52,
          "en": "or of course also an array.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 191.52,
          "end": 193.71,
          "en": "Any kind of data can be a signal.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 193.71,
          "end": 195.453,
          "en": "In this case here, it's a number.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 197.31,
          "end": 199.68,
          "en": "So with that, we created a signal,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 199.68,
          "end": 201.723,
          "en": "and that's the first important step.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
