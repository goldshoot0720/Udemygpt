        },
        {
          "id": 29,
          "start": 93.93,
          "end": 96.06,
          "en": "and copy it again",
          "zh": ""
        },
        {
          "id": 30,
          "start": 96.06,
          "end": 99.663,
          "en": "to use the same configuration for the street.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 100.65,
          "end": 103.39699999999999,
          "en": "And then also for the number, so the number",
