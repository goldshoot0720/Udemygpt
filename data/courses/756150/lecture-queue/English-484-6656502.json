          "zh": ""
        },
        {
          "id": 71,
          "start": 146.76,
          "end": 149.43,
          "en": "The first argument is the initial state,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 149.43,
          "end": 152.55,
          "en": "the initial value of this control you could say.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 152.55,
          "end": 154.8,
          "en": "The second argument will be a single validator",
          "zh": ""
        },
        {
          "id": 74,
          "start": 154.8,
          "end": 157.86,
          "en": "or an array of validators we want to apply to this control.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 157.86,
          "end": 159.39,
          "en": "I'll come back to this.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 159.39,
          "end": 160.56,
          "en": "The third argument",
          "zh": ""
        },
        {
          "id": 77,
          "start": 160.56,
          "end": 161.393,
          "en": "will be",
          "zh": ""
        },
        {
          "id": 78,
          "start": 161.393,
          "end": 163.82999999999998,
          "en": "potential asynchronous validators.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 163.82999999999998,
          "end": 165.96,
          "en": "I will also come back to this later.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 165.96,
          "end": 168.36,
          "en": "For now, I want to set an initial state of null",
          "zh": ""
        },
        {
          "id": 81,
