{
  "version": 1,
  "courseId": 756150,
  "courseSlug": "the-complete-guide-to-angular-2",
  "courseTitle": "Angular - The Complete Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "38137590",
      "title": "Adding a Second Effect",
      "lectureOrder": 703,
      "videoOrder": 648,
      "sourceHash": "26015df1c640cea83060ac14d23b9e359b95b9168aac000847ecc575e4f584ae",
      "cues": [
        {
          "id": 1,
          "start": 2.04,
          "end": 3.36,
          "en": "So now we already learned",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.36,
          "end": 4.92,
          "en": "quite a bit about effects.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 4.92,
          "end": 8.13,
          "en": "To finish this part about effects here,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.13,
          "end": 10.02,
          "en": "I now want to add a second effect",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.02,
          "end": 13.65,
          "en": "which actually loads the data from local storage.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.65,
          "end": 15.57,
          "en": "And this is now an effect",
          "zh": ""
        },
        {
          "id": 7,
          "start": 15.57,
          "end": 18.93,
          "en": "that should then actually dispatch a new action",
          "zh": ""
        },
        {
          "id": 8,
          "start": 18.93,
          "end": 20.79,
          "en": "once it's done.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 20.79,
          "end": 24.33,
          "en": "A new action that will take that counter",
          "zh": ""
        },
        {
          "id": 10,
          "start": 24.33,
          "end": 26.79,
          "en": "that was extracted from local storage",
          "zh": ""
        },
        {
          "id": 11,
          "start": 26.79,
          "end": 29.37,
          "en": "and store it in our NgRx store,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 29.37,
          "end": 32.25,
          "en": "so that when we basically reload the app,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 32.25,
          "end": 35.223,
          "en": "we continue with the counter we stored before.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 36.3,
          "end": 40.383,
          "en": "To make this all work, I need to add two new actions though.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 41.34,
          "end": 45.27,
          "en": "I need one new action which could be called init,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 45.27,
          "end": 49.86,
          "en": "which should, in the end, trigger this side effect pipeline",
          "zh": ""
        },
        {
          "id": 17,
          "start": 49.86,
          "end": 54.09,
          "en": "that reaches out to local storage and loads data from it.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 54.09,
          "end": 57.27,
          "en": "For this, I'll create it here with createAction",
          "zh": ""
        },
        {
          "id": 19,
          "start": 57.27,
          "end": 61.08,
          "en": "or of course, also with this alternative syntax,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 61.08,
          "end": 62.58,
          "en": "but here I'll use createAction",
          "zh": ""
        },
        {
          "id": 21,
          "start": 64.11,
          "end": 66.33,
          "en": "and give it this identifier.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 66.33,
          "end": 68.7,
          "en": "And here, I don't need any extra payload,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 68.7,
          "end": 71.853,
          "en": "I don't need any extra data attached to the action.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 72.9,
          "end": 76.53,
          "en": "But I'll then add a second action here,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 76.53,
          "end": 78.363,
          "en": "which I'll simply name as set.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 79.285,
          "end": 82.05,
          "en": "I also created with createAction",
          "zh": ""
        },
        {
          "id": 27,
          "start": 82.05,
          "end": 85.83,
          "en": "where the identifier should be Counter Set.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 85.83,
          "end": 88.05,
          "en": "But where I now do want to have some",
          "zh": ""
        },
        {
          "id": 29,
          "start": 88.05,
          "end": 89.85,
          "en": "value attached to it again,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 89.85,
          "end": 93.33,
          "en": "and the value here should again be the number",
          "zh": ""
        },
        {
          "id": 31,
          "start": 93.33,
          "end": 95.52000000000001,
          "en": "to which we set the counter.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 95.52000000000001,
          "end": 100.05,
          "en": "And therefore again, here I'll add this kind of shape",
          "zh": ""
        },
        {
          "id": 33,
          "start": 100.05,
          "end": 102.963,
          "en": "for the data that is attached to the action.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 105,
          "end": 107.13,
          "en": "With these two actions added,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 107.13,
          "end": 110.49000000000001,
          "en": "I have one action now that will trigger the side effect",
          "zh": ""
        },
        {
          "id": 36,
          "start": 110.49000000000001,
          "end": 112.44,
          "en": "and one action that should be dispatched",
          "zh": ""
        },
        {
          "id": 37,
          "start": 112.44,
          "end": 114.24000000000001,
          "en": "once the side effect is done,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 114.24000000000001,
          "end": 116.703,
          "en": "to then be handled in the reducer.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 117.84,
          "end": 120.15,
          "en": "Therefore, I'll start in the reducer actually",
          "zh": ""
        },
        {
          "id": 40,
          "start": 120.15,
          "end": 123.24,
          "en": "and add another on branch to it.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 123.24,
          "end": 127.83,
          "en": "So to say, where I now listen for the set action,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 127.83,
          "end": 129.51,
          "en": "which again, should be dispatched",
          "zh": ""
        },
        {
          "id": 43,
          "start": 129.51,
          "end": 132.543,
          "en": "once we loaded data with help of our side effect.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 133.95,
          "end": 137.25,
          "en": "And here I then got my state and my action",
          "zh": ""
        },
        {
          "id": 45,
          "start": 137.25,
          "end": 140.1,
          "en": "and I know that my action will carry the data",
          "zh": ""
        },
        {
          "id": 46,
          "start": 140.1,
          "end": 141.9,
          "en": "to which the state should be set.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 141.9,
          "end": 145.86,
          "en": "Therefore here, I simply return action.value.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 145.86,
          "end": 148.41,
          "en": "I don't even care about the existing state.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 148.41,
          "end": 151.53,
          "en": "Instead, I'll set my state to the payload",
          "zh": ""
        },
        {
          "id": 50,
          "start": 151.53,
          "end": 153.32999999999998,
          "en": "that is attached to the action",
          "zh": ""
        },
        {
          "id": 51,
          "start": 153.32999999999998,
          "end": 155.61,
          "en": "because that will be the counter value",
          "zh": ""
        },
        {
          "id": 52,
          "start": 155.61,
          "end": 158.55,
          "en": "that will be retrieved from local storage.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 158.55,
          "end": 161.433,
          "en": "But of course, we now have to add the logic for this.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 162.36,
          "end": 164.67000000000002,
          "en": "And for this back here in CounterEffects,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 164.67000000000002,
          "end": 168.3,
          "en": "we can add a new property, loadCount",
          "zh": ""
        },
        {
          "id": 56,
          "start": 168.3,
          "end": 169.893,
          "en": "with help of createEffect.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 171.66,
          "end": 174.27,
          "en": "And we again, pass our function to createEffect",
          "zh": ""
        },
        {
          "id": 58,
          "start": 174.27,
          "end": 177.09,
          "en": "where we build another effect pipeline",
          "zh": ""
        },
        {
          "id": 59,
          "start": 177.09,
          "end": 179.523,
          "en": "with help of this.actions$.pipe.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 180.51,
          "end": 183.45,
          "en": "And then here, we pass ofType here",
          "zh": ""
        },
        {
          "id": 61,
          "start": 183.45,
          "end": 185.52,
          "en": "to define for which kind of action",
          "zh": ""
        },
        {
          "id": 62,
          "start": 185.52,
          "end": 187.74,
          "en": "this pipeline should be executed.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 187.74,
          "end": 190.5,
          "en": "And here, that's for the init action,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 190.5,
          "end": 194.07,
          "en": "which must be imported from the actions file.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 194.07,
          "end": 196.86,
          "en": "And we'll make sure to dispatch this action",
          "zh": ""
        },
        {
          "id": 66,
          "start": 196.86,
          "end": 199.53300000000002,
          "en": "from somewhere in our application soon.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 200.67000000000002,
          "end": 202.11,
          "en": "So with that, we got the filter.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 202.11,
          "end": 203.82,
          "en": "And here, it's only one action",
          "zh": ""
        },
        {
          "id": 69,
          "start": 203.82,
          "end": 205.82999999999998,
          "en": "that should trigger this side effect,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 205.82999999999998,
          "end": 208.38,
          "en": "so other actions will not trigger it.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 208.38,
          "end": 210.21,
          "en": "And for example, the init action",
          "zh": ""
        },
        {
          "id": 72,
          "start": 210.21,
          "end": 212.49,
          "en": "would not trigger this side effect here,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 212.49,
          "end": 214.8,
          "en": "this saveCount side effect",
          "zh": ""
        },
        {
          "id": 74,
          "start": 214.8,
          "end": 216.51,
          "en": "because here, we're only listening",
          "zh": ""
        },
        {
          "id": 75,
          "start": 216.51,
          "end": 219.63,
          "en": "for increment and decrement actions.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 219.63,
          "end": 222.87,
          "en": "But in the loadCount side effect pipeline here,",
          "zh": ""
        },
        {
          "id": 77,
          "start": 222.87,
          "end": 225.45,
          "en": "we then wanna continue",
          "zh": ""
        },
        {
          "id": 78,
          "start": 225.45,
          "end": 229.47,
          "en": "by getting some data from our local storage.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 229.47,
          "end": 232.95,
          "en": "And for this, we can use the switchMap operator",
          "zh": ""
        },
        {
          "id": 80,
          "start": 232.95,
          "end": 234.72,
          "en": "offered by RxJS,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 234.72,
          "end": 238.51,
          "en": "which simply allows us to switch to a new observable chain",
          "zh": ""
        },
        {
          "id": 82,
          "start": 239.82,
          "end": 243.54,
          "en": "where we then start by getting some value",
          "zh": ""
        },
        {
          "id": 83,
          "start": 243.54,
          "end": 245.19,
          "en": "from local storage.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 245.19,
          "end": 248.41,
          "en": "And for that, we want to use localStorage.getItem",
          "zh": ""
        },
        {
          "id": 85,
          "start": 249.54,
          "end": 252.06,
          "en": "and get the item stored under the key count",
          "zh": ""
        },
        {
          "id": 86,
          "start": 252.06,
          "end": 254.13,
          "en": "because that's the key I'm using down here",
          "zh": ""
        },
        {
          "id": 87,
          "start": 254.13,
          "end": 256.35,
          "en": "for storing the value.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 256.35,
          "end": 258.45,
          "en": "So that's then my storedCounter.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 259.62,
          "end": 262.8,
          "en": "And then the new value we wanna return here",
          "zh": ""
        },
        {
          "id": 90,
          "start": 262.8,
          "end": 265.2,
          "en": "should be a new observable",
          "zh": ""
        },
        {
          "id": 91,
          "start": 265.2,
          "end": 267,
          "en": "that in the end is wrapped around",
          "zh": ""
        },
        {
          "id": 92,
          "start": 267,
          "end": 269.76,
          "en": "an action we wanna dispatch.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 269.76,
          "end": 273.39300000000003,
          "en": "And for that, we can simply call set.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 274.38,
          "end": 279.38,
          "en": "So this set action which is imported from the actions file,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 279.87,
          "end": 282.27,
          "en": "which creates such an action object.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 282.27,
          "end": 286.59000000000003,
          "en": "And here, I then set the value equal to my storedCounter.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 286.59000000000003,
          "end": 288.84000000000003,
          "en": "However, here I want to convert this to a number",
          "zh": ""
        },
        {
          "id": 98,
          "start": 288.84000000000003,
          "end": 290.973,
          "en": "and therefore, add a plus in front of it.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 292.86,
          "end": 294.93,
          "en": "Now stored counter could be null,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 294.93,
          "end": 297.69,
          "en": "if no value is found under that key.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 297.69,
          "end": 300,
          "en": "And therefore, I'll actually add a if check",
          "zh": ""
        },
        {
          "id": 102,
          "start": 300,
          "end": 304.56,
          "en": "and check if storedCounter is truthy.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 304.56,
          "end": 307.8,
          "en": "in which case, I'll return this action",
          "zh": ""
        },
        {
          "id": 104,
          "start": 307.8,
          "end": 311.31,
          "en": "wrapped around this counter convert it to a number.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 311.31,
          "end": 316.31,
          "en": "Alternatively, I'll execute set with a value of zero.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 316.8,
          "end": 318.93,
          "en": "So if we have no counter stored yet,",
          "zh": ""
        },
        {
          "id": 107,
          "start": 318.93,
          "end": 322.593,
          "en": "we'll just start with zero as a counter value.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 324.15,
          "end": 325.98,
          "en": "So with that, we're almost there",
          "zh": ""
        },
        {
          "id": 109,
          "start": 325.98,
          "end": 329.37,
          "en": "but switchMap actually needs an observable",
          "zh": ""
        },
        {
          "id": 110,
          "start": 329.37,
          "end": 334.2,
          "en": "to be returned by this function and not an action object.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 334.2,
          "end": 336.96,
          "en": "And therefore, we should turn this action object",
          "zh": ""
        },
        {
          "id": 112,
          "start": 336.96,
          "end": 338.43,
          "en": "into an observable",
          "zh": ""
        },
        {
          "id": 113,
          "start": 338.43,
          "end": 342.9,
          "en": "by using the of operator which is imported from RxJS,",
          "zh": ""
        },
        {
          "id": 114,
          "start": 344.79,
          "end": 347.04,
          "en": "which is simply a function we can execute",
          "zh": ""
        },
        {
          "id": 115,
          "start": 347.04,
          "end": 348.99,
          "en": "to wrap it around the value",
          "zh": ""
        },
        {
          "id": 116,
          "start": 348.99,
          "end": 352.23,
          "en": "which will then be wrapped into an observable.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 352.23,
          "end": 354.42,
          "en": "And with that, switchMap is happy",
          "zh": ""
        },
        {
          "id": 118,
          "start": 354.42,
          "end": 356.913,
          "en": "once I wrapped both action objects with of.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 357.87,
          "end": 360.99,
          "en": "And with that, we also finished this effect pipeline",
          "zh": ""
        },
        {
          "id": 120,
          "start": 360.99,
          "end": 364.23,
          "en": "which will now load some data from local storage",
          "zh": ""
        },
        {
          "id": 121,
          "start": 364.23,
          "end": 366.42,
          "en": "and which will then in the end",
          "zh": ""
        },
        {
          "id": 122,
          "start": 366.42,
          "end": 368.853,
          "en": "dispatch a new action once it's done.",
          "zh": ""
        },
        {
          "id": 123,
          "start": 370.26,
          "end": 372.6,
          "en": "And therefore here, since this pipeline",
          "zh": ""
        },
        {
          "id": 124,
          "start": 372.6,
          "end": 376.08,
          "en": "does in the end yield a new action object,",
          "zh": ""
        },
        {
          "id": 125,
          "start": 376.08,
          "end": 379.44,
          "en": "which is the default for NgRx effects,",
          "zh": ""
        },
        {
          "id": 126,
          "start": 379.44,
          "end": 382.83,
          "en": "which is kind of expected by NgRx effects,",
          "zh": ""
        },
        {
          "id": 127,
          "start": 382.83,
          "end": 387.6,
          "en": "we should not add this dispatch: false configuration object",
          "zh": ""
        },
        {
          "id": 128,
          "start": 387.6,
          "end": 389.67,
          "en": "to create effect.",
          "zh": ""
        },
        {
          "id": 129,
          "start": 389.67,
          "end": 393.36,
          "en": "That was only required before for this pipeline",
          "zh": ""
        },
        {
          "id": 130,
          "start": 393.36,
          "end": 397.2,
          "en": "where we did indeed not yield a new action object",
          "zh": ""
        },
        {
          "id": 131,
          "start": 397.2,
          "end": 398.64,
          "en": "as a final result.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 398.64,
          "end": 402.003,
          "en": "Here, that's different, so we don't set dispatch to false.",
          "zh": ""
        },
        {
          "id": 133,
          "start": 402.87,
          "end": 404.97,
          "en": "And with that, we're almost there.",
          "zh": ""
        },
        {
          "id": 134,
          "start": 404.97,
          "end": 406.59000000000003,
          "en": "We now just have to make sure",
          "zh": ""
        },
        {
          "id": 135,
