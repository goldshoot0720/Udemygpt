          "en": "We have our polyfills files,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 22.74,
          "end": 25.62,
          "en": "styles.js, vendor.js, main.js.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 25.62,
          "end": 28.38,
          "en": "These are four JavaScript files",
          "zh": ""
        },
        {
          "id": 13,
          "start": 28.38,
          "end": 30.18,
          "en": "and we're in development mode here",
          "zh": ""
        },
        {
          "id": 14,
          "start": 30.18,
          "end": 32.16,
          "en": "which is why they are extremely big.",
