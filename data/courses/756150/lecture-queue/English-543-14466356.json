    {
      "id": "14466356",
      "title": "Using Subjects for Error Handling",
      "lectureOrder": 590,
      "videoOrder": 543,
      "sourceHash": "b715dd1391da107914f19b32d537a74346a51180a5bba1daafa5534d67aa2f3f",
      "cues": [
        {
          "id": 1,
          "start": 2.19,
          "end": 5.01,
          "en": "-: This other way of handling errors could be interesting",
          "zh": ""
        },
        {
          "id": 2,
          "start": 5.01,
          "end": 6.12,
          "en": "in cases like",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.12,
          "end": 8.19,
          "en": "when you send a request",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.19,
          "end": 10.68,
          "en": "and don't subscribe to it in your component.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.68,
          "end": 14.433,
          "en": "It's easy for us to react to an error in the component here,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.433,
          "end": 16.71,
          "en": "if we do return the observable",
          "zh": ""
        },
        {
          "id": 7,
          "start": 16.71,
          "end": 18.18,
          "en": "and we subscribe in the component,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 18.18,
          "end": 21.48,
          "en": "because then we can pass this second argument to subscribe,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 21.48,
          "end": 24.03,
          "en": "which is this error-handling function.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 24.03,
          "end": 25.71,
          "en": "But what about creating a post?",
          "zh": ""
        },
        {
          "id": 11,
          "start": 25.71,
          "end": 28.14,
          "en": "There I subscribe in the service.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 28.14,
          "end": 30.78,
          "en": "Now obviously you could just return the observable there too",
          "zh": ""
        },
        {
          "id": 13,
          "start": 30.78,
          "end": 33.54,
          "en": "and simply subscribe in the component instead,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 33.54,
          "end": 35.64,
          "en": "and that would not be wrong.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 35.64,
          "end": 36.57,
          "en": "But you can of course",
          "zh": ""
        },
        {
          "id": 16,
          "start": 36.57,
          "end": 38.88,
          "en": "also implement a different pattern",
          "zh": ""
        },
        {
          "id": 17,
          "start": 38.88,
          "end": 41.16,
          "en": "of handling that error.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 41.16,
          "end": 42.87,
          "en": "You could use a subject,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 42.87,
          "end": 44.19,
          "en": "and that is especially useful",
          "zh": ""
        },
        {
          "id": 20,
          "start": 44.19,
          "end": 46.47,
          "en": "if you have multiple places in the application",
          "zh": ""
        },
        {
          "id": 21,
          "start": 46.47,
          "end": 48.66,
          "en": "that might be interested in your error.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 48.66,
          "end": 49.805,
          "en": "So for example here",
          "zh": ""
        },
        {
          "id": 23,
          "start": 49.805,
          "end": 51.88,
          "en": "you could have your",
          "zh": ""
        },
        {
          "id": 24,
          "start": 53.4,
          "end": 55.47,
          "en": "error property,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 55.47,
          "end": 57.24,
          "en": "which is a new subject",
          "zh": ""
        },
        {
          "id": 26,
          "start": 57.24,
          "end": 60.813,
          "en": "and subject needs to be imported from rxjs.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 61.89,
          "end": 63.36,
          "en": "And that will,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 63.36,
          "end": 65.91,
          "en": "let's say eventually give us a string that error message.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 65.91,
          "end": 69.21000000000001,
          "en": "But of course you can store in there whatever you want.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 69.21000000000001,
          "end": 72.93,
          "en": "And the idea then simply is that here where we subscribe,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 72.93,
          "end": 74.64,
          "en": "where we get that error,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 74.64,
          "end": 76.53,
          "en": "we now use that subject.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 76.53,
          "end": 78.96000000000001,
          "en": "So this error we call 'next'",
          "zh": ""
        },
        {
          "id": 34,
          "start": 78.96000000000001,
          "end": 80.82,
          "en": "and we pass on error message.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 80.82,
          "end": 82.41,
          "en": "And now the remaining step is",
          "zh": ""
        },
        {
          "id": 36,
          "start": 82.41,
          "end": 84.78,
          "en": "that we subscribe to that subject",
          "zh": ""
        },
        {
          "id": 37,
          "start": 84.78,
          "end": 85.95,
          "en": "in all the places",
          "zh": ""
        },
        {
          "id": 38,
          "start": 85.95,
          "end": 88.28999999999999,
          "en": "we're interested in that error message.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 88.28999999999999,
          "end": 90.93,
          "en": "So here in this example,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 90.93,
          "end": 93.57300000000001,
          "en": "we would subscribe an ngOnInit in it for example,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 95.13,
          "end": 96.53999999999999,
          "en": "like this.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 96.53999999999999,
          "end": 99.27000000000001,
          "en": "And whenever we get our error message here,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 99.27000000000001,
          "end": 102.72,
          "en": "we could set this error equal to the error message.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 102.72,
          "end": 104.00999999999999,
          "en": "Now, of course, as you learned,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 104.00999999999999,
          "end": 107.16,
          "en": "it's a good and recommended practice to unsubscribe",
          "zh": ""
        },
        {
          "id": 46,
          "start": 107.16,
          "end": 108.87299999999999,
          "en": "if you get rid of this component.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 110.1,
          "end": 112.8,
          "en": "So I'll add a new property error sub,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 112.8,
          "end": 114.9,
          "en": "which is a subscription",
          "zh": ""
        },
        {
          "id": 49,
          "start": 114.9,
          "end": 116.03999999999999,
          "en": "and therefore we need to",
          "zh": ""
        },
        {
          "id": 50,
          "start": 116.03999999999999,
          "end": 119.583,
          "en": "import subscription from rxjs,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 120.99,
          "end": 122.01,
          "en": "like this.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 122.01,
          "end": 124.35,
          "en": "And now we can store our subscription",
          "zh": ""
        },
        {
          "id": 53,
          "start": 124.35,
          "end": 125.53,
          "en": "in that property",
          "zh": ""
        },
        {
          "id": 54,
          "start": 129.75,
          "end": 131.25,
          "en": "here in ngOnInit,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 131.25,
          "end": 132.38,
          "en": "and now we just need to add",
          "zh": ""
        },
        {
          "id": 56,
          "start": 132.38,
          "end": 135.18,
          "en": "OnDestroy here - this interface",
          "zh": ""
        },
        {
          "id": 57,
          "start": 135.18,
          "end": 138.57,
          "en": "and import that from at @anglular/core as well.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 138.57,
          "end": 140.7,
          "en": "and add ngOnDestroy,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 140.7,
          "end": 141.53300000000002,
          "en": "therefore,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 141.53300000000002,
          "end": 143.463,
          "en": "maybe here at the end of the component.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 144.78,
          "end": 146.94,
          "en": "And there we now just want to unsubscribe,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 146.94,
          "end": 151.94,
          "en": "so this.errorSub.unsubscribe.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 151.98,
          "end": 154.11,
          "en": "Now we use a subject-based strategy",
          "zh": ""
        },
        {
          "id": 64,
          "start": 154.11,
          "end": 156.633,
          "en": "for forwarding the error and that is fine too.",
          "zh": ""
        }
      ]
    }
