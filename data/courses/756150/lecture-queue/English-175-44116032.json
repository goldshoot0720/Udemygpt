  "courseSlug": "the-complete-guide-to-angular-2",
  "courseTitle": "Angular - The Complete Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "44116032",
      "title": "There Are Multiple Ways Of Providing a Service",
      "lectureOrder": 183,
      "videoOrder": 175,
      "sourceHash": "1127198fee4870597408b8643d27c1e34c26f8420bb4c92fa33ed98810ed457b",
      "cues": [
        {
          "id": 1,
          "start": 0.75,
          "end": 2.46,
          "en": "Providing a service with help",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.46,
          "end": 5.49,
          "en": "of @Injectable and providedIn set to root",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.49,
          "end": 8.16,
          "en": "is the most common use case, and therefore,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.16,
          "end": 12.51,
          "en": "that's how you typically wanna provide your services.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.51,
          "end": 14.823,
          "en": "But there are alternative ways.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.75,
          "end": 18.75,
          "en": "With that disabled, you can, for example,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.75,
          "end": 22.08,
          "en": "provide that service to your entire application",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.08,
          "end": 24.36,
          "en": "by going to the main.ts file",
          "zh": ""
        },
        {
          "id": 9,
          "start": 24.36,
          "end": 26.61,
          "en": "and by then passing a second argument",
          "zh": ""
        },
        {
          "id": 10,
          "start": 26.61,
          "end": 29.1,
          "en": "to bootstrapApplication",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.1,
          "end": 31.563,
          "en": "and that argument should be an object.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.58,
          "end": 36.12,
          "en": "And this object then has a providers property,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 36.12,
          "end": 40.47,
          "en": "which you can set up, and this wants an array of providers",
          "zh": ""
        },
        {
          "id": 14,
          "start": 40.47,
          "end": 45.47,
          "en": "and a provider, then in the end is a piece of information",
          "zh": ""
        },
        {
          "id": 15,
          "start": 45.81,
          "end": 49.41,
          "en": "that lets Angular know that a certain value",
          "zh": ""
        },
        {
          "id": 16,
          "start": 49.41,
          "end": 50.673,
          "en": "should be injectable.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 51.72,
          "end": 53.61,
          "en": "In its simple form,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 53.61,
          "end": 58.61,
          "en": "you can pass the TasksService to this provider's array now,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 58.68,
          "end": 61.863,
          "en": "just like this, and Angular will do the rest.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 63.72,
          "end": 66.67,
          "en": "With that, you register this TasksService",
          "zh": ""
        },
        {
          "id": 21,
          "start": 67.53,
          "end": 71.1,
          "en": "with the application root environment injector,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 71.1,
          "end": 72.81,
          "en": "just as you would do it",
          "zh": ""
        },
        {
          "id": 23,
          "start": 72.81,
          "end": 77.43,
          "en": "with @Injectable with providedIn set to root,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 77.43,
          "end": 80.22,
          "en": "but now by using this configuration object",
          "zh": ""
        },
        {
          "id": 25,
          "start": 80.22,
          "end": 81.90299999999999,
          "en": "on bootstrapApplication.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 82.83,
          "end": 85.89,
          "en": "With that done, therefore, if you save that,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 85.89,
          "end": 89.4,
          "en": "you see the application seems to work again,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 89.4,
          "end": 94.053,
          "en": "the error is gone, and that all seems to work again.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 96.53999999999999,
          "end": 100.92,
          "en": "So that's one other way of providing a service.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 100.92,
          "end": 103.53,
          "en": "Now one important difference compared",
          "zh": ""
        },
        {
          "id": 31,
          "start": 103.53,
          "end": 107.72999999999999,
          "en": "to using @Injectable with providedIn set to root",
          "zh": ""
        },
        {
          "id": 32,
          "start": 107.72999999999999,
          "end": 110.72999999999999,
          "en": "is that this approach",
          "zh": ""
        },
        {
          "id": 33,
          "start": 110.72999999999999,
          "end": 113.7,
          "en": "where you use this configuration object,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 113.7,
          "end": 118.7,
          "en": "does not allow for tree shaking of this TasksService thing,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 120.45,
          "end": 124.17,
          "en": "which in the end means that Angular tries to",
          "zh": ""
        },
        {
          "id": 36,
          "start": 124.17,
          "end": 126.78,
          "en": "optimize your code as much as possible",
          "zh": ""
        },
        {
          "id": 37,
          "start": 126.78,
          "end": 129,
          "en": "once you prepare it for deployment.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 129,
          "end": 131.61,
          "en": "And during that optimization process,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 131.61,
          "end": 136.61,
          "en": "it tries to throw away any code that's not being used",
          "zh": ""
        },
        {
          "id": 40,
          "start": 137.25,
          "end": 141.333,
          "en": "or that's at least not needed initially when the app starts.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 142.23,
          "end": 146.1,
          "en": "Now, when you register your injectable value,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 146.1,
          "end": 150.6,
          "en": "your TasksService with this providers array here,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 150.6,
          "end": 153.32999999999998,
          "en": "and you therefore add this import here,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 153.32999999999998,
          "end": 157.71,
          "en": "it will always be included in that initial code bundle",
          "zh": ""
        },
        {
          "id": 45,
          "start": 157.71,
          "end": 160.26,
          "en": "that is generated by Angular",
          "zh": ""
        },
        {
          "id": 46,
          "start": 160.26,
          "end": 162.51,
          "en": "because Angular sees that it's needed",
          "zh": ""
        },
        {
          "id": 47,
          "start": 162.51,
          "end": 163.89,
          "en": "right from the start here,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 163.89,
          "end": 168.57,
          "en": "in this very first code that executes when the app starts.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 168.57,
          "end": 170.85,
          "en": "Now, if your app would be more complex",
          "zh": ""
        },
        {
          "id": 50,
          "start": 170.85,
          "end": 173.7,
          "en": "and this entire tasks feature",
          "zh": ""
        },
        {
          "id": 51,
          "start": 173.7,
          "end": 177.87,
          "en": "would maybe only be loaded at a later point of time,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 177.87,
          "end": 181.86,
          "en": "the TasksService would be included in that initial bundle,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 181.86,
          "end": 185.97,
          "en": "even though it technically might not be needed initially.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 185.97,
          "end": 188.55,
          "en": "And I'll get back to lazy loading",
          "zh": ""
        },
        {
          "id": 55,
          "start": 188.55,
          "end": 191.31,
          "en": "and splitting your code across multiple bundles",
          "zh": ""
        },
        {
          "id": 56,
          "start": 191.31,
          "end": 194.67,
          "en": "to improve efficiency a little bit later.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 194.67,
          "end": 196.14,
          "en": "For now, it's just important",
          "zh": ""
        },
        {
          "id": 58,
          "start": 196.14,
          "end": 199.05,
          "en": "to take away that with this approach here,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 199.05,
          "end": 202.02,
          "en": "this code that belongs to the TasksService",
          "zh": ""
        },
        {
          "id": 60,
          "start": 202.02,
          "end": 204.21,
          "en": "will always be included.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 204.21,
          "end": 208.82999999999998,
          "en": "Whereas if you use @Injectable with provided set to root,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 208.82999999999998,
          "end": 211.14,
          "en": "this is not necessarily the case,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 211.14,
          "end": 213.66,
          "en": "and therefore this approach with this decorator",
          "zh": ""
        },
        {
          "id": 64,
          "start": 213.66,
          "end": 218.66,
          "en": "and this setting can lead to more optimized code bundles",
          "zh": ""
        },
        {
          "id": 65,
          "start": 218.97,
          "end": 222.3,
          "en": "and to a smaller initial code base",
          "zh": ""
        },
        {
          "id": 66,
          "start": 222.3,
          "end": 225.18,
          "en": "that's shipped to your users.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 225.18,
          "end": 229.14,
          "en": "That's why it's typically recommended to use this approach",
          "zh": ""
        },
        {
          "id": 68,
          "start": 229.14,
          "end": 232.07999999999998,
          "en": "instead of using this providers array.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 232.07999999999998,
          "end": 235.23,
          "en": "That's why I will copy this code",
          "zh": ""
        },
        {
          "id": 70,
          "start": 235.23,
          "end": 238.56,
          "en": "and then comment it out and remove this from here",
          "zh": ""
        },
        {
          "id": 71,
          "start": 238.56,
          "end": 241.29,
          "en": "so that we still see it for reference,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 241.29,
          "end": 244.17,
          "en": "but the code isn't active anymore",
          "zh": ""
        },
        {
          "id": 73,
          "start": 244.17,
          "end": 246.75,
          "en": "because this is an alternative.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 246.75,
          "end": 249.15,
          "en": "But that is typically the better way",
          "zh": ""
        },
        {
          "id": 75,
          "start": 249.15,
          "end": 252.33,
          "en": "of providing that value if you want to provide it",
          "zh": ""
        },
        {
          "id": 76,
          "start": 252.33,
          "end": 254.553,
          "en": "to the root application injector.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
