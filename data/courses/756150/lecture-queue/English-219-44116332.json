      "cues": [
        {
          "id": 1,
          "start": 0.63,
          "end": 1.763,
          "en": "So now that we're able",
          "zh": ""
        },
        {
          "id": 2,
          "start": 1.763,
          "end": 4.92,
          "en": "to pick places we like,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 4.92,
          "end": 7.26,
          "en": "I wanna make sure that we can also load them here",
          "zh": ""
        },
        {
          "id": 4,
          "start": 7.26,
          "end": 10.443,
          "en": "and show them here in this favorite places box.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.28,
          "end": 14.49,
          "en": "So this box, and therefore in the end,",
          "zh": ""
        },
        {
          "id": 6,
