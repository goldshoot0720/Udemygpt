          "en": "and the error signal.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 73.08,
          "end": 74.78999999999999,
          "en": "And I'll also make sure that",
          "zh": ""
        },
        {
          "id": 22,
          "start": 74.78999999999999,
          "end": 77.76,
          "en": "these injected values are available.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 77.76,
          "end": 79.713,
          "en": "HTDP client and Destroy ref.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 80.58,
          "end": 82.203,
          "en": "So copy that as well.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 83.1,
          "end": 85.503,
          "en": "All here into user places component.",
