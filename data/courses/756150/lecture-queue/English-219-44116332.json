        },
        {
          "id": 33,
          "start": 113.75999999999999,
          "end": 117.405,
          "en": "And of course also those operators",
          "zh": ""
        },
        {
          "id": 34,
          "start": 117.405,
          "end": 121.2,
          "en": "were using map and catch error",
          "zh": ""
        },
        {
          "id": 35,
          "start": 121.2,
          "end": 124.653,
          "en": "and also of course throw error.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 127.23,
          "end": 132.033,
          "en": "So all these things should be imported into this file.",
