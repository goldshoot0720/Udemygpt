          "end": 55.533,
          "en": "places component TypeScript file.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 57.39,
          "end": 60.093,
          "en": "We'll have to adjust it, but it's a start.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 61.86,
          "end": 63.75,
          "en": "Now we don't just wanna copy that.",
