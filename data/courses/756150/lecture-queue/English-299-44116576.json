{
  "version": 1,
  "courseId": 756150,
  "courseSlug": "the-complete-guide-to-angular-2",
  "courseTitle": "Angular - The Complete Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "44116576",
      "title": "Building SPAs: Pros & Cons",
      "lectureOrder": 316,
      "videoOrder": 299,
      "sourceHash": "d2d945092fd058689f83a6a13ad27566edbe097ee36dd15e1ce09ba338ad0820",
      "cues": [
        {
          "id": 1,
          "start": 0.6,
          "end": 3.6,
          "en": "In this example application here,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.6,
          "end": 5.7,
          "en": "where I ran npm run build",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.7,
          "end": 8.31,
          "en": "without running anything else before,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.31,
          "end": 10.71,
          "en": "we built this application",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.71,
          "end": 14.76,
          "en": "as a so-called single page application,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.76,
          "end": 16.98,
          "en": "so that's the first option we have",
          "zh": ""
        },
        {
          "id": 7,
          "start": 16.98,
          "end": 20.13,
          "en": "when it comes to building Angular applications.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.13,
          "end": 23.13,
          "en": "We can build them as single page applications,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 23.13,
          "end": 23.963,
          "en": "which, in the end,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 23.963,
          "end": 28.963,
          "en": "means that we build a client-side only web application",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.01,
          "end": 32.52,
          "en": "because the idea behind single page applications",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.52,
          "end": 35.25,
          "en": "is that we have a single HTML file",
          "zh": ""
        },
        {
          "id": 13,
          "start": 35.25,
          "end": 38.97,
          "en": "that will be put on some web host in the end,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 38.97,
          "end": 41.25,
          "en": "and it's that file that will be requested",
          "zh": ""
        },
        {
          "id": 15,
          "start": 41.25,
          "end": 44.34,
          "en": "by website visitors and that will be loaded.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 44.34,
          "end": 48.54,
          "en": "And that file then will load all the Java script code",
          "zh": ""
        },
        {
          "id": 17,
          "start": 48.54,
          "end": 50.58,
          "en": "that makes up our application,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 50.58,
          "end": 54.45,
          "en": "and that Java script code will then take over",
          "zh": ""
        },
        {
          "id": 19,
          "start": 54.45,
          "end": 58.11,
          "en": "in the browsers of our website visitors.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 58.11,
          "end": 60.48,
          "en": "And it's that JavaScript code",
          "zh": ""
        },
        {
          "id": 21,
          "start": 60.48,
          "end": 65.48,
          "en": "that will then render the UI of our Angular application.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 65.88,
          "end": 69.27,
          "en": "That's what client-side only means here.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 69.27,
          "end": 73.02,
          "en": "All the UI rendering happens on the client side",
          "zh": ""
        },
        {
          "id": 24,
          "start": 73.02,
          "end": 75.15,
          "en": "by that JavaScript code",
          "zh": ""
        },
        {
          "id": 25,
          "start": 75.15,
          "end": 77.52,
          "en": "that is being served by the web host",
          "zh": ""
        },
        {
          "id": 26,
          "start": 77.52,
          "end": 79.92,
          "en": "to the website visitors.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 79.92,
          "end": 81.51,
          "en": "So all this compiled",
          "zh": ""
        },
        {
          "id": 28,
          "start": 81.51,
          "end": 84.3,
          "en": "and optimized application code executes",
          "zh": ""
        },
        {
          "id": 29,
          "start": 84.3,
          "end": 87.09,
          "en": "in the browsers of our website visitors,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 87.09,
          "end": 90.93,
          "en": "and therefore, we don't need any dynamic web server.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 90.93,
          "end": 93.27000000000001,
          "en": "We don't need a web server",
          "zh": ""
        },
        {
          "id": 32,
          "start": 93.27000000000001,
          "end": 97.22999999999999,
          "en": "that would be able to execute code on it.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 97.22999999999999,
          "end": 100.83,
          "en": "We don't need to run any Node.js or PHP",
          "zh": ""
        },
        {
          "id": 34,
          "start": 100.83,
          "end": 103.38,
          "en": "or any other code on that server.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 103.38,
          "end": 106.17,
          "en": "Instead, we just need a static host",
          "zh": ""
        },
        {
          "id": 36,
          "start": 106.17,
          "end": 109.71000000000001,
          "en": "that's able to serve the single HTML file",
          "zh": ""
        },
        {
          "id": 37,
          "start": 109.71000000000001,
          "end": 111.27000000000001,
          "en": "and all the other assets,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 111.27000000000001,
          "end": 113.82,
          "en": "like all the JavaScript files we have,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 113.82,
          "end": 115.983,
          "en": "to the website visitors.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 117.27000000000001,
          "end": 119.16,
          "en": "So that's the most basic way",
          "zh": ""
        },
        {
          "id": 41,
          "start": 119.16,
          "end": 121.56,
          "en": "of building an Angular application,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 121.56,
          "end": 124.59,
          "en": "and sometimes it might be just what you want.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 124.59,
          "end": 126.81,
          "en": "Sometimes you just might want",
          "zh": ""
        },
        {
          "id": 44,
          "start": 126.81,
          "end": 129.84,
          "en": "to build such a single page application,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 129.84,
          "end": 134.01,
          "en": "but this approach can have disadvantages.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 134.01,
          "end": 137.76,
          "en": "For example, since the entire UI is, in the end, rendered",
          "zh": ""
        },
        {
          "id": 47,
          "start": 137.76,
          "end": 140.49,
          "en": "in the browsers of the visitors,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 140.49,
          "end": 144.12,
          "en": "the initially loaded page is pretty empty.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 144.12,
          "end": 147.99,
          "en": "And if rendering takes a while for some reason",
          "zh": ""
        },
        {
          "id": 50,
          "start": 147.99,
          "end": 150.6,
          "en": "because the browser is slow",
          "zh": ""
        },
        {
          "id": 51,
          "start": 150.6,
          "end": 152.34,
          "en": "or anything like that,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 152.34,
          "end": 156.66,
          "en": "users might initially see pretty empty websites",
          "zh": ""
        },
        {
          "id": 53,
          "start": 156.66,
          "end": 159.57,
          "en": "or at least some missing content.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 159.57,
          "end": 161.64,
          "en": "That's not necessarily a problem,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 161.64,
          "end": 164.43,
          "en": "but it is something that could happen.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 164.43,
          "end": 168,
          "en": "In addition, search engine optimization can be a problem",
          "zh": ""
        },
        {
          "id": 57,
          "start": 168,
          "end": 170.7,
          "en": "because search engine crawlers",
          "zh": ""
        },
        {
          "id": 58,
          "start": 170.7,
          "end": 173.7,
          "en": "will likely see an empty site",
          "zh": ""
        },
        {
          "id": 59,
          "start": 173.7,
          "end": 175.44,
          "en": "because they are not waiting",
          "zh": ""
        },
        {
          "id": 60,
          "start": 175.44,
          "end": 177.78,
          "en": "for the client-side JavaScript code",
          "zh": ""
        },
        {
          "id": 61,
          "start": 177.78,
          "end": 179.88,
          "en": "to render all the content.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 179.88,
          "end": 182.79,
          "en": "At least, they're not guaranteed to wait.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 182.79,
          "end": 187.47,
          "en": "So since this initial HTML file here is pretty empty,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 187.47,
          "end": 188.303,
          "en": "as you can see,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 188.303,
          "end": 191.7,
          "en": "it only has a couple of style tags and script tags,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 191.7,
          "end": 195.66,
          "en": "but no actual content, just this placeholder,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 195.66,
          "end": 197.4,
          "en": "since that's the case,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 197.4,
          "end": 200.91,
          "en": "we could run into those disadvantages here.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 200.91,
          "end": 204.93,
          "en": "But there also are applications where this might not matter",
          "zh": ""
        },
        {
          "id": 70,
          "start": 204.93,
          "end": 207.45,
          "en": "because search engines might not matter",
          "zh": ""
        },
        {
          "id": 71,
          "start": 207.45,
          "end": 210.75,
          "en": "because it's some internal application",
          "zh": ""
        },
        {
          "id": 72,
          "start": 210.75,
          "end": 214.44,
          "en": "or an application that requires authentication anyways.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 214.44,
          "end": 217.5,
          "en": "And in such cases, building your Angular apps",
          "zh": ""
        },
        {
          "id": 74,
          "start": 217.5,
          "end": 220.803,
          "en": "as single page applications can be a good idea.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
