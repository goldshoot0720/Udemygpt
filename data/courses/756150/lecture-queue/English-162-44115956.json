          "en": "then here Fahrenheit to Celsius,",
          "zh": ""
        },
        {
          "id": 88,
          "start": 251.46,
          "end": 254.594,
          "en": "and then here Fahrenheit to Fahrenheit,",
          "zh": ""
        },
        {
          "id": 89,
          "start": 254.594,
          "end": 257.253,
