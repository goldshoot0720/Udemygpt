{
  "version": 1,
  "courseId": 756150,
  "courseSlug": "the-complete-guide-to-angular-2",
  "courseTitle": "Angular - The Complete Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "32463340",
      "title": "Routing with Standalone Components",
      "lectureOrder": 671,
      "videoOrder": 617,
      "sourceHash": "2f4ced703b95f7f7f65c019c0d80071972cf80f62dfdd494ea04024be98a0d65",
      "cues": [
        {
          "id": 1,
          "start": 2.13,
          "end": 3.39,
          "en": "Instructor: Now with all those",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.39,
          "end": 6.42,
          "en": "basics about standalone components out of the way,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.42,
          "end": 8.37,
          "en": "let's move one step further",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.37,
          "end": 11.4,
          "en": "and let's take a look at standalone components combined",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.4,
          "end": 15.51,
          "en": "with routing because of course in many Angular applications",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.51,
          "end": 17.223,
          "en": "you also need routing.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.09,
          "end": 21.27,
          "en": "For this attached you find an updated starting project",
          "zh": ""
        },
        {
          "id": 8,
          "start": 21.27,
          "end": 23.37,
          "en": "which is the same project as before",
          "zh": ""
        },
        {
          "id": 9,
          "start": 23.37,
          "end": 27.06,
          "en": "with all those components migrated to standalone components",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.06,
          "end": 29.97,
          "en": "at least the components we worked on thus far.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.97,
          "end": 33.21,
          "en": "But we got some new components in there as well.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 33.21,
          "end": 37.02,
          "en": "We got an about.component which renders a simple dummy",
          "zh": ""
        },
        {
          "id": 13,
          "start": 37.02,
          "end": 39.907,
          "en": "About page and a dashboard.component",
          "zh": ""
        },
        {
          "id": 14,
          "start": 39.907,
          "end": 42.36,
          "en": "which renders a dummy page",
          "zh": ""
        },
        {
          "id": 15,
          "start": 42.36,
          "end": 44.85,
          "en": "which also has another router link in there",
          "zh": ""
        },
        {
          "id": 16,
          "start": 44.85,
          "end": 47.76,
          "en": "because there we can navigate to this TodayComponent",
          "zh": ""
        },
        {
          "id": 17,
          "start": 47.76,
          "end": 49.593,
          "en": "which is another dummy page.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 50.52,
          "end": 52.47,
          "en": "Now what's interesting here is",
          "zh": ""
        },
        {
          "id": 19,
          "start": 52.47,
          "end": 56.04,
          "en": "that the dashboard components have their own module",
          "zh": ""
        },
        {
          "id": 20,
          "start": 56.04,
          "end": 60.18,
          "en": "where I'm specifically declaring the dashboard.component",
          "zh": ""
        },
        {
          "id": 21,
          "start": 60.18,
          "end": 62.43,
          "en": "and then the dashboard-routing.module.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 62.43,
          "end": 65.917,
          "en": "And the dashboard-routing.module is responsible",
          "zh": ""
        },
        {
          "id": 23,
          "start": 65.917,
          "end": 70.28999999999999,
          "en": "for navigating between dashboard and this TodayComponent.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 70.28999999999999,
          "end": 71.67,
          "en": "And it's worth noting",
          "zh": ""
        },
        {
          "id": 25,
          "start": 71.67,
          "end": 75,
          "en": "that they are provided with the forChild method",
          "zh": ""
        },
        {
          "id": 26,
          "start": 75,
          "end": 77.73,
          "en": "making them lazy loadable.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 77.73,
          "end": 79.47,
          "en": "Because that's the idea.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 79.47,
          "end": 81.72,
          "en": "I have this dashboard-routing.module",
          "zh": ""
        },
        {
          "id": 29,
          "start": 81.72,
          "end": 84.3,
          "en": "and the module and its routes should be loaded",
          "zh": ""
        },
        {
          "id": 30,
          "start": 84.3,
          "end": 88.44,
          "en": "lazily when they're needed by the app-routing.module.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 88.44,
          "end": 91.62,
          "en": "This is also new, a never-new file I added",
          "zh": ""
        },
        {
          "id": 32,
          "start": 91.62,
          "end": 93.27000000000001,
          "en": "to this starting project.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 93.27000000000001,
          "end": 97.41,
          "en": "And in this app-routing.module, I am defining some routes",
          "zh": ""
        },
        {
          "id": 34,
          "start": 97.41,
          "end": 101.49000000000001,
          "en": "the Route route to the WelcomeComponent, the about route",
          "zh": ""
        },
        {
          "id": 35,
          "start": 101.49000000000001,
          "end": 104.78999999999999,
          "en": "to the AboutComponent, and then the dashboard route,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 104.78999999999999,
          "end": 108.63,
          "en": "which loads this dashboard routing module lazily.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 108.63,
          "end": 113.55,
          "en": "So that module I just showed you is loaded lazily here.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 113.55,
          "end": 116.67,
          "en": "And again this is all default Angular code.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 116.67,
          "end": 120.39,
          "en": "That is what you already know; that's nothing special.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 120.39,
          "end": 122.79,
          "en": "But this also won't work like this because",
          "zh": ""
        },
        {
          "id": 41,
          "start": 122.79,
          "end": 126.566,
          "en": "at the moment this app-routing.module is not wired up",
          "zh": ""
        },
        {
          "id": 42,
          "start": 126.566,
          "end": 128.94,
          "en": "because we have no app module.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 128.94,
          "end": 132.39,
          "en": "We removed that app module after all.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 132.39,
          "end": 134.52,
          "en": "Therefore, if you ng serve this,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 134.52,
          "end": 137.19,
          "en": "if you start the development server here,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 137.19,
          "end": 139.56,
          "en": "you will notice that this fails",
          "zh": ""
        },
        {
          "id": 47,
          "start": 139.56,
          "end": 142.65,
          "en": "because in the app.component template here",
          "zh": ""
        },
        {
          "id": 48,
          "start": 142.65,
          "end": 147.45,
          "en": "I'm using the router-outlet, but this won't work anymore",
          "zh": ""
        },
        {
          "id": 49,
          "start": 147.45,
          "end": 150.6,
          "en": "because the app.component is a standalone component",
          "zh": ""
        },
        {
          "id": 50,
          "start": 150.6,
          "end": 153.81,
          "en": "and does not know what to do with that router outlet",
          "zh": ""
        },
        {
          "id": 51,
          "start": 153.81,
          "end": 156.66,
          "en": "and it also doesn't know about these routes.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 156.66,
          "end": 159.69,
          "en": "So therefore that's what we'll have to fix here.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 159.69,
          "end": 162.24,
          "en": "Now, as a first step to fix this",
          "zh": ""
        },
        {
          "id": 54,
          "start": 162.24,
          "end": 164.67000000000002,
          "en": "we have to make the app.component aware",
          "zh": ""
        },
        {
          "id": 55,
          "start": 164.67000000000002,
          "end": 168.03,
          "en": "of the router module, the router module that's built",
          "zh": ""
        },
        {
          "id": 56,
          "start": 168.03,
          "end": 171.32999999999998,
          "en": "into Angular, so that it knows the router-outlet,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 171.32999999999998,
          "end": 174.27,
          "en": "but also the routerLink directive.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 174.27,
          "end": 177.72,
          "en": "Because routerLink and router-outlet are things",
          "zh": ""
        },
        {
          "id": 59,
          "start": 177.72,
          "end": 181.2,
          "en": "totally unknown to Angular if you're not making",
          "zh": ""
        },
        {
          "id": 60,
          "start": 181.2,
          "end": 183.18,
          "en": "the router module available.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 183.18,
          "end": 185.16,
          "en": "And right now the app.component doesn't know",
          "zh": ""
        },
        {
          "id": 62,
          "start": 185.16,
          "end": 187.74,
          "en": "about it because it's standalone.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 187.74,
          "end": 190.95,
          "en": "So just because we have an ngModule here",
          "zh": ""
        },
        {
          "id": 64,
          "start": 190.95,
          "end": 193.68,
          "en": "where we are defining the RouterModule",
          "zh": ""
        },
        {
          "id": 65,
          "start": 193.68,
          "end": 196.53300000000002,
          "en": "does not tell the app.component about it.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 197.37,
          "end": 199.846,
          "en": "Instead, just as with our own custom component,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 199.846,
          "end": 203.16,
          "en": "we have to import the RouterModule here;",
          "zh": ""
        },
        {
          "id": 68,
          "start": 203.16,
          "end": 206.73,
          "en": "we have to add it to imports here in our app.component",
          "zh": ""
        },
        {
          "id": 69,
          "start": 206.73,
          "end": 210.003,
          "en": "and also add the import here at the top of our file.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 211.26,
          "end": 214.59,
          "en": "With that, this error is gone",
          "zh": ""
        },
        {
          "id": 71,
          "start": 214.59,
          "end": 217.2,
          "en": "but now we don't see anything on the screen.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 217.2,
          "end": 218.67000000000002,
          "en": "The reason for that is that",
          "zh": ""
        },
        {
          "id": 73,
          "start": 218.67000000000002,
          "end": 222.72,
          "en": "Angular now does know about the router-outlet;",
          "zh": ""
        },
        {
          "id": 74,
          "start": 222.72,
          "end": 224.4,
          "en": "it does now understand this",
          "zh": ""
        },
        {
          "id": 75,
          "start": 224.4,
          "end": 226.74,
          "en": "and it does understand routerLink",
          "zh": ""
        },
        {
          "id": 76,
          "start": 226.74,
          "end": 228.873,
          "en": "but it's not aware of those routes yet.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 229.92000000000002,
          "end": 232.44,
          "en": "Now, to make Angular aware of these routes",
          "zh": ""
        },
        {
          "id": 78,
          "start": 232.44,
          "end": 236.28,
          "en": "we have to go to main.ts where we bootstrap the application",
          "zh": ""
        },
        {
          "id": 79,
          "start": 236.28,
          "end": 239.34,
          "en": "and here we basically have to add our",
          "zh": ""
        },
        {
          "id": 80,
          "start": 239.34,
          "end": 240.9,
          "en": "routing module",
          "zh": ""
        },
        {
          "id": 81,
          "start": 240.9,
          "end": 242.79,
          "en": "to providers.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 242.79,
          "end": 245.58,
          "en": "Now the routing module is not a service",
          "zh": ""
        },
        {
          "id": 83,
          "start": 245.58,
          "end": 246.972,
          "en": "but forRoot",
          "zh": ""
        },
        {
          "id": 84,
          "start": 246.972,
          "end": 250.47,
          "en": "actually acts as a service.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 250.47,
          "end": 254.97,
          "en": "Now, to make the app routing module work here in main.ts",
          "zh": ""
        },
        {
          "id": 86,
          "start": 254.97,
          "end": 258.54,
          "en": "we have to import a special helper function provided",
          "zh": ""
        },
        {
          "id": 87,
          "start": 258.54,
          "end": 260.939,
          "en": "by @angular/core and that's the",
          "zh": ""
        },
        {
          "id": 88,
          "start": 260.939,
          "end": 263.823,
          "en": "importProvidersfrom function.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 265.35,
          "end": 268.65,
          "en": "We have to add this here to our providers array",
          "zh": ""
        },
        {
          "id": 90,
          "start": 268.65,
          "end": 271.68,
          "en": "on bootstrapApplication and it's a function",
          "zh": ""
        },
        {
          "id": 91,
          "start": 271.68,
          "end": 273.27,
          "en": "so we execute it.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 273.27,
          "end": 276.69,
          "en": "And then to importProvidersfrom",
          "zh": ""
        },
        {
          "id": 93,
          "start": 276.69,
          "end": 280.53,
          "en": "we add a pointer at AppRoutingModule",
          "zh": ""
        },
        {
          "id": 94,
          "start": 280.53,
          "end": 281.363,
          "en": "like this.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 282.39,
          "end": 286.29,
          "en": "So we have to import AppRoutingModule from this",
          "zh": ""
        },
        {
          "id": 96,
          "start": 286.29,
          "end": 289.86,
          "en": "app-routing.module file, and then we point at it here.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 289.86,
          "end": 293.61,
          "en": "We pass a pointer at this routing module clause",
          "zh": ""
        },
        {
          "id": 98,
          "start": 293.61,
          "end": 295.7,
          "en": "to importProvidersfrom.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 296.71500000000003,
          "end": 300.15,
          "en": "And this in the end makes our standalone route component",
          "zh": ""
        },
        {
          "id": 100,
          "start": 300.15,
          "end": 302.85,
          "en": "aware of our routes and makes the overall",
          "zh": ""
        },
        {
          "id": 101,
          "start": 302.85,
          "end": 307.23,
          "en": "Angular application aware of our routes, so to say.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 307.23,
          "end": 310.68,
          "en": "If we save this, now, our Welcome page is back",
          "zh": ""
        },
        {
          "id": 103,
          "start": 310.68,
          "end": 313.44,
          "en": "but we can now also navigate to the About page",
          "zh": ""
        },
        {
          "id": 104,
          "start": 313.44,
          "end": 315.36,
          "en": "or the Dashboard page.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 315.36,
          "end": 318.51,
          "en": "And it's worth noting if we reload the application",
          "zh": ""
        },
        {
          "id": 106,
          "start": 318.51,
          "end": 320.97,
          "en": "on the homepage and we open the Network tab",
          "zh": ""
        },
        {
          "id": 107,
          "start": 320.97,
          "end": 322.77,
          "en": "in our browser dev tools,",
          "zh": ""
        },
        {
          "id": 108,
          "start": 322.77,
          "end": 326.16,
          "en": "that this Dashboard page is loaded lazily.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 326.16,
          "end": 329.52,
          "en": "If you watch the HTTP requests here, you'll notice that",
          "zh": ""
        },
        {
          "id": 110,
          "start": 329.52,
          "end": 332.25,
          "en": "if I click on Dashboard, the code for this component",
          "zh": ""
        },
        {
          "id": 111,
          "start": 332.25,
          "end": 335.01,
          "en": "is only downloaded when it's needed.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 335.01,
          "end": 338.15999999999997,
          "en": "So lazy loading works just fine here and it's also worth",
          "zh": ""
        },
        {
          "id": 113,
          "start": 338.15999999999997,
          "end": 341.58,
          "en": "noting that all of that works in an application",
          "zh": ""
        },
        {
          "id": 114,
          "start": 341.58,
          "end": 345.03,
          "en": "in an Angular app where many components including",
          "zh": ""
        },
        {
          "id": 115,
          "start": 345.03,
          "end": 349.26,
          "en": "the root component, are actually standalone components.",
          "zh": ""
        },
        {
          "id": 116,
          "start": 349.26,
          "end": 353.04,
          "en": "So app component is a standalone component and nonetheless",
          "zh": ""
        },
        {
          "id": 117,
          "start": 353.04,
          "end": 356.49,
          "en": "by connecting our routing setup like this, we are able",
          "zh": ""
        },
        {
          "id": 118,
          "start": 356.49,
          "end": 360.54,
          "en": "to use routing with our app-routing.module and with a couple",
          "zh": ""
        },
        {
          "id": 119,
          "start": 360.54,
          "end": 364.383,
          "en": "of components that are not standalone components at all:",
          "zh": ""
        },
        {
          "id": 120,
          "start": 365.31,
          "end": 369.39,
          "en": "dashboard, today, and about are not standalone components.",
          "zh": ""
        },
        {
          "id": 121,
          "start": 369.39,
          "end": 372.72,
          "en": "Instead they are registered in a different module",
          "zh": ""
        },
        {
          "id": 122,
          "start": 372.72,
          "end": 374.94,
          "en": "and in a different routing module",
          "zh": ""
        },
        {
          "id": 123,
          "start": 374.94,
          "end": 377.28,
          "en": "and everything works just fine.",
          "zh": ""
        },
        {
          "id": 124,
          "start": 377.28,
          "end": 379.56,
          "en": "So again, you can blend modules",
          "zh": ""
        },
        {
          "id": 125,
          "start": 379.56,
          "end": 383.59,
          "en": "with this standalone approach also when using routing",
          "zh": ""
        },
        {
          "id": 126,
          "start": 384.51,
          "end": 387.24,
          "en": "but you can also choose a different approach,",
          "zh": ""
        },
        {
          "id": 127,
          "start": 387.24,
          "end": 390.9,
          "en": "turn those components into standalone components as well",
          "zh": ""
        },
        {
          "id": 128,
          "start": 390.9,
          "end": 394.203,
          "en": "and then also adjust the routing code accordingly.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
