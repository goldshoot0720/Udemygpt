          "end": 134.611,
          "en": "we can now invoke the TypeScript compiler,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 134.611,
          "end": 136.45,
          "en": "and that is really important.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 136.45,
          "end": 137.91,
          "en": "As you learned,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 137.91,
          "end": 140.493,
          "en": "TypeScript is a superset to JavaScript,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 140.493,
          "end": 145.10399999999998,
