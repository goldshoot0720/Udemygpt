          "id": 54,
          "start": 155.82,
          "end": 157.251,
          "en": "it will fail.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 157.251,
          "end": 162.251,
          "en": "Therefore, we need to compile Typescript to JavaScript.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 162.59199999999998,
          "end": 165.851,
          "en": "And during that compilation process,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 165.851,
          "end": 169.77,
          "en": "all our type annotations will be removed",
          "zh": ""
        },
        {
          "id": 58,
          "start": 169.77,
          "end": 173.133,
          "en": "because JavaScript doesn't know those annotations,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 173.133,
          "end": 176.053,
          "en": "but it's during this compilation step",
          "zh": ""
        },
        {
          "id": 60,
          "start": 176.053,
          "end": 179.053,
          "en": "where we will be notified about errors",
          "zh": ""
        },
        {
          "id": 61,
          "start": 179.053,
          "end": 183.032,
          "en": "in addition to the notification we get in the IDE already.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 183.032,
          "end": 184.842,
          "en": "So it's this compilation step",
          "zh": ""
        },
        {
          "id": 63,
          "start": 184.842,
          "end": 189.842,
          "en": "which then will warn us of potential code problems if",
          "zh": ""
        },
        {
          "id": 64,
          "start": 189.9,
          "end": 193.23,
          "en": "we haven't spotted them in the IDE before.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 193.23,
          "end": 195.57,
          "en": "And then it's that compiled code",
          "zh": ""
        },
        {
          "id": 66,
          "start": 195.57,
          "end": 197.34,
          "en": "which will run in the browser.",
          "zh": ""
        },
        {
          "id": 67,
