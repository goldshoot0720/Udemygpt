  "lectures": [
    {
      "id": "44115886",
      "title": "Using Attribute Directives To Change Element Behavior",
      "lectureOrder": 156,
      "videoOrder": 148,
      "sourceHash": "c5ec734bef4e4dfe142f9ee3ea0e90882a0ad01233433d341ffdfeddd618f860",
      "cues": [
        {
          "id": 1,
          "start": 0.48,
          "end": 2.22,
          "en": "So the goal is to get a warning",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.22,
          "end": 4.38,
          "en": "when we click this link here",
          "zh": ""
        },
        {
          "id": 3,
          "start": 4.38,
          "end": 5.76,
          "en": "and we want to be asked",
          "zh": ""
        },
        {
          "id": 4,
          "start": 5.76,
          "end": 8.43,
          "en": "whether we really wanna leave the page.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 8.43,
          "end": 11.7,
          "en": "So therefore, in this SafeLink directive,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 11.7,
          "end": 15.42,
          "en": "we wanna listen to clicks on the element",
          "zh": ""
        },
        {
          "id": 7,
          "start": 15.42,
          "end": 17.373,
          "en": "to which this directive was added.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 18.84,
          "end": 21.03,
          "en": "And one way, and the main way,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 21.03,
          "end": 23.04,
          "en": "of listening to such clicks",
          "zh": ""
        },
        {
          "id": 10,
          "start": 23.04,
          "end": 26.94,
          "en": "would be to use the host configuration option here",
          "zh": ""
        },
        {
          "id": 11,
          "start": 26.94,
          "end": 29.463,
          "en": "on this directive configuration object.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 30.57,
          "end": 34.41,
          "en": "Because just as with the component decorator,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 34.41,
          "end": 39.09,
          "en": "the directive decorator allows us to add attributes",
          "zh": ""
        },
        {
          "id": 14,
          "start": 39.09,
          "end": 42.84,
          "en": "or event listeners to the host element",
          "zh": ""
        },
        {
          "id": 15,
          "start": 42.84,
          "end": 47.25,
          "en": "that is controlled or enhanced by this directive.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 47.25,
          "end": 48.93,
          "en": "So to this anchor element",
          "zh": ""
        },
        {
          "id": 17,
          "start": 48.93,
          "end": 51.603,
          "en": "with this attribute here, in this case.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 52.59,
          "end": 55.47,
          "en": "And here I wanna listen to click events",
          "zh": ""
        },
        {
          "id": 19,
          "start": 55.47,
          "end": 58.26,
          "en": "just as you learned it in the components section",
          "zh": ""
        },
        {
          "id": 20,
          "start": 58.26,
          "end": 59.94,
          "en": "earlier in this course,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 59.94,
          "end": 64.94,
          "en": "by adding a key with this name to this host object",
          "zh": ""
        },
        {
          "id": 22,
          "start": 65.88,
          "end": 68.64,
          "en": "and as a value we then specified a code",
          "zh": ""
        },
        {
          "id": 23,
          "start": 68.64,
          "end": 73.64,
          "en": "that should be executed by Angular when that event occurs.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 73.65,
          "end": 77.31,
          "en": "And we're using this Angular event binding syntax here.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 77.31,
          "end": 78.93,
          "en": "That's what you also learned",
          "zh": ""
        },
        {
          "id": 26,
          "start": 78.93,
          "end": 80.883,
          "en": "in the components deep dive section.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 82.14,
          "end": 85.83,
          "en": "Now, the code that should execute here is, in the end,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 85.83,
          "end": 88.8,
          "en": "a function that should be triggered.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 88.8,
          "end": 91.47,
          "en": "And therefore I'll start by adding that function",
          "zh": ""
        },
        {
          "id": 30,
          "start": 91.47,
          "end": 94.35,
          "en": "to this SafeLink directive class",
          "zh": ""
        },
        {
          "id": 31,
          "start": 94.35,
          "end": 97.31700000000001,
          "en": "and I'll name it onConfirmLeavePage,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 99.27000000000001,
          "end": 101.40299999999999,
          "en": "but the name is up to you of course.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 103.17,
          "end": 108.06,
          "en": "And in there I can use window confirm",
          "zh": ""
        },
        {
          "id": 34,
          "start": 108.06,
          "end": 111.72,
          "en": "to use a method built into the browser",
          "zh": ""
        },
        {
          "id": 35,
          "start": 111.72,
          "end": 116.72,
          "en": "to ask the user, \"Do you want to leave the app?\"",
          "zh": ""
        },
        {
          "id": 36,
          "start": 118.41,
          "end": 123.12,
          "en": "And as a result, I'll get back a bullion value,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 123.12,
          "end": 126.84,
          "en": "which I can store in a constant named, wantsToLeave.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 130.86,
          "end": 133.417,
          "en": "And then we can check if wantsToLeave,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 134.797,
          "end": 137.55,
          "en": "so if the user wants to leave the page,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 137.55,
          "end": 141.03300000000002,
          "en": "in which case I'll return and not do anything.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 142.32,
          "end": 146.01,
          "en": "But else if wantsToLeave is false,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 146.01,
          "end": 148.74,
          "en": "so if you make it past this if check,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 148.74,
          "end": 153.74,
          "en": "I want to prevent the default of the event,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 154.98,
          "end": 159.18,
          "en": "which I expect to get here onConfirmLeave page,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 159.18,
          "end": 161.673,
          "en": "and that will be of type MouseEvent,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 162.66899999999998,
          "end": 166.293,
          "en": "which is a built in type provided by TypeScript.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 168.03,
          "end": 171.09,
          "en": "And I wanna prevent that default of that event",
          "zh": ""
        },
        {
          "id": 48,
          "start": 171.09,
          "end": 173.94,
          "en": "to cancel this navigation",
          "zh": ""
        },
        {
          "id": 49,
          "start": 173.94,
          "end": 178.05,
          "en": "that would otherwise be triggered by the anchor element.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 178.05,
          "end": 180.48,
          "en": "So with that, if the user chooses no,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 180.48,
          "end": 183.003,
          "en": "we will cancel that navigation.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 184.59,
          "end": 186.27,
          "en": "Now we just need to make sure",
          "zh": ""
        },
        {
          "id": 53,
          "start": 186.27,
          "end": 188.88,
          "en": "that onConfirmLeave page is triggered",
          "zh": ""
        },
        {
          "id": 54,
          "start": 188.88,
          "end": 191.52,
          "en": "and therefore, here in this host setting,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 191.52,
          "end": 192.9,
          "en": "we should execute that",
          "zh": ""
        },
        {
          "id": 56,
          "start": 192.9,
          "end": 196.77,
          "en": "and then pass this special $event variable",
          "zh": ""
        },
        {
          "id": 57,
          "start": 196.77,
          "end": 199.59,
          "en": "that is provided by Angular here",
          "zh": ""
        },
        {
          "id": 58,
          "start": 199.59,
          "end": 202.14,
          "en": "when using this event binding syntax",
          "zh": ""
        },
        {
          "id": 59,
          "start": 202.14,
          "end": 204.723,
          "en": "to onConfirmLeave page.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 205.59,
          "end": 209.67000000000002,
          "en": "And $event will be such a MouseEvent object",
          "zh": ""
        },
        {
          "id": 61,
          "start": 209.67000000000002,
          "end": 212.94,
          "en": "that's automatically generated by the browser in the end",
          "zh": ""
        },
        {
          "id": 62,
          "start": 212.94,
          "end": 214.953,
          "en": "when an anchor element is clicked.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 216.51,
          "end": 218.7,
          "en": "So that will trigger this method",
          "zh": ""
        },
        {
          "id": 64,
          "start": 218.7,
          "end": 221.37,
          "en": "whenever the host element of this directive,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 221.37,
          "end": 224.04,
          "en": "which is this anchor element with this attribute,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 224.04,
          "end": 225.183,
          "en": "is being clicked.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 226.82999999999998,
          "end": 229.89,
          "en": "So with all that done, if we saved that all,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 229.89,
          "end": 232.8,
          "en": "and you go back, if you click that first link",
          "zh": ""
        },
        {
          "id": 69,
          "start": 232.8,
          "end": 235.41,
          "en": "where I did add that directive,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 235.41,
          "end": 237.873,
          "en": "you should get that dialogue here.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 239.28,
          "end": 244.28,
          "en": "And if you click Cancel, you should stay on this page.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 244.59,
          "end": 248.71,
          "en": "If you click Okay, you should be navigated away",
          "zh": ""
        },
        {
          "id": 73,
          "start": 250.5,
          "end": 254.04,
          "en": "because we either prevent that navigation or not,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 254.04,
          "end": 256.17,
          "en": "depending on what the user chose.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 256.17,
          "end": 259.29,
          "en": "But that's an example for an attribute directive",
          "zh": ""
        },
        {
          "id": 76,
          "start": 259.29,
          "end": 264.15,
          "en": "that we can build ourselves to enhance built-in elements,",
          "zh": ""
        },
        {
          "id": 77,
          "start": 264.15,
          "end": 266.52,
          "en": "in this case, anchor elements,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 266.52,
          "end": 271.52,
          "en": "so that we can easily add this confirmation feature here",
          "zh": ""
        },
        {
          "id": 79,
          "start": 272.1,
          "end": 274.11,
          "en": "to any link in our application",
          "zh": ""
        },
        {
          "id": 80,
          "start": 274.11,
          "end": 277.44,
          "en": "by simply putting that directive onto it.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 277.44,
          "end": 280.74,
          "en": "And that's why you sometimes might need directives",
          "zh": ""
        },
        {
          "id": 82,
          "start": 280.74,
          "end": 283.65,
          "en": "because they do allow you to add quick",
          "zh": ""
        },
        {
          "id": 83,
          "start": 283.65,
          "end": 285.753,
          "en": "and easy enhancements like this.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
