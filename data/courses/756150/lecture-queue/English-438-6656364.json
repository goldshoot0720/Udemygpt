          "end": 208.92000000000002,
          "en": "because this is hash mode routing.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 208.92000000000002,
          "end": 213.187,
          "en": "What this hashtag will do is it informs your web server",
          "zh": ""
        },
        {
          "id": 70,
          "start": 213.187,
          "end": 216.84,
          "en": "\"Hey, only care about the part in this URL",
          "zh": ""
        },
        {
          "id": 71,
          "start": 216.84,
          "end": 221.31,
          "en": "before this hashtag.\" So all the part thereafter",
          "zh": ""
        },
        {
          "id": 72,
          "start": 221.31,
          "end": 223.77,
          "en": "will be ignored by your web server.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 223.77,
          "end": 225.66,
          "en": "Therefore, this will run even",
          "zh": ""
        },
        {
          "id": 74,
          "start": 225.66,
          "end": 228.9,
          "en": "on servers which don't return the index html file",
          "zh": ""
        },
        {
          "id": 75,
          "start": 228.9,
          "end": 232.47,
          "en": "in case of 404 errors because they will only care",
          "zh": ""
        },
        {
          "id": 76,
          "start": 232.47,
          "end": 234.63,
          "en": "about the part in front of the hashtag.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 234.63,
          "end": 236.56,
          "en": "That's how it works by default",
          "zh": ""
        },
        {
          "id": 78,
          "start": 237.75,
          "end": 241.02,
          "en": "and the part after the hashtag can now be parsed",
          "zh": ""
        },
        {
          "id": 79,
          "start": 241.02,
          "end": 244.65,
          "en": "by your client by Angular.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 244.65,
          "end": 246.06,
          "en": "So this is the solution",
          "zh": ""
        },
        {
          "id": 81,
          "start": 246.06,
          "end": 248.88,
          "en": "if you can't get the other approach to work.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 248.88,
          "end": 250.53,
