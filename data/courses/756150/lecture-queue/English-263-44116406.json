{
  "version": 1,
  "courseId": 756150,
  "courseSlug": "the-complete-guide-to-angular-2",
  "courseTitle": "Angular - The Complete Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "44116406",
      "title": "Extracting Dynamic Route Parameters via Observables",
      "lectureOrder": 276,
      "videoOrder": 263,
      "sourceHash": "02ac710db0838ded0b50b5cad6433eeaebca169fb9bb7dadf40eff3118e40d92",
      "cues": [
        {
          "id": 1,
          "start": 0.57,
          "end": 5.31,
          "en": "So you can get hold of the dynamic path parameter values",
          "zh": ""
        },
        {
          "id": 2,
          "start": 5.31,
          "end": 8.67,
          "en": "and extract them with help of inputs",
          "zh": ""
        },
        {
          "id": 3,
          "start": 8.67,
          "end": 13.67,
          "en": "if you enable this with component input binding setting here",
          "zh": ""
        },
        {
          "id": 4,
          "start": 14.04,
          "end": 15.693,
          "en": "when providing the router.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 16.92,
          "end": 19.86,
          "en": "Now it is the approach I personally prefer",
          "zh": ""
        },
        {
          "id": 6,
          "start": 19.86,
          "end": 21.9,
          "en": "because it is straightforward,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 21.9,
          "end": 23.49,
          "en": "but it's not the only way",
          "zh": ""
        },
        {
          "id": 8,
          "start": 23.49,
          "end": 26.76,
          "en": "of getting hold of those path parameters.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 26.76,
          "end": 29.28,
          "en": "And especially if you would be working",
          "zh": ""
        },
        {
          "id": 10,
          "start": 29.28,
          "end": 31.44,
          "en": "in an older Angular version,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 31.44,
          "end": 33.443,
          "en": "you might not have access to this approach",
          "zh": ""
        },
        {
          "id": 12,
          "start": 33.443,
          "end": 36.3,
          "en": "and therefore it's also worth knowing",
          "zh": ""
        },
        {
          "id": 13,
          "start": 36.3,
          "end": 40.023,
          "en": "about the alternative way of extracting that data.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 40.95,
          "end": 42.78,
          "en": "Now, an alternative way,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 42.78,
          "end": 44.58,
          "en": "which you might need to use",
          "zh": ""
        },
        {
          "id": 16,
          "start": 44.58,
          "end": 47.4,
          "en": "because you can't use this input binding",
          "zh": ""
        },
        {
          "id": 17,
          "start": 47.4,
          "end": 50.34,
          "en": "because you're using an older Angular version",
          "zh": ""
        },
        {
          "id": 18,
          "start": 50.34,
          "end": 52.471,
          "en": "or simply because you don't like it,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 52.471,
          "end": 55.02,
          "en": "an alternative way of getting hold of",
          "zh": ""
        },
        {
          "id": 20,
          "start": 55.02,
          "end": 57.469,
          "en": "that dynamic path parameter value",
          "zh": ""
        },
        {
          "id": 21,
          "start": 57.469,
          "end": 61.71,
          "en": "would be to inject a special kind of service",
          "zh": ""
        },
        {
          "id": 22,
          "start": 61.71,
          "end": 63.9,
          "en": "into this component and that would be",
          "zh": ""
        },
        {
          "id": 23,
          "start": 63.9,
          "end": 66.938,
          "en": "the activated route service.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 66.938,
          "end": 71.28,
          "en": "Activated route, which must be imported",
          "zh": ""
        },
        {
          "id": 25,
          "start": 71.28,
          "end": 75.36,
          "en": "from at Angular router and I'm storing it in",
          "zh": ""
        },
        {
          "id": 26,
          "start": 75.36,
          "end": 77.67,
          "en": "a property named activated route here",
          "zh": ""
        },
        {
          "id": 27,
          "start": 77.67,
          "end": 80.373,
          "en": "though as so often the name doesn't matter here.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 82.02,
          "end": 86.13,
          "en": "Activated route then gives you various properties",
          "zh": ""
        },
        {
          "id": 29,
          "start": 86.13,
          "end": 89.22,
          "en": "that hold information about the route",
          "zh": ""
        },
        {
          "id": 30,
          "start": 89.22,
          "end": 92.482,
          "en": "that has been activated by the Angular router",
          "zh": ""
        },
        {
          "id": 31,
          "start": 92.482,
          "end": 95.67,
          "en": "and you can for example,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 95.67,
          "end": 98.72999999999999,
          "en": "implement the OnInit interface",
          "zh": ""
        },
        {
          "id": 33,
          "start": 98.72999999999999,
          "end": 102.50999999999999,
          "en": "so that you're forced to add ngOnInit",
          "zh": ""
        },
        {
          "id": 34,
          "start": 102.50999999999999,
          "end": 107.50999999999999,
          "en": "so that in there you can console log this activated route",
          "zh": ""
        },
        {
          "id": 35,
          "start": 108.36,
          "end": 110.72999999999999,
          "en": "so that you get an idea of what's inside",
          "zh": ""
        },
        {
          "id": 36,
          "start": 110.72999999999999,
          "end": 112.32300000000001,
          "en": "this injected object.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 113.58,
          "end": 116.956,
          "en": "If I do that here and I then take a look at my console,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 116.956,
          "end": 121.17,
          "en": "I can see that activated route is an object that,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 121.17,
          "end": 124.53,
          "en": "for example, holds a pointer to the class,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 124.53,
          "end": 126.587,
          "en": "the component class that has been loaded",
          "zh": ""
        },
        {
          "id": 41,
          "start": 126.587,
          "end": 130.38,
          "en": "and then it holds a bunch of subjects.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 130.38,
          "end": 133.08,
          "en": "So a bunch of observables in the end",
          "zh": ""
        },
        {
          "id": 43,
          "start": 133.08,
          "end": 135.93,
          "en": "that are managed by Angular",
          "zh": ""
        },
        {
          "id": 44,
          "start": 135.93,
          "end": 138.125,
          "en": "and it holds some additional properties",
          "zh": ""
        },
        {
          "id": 45,
          "start": 138.125,
          "end": 141.81,
          "en": "which are in the end derived from these subjects",
          "zh": ""
        },
        {
          "id": 46,
          "start": 141.81,
          "end": 143.223,
          "en": "like paraMap,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 144.21,
          "end": 146.76,
          "en": "which would be an observable in the end",
          "zh": ""
        },
        {
          "id": 48,
          "start": 146.76,
          "end": 149.82,
          "en": "to which you can subscribe to be notified",
          "zh": ""
        },
        {
          "id": 49,
          "start": 149.82,
          "end": 153.063,
          "en": "about changes to the route parameters.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 153.99,
          "end": 156.12,
          "en": "You can also extract other information",
          "zh": ""
        },
        {
          "id": 51,
          "start": 156.12,
          "end": 161.1,
          "en": "and we'll work with some of that data later in this section.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 161.1,
          "end": 163.5,
          "en": "For the moment, we could, for example,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 163.5,
          "end": 166.48,
          "en": "simply set up a subscription to paraMap here",
          "zh": ""
        },
        {
          "id": 54,
          "start": 169.32,
          "end": 174.32,
          "en": "and that will give us that paraMap here",
          "zh": ""
        },
        {
          "id": 55,
          "start": 174.45,
          "end": 177.45,
          "en": "and pass an observer object to it",
          "zh": ""
        },
        {
          "id": 56,
          "start": 177.45,
          "end": 179.43,
          "en": "and to find that next function",
          "zh": ""
        },
        {
          "id": 57,
          "start": 179.43,
          "end": 182.76,
          "en": "where we will get that paraMap.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 182.76,
          "end": 185.73,
          "en": "And that paraMap in the end is an object",
          "zh": ""
        },
        {
          "id": 59,
          "start": 185.73,
          "end": 188.43,
          "en": "that will hold key value pairs",
          "zh": ""
        },
        {
          "id": 60,
          "start": 188.43,
          "end": 191.28,
          "en": "where our dynamic path parameters,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 191.28,
          "end": 195.09,
          "en": "so these identifiers we define during route setup,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 195.09,
          "end": 198.06,
          "en": "are the keys and the actual values",
          "zh": ""
        },
        {
          "id": 63,
          "start": 198.06,
          "end": 200.25,
          "en": "that are encoded in the URL",
          "zh": ""
        },
        {
          "id": 64,
          "start": 200.25,
          "end": 202.593,
          "en": "are the value for those keys.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 204.36,
          "end": 207.6,
          "en": "So here we could then, for example,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 207.6,
          "end": 212.6,
          "en": "manage the username not as a computed signal like this,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 213.39,
          "end": 215.4,
          "en": "but instead we could set the username",
          "zh": ""
        },
        {
          "id": 68,
          "start": 215.4,
          "end": 217.263,
          "en": "to an empty string initially.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 218.4,
          "end": 221.25,
          "en": "And then here in this next function,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 221.25,
          "end": 224.28,
          "en": "we could use the user's service",
          "zh": ""
        },
        {
          "id": 71,
          "start": 224.28,
          "end": 227.46,
          "en": "and access all the users there to find a user",
          "zh": ""
        },
        {
          "id": 72,
          "start": 227.46,
          "end": 229.236,
          "en": "just as we did it before.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 229.236,
          "end": 233.04,
          "en": "But now I want to compare the user ID of a user",
          "zh": ""
        },
        {
          "id": 74,
          "start": 233.04,
          "end": 237.827,
          "en": "in that array to paraMap get user id",
          "zh": ""
        },
        {
          "id": 75,
          "start": 240.18,
          "end": 243.75,
          "en": "because this paraMap object has a get method",
          "zh": ""
        },
        {
          "id": 76,
          "start": 243.75,
          "end": 247.44,
          "en": "that allows you to extract one of its key value pairs",
          "zh": ""
        },
        {
          "id": 77,
          "start": 247.44,
          "end": 249.66,
          "en": "that's managed by it.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 249.66,
          "end": 253.59,
          "en": "And what you pass to get of course has been an identifier",
          "zh": ""
        },
        {
          "id": 79,
          "start": 253.59,
          "end": 256.41,
          "en": "you specified when configuring the routes.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 256.41,
          "end": 259.677,
          "en": "So if you used user ID here after the colon,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 259.677,
          "end": 264.123,
          "en": "that's also what you want to get access to with get here.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 265.47,
          "end": 267.66,
          "en": "So that will then give you that user ID",
          "zh": ""
        },
        {
          "id": 83,
          "start": 267.66,
          "end": 270.36,
          "en": "that's encoded in the URL and that will",
          "zh": ""
        },
        {
          "id": 84,
          "start": 270.36,
          "end": 273.39,
          "en": "therefore then find us such a user.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 273.39,
          "end": 275.61,
          "en": "Now of course, I now want to update my username",
          "zh": ""
        },
        {
          "id": 86,
          "start": 275.61,
          "end": 277.35,
          "en": "with the name of that user.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 277.35,
          "end": 280.08,
          "en": "So here in that next function,",
          "zh": ""
        },
        {
          "id": 88,
          "start": 280.08,
          "end": 282.78,
          "en": "I actually want to set this username",
          "zh": ""
        },
        {
          "id": 89,
          "start": 282.78,
          "end": 287.52,
          "en": "equal to this user's service users find,",
          "zh": ""
        },
        {
          "id": 90,
          "start": 287.52,
          "end": 289.33,
          "en": "and then there I access the name",
          "zh": ""
        },
        {
          "id": 91,
          "start": 290.55,
          "end": 292.8,
          "en": "and I'll just wrap that here",
          "zh": ""
        },
        {
          "id": 92,
          "start": 292.8,
          "end": 296.31,
          "en": "with curly braces like this.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 296.31,
          "end": 299.97,
          "en": "And I'll add a fallback here to set the username",
          "zh": ""
        },
        {
          "id": 94,
          "start": 299.97,
          "end": 303.57,
          "en": "to an empty string in case we don't find a user for that ID.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 303.57,
          "end": 306.75,
          "en": "And with that we would have an alternative way",
          "zh": ""
        },
        {
          "id": 96,
          "start": 306.75,
          "end": 310.533,
          "en": "of getting hold of that route para value.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 311.37,
          "end": 313.8,
          "en": "Of course, a more complex way",
          "zh": ""
        },
        {
          "id": 98,
          "start": 313.8,
          "end": 317.07,
          "en": "than what we had before, as you can tell,",
          "zh": ""
        },
        {
          "id": 99,
          "start": 317.07,
          "end": 320.319,
          "en": "but still an approach you could use.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 320.319,
          "end": 324.75,
          "en": "And you could of course also use this paraMap",
          "zh": ""
        },
        {
          "id": 101,
          "start": 324.75,
          "end": 326.67,
          "en": "observable in other ways.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 326.67,
          "end": 329.46,
          "en": "You could set up a pipeline where you use",
          "zh": ""
        },
        {
          "id": 103,
          "start": 329.46,
          "end": 332.94,
          "en": "observable operators to extract the username.",
          "zh": ""
        },
        {
          "id": 104,
          "start": 332.94,
          "end": 336.39,
          "en": "This here is just one possible way of using it.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 336.39,
          "end": 339.63,
          "en": "Depending on your level of RXJS knowledge,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 339.63,
          "end": 342.57,
          "en": "you could also embrace RXJS more",
          "zh": ""
        },
        {
          "id": 107,
          "start": 342.57,
          "end": 345.003,
          "en": "and find alternative solutions.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 346.44,
          "end": 348.45,
          "en": "One thing you should definitely do though",
          "zh": ""
        },
        {
          "id": 109,
          "start": 348.45,
          "end": 352.14,
          "en": "is store the subscription and clean it up",
          "zh": ""
        },
        {
          "id": 110,
          "start": 352.14,
          "end": 353.853,
          "en": "once you don't need it anymore.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 354.72,
          "end": 358.95,
          "en": "So you should inject that destroyRef thing,",
          "zh": ""
        },
        {
          "id": 112,
          "start": 358.95,
          "end": 361.383,
          "en": "which we also used before in this course.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 363.96,
          "end": 365.76,
          "en": "And then here in ENG on in it,",
          "zh": ""
        },
        {
          "id": 114,
          "start": 365.76,
          "end": 369.46,
          "en": "use this destroy ref onDestroy hook",
          "zh": ""
        },
        {
          "id": 115,
          "start": 371.19,
          "end": 373.8,
          "en": "to clean up that subscription",
          "zh": ""
        },
        {
          "id": 116,
          "start": 373.8,
          "end": 376.113,
          "en": "whenever the component gets destroyed.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 377.55,
          "end": 380.09,
          "en": "You also might wonder why it's a subscription",
          "zh": ""
        },
        {
          "id": 118,
          "start": 380.09,
          "end": 381.6,
          "en": "in the first place,",
          "zh": ""
        },
        {
          "id": 119,
          "start": 381.6,
          "end": 385.47,
          "en": "but the reason simply is that Angular will reuse",
          "zh": ""
        },
        {
          "id": 120,
          "start": 385.47,
          "end": 389.07,
          "en": "this component as you switch between different users",
          "zh": ""
        },
        {
          "id": 121,
          "start": 389.07,
          "end": 391.95,
          "en": "and will not reload it all the time",
          "zh": ""
        },
        {
          "id": 122,
          "start": 391.95,
          "end": 394.40999999999997,
          "en": "because reusing it is more efficient.",
          "zh": ""
        },
        {
          "id": 123,
          "start": 394.40999999999997,
          "end": 396.9,
          "en": "Therefore, the only thing that will change",
          "zh": ""
        },
        {
          "id": 124,
          "start": 396.9,
          "end": 400.32,
          "en": "is that user ID that's encoded in the URL",
          "zh": ""
        },
        {
          "id": 125,
          "start": 400.32,
          "end": 402.48,
          "en": "and that's why this is a subscription",
          "zh": ""
        },
        {
          "id": 126,
          "start": 402.48,
          "end": 406.68,
          "en": "so that you're notified every time this user ID changes",
          "zh": ""
        },
        {
          "id": 127,
          "start": 406.68,
          "end": 409.92,
          "en": "and so that you can update any data that depends on it,",
          "zh": ""
        },
        {
          "id": 128,
          "start": 409.92,
          "end": 411.81,
          "en": "like this username.",
          "zh": ""
        },
        {
          "id": 129,
          "start": 411.81,
          "end": 415.26,
          "en": "With that in the user tasks component HTML file,",
          "zh": ""
        },
        {
          "id": 130,
          "start": 415.26,
          "end": 418.29,
          "en": "username is now no longer a signal,",
          "zh": ""
        },
        {
          "id": 131,
          "start": 418.29,
          "end": 420.3,
          "en": "therefore all not executed,",
          "zh": ""
        },
        {
          "id": 132,
          "start": 420.3,
          "end": 421.893,
          "en": "but instead use it like this.",
          "zh": ""
        },
        {
          "id": 133,
          "start": 423.18,
          "end": 424.932,
          "en": "And with that, if you save that,",
          "zh": ""
        },
        {
          "id": 134,
          "start": 424.932,
          "end": 428.31,
          "en": "you should be able to switch between different users",
          "zh": ""
        },
        {
          "id": 135,
          "start": 428.31,
          "end": 430.32,
          "en": "and still see their names here,",
          "zh": ""
        },
        {
          "id": 136,
