  "lectures": [
    {
      "id": "14466394",
      "title": "Fetching Recipes",
      "lectureOrder": 607,
      "videoOrder": 559,
      "sourceHash": "366b2926a297add416151096e3d2570ec9f568ae46085f1fec2b0a9e10a53e37",
      "cues": [
        {
          "id": 1,
          "start": 2.25,
          "end": 3.63,
          "en": "Instructor: So we can store data,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.63,
          "end": 5.01,
          "en": "how about fetching?",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.01,
          "end": 8.07,
          "en": "Because obviously, we can delete recipes, right?",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.07,
          "end": 10.41,
          "en": "We can get rid of all of them.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.41,
          "end": 13.29,
          "en": "And in that case, we got a problem here,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.29,
          "end": 16.17,
          "en": "and we want to be able to Fetch Data in that case,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 16.17,
          "end": 19.07,
          "en": "so that we can load all the recipes we have on the server.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.04,
          "end": 21.6,
          "en": "For loading data,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 21.6,
          "end": 24.39,
          "en": "we can again use the data-storage.service.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 24.39,
          "end": 26.94,
          "en": "Which makes sense because if we started using that",
          "zh": ""
        },
        {
          "id": 11,
          "start": 26.94,
          "end": 28.44,
          "en": "for interacting with the backend,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 28.44,
          "end": 30.03,
          "en": "we should definitely stick to it.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 30.03,
          "end": 33.63,
          "en": "And there, we can now simply add a fetchRecipes method,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 33.63,
          "end": 35.31,
          "en": "which should be triggered",
          "zh": ""
        },
        {
          "id": 15,
          "start": 35.31,
          "end": 37.95,
          "en": "when we click that other button in the header.component.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 37.95,
          "end": 40.92,
          "en": "So this button, the Fetch Data button here.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 40.92,
          "end": 42.51,
          "en": "Let's already add that click listener,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 42.51,
          "end": 44.34,
          "en": "and call this onFetchData,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 44.34,
          "end": 47.25,
          "en": "or whatever you wanna call this method, which gets called.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 47.25,
          "end": 48.84,
          "en": "And that method needs to be added",
          "zh": ""
        },
        {
          "id": 21,
          "start": 48.84,
          "end": 51.06,
          "en": "to the component body, of course.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 51.06,
          "end": 54.63,
          "en": "And in there, the goal now is to use the dataStorageService,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 54.63,
          "end": 57.48,
          "en": "and call fetchRecipes.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 57.48,
          "end": 60.3,
          "en": "Now, of course, right now in fetchRecipes,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 60.3,
          "end": 61.68,
          "en": "we're not doing much.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 61.68,
          "end": 63.24,
          "en": "So let's change this by, again,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 63.24,
          "end": 65.94,
          "en": "using the Angular HttpClient,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 65.94,
          "end": 68.37,
          "en": "and there we can now send a get request.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 68.37,
          "end": 71.46000000000001,
          "en": "Now obviously, the URL to which you wanna send that request",
          "zh": ""
        },
        {
          "id": 30,
          "start": 71.46000000000001,
          "end": 74.49,
          "en": "is that same URL we were using up there.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 74.49,
          "end": 76.98,
          "en": "So let's add that URL here,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 76.98,
          "end": 80.85,
          "en": "and let's send the request there to get our recipes.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 80.85,
          "end": 82.56700000000001,
          "en": "Now, just as before, the question is,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 82.56700000000001,
          "end": 84.39,
          "en": "\"Where do we wanna subscribe?\"",
          "zh": ""
        },
        {
          "id": 35,
          "start": 84.39,
          "end": 85.41,
          "en": "And the answer is,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 85.41,
          "end": 87.93,
          "en": "where are we interested in the response?",
          "zh": ""
        },
        {
          "id": 37,
          "start": 87.93,
          "end": 90.39,
          "en": "Are we interested in the header.component?",
          "zh": ""
        },
        {
          "id": 38,
          "start": 90.39,
          "end": 92.22,
          "en": "Well, not really, in my opinion.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 92.22,
          "end": 94.08,
          "en": "What would we do if the Recipes here",
          "zh": ""
        },
        {
          "id": 40,
          "start": 94.08,
          "end": 96.45,
          "en": "were not using the Recipes in the header?",
          "zh": ""
        },
        {
          "id": 41,
          "start": 96.45,
          "end": 99.45,
          "en": "So I'm not really caring about the Recipes here.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 99.45,
          "end": 102.75,
          "en": "And hence, there is no strong reason to subscribe here.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 102.75,
          "end": 105.3,
          "en": "Instead, it would be fine to just subscribe",
          "zh": ""
        },
        {
          "id": 44,
          "start": 105.3,
          "end": 107.03999999999999,
          "en": "in the data-storage.service,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 107.03999999999999,
          "end": 109.41,
          "en": "where we already injected RecipeService.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 109.41,
          "end": 112.2,
          "en": "Because maybe we can do something with the RecipeService",
          "zh": ""
        },
        {
          "id": 47,
          "start": 112.2,
          "end": 116.94,
          "en": "than to push or to move our fetched recipes",
          "zh": ""
        },
        {
          "id": 48,
          "start": 116.94,
          "end": 118.68,
          "en": "into that RecipeService,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 118.68,
          "end": 119.94,
          "en": "which in the end is the place",
          "zh": ""
        },
        {
          "id": 50,
          "start": 119.94,
          "end": 122.16,
          "en": "where we do manage our recipes.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 122.16,
          "end": 124.68,
          "en": "So let's subscribe here.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 124.68,
          "end": 127.86,
          "en": "And we should be getting back our recipes here.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 127.86,
          "end": 130.32,
          "en": "Though, let's first of all, console.log this",
          "zh": ""
        },
        {
          "id": 54,
          "start": 130.32,
          "end": 133.59,
          "en": "to get an idea of the format of data we get.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 133.59,
          "end": 135.51,
          "en": "So we got everything in place.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 135.51,
          "end": 137.07,
          "en": "Let's save that.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 137.07,
          "end": 139.17000000000002,
          "en": "Go back to our application.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 139.17000000000002,
          "end": 140.79,
          "en": "And it's reloaded in the meantime,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 140.79,
          "end": 143.01,
          "en": "which is why the recipes are back here.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 143.01,
          "end": 145.26,
          "en": "Let's click Fetch Data.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 145.26,
          "end": 146.19,
          "en": "That's looking good.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 146.19,
          "end": 147.36,
          "en": "We're getting an array,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 147.36,
          "end": 149.1,
          "en": "note the square brackets.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 149.1,
          "end": 151.07999999999998,
          "en": "We're getting an array of Recipes.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 151.07999999999998,
          "end": 153.96,
          "en": "So since these recipes already have the right format,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 153.96,
          "end": 157.82999999999998,
          "en": "we should be able to just set our currently loaded recipes",
          "zh": ""
        },
        {
          "id": 67,
          "start": 157.82999999999998,
          "end": 159.99,
          "en": "equal to these ones to overwrite them",
          "zh": ""
        },
        {
          "id": 68,
          "start": 159.99,
          "end": 162,
          "en": "with the fetched recipes.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 162,
          "end": 163.98,
          "en": "And for that, in the recipe.service,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 163.98,
          "end": 166.02,
          "en": "we now just need a method that allows us",
          "zh": ""
        },
        {
          "id": 71,
          "start": 166.02,
          "end": 168.99,
          "en": "to overwrite the existing array of recipes.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 168.99,
          "end": 171.6,
          "en": "Because we have that starting array of recipes,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 171.6,
          "end": 175.44,
          "en": "and we have a function to get the recipes,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 175.44,
          "end": 177.93,
          "en": "which means return them from the recipe component",
          "zh": ""
        },
        {
          "id": 75,
          "start": 177.93,
          "end": 179.97,
          "en": "from the RecipeService to another component,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 179.97,
          "end": 182.25,
          "en": "and then we have the same for a single recipe, and so on,",
          "zh": ""
        },
        {
          "id": 77,
          "start": 182.25,
          "end": 185.01,
          "en": "but we have no method to overwrite",
          "zh": ""
        },
        {
          "id": 78,
          "start": 185.01,
          "end": 186.9,
          "en": "that array of recipes here.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 186.9,
          "end": 188.85,
          "en": "And it's time to do so now.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 188.85,
          "end": 191.25,
          "en": "So let's add a new method in the recipe.service,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 191.25,
          "end": 192.7,
          "en": "which we can call setRecipes.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 193.98,
          "end": 198.12,
          "en": "And there, we should get an array of recipes,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 198.12,
          "end": 201.32999999999998,
          "en": "so let's make it really clear by adding that type.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 201.32999999999998,
          "end": 203.19,
          "en": "And the idea here is simple.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 203.19,
          "end": 205.98,
          "en": "This recipes should be set equal",
          "zh": ""
        },
        {
          "id": 86,
          "start": 205.98,
          "end": 208.74,
          "en": "to the recipes we're getting as an argument here.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 208.74,
          "end": 211.68,
          "en": "And this will overwrite our recipes here",
          "zh": ""
        },
        {
          "id": 88,
          "start": 211.68,
          "end": 214.05,
          "en": "with, well, these recipes.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 214.05,
          "end": 215.97,
          "en": "The important thing here just is,",
          "zh": ""
        },
        {
          "id": 90,
          "start": 215.97,
          "end": 217.77,
          "en": "since we're changing the recipes,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 217.77,
          "end": 222.77,
          "en": "we should then also call this.recipesChanged.next,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 222.9,
          "end": 227.9,
          "en": "and push a copy with the slice method of our recipes there,",
          "zh": ""
        },
        {
          "id": 93,
          "start": 228.12,
          "end": 231.27,
          "en": "so that we inform all interested places in our app",
          "zh": ""
        },
        {
          "id": 94,
          "start": 231.27,
          "end": 233.19,
          "en": "that we got new recipes.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 233.19,
          "end": 235.5,
          "en": "Just as we're doing it when we're updating a recipe",
          "zh": ""
        },
        {
          "id": 96,
          "start": 235.5,
          "end": 236.763,
          "en": "or deleting a recipe.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 237.9,
          "end": 240.75,
          "en": "So with that, we're setting the recipes equal.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 240.75,
          "end": 243.06,
          "en": "Now in the data-storage.service,",
          "zh": ""
        },
        {
          "id": 99,
          "start": 243.06,
          "end": 244.98,
          "en": "instead of logging the recipes,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 244.98,
          "end": 247.47,
          "en": "we can use the injected recipeService,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 247.47,
          "end": 251.313,
          "en": "and call setRecipes to forward our recipes there.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 253.29,
          "end": 254.85,
          "en": "Now we're getting an error here",
          "zh": ""
        },
        {
          "id": 103,
          "start": 254.85,
          "end": 257.52,
          "en": "because TypeScript does not understand",
          "zh": ""
        },
        {
          "id": 104,
          "start": 257.52,
          "end": 258.96,
          "en": "that the recipes we're getting here",
          "zh": ""
        },
        {
          "id": 105,
          "start": 258.96,
          "end": 262.53,
          "en": "really are an array of recipes, and that makes sense.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 262.53,
          "end": 265.77,
          "en": "It just understands that here we have the body",
          "zh": ""
        },
        {
          "id": 107,
          "start": 265.77,
          "end": 269.55,
          "en": "of an HTTP response, and that could be anything.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 269.55,
          "end": 273.27,
          "en": "And the effort to inform TypeScript about the type,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 273.27,
          "end": 277.11,
          "en": "we should indeed add the generic annotation",
          "zh": ""
        },
        {
          "id": 110,
          "start": 277.11,
          "end": 278.43,
          "en": "to the get method here,",
          "zh": ""
        },
        {
          "id": 111,
          "start": 278.43,
          "end": 279.63,
          "en": "where we can make clear",
          "zh": ""
        },
        {
          "id": 112,
          "start": 279.63,
          "end": 283.35,
          "en": "which format our extracted response body will have.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 283.35,
          "end": 286.47,
          "en": "And therefore, here I will add Recipe array.",
          "zh": ""
        },
        {
          "id": 114,
          "start": 286.47,
          "end": 288.48,
          "en": "And that now requires me,",
          "zh": ""
        },
        {
          "id": 115,
          "start": 288.48,
          "end": 290.82,
          "en": "or requires us if you're following along,",
          "zh": ""
        },
        {
          "id": 116,
          "start": 290.82,
          "end": 295.82,
          "en": "to import the Recipe model here from the recipes area,",
          "zh": ""
        },
        {
          "id": 117,
          "start": 296.46,
          "end": 299.61,
          "en": "so that we can use that type in the data-storage.service.",
          "zh": ""
        },
        {
          "id": 118,
          "start": 299.61,
          "end": 302.19,
          "en": "And now, TypeScript does not complain anymore.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 302.19,
          "end": 305.31,
          "en": "Because now TypeScript understands that the response body",
          "zh": ""
        },
        {
          "id": 120,
          "start": 305.31,
          "end": 307.59,
          "en": "will indeed be in a array of recipes.",
          "zh": ""
        },
        {
          "id": 121,
          "start": 307.59,
          "end": 310.053,
          "en": "And therefore, we can validly forward this here.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 311.1,
          "end": 312.663,
          "en": "With that out of the way,",
          "zh": ""
        },
        {
          "id": 123,
          "start": 314.7,
          "end": 316.2,
          "en": "let's give this a try.",
          "zh": ""
        },
        {
          "id": 124,
          "start": 316.2,
          "end": 320.25,
          "en": "Let's first of all delete all these recipes here.",
          "zh": ""
        },
        {
          "id": 125,
          "start": 320.25,
          "end": 321.753,
          "en": "And let's now fetch them.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 322.71,
          "end": 323.7,
          "en": "And that's looking good.",
          "zh": ""
        },
        {
          "id": 127,
          "start": 323.7,
          "end": 324.78,
          "en": "Here they are again.",
          "zh": ""
        },
        {
          "id": 128,
          "start": 324.78,
          "end": 328.02,
          "en": "And if we send this to the Shopping List for example,",
          "zh": ""
        },
        {
          "id": 129,
          "start": 328.02,
          "end": 330.06,
          "en": "that all seems to work.",
          "zh": ""
        },
        {
          "id": 130,
          "start": 330.06,
          "end": 332.67,
          "en": "So we can now manage our recipes.",
          "zh": ""
        },
        {
          "id": 131,
          "start": 332.67,
          "end": 336.543,
          "en": "And now, we are indeed storing them on a server.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
