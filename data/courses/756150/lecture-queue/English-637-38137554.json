          "end": 51.423,
          "en": "from ngrx/store.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 52.77,
          "end": 54.96,
          "en": "And then here in increment,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 54.96,
          "end": 58.41,
          "en": "you can use this injected store object",
          "zh": ""
        },
        {
          "id": 21,
          "start": 58.41,
          "end": 61.95,
          "en": "to call the built-in dispatch method.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 61.95,
          "end": 65.31,
          "en": "So before we use select for selecting data,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 65.31,
          "end": 70.31,
          "en": "now we're using dispatch to dispatch an action.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 70.62,
          "end": 73.5,
          "en": "And now, you just need the identifier of the action",
