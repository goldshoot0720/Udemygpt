          "zh": ""
        },
        {
          "id": 4,
          "start": 8.01,
          "end": 9.27,
          "en": "And in this app here,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 9.27,
          "end": 12.123,
          "en": "that happens in the Counter-controls Component.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 12.99,
          "end": 17.01,
          "en": "In there, I have the increment and decrement functions,",
          "zh": ""
        },
        {
          "id": 7,
