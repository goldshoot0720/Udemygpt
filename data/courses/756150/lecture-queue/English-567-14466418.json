{
  "version": 1,
  "courseId": 756150,
  "courseSlug": "the-complete-guide-to-angular-2",
  "courseTitle": "Angular - The Complete Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "14466418",
      "title": "Handling Form Input",
      "lectureOrder": 615,
      "videoOrder": 567,
      "sourceHash": "3493f27783924082feeea354d269a58ce2cd141694cfe85f5c6a05037a0c5d42",
      "cues": [
        {
          "id": 1,
          "start": 2.13,
          "end": 3.36,
          "en": "Instructor: Now handling form input",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.36,
          "end": 4.8,
          "en": "is something you already learned about",
          "zh": ""
        },
        {
          "id": 3,
          "start": 4.8,
          "end": 5.73,
          "en": "throughout this course.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 5.73,
          "end": 8.28,
          "en": "And here I'll use the template driven approach.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 8.28,
          "end": 9.87,
          "en": "But of course feel free to use",
          "zh": ""
        },
        {
          "id": 6,
          "start": 9.87,
          "end": 12.36,
          "en": "the reactive one of you prefer that.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 12.36,
          "end": 13.92,
          "en": "Now we got two inputs.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 13.92,
          "end": 16.08,
          "en": "The first one, this email input",
          "zh": ""
        },
        {
          "id": 9,
          "start": 16.08,
          "end": 19.41,
          "en": "this one will get NG model of course,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 19.41,
          "end": 20.91,
          "en": "and besides NG model",
          "zh": ""
        },
        {
          "id": 11,
          "start": 20.91,
          "end": 22.29,
          "en": "it then also needs a name.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 22.29,
          "end": 23.58,
          "en": "And the name can be emailed",
          "zh": ""
        },
        {
          "id": 13,
          "start": 23.58,
          "end": 26.13,
          "en": "but of course you can take any name you want.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 26.13,
          "end": 29.25,
          "en": "I also want to validate whatever the user enters here.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 29.25,
          "end": 32.79,
          "en": "So I will add required because this must not be empty.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 32.79,
          "end": 35.13,
          "en": "And also the email validator.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 35.13,
          "end": 37.65,
          "en": "These are both built in validation directives",
          "zh": ""
        },
        {
          "id": 18,
          "start": 37.65,
          "end": 38.88,
          "en": "Angular ships with,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 38.88,
          "end": 40.95,
          "en": "which allow us to validate the input",
          "zh": ""
        },
        {
          "id": 20,
          "start": 40.95,
          "end": 44.43,
          "en": "for being there, for being any input at all,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 44.43,
          "end": 46.623,
          "en": "and for being a valid email address.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 47.683,
          "end": 51.15,
          "en": "Now the password will also receive ng model",
          "zh": ""
        },
        {
          "id": 23,
          "start": 51.15,
          "end": 53.16,
          "en": "and a name which could be password.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 53.16,
          "end": 55.14,
          "en": "Again, that name is up to you.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 55.14,
          "end": 57.69,
          "en": "And here that should also be required.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 57.69,
          "end": 60.12,
          "en": "And I also want to have a minimum length here",
          "zh": ""
        },
        {
          "id": 27,
          "start": 60.12,
          "end": 63.42,
          "en": "because we will use Firebase REST API for authenticating.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 63.42,
          "end": 65.46,
          "en": "And it turns out that this REST API",
          "zh": ""
        },
        {
          "id": 29,
          "start": 65.46,
          "end": 68.28,
          "en": "indeed requests us to have at least six characters.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 68.28,
          "end": 72.56700000000001,
          "en": "So here we cans add the min length validator",
          "zh": ""
        },
        {
          "id": 31,
          "start": 72.56700000000001,
          "end": 74.52,
          "en": "and give this a value of six,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 74.52,
          "end": 78.453,
          "en": "so that passwords shorter than six will not be accepted.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 80.03999999999999,
          "end": 83.16,
          "en": "Now I want to disable the button if the form is not valid,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 83.16,
          "end": 85.8,
          "en": "and therefore on this form element",
          "zh": ""
        },
        {
          "id": 35,
          "start": 85.8,
          "end": 87.87,
          "en": "we'll use that trick you already learned about",
          "zh": ""
        },
        {
          "id": 36,
          "start": 87.87,
          "end": 89.25,
          "en": "in the forms section.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 89.25,
          "end": 91.71000000000001,
          "en": "We get access to that form object",
          "zh": ""
        },
        {
          "id": 38,
          "start": 91.71000000000001,
          "end": 94.14,
          "en": "Angular creates automatically for us",
          "zh": ""
        },
        {
          "id": 39,
          "start": 94.14,
          "end": 96.27000000000001,
          "en": "by creating a local reference,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 96.27000000000001,
          "end": 97.47,
          "en": "giving it any name you want,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 97.47,
          "end": 100.28999999999999,
          "en": "like auth form, but that name is up to you.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 100.28999999999999,
          "end": 102.53999999999999,
          "en": "And then you set this equal to ng form.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 102.53999999999999,
          "end": 103.92,
          "en": "And now this will give you access",
          "zh": ""
        },
        {
          "id": 44,
          "start": 103.92,
          "end": 105.81,
          "en": "to the Angular form object.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 105.81,
          "end": 108.47999999999999,
          "en": "And we can now use the auth form reference here,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 108.47999999999999,
          "end": 111.47999999999999,
          "en": "for example on this button to disable it,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 111.47999999999999,
          "end": 116.31,
          "en": "if not auth form valid.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 116.31,
          "end": 118.08,
          "en": "So if the auth form is not valid,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 118.08,
          "end": 120.81,
          "en": "then the submit button will be disabled.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 120.81,
          "end": 123.15,
          "en": "And indeed now you see it is disabled.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 123.15,
          "end": 126.21,
          "en": "And if I enter a email address here, it still is disabled.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 126.21,
          "end": 129.03,
          "en": "If I start typing a password, it is disabled.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 129.03,
          "end": 132.18,
          "en": "And only as soon as I have six characters it gets enabled.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 132.18,
          "end": 133.89,
          "en": "If I convert this to something",
          "zh": ""
        },
        {
          "id": 55,
          "start": 133.89,
          "end": 136.78,
          "en": "which is not a valid email address",
          "zh": ""
        },
        {
          "id": 56,
          "start": 138.6,
          "end": 140.28300000000002,
          "en": "it also gets disabled.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 141.96,
          "end": 143.46,
          "en": "So this works.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 143.46,
          "end": 145.41,
          "en": "We got working validation.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 145.41,
          "end": 148.07999999999998,
          "en": "Now of course when we submit the form,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 148.07999999999998,
          "end": 149.94,
          "en": "we also want to do something.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 149.94,
          "end": 153.96,
          "en": "So here on the form element, as you already learned it",
          "zh": ""
        },
        {
          "id": 62,
          "start": 153.96,
          "end": 157.65,
          "en": "in the form section, we can add ng submit,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 157.65,
          "end": 161.37,
          "en": "and there we can trigger the on submit method",
          "zh": ""
        },
        {
          "id": 64,
          "start": 161.37,
          "end": 163.82999999999998,
          "en": "and forward our off form,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 163.82999999999998,
          "end": 166.11,
          "en": "or just the off form value.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 166.11,
          "end": 167.16,
          "en": "Whatever you want.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 167.16,
          "end": 169.62,
          "en": "I will submit the entire form.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 169.62,
          "end": 173.994,
          "en": "Now in the off component we therefore can add",
          "zh": ""
        },
        {
          "id": 69,
          "start": 173.994,
          "end": 178.994,
          "en": "on submit here and we'll get our form object here,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 180.48,
          "end": 183.36,
          "en": "which is I'll type ng form as an argument.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 183.36,
          "end": 185.94,
          "en": "And therefore you need to import ng form",
          "zh": ""
        },
        {
          "id": 72,
          "start": 185.94,
          "end": 188.4,
          "en": "from @ Angular forms.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 188.4,
          "end": 190.2,
          "en": "And now here we can of course,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 190.2,
          "end": 193.59,
          "en": "for example, console lock the form value.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 193.59,
          "end": 198.59,
          "en": "And all the call form reset to reset it once we're done.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 198.63,
          "end": 199.71,
          "en": "So let's give this a try.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 199.71,
          "end": 201.09,
          "en": "Let's go back here.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 201.09,
          "end": 204.281,
          "en": "Let me enter a email address and a password.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 204.281,
          "end": 206.94,
          "en": "And you see the form was reset correctly.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 206.94,
          "end": 209.88,
          "en": "It was disabled again, this button was disabled again.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 209.88,
          "end": 211.98,
          "en": "And you also see this is the data I got.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 211.98,
          "end": 213.27,
          "en": "This is the data I entered.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 213.27,
          "end": 216.66,
          "en": "This is now the data we'll use to actually use Firebase",
          "zh": ""
        },
        {
          "id": 84,
          "start": 216.66,
          "end": 219.36,
          "en": "to for a start, create a new user",
          "zh": ""
        },
        {
          "id": 85,
          "start": 219.36,
          "end": 221.853,
          "en": "and then to also of course log users in.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
