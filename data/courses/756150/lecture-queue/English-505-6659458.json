        },
        {
          "id": 16,
          "start": 43.32,
          "end": 45.93,
          "en": "That is basically almost all.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 45.93,
          "end": 50.93,
          "en": "We also need to make sure that we call this onClear",
          "zh": ""
        },
        {
          "id": 18,
          "start": 51.06,
          "end": 53.28,
          "en": "because we definitely also want to clear the form",
          "zh": ""
        },
        {
          "id": 19,
          "start": 53.28,
          "end": 56.04,
          "en": "if we delete the item which was loaded.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 56.04,
          "end": 57.39,
          "en": "Now, in a shopping list service,",
          "zh": ""
        },
        {
          "id": 21,
