        },
        {
          "id": 36,
          "start": 102.47999999999999,
          "end": 107.31,
          "en": "call delete ingredient, and simply pass",
          "zh": ""
        },
        {
          "id": 37,
          "start": 107.31,
          "end": 110.283,
          "en": "the edited item index as a value.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 111.21000000000001,
          "end": 114.36,
          "en": "Now this will throw an error if we click delete",
