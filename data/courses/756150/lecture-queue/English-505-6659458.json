        },
        {
          "id": 24,
          "start": 69.81,
          "end": 72.24,
          "en": "and splice one of the elements.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 72.24,
          "end": 75.39,
          "en": "Splice allows us to start at a specific point,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 75.39,
          "end": 77.19,
          "en": "for example, at the index here,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 77.19,
          "end": 81.09,
          "en": "and then splice one element, thus removing it.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 81.09,
          "end": 82.53,
          "en": "And then, of course, as always,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 82.53,
          "end": 84.72,
          "en": "we should call ingredients changed.",
