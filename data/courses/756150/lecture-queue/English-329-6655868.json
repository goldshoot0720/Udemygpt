      "sourceHash": "66e1a0e795d27961fcff2a997de00a714cf081b1ae045ba94d09a4c3e661926d",
      "cues": [
        {
          "id": 1,
          "start": 3,
          "end": 3.87,
          "en": "-: In the last lectures",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.87,
          "end": 5.37,
          "en": "we learned a lot about event binding",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.37,
          "end": 6.81,
          "en": "and property binding.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 6.81,
          "end": 10.476,
          "en": "Now let's combine both, to two-way binding.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.476,
          "end": 13.71,
          "en": "We learned that we can get the event data",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.71,
          "end": 15.72,
          "en": "like this, for example.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 15.72,
          "end": 18.3,
          "en": "There is another approach too, though.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 18.3,
          "end": 20.34,
          "en": "If I copy this and then comment it",
          "zh": ""
        },
        {
          "id": 9,
          "start": 20.34,
          "end": 23.553,
          "en": "out and now I replace this input event",
          "zh": ""
        },
        {
          "id": 10,
          "start": 23.553,
          "end": 26.1,
          "en": "here with something else, you'll find",
          "zh": ""
        },
        {
          "id": 11,
          "start": 26.1,
          "end": 28.89,
          "en": "that we have an even easier way of binding",
          "zh": ""
        },
        {
          "id": 12,
          "start": 28.89,
          "end": 30.36,
          "en": "to some data.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 30.36,
          "end": 32.16,
          "en": "With two-way data binding,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 32.16,
          "end": 35.16,
          "en": "we combine property and event binding.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 35.16,
          "end": 37.8,
          "en": "We use it therefore by combining the syntaxes,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 37.8,
          "end": 42.42,
          "en": "square brackets, and within these parentheses.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 42.42,
          "end": 45.45,
          "en": "Now here we have to use a special directive,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 45.45,
          "end": 46.35,
          "en": "and we will learn more",
          "zh": ""
        },
        {
          "id": 19,
          "start": 46.35,
          "end": 50.01,
          "en": "about directives in a second NG model.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 50.01,
          "end": 51.45,
          "en": "Now we can set this equal",
          "zh": ""
        },
        {
          "id": 21,
          "start": 51.45,
          "end": 54.24,
          "en": "to some property defined in our TypeScript code.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 54.24,
          "end": 56.85,
          "en": "So to the server name for example.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 56.85,
          "end": 58.98,
          "en": "This setup will do the following.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 58.98,
          "end": 61.56,
          "en": "It will trigger on the input event",
          "zh": ""
        },
        {
          "id": 25,
          "start": 61.56,
          "end": 63.8,
          "en": "and update the value of server name",
          "zh": ""
        },
        {
          "id": 26,
          "start": 63.8,
          "end": 67.113,
          "en": "in our component automatically.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 67.95,
          "end": 70.98,
          "en": "On the other hand, since it is two-way binding",
          "zh": ""
        },
        {
          "id": 28,
          "start": 70.98,
          "end": 73.28999999999999,
          "en": "it will also update the value",
          "zh": ""
        },
        {
          "id": 29,
          "start": 73.28999999999999,
          "end": 75,
          "en": "of the input element",
          "zh": ""
        },
        {
          "id": 30,
          "start": 75,
          "end": 77.37,
          "en": "if we change server name somewhere else.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 77.37,
          "end": 79.413,
          "en": "And I can demonstrate this,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 80.43,
          "end": 82.53,
          "en": "by going back to the TypeScript code",
          "zh": ""
        },
        {
          "id": 33,
          "start": 82.53,
          "end": 84.78,
          "en": "and setting server name to",
          "zh": ""
        },
        {
          "id": 34,
          "start": 84.78,
          "end": 87.15,
          "en": "test server here initially.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 87.15,
          "end": 89.01,
          "en": "So before it was an empty string,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 89.01,
          "end": 90.93,
          "en": "now it isn't anymore.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 90.93,
          "end": 92.28,
          "en": "With this, if we go back to the",
          "zh": ""
        },
        {
          "id": 38,
          "start": 92.28,
          "end": 95.13,
          "en": "running application you see that the input",
          "zh": ""
        },
        {
          "id": 39,
          "start": 95.13,
          "end": 97.92,
          "en": "is pre-populated with that.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 97.92,
          "end": 100.95,
          "en": "Now, if for demo purposes, I comment",
          "zh": ""
        },
        {
          "id": 41,
          "start": 100.95,
          "end": 102.84,
          "en": "in the other input",
          "zh": ""
        },
        {
          "id": 42,
          "start": 102.84,
          "end": 105.47999999999999,
          "en": "which does not use two-way binding.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 105.47999999999999,
          "end": 107.97,
          "en": "You see that this input is empty because again",
          "zh": ""
        },
        {
          "id": 44,
          "start": 107.97,
          "end": 109.8,
          "en": "it's not using two-way binding.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 109.8,
          "end": 112.83,
          "en": "Now if I type something here,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 112.83,
          "end": 115.74000000000001,
          "en": "you see it updates the property name",
          "zh": ""
        },
        {
          "id": 47,
          "start": 115.74000000000001,
          "end": 117.50999999999999,
          "en": "and hence it updates it there",
          "zh": ""
        },
        {
          "id": 48,
          "start": 117.50999999999999,
          "end": 119.19,
          "en": "where we use string intrapopulation,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 119.19,
          "end": 121.08,
          "en": "and in the other input.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 121.08,
          "end": 123.03,
          "en": "But if I type here,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 123.03,
          "end": 124.92,
          "en": "it's not getting changed in the first",
          "zh": ""
        },
        {
          "id": 52,
          "start": 124.92,
          "end": 126.78,
          "en": "input because again we're not using",
          "zh": ""
        },
        {
          "id": 53,
          "start": 126.78,
          "end": 128.37,
          "en": "two-way binding there.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 128.37,
          "end": 130.68,
          "en": "This is what two-way data binding is,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 130.68,
          "end": 132.72,
          "en": "a very simple way of binding",
          "zh": ""
        },
        {
          "id": 56,
          "start": 132.72,
          "end": 135.45,
          "en": "in both directions and for example,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 135.45,
          "end": 138.99,
          "en": "of reacting to changes in,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 138.99,
          "end": 141.42000000000002,
          "en": "well the input value here.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 141.42000000000002,
          "end": 143.64,
          "en": "So I will comment out the first approach.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 143.64,
          "end": 146.07,
          "en": "I will leave the method injury though",
          "zh": ""
        },
        {
          "id": 61,
          "start": 146.07,
          "end": 148.02,
          "en": "even though we're not calling it anymore.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 148.02,
          "end": 149.1,
          "en": "But with that,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 149.1,
          "end": 151.17000000000002,
          "en": "you now also had a look at two-way binding",
          "zh": ""
        },
        {
          "id": 64,
          "start": 151.17000000000002,
          "end": 152.64,
          "en": "a nice and easy way",
          "zh": ""
        },
        {
          "id": 65,
          "start": 152.64,
          "end": 156.32999999999998,
          "en": "of reacting to events in both directions.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 156.32999999999998,
          "end": 158.76,
          "en": "Now let's fine tune our app here a little",
          "zh": ""
        },
        {
          "id": 67,
          "start": 158.76,
          "end": 162.75,
          "en": "bit more and let's then move on to directives.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 162.75,
          "end": 165.453,
          "en": "Another core feature of angular.",
          "zh": ""
        }
      ]
    }
  ],
