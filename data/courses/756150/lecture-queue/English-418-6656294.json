  "lectures": [
    {
      "id": "6656294",
      "title": "Using Relative Paths in Programmatic Navigation",
      "lectureOrder": 456,
      "videoOrder": 418,
      "sourceHash": "90739bf634a74de360c569d24a291c03b7ea35d33a8bbbd7839b4348b91c7466",
      "cues": [
        {
          "id": 1,
          "start": 2.64,
          "end": 3.6,
          "en": "-: In the last lecture,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.6,
          "end": 6.54,
          "en": "we learned how to navigate programmatically.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.54,
          "end": 8.237,
          "en": "Now I want to also have a look",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.237,
          "end": 11.22,
          "en": "at how we can use relative pops there.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.22,
          "end": 13.526,
          "en": "So back in our servers component,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.526,
          "end": 16.5,
          "en": "let's say we have again our reload page link",
          "zh": ""
        },
        {
          "id": 7,
          "start": 16.5,
          "end": 17.94,
          "en": "but this time it's a button here",
          "zh": ""
        },
        {
          "id": 8,
          "start": 17.94,
          "end": 19.8,
          "en": "with button, button primary.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 19.8,
          "end": 21.66,
          "en": "And still we might use this approach",
          "zh": ""
        },
        {
          "id": 10,
          "start": 21.66,
          "end": 24.15,
          "en": "because we want to do some different things.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 24.15,
          "end": 26.13,
          "en": "So reload page",
          "zh": ""
        },
        {
          "id": 12,
          "start": 26.13,
          "end": 30.723,
          "en": "and here I will have my click listener on reload maybe.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 31.62,
          "end": 34.62,
          "en": "So if we now go to our TypeScript code,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 34.62,
          "end": 38.52,
          "en": "here on reload, we'll simply",
          "zh": ""
        },
        {
          "id": 15,
          "start": 38.52,
          "end": 40.77,
          "en": "or will be the method which gets triggered",
          "zh": ""
        },
        {
          "id": 16,
          "start": 40.77,
          "end": 44.04,
          "en": "and we already injected this servers service here.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 44.04,
          "end": 47.01,
          "en": "I also want to inject the router.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 47.01,
          "end": 49.68,
          "en": "So let's add router here.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 49.68,
          "end": 54.333,
          "en": "Make sure to add the import from @angular router.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 55.38,
          "end": 59.605,
          "en": "So we learned that now we could say this router navigate",
          "zh": ""
        },
        {
          "id": 21,
          "start": 59.605,
          "end": 63.81,
          "en": "and now let's add slash servers here.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 63.81,
          "end": 67.08,
          "en": "If we do this and we save this page",
          "zh": ""
        },
        {
          "id": 23,
          "start": 67.08,
          "end": 69.472,
          "en": "and we go to the service page and click reload,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 69.472,
          "end": 71.73,
          "en": "nothing happens, we don't get an error",
          "zh": ""
        },
        {
          "id": 25,
          "start": 71.73,
          "end": 73.68,
          "en": "because we are already on this page.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 73.68,
          "end": 75.87,
          "en": "Technically it still reloads the page",
          "zh": ""
        },
        {
          "id": 27,
          "start": 75.87,
          "end": 77.91,
          "en": "but keep in mind it never sends a request.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 77.91,
          "end": 80.55,
          "en": "So this reload icon will never spin",
          "zh": ""
        },
        {
          "id": 29,
          "start": 80.55,
          "end": 83.49,
          "en": "but Angular simply determined that we are on this page.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 83.49,
          "end": 86.03999999999999,
          "en": "So no further action is needed.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 86.03999999999999,
          "end": 88.71000000000001,
          "en": "Now let's say we remove the slash at the beginning.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 88.71000000000001,
          "end": 91.14,
          "en": "So we turn this into a relative path",
          "zh": ""
        },
        {
          "id": 33,
          "start": 91.14,
          "end": 93.18,
          "en": "and we still are on the servers component.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 93.18,
          "end": 94.44,
          "en": "Keep this in mind.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 94.44,
          "end": 97.71000000000001,
          "en": "So now if this reloaded and we click this page,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 97.71000000000001,
          "end": 99.57,
          "en": "we still don't get an error.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 99.57,
          "end": 100.95,
          "en": "And now this might be strange",
          "zh": ""
        },
        {
          "id": 38,
          "start": 100.95,
          "end": 104.7,
          "en": "because before when we use the router link,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 104.7,
          "end": 106.83,
          "en": "you saw that we did get an error",
          "zh": ""
        },
        {
          "id": 40,
          "start": 106.83,
          "end": 110.88,
          "en": "because it would try to add servers to the end of this path.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 110.88,
          "end": 113.58,
          "en": "And of course this route now doesn't exist.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 113.58,
          "end": 117.783,
          "en": "So why does it work fine if we use the navigate method?",
          "zh": ""
        },
        {
          "id": 43,
          "start": 119.49000000000001,
          "end": 121.53,
          "en": "Because unlike the router link,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 121.53,
          "end": 124.08,
          "en": "the navigate method doesn't know",
          "zh": ""
        },
        {
          "id": 45,
          "start": 124.08,
          "end": 127.2,
          "en": "on which route you're currently on, so to say.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 127.2,
          "end": 129.6,
          "en": "The router link always knows",
          "zh": ""
        },
        {
          "id": 47,
          "start": 129.6,
          "end": 131.19,
          "en": "in which component it sits,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 131.19,
          "end": 133.02,
          "en": "in which component's template",
          "zh": ""
        },
        {
          "id": 49,
          "start": 133.02,
          "end": 135.99,
          "en": "and therefore it knows what the currently loaded route is.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 135.99,
          "end": 139.07999999999998,
          "en": "Now you could argue that here we also the call this inside",
          "zh": ""
        },
        {
          "id": 51,
          "start": 139.07999999999998,
          "end": 140.82,
          "en": "of the component Typescript code.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 140.82,
          "end": 143.04,
          "en": "So it could determine where it is in,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 143.04,
          "end": 145.44,
          "en": "but it's just not how it works.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 145.44,
          "end": 149.16,
          "en": "So to tell this where we currently are in,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 149.16,
          "end": 153.24,
          "en": "we have to pass a second argument to the navigate method",
          "zh": ""
        },
        {
          "id": 56,
          "start": 153.24,
          "end": 154.92000000000002,
          "en": "which is a JavaScript object.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 154.92000000000002,
          "end": 159.36,
          "en": "And here we can configure this navigation action.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 159.36,
          "end": 161.22,
          "en": "Now, I will come back to this later",
          "zh": ""
        },
        {
          "id": 59,
          "start": 161.22,
          "end": 163.47,
          "en": "because there are more things we can add,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 163.47,
          "end": 168.47,
          "en": "but one configuration is the relative to property here.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 169.29,
          "end": 172.62,
          "en": "Here we define relative to which route,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 172.62,
          "end": 174.03,
          "en": "this link should be loaded",
          "zh": ""
        },
        {
          "id": 63,
          "start": 174.03,
          "end": 176.49,
          "en": "and by default this is always the root domain",
          "zh": ""
        },
        {
          "id": 64,
          "start": 176.49,
          "end": 178.05,
          "en": "which is why we didn't get an error",
          "zh": ""
        },
        {
          "id": 65,
          "start": 178.05,
          "end": 180.063,
          "en": "for this servers path.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 181.02,
          "end": 183.54,
          "en": "Here we have to give a route though,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 183.54,
          "end": 186,
          "en": "so we don't pass a string here.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 186,
          "end": 189.99,
          "en": "Instead, the route is something we can inject here too.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 189.99,
          "end": 192.24,
          "en": "We can get the currently active route",
          "zh": ""
        },
        {
          "id": 70,
          "start": 192.24,
          "end": 196.77,
          "en": "by injecting route which is of type activated route.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 196.77,
          "end": 200.25,
          "en": "And make sure to import activated route",
          "zh": ""
        },
        {
          "id": 72,
          "start": 200.25,
          "end": 203.37,
          "en": "from the @angler router package too.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 203.37,
          "end": 205.59,
          "en": "Now, activated route, like the name applies,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 205.59,
          "end": 208.92000000000002,
          "en": "simply injects the currently active route.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 208.92000000000002,
          "end": 210.63,
          "en": "So for the component you loaded,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 210.63,
          "end": 213.12,
          "en": "this will be the route which loaded this component.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 213.12,
          "end": 214.5,
          "en": "And the route simply is kind",
          "zh": ""
        },
        {
          "id": 78,
          "start": 214.5,
          "end": 216.72,
          "en": "of a complex JavaScript object,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 216.72,
          "end": 218.73,
          "en": "which keeps a lot of meta information",
          "zh": ""
        },
        {
          "id": 80,
          "start": 218.73,
          "end": 220.766,
          "en": "about the currently active route.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 220.766,
          "end": 223.23,
          "en": "Now we can set this as a value.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 223.23,
          "end": 226.2,
          "en": "So this route, this injected route",
          "zh": ""
        },
        {
          "id": 83,
          "start": 226.2,
          "end": 228.39,
          "en": "for the relative to property.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 228.39,
          "end": 231.423,
          "en": "And now with that extra piece of information,",
          "zh": ""
        },
        {
          "id": 85,
          "start": 231.423,
          "end": 235.95,
          "en": "angular knows what our currently active route is.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 235.95,
          "end": 237.84,
          "en": "And theoretically, you could also set this",
          "zh": ""
        },
        {
          "id": 87,
          "start": 237.84,
          "end": 241.95,
          "en": "to some other route which you would have to get by some way.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 241.95,
          "end": 243.66,
          "en": "So here we are telling it,",
          "zh": ""
        },
        {
          "id": 89,
          "start": 243.66,
          "end": 246.24,
          "en": "now, our currently active route is this activated route.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 246.24,
          "end": 249.45,
          "en": "So relative to this route, you should navigate",
          "zh": ""
        },
        {
          "id": 91,
          "start": 249.45,
          "end": 253.26,
          "en": "and then it will simply resolve all the relative",
          "zh": ""
        },
        {
          "id": 92,
          "start": 253.26,
          "end": 257.13,
          "en": "paths you might have here relative to this route.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 257.13,
          "end": 259.62,
          "en": "So if this changes in place,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 259.62,
          "end": 262.23,
          "en": "we now click this button again.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 262.23,
          "end": 263.7,
          "en": "Now we broke the app",
          "zh": ""
        },
        {
          "id": 96,
          "start": 263.7,
          "end": 267.72,
          "en": "because now it again tries to find servers slash servers",
          "zh": ""
        },
        {
          "id": 97,
          "start": 267.72,
          "end": 269.16,
          "en": "which doesn't exist.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 269.16,
          "end": 270.78,
          "en": "So great, we broke the app.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 270.78,
          "end": 272.07,
          "en": "But with that,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 272.07,
          "end": 274.32,
          "en": "you should understand how you can work",
          "zh": ""
        },
        {
          "id": 101,
          "start": 274.32,
          "end": 276.84000000000003,
          "en": "with relative paths in the navigate method,",
          "zh": ""
        },
        {
          "id": 102,
          "start": 276.84000000000003,
          "end": 280.47,
          "en": "you define relative to what this path should be loaded",
          "zh": ""
        },
        {
          "id": 103,
          "start": 280.47,
          "end": 282.33,
          "en": "the defaults to route URL,",
          "zh": ""
        },
        {
          "id": 104,
          "start": 282.33,
          "end": 284.55,
          "en": "that might be the behavior you're looking for.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 284.55,
          "end": 287.04,
          "en": "It might not be the behavior you're looking for.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 287.04,
          "end": 290.49,
          "en": "You can change it with this extra JavaScript object.",
          "zh": ""
        },
        {
          "id": 107,
          "start": 290.49,
          "end": 292.8,
          "en": "Second argument to the navigate method",
          "zh": ""
        },
        {
          "id": 108,
          "start": 292.8,
          "end": 294.81,
          "en": "where you have the relative to property,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 294.81,
          "end": 298.29,
          "en": "you can set to the route you want to navigate relative to.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 298.29,
          "end": 301.53,
          "en": "For now, I will simply comment this out",
          "zh": ""
        },
        {
          "id": 111,
          "start": 301.53,
          "end": 303.69,
          "en": "to disable this not working button",
          "zh": ""
        },
        {
          "id": 112,
          "start": 303.69,
          "end": 305.22,
          "en": "and still keep the code.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 305.22,
          "end": 307.413,
          "en": "In this example project.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
