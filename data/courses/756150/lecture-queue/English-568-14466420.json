  "lectures": [
    {
      "id": "14466420",
      "title": "Preparing the Backend",
      "lectureOrder": 616,
      "videoOrder": 568,
      "sourceHash": "2450bdd9a9d4373434a0e07e9847e0e43edb8178d6f17b518c6bb8ded5b93e0a",
      "cues": [
        {
          "id": 1,
          "start": 2.31,
          "end": 4.53,
          "en": "Instructor: I'm back in my Firebase project,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.53,
          "end": 7.95,
          "en": "and as with the normal HTTP requests,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.95,
          "end": 10.11,
          "en": "I really want to emphasize that you, of course,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.11,
          "end": 13.02,
          "en": "don't need Firebase to add authentication",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.02,
          "end": 14.79,
          "en": "to an Angular application.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.79,
          "end": 17.19,
          "en": "You can add it with any backend,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.19,
          "end": 19.86,
          "en": "be that a REST or a GraphQL API.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 19.86,
          "end": 22.59,
          "en": "Your backend just needs to offer endpoints",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.59,
          "end": 24.66,
          "en": "you can use to create new users",
          "zh": ""
        },
        {
          "id": 10,
          "start": 24.66,
          "end": 28.14,
          "en": "and to log users in to get such a token therefore.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 28.14,
          "end": 31.41,
          "en": "If your API supports that, and most APIs do,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 31.41,
          "end": 32.73,
          "en": "and if you're creating your own API,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 32.73,
          "end": 35.28,
          "en": "you can of course add your own auth logic,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 35.28,
          "end": 36.69,
          "en": "then you can use that API.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 36.69,
          "end": 37.98,
          "en": "You don't need Firebase",
          "zh": ""
        },
        {
          "id": 16,
          "start": 37.98,
          "end": 40.89,
          "en": "I'm just using it because it's easy, free to use,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 40.89,
          "end": 43.05,
          "en": "doesn't require us to write server side code.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 43.05,
          "end": 44.85,
          "en": "That's the only reason.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 44.85,
          "end": 49.8,
          "en": "And with that, let's go to the authentication page here.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 49.8,
          "end": 53.46,
          "en": "And there, we now have to set up a sign in method.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 53.46,
          "end": 54.72,
          "en": "Well, actually, before we do that",
          "zh": ""
        },
        {
          "id": 22,
          "start": 54.72,
          "end": 56.88,
          "en": "let's go to the database again.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 56.88,
          "end": 59.79,
          "en": "And there let's go to rules.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 59.79,
          "end": 64.41,
          "en": "And under rules, previously, we unlocked this",
          "zh": ""
        },
        {
          "id": 25,
          "start": 64.41,
          "end": 67.2,
          "en": "by setting read and write access to true for everyone.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 67.2,
          "end": 70.95,
          "en": "And this means that everyone can read our recipes,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 70.95,
          "end": 72.69,
          "en": "get our recipes, and store recipes.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 72.69,
          "end": 75.24,
          "en": "Everyone can interact with our database here.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 75.24,
          "end": 76.98,
          "en": "Now this was required in the past",
          "zh": ""
        },
        {
          "id": 30,
          "start": 76.98,
          "end": 79.47,
          "en": "because we had no authentication in place.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 79.47,
          "end": 81.33,
          "en": "Since this is about to change now,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 81.33,
          "end": 83.49,
          "en": "it's about to change these settings,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 83.49,
          "end": 86.02799999999999,
          "en": "and therefore you should now change this",
          "zh": ""
        },
        {
          "id": 34,
          "start": 86.02799999999999,
          "end": 90.27,
          "en": "to auth unequal null here for both read and write.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 90.27,
          "end": 93.24000000000001,
          "en": "This will tell Firebase that only authenticated users",
          "zh": ""
        },
        {
          "id": 36,
          "start": 93.24000000000001,
          "end": 95.75999999999999,
          "en": "should be able to read and write data.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 95.75999999999999,
          "end": 98.91,
          "en": "Now, of course, if you were using Firebase for your project,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 98.91,
          "end": 100.92,
          "en": "you can set up more sophisticated rules",
          "zh": ""
        },
        {
          "id": 39,
          "start": 100.92,
          "end": 102.42,
          "en": "for different resources.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 102.42,
          "end": 105.3,
          "en": "And the official Firebase docs are then the way to go.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 105.3,
          "end": 107.31,
          "en": "Here, I wanna lock down everything,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 107.31,
          "end": 109.11,
          "en": "my entire Firebase database,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 109.11,
          "end": 111.333,
          "en": "if users are not authenticated.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 113.07,
          "end": 115.74000000000001,
          "en": "Publish these rules to make sure they have an effect.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 115.74000000000001,
          "end": 118.71000000000001,
          "en": "And what you will already notice now with these changes",
          "zh": ""
        },
        {
          "id": 46,
          "start": 118.71000000000001,
          "end": 122.55,
          "en": "that if you go to recipes and you fetch data,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 122.55,
          "end": 123.75,
          "en": "you get an error here,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 123.75,
          "end": 126.78,
          "en": "a 401 error that you're not authorized.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 126.78,
          "end": 130.27,
          "en": "Now, of course, we could handle that error in a better way",
          "zh": ""
        },
        {
          "id": 50,
          "start": 130.27,
          "end": 131.31,
          "en": "by displaying a nice error message here",
          "zh": ""
        },
        {
          "id": 51,
          "start": 131.31,
          "end": 132.66,
          "en": "or anything like that.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 132.66,
          "end": 134.76,
          "en": "But we won't even reach that page soon",
          "zh": ""
        },
        {
          "id": 53,
          "start": 134.76,
          "end": 138.27,
          "en": "because we will lock down access to it in our front end",
          "zh": ""
        },
        {
          "id": 54,
          "start": 138.27,
          "end": 140.16,
          "en": "to provide a good user experience",
          "zh": ""
        },
        {
          "id": 55,
          "start": 140.16,
          "end": 142.89,
          "en": "and avoid that a user is able to visit a page",
          "zh": ""
        },
        {
          "id": 56,
          "start": 142.89,
          "end": 145.98,
          "en": "where he's not going to be able to do anything anyways.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 145.98,
          "end": 147.96,
          "en": "So for now, we can go there and we can fail,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 147.96,
          "end": 149.37,
          "en": "but soon this will change.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 149.37,
          "end": 152.22,
          "en": "But now we need to go back to Firebase",
          "zh": ""
        },
        {
          "id": 60,
          "start": 152.22,
          "end": 154.02,
          "en": "and enable authentication",
          "zh": ""
        },
        {
          "id": 61,
          "start": 154.02,
          "end": 156.32999999999998,
          "en": "so that we can slowly add the logic",
          "zh": ""
        },
        {
          "id": 62,
          "start": 156.32999999999998,
          "end": 160.2,
          "en": "to be able to visit our authenticated routes again.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 160.2,
          "end": 162.78,
          "en": "So here under authentication on Firebase,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 162.78,
          "end": 164.57999999999998,
          "en": "click on set up sign-in method,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 164.57999999999998,
          "end": 166.44,
          "en": "and choose email and password,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 166.44,
          "end": 169.77,
          "en": "and click enable here, only that top one.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 169.77,
          "end": 170.76,
          "en": "Now click save.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 170.76,
          "end": 172.26,
          "en": "And now you got",
          "zh": ""
        },
        {
          "id": 69,
          "start": 172.26,
          "end": 176.22,
          "en": "that built-in Firebase authentication active,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 176.22,
          "end": 179.79,
          "en": "where you can send requests to certain endpoints",
          "zh": ""
        },
        {
          "id": 71,
          "start": 179.79,
          "end": 184.35,
          "en": "offered by Firebase to create users and to log users in.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 184.35,
          "end": 186.36,
          "en": "And you'll then see your users here",
          "zh": ""
        },
        {
          "id": 73,
          "start": 186.36,
          "end": 188.85,
          "en": "under authentication in the users tab.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 188.85,
          "end": 190.95,
          "en": "Now, which endpoints are they though?",
          "zh": ""
        },
        {
          "id": 75,
          "start": 190.95,
          "end": 192.843,
          "en": "Let's start with signing users up.",
          "zh": ""
        }
      ]
    }
