          "zh": ""
        },
        {
          "id": 52,
          "start": 145.89,
          "end": 150.66,
          "en": "So therefore, let me now inject the router here",
          "zh": ""
        },
        {
          "id": 53,
          "start": 150.66,
          "end": 153.09,
          "en": "into that authService router.",
