        },
        {
          "id": 49,
          "start": 135.72,
          "end": 137.34,
          "en": "once the token expired soon.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 137.34,
          "end": 140.97,
          "en": "And therefore, I wanna redirect here in the logout method",
