        },
        {
          "id": 46,
          "start": 129.36,
          "end": 130.95,
          "en": "which could lead to a log out.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 130.95,
          "end": 132.87,
          "en": "It's not just the header component.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 132.87,
          "end": 135.72,
          "en": "We will also add logic to automatically log us out",
