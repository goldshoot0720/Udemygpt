          "end": 113.72999999999999,
          "en": "And if I now click logout, this works.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 113.72999999999999,
          "end": 116.46000000000001,
          "en": "One nice thing would be that we are redirected",
          "zh": ""
        },
        {
          "id": 41,
