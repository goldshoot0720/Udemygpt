          "end": 39.12,
          "en": "the reactive approach.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 39.12,
          "end": 43.29,
          "en": "There, you actually define the structure of the form",
          "zh": ""
        },
        {
          "id": 15,
          "start": 43.29,
          "end": 45.15,
          "en": "in TypeScript code.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 45.15,
