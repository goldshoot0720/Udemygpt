          "en": "Instructor: Before diving in the actual code,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.44,
          "end": 6.21,
          "en": "it's super important to understand",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.21,
          "end": 9.54,
          "en": "that Angular actually offers two approaches",
          "zh": ""
        },
        {
          "id": 4,
