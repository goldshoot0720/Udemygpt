          "zh": ""
        },
        {
          "id": 17,
          "start": 48,
          "end": 49.68,
          "en": "and then you manually connect it,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 49.68,
          "end": 52.98,
          "en": "which might sound more complicated than it is in the end,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 52.98,
          "end": 56.13,
