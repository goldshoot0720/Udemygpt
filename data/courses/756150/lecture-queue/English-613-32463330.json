          "zh": ""
        },
        {
          "id": 30,
          "start": 76.38,
          "end": 78.03,
          "en": "Because that's important.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 78.03,
          "end": 79.38,
          "en": "When you are working",
          "zh": ""
        },
        {
          "id": 32,
