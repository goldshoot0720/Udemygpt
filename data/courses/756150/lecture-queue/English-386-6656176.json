          "end": 125.55,
          "en": "which I don't need here.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 125.55,
          "end": 126.48,
          "en": "But what I want to do",
          "zh": ""
        },
        {
          "id": 72,
          "start": 126.48,
          "end": 128.46,
          "en": "in this case is I want to",
          "zh": ""
        },
        {
          "id": 73,
          "start": 128.46,
          "end": 129.51,
          "en": "change the background",
          "zh": ""
        },
        {
          "id": 74,
          "start": 129.51,
          "end": 130.983,
          "en": "color of the element.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 132.18,
          "end": 133.65,
          "en": "So what I can do is",
          "zh": ""
        },
        {
          "id": 76,
          "start": 133.65,
          "end": 135.36,
          "en": "I can copy this code",
          "zh": ""
        },
        {
          "id": 77,
          "start": 135.36,
          "end": 137.97,
          "en": "from ngOnInit and comment it out.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 137.97,
          "end": 139.11,
          "en": "And now set the style",
          "zh": ""
        },
        {
          "id": 79,
          "start": 139.11,
          "end": 141.09,
          "en": "here on mouse enter.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 141.09,
          "end": 142.82999999999998,
          "en": "And now I can quickly copy",
          "zh": ""
        },
        {
          "id": 81,
          "start": 142.82999999999998,
          "end": 145.95,
          "en": "this and add another method. (mouse clicking)",
          "zh": ""
        },
        {
          "id": 82,
          "start": 145.95,
          "end": 146.79,
          "en": "Which I'll name",
          "zh": ""
        },
        {
          "id": 83,
          "start": 146.79,
