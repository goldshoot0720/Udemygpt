          "en": "mouse leave maybe. (mouse clicking)",
          "zh": ""
        },
        {
          "id": 84,
          "start": 150.06,
          "end": 150.93,
          "en": "Where I will listen to",
          "zh": ""
        },
        {
          "id": 85,
          "start": 150.93,
          "end": 152.34,
          "en": "the mouse leave event",
          "zh": ""
        },
        {
          "id": 86,
          "start": 152.34,
          "end": 153.45,
          "en": "another official event",
          "zh": ""
        },
        {
          "id": 87,
          "start": 153.45,
          "end": 154.935,
          "en": "I can listen to.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 154.935,
          "end": 156.24,
          "en": "And then I want to",
          "zh": ""
        },
        {
          "id": 89,
          "start": 156.24,
          "end": 157.59300000000002,
          "en": "set the background color",
          "zh": ""
        },
        {
          "id": 90,
          "start": 157.59300000000002,
