          "en": "to transparent maybe. (keyboard tapping)",
          "zh": ""
        },
        {
          "id": 91,
          "start": 160.65,
          "end": 162.18,
          "en": "Now with this in place",
          "zh": ""
        },
        {
          "id": 92,
          "start": 162.18,
          "end": 163.013,
          "en": "we should have",
