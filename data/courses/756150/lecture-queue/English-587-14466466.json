          "zh": ""
        },
        {
          "id": 25,
          "start": 71.97,
          "end": 74.91,
          "en": "clicks this close button or the backdrop.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 74.91,
          "end": 79.59,
          "en": "So here we can register a click listener and fire on close.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 79.59,
          "end": 81.75,
          "en": "And we do the same when the backdrop is clicked",
          "zh": ""
        },
        {
          "id": 28,
          "start": 81.75,
          "end": 85.11,
