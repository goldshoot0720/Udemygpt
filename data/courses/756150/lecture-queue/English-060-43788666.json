        },
        {
          "id": 143,
          "start": 376.41,
          "end": 379.56,
          "en": "by giving you the special ngSubmit event",
          "zh": ""
        },
        {
          "id": 144,
          "start": 379.56,
          "end": 381,
          "en": "to which you can listen,",
          "zh": ""
        },
        {
          "id": 145,
          "start": 381,
          "end": 384.18,
