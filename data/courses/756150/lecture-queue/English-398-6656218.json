  "courseSlug": "the-complete-guide-to-angular-2",
  "courseTitle": "Angular - The Complete Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "6656218",
      "title": "Understanding the Hierarchical Injector",
      "lectureOrder": 434,
      "videoOrder": 398,
      "sourceHash": "d4f792a5e464e6241af8e03dc5995a4a976eeea05e276b81d13dfa94d6f841da",
      "cues": [
        {
          "id": 1,
          "start": 2.67,
          "end": 3.63,
          "en": "-: In the last lecture,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.63,
          "end": 6.48,
          "en": "we set up our account service and hooked it up in our app,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.48,
          "end": 9.96,
          "en": "and still our app seems to be broken.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.96,
          "end": 13.2,
          "en": "If I click these buttons, the status has not changed.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.2,
          "end": 16.59,
          "en": "So somehow our code is not working.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.59,
          "end": 19.2,
          "en": "Actually, it's working correctly.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 19.2,
          "end": 22.17,
          "en": "We're just using services wrong here.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.17,
          "end": 24.8,
          "en": "In this specific case, we're not using the service",
          "zh": ""
        },
        {
          "id": 9,
          "start": 24.8,
          "end": 27.87,
          "en": "in the way we should use it in our app.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.87,
          "end": 29.043,
          "en": "What's going wrong?",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.91,
          "end": 32.76,
          "en": "The Angular dependence injector",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.76,
          "end": 36.12,
          "en": "actually is a hierarchical injector.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 36.12,
          "end": 39.51,
          "en": "That means that if we provide a service",
          "zh": ""
        },
        {
          "id": 14,
          "start": 39.51,
          "end": 43.71,
          "en": "in some place of our app, let's say on one component,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 43.71,
          "end": 47.1,
          "en": "the Angular framework knows how to create",
          "zh": ""
        },
        {
          "id": 16,
          "start": 47.1,
          "end": 50.58,
          "en": "an instance of that service for this component,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 50.58,
          "end": 53.97,
          "en": "and, important, all its child components.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 53.97,
          "end": 58.47,
          "en": "And actually, this component and all its child components,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 58.47,
          "end": 61.2,
          "en": "and the child components of the child components,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 61.2,
          "end": 64.863,
          "en": "will receive the same instance of the service.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 65.88,
          "end": 69.12,
          "en": "There are other places where we can provide a service too.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 69.12,
          "end": 72.48,
          "en": "The highest possible level is the AppModule.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 72.48,
          "end": 75.63,
          "en": "We haven't done this yet, but we will see this soon,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 75.63,
          "end": 78.09,
          "en": "if we provide a service there,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 78.09,
          "end": 80.85,
          "en": "the AppModule does have a provider's array.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 80.85,
          "end": 83.16,
          "en": "The same instance, and that's important,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 83.16,
          "end": 87,
          "en": "the same instance of the class of the service",
          "zh": ""
        },
        {
          "id": 28,
          "start": 87,
          "end": 90.36,
          "en": "is available in our whole app, in all components,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 90.36,
          "end": 93.42,
          "en": "in all directives, in all other services",
          "zh": ""
        },
        {
          "id": 30,
          "start": 93.42,
          "end": 95.22,
          "en": "where we maybe inject the service.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 95.22,
          "end": 97.8,
          "en": "Yes, we can inject services into services.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 97.8,
          "end": 99.033,
          "en": "I'll come back to this.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 100.22999999999999,
          "end": 103.86,
          "en": "The next level, for example, would be the AppComponent.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 103.86,
          "end": 107.97,
          "en": "There, the AppComponent and all its child components,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 107.97,
          "end": 110.46000000000001,
          "en": "do have the same instance of the service.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 110.46000000000001,
          "end": 112.35,
          "en": "And this is true for any component.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 112.35,
          "end": 114.9,
          "en": "So even if we have a child of the AppComponent,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 114.9,
          "end": 117.12,
          "en": "if we provide it on that child,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 117.12,
          "end": 120.09,
          "en": "all the children of this child will have the same instance,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 120.09,
          "end": 123.42,
          "en": "and the child itself, but not the AppComponent.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 123.42,
          "end": 125.73,
          "en": "The instances don't propagate up.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 125.73,
          "end": 130.38,
          "en": "They only go down that tree of components.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 130.38,
          "end": 132.12,
          "en": "The lowest level, therefore,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 132.12,
          "end": 135.75,
          "en": "is a single component with no child components.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 135.75,
          "end": 138.06,
          "en": "If we provide a service there,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 138.06,
          "end": 142.05,
          "en": "this component will have its own instance of the service,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 142.05,
          "end": 144.24,
          "en": "and. Well, it doesn't have any child components,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 144.24,
          "end": 148.23,
          "en": "so this instance will only be available for this component.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 148.23,
          "end": 150.36,
          "en": "And this will actually even override",
          "zh": ""
        },
        {
          "id": 50,
          "start": 150.36,
          "end": 154.14,
          "en": "if we were to provide the same service on a higher level.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 154.14,
          "end": 155.76,
          "en": "And that's exactly what we're doing.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 155.76,
          "end": 158.16,
          "en": "So let's take a closer look in the next lecture.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
