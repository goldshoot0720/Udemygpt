          "en": "in the user component for now",
          "zh": ""
        },
        {
          "id": 232,
          "start": 750.45,
          "end": 753.12,
          "en": "so that you see how they could be used.",
          "zh": ""
        },
        {
          "id": 233,
          "start": 753.12,
          "end": 755.97,
          "en": "But I will use that other State management approach,",
