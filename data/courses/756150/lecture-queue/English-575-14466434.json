{
  "version": 1,
  "courseId": 756150,
  "courseSlug": "the-complete-guide-to-angular-2",
  "courseTitle": "Angular - The Complete Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "14466434",
      "title": "Creating & Storing the User Data",
      "lectureOrder": 624,
      "videoOrder": 575,
      "sourceHash": "d600836c7a208e28c9b80b26e15b134ef3a146a1db7b2703ae07e49f93e8733c",
      "cues": [
        {
          "id": 1,
          "start": 2.37,
          "end": 5.49,
          "en": "Instructor: Let's start storing data about the user",
          "zh": ""
        },
        {
          "id": 2,
          "start": 5.49,
          "end": 8.07,
          "en": "whether the user is authenticated and so on.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 8.07,
          "end": 10.83,
          "en": "And for that, I think it makes sense to start off",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.83,
          "end": 13.62,
          "en": "by creating a user model.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.62,
          "end": 14.94,
          "en": "So in the auth folder,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.94,
          "end": 18.3,
          "en": "I'll add a new user.model.typescript file.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.3,
          "end": 20.1,
          "en": "And the idea here is that this model",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.1,
          "end": 23.52,
          "en": "stores all the core data that makes up a user",
          "zh": ""
        },
        {
          "id": 9,
          "start": 23.52,
          "end": 25.71,
          "en": "and even helps us with validating",
          "zh": ""
        },
        {
          "id": 10,
          "start": 25.71,
          "end": 28.14,
          "en": "whether that token is still valid",
          "zh": ""
        },
        {
          "id": 11,
          "start": 28.14,
          "end": 30.3,
          "en": "because, remember, I said that the token",
          "zh": ""
        },
        {
          "id": 12,
          "start": 30.3,
          "end": 31.92,
          "en": "would expire after one hour",
          "zh": ""
        },
        {
          "id": 13,
          "start": 31.92,
          "end": 34.86,
          "en": "and we'll need to, therefore, also find out",
          "zh": ""
        },
        {
          "id": 14,
          "start": 34.86,
          "end": 37.44,
          "en": "not only if the token exists, but if it is still valid,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 37.44,
          "end": 39.453,
          "en": "and I wanna manage this in this model.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 40.38,
          "end": 43.86,
          "en": "Therefore, I export a class here with a name of User",
          "zh": ""
        },
        {
          "id": 17,
          "start": 43.86,
          "end": 47.76,
          "en": "which, I guess, is a fitting name for, well, a user model.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 47.76,
          "end": 50.43,
          "en": "And in there, we can use a constructor",
          "zh": ""
        },
        {
          "id": 19,
          "start": 50.43,
          "end": 54.03,
          "en": "so that we can create a user with the new keyword.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 54.03,
          "end": 57.3,
          "en": "And there again, I'll use the TypeScript shortcut",
          "zh": ""
        },
        {
          "id": 21,
          "start": 57.3,
          "end": 60.84,
          "en": "of automatically storing arguments of the constructor",
          "zh": ""
        },
        {
          "id": 22,
          "start": 60.84,
          "end": 63.688,
          "en": "in properties of the class by adding an accessor",
          "zh": ""
        },
        {
          "id": 23,
          "start": 63.688,
          "end": 67.17,
          "en": "in front of the argument name,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 67.17,
          "end": 69.9,
          "en": "which will then also be used as the property name.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 69.9,
          "end": 71.73,
          "en": "And there, a user should have an email",
          "zh": ""
        },
        {
          "id": 26,
          "start": 71.73,
          "end": 73.23,
          "en": "which is of type string.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 73.23,
          "end": 76.2,
          "en": "A user also should have an ID, which is of type string.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 76.2,
          "end": 77.91,
          "en": "And we need that token,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 77.91,
          "end": 80.822,
          "en": "and this I will store as a private property,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 80.822,
          "end": 83.1,
          "en": "_token which is a string,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 83.1,
          "end": 86.07,
          "en": "and also a token expiration date",
          "zh": ""
        },
        {
          "id": 32,
          "start": 86.07,
          "end": 88.87,
          "en": "which should be a private property _tokenExpirationDate,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 90.96000000000001,
          "end": 95.46000000000001,
          "en": "which will be a date object, so of type date.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 95.46000000000001,
          "end": 97.97999999999999,
          "en": "Now why underscore and why private?",
          "zh": ""
        },
        {
          "id": 35,
          "start": 97.97999999999999,
          "end": 99.53999999999999,
          "en": "Private because the token",
          "zh": ""
        },
        {
          "id": 36,
          "start": 99.53999999999999,
          "end": 102.06,
          "en": "should not be retrievable like this.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 102.06,
          "end": 104.91,
          "en": "Instead, when the user, or you as a developer,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 104.91,
          "end": 106.74000000000001,
          "en": "want to get access to the token,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 106.74000000000001,
          "end": 109.25999999999999,
          "en": "you should actually be required to do that in a way",
          "zh": ""
        },
        {
          "id": 40,
          "start": 109.25999999999999,
          "end": 111.75,
          "en": "that will automatically check the validity.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 111.75,
          "end": 114.42,
          "en": "And this can be achieved by adding a gather here",
          "zh": ""
        },
        {
          "id": 42,
          "start": 114.42,
          "end": 117.47999999999999,
          "en": "with the get keyword, which I'll name token now.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 117.47999999999999,
          "end": 122.04,
          "en": "Now what is a gather? A gather here looks like a function.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 122.04,
          "end": 124.68,
          "en": "We add parentheses and then a function body,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 124.68,
          "end": 127.17,
          "en": "but you actually access it like a property.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 127.17,
          "end": 130.59,
          "en": "So you will be able to do something like user.token.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 130.59,
          "end": 132.63,
          "en": "This is how you will be able to access this",
          "zh": ""
        },
        {
          "id": 48,
          "start": 132.63,
          "end": 133.983,
          "en": "because it's a gather,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 135.36,
          "end": 137.67000000000002,
          "en": "it's a special type of property, you could say.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 137.67000000000002,
          "end": 139.98,
          "en": "It's a property where you can write code",
          "zh": ""
        },
        {
          "id": 51,
          "start": 139.98,
          "end": 143.04,
          "en": "that runs when you try to access this property.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 143.04,
          "end": 147,
          "en": "So it's a property plus, plus, you could say.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 147,
          "end": 149.73,
          "en": "A gather also means that the user can't override this.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 149.73,
          "end": 152.46,
          "en": "So setting user token to something new,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 152.46,
          "end": 153.63,
          "en": "this will throw an error",
          "zh": ""
        },
        {
          "id": 56,
          "start": 153.63,
          "end": 155.73,
          "en": "because it's only a gather, not a setter.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 155.73,
          "end": 158.76,
          "en": "There are setters, too, but we don't need them here.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 158.76,
          "end": 161.28,
          "en": "You set a token when you create a new user object",
          "zh": ""
        },
        {
          "id": 59,
          "start": 161.28,
          "end": 163.68,
          "en": "and we will always create a new user object",
          "zh": ""
        },
        {
          "id": 60,
          "start": 163.68,
          "end": 164.94299999999998,
          "en": "when a user logs in.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 166.11,
          "end": 168.45,
          "en": "So, therefore, we have that gather named token,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 168.45,
          "end": 170.34,
          "en": "and the idea here is that we, of course,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 170.34,
          "end": 172.98,
          "en": "return this._token here.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 172.98,
          "end": 176.22,
          "en": "But before we do that, we can add certain checks,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 176.22,
          "end": 179.1,
          "en": "or to be precise, I want to add one check.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 179.1,
          "end": 184.1,
          "en": "I wanna check if this.tokenExpirationDate does not exist.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 186.21,
          "end": 188.52,
          "en": "So if this does not exist",
          "zh": ""
        },
        {
          "id": 68,
          "start": 188.52,
          "end": 192.84,
          "en": "or if the current date which we get with new Date,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 192.84,
          "end": 195.39,
          "en": "that's a JavaScript feature, that's the current timestamp,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 195.39,
          "end": 197.64,
          "en": "not just the date but also the current time,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 197.64,
          "end": 202.07,
          "en": "if the current is greater than this.tokenExpirationDate,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 202.07,
          "end": 203.31,
          "en": "so if it does exist",
          "zh": ""
        },
        {
          "id": 73,
          "start": 203.31,
          "end": 205.44,
          "en": "but it is smaller than the current timestamp,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 205.44,
          "end": 207.32999999999998,
          "en": "then we know that the token expired, right?",
          "zh": ""
        },
        {
          "id": 75,
          "start": 207.32999999999998,
          "end": 209.188,
          "en": "Because if the token expiration date is smaller",
          "zh": ""
        },
        {
          "id": 76,
          "start": 209.188,
          "end": 211.98,
          "en": "than the current date, then it's in the past,",
          "zh": ""
        },
        {
          "id": 77,
          "start": 211.98,
          "end": 214.07999999999998,
          "en": "and that means even if we have a token,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 214.07999999999998,
          "end": 215.73,
          "en": "it's not valid anymore.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 215.73,
          "end": 218.57999999999998,
          "en": "And therefore, in that case, I will return null",
          "zh": ""
        },
        {
          "id": 80,
          "start": 218.57999999999998,
          "end": 220.293,
          "en": "even though we might have a token.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 223.05,
          "end": 227.67000000000002,
          "en": "That's the logic I want to add in this user object for now",
          "zh": ""
        },
        {
          "id": 82,
          "start": 227.67000000000002,
          "end": 230.46,
          "en": "or in that user class for now.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 230.46,
          "end": 233.4,
          "en": "With that created in the auth service,",
          "zh": ""
        },
        {
          "id": 84,
          "start": 233.4,
          "end": 236.17000000000002,
          "en": "I wanna store the authenticated user",
          "zh": ""
        },
        {
          "id": 85,
          "start": 237.21,
          "end": 240.06,
          "en": "and I will actually store it as a subject.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 240.06,
          "end": 245.06,
          "en": "So for that, let's add user subject with new Subject.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 246.18,
          "end": 249.88,
          "en": "The subject here is, of course, imported from RxJS",
          "zh": ""
        },
        {
          "id": 88,
          "start": 251.79,
          "end": 255.87,
          "en": "and this will be a generic type where we store the user",
          "zh": ""
        },
        {
          "id": 89,
          "start": 255.87,
          "end": 257.04,
          "en": "in the subject in the end.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 257.04,
          "end": 260.043,
          "en": "So the user needs to be imported from the user model.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 260.91,
          "end": 264.51,
          "en": "And now with that, the idea is that we emit a new user,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 264.51,
          "end": 266.76,
          "en": "we next a new user.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 266.76,
          "end": 268.98,
          "en": "Whenever we have one, we log in,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 268.98,
          "end": 271.26,
          "en": "or also when we log out, when we clear the user",
          "zh": ""
        },
        {
          "id": 95,
          "start": 271.26,
          "end": 275.34000000000003,
          "en": "when the user becomes invalid or the token expired.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 275.34000000000003,
          "end": 278.22,
          "en": "So now here, for example, for signing up,",
          "zh": ""
        },
        {
          "id": 97,
          "start": 278.22,
          "end": 282.09000000000003,
          "en": "we know that when we succeed, if we don't have an error,",
          "zh": ""
        },
        {
          "id": 98,
          "start": 282.09000000000003,
          "end": 284.07,
          "en": "we get the AuthResponseData",
          "zh": ""
        },
        {
          "id": 99,
          "start": 284.07,
          "end": 286.23,
          "en": "which contains stats token we need for the user",
          "zh": ""
        },
        {
          "id": 100,
          "start": 286.23,
          "end": 289.68,
          "en": "which contains the email and the expiry date,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 289.68,
          "end": 292.59000000000003,
          "en": "and therefore, I want to add a new operator,",
          "zh": ""
        },
        {
          "id": 102,
          "start": 292.59000000000003,
          "end": 295.5,
          "en": "a new RxJS operator to that pipe here,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 295.5,
          "end": 297.72,
          "en": "to that observable pipe.",
          "zh": ""
        },
        {
          "id": 104,
          "start": 297.72,
          "end": 300.12,
          "en": "This will be the tap operator.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 300.12,
          "end": 302.64,
          "en": "Now the tap operator, just like catch error,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 302.64,
          "end": 305.19,
          "en": "needs to be imported from RxJS operators.",
          "zh": ""
        },
        {
          "id": 107,
          "start": 305.19,
          "end": 307.83,
          "en": "And if you remember, tap was an operator",
          "zh": ""
        },
        {
          "id": 108,
          "start": 307.83,
          "end": 309.84,
          "en": "that allows us to perform some action",
          "zh": ""
        },
        {
          "id": 109,
          "start": 309.84,
          "end": 311.67,
          "en": "without changing the response.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 311.67,
          "end": 314.13,
          "en": "So it steps into that observable chain,",
          "zh": ""
        },
        {
          "id": 111,
          "start": 314.13,
          "end": 316.32,
          "en": "but it doesn't stop it, block it, or change it.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 316.32,
          "end": 318.36,
          "en": "It just runs some code with the data",
          "zh": ""
        },
        {
          "id": 113,
          "start": 318.36,
          "end": 319.89,
          "en": "you get back from the observable,",
          "zh": ""
        },
        {
          "id": 114,
          "start": 319.89,
          "end": 322.17,
          "en": "so with the response, in this case.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 322.17,
          "end": 324.63,
          "en": "Therefore, here we get our response data.",
          "zh": ""
        },
        {
          "id": 116,
          "start": 324.63,
          "end": 328.14,
          "en": "And here, I then want to create my new user.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 328.14,
          "end": 330.45,
          "en": "For that, I'll create a new constant user",
          "zh": ""
        },
        {
          "id": 118,
          "start": 330.45,
          "end": 333.54,
          "en": "where I call new User using the user model.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 333.54,
          "end": 336.72,
          "en": "And we need to forward that email",
          "zh": ""
        },
        {
          "id": 120,
          "start": 336.72,
          "end": 339.45,
          "en": "because we expect that as our argument here",
          "zh": ""
        },
        {
          "id": 121,
          "start": 339.45,
          "end": 340.65,
          "en": "in the constructor.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 340.65,
          "end": 344.13,
          "en": "We need to forward the ID, which is the resData.localID,",
          "zh": ""
        },
        {
          "id": 123,
          "start": 344.13,
          "end": 348.15,
          "en": "that's the generated user ID generated by Firebase.",
          "zh": ""
        },
        {
          "id": 124,
          "start": 348.15,
          "end": 351.033,
          "en": "We need to forward the token, which is our idToken,",
          "zh": ""
        },
        {
          "id": 125,
          "start": 352.08,
          "end": 353.82,
          "en": "and we need the expiration date,",
          "zh": ""
        },
        {
          "id": 126,
          "start": 353.82,
          "end": 355.44,
          "en": "which should be a date object.",
          "zh": ""
        },
        {
          "id": 127,
          "start": 355.44,
          "end": 357.65999999999997,
          "en": "Now that's not part of our response,",
          "zh": ""
        },
        {
          "id": 128,
          "start": 357.65999999999997,
          "end": 360.78,
          "en": "that is something we have to generate.",
          "zh": ""
        },
        {
          "id": 129,
          "start": 360.78,
          "end": 364.533,
          "en": "And for that, I'll add a new constant here, expirationDate,",
          "zh": ""
        },
        {
          "id": 130,
          "start": 367.62,
          "end": 370.68,
          "en": "where I create a new JavaScript data object",
          "zh": ""
        },
        {
          "id": 131,
          "start": 370.68,
          "end": 374.31,
          "en": "based on that expiresIn time we get back from Firebase.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 374.31,
