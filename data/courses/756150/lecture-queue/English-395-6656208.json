          "zh": ""
        },
        {
          "id": 22,
          "start": 57.3,
          "end": 59.55,
          "en": "Now, a Component becomes a Component",
          "zh": ""
        },
        {
          "id": 23,
          "start": 59.55,
          "end": 63.36,
          "en": "because we attach this \"@Component\" decorator.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 63.36,
          "end": 64.92,
          "en": "A Directive becomes a Directive",
          "zh": ""
        },
        {
          "id": 25,
          "start": 64.92,
          "end": 67.29,
          "en": "because we attach \"@Directive.\"",
          "zh": ""
        },
        {
          "id": 26,
          "start": 67.29,
          "end": 71.19,
