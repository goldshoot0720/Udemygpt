          "zh": ""
        },
        {
          "id": 49,
          "start": 144.81,
          "end": 147.36,
          "en": "of type of response data.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 147.36,
          "end": 151.53,
          "en": "Now just as for signing up, I wanna return this observable",
          "zh": ""
        },
        {
          "id": 51,
          "start": 151.53,
          "end": 155.28,
          "en": "so that we only prepare it here, but we can then subscribe",
          "zh": ""
        },
        {
          "id": 52,
          "start": 155.28,
          "end": 157.5,
          "en": "in our auth component,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 157.5,
          "end": 160.29,
          "en": "and therefore now in the auth component,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 160.29,
          "end": 164.97,
          "en": "here we have our logic for sending that sign up request.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 164.97,
          "end": 166.8,
          "en": "In the isLogin mode, we therefor",
          "zh": ""
        },
        {
          "id": 56,
          "start": 166.8,
          "end": 170.1,
          "en": "now can reach out to authService login,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 170.1,
          "end": 173.13,
          "en": "and all the forward email and password here.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 173.13,
          "end": 175.86,
          "en": "And then we have pretty much the same logic as down there.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 175.86,
          "end": 177.25,
          "en": "So I can grab this",
          "zh": ""
        },
