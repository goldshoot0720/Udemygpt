      "cues": [
        {
          "id": 1,
          "start": 2.4,
          "end": 6.15,
          "en": "-: So we spend quite some time here on the signup process",
          "zh": ""
        },
        {
          "id": 2,
          "start": 6.15,
          "end": 10.59,
          "en": "but therefore we already got a nice error handling step here",
          "zh": ""
        },
        {
          "id": 3,
          "start": 10.59,
          "end": 12.99,
          "en": "in place, which is not too bad.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 12.99,
          "end": 15.54,
          "en": "But now it's of course also time to sign users in",
          "zh": ""
        },
        {
          "id": 5,
          "start": 15.54,
          "end": 16.8,
          "en": "and not just up.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.8,
          "end": 18.63,
          "en": "And of course our UI doesn't change",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.63,
