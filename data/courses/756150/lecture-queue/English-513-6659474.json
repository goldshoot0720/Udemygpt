        },
        {
          "id": 54,
          "start": 151.92000000000002,
          "end": 153.36,
          "en": "we don't need that import anymore,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 153.36,
          "end": 155.19,
          "en": "so we can remove it.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 155.19,
          "end": 156.87,
          "en": "But the thing I wanted to do is,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 156.87,
          "end": 160.39,
          "en": "I will add the on cancel method",
          "zh": ""
        },
        {
          "id": 58,
          "start": 161.46,
          "end": 163.41,
          "en": "and in on cancel,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 163.41,
          "end": 166.71,
          "en": "well here I simply want to navigate away.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 166.71,
          "end": 169.15,
          "en": "So for that we need the router",
