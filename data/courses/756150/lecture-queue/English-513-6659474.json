        },
        {
          "id": 79,
          "start": 224.04,
          "end": 226.14,
          "en": "even though it sounds wrong,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 226.14,
          "end": 227.88,
          "en": "but we are done at this point,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 227.88,
          "end": 230.79,
          "en": "we can simply navigate away.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 230.79,
          "end": 232.2,
          "en": "Let's see if that all works.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 232.2,
          "end": 236.19,
          "en": "If I click Cancel, we're back to our recipe.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 236.19,
          "end": 238.473,
          "en": "The same for this one.",
