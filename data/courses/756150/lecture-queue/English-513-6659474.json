        },
        {
          "id": 51,
          "start": 141.75,
          "end": 143.46,
          "en": "the submission event.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 143.46,
          "end": 147.003,
          "en": "When we hit Cancel, I want to execute on cancel.",
