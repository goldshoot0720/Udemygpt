          "end": 171.51,
          "en": "of type router,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 171.51,
          "end": 172.92000000000002,
          "en": "so let's inject it here.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 172.92000000000002,
          "end": 177.573,
          "en": "Make sure to import the router type from at Angular router.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 178.53,
          "end": 181.26,
          "en": "And with that injected and on cancel,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 181.26,
          "end": 185.61,
