          "zh": ""
        },
        {
          "id": 75,
          "start": 210.78,
          "end": 213.663,
          "en": "relative to this route.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 214.71,
          "end": 217.56,
          "en": "So that happens if we click the Cancel button.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 217.56,
          "end": 221.46,
          "en": "I actually want the same to happen once I submit the form.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 221.46,
          "end": 224.04,
          "en": "So here I will call on cancel,",
