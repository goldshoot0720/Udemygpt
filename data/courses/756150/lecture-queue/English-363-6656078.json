      "cues": [
        {
          "id": 1,
          "start": 2.34,
          "end": 5.85,
          "en": "-: In the last lecture, you learned how to use @Output",
          "zh": ""
        },
        {
          "id": 2,
          "start": 5.85,
          "end": 10.02,
          "en": "to enable our components to listen to your own custom events",
          "zh": ""
        },
        {
          "id": 3,
          "start": 10.02,
          "end": 12.78,
          "en": "which you could create with EventEmitter.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 12.78,
          "end": 15.15,
          "en": "Now, just like on @Input,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 15.15,
          "end": 18.33,
          "en": "on @Output, you also can assign an alias.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 18.33,
          "end": 20.25,
          "en": "Like here for blueprintCreated,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.25,
          "end": 22.8,
          "en": "maybe you want to name this bpCreated.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.8,
          "end": 25.44,
          "en": "Now with this, this is the event",
          "zh": ""
        },
        {
          "id": 9,
          "start": 25.44,
          "end": 27.69,
          "en": "you can listen to from outside.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.69,
          "end": 30.66,
          "en": "So in the app component where we try to listen,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 30.66,
          "end": 34.92,
          "en": "we now need to rename it here too and listen to bpCreated,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 34.92,
          "end": 38.01,
          "en": "which is now, just like on @Input,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 38.01,
          "end": 40.47,
          "en": "the one and only event you can listen to",
          "zh": ""
        },
        {
          "id": 14,
          "start": 40.47,
          "end": 42.93,
          "en": "when it comes to this blueprintCreated event.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 42.93,
          "end": 46.77,
          "en": "The other name, blueprintCreated here,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 46.77,
          "end": 49.14,
          "en": "will not be exposed to the outside anymore,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 49.14,
          "end": 51.66,
          "en": "so it has to be bpCreated now.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 51.66,
          "end": 55.083,
          "en": "All the rest stays in touch and works just like before.",
          "zh": ""
        }
      ]
    }
