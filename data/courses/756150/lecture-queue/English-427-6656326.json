          "end": 10.44,
          "en": "In our servers component",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.44,
          "end": 13.8,
          "en": "we have our links loading the individual servers.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.8,
          "end": 15.93,
          "en": "So the single server component.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.93,
          "end": 20.88,
          "en": "This component here with this allow added query parameter.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.88,
          "end": 24.9,
          "en": "So now in the server component we should add some button",
