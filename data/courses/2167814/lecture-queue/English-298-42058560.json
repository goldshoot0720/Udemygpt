        },
        {
          "id": 48,
          "start": 106.28999999999999,
          "end": 107.324,
          "en": "for the subsequent request,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 107.324,
          "end": 109.8,
          "en": "it uses the same session id, right?",
          "zh": ""
        },
        {
          "id": 50,
          "start": 109.8,
          "end": 110.75999999999999,
          "en": "And we have seen this.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 110.75999999999999,
          "end": 113.09,
          "en": "If you open your browser, may request for hello,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 113.09,
          "end": 115.32,
          "en": "you can say it'll give you a login page.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 115.32,
          "end": 117.15,
          "en": "And here you have to enter your username",
          "zh": ""
        },
        {
          "id": 54,
          "start": 117.15,
          "end": 118.83,
          "en": "and you have to enter your password.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 118.83,
          "end": 120.12,
          "en": "And then you get this.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 120.12,
          "end": 122.28,
          "en": "And every time you send a request,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 122.28,
          "end": 124.38,
          "en": "let's say I'm sending a request for about now.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 124.38,
          "end": 127.557,
          "en": "And if I say enter, you have the same session id.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 127.557,
          "end": 129.96,
          "en": "Even if you use for students.",
