          "en": "having the token, right?",
          "zh": ""
        },
        {
          "id": 22,
          "start": 48.3,
          "end": 49.49,
          "en": "So we have seen the example before",
          "zh": ""
        },
        {
          "id": 23,
          "start": 49.49,
