        },
        {
          "id": 118,
          "start": 277.92,
          "end": 280.38,
          "en": "And Hibernate is that tool.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 280.38,
          "end": 281.97,
          "en": "Okay, everything looks magical here.",
          "zh": ""
        },
        {
          "id": 120,
          "start": 281.97,
          "end": 283.14,
          "en": "How we are going to implement that?",
