          "end": 282.42,
          "en": "This NUM1 isn't reference variable.",
          "zh": ""
        },
        {
          "id": 128,
          "start": 282.42,
          "end": 283.95,
          "en": "So of course it should be an object.",
          "zh": ""
        },
        {
          "id": 129,
          "start": 283.95,
          "end": 287.46,
          "en": "So this will be getting converted to object automatically,",
          "zh": ""
        },
        {
          "id": 130,
          "start": 287.46,
          "end": 289.62,
