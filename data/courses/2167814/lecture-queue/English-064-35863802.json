        },
        {
          "id": 76,
          "start": 165.87,
          "end": 167.61,
          "en": "This is a reference variable.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 167.61,
          "end": 171.303,
          "en": "Now since this is a class integer, we can say new integer.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 172.35,
          "end": 174.51,
          "en": "And in this integer we can say",
          "zh": ""
        },
        {
          "id": 79,
          "start": 174.51,
          "end": 175.41,
          "en": "whatever value you want to store.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 175.41,
          "end": 177.06,
          "en": "Let's say I want to store eight.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 177.06,
          "end": 179.46,
          "en": "Now you can see there's a line on this.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 179.46,
          "end": 182.55,
          "en": "So whenever you see a line in any of the IDE,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 182.55,
