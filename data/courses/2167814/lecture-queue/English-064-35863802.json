          "en": "And let me print NUM1,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 206.037,
          "end": 207.36,
          "en": "and let's see if that works",
          "zh": ""
        },
        {
          "id": 96,
          "start": 207.36,
          "end": 209.61,
          "en": "in the same way as we were doing.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 209.61,
          "end": 212.52,
          "en": "Okay, you can see we got a warning, there's no error.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 212.52,
