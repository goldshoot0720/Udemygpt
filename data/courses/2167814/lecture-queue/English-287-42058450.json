          "end": 282.763,
          "en": "If you are handling user credit card information,",
          "zh": ""
        },
        {
          "id": 130,
          "start": 282.763,
          "end": 284.25,
          "en": "now that's critical,",
          "zh": ""
        },
        {
          "id": 131,
          "start": 284.25,
          "end": 287.04,
          "en": "you are handling user medical records, now that's critical.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 287.04,
          "end": 288.51,
          "en": "If you're handling user's money,",
          "zh": ""
        },
        {
          "id": 133,
          "start": 288.51,
