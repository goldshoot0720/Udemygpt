          "en": "you find the minimum value",
          "zh": ""
        },
        {
          "id": 34,
          "start": 72.33,
          "end": 73.44,
          "en": "and then you make sure",
          "zh": ""
        },
        {
          "id": 35,
          "start": 73.44,
          "end": 75.75,
          "en": "that the minimum value stays at the start.",
