        },
        {
          "id": 70,
          "start": 148.82999999999998,
          "end": 150.15,
          "en": "Ah yes, at any given point,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 150.15,
          "end": 152.91,
          "en": "if you want to go back to the previous commit,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 152.91,
          "end": 154.2,
