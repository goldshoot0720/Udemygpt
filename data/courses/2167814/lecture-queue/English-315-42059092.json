        },
        {
          "id": 11,
          "start": 24.12,
          "end": 26.73,
          "en": "And then the front end, which is your React application,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 26.73,
          "end": 28.71,
          "en": "is running on a different port number, which is 3000.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 28.71,
          "end": 32.04,
          "en": "Now by default, Spring says you can't actually access",
          "zh": ""
        },
        {
          "id": 14,
          "start": 32.04,
          "end": 33.78,
          "en": "a resource from a different origin",
          "zh": ""
        },
        {
          "id": 15,
          "start": 33.78,
