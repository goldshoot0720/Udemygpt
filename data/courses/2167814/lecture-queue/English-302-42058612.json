      "cues": [
        {
          "id": 1,
          "start": 2.93,
          "end": 6.2,
          "en": "Tähän asti olemme siis pystyneet varmistamaan hakemuksen.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 6.2,
          "end": 9.56,
          "en": "Ja sitten teemme sen käyttäjätunnuksen ja salasanan avulla.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 9.59,
          "end": 13.88,
          "en": "Itse asiassa yksi asia, jota emme ole nähneet, on, jos avaan selaimen nyt.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 13.88,
          "end": 20.84,
          "en": "Avataan siis incognito-tila, koska joku saattaa olla jo siellä, ja siirryn localhost-pistekolonniin",
          "zh": ""
        },
        {
          "id": 5,
          "start": 20.84,
          "end": 22.28,
          "en": "8080-viivalla.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 22.28,
          "end": 23,
          "en": "Hei.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 23,
          "end": 26.27,
          "en": "Ja jos astut sisään, näet, että saamme ponnahdusikkunan tänne.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 26.27,
          "end": 27.65,
          "en": "Ei lomake.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 27.68,
          "end": 33.6,
          "en": "Syy tähän on se, että jos palaat takaisin koodiisi ja siihen, mitä olemme tehneet konfiguraatiossa, olemme periaatteessa sanoneet,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 33.6,
          "end": 37.83,
          "en": "että haluamme käyttää HTTP-perustodennusta, emme lomakkeella kirjautumista.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 37.83,
          "end": 39.39,
          "en": "Siksi emme saa kirjautumislomaketta.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 39.39,
          "end": 41.25,
          "en": "Saamme kehotuksen.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 41.25,
          "end": 43.02,
          "en": "Ja tietenkin se toimii täällä.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 43.02,
          "end": 47.88,
          "en": "Jos siis määrität listan go ja 1234 ja sitten sanot kirjaudu sisään, tämä toimii hyvin.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 47.88,
          "end": 51.54,
          "en": "Ja tietenkin aina kun päivität, saat uuden istuntotunnuksen.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 51.54,
          "end": 57.51,
          "en": "Ja jos haluat kirjautua uudelleen sisään, sinun on tietenkin suljettava se, koska uloskirjautuminen ei toimi nyt, koska emme ole",
          "zh": ""
        },
        {
          "id": 17,
          "start": 57.51,
          "end": 59.61,
          "en": "lisänneet uloskirjautumissuodatinta.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 59.61,
          "end": 63.7,
          "en": "Joten jos sanon kirjaudu ulos enter se ei toimi.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 63.7,
          "end": 67.54,
          "en": "Periaatteessa emme siis aio kirjautua ulos, koska teemme stateless-toimintoa.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 67.54,
          "end": 71.28999999999999,
          "en": "Joka kerta kun lähetät pyynnön, sinun on periaatteessa lähetettävä tiedot.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 71.28999999999999,
          "end": 75.55,
          "en": "Jos käytät Rest APIa, vaikka avaisit uuden incognito-tilan, se ottaa istunnon, joten",
          "zh": ""
        },
        {
          "id": 22,
          "start": 75.55,
          "end": 77.05,
          "en": "voit sulkea sen tästä.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 77.05,
          "end": 77.95,
          "en": "Sen pitäisi toimia.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 77.95,
          "end": 80.44,
          "en": "Palatakseni takaisin koodiin, halusin näyttää teille yhden asian.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 80.44,
          "end": 84.4,
          "en": "Nyt haluan tehdä sen, että käyttäjätunnus ja salasana on vahvistettu, eikö niin?",
          "zh": ""
        },
        {
          "id": 26,
          "start": 84.4,
          "end": 89.5,
          "en": "Tietenkin ennen näiden asetusten tekemistä saimme käyttäjätunnuksen käyttäjänä ja salasanan, jonka saimme",
          "zh": ""
        },
        {
          "id": 27,
          "start": 89.5,
          "end": 90.38,
          "en": "konsoliin.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 90.38,
          "end": 94.1,
          "en": "Mutta nyt olen täsmentänyt, että hei, käyttäjänimi, jonka haluan valita, on teleskooppi.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 94.13,
          "end": 96.02000000000001,
          "en": "Haluamani salasana on 1234.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 96.02000000000001,
          "end": 98.53999999999999,
          "en": "Entä jos haluat useita käyttäjiä?",
          "zh": ""
        },
        {
          "id": 31,
          "start": 98.53999999999999,
          "end": 102.77000000000001,
          "en": "Koska tässä sovelluksessa on lopulta vain yksi käyttäjä.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 102.77000000000001,
          "end": 103.75999999999999,
          "en": "En halua sitä.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 103.75999999999999,
          "end": 105.32,
          "en": "Haluan useita käyttäjiä.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 105.32,
          "end": 108.35,
          "en": "Siinä tapauksessa meidän on tehtävä asetukset.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 108.35,
          "end": 114.32,
          "en": "Emme siis halua vain useita käyttäjiä, vaan haluamme, että käyttäjät tulevat tietokannasta, eikö niin?",
          "zh": ""
        },
        {
          "id": 36,
          "start": 114.32,
          "end": 116.09,
          "en": "Koodaamme arvot kovalla koodilla.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 116.09,
          "end": 120.51,
          "en": "Asia ei toimi näin, vaan aina kun joku kirjautuu sovellukseen, meidän on periaatteessa tallennettava",
          "zh": ""
        },
        {
          "id": 38,
          "start": 120.51,
          "end": 123.6,
          "en": "hänen tietonsa tietokantaan, josta hän voi kirjautua sisään.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 123.6,
          "end": 124.77,
          "en": "Nuo nuo valtakirjat.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 124.77,
          "end": 130.74,
          "en": "Joten tässä sarjassa keskitymme nyt siihen, miten voimme saada useita käyttäjätunnuksia ja salasanoja.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 130.74,
          "end": 131.94,
          "en": "Aloitamme muistista.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 131.94,
          "end": 135.72,
          "en": "Sitten siirrymme hitaasti siihen, että tiedot ovat tietokannassa.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 135.72,
          "end": 138.36,
          "en": "Ja miten voimme turvata sen.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 138.36,
          "end": 143.19,
          "en": "Koska emme halua tallentaa tietoja tai salasanaa pelkkänä tekstinä palvelimelle.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 143.19,
          "end": 144.32999999999998,
          "en": "Se olisi siis koodattava.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 144.32999999999998,
          "end": 148.14,
          "en": "Keskitymme siis kaikkeen tulevissa videoissa.",
          "zh": ""
        }
      ]
    }
