      "sourceHash": "d39cede68a8ec9f72603b58f92553ffec183186cd40f37aa8b3b985f0cfca01f",
      "sourceLanguage": "en",
      "cues": [
        {
          "id": 1,
          "start": 0.069,
          "end": 3.21,
          "en": "(mellow bright music)",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.21,
          "end": 5.49,
          "en": "-: In this video, we'll talk about REST,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.49,
          "end": 9.24,
          "en": "which stands for Representational State Transfer.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.24,
          "end": 11.52,
          "en": "See, the thing is, if we talk about a web application,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.52,
          "end": 14.13,
          "en": "most of the time, we work with data, right?",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.13,
          "end": 16.14,
          "en": "Creating data, reading data,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 16.14,
          "end": 18,
          "en": "updating data, and deleting data.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 18,
          "end": 21.12,
          "en": "We can also call this as a CRUD operation:",
          "zh": ""
        },
        {
          "id": 9,
          "start": 21.12,
          "end": 23.37,
          "en": "create, read, update, and delete.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 23.37,
          "end": 26.4,
          "en": "So what we basically do is you want to create some data",
          "zh": ""
        },
        {
          "id": 11,
          "start": 26.4,
          "end": 27.233,
          "en": "on the server.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 27.233,
          "end": 28.98,
          "en": "You want to get some data.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 28.98,
          "end": 30.06,
          "en": "You want to update some data.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 30.06,
          "end": 31.8,
          "en": "You want to delete some data.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 31.8,
          "end": 33.18,
          "en": "To achieve this, first of all,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 33.18,
          "end": 34.92,
          "en": "we have to consider this data,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 34.92,
          "end": 37.05,
          "en": "which is on the server, as a resource.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 37.05,
          "end": 37.92,
          "en": "I mean, think about this.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 37.92,
          "end": 39.81,
          "en": "Whenever you try to build an application,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 39.81,
          "end": 42.21,
          "en": "you create entities out of it, right?",
          "zh": ""
        },
        {
          "id": 21,
          "start": 42.21,
          "end": 43.92,
          "en": "So let's say if you talk about the job application,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 43.92,
          "end": 44.97,
          "en": "which you are building,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 44.97,
          "end": 45.99,
          "en": "in this job application,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 45.99,
          "end": 49.62,
          "en": "we can think about job itself as one entity, right?",
          "zh": ""
        },
        {
          "id": 25,
          "start": 49.62,
          "end": 51.24,
          "en": "Maybe you can also think about",
          "zh": ""
        },
        {
          "id": 26,
          "start": 51.24,
          "end": 53.31,
          "en": "if you want to maintain the employee details,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 53.31,
          "end": 54.143,
          "en": "which we are not doing,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 54.143,
          "end": 55.83,
          "en": "but let's say if you have employee details,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 55.83,
          "end": 57.66,
          "en": "so employee becomes one entity.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 57.66,
          "end": 59.1,
          "en": "Your job is one entity.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 59.1,
          "end": 60.45,
          "en": "Let's say you have an admin,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 60.45,
          "end": 62.52,
          "en": "so admin becomes one entity.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 62.52,
          "end": 64.98,
          "en": "Let's say you want to also represent some companies there.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 64.98,
          "end": 66.66,
          "en": "So if you're an employer,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 66.66,
          "end": 68.67,
          "en": "first, you have to talk about your own company,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 68.67,
          "end": 71.1,
          "en": "why someone should join your company, right?",
          "zh": ""
        },
        {
          "id": 37,
          "start": 71.1,
          "end": 73.98,
          "en": "So this is your employer profile.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 73.98,
          "end": 75.33,
          "en": "So that's your one entity.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 75.33,
          "end": 77.85,
          "en": "So basically what we have is in your application,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 77.85,
          "end": 79.26,
          "en": "we have different entities.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 79.26,
          "end": 81.013,
          "en": "Each entity you can represent,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 81.013,
          "end": 83.37,
          "en": "you can think about them as a resource, right?",
          "zh": ""
        },
        {
          "id": 43,
          "start": 83.37,
          "end": 85.98,
          "en": "You have a job resource, you have a employee resource,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 85.98,
          "end": 88.35,
          "en": "you have a employer resource.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 88.35,
          "end": 90.69,
          "en": "So what we are doing is we are just working",
          "zh": ""
        },
        {
          "id": 46,
          "start": 90.69,
          "end": 92.58,
          "en": "with a resource here, right?",
          "zh": ""
        },
        {
          "id": 47,
          "start": 92.58,
          "end": 95.4,
          "en": "Now when I say, \"I want to add a new job,\"",
          "zh": ""
        },
        {
          "id": 48,
          "start": 95.4,
          "end": 97.89,
          "en": "now that is one resource, right?",
          "zh": ""
        },
        {
          "id": 49,
          "start": 97.89,
          "end": 99.42,
          "en": "Now, whatever data you have in a server,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 99.42,
          "end": 101.13,
          "en": "of course they will be changing, right?",
          "zh": ""
        },
        {
          "id": 51,
          "start": 101.13,
          "end": 103.65,
          "en": "So let's say if you talk about employee data.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 103.65,
          "end": 105.24000000000001,
          "en": "So an employee,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 105.24000000000001,
          "end": 108.63,
          "en": "maybe you have a section there which says current employer,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 108.63,
          "end": 110.67,
          "en": "which is null at this point.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 110.67,
          "end": 112.35,
          "en": "And after some time you got a job,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 112.35,
          "end": 115.25999999999999,
          "en": "so the current employer will change to something else.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 115.25999999999999,
          "end": 117.24000000000001,
          "en": "Maybe it'll become Google, Microsoft,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 117.24000000000001,
          "end": 118.2,
          "en": "Telusko, doesn't matter.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 118.2,
          "end": 121.895,
          "en": "So what happens is you update those resources, right?",
          "zh": ""
        },
        {
          "id": 60,
          "start": 121.895,
          "end": 124.38,
          "en": "But if you think about a moment,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 124.38,
          "end": 126.96,
          "en": "at this moment, what's the value?",
          "zh": ""
        },
        {
          "id": 62,
          "start": 126.96,
          "end": 129.33,
          "en": "So let's say at this moment, the value is Microsoft.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 129.33,
          "end": 131.58,
          "en": "Maybe after a few months, it becomes Telusko.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 131.58,
          "end": 133.92,
          "en": "After a few months, it's become some other company.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 133.92,
          "end": 135.96,
          "en": "So what we are doing is we are changing, right?",
          "zh": ""
        },
        {
          "id": 66,
          "start": 135.96,
          "end": 137.46,
          "en": "But at a given point,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 137.46,
          "end": 140.49,
          "en": "you got some value that is called a state.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 140.49,
          "end": 142.447,
          "en": "So example, at this point, if I say,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 142.447,
          "end": 144.66,
          "en": "\"Hey, give me the data about the employee,\"",
          "zh": ""
        },
        {
          "id": 70,
          "start": 144.66,
          "end": 147.6,
          "en": "of course, employee will have a name, ID,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 147.6,
          "end": 149.88,
          "en": "or some other details, which will be fixed, right?",
          "zh": ""
        },
        {
          "id": 72,
          "start": 149.88,
          "end": 151.82999999999998,
          "en": "You don't change your name often.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 151.82999999999998,
          "end": 155.37,
          "en": "You might, but most of the time it is fixed.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 155.37,
          "end": 156.69,
          "en": "You might be having an ID,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 156.69,
          "end": 158.07,
          "en": "which is common for the application,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 158.07,
          "end": 158.91,
          "en": "so it will be fixed.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 158.91,
          "end": 160.35,
          "en": "Maybe you have address as well,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 160.35,
          "end": 163.44,
          "en": "which will not change frequently, but it might.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 163.44,
          "end": 164.61,
          "en": "But what about the employer?",
          "zh": ""
        },
        {
          "id": 80,
          "start": 164.61,
          "end": 167.34,
          "en": "You know, people do switch job every few months nowadays,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 167.34,
          "end": 169.607,
          "en": "so that thing is keep changing, right?",
          "zh": ""
        },
        {
          "id": 82,
          "start": 169.607,
          "end": 173.7,
          "en": "But at a given point, we can call it as a state.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 173.7,
          "end": 175.68,
          "en": "So if you fetch now, you will get a different state.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 175.68,
          "end": 178.77,
          "en": "If you fetch later, you will get a different state.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 178.77,
          "end": 181.53,
          "en": "So what you have to do is you just have to send the state",
          "zh": ""
        },
        {
          "id": 86,
          "start": 181.53,
          "end": 182.363,
          "en": "to the client",
          "zh": ""
        },
        {
          "id": 87,
          "start": 182.363,
          "end": 184.29,
          "en": "because client is asking for data, right?",
          "zh": ""
        },
        {
          "id": 88,
          "start": 184.29,
          "end": 186.39,
          "en": "So client says, \"Hey, I want the details",
          "zh": ""
        },
        {
          "id": 89,
          "start": 186.39,
          "end": 187.71,
          "en": "about this employee.\"",
          "zh": ""
        },
        {
          "id": 90,
          "start": 187.71,
          "end": 190.32,
          "en": "So servers will say, \"Okay, let me send the current state,\"",
          "zh": ""
        },
        {
          "id": 91,
          "start": 190.32,
          "end": 192.18,
          "en": "so the server will send it.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 192.18,
          "end": 193.47,
          "en": "So we are sending a state,",
          "zh": ""
        },
        {
          "id": 93,
          "start": 193.47,
          "end": 196.44,
          "en": "but also we have to send that in a proper format.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 196.44,
          "end": 197.324,
          "en": "So we will say,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 197.324,
          "end": 200.04,
          "en": "\"Let's make it a proper presentable thing,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 200.04,
          "end": 202.26,
          "en": "presentational state.\"",
          "zh": ""
        },
        {
          "id": 97,
          "start": 202.26,
          "end": 204.51,
          "en": "So that is your representational state.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 204.51,
          "end": 207.48,
          "en": "And then we have to also make sure that we are transferring.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 207.48,
          "end": 210.03,
          "en": "So it is transfer, that is REST, right?",
          "zh": ""
        },
        {
          "id": 100,
          "start": 210.03,
          "end": 213.45,
          "en": "So important thing is you are transferring state here.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 213.45,
          "end": 215.88,
          "en": "Also, remember when you talk about REST as architecture,",
          "zh": ""
        },
        {
          "id": 102,
          "start": 215.88,
          "end": 218.16,
          "en": "you have to use it as a stateless,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 218.16,
          "end": 220.68,
          "en": "which means when a client talk to the server",
          "zh": ""
        },
        {
          "id": 104,
          "start": 220.68,
          "end": 222.21,
          "en": "for the first time,",
          "zh": ""
        },
        {
          "id": 105,
          "start": 222.21,
          "end": 224.017,
          "en": "client has to mention all the details, right?",
          "zh": ""
        },
        {
          "id": 106,
          "start": 224.017,
          "end": 225.27,
          "en": "\"Hey, I want this data.",
          "zh": ""
        },
        {
          "id": 107,
          "start": 225.27,
          "end": 227.76,
          "en": "Why I want this data because I have this login.\"",
          "zh": ""
        },
        {
          "id": 108,
          "start": 227.76,
          "end": 230.13,
          "en": "Maybe you have to also implement security there.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 230.13,
          "end": 232.44,
          "en": "But when a client comes for the second time,",
          "zh": ""
        },
        {
          "id": 110,
          "start": 232.44,
          "end": 235.59,
          "en": "you cannot expect from the server that server knows you",
          "zh": ""
        },
        {
          "id": 111,
          "start": 235.59,
          "end": 238.26,
          "en": "because every request is stateless, okay?",
          "zh": ""
        },
        {
          "id": 112,
          "start": 238.26,
          "end": 240.24,
          "en": "So every time you talk to a server,",
          "zh": ""
        },
        {
          "id": 113,
          "start": 240.24,
          "end": 241.5,
          "en": "you have to talk about who you are,",
          "zh": ""
        },
        {
          "id": 114,
          "start": 241.5,
          "end": 242.97,
          "en": "why you're asking for it.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 242.97,
          "end": 244.47,
          "en": "So that's one thing.",
          "zh": ""
        },
        {
          "id": 116,
          "start": 244.47,
          "end": 249.47,
          "en": "Next, in the REST API, we use something called a noun.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 249.51,
          "end": 251.94,
          "en": "So example, if you talk about our code here,",
          "zh": ""
        },
        {
          "id": 118,
          "start": 251.94,
          "end": 255.51,
          "en": "we were using view all jobs, add a job.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 255.51,
          "end": 257.7,
          "en": "So basically we were using actions, right?",
          "zh": ""
        },
        {
          "id": 120,
          "start": 257.7,
          "end": 261.21,
          "en": "So in the URL, we were basically using actions, words.",
          "zh": ""
        },
        {
          "id": 121,
          "start": 261.21,
          "end": 264.42,
          "en": "But now in REST API, you will not be using actions.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 264.42,
          "end": 267,
          "en": "We'll be using something called a noun.",
          "zh": ""
        },
        {
          "id": 123,
          "start": 267,
          "end": 269.04,
          "en": "Example, let's say if you want details about the jobs,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 269.04,
          "end": 270,
          "en": "you can simply say:",
          "zh": ""
        },
        {
          "id": 125,
          "start": 270,
          "end": 272.97,
          "en": "localhost:8080/jobs.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 272.97,
          "end": 275.031,
          "en": "If you want to add a job, you will say:",
          "zh": ""
        },
        {
          "id": 127,
          "start": 275.031,
          "end": 277.68,
          "en": "localhost:8080/job.",
          "zh": ""
        },
        {
          "id": 128,
          "start": 277.68,
          "end": 280.283,
          "en": "If you want to get one job, you will say:",
          "zh": ""
        },
        {
          "id": 129,
          "start": 280.283,
          "end": 282.09000000000003,
          "en": "localhost:8080/job.",
          "zh": ""
        },
        {
          "id": 130,
          "start": 282.09000000000003,
          "end": 284.13,
          "en": "But is it matching with the add job?",
          "zh": ""
        },
        {
          "id": 131,
          "start": 284.13,
          "end": 285.99,
          "en": "How do you differentiate between this two?",
          "zh": ""
        },
        {
          "id": 132,
          "start": 285.99,
          "end": 288.03,
          "en": "Add job also has the same URL,",
          "zh": ""
        },
        {
          "id": 133,
          "start": 288.03,
          "end": 290.28,
          "en": "get job also has the same URL,",
          "zh": ""
        },
        {
          "id": 134,
          "start": 290.28,
          "end": 291.15,
          "en": "how it will work?",
          "zh": ""
