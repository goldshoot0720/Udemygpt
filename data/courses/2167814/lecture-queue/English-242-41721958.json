          "en": "is 2.15.3.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 153.72,
          "end": 154.82999999999998,
          "en": "Let's pick up the same one.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 154.82999999999998,
          "end": 158.16,
          "en": "Copy dependency, go back to your project, and paste it here.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 158.16,
          "end": 158.993,
          "en": "That's it.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 158.993,
          "end": 160.11,
          "en": "Once you add this,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 160.11,
          "end": 162.57,
          "en": "of course, since we have changed the Maven,",
