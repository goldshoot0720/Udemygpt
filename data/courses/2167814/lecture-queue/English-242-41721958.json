        },
        {
          "id": 42,
          "start": 100.731,
          "end": 103.8,
          "en": "Okay, but then why XML is not working?",
          "zh": ""
        },
        {
          "id": 43,
          "start": 103.8,
          "end": 106.28999999999999,
          "en": "It should also return XML format, right?",
          "zh": ""
        },
        {
          "id": 44,
          "start": 106.28999999999999,
          "end": 107.67,
          "en": "See, the thing is,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 107.67,
          "end": 109.68,
          "en": "by default, the Jackson Library, which you have added,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 109.68,
          "end": 110.74000000000001,
          "en": "only works with JSON.",
