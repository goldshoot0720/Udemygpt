        },
        {
          "id": 63,
          "start": 149.4,
          "end": 150.51,
          "en": "just pick up the same version.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 150.51,
          "end": 152.07,
          "en": "So, you can see the version which we're using here",
          "zh": ""
        },
        {
          "id": 65,
          "start": 152.07,
