        },
        {
          "id": 52,
          "start": 105.87,
          "end": 107.55,
          "en": "with a request \"add\".",
          "zh": ""
        },
        {
          "id": 53,
          "start": 107.55,
          "end": 108.9,
          "en": "Now, this controller,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 108.9,
          "end": 110.7,
          "en": "the Front controller in Spring Framework",
          "zh": ""
        },
        {
          "id": 55,
          "start": 110.7,
          "end": 113.34,
          "en": "is called a DispatcherServlet.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 113.34,
          "end": 116.58,
