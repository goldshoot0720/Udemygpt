        },
        {
          "id": 47,
          "start": 97.44,
          "end": 98.61,
          "en": "You are saying add.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 98.61,
          "end": 99.9,
          "en": "Now, you have a controller there",
          "zh": ""
        },
        {
          "id": 49,
          "start": 99.9,
          "end": 101.88,
          "en": "who is responsible to add two numbers.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 101.88,
          "end": 103.56,
          "en": "Now, your front controller will know that,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 103.56,
          "end": 105.87,
          "en": "hey, we have a controller there who can add two numbers",
