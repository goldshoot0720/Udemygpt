        },
        {
          "id": 41,
          "start": 86.13,
          "end": 87.33,
          "en": "to a particular controller.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 87.33,
          "end": 89.13,
          "en": "So let's say if you request for the homepage,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 89.13,
          "end": 91.5,
          "en": "it is a job of your Front controller to know",
          "zh": ""
        },
        {
          "id": 44,
          "start": 91.5,
          "end": 92.88,
          "en": "that I have a controller here",
          "zh": ""
        },
        {
          "id": 45,
          "start": 92.88,
          "end": 95.67,
          "en": "who can accept the request for the homepage.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 95.67,
          "end": 97.44,
          "en": "Let's say you request for an addition of two numbers.",
