        },
        {
          "id": 64,
          "start": 139.17000000000002,
          "end": 141.18,
          "en": "because if you get the key, you are gone.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 141.18,
          "end": 142.92000000000002,
          "en": "All the passwords are linked.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 142.92000000000002,
          "end": 144.09,
          "en": "The other way you can do",
          "zh": ""
        },
        {
          "id": 67,
