        },
        {
          "id": 34,
          "start": 69.738,
          "end": 73.14,
          "en": "So not just we are storing data in a plain text,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 73.14,
          "end": 76.86,
          "en": "but also we are transferring this data in a plain text.",
