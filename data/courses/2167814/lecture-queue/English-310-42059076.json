        },
        {
          "id": 73,
          "start": 159.32999999999998,
          "end": 162.51,
          "en": "Now let's say this is your hash, okay?",
          "zh": ""
        },
        {
          "id": 74,
          "start": 162.51,
          "end": 164.19,
          "en": "Now hash is basically one way.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 164.19,
          "end": 166.68,
          "en": "So for every data, you will get only one hash.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 166.68,
          "end": 168.09,
          "en": "There's no collision here.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 168.09,
          "end": 170.34,
          "en": "Now what will happen is you can't get it back.",
