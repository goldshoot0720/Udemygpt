        },
        {
          "id": 72,
          "start": 160.17000000000002,
          "end": 161.61,
          "en": "because that's where this thing starts.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 161.61,
          "end": 162.44299999999998,
          "en": "So that's your root.",
