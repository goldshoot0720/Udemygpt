          "zh": ""
        },
        {
          "id": 45,
          "start": 100.65,
          "end": 102.75,
          "en": "these are your nodes, okay?",
          "zh": ""
        },
        {
          "id": 46,
          "start": 102.75,
          "end": 104.88,
          "en": "And the same thing we have done in LinkedList as well.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 104.88,
          "end": 106.83,
          "en": "Next we have something called root.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 106.83,
          "end": 109.68,
