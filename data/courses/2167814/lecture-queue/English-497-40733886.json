        },
        {
          "id": 77,
          "start": 169.23,
          "end": 170.52,
          "en": "It's your edge.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 170.52,
          "end": 172.77,
          "en": "So this line here is edge.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 172.77,
          "end": 174.03,
          "en": "So we have talked about node.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 174.03,
          "end": 176.07,
          "en": "So node is something where you save data.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 176.07,
          "end": 178.92000000000002,
          "en": "Root is the top most parent node.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 178.92000000000002,
          "end": 181.44,
          "en": "We have edge, which connects different nodes.",
