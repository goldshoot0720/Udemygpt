        },
        {
          "id": 71,
          "start": 132.06,
          "end": 133.77,
          "en": "so I'll be using that example.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 133.77,
          "end": 136.65,
          "en": "So if we talk about this phone here,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 136.65,
          "end": 138.36,
