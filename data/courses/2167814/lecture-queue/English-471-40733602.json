        },
        {
          "id": 75,
          "start": 139.193,
          "end": 140.19,
          "en": "it'll have a brand.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 140.19,
          "end": 141.75,
          "en": "Of course, name is model number.",
