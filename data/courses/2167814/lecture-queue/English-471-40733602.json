        },
        {
          "id": 90,
          "start": 165.72,
          "end": 167.43,
          "en": "what are the properties there.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 167.43,
          "end": 168.263,
          "en": "In the same way,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 168.263,
          "end": 169.98,
          "en": "in the object oriented languages,",
          "zh": ""
        },
        {
          "id": 93,
          "start": 169.98,
          "end": 171.36,
          "en": "we use something called class.",
