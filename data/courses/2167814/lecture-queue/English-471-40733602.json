        },
        {
          "id": 18,
          "start": 26.94,
          "end": 28.23,
          "en": "you process data,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 28.23,
          "end": 30.15,
          "en": "you also give the output to the user,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 30.15,
          "end": 33.09,
