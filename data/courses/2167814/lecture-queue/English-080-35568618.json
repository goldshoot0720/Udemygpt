        },
        {
          "id": 11,
          "start": 27.384,
          "end": 30.18,
          "en": "to the compiler or to the runtime.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 30.18,
          "end": 31.32,
          "en": "How do we do that?",
          "zh": ""
        },
        {
          "id": 13,
          "start": 31.32,
          "end": 34.59,
