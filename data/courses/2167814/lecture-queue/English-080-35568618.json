        },
        {
          "id": 67,
          "start": 176.67000000000002,
          "end": 178.02,
          "en": "is logical problems.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 178.02,
          "end": 179.46,
          "en": "You know, we always say in programming",
          "zh": ""
        },
        {
          "id": 69,
          "start": 179.46,
          "end": 181.171,
          "en": "that you spend less time in coding",
