        },
        {
          "id": 34,
          "start": 77.73,
          "end": 80.49,
          "en": "Now, logical error means everything is working,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 80.49,
          "end": 82.74,
          "en": "there's no compiled time issue, everything is working.",
