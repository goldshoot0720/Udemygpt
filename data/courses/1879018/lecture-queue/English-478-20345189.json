        },
        {
          "id": 12,
          "start": 29.76,
          "end": 32.45,
          "en": "which as you saw in the Node parts of this course,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 32.45,
          "end": 34.86,
          "en": "makes working with MongoDB much easier.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 34.86,
          "end": 37.17,
          "en": "We don't have that here, for example.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 37.17,
          "end": 40.41,
          "en": "Also, a lot of those third-party modules",
          "zh": ""
        },
        {
          "id": 16,
          "start": 40.41,
          "end": 43.09,
          "en": "but also a lot of the standard library modules",
          "zh": ""
        },
        {
          "id": 17,
          "start": 43.09,
          "end": 44.88,
          "en": "are work in progress,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 44.88,
          "end": 47.27,
          "en": "which means they can change over time,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 47.27,
          "end": 48.69,
          "en": "they can contain bugs,",
          "zh": ""
        },
        {
          "id": 20,
