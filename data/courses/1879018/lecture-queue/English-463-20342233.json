        },
        {
          "id": 10,
          "start": 24.63,
          "end": 27.28,
          "en": "Deno is secure by default.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 27.28,
          "end": 28.97,
          "en": "What does this mean?",
          "zh": ""
        },
        {
          "id": 12,
          "start": 28.97,
          "end": 32.12,
          "en": "It does not mean that Deno code that we write,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 32.12,
          "end": 36.5,
          "en": "is more or less secure than node code.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 36.5,
          "end": 39.24,
          "en": "It's us who write the code, and we as a developer,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 39.24,
          "end": 41.71,
          "en": "we can write good, and we can write bad code.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 41.71,
          "end": 45.19,
          "en": "So just because we use Deno does not mean,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 45.19,
          "end": 47.87,
          "en": "that our code is always secure.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 47.87,
          "end": 52.21,
