          "zh": ""
        },
        {
          "id": 19,
          "start": 52.21,
          "end": 54.01,
          "en": "This means something else,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 54.01,
          "end": 56.62,
          "en": "it means that when we run a script",
          "zh": ""
        },
        {
          "id": 21,
          "start": 56.62,
          "end": 60.25,
          "en": "with Deno, that script does not by default,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 60.25,
