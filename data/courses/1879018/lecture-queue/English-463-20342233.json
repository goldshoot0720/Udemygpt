        },
        {
          "id": 42,
          "start": 117.00999999999999,
          "end": 120.19,
          "en": "By default, when you execute code with Deno,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 120.19,
          "end": 123.65,
          "en": "that code may not write to files,",
          "zh": ""
        },
