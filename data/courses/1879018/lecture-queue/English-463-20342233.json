        },
        {
          "id": 50,
          "start": 145.76,
          "end": 147.61,
          "en": "it probably would be the more correct term,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 147.61,
          "end": 149.27,
          "en": "I simply got started with Deno,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 149.27,
          "end": 151.97,
          "en": "and I can't get rid of it Sorry.",
          "zh": ""
        },
        {
          "id": 53,
