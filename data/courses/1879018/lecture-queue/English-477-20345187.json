          "zh": ""
        },
        {
          "id": 60,
          "start": 158.57,
          "end": 161.45,
          "en": "and that syntax is $set,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 161.45,
          "end": 164.11,
          "en": "and then we define the key value pairs",
          "zh": ""
        },
        {
          "id": 62,
          "start": 164.11,
          "end": 167.09,
          "en": "where we wanna set a new value.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 167.09,
          "end": 170.653,
          "en": "And here, at the end, I want to set text to a new value,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 171.84,
          "end": 175.16,
          "en": "and I want to set it to data.value.text,",
