        },
        {
          "id": 92,
          "start": 288.51,
          "end": 290.13,
          "en": "to make this a bit more meaningful",
          "zh": ""
        },
        {
          "id": 93,
          "start": 290.13,
          "end": 292.863,
          "en": "and useful to the users of our app.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 294.141,
          "end": 297.81,
          "en": "So that's my first MealItemTrait being used here.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 297.81,
          "end": 299.883,
          "en": "If I save this and reload,",
