      "sourceHash": "5eef4071193e8498247bbe842fa6a77fc7b59b7b1722035790b1fa92a8e824b4",
      "cues": [
        {
          "id": 1,
          "start": 2.07,
          "end": 3.69,
          "en": "So it's a River Pod time.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.69,
          "end": 7.74,
          "en": "Because I wanna manage my places in some app wide state",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.74,
          "end": 9.57,
          "en": "that can be accessed by different widgets",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.57,
          "end": 11.823,
          "en": "from any place in the app.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.72,
          "end": 14.866,
          "en": "For that, I will have to install",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.866,
          "end": 17.37,
          "en": "this Flutter River Pod package",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.37,
          "end": 18.75,
          "en": "about which you learned earlier.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 18.75,
          "end": 22.773,
          "en": "And this can be done with flutter pub add flutter_riverpod.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 25.093,
          "end": 27.84,
          "en": "Of course, you can also simply search for flutter riverpod",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.84,
          "end": 30,
          "en": "and visit the official documentation page",
          "zh": ""
        },
        {
          "id": 11,
          "start": 30,
          "end": 33.42,
          "en": "or the package page to learn more about how to",
          "zh": ""
        },
        {
          "id": 12,
          "start": 33.42,
          "end": 36.033,
          "en": "use this package and how to install it.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 37.02,
          "end": 38.58,
          "en": "And with it installed,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 38.58,
          "end": 41.22,
          "en": "we can go back to our project here.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 41.22,
          "end": 43.77,
          "en": "And in there I'll add a new folder, in the lib folder,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 43.77,
          "end": 45.15,
          "en": "which I'll name providers",
          "zh": ""
        },
        {
          "id": 17,
          "start": 45.15,
          "end": 47.247,
          "en": "because you might recall that with riverpod",
          "zh": ""
        },
        {
          "id": 18,
          "start": 47.247,
          "end": 50.329,
          "en": "you can set up so-called state providers.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 50.329,
          "end": 53.28,
          "en": "And in this providers folder I'll add one new file,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 53.28,
          "end": 56.22,
          "en": "which I'll name user_places.dart",
          "zh": ""
        },
        {
          "id": 21,
          "start": 56.22,
          "end": 59.04,
          "en": "which will be responsible for managing those places",
          "zh": ""
        },
        {
          "id": 22,
          "start": 59.04,
          "end": 62.55,
          "en": "selected by the user or added by the user.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 62.55,
          "end": 64.59,
          "en": "Now in this file you should add a import",
          "zh": ""
        },
        {
          "id": 24,
          "start": 64.59,
          "end": 68.81,
          "en": "to this Flutter River Pod package",
          "zh": ""
        },
        {
          "id": 25,
          "start": 68.81,
          "end": 72.84,
          "en": "so that we can use its functionality in this file.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 72.84,
          "end": 76.14,
          "en": "And then here I want to add a notifier class",
          "zh": ""
        },
        {
          "id": 27,
          "start": 76.14,
          "end": 78.42,
          "en": "because you might recall that you can create",
          "zh": ""
        },
        {
          "id": 28,
          "start": 78.42,
          "end": 81.42,
          "en": "such notifier classes with River Pod",
          "zh": ""
        },
        {
          "id": 29,
          "start": 81.42,
          "end": 84.53999999999999,
          "en": "to have a class where you can add methods that allow you",
          "zh": ""
        },
        {
          "id": 30,
          "start": 84.53999999999999,
          "end": 88.03,
          "en": "to manipulate the state that's managed by River Pod",
          "zh": ""
        },
        {
          "id": 31,
          "start": 89.19,
          "end": 91.5,
          "en": "and that's exactly what I wanna do here.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 91.5,
          "end": 95.82,
          "en": "So I'll add a user places notifier class here,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 95.82,
          "end": 98.75999999999999,
          "en": "which must extend state notifier,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 98.75999999999999,
          "end": 101.7,
          "en": "which is a class provided by a River Pod.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 101.7,
          "end": 104.97,
          "en": "And state notifier is actually a generic class",
          "zh": ""
        },
        {
          "id": 36,
          "start": 104.97,
          "end": 108.18,
          "en": "where we should add some annotation that tells",
          "zh": ""
        },
        {
          "id": 37,
          "start": 108.18,
          "end": 111.45,
          "en": "River Pod and Dart which kind of data will in the end",
          "zh": ""
        },
        {
          "id": 38,
          "start": 111.45,
          "end": 114.33,
          "en": "be managed by our notifier class here and here.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 114.33,
          "end": 116.28,
          "en": "And here the data I do wanna manage",
          "zh": ""
        },
        {
          "id": 40,
          "start": 116.28,
          "end": 121.023,
          "en": "will be that list of places using my custom place model.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 122.01,
          "end": 124.83,
          "en": "And for that of course we must import that model",
          "zh": ""
        },
        {
          "id": 42,
          "start": 124.83,
          "end": 127.02,
          "en": "by reaching out to our own package,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 127.02,
          "end": 130.08,
          "en": "which in my case here is called favorite places",
          "zh": ""
        },
        {
          "id": 44,
          "start": 130.08,
          "end": 132.98,
          "en": "and then there to the model's folder and then place start.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 133.98,
          "end": 136.47,
          "en": "So that's the base setup.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 136.47,
          "end": 139.41,
          "en": "In addition, you then must add a constructor function,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 139.41,
          "end": 141.42000000000002,
          "en": "which doesn't take any parameters,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 141.42000000000002,
          "end": 144.18,
          "en": "but which must have an initializer list",
          "zh": ""
        },
        {
          "id": 49,
          "start": 144.18,
          "end": 146.31,
          "en": "so that we can reach out to the super class",
          "zh": ""
        },
        {
          "id": 50,
          "start": 146.31,
          "end": 149.086,
          "en": "by calling Super, so to the parent class,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 149.086,
          "end": 152.79,
          "en": "and we can pass on our initial state.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 152.79,
          "end": 155.67000000000002,
          "en": "And the initial state here will be an empty list",
          "zh": ""
        },
        {
          "id": 53,
          "start": 155.67000000000002,
          "end": 157.495,
          "en": "and it's actually marked as const",
          "zh": ""
        },
        {
          "id": 54,
          "start": 157.495,
          "end": 161.01,
          "en": "because as you might recall the state managed",
          "zh": ""
        },
        {
          "id": 55,
          "start": 161.01,
          "end": 164.01,
          "en": "by a River Pod must not be mutated.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 164.01,
          "end": 166.82999999999998,
          "en": "You must not edit it in memory.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 166.82999999999998,
          "end": 169.07999999999998,
          "en": "Instead, if you want to add something to it,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 169.07999999999998,
          "end": 171.36,
          "en": "you should create a new state object,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 171.36,
          "end": 173.13,
          "en": "a new list in this case here,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 173.13,
          "end": 175.59,
          "en": "that could be based on the old state,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 175.59,
          "end": 178.86,
          "en": "but you should not edit the old state directly.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 178.86,
          "end": 181.68,
          "en": "And we make sure that we don't accidentally do that",
          "zh": ""
        },
        {
          "id": 63,
          "start": 181.68,
          "end": 184.68,
          "en": "and we instead would see an error if we tried to do it",
          "zh": ""
        },
        {
          "id": 64,
          "start": 184.68,
          "end": 186.783,
          "en": "by adding const in front of that list.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 187.98,
          "end": 191.893,
          "en": "So with that here I'm setting up this initial state",
          "zh": ""
        },
        {
          "id": 66,
          "start": 191.893,
          "end": 195.27,
          "en": "and now we can add a method here to this class",
          "zh": ""
        },
        {
          "id": 67,
          "start": 195.27,
          "end": 197.82,
          "en": "that allows us to add a new place.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 197.82,
          "end": 201.1,
          "en": "For this I'll add a new add place method",
          "zh": ""
        },
        {
          "id": 69,
          "start": 202.14,
          "end": 205.11,
          "en": "where I expect to get some input.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 205.11,
          "end": 210.11,
          "en": "To be precise I want to get my title of the place",
          "zh": ""
        },
        {
          "id": 71,
          "start": 210.21,
          "end": 212.91,
          "en": "that should be added and then in there",
          "zh": ""
        },
        {
          "id": 72,
          "start": 212.91,
          "end": 215.85,
          "en": "the goal is to create a new place object",
          "zh": ""
        },
        {
          "id": 73,
          "start": 215.85,
          "end": 219.062,
          "en": "and then that place object should be added to this list.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 219.062,
          "end": 222.78,
          "en": "By the way, if instead of the title you came up with",
          "zh": ""
        },
        {
          "id": 75,
          "start": 222.78,
          "end": 225.72,
          "en": "a solution where you expected the finished place",
          "zh": ""
        },
        {
          "id": 76,
          "start": 225.72,
          "end": 228.608,
          "en": "as an input that would of course also be fine.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 228.608,
          "end": 230.13,
          "en": "And in general,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 230.13,
          "end": 233.25,
          "en": "of course your solution will deviate from mine.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 233.25,
          "end": 235.02,
          "en": "It's all about practicing though,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 235.02,
          "end": 237.03,
          "en": "so by taking a look at my solution,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 237.03,
          "end": 238.82999999999998,
          "en": "you might get some new ideas",
          "zh": ""
        },
        {
          "id": 82,
          "start": 238.82999999999998,
          "end": 241.05,
          "en": "or you might also have some places",
          "zh": ""
        },
        {
          "id": 83,
          "start": 241.05,
          "end": 242.85,
          "en": "where you prefer your solution",
          "zh": ""
        },
        {
          "id": 84,
          "start": 242.85,
          "end": 245.103,
          "en": "and that's also absolutely fine.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 246.39,
          "end": 248.582,
          "en": "Here I'll accept a title though",
          "zh": ""
        },
        {
          "id": 86,
          "start": 248.582,
          "end": 252,
          "en": "and I'll then create a new place",
          "zh": ""
        },
        {
          "id": 87,
          "start": 252,
          "end": 255.18,
          "en": "by instantiating my place class",
          "zh": ""
        },
        {
          "id": 88,
          "start": 255.18,
          "end": 257.34,
          "en": "and setting the title parameter",
          "zh": ""
        },
        {
          "id": 89,
          "start": 257.34,
          "end": 259.323,
          "en": "to the title I'm getting here.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 260.37,
          "end": 263.7,
          "en": "With that new place added we want to add it to our state.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 263.7,
          "end": 265.44,
          "en": "And as mentioned, we're not allowed",
          "zh": ""
        },
        {
          "id": 92,
          "start": 265.44,
          "end": 267.54,
          "en": "to directly add that state.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 267.54,
          "end": 270.39,
          "en": "So therefore I'll instead set this state property",
          "zh": ""
        },
        {
          "id": 94,
          "start": 270.39,
          "end": 274.446,
          "en": "that's provided by state notifier equal to a new list.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 274.446,
          "end": 278.13,
          "en": "And in that new list I'll use that spread operator",
          "zh": ""
        },
        {
          "id": 96,
          "start": 278.13,
          "end": 279.63,
          "en": "about which you already learned",
          "zh": ""
        },
        {
          "id": 97,
          "start": 279.63,
          "end": 283.2,
          "en": "to spread my old state elements into this new list",
          "zh": ""
        },
        {
          "id": 98,
          "start": 283.2,
          "end": 284.95799999999997,
          "en": "so that we don't lose them,",
          "zh": ""
        },
        {
          "id": 99,
          "start": 284.95799999999997,
          "end": 289.32,
          "en": "but in addition I'll add my new place here like this",
          "zh": ""
        },
        {
          "id": 100,
          "start": 289.32,
          "end": 292.74,
          "en": "so that it's always at the start of the list,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 292.74,
          "end": 295.11,
          "en": "but that's of course optional.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 295.11,
          "end": 298.23,
          "en": "With that we have a method that will update the state",
          "zh": ""
        },
        {
          "id": 103,
          "start": 298.23,
          "end": 300,
          "en": "and that's all we need for now.",
          "zh": ""
        },
        {
          "id": 104,
          "start": 300,
          "end": 302.76,
          "en": "We now just also need to set up a provider,",
          "zh": ""
        },
        {
          "id": 105,
          "start": 302.76,
          "end": 305.973,
          "en": "a user places provider, for example,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 305.973,
          "end": 310.973,
          "en": "by using the built-in state notifier provider class,",
          "zh": ""
        },
        {
          "id": 107,
          "start": 312.51,
          "end": 314.16,
          "en": "which is created like this,",
          "zh": ""
        },
        {
          "id": 108,
          "start": 314.16,
          "end": 316.41,
          "en": "which takes a function as an input",
          "zh": ""
        },
        {
          "id": 109,
          "start": 316.41,
          "end": 318.48,
          "en": "to its constructive function.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 318.48,
          "end": 320.37,
          "en": "And in this function you automatically get",
          "zh": ""
        },
        {
          "id": 111,
          "start": 320.37,
          "end": 322.89,
          "en": "such a ref object which you could use to listen",
          "zh": ""
        },
        {
          "id": 112,
          "start": 322.89,
          "end": 325.59,
          "en": "to other providers as you learned.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 325.59,
          "end": 329.1,
          "en": "But here, I'll instead just return a new instance",
          "zh": ""
        },
        {
          "id": 114,
          "start": 329.1,
          "end": 332.578,
          "en": "of my user places notify class like this.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 332.578,
          "end": 336.9,
          "en": "And that is all, it's a very simple provider",
          "zh": ""
        },
        {
          "id": 116,
          "start": 336.9,
          "end": 339.693,
          "en": "and right now also a very simple class.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 341.34000000000003,
          "end": 343.14,
          "en": "With that provider added here,",
          "zh": ""
        },
        {
          "id": 118,
          "start": 343.14,
          "end": 345.911,
          "en": "we now have to make it available to the entire app,",
          "zh": ""
        },
        {
          "id": 119,
          "start": 345.911,
          "end": 349.26,
          "en": "which can be done from inside the main dart file",
          "zh": ""
        },
        {
          "id": 120,
          "start": 349.26,
          "end": 352.89,
          "en": "where I now want to import something.",
          "zh": ""
        },
        {
          "id": 121,
          "start": 352.89,
          "end": 354.51,
          "en": "For example, I want to import",
          "zh": ""
        },
        {
          "id": 122,
          "start": 354.51,
          "end": 357.278,
          "en": "from the Flutter River Pod package,",
          "zh": ""
        },
        {
          "id": 123,
          "start": 357.278,
          "end": 360.781,
          "en": "the Flutter River Pod dot Dart file.",
          "zh": ""
        },
        {
          "id": 124,
          "start": 360.781,
          "end": 363.34,
          "en": "And I'm just organizing my imports such",
          "zh": ""
        },
        {
          "id": 125,
          "start": 364.828,
          "end": 365.661,
          "en": "that the package imports come first",
          "zh": ""
        },
        {
          "id": 126,
          "start": 367.158,
          "end": 369.225,
          "en": "and then come the custom imports.",
          "zh": ""
        },
        {
          "id": 127,
          "start": 369.225,
          "end": 370.058,
          "en": "And now with that import added here",
          "zh": ""
        },
        {
          "id": 128,
          "start": 370.058,
          "end": 372.221,
          "en": "we can go down to Run app and wrap my app",
          "zh": ""
        },
        {
          "id": 129,
          "start": 372.221,
          "end": 377.221,
          "en": "with the provider scope widget,",
          "zh": ""
        },
        {
          "id": 130,
          "start": 377.586,
          "end": 380.043,
          "en": "which is provided by River Pod.",
          "zh": ""
        },
        {
          "id": 131,
          "start": 380.94,
          "end": 383.97,
          "en": "And my app is now simply the child widget",
          "zh": ""
        },
        {
          "id": 132,
          "start": 383.97,
          "end": 385.98,
          "en": "that's passed to Provider Scope.",
          "zh": ""
        },
        {
          "id": 133,
          "start": 385.98,
          "end": 387.3,
          "en": "And as you might recall,",
          "zh": ""
        },
