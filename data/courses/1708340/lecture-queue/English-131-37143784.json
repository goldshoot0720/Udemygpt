        },
        {
          "id": 123,
          "start": 337.38,
          "end": 339.09000000000003,
          "en": "which is provided by Dart,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 339.09000000000003,
          "end": 342.693,
          "en": "which has helpful properties like is Android or is iOS.",
