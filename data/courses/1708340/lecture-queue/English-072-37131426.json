        },
        {
          "id": 86,
          "start": 252.54,
          "end": 255,
          "en": "Of course, that's not the final version of the app.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 255,
          "end": 257.49,
          "en": "The results screen is still missing,",
          "zh": ""
        },
        {
          "id": 88,
          "start": 257.49,
          "end": 261.48,
          "en": "but that's how we can use this selectedAnswers state",
          "zh": ""
        },
        {
          "id": 89,
          "start": 261.48,
          "end": 263.19,
          "en": "to show a different screen",
          "zh": ""
        },
        {
          "id": 90,
