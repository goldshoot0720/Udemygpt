          "zh": ""
        },
        {
          "id": 21,
          "start": 64.89,
          "end": 69.24,
          "en": "and set it to a height of, let's say, 30 maybe.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 69.24,
          "end": 71.16,
          "en": "And to get rid of these blue squiggly lines,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 71.16,
          "end": 73.41,
          "en": "we can add const in front of this list",
          "zh": ""
        },
        {
          "id": 24,
          "start": 73.41,
          "end": 75.72,
          "en": "to make sure that all the items in the list",
