        },
        {
          "id": 25,
          "start": 75.72,
          "end": 78,
          "en": "are turned into const items,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 78,
          "end": 80.78999999999999,
          "en": "and therefore, they are only stored in memory once",
