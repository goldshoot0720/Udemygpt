        },
        {
          "id": 18,
          "start": 55.447,
          "end": 59.463,
          "en": "where each button represents one selectable answer.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 60.57,
          "end": 61.74,
          "en": "So, to add the spacing,",
          "zh": ""
        },
        {
          "id": 20,
