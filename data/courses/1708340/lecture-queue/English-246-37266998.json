          "end": 213.32999999999998,
          "en": "we can check whether picked location",
          "zh": ""
        },
        {
          "id": 72,
          "start": 213.32999999999998,
          "end": 216.84,
          "en": "is null, and wrapped in parentheses",
          "zh": ""
        },
        {
          "id": 73,
          "start": 216.84,
          "end": 219.66,
          "en": "to group these two conditions together.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 219.66,
          "end": 224.583,
          "en": "And if widget is selecting is true,",
          "zh": ""
        },
        {
          "id": 75,
