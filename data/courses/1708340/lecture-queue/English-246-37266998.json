        },
        {
          "id": 59,
          "start": 174.69,
          "end": 177.09,
          "en": "So therefore here for markers, we can check",
          "zh": ""
        },
        {
          "id": 60,
          "start": 177.09,
          "end": 181.53,
          "en": "if picked location is null,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 181.53,
          "end": 185.61,
          "en": "in which case I wanna pass an empty set to markers",
