        },
        {
          "id": 39,
          "start": 124.95,
          "end": 127.65,
          "en": "Dart does not understand that here I'm checking",
          "zh": ""
        },
        {
          "id": 40,
          "start": 127.65,
          "end": 129.18,
          "en": "for it to not be null.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 129.18,
          "end": 131.31,
          "en": "Hence we must add an exclamation mark.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 131.31,
          "end": 133.89,
          "en": "And with that, we implemented this check,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 133.89,
          "end": 137.25,
          "en": "and we have these two alternatives now.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 137.25,
          "end": 138.083,
          "en": "By the way,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 138.083,
          "end": 139.38,
          "en": "you could also write this",
          "zh": ""
        },
        {
          "id": 46,
          "start": 139.38,
          "end": 144.09,
          "en": "in a more concise way by using this syntax,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 144.09,
          "end": 146.619,
          "en": "these double question marks.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 146.619,
          "end": 150.72,
