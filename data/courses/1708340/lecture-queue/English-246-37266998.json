        },
        {
          "id": 65,
          "start": 196.32,
          "end": 199.07999999999998,
          "en": "for showing an already picked place,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 199.07999999999998,
          "end": 201.63,
          "en": "because in that case, picked location would be null,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 201.63,
          "end": 203.763,
          "en": "but of course we still would have a place,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 204.63,
          "end": 209.1,
          "en": "but that's why we also have this is-selecting property here.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 209.1,
          "end": 210.3,
          "en": "With that down here,",
