          "zh": ""
        },
        {
          "id": 26,
          "start": 75.06,
          "end": 78.78,
          "en": "And we could set the color here to our color scheme again,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 78.78,
          "end": 83.01,
