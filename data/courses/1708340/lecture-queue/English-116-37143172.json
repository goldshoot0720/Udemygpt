        },
        {
          "id": 51,
          "start": 145.38,
          "end": 147.6,
          "en": "Yeah, I think that looks better.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 147.6,
          "end": 150.69,
          "en": "Now I also showed you before that you can, for example,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 150.69,
          "end": 152.76,
          "en": "set up some default button styles",
