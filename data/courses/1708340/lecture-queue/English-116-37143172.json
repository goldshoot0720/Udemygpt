        },
        {
          "id": 79,
          "start": 218.46,
          "end": 222.27,
          "en": "how a specific widget is best themed.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 222.27,
          "end": 223.32,
          "en": "Here for buttons,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 223.32,
          "end": 225,
          "en": "I recommend using style from",
          "zh": ""
        },
        {
          "id": 82,
          "start": 225,
          "end": 227.28,
          "en": "on the elevated button in this case.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 227.28,
          "end": 230.82,
          "en": "And now we can again target some individual style settings",
