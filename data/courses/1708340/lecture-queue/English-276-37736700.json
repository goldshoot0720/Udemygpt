        },
        {
          "id": 97,
          "start": 302.58,
          "end": 304.8,
          "en": "because that's the collection we also used",
          "zh": ""
        },
        {
          "id": 98,
          "start": 304.8,
          "end": 306.243,
          "en": "for storing the data.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 307.38,
          "end": 310.38,
          "en": "And then we wanna reach out to the document that belongs",
