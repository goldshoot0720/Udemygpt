        },
        {
          "id": 107,
          "start": 334.59000000000003,
          "end": 337.17,
          "en": "stored in this document in this collection,",
          "zh": ""
        },
        {
          "id": 108,
          "start": 337.17,
          "end": 339.65999999999997,
          "en": "which in this case will be that user data",
