        },
        {
          "id": 80,
          "start": 248.28,
          "end": 250.74,
          "en": "And I'll set this to true as a default",
          "zh": ""
        },
        {
          "id": 81,
          "start": 250.74,
          "end": 254.22,
          "en": "so that if I open this MapScreen without overriding this,",
