        },
        {
          "id": 94,
          "start": 276.3,
          "end": 278.38,
          "en": "and I'll set it to double infinity",
          "zh": ""
        },
        {
          "id": 95,
          "start": 279.33,
          "end": 284.07,
          "en": "to make sure that this takes up as much space as it can get.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 284.07,
          "end": 287.15999999999997,
          "en": "And with that, if we save this and reload,",
          "zh": ""
        },
        {
          "id": 97,
          "start": 287.15999999999997,
          "end": 290.22,
          "en": "I get this full screen mode again.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 290.22,
          "end": 293.37,
          "en": "Still scrollable, but full screen.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 293.37,
          "end": 295.2,
          "en": "And this strange error message,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 295.2,
          "end": 297.84000000000003,
