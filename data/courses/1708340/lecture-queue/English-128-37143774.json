          "en": "that we can always reach all the contents",
          "zh": ""
        },
        {
          "id": 103,
          "start": 302.16,
          "end": 305.76,
          "en": "no matter if we view this application here in landscape mode",
          "zh": ""
        },
        {
          "id": 104,
          "start": 305.76,
          "end": 308.04,
          "en": "or as before in portrait mode.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 308.04,
          "end": 310.653,
