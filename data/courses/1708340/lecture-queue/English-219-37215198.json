          "zh": ""
        },
        {
          "id": 19,
          "start": 61.346000000000004,
          "end": 65.7,
          "en": "and then here you can create such an exception object",
          "zh": ""
        },
        {
          "id": 20,
          "start": 65.7,
          "end": 68.19,
          "en": "by using the exception constructor function,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 68.19,
