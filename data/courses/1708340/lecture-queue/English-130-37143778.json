        },
        {
          "id": 33,
          "start": 92.82,
          "end": 95.72999999999999,
          "en": "So therefore here, I'll register an anonymous function",
          "zh": ""
        },
        {
          "id": 34,
          "start": 95.72999999999999,
          "end": 99.093,
          "en": "where I get this context and this constraints object.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 100.59,
          "end": 102.53999999999999,
          "en": "And it's now inside of this function,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 102.53999999999999,
          "end": 104.91,
          "en": "where we should return this SizedBox",
          "zh": ""
        },
        {
          "id": 37,
          "start": 104.91,
          "end": 106.97999999999999,
          "en": "and this entire widget tree.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 106.97999999999999,
          "end": 108.57,
          "en": "So I'll cut it here,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 108.57,
          "end": 111.15,
          "en": "and return it here inside of this function,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 111.15,
          "end": 114.543,
