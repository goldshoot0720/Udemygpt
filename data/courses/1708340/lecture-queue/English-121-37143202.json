        },
        {
          "id": 79,
          "start": 223.95,
          "end": 226.053,
          "en": "like here for the children of a row.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 226.89,
          "end": 229.2,
          "en": "Then you can use this for loop here",
          "zh": ""
        },
        {
          "id": 81,
          "start": 229.2,
          "end": 232.26,
          "en": "with a syntax that's similar to what I showed you",
