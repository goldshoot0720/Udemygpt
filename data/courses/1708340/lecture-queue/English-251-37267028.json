          "end": 366.9,
          "en": "I do want to accept an ID parameter here,",
          "zh": ""
        },
        {
          "id": 127,
          "start": 366.9,
          "end": 370.773,
          "en": "but now this clashes with this automatic ID generation here.",
          "zh": ""
        },
        {
          "id": 128,
          "start": 371.82,
          "end": 373.14,
          "en": "So what I want to do here",
          "zh": ""
        },
        {
          "id": 129,
          "start": 373.14,
          "end": 376.83,
          "en": "is I wanna accept this id parameter,",
          "zh": ""
        },
        {
          "id": 130,
          "start": 376.83,
          "end": 380.31,
          "en": "but I'll not automatically assign it to this property.",
          "zh": ""
        },
        {
          "id": 131,
          "start": 380.31,
          "end": 382.08,
          "en": "Instead I accept it here.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 382.08,
          "end": 387.08,
          "en": "And then here I'll set id equal to either the id I got here,",
          "zh": ""
        },
        {
          "id": 133,
          "start": 387.33,
          "end": 389.01,
          "en": "or if that's null,",
          "zh": ""
        },
        {
          "id": 134,
          "start": 389.01,
