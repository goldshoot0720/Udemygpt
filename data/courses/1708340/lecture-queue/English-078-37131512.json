      "sourceHash": "6caa83d11b2e6b5b4cf92bc31be222b596b22f55875ed1d33004a1ceb74a5c93",
      "cues": [
        {
          "id": 1,
          "start": 2.16,
          "end": 3,
          "en": "So we're outputting",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3,
          "end": 5.28,
          "en": "some basic summary data here,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.28,
          "end": 8.1,
          "en": "but of course at the moment there are these ugly warnings",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.1,
          "end": 11.04,
          "en": "that some content does basically not fit",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.04,
          "end": 14.643,
          "en": "into the screen boundaries, and that's of course not good.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.52,
          "end": 19.68,
          "en": "To fix this, you should go",
          "zh": ""
        },
        {
          "id": 7,
          "start": 19.68,
          "end": 22.41,
          "en": "to the questions summary.dart file",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.41,
          "end": 25.35,
          "en": "and to the questions summary component there.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 25.35,
          "end": 29.31,
          "en": "And there you can fix this issue by wrapping this column,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 29.31,
          "end": 30.725,
          "en": "which is inside of this row,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 30.725,
          "end": 32.49,
          "en": "so not the outer column,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.49,
          "end": 35.61,
          "en": "but this inner column with another widget.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 35.61,
          "end": 38.055,
          "en": "For that, we can refactor this of course",
          "zh": ""
        },
        {
          "id": 14,
          "start": 38.055,
          "end": 40.71,
          "en": "and wrap it with a widget.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 40.71,
          "end": 41.58,
          "en": "And the widget",
          "zh": ""
        },
        {
          "id": 16,
          "start": 41.58,
          "end": 45.59,
          "en": "with which this should be wrapped is the expanded widget,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 45.59,
          "end": 50.13,
          "en": "which is a widget we haven't used up to this point.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 50.13,
          "end": 52.05,
          "en": "Now I'll explain it in just a second.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 52.05,
          "end": 54.03,
          "en": "If we save this,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 54.03,
          "end": 57.69,
          "en": "you should see that now this is reformatted here",
          "zh": ""
        },
        {
          "id": 21,
          "start": 57.69,
          "end": 60.06,
          "en": "and now text that is too long",
          "zh": ""
        },
        {
          "id": 22,
          "start": 60.06,
          "end": 64.14,
          "en": "for a single line instead is broken across multiple lines,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 64.14,
          "end": 65.37,
          "en": "which is better.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 65.37,
          "end": 67.38,
          "en": "The overall styling is still not great,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 67.38,
          "end": 69.423,
          "en": "but this is a good start.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 70.38,
          "end": 73.185,
          "en": "But what exactly does expanded do here?",
          "zh": ""
        },
        {
          "id": 27,
          "start": 73.185,
          "end": 76.26,
          "en": "Now, the name expanded here might sound",
          "zh": ""
        },
        {
          "id": 28,
          "start": 76.26,
          "end": 80.31,
          "en": "like the child widget takes all the space that it can get,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 80.31,
          "end": 81.506,
          "en": "and to some extent it does,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 81.506,
          "end": 84.63,
          "en": "but that's actually better than what we had before",
          "zh": ""
        },
        {
          "id": 31,
          "start": 84.63,
          "end": 86.34,
          "en": "because without expanded,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 86.34,
          "end": 89.91,
          "en": "column actually takes an infinite amount of width,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 89.91,
          "end": 93.405,
          "en": "even if that goes beyond the screen boundaries.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 93.405,
          "end": 96.72,
          "en": "After wrapping it with expanded, this changes,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 96.72,
          "end": 100.28999999999999,
          "en": "because expanded basically allows its child",
          "zh": ""
        },
        {
          "id": 36,
          "start": 100.28999999999999,
          "end": 102.06,
          "en": "to take the available space",
          "zh": ""
        },
        {
          "id": 37,
          "start": 102.06,
          "end": 104.94,
          "en": "along the flex widget's main axis,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 104.94,
          "end": 106.71000000000001,
          "en": "which might sound strange,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 106.71000000000001,
          "end": 109.02000000000001,
          "en": "but the flex widget is simply a row",
          "zh": ""
        },
        {
          "id": 40,
          "start": 109.02000000000001,
          "end": 111.66,
          "en": "or a column widget above the widget",
          "zh": ""
        },
        {
          "id": 41,
          "start": 111.66,
          "end": 113.485,
          "en": "that you put into expanded.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 113.485,
          "end": 115.17,
          "en": "So the flex widget",
          "zh": ""
        },
        {
          "id": 43,
          "start": 115.17,
          "end": 118.95,
          "en": "for this column here would be this row widget, for example.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 118.95,
          "end": 120.18,
          "en": "Now the maximum width",
          "zh": ""
        },
        {
          "id": 45,
          "start": 120.18,
          "end": 123.21,
          "en": "of a row widget is the maximum screen width,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 123.21,
          "end": 124.89,
          "en": "just as the maximum height",
          "zh": ""
        },
        {
          "id": 47,
          "start": 124.89,
          "end": 127.953,
          "en": "of a column widget is the maximum height of the screen.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 128.82,
          "end": 131.7,
          "en": "Therefore, if you use expanded inside of a row,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 131.7,
          "end": 133.95,
          "en": "the widget that is passed as a child",
          "zh": ""
        },
        {
          "id": 50,
          "start": 133.95,
          "end": 137.55,
          "en": "to expanded can't take more than the width of that row.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 137.55,
          "end": 139.554,
          "en": "That's what expanded guarantees.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 139.554,
          "end": 142.53,
          "en": "Without expanded, the column inside",
          "zh": ""
        },
        {
          "id": 53,
          "start": 142.53,
          "end": 146.373,
          "en": "of the row totally ignores the maximum width off the row",
          "zh": ""
        },
        {
          "id": 54,
          "start": 146.373,
          "end": 149.79,
          "en": "and instead grows beyond that width.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 149.79,
          "end": 153.63,
          "en": "With expanded, it's restricted to that width of that row,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 153.63,
          "end": 156.6,
          "en": "and this column here will instead only expand",
          "zh": ""
        },
        {
          "id": 57,
          "start": 156.6,
          "end": 159.99,
          "en": "such that it fills up the space provided by row.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 159.99,
          "end": 161.01,
          "en": "That's why in the end,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 161.01,
          "end": 164.267,
          "en": "expanded here restricts the width of the column",
          "zh": ""
        },
        {
          "id": 60,
          "start": 164.267,
          "end": 166.695,
          "en": "instead of increasing it.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 166.695,
          "end": 168.595,
          "en": "It restricts the width of the column",
          "zh": ""
        },
        {
          "id": 62,
          "start": 168.595,
          "end": 170.25,
          "en": "to the width of the row,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 170.25,
          "end": 173.22,
          "en": "which in the end is the width of the device screen.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 173.22,
          "end": 174.93,
          "en": "Of course, we'll also soon take care",
          "zh": ""
        },
        {
          "id": 65,
          "start": 174.93,
          "end": 176.733,
          "en": "about the rest of this styling.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 177.655,
          "end": 179.175,
          "en": "Before we do that though,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 179.175,
          "end": 182.25,
          "en": "I want to add these summary statistics here",
          "zh": ""
        },
        {
          "id": 68,
          "start": 182.25,
          "end": 185.223,
          "en": "with concrete values for X and Y.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
