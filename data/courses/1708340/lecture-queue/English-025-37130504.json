        },
        {
          "id": 147,
          "start": 359.28,
          "end": 363,
          "en": "we should of course go back to a real text.",
          "zh": ""
        },
        {
          "id": 148,
          "start": 363,
          "end": 364.98,
          "en": "So that's the idea behind types",
