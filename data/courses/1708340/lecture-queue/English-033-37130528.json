        },
        {
          "id": 115,
          "start": 348.18,
          "end": 349.2,
          "en": "Now, up to this point,",
          "zh": ""
        },
        {
          "id": 116,
          "start": 349.2,
          "end": 352.17,
          "en": "in all the examples I just showed you from time to time,",
          "zh": ""
        },
        {
          "id": 117,
          "start": 352.17,
          "end": 354.09000000000003,
          "en": "you always saw void.",
          "zh": ""
        },
        {
          "id": 118,
          "start": 354.09000000000003,
          "end": 355.95,
          "en": "That's, of course, also what we have in front",
