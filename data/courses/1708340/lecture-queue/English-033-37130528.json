        },
        {
          "id": 106,
          "start": 318.84,
          "end": 322.26,
          "en": "as a metadata object that contains some useful information",
          "zh": ""
        },
        {
          "id": 107,
          "start": 322.26,
          "end": 325.5,
          "en": "about this widget in the overall widget tree.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 325.5,
          "end": 328.5,
          "en": "For example, some information about where this widget",
          "zh": ""
        },
        {
          "id": 109,
          "start": 328.5,
          "end": 331.14300000000003,
          "en": "is positioned in the overall widget tree.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 332.31,
          "end": 335.37,
          "en": "Now, between those build() method's curly braces,",
