        },
        {
          "id": 31,
          "start": 92.28,
          "end": 93.87,
          "en": "You could add curly braces",
          "zh": ""
        },
        {
          "id": 32,
          "start": 93.87,
          "end": 98.37,
          "en": "and add your class logic between those curly braces,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 98.37,
          "end": 100.17,
          "en": "just as you add function logic",
          "zh": ""
        },
        {
          "id": 34,
          "start": 100.17,
          "end": 103.32,
          "en": "between the curly braces of a custom function.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 103.32,
          "end": 105.12,
