      "cues": [
        {
          "id": 1,
          "start": 2.13,
          "end": 4.44,
          "en": "So, we added our own custom widget.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.44,
          "end": 5.61,
          "en": "Now, before we continue,",
          "zh": ""
        },
        {
          "id": 3,
