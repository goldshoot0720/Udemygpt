        },
        {
          "id": 12,
          "start": 26.4,
          "end": 28.92,
          "en": "or some other class which you'll see later,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 28.92,
          "end": 32.01,
          "en": "should have a constructor function added to them.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 32.01,
          "end": 34.83,
