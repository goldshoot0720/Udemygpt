        },
        {
          "id": 15,
          "start": 34.83,
          "end": 36.54,
          "en": "you get one automatically,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 36.54,
          "end": 39.15,
          "en": "but if you wanna add some extra settings",
          "zh": ""
        },
        {
          "id": 17,
          "start": 39.15,
          "end": 40.86,
          "en": "or some extra configuration,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 40.86,
          "end": 43.68,
          "en": "at the point of time this widget is created,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 43.68,
          "end": 46.8,
          "en": "you have to add your own constructor function.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 46.8,
          "end": 49.77,
          "en": "And adding a constructor function is quite straightforward.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 49.77,
          "end": 52.2,
