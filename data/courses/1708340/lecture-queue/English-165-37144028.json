      "cues": [
        {
          "id": 1,
          "start": 2.13,
          "end": 3.9,
          "en": "Now to read that data",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.9,
          "end": 6.9,
          "en": "that might be passed back by pop,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.9,
          "end": 10.08,
          "en": "we can go to this place where we called push.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.08,
          "end": 13.41,
          "en": "And here it's interesting to see that this push method,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.41,
          "end": 16.53,
          "en": "which we're calling actually returns a value.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.53,
          "end": 18.87,
          "en": "It returns a future.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.87,
          "end": 22.32,
          "en": "Thus far in this course we haven't used dart value,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.32,
          "end": 24.63,
          "en": "but that's now going to change,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 24.63,
          "end": 26.49,
          "en": "because we'll get a future here,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 26.49,
          "end": 28.05,
          "en": "which, will in the end,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 28.05,
          "end": 31.23,
          "en": "resolve to the data returned by the screen",
          "zh": ""
        },
        {
          "id": 12,
          "start": 31.23,
          "end": 32.7,
          "en": "where we navigate to.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 32.7,
          "end": 35.16,
          "en": "So to this map, in this case.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 35.16,
          "end": 37.86,
          "en": "We'll get a future that contains this map,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 37.86,
          "end": 39.81,
          "en": "and it will be a future instead",
          "zh": ""
        },
        {
          "id": 16,
          "start": 39.81,
          "end": 41.49,
          "en": "of getting this map right away.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 41.49,
          "end": 43.95,
          "en": "Because of course when we push this screen",
          "zh": ""
        },
        {
          "id": 18,
          "start": 43.95,
          "end": 46.02,
          "en": "onto this stack of screen,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 46.02,
          "end": 48.78,
          "en": "we don't immediately get back that data.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 48.78,
          "end": 51.87,
          "en": "Instead, the user may interact with that screen",
          "zh": ""
        },
        {
          "id": 21,
          "start": 51.87,
          "end": 55.11,
          "en": "and may press the back button after 10 seconds,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 55.11,
          "end": 57.36,
          "en": "10 minutes or 10 hours.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 57.36,
          "end": 58.77,
          "en": "And that's why it's a future.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 58.77,
          "end": 62.22,
          "en": "We don't have the return value available immediately,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 62.22,
          "end": 64.17,
          "en": "but at some point in the future,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 64.17,
          "end": 66.303,
          "en": "once the user did navigate back.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 67.47,
          "end": 69.42,
          "en": "So that's why we get a future here.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 69.42,
          "end": 72.51,
          "en": "And to use this future in a convenient way,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 72.51,
          "end": 75.75,
          "en": "we can add async here between parameter list",
          "zh": ""
        },
        {
          "id": 30,
          "start": 75.75,
          "end": 77.25,
          "en": "and curly brace,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 77.25,
          "end": 80.37,
          "en": "so that here we can use await,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 80.37,
          "end": 82.11,
          "en": "so that in the end then,",
          "zh": ""
        },
        {
          "id": 33,
