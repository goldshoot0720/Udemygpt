        },
        {
          "id": 34,
          "start": 86.03999999999999,
          "end": 89.34,
          "en": "But this will only be set once the user did navigate back.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 89.34,
          "end": 91.23,
          "en": "So once this future did resolve,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 91.23,
          "end": 93.21000000000001,
          "en": "we wait for that to happen here",
          "zh": ""
        },
        {
          "id": 37,
          "start": 93.21000000000001,
          "end": 95.88300000000001,
          "en": "with help of the await keyword, so to say.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 97.65,
          "end": 99.57,
          "en": "Therefore, in the next line thereafter,",
