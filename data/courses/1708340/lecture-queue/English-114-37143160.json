        },
        {
          "id": 26,
          "start": 70.89,
          "end": 74.34,
          "en": "And of course, there's nothing wrong with this approach,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 74.34,
          "end": 78.87,
