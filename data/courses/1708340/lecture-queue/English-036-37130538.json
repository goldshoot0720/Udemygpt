        },
        {
          "id": 60,
          "start": 163.07999999999998,
          "end": 166.38,
          "en": "we then forward this to StatelessWidget.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 166.38,
          "end": 168.81,
          "en": "And here, we should now also add const",
          "zh": ""
        },
        {
          "id": 62,
          "start": 168.81,
          "end": 171.3,
          "en": "since this is suggested to us here",
          "zh": ""
        },
        {
          "id": 63,
          "start": 171.3,
          "end": 173.883,
          "en": "to unlock various optimizations by Dart.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 175.62,
          "end": 179.16,
          "en": "And with that, we have our StyledText widget defined.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 179.16,
          "end": 182.25,
          "en": "We can now use it in GradientContainer.",
