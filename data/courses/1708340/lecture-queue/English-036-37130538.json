          "end": 140.67000000000002,
          "en": "is detached from the fact",
          "zh": ""
        },
        {
          "id": 51,
          "start": 140.67000000000002,
          "end": 143.973,
          "en": "if we unlock this widget for being optimized itself.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 145.07999999999998,
          "end": 147,
          "en": "But of course, here we should add a constructor",
          "zh": ""
        },
        {
          "id": 53,
          "start": 147,
          "end": 148.56,
          "en": "for the same reason as before,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 148.56,
          "end": 151.77,
          "en": "to forward that key argument about which you learned.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 151.77,
          "end": 153.36,
          "en": "Hence, I create a constructor",
          "zh": ""
        },
        {
          "id": 56,
          "start": 153.36,
          "end": 156.15,
          "en": "by repeating that name of the class.",
