      "sourceHash": "a09b5bda8a63806e8795c3a7e55fc541c134eb2deff60604f2543d2762358d1c",
      "cues": [
        {
          "id": 1,
          "start": 2.07,
          "end": 3.99,
          "en": "Now before we add the logic",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.99,
          "end": 5.64,
          "en": "for logging users in,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.64,
          "end": 7.41,
          "en": "I wanna come back to the question",
          "zh": ""
        },
        {
          "id": 4,
          "start": 7.41,
          "end": 10.35,
          "en": "how authentication actually works.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.35,
          "end": 11.82,
          "en": "Of course, you already learned",
          "zh": ""
        },
        {
          "id": 6,
          "start": 11.82,
          "end": 15.03,
          "en": "and saw that you collect the user credentials,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 15.03,
          "end": 16.83,
          "en": "and you send them to the backend,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 16.83,
          "end": 18.87,
          "en": "where they then get stored.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 18.87,
          "end": 21.39,
          "en": "That's what happened in the last lecture,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 21.39,
          "end": 22.65,
          "en": "but now we wanna do more",
          "zh": ""
        },
        {
          "id": 11,
          "start": 22.65,
          "end": 25.26,
          "en": "than just storing those credentials.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 25.26,
          "end": 27.27,
          "en": "Instead now with the logging in,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 27.27,
          "end": 29.73,
          "en": "the collected credentials should not be stored,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 29.73,
          "end": 32.19,
          "en": "but instead validated to make sure",
          "zh": ""
        },
        {
          "id": 15,
          "start": 32.19,
          "end": 35.43,
          "en": "that we have a valid email/password combination,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 35.43,
          "end": 38.373,
          "en": "and Firebase will do that for us, thankfully.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 39.63,
          "end": 42,
          "en": "But then what happens thereafter?",
          "zh": ""
        },
        {
          "id": 18,
          "start": 42,
          "end": 42.96,
          "en": "Well, in the end,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 42.96,
          "end": 46.35,
          "en": "we might want to change what we display in the app.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 46.35,
          "end": 49.05,
          "en": "We might want to navigate to a different screen",
          "zh": ""
        },
        {
          "id": 21,
          "start": 49.05,
          "end": 51.033,
          "en": "once the user is authenticated.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 51.96,
          "end": 53.61,
          "en": "But in addition to that,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 53.61,
          "end": 56.46,
          "en": "we also might want to be able to access",
          "zh": ""
        },
        {
          "id": 24,
          "start": 56.46,
          "end": 59.7,
          "en": "certain protected resources on the backend,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 59.7,
          "end": 64.29,
          "en": "some data that should only be available to logged in users.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 64.29,
          "end": 66.63,
          "en": "For example, here in this chat app,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 66.63,
          "end": 69.75,
          "en": "the chat messages should only be accessible",
          "zh": ""
        },
        {
          "id": 28,
          "start": 69.75,
          "end": 71.76,
          "en": "by logged in users.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 71.76,
          "end": 74.52,
          "en": "Anonymous users who are not logged in",
          "zh": ""
        },
        {
          "id": 30,
          "start": 74.52,
          "end": 78.393,
          "en": "should not be able to see or create chat messages.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 79.68,
          "end": 82.74,
          "en": "Therefore, once we validated the user data,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 82.74,
          "end": 86.91,
          "en": "the backup also creates such a authentication token.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 86.91,
          "end": 88.56,
          "en": "It actually also does that",
          "zh": ""
        },
        {
          "id": 34,
          "start": 88.56,
          "end": 91.11,
          "en": "when a new user is created, by the way.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 91.11,
          "end": 93.45,
          "en": "Now this authentication token string",
          "zh": ""
        },
        {
          "id": 36,
          "start": 93.45,
          "end": 96.42,
          "en": "is a rather cryptic and random-looking string,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 96.42,
          "end": 98.43,
          "en": "and you'll see one soon,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 98.43,
          "end": 99.263,
          "en": "but in the end,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 99.263,
          "end": 100.71000000000001,
          "en": "it will be a string that's generated",
          "zh": ""
        },
        {
          "id": 40,
          "start": 100.71000000000001,
          "end": 103.25999999999999,
          "en": "by the backend that validated the user,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 103.25999999999999,
          "end": 106.74000000000001,
          "en": "so that's handling the authentication in the end,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 106.74000000000001,
          "end": 109.59,
          "en": "and it's created using a certain algorithm",
          "zh": ""
        },
        {
          "id": 43,
          "start": 109.59,
          "end": 111.84,
          "en": "that actually ensures that the string,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 111.84,
          "end": 115.35,
          "en": "despite looking random, isn't random.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 115.35,
          "end": 118.62,
          "en": "Instead, it is a string that can't be reproduced",
          "zh": ""
        },
        {
          "id": 46,
          "start": 118.62,
          "end": 121.38,
          "en": "by anyone else but that backend",
          "zh": ""
        },
        {
          "id": 47,
          "start": 121.38,
          "end": 123.78,
          "en": "because it uses some secret key,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 123.78,
          "end": 125.49,
          "en": "which only the backend knows",
          "zh": ""
        },
        {
          "id": 49,
          "start": 125.49,
          "end": 129.09,
          "en": "as part of that token-generation process,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 129.09,
          "end": 130.62,
          "en": "but it's then that token",
          "zh": ""
        },
        {
          "id": 51,
          "start": 130.62,
          "end": 132.6,
          "en": "that will be sent back to the frontend",
          "zh": ""
        },
        {
          "id": 52,
          "start": 132.6,
          "end": 134.73,
          "en": "so that it can be stored there.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 134.73,
          "end": 137.07,
          "en": "And that can then be used by the frontend",
          "zh": ""
        },
        {
          "id": 54,
          "start": 137.07,
          "end": 140.04,
          "en": "to attach it to future requests",
          "zh": ""
        },
        {
          "id": 55,
          "start": 140.04,
          "end": 143.52,
          "en": "that are trying to access protected resources.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 143.52,
          "end": 145.86,
          "en": "And since those requests then have",
          "zh": ""
        },
        {
          "id": 57,
          "start": 145.86,
          "end": 147.9,
          "en": "that token attached to them",
          "zh": ""
        },
        {
          "id": 58,
          "start": 147.9,
          "end": 152.28,
          "en": "and only the backend knows how it created that token,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 152.28,
          "end": 155.22,
          "en": "the backend is able to verify that token",
          "zh": ""
        },
        {
          "id": 60,
          "start": 155.22,
          "end": 157.98,
          "en": "and either deny or grant access",
          "zh": ""
        },
        {
          "id": 61,
          "start": 157.98,
          "end": 160.41,
          "en": "to those protected resources.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 160.41,
          "end": 164.49,
          "en": "So that's how the authentication flow generally works.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 164.49,
          "end": 167.57999999999998,
          "en": "Thankfully, that token creation on the backend",
          "zh": ""
        },
        {
          "id": 64,
          "start": 167.57999999999998,
          "end": 170.22,
          "en": "and that validation of the token on the backend",
          "zh": ""
        },
        {
          "id": 65,
          "start": 170.22,
          "end": 171.9,
          "en": "will be handled by Firebase",
          "zh": ""
        },
        {
          "id": 66,
          "start": 171.9,
          "end": 174.27,
          "en": "since you're not working on the backend,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 174.27,
          "end": 176.61,
          "en": "and the storage of the token on the device",
          "zh": ""
        },
        {
          "id": 68,
          "start": 176.61,
          "end": 178.68,
          "en": "will also be handled by Firebase",
          "zh": ""
        },
        {
          "id": 69,
          "start": 178.68,
          "end": 181.8,
          "en": "since we're using that Firebase SDK here.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 181.8,
          "end": 183.33,
          "en": "If we were not using that,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 183.33,
          "end": 185.46,
          "en": "we would have to store it manually",
          "zh": ""
        },
        {
          "id": 72,
          "start": 185.46,
          "end": 187.68,
          "en": "and manage its lifecycle manually",
          "zh": ""
        },
        {
          "id": 73,
          "start": 187.68,
          "end": 190.26,
          "en": "because it turns out that this token expires",
          "zh": ""
        },
        {
          "id": 74,
          "start": 190.26,
          "end": 192.033,
          "en": "after a certain time period.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 192.99,
          "end": 194.46,
          "en": "With the Firebase SDK,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 194.46,
          "end": 196.82999999999998,
          "en": "we don't have to worry about anything like that,",
          "zh": ""
        },
        {
          "id": 77,
          "start": 196.82999999999998,
          "end": 199.11,
          "en": "and instead, with that out of the way,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 199.11,
          "end": 201.57,
          "en": "we can now add the login logic",
          "zh": ""
        },
        {
          "id": 79,
          "start": 201.57,
          "end": 203.91,
          "en": "to make sure that users can log in",
          "zh": ""
        },
        {
          "id": 80,
          "start": 203.91,
          "end": 206.43,
          "en": "and that they then also get such a token,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 206.43,
          "end": 207.81,
          "en": "not just when they sign up,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 207.81,
          "end": 210,
          "en": "but also when they log in.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 210,
          "end": 212.46,
          "en": "And we'll then use that token later",
          "zh": ""
        },
        {
          "id": 84,
          "start": 212.46,
          "end": 216.9,
          "en": "for sending requests to protected resources.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 216.9,
          "end": 220.14,
          "en": "So let's now add the authentication logic.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 220.14,
          "end": 223.89,
          "en": "For this here in this first branch of this if check,",
          "zh": ""
        },
        {
          "id": 87,
          "start": 223.89,
          "end": 226.23,
          "en": "we can again use _firebase",
          "zh": ""
        },
        {
          "id": 88,
          "start": 226.23,
          "end": 228.81,
          "en": "to use this Firebase SDK.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 228.81,
          "end": 231.09,
          "en": "And now we don't want to create a new user.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 231.09,
          "end": 233.1,
          "en": "Instead, we wanna log a user in,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 233.1,
          "end": 235.05,
          "en": "and that can be done",
          "zh": ""
        },
        {
          "id": 92,
          "start": 235.05,
          "end": 236.85,
          "en": "by using signInWithEmailAndPassword.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 239.82,
          "end": 242.79,
          "en": "Here again, we pass the entered email",
          "zh": ""
        },
        {
          "id": 94,
          "start": 242.79,
          "end": 244.743,
          "en": "and the entered password,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 246.24,
          "end": 249.48,
          "en": "and we learned that this also returns a future,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 249.48,
          "end": 252.12,
          "en": "and that it also may throw an exception",
          "zh": ""
        },
        {
          "id": 97,
          "start": 252.12,
          "end": 255.423,
          "en": "if, for example, an invalid email was provided.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 257.01800000000003,
          "end": 260.79,
          "en": "Therefore, here, I'll again await this",
          "zh": ""
        },
        {
          "id": 99,
          "start": 260.79,
          "end": 264.81,
          "en": "and add final userCredentials here.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 264.81,
          "end": 267.81,
          "en": "I can use the same variable name as down there",
          "zh": ""
        },
        {
          "id": 101,
          "start": 267.81,
          "end": 270.81,
          "en": "since these are in different branches of the if statement",
          "zh": ""
        },
        {
          "id": 102,
          "start": 270.81,
          "end": 272.46,
          "en": "in the end.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 272.46,
          "end": 276.3,
          "en": "And I'll wrap this with try catch here.",
          "zh": ""
        },
        {
          "id": 104,
          "start": 276.3,
          "end": 279.36,
          "en": "Though, since I want to use try catch here and here,",
          "zh": ""
        },
        {
          "id": 105,
          "start": 279.36,
          "end": 283.29,
          "en": "I can also instead just wrap this overall if statement",
          "zh": ""
        },
        {
          "id": 106,
          "start": 283.29,
          "end": 285.36,
          "en": "with try catch",
          "zh": ""
        },
        {
          "id": 107,
          "start": 285.36,
          "end": 288.63,
          "en": "so that I can also reuse this catch logic,",
          "zh": ""
        },
        {
          "id": 108,
          "start": 288.63,
          "end": 293.63,
          "en": "so now the try catch block is outside of this if statement,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 293.64,
          "end": 295.17,
          "en": "or to put it in other words,",
          "zh": ""
        },
        {
          "id": 110,
          "start": 295.17,
          "end": 298.173,
          "en": "the if statement is inside of this try block.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 299.64,
          "end": 301.32,
          "en": "And then we handle errors here,",
          "zh": ""
        },
        {
          "id": 112,
          "start": 301.32,
          "end": 303.78,
          "en": "no matter if they're coming from the sign-up",
          "zh": ""
        },
        {
          "id": 113,
          "start": 303.78,
          "end": 305.583,
          "en": "or log-in process.",
          "zh": ""
        },
        {
          "id": 114,
          "start": 306.51,
          "end": 308.22,
          "en": "And then here, when logging in,",
          "zh": ""
        },
        {
          "id": 115,
          "start": 308.22,
          "end": 311.64,
          "en": "I also wanna print my user credentials here",
          "zh": ""
        },
        {
          "id": 116,
          "start": 311.64,
          "end": 314.283,
          "en": "to see whether the login process worked.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 315.87,
          "end": 320.19,
          "en": "And that's all we have to do to log users in.",
          "zh": ""
        },
        {
          "id": 118,
          "start": 320.19,
          "end": 322.8,
          "en": "If you now save this and reload,",
          "zh": ""
        },
        {
          "id": 119,
          "start": 322.8,
          "end": 324.75,
          "en": "I can go back here,",
          "zh": ""
        },
        {
          "id": 120,
          "start": 324.75,
          "end": 327.18,
          "en": "enter my email address from before,",
          "zh": ""
        },
        {
          "id": 121,
          "start": 327.18,
          "end": 330.36,
          "en": "and here, I want to use the same one as I did before,",
          "zh": ""
        },
        {
          "id": 122,
          "start": 330.36,
          "end": 332.85,
          "en": "so the valid email and the valid password.",
          "zh": ""
        },
        {
          "id": 123,
          "start": 332.85,
          "end": 335.31,
          "en": "And now here, staying in Login mode,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 335.31,
          "end": 337.02,
          "en": "we can click Login,",
          "zh": ""
        },
        {
          "id": 125,
          "start": 337.02,
          "end": 338.43,
          "en": "and I get no error.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 338.43,
          "end": 340.35,
          "en": "So that's looking good.",
          "zh": ""
        },
        {
          "id": 127,
          "start": 340.35,
          "end": 343.05,
          "en": "And if I now open the debug Console,",
          "zh": ""
        },
        {
          "id": 128,
          "start": 343.05,
          "end": 344.82,
          "en": "somewhere in there,",
          "zh": ""
        },
        {
          "id": 129,
          "start": 344.82,
          "end": 348.873,
          "en": "you should see such a UserCredential output again.",
          "zh": ""
        },
        {
          "id": 130,
          "start": 350.49,
          "end": 353.28,
          "en": "Now you don't see that token in there.",
          "zh": ""
        },
        {
          "id": 131,
          "start": 353.28,
          "end": 355.05,
          "en": "Again, we will see it later.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 355.05,
          "end": 356.19,
          "en": "We don't see it here,",
          "zh": ""
        },
        {
          "id": 133,
          "start": 356.19,
          "end": 358.32,
          "en": "but we can see this output here,",
          "zh": ""
        },
        {
          "id": 134,
          "start": 358.32,
          "end": 361.11,
          "en": "which proves, in combination with the fact",
          "zh": ""
        },
        {
          "id": 135,
          "start": 361.11,
          "end": 363.48,
          "en": "that we did not get an error message,",
          "zh": ""
        },
        {
          "id": 136,
