          "en": "this empty anonymous function,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 297.21,
          "end": 302.21,
          "en": "which I used as a dummy value for my onTap argument here,",
          "zh": ""
        },
        {
          "id": 104,
          "start": 302.31,
          "end": 304.11,
          "en": "which wants a function,",
          "zh": ""
        },
        {
          "id": 105,
          "start": 304.11,
          "end": 308.43,
          "en": "with a pointer at this brand new answer question function,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 308.43,
