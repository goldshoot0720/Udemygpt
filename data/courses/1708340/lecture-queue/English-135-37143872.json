      "sourceHash": "85b49ba09d1296e85ef19ee787e75009a6b91eed672d132ce25c78d3ec4d9543",
      "cues": [
        {
          "id": 1,
          "start": 2.1,
          "end": 4.68,
          "en": "Now to make this tree thing",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.68,
          "end": 9.33,
          "en": "and this UI updating process at least a little bit",
          "zh": ""
        },
        {
          "id": 3,
          "start": 9.33,
          "end": 11.4,
          "en": "less abstract,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.4,
          "end": 14.33,
          "en": "I created a very basic demo app which you'll find attached.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 14.33,
          "end": 18.03,
          "en": "To be precise, you find my lib folder attached",
          "zh": ""
        },
        {
          "id": 6,
          "start": 18.03,
          "end": 19.5,
          "en": "and you can drag",
          "zh": ""
        },
        {
          "id": 7,
          "start": 19.5,
          "end": 22.32,
          "en": "and drop that into a new Flutter project created",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.32,
          "end": 24.21,
          "en": "with Flutter Create.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 24.21,
          "end": 27.18,
          "en": "And if you do that and you then start this app",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.18,
          "end": 30.3,
          "en": "which I provided to you, you should see an app on the screen",
          "zh": ""
        },
        {
          "id": 11,
          "start": 30.3,
          "end": 32.313,
          "en": "that looks something like this.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 33.39,
          "end": 36.66,
          "en": "Now this is of course a very simple not too helpful app,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 36.66,
          "end": 40.77,
          "en": "but it is an app where we do have some interactivity",
          "zh": ""
        },
        {
          "id": 14,
          "start": 40.77,
          "end": 43.92,
          "en": "and it is an app that can help us understand the difference",
          "zh": ""
        },
        {
          "id": 15,
          "start": 43.92,
          "end": 47.85,
          "en": "between our widget tree and the build method being called",
          "zh": ""
        },
        {
          "id": 16,
          "start": 47.85,
          "end": 50.37,
          "en": "and the element tree.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 50.37,
          "end": 54.54,
          "en": "And for that in this ui_updates_demo.dart file,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 54.54,
          "end": 59.25,
          "en": "I created a stateful widget UIUpdatesDemo.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 59.25,
          "end": 61.8,
          "en": "And this is a very simple stateful widget",
          "zh": ""
        },
        {
          "id": 20,
          "start": 61.8,
          "end": 64.02,
          "en": "with a column widget being rendered here,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 64.02,
          "end": 65.52,
          "en": "which displays these texts",
          "zh": ""
        },
        {
          "id": 22,
          "start": 65.52,
          "end": 67.8,
          "en": "and these buttons that change the state.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 67.8,
          "end": 70.35,
          "en": "And then this conditionally shown text",
          "zh": ""
        },
        {
          "id": 24,
          "start": 70.35,
          "end": 71.673,
          "en": "here at the very bottom.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 72.84,
          "end": 74.49,
          "en": "So that's what's being rendered here.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 74.49,
          "end": 78.72,
          "en": "This is the widget tree of this UIUpdatesDemo widget.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 78.72,
          "end": 81.18,
          "en": "And overall this is the widget tree",
          "zh": ""
        },
        {
          "id": 28,
          "start": 81.18,
          "end": 82.83,
          "en": "that's being rendered for my app.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 83.88,
          "end": 88.62,
          "en": "Now if you open the debug console here in Visual Studio Code",
          "zh": ""
        },
        {
          "id": 30,
          "start": 88.62,
          "end": 91.62,
          "en": "and you restart the app, which also clears the console,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 91.62,
          "end": 95.88,
          "en": "you will see two log statements in there, UIUpdatesDemo",
          "zh": ""
        },
        {
          "id": 32,
          "start": 96.956,
          "end": 98.22,
          "en": "CREATEELEMENT called",
          "zh": ""
        },
        {
          "id": 33,
          "start": 98.22,
          "end": 101.19,
          "en": "and UIUpdatesDemo BUILD called.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 101.19,
          "end": 103.8,
          "en": "Now these log statements are coming from my",
          "zh": ""
        },
        {
          "id": 35,
          "start": 103.8,
          "end": 105.99000000000001,
          "en": "UIUpdatesDemo widget.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 105.99000000000001,
          "end": 110.58,
          "en": "And in there in the build method in its state class here,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 110.58,
          "end": 113.64,
          "en": "you'll find this print statement at the beginning",
          "zh": ""
        },
        {
          "id": 38,
          "start": 113.64,
          "end": 116.28,
          "en": "of the build method, which is of course responsible",
          "zh": ""
        },
        {
          "id": 39,
          "start": 116.28,
          "end": 117.963,
          "en": "for this output here.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 119.033,
          "end": 122.07,
          "en": "The CREATEELEMENT output is coming from the",
          "zh": ""
        },
        {
          "id": 41,
          "start": 122.07,
          "end": 124.08,
          "en": "widget class itself",
          "zh": ""
        },
        {
          "id": 42,
          "start": 124.08,
          "end": 127.65,
          "en": "because there, I actually added a createElement method",
          "zh": ""
        },
        {
          "id": 43,
          "start": 127.65,
          "end": 131.07,
          "en": "which we haven't added before anywhere in the course,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 131.07,
          "end": 134.22,
          "en": "and which you typically also don't need to add.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 134.22,
          "end": 136.56,
          "en": "And here I'm also not doing anything",
          "zh": ""
        },
        {
          "id": 46,
          "start": 136.56,
          "end": 139.47,
          "en": "but calling the parent widgets CREATEELEMENT method",
          "zh": ""
        },
        {
          "id": 47,
          "start": 139.47,
          "end": 141.3,
          "en": "and logging something.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 141.3,
          "end": 144.54,
          "en": "So unless you really know what you're doing, you won't need",
          "zh": ""
        },
        {
          "id": 49,
          "start": 144.54,
          "end": 146.91,
          "en": "to override this createElement method",
          "zh": ""
        },
        {
          "id": 50,
          "start": 146.91,
          "end": 148.71,
          "en": "and implement your own logic.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 148.71,
          "end": 150.18,
          "en": "Though you can do this",
          "zh": ""
        },
        {
          "id": 52,
          "start": 150.18,
          "end": 152.04,
          "en": "because this is indeed a method",
          "zh": ""
        },
        {
          "id": 53,
          "start": 152.04,
          "end": 154.74,
          "en": "that is also invoked by Flutter.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 154.74,
          "end": 156.69,
          "en": "And Flutter calls this method",
          "zh": ""
        },
        {
          "id": 55,
          "start": 156.69,
          "end": 159.03,
          "en": "to create the element for this widget.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 159.03,
          "end": 161.19,
          "en": "And that of course would be the element connected",
          "zh": ""
        },
        {
          "id": 57,
          "start": 161.19,
          "end": 163.47,
          "en": "to your widget object,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 163.47,
          "end": 165.21,
          "en": "and it would be this element",
          "zh": ""
        },
        {
          "id": 59,
          "start": 165.21,
          "end": 166.74,
          "en": "that would be used in conjunction",
          "zh": ""
        },
        {
          "id": 60,
          "start": 166.74,
          "end": 169.74,
          "en": "with all the other widget elements that make up your apps",
          "zh": ""
        },
        {
          "id": 61,
          "start": 169.74,
          "end": 172.71,
          "en": "to determine when the render tree must be updated",
          "zh": ""
        },
        {
          "id": 62,
          "start": 172.71,
          "end": 176.79,
          "en": "and which partial UI updates might be required.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 176.79,
          "end": 178.98,
          "en": "Now what you can of course see here is",
          "zh": ""
        },
        {
          "id": 64,
          "start": 178.98,
          "end": 181.26,
          "en": "that actually CREATEELEMENT is called",
          "zh": ""
        },
        {
          "id": 65,
          "start": 181.26,
          "end": 183.15,
          "en": "before BUILD is called,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 183.15,
          "end": 184.71,
          "en": "but you can think of that",
          "zh": ""
        },
        {
          "id": 67,
          "start": 184.71,
          "end": 187.65,
          "en": "as the element object being created",
          "zh": ""
        },
        {
          "id": 68,
          "start": 187.65,
          "end": 189.09,
          "en": "and then being updated",
          "zh": ""
        },
        {
          "id": 69,
          "start": 189.09,
          "end": 192.18,
          "en": "behind the scenes once your build method finished.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 192.18,
          "end": 194.04,
          "en": "b=Because it is your build method",
          "zh": ""
        },
        {
          "id": 71,
          "start": 194.04,
          "end": 197.22,
          "en": "that then also tells Flutter, which other widgets",
          "zh": ""
        },
        {
          "id": 72,
          "start": 197.22,
          "end": 199.8,
          "en": "and widget elements must be created",
          "zh": ""
        },
        {
          "id": 73,
          "start": 199.8,
          "end": 201.21,
          "en": "because that's always important.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 201.21,
          "end": 204.99,
          "en": "Flutter does not just create elements for your own widgets,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 204.99,
          "end": 207.93,
          "en": "but for all the widgets that make up the UI.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 207.93,
          "end": 210.24,
          "en": "So the Padding widget gets its own element.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 210.24,
          "end": 212.01,
          "en": "The Center widget gets its element,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 212.01,
          "end": 214.59,
          "en": "the Column widget and so on.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 214.59,
          "end": 218.13,
          "en": "And all these elements form the element tree,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 218.13,
          "end": 222.72,
          "en": "which is then used to find out whether UI updates are needed",
          "zh": ""
        },
        {
          "id": 81,
          "start": 222.72,
          "end": 225.21,
          "en": "and when the app is being rendered for the first time,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 225.21,
          "end": 227.7,
          "en": "of course the entire element tree is new",
          "zh": ""
        },
        {
          "id": 83,
          "start": 227.7,
          "end": 231.6,
          "en": "and therefore the entire UI is rendered for the first time.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 231.6,
          "end": 234.99,
          "en": "So this rendered tree for the UI is created",
          "zh": ""
        },
        {
          "id": 85,
          "start": 234.99,
          "end": 236.43,
          "en": "for the first time,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 236.43,
          "end": 239.49,
          "en": "but thereafter the element tree is only updated if",
          "zh": ""
        },
        {
          "id": 87,
          "start": 239.49,
          "end": 240.57,
          "en": "it needs to be updated.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 240.57,
          "end": 243.18,
          "en": "And the same is true for the render tree.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 243.18,
          "end": 246.24,
          "en": "If I for example, clicked this no button now,",
          "zh": ""
        },
        {
          "id": 90,
          "start": 246.24,
          "end": 248.37,
          "en": "nothing on the UI changed.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 248.37,
          "end": 251.04,
          "en": "If you take a look at the log though, you see",
          "zh": ""
        },
        {
          "id": 92,
          "start": 251.04,
          "end": 254.49,
          "en": "that UIUpdatesDemo BUILD was called again",
          "zh": ""
        },
        {
          "id": 93,
          "start": 254.49,
          "end": 256.05,
          "en": "and BUILD was called again",
          "zh": ""
        },
        {
          "id": 94,
          "start": 256.05,
          "end": 258.9,
          "en": "because the build method of a stateful widget,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 258.9,
          "end": 261.33,
          "en": "which this build method is in the end here,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 261.33,
          "end": 265.35,
          "en": "is always called when the state of that widget is updated,",
          "zh": ""
        },
        {
          "id": 97,
          "start": 265.35,
          "end": 267.9,
          "en": "which happens if I click the no or yes buttons",
          "zh": ""
        },
        {
          "id": 98,
          "start": 267.9,
          "end": 270.513,
          "en": "because for both buttons I called setState.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 271.457,
          "end": 275.67,
          "en": "Now in case of the no button, I set my isUnderstood state",
          "zh": ""
        },
        {
          "id": 100,
          "start": 275.67,
          "end": 279.06,
          "en": "to false though, and that also is my initial state.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 279.06,
          "end": 281.73,
          "en": "So therefore, of course I did update the state",
          "zh": ""
        },
        {
          "id": 102,
          "start": 281.73,
          "end": 284.07,
          "en": "and BUILD indeed was called again.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 284.07,
          "end": 287.73,
          "en": "But Flutter then determined that no new elements needed",
          "zh": ""
        },
        {
          "id": 104,
          "start": 287.73,
          "end": 291.65999999999997,
          "en": "to be created because no new widgets were added.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 291.65999999999997,
          "end": 293.25,
          "en": "I have one widget,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 293.25,
          "end": 296.22,
          "en": "this text widget here at the bottom which is displayed",
          "zh": ""
        },
        {
          "id": 107,
          "start": 296.22,
          "end": 300.42,
          "en": "conditionally, but if isUnderstood as false, it's not shown",
          "zh": ""
        },
        {
          "id": 108,
          "start": 300.42,
          "end": 303.78,
          "en": "and therefore its element doesn't need to be created.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 303.78,
          "end": 305.52,
          "en": "So therefore this is a great example",
          "zh": ""
        },
        {
          "id": 110,
          "start": 305.52,
          "end": 307.44,
          "en": "for the build method being called",
          "zh": ""
        },
        {
          "id": 111,
          "start": 307.44,
          "end": 310.23,
          "en": "and the widget tree being reevaluated",
          "zh": ""
        },
        {
          "id": 112,
          "start": 310.23,
          "end": 313.2,
          "en": "and partially recreated, but the element",
          "zh": ""
        },
        {
          "id": 113,
          "start": 313.2,
          "end": 315.96,
          "en": "and rendered trees would be left untouched if I",
          "zh": ""
        },
        {
          "id": 114,
          "start": 315.96,
          "end": 317.133,
          "en": "click no initially.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 318.09,
          "end": 320.61,
          "en": "Now, if I click yes though, that changes",
          "zh": ""
        },
        {
          "id": 116,
          "start": 320.61,
          "end": 323.04,
          "en": "because now this text here appeared",
          "zh": ""
        },
        {
          "id": 117,
          "start": 323.04,
          "end": 325.77,
          "en": "and this text is coming from this line of code",
          "zh": ""
        },
        {
          "id": 118,
          "start": 325.77,
          "end": 329.1,
          "en": "where this text widget is rendered conditionally",
          "zh": ""
        },
        {
          "id": 119,
          "start": 329.1,
          "end": 331.77,
          "en": "and therefore if we take a look at the log statements,",
          "zh": ""
        },
        {
          "id": 120,
          "start": 331.77,
          "end": 333,
          "en": "if I restart this",
          "zh": ""
        },
        {
          "id": 121,
          "start": 333,
          "end": 334.92,
          "en": "and click yes again, we see",
          "zh": ""
        },
        {
          "id": 122,
          "start": 334.92,
          "end": 336.813,
          "en": "that indeed BUILD was called again,",
          "zh": ""
        },
        {
          "id": 123,
          "start": 337.772,
          "end": 339.87,
          "en": "createElement was not called again",
          "zh": ""
        },
        {
          "id": 124,
          "start": 339.87,
          "end": 342.99,
          "en": "because this UIUpdatesDemo widget does not",
          "zh": ""
        },
        {
          "id": 125,
          "start": 342.99,
          "end": 344.25,
          "en": "need to be recreated.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 344.25,
          "end": 347.04,
          "en": "It was part of the element tree before as well.",
          "zh": ""
        },
        {
          "id": 127,
          "start": 347.04,
          "end": 348.45,
          "en": "But indeed createElement",
          "zh": ""
        },
        {
          "id": 128,
          "start": 348.45,
          "end": 351.45,
          "en": "for this text widget would've been called internally.",
          "zh": ""
        },
        {
          "id": 129,
          "start": 351.45,
          "end": 353.67,
          "en": "We're just not logging this here,",
          "zh": ""
        },
        {
          "id": 130,
          "start": 353.67,
          "end": 355.05,
          "en": "but for this text widget,",
          "zh": ""
        },
        {
          "id": 131,
          "start": 355.05,
          "end": 358.44,
          "en": "which now should be shown a new element was created",
          "zh": ""
        },
        {
          "id": 132,
          "start": 358.44,
          "end": 361.56,
          "en": "because initially this text widget did not have a text",
          "zh": ""
        },
        {
          "id": 133,
          "start": 361.56,
          "end": 363.87,
          "en": "element because it was not included",
          "zh": ""
        },
        {
          "id": 134,
          "start": 363.87,
          "end": 365.76,
          "en": "because of this condition.",
          "zh": ""
        },
        {
          "id": 135,
          "start": 365.76,
          "end": 369.03,
