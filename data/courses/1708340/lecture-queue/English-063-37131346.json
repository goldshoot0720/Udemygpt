        },
        {
          "id": 36,
          "start": 112.74000000000001,
          "end": 116.28,
          "en": "Therefore it's a stateless widget, and of course, as always,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 116.28,
          "end": 119.973,
          "en": "we import flutter/material.dart here,",
