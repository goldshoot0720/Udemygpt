        },
        {
          "id": 51,
          "start": 164.28,
          "end": 166.74,
          "en": "and all these buttons will then have the same styling",
          "zh": ""
        },
        {
          "id": 52,
          "start": 166.74,
          "end": 169.8,
          "en": "because the styling is locked into our custom widget.",
