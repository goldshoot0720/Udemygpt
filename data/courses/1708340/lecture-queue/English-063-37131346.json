        },
        {
          "id": 53,
          "start": 169.8,
          "end": 171.36,
          "en": "That's the plan.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 171.36,
          "end": 174.3,
          "en": "Now of course, the text that's set on this button",
