        },
        {
          "id": 81,
          "start": 262.17,
          "end": 263.58299999999997,
          "en": "to true or false.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 264.42,
          "end": 268.392,
          "en": "And with that data received, we can now update the state.",
