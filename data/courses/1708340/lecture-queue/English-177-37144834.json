        },
        {
          "id": 84,
          "start": 270.468,
          "end": 273.69,
          "en": "we must do this in an immutable way.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 273.69,
          "end": 276.57,
          "en": "So accessing state filter like this",
          "zh": ""
        },
        {
          "id": 86,
          "start": 276.57,
          "end": 279.909,
          "en": "and setting it to the updated value would not be allowed",
          "zh": ""
        },
        {
          "id": 87,
          "start": 279.909,
          "end": 283.95,
          "en": "because here, we are mutating the state in memory",
          "zh": ""
        },
        {
          "id": 88,
          "start": 283.95,
          "end": 285.363,
          "en": "and that's not allowed.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 286.62,
          "end": 288.63,
          "en": "Therefore, what you should do instead",
          "zh": ""
        },
        {
          "id": 90,
          "start": 288.63,
          "end": 291.81,
          "en": "is you should set the state to a new map",
