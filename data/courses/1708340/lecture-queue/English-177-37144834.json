          "zh": ""
        },
        {
          "id": 96,
          "start": 308.61,
          "end": 311.34,
          "en": "just as we did it for the list.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 311.34,
          "end": 314.55,
          "en": "This also works for maps inside of maps.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 314.55,
          "end": 318.09,
          "en": "So this copies the existing maps key value pairs",
          "zh": ""
        },
        {
          "id": 99,
          "start": 318.09,
          "end": 320.01,
          "en": "into this new map.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 320.01,
          "end": 323.421,
          "en": "And then we can explicitly set one key like here,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 323.421,
          "end": 327.483,
          "en": "this filter to a new value isActive.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 328.352,
          "end": 331.47,
          "en": "So that will then override the key value pair",
          "zh": ""
        },
        {
          "id": 103,
          "start": 331.47,
          "end": 334.8,
          "en": "with the same filter identifier that has been copied",
          "zh": ""
        },
        {
          "id": 104,
          "start": 334.8,
          "end": 337.98,
          "en": "and all the other key value pairs will be kept along",
          "zh": ""
        },
        {
          "id": 105,
          "start": 337.98,
          "end": 340.11,
          "en": "with this new setting here.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 340.11,
          "end": 342.81,
          "en": "And with that, we are creating a new map",
          "zh": ""
        },
        {
          "id": 107,
          "start": 342.81,
          "end": 345.06,
          "en": "with the old key value pairs",
          "zh": ""
        },
        {
          "id": 108,
          "start": 345.06,
          "end": 347.43,
          "en": "and one new key value pair",
          "zh": ""
        },
        {
          "id": 109,
          "start": 347.43,
          "end": 350.37,
          "en": "that overwrites the respective old key value pair",
