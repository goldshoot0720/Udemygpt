        },
        {
          "id": 17,
          "start": 48.57,
          "end": 49.59,
          "en": "or anything like that.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 49.59,
          "end": 52.14,
          "en": "The name is, of course, up to you.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 52.14,
          "end": 55.38,
          "en": "It's a method that doesn't need to return anything,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 55.38,
          "end": 58.59,
          "en": "hence it's return type is void.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 58.59,
          "end": 60.72,
          "en": "And inside of the curly braces,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 60.72,
          "end": 61.95,
          "en": "so between the curly braces,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 61.95,
          "end": 64.92,
          "en": "we're going to add the logic for showing this overlay.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 64.92,
          "end": 65.88,
          "en": "But before we do that,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 65.88,
          "end": 69.36,
          "en": "we wanna assign this function as a value to onPressed",
          "zh": ""
        },
        {
          "id": 26,
          "start": 69.36,
          "end": 70.95,
          "en": "by pointing at it like this",
          "zh": ""
        },
        {
          "id": 27,
          "start": 70.95,
          "end": 73.17,
          "en": "as you learned without parentheses",
          "zh": ""
        },
        {
          "id": 28,
          "start": 73.17,
          "end": 75.45,
          "en": "since we don't want to execute the function here,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 75.45,
