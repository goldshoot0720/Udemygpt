        },
        {
          "id": 78,
          "start": 231.15,
          "end": 234.3,
          "en": "to have a slightly transparent image.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 234.3,
          "end": 237.42000000000002,
          "en": "And these are some additional styling things",
          "zh": ""
        },
        {
          "id": 80,
          "start": 237.42000000000002,
