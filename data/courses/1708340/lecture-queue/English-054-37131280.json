        },
        {
          "id": 81,
          "start": 239.16,
          "end": 242.43,
          "en": "to make it look exactly the way it should look.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 242.43,
          "end": 243.39,
          "en": "So for the moment,",
          "zh": ""
        },
        {
          "id": 83,
