        },
        {
          "id": 7,
          "start": 19.02,
          "end": 21.78,
          "en": "the name of the clause, ExpenseBucket,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 21.78,
          "end": 24.45,
          "en": "and then adding a dot right after it",
          "zh": ""
        },
        {
          "id": 9,
          "start": 24.45,
          "end": 26.82,
          "en": "inside here of the class definition",
          "zh": ""
        },
        {
          "id": 10,
