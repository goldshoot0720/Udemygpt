        },
        {
          "id": 88,
          "start": 238.77,
          "end": 240.22,
          "en": "so we can copy this",
          "zh": ""
        },
        {
          "id": 89,
          "start": 241.08,
          "end": 242.1,
          "en": "and paste it in here",
