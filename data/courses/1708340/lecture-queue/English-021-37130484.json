        },
        {
          "id": 41,
          "start": 101.91,
          "end": 103.2,
          "en": "When defining the function,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 103.2,
          "end": 106.77000000000001,
          "en": "you wrap those parameters between curly braces.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 106.77000000000001,
          "end": 108.57,
          "en": "And again, that is also something",
          "zh": ""
        },
        {
          "id": 44,
          "start": 108.57,
          "end": 109.83,
          "en": "you will learn about later",
          "zh": ""
        },
        {
          "id": 45,
          "start": 109.83,
          "end": 111.24000000000001,
          "en": "in the course in greater detail,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 111.24000000000001,
          "end": 114.06,
          "en": "and which you will do a lot throughout the course.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 114.06,
          "end": 116.28,
          "en": "But in the code where you define a function,",
