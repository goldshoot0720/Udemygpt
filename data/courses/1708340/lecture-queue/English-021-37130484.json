          "en": "when calling that function",
          "zh": ""
        },
        {
          "id": 33,
          "start": 81.12,
          "end": 83.4,
          "en": "would be mapped to the first parameter,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 83.4,
          "end": 86.28,
          "en": "the second value to the second parameter, and so on.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 86.28,
          "end": 88.17,
          "en": "That's one way of accepting",
          "zh": ""
        },
        {
          "id": 36,
          "start": 88.17,
          "end": 90.363,
          "en": "and receiving parameters in dart.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 91.23,
          "end": 92.72999999999999,
          "en": "But an alternative way,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 92.72999999999999,
          "end": 95.4,
          "en": "which you will also learn in greater detail later,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 95.4,
          "end": 97.68,
          "en": "is to define functions that take",
          "zh": ""
        },
        {
          "id": 40,
          "start": 97.68,
          "end": 101.91,
          "en": "so-called named parameters or named arguments.",
