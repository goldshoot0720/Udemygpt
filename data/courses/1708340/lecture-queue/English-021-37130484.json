      "cues": [
        {
          "id": 1,
          "start": 2.04,
          "end": 2.91,
          "en": "Now as mentioned,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.91,
          "end": 6.63,
          "en": "MaterialApp then also needs input value though.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.63,
          "end": 9.03,
          "en": "Because like this, this MaterialApp thing",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.03,
          "end": 11.58,
          "en": "doesn't provide too much information",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.58,
          "end": 13.62,
          "en": "to Flutter and to runApp",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.62,
          "end": 16.65,
          "en": "regarding what should be displayed on the screen.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 16.65,
          "end": 19.83,
          "en": "Instead, you must pass more information to MaterialApp",
          "zh": ""
        },
        {
          "id": 8,
          "start": 19.83,
          "end": 22.77,
          "en": "so that that information will then indirectly",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.77,
          "end": 24.93,
          "en": "also be picked up by Flutter.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 24.93,
          "end": 27.39,
          "en": "And for that, between those parentheses here,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 27.39,
          "end": 29.19,
          "en": "which belong to MaterialApp,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 29.19,
