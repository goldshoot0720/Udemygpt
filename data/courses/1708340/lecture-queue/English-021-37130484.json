          "zh": ""
        },
        {
          "id": 14,
          "start": 36.51,
          "end": 39.51,
          "en": "what should be shown inside of that app UI",
          "zh": ""
        },
        {
          "id": 15,
          "start": 39.51,
          "end": 41.91,
          "en": "that will be displayed on the screen.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 41.91,
          "end": 43.56,
          "en": "And for this, MaterialApp",
          "zh": ""
        },
        {
          "id": 17,
          "start": 43.56,
          "end": 46.35,
          "en": "also takes input value, a parameter,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 46.35,
          "end": 49.65,
          "en": "though not a parameter that would be defined like this,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 49.65,
          "end": 51.39,
          "en": "as is the case for runApp,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 51.39,
          "end": 54.36,
          "en": "a so-called positional parameter",
          "zh": ""
        },
        {
          "id": 21,
          "start": 54.36,
          "end": 56.64,
          "en": "or positional argument.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 56.64,
          "end": 58.17,
          "en": "Because here for runApp,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 58.17,
          "end": 60.9,
          "en": "the first value you pass to runApp",
          "zh": ""
        },
        {
          "id": 24,
          "start": 60.9,
          "end": 63.63,
          "en": "is used as a value for the first parameter",
          "zh": ""
        },
        {
          "id": 25,
          "start": 63.63,
          "end": 65.19,
          "en": "in this parameter list.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 65.19,
          "end": 68.4,
          "en": "And of course, runApp only takes one parameter,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 68.4,
          "end": 70.28999999999999,
          "en": "but other functions could also take",
          "zh": ""
        },
        {
          "id": 28,
          "start": 70.28999999999999,
          "end": 72.84,
          "en": "multiple comma-separated parameters.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 72.84,
          "end": 74.91,
          "en": "And then values would be passed",
          "zh": ""
        },
        {
          "id": 30,
          "start": 74.91,
          "end": 76.98,
          "en": "in a matched by position.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 76.98,
          "end": 79.62,
          "en": "So the first value provided to a function",
          "zh": ""
        },
        {
