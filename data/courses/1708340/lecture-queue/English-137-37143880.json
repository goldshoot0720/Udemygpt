          "end": 16.2,
          "en": "the build method is called very frequently",
          "zh": ""
        },
        {
          "id": 7,
          "start": 16.2,
          "end": 18.51,
          "en": "whenever the state changes, for example.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 18.51,
          "end": 19.343,
          "en": "But on the other hand,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 19.343,
          "end": 22.86,
          "en": "elements are not recreated unnecessarily.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 22.86,
          "end": 25.89,
          "en": "Now we can also use this newly gained knowledge",
