          "id": 48,
          "start": 149.13,
          "end": 152.37,
          "en": "It will emit a new event without data",
          "zh": ""
        },
        {
          "id": 49,
          "start": 152.37,
          "end": 155.97,
          "en": "because no authentication token will exist anymore,",
          "zh": ""
        },
        {
          "id": 50,
