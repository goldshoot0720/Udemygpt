        },
        {
          "id": 45,
          "start": 142.56,
          "end": 144.51,
          "en": "as the user gets logged out,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 144.51,
          "end": 147.69,
          "en": "because Firebase will indeed emit a new event",
