{
  "version": 1,
  "courseId": 1708340,
  "courseSlug": "learn-flutter-dart-to-build-ios-android-apps",
  "courseTitle": "Flutter & Dart - The Complete Guide",
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "37143894",
      "title": "Understanding & Using Keys",
      "lectureOrder": 151,
      "videoOrder": 139,
      "sourceHash": "70cd2e20315439c9c404ba31c41ddca9c27048368b5a6174ffea7201ea87c411",
      "cues": [
        {
          "id": 1,
          "start": 2.07,
          "end": 4.05,
          "en": "So how can keys help us",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.05,
          "end": 6.54,
          "en": "solve this problem here?",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.54,
          "end": 7.65,
          "en": "To understand this,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 7.65,
          "end": 9.06,
          "en": "it's important to understand",
          "zh": ""
        },
        {
          "id": 5,
          "start": 9.06,
          "end": 11.52,
          "en": "that Flutter determines whether an element",
          "zh": ""
        },
        {
          "id": 6,
          "start": 11.52,
          "end": 13.35,
          "en": "can be reused or not",
          "zh": ""
        },
        {
          "id": 7,
          "start": 13.35,
          "end": 16.53,
          "en": "simply by taking a look at the type of that element,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 16.53,
          "end": 18.42,
          "en": "for example, to-do item.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 18.42,
          "end": 20.64,
          "en": "And if that type is in line",
          "zh": ""
        },
        {
          "id": 10,
          "start": 20.64,
          "end": 23.04,
          "en": "with the type it finds in the widget tree",
          "zh": ""
        },
        {
          "id": 11,
          "start": 23.04,
          "end": 26.55,
          "en": "in that position where the element is, it's happy,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 26.55,
          "end": 28.17,
          "en": "and it keeps that element",
          "zh": ""
        },
        {
          "id": 13,
          "start": 28.17,
          "end": 30.99,
          "en": "and just makes sure to update the reference",
          "zh": ""
        },
        {
          "id": 14,
          "start": 30.99,
          "end": 33.03,
          "en": "to the widget it found in the same place",
          "zh": ""
        },
        {
          "id": 15,
          "start": 33.03,
          "end": 34.38,
          "en": "in the widget tree.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 34.38,
          "end": 35.213,
          "en": "That's all.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 35.213,
          "end": 37.89,
          "en": "But it just takes a look at the element type",
          "zh": ""
        },
        {
          "id": 18,
          "start": 37.89,
          "end": 38.973,
          "en": "and the widget type.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 40.08,
          "end": 42.15,
          "en": "And that's why the state doesn't move along",
          "zh": ""
        },
        {
          "id": 20,
          "start": 42.15,
          "end": 45.09,
          "en": "because of course the types here didn't change.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 45.09,
          "end": 47.91,
          "en": "We're still dealing with to-do items,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 47.91,
          "end": 49.59,
          "en": "but this behavior changes",
          "zh": ""
        },
        {
          "id": 23,
          "start": 49.59,
          "end": 51.51,
          "en": "if we introduce keys.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 51.51,
          "end": 53.46,
          "en": "If we add keys to widgets,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 53.46,
          "end": 57.03,
          "en": "those keys are also added to the elements.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 57.03,
          "end": 59.64,
          "en": "And now if your widgets move around,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 59.64,
          "end": 61.59,
          "en": "the keys move with them.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 61.59,
          "end": 64.98,
          "en": "And if Flutter finds a key on an element,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 64.98,
          "end": 68.73,
          "en": "it does not just take a look at the element in widget types,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 68.73,
          "end": 71.07,
          "en": "but also at their keys.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 71.07,
          "end": 73.02,
          "en": "And therefore here it would then see",
          "zh": ""
        },
        {
          "id": 32,
          "start": 73.02,
          "end": 75.24,
          "en": "that the keys don't match.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 75.24,
          "end": 78.3,
          "en": "And it would then also update the key on the element",
          "zh": ""
        },
        {
          "id": 34,
          "start": 78.3,
          "end": 80.13,
          "en": "and move those states.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 80.13,
          "end": 83.25,
          "en": "So it would move the elements, you could say.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 83.25,
          "end": 86.19,
          "en": "And therefore, then, with the usage of keys,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 86.19,
          "end": 90.45,
          "en": "which are simply an additional identification criteria",
          "zh": ""
        },
        {
          "id": 38,
          "start": 90.45,
          "end": 93.78,
          "en": "allowing Flutter to match elements to widgets,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 93.78,
          "end": 95.88,
          "en": "Flutter is able to make sure",
          "zh": ""
        },
        {
          "id": 40,
          "start": 95.88,
          "end": 98.49000000000001,
          "en": "that every widget has exactly the element",
          "zh": ""
        },
        {
          "id": 41,
          "start": 98.49000000000001,
          "end": 101.07,
          "en": "with exactly the state it needs.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 101.07,
          "end": 103.22999999999999,
          "en": "So therefore, here, in this example,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 103.22999999999999,
          "end": 105.50999999999999,
          "en": "the fix is to go to keys.dart",
          "zh": ""
        },
        {
          "id": 44,
          "start": 105.50999999999999,
          "end": 109.86,
          "en": "and add a key to our CheckableTodoItems.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 109.86,
          "end": 112.08,
          "en": "And that's also why it's recommended",
          "zh": ""
        },
        {
          "id": 46,
          "start": 112.08,
          "end": 115.77000000000001,
          "en": "to accept a key in the constructor function",
          "zh": ""
        },
        {
          "id": 47,
          "start": 115.77000000000001,
          "end": 118.41,
          "en": "on all your own widget classes",
          "zh": ""
        },
        {
          "id": 48,
          "start": 118.41,
          "end": 121.02,
          "en": "because that makes it very easy to set a key",
          "zh": ""
        },
        {
          "id": 49,
          "start": 121.02,
          "end": 123.69,
          "en": "if you ever need to do that.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 123.69,
          "end": 125.34,
          "en": "Now, the key is then forwarded",
          "zh": ""
        },
        {
          "id": 51,
          "start": 125.34,
          "end": 126.45,
          "en": "to the parent class",
          "zh": ""
        },
        {
          "id": 52,
          "start": 126.45,
          "end": 129.3,
          "en": "so that Flutter can do its thing with it.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 129.3,
          "end": 132.66,
          "en": "But that is why you should always accept this key parameter",
          "zh": ""
        },
        {
          "id": 54,
          "start": 132.66,
          "end": 135.6,
          "en": "so that you can always set it if you need to.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 135.6,
          "end": 138.54,
          "en": "Like here where I actually need to set a key",
          "zh": ""
        },
        {
          "id": 56,
          "start": 138.54,
          "end": 140.4,
          "en": "on the CheckableTodoItem,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 140.4,
          "end": 143.46,
          "en": "which also accepts keys, of course.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 143.46,
          "end": 146.61,
          "en": "And we can set that key by adding that key parameter,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 146.61,
          "end": 149.37,
          "en": "which we are accepting in the constructor function",
          "zh": ""
        },
        {
          "id": 60,
          "start": 149.37,
          "end": 150.81,
          "en": "of this widget.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 150.81,
          "end": 153.21,
          "en": "And the only remaining question now is,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 153.21,
          "end": 155.61,
          "en": "which kind of value should we set",
          "zh": ""
        },
        {
          "id": 63,
          "start": 155.61,
          "end": 158.49,
          "en": "as a value for this parameter?",
          "zh": ""
        },
        {
          "id": 64,
          "start": 158.49,
          "end": 160.92000000000002,
          "en": "Well, in here, you got two main keys",
          "zh": ""
        },
        {
          "id": 65,
          "start": 160.92000000000002,
          "end": 163.35,
          "en": "which you should typically use.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 163.35,
          "end": 165.69,
          "en": "The first one is a so-called ValueKey",
          "zh": ""
        },
        {
          "id": 67,
          "start": 165.69,
          "end": 168.633,
          "en": "created with Flutters ValueKey class.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 169.5,
          "end": 173.52,
          "en": "ValueKey wants a value, any kind of value,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 173.52,
          "end": 174.63,
          "en": "it's a dynamic type,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 174.63,
          "end": 177.09,
          "en": "so you can pass a number, a text,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 177.09,
          "end": 178.59,
          "en": "or anything like this.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 178.59,
          "end": 180.27,
          "en": "And this will then internally be used",
          "zh": ""
        },
        {
          "id": 73,
          "start": 180.27,
          "end": 183.09,
          "en": "as an identification criteria.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 183.09,
          "end": 184.65,
          "en": "So therefore here we could, for example,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 184.65,
          "end": 186.09,
          "en": "use the todo.text",
          "zh": ""
        },
        {
          "id": 76,
          "start": 186.09,
          "end": 189.39,
          "en": "because that should be unique for every to-do.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 189.39,
          "end": 191.49,
          "en": "If our to-dos had IDs,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 191.49,
          "end": 193.62,
          "en": "we might wanna use those IDs instead,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 193.62,
          "end": 196.32,
          "en": "because that would be an even better value.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 196.32,
          "end": 198.03,
          "en": "But here it's the todo.text,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 198.03,
          "end": 200.49,
          "en": "and if we add such a ValueKey here,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 200.49,
          "end": 202.29,
          "en": "we'll see that now in this app",
          "zh": ""
        },
        {
          "id": 83,
          "start": 202.29,
          "end": 204.63,
          "en": "indeed the state does move together",
          "zh": ""
        },
        {
          "id": 84,
          "start": 204.63,
          "end": 205.95,
          "en": "with the widget.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 205.95,
          "end": 208.443,
          "en": "So now this app is working the way it should.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 209.31,
          "end": 211.56,
          "en": "Now, as an alternative to this ValueKey,",
          "zh": ""
        },
        {
          "id": 87,
          "start": 211.56,
          "end": 213.63,
          "en": "we could also use an ObjectKey,",
          "zh": ""
        },
        {
          "id": 88,
          "start": 213.63,
          "end": 217.14,
          "en": "and then we could use the entire to-do object as a value.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 217.14,
          "end": 218.97,
          "en": "That is also something you could do,",
          "zh": ""
        },
        {
          "id": 90,
          "start": 218.97,
          "end": 221.79,
          "en": "though I personally prefer the ValueKey",
          "zh": ""
        },
        {
          "id": 91,
          "start": 221.79,
          "end": 223.47,
          "en": "simply because, behind the scenes,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 223.47,
          "end": 225.3,
          "en": "it's also a bit more lightweight",
          "zh": ""
        },
        {
          "id": 93,
          "start": 225.3,
          "end": 227.76,
          "en": "because it only needs to manage a single value",
          "zh": ""
        },
        {
          "id": 94,
          "start": 227.76,
          "end": 229.44,
          "en": "instead of an entire object.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 229.44,
          "end": 231.57,
          "en": "But both keys work fine.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 231.57,
          "end": 233.16,
          "en": "The only important thing",
          "zh": ""
        },
        {
          "id": 97,
          "start": 233.16,
          "end": 236.01,
          "en": "is that those values must be unique",
          "zh": ""
        },
        {
          "id": 98,
          "start": 236.01,
          "end": 240.03,
          "en": "and must be directly connected to your data.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 240.03,
          "end": 242.43,
          "en": "So don't use any random numbers",
          "zh": ""
        },
        {
          "id": 100,
          "start": 242.43,
          "end": 243.57,
          "en": "that change all the time",
          "zh": ""
        },
        {
          "id": 101,
          "start": 243.57,
          "end": 244.74,
          "en": "or anything like that,",
          "zh": ""
        },
        {
          "id": 102,
          "start": 244.74,
          "end": 246.69,
          "en": "but instead, use key values",
          "zh": ""
        },
        {
          "id": 103,
          "start": 246.69,
          "end": 249.03,
          "en": "that are directly connected to your data",
          "zh": ""
        },
        {
          "id": 104,
          "start": 249.03,
          "end": 250.203,
          "en": "and that are unique.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
