        {
          "id": 17,
          "start": 78.16,
          "end": 79.42,
          "en": "here it is.",
          "zh": "它就在這裡。"
        },
        {
          "id": 18,
          "start": 79.53999999999999,
          "end": 82.7,
          "en": "I'll remove the spec testing file, we don't need that right now",
          "zh": "我會移除 spec 測試檔，我們目前不需要它，"
        },
        {
          "id": 19,
          "start": 82.98,
          "end": 87.7,
          "en": "and here, that places service, here I want to manage my places.",
          "zh": "而在這裡，這個 places service，我想要在這裡管理我的 places。"
        },
        {
          "id": 20,
          "start": 87.76,
          "end": 90.24,
          "en": "Now we'll get more sophisticated there",
