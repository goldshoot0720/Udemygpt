        {
          "id": 94,
          "start": 242.933,
          "end": 244.86599999999999,
          "en": "and fetch data from a database, to validate user input",
          "zh": "並從資料庫取得資料、驗證使用者的輸入，"
        },
        {
          "id": 95,
          "start": 244.86599999999999,
          "end": 248.8,
          "en": "or to do any other kind of task.",
          "zh": "或執行任何其他種類的工作。"
        },
        {
          "id": 96,
          "start": 248.8,
          "end": 252.266,
          "en": "So here we have our expense date,",
