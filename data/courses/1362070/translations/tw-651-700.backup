        {
          "id": 117,
          "start": 306.233,
          "end": 306.666,
          "en": "Single curly braces opening and closing.",
          "zh": "單一組開頭和結尾的大括號。"
        },
        {
          "id": 118,
          "start": 306.666,
          "end": 309.233,
          "en": "And the special thing about these curly braces",
          "zh": "而這些大括號特別的地方在於，"
