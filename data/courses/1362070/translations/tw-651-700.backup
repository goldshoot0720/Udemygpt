        {
          "id": 125,
          "start": 325.4,
          "end": 326.933,
          "en": "before we return",
          "zh": "在我們 return 之前，"
        },
        {
          "id": 126,
          "start": 326.933,
          "end": 329.83299999999997,
          "en": "and we can check if filtered expenses length",
          "zh": "我們可以檢查 filtered expenses 的 length"
        },
        {
          "id": 127,
          "start": 329.83299999999997,
          "end": 331.866,
          "en": "is greater than zero,",
          "zh": "是否大於零，"
        },
        {
          "id": 128,
          "start": 331.866,
          "end": 332.06600000000003,
          "en": "is greater than zero,",
          "zh": "是否大於零，"
        },
        {
          "id": 129,
          "start": 332.06600000000003,
          "end": 335.3,
          "en": "so if we do have filtered expenses.",
          "zh": "也就是如果我們確實有篩選後的支出。"
        },
        {
          "id": 130,
          "start": 335.3,
          "end": 335.866,
          "en": "so if we do have filtered expenses.",
          "zh": "也就是如果我們確實有篩選後的支出。"
        },
        {
          "id": 131,
          "start": 335.866,
          "end": 336.966,
          "en": "And if that's the case,",
          "zh": "如果真是這樣，"
        },
        {
          "id": 132,
