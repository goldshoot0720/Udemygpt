        },
        {
          "id": 135,
          "start": 350.366,
          "end": 352.7,
          "en": "Now that's something we can do.",
          "zh": "這是我們可以做的事。"
        },
        {
          "id": 136,
          "start": 352.7,
          "end": 353.33299999999997,
          "en": "Now that's something we can do.",
          "zh": "這是我們可以做的事。"
        },
        {
          "id": 137,
          "start": 353.33299999999997,
          "end": 355.6,
          "en": "Now here. I don't wanna get a random number,",
