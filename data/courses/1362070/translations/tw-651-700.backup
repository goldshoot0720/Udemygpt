        {
          "id": 140,
          "start": 361.5,
          "end": 363.1,
          "en": "in this constant.",
          "zh": "這個常數裡的值。"
        },
        {
          "id": 141,
          "start": 363.1,
          "end": 367.233,
          "en": "And therefore we can just repeat that constant name here.",
          "zh": "因此我們可以在這裡直接重複那個常數名稱。"
        },
        {
          "id": 142,
          "start": 367.233,
          "end": 367.566,
          "en": "And therefore we can just repeat that constant name here.",
          "zh": "因此我們可以在這裡直接重複那個常數名稱。"
        },
        {
          "id": 143,
          "start": 367.566,
          "end": 371.4,
          "en": "This is also a valid JavaScript expression",
          "zh": "這也是一個有效的 JavaScript 運算式，"
        },
        {
          "id": 144,
          "start": 371.4,
          "end": 375.3,
          "en": "just pointing at a variable or a constant.",
          "zh": "只是指向一個變數或常數。"
        },
        {
          "id": 145,
          "start": 375.3,
          "end": 377.266,
          "en": "In this case a constant.",
          "zh": "在這個例子裡是一個常數。"
        },
        {
          "id": 146,
          "start": 377.266,
          "end": 377.566,
          "en": "In this case a constant.",
          "zh": "在這個例子裡是一個常數。"
        },
        {
          "id": 147,
          "start": 377.566,
          "end": 380.266,
          "en": "And now JavaScript will extract the value",
          "zh": "而現在 JavaScript 會取出"
