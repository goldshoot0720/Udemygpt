{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "39836928",
      "title": "Module Introduction",
      "sourceHash": "5fe126c4deda4bbaa883ee66aa8767da62acfbdefe50db9498dc9b3d8fab7179",
      "cues": [
        {
          "id": 1,
          "start": 0.36,
          "end": 3.42,
          "en": "Up to this point in the course,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.42,
          "end": 6.96,
          "en": "we always worked with demo projects",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.96,
          "end": 11.96,
          "en": "where all the data that was required for those projects",
          "zh": ""
        },
        {
          "id": 4,
          "start": 12.21,
          "end": 15.69,
          "en": "was part of the React project.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 15.69,
          "end": 20.49,
          "en": "For example, this project where we could pick a place,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 20.49,
          "end": 25.05,
          "en": "there all the place dummy data and all the place images",
          "zh": ""
        },
        {
          "id": 7,
          "start": 25.05,
          "end": 28.68,
          "en": "were part of the React project.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 28.68,
          "end": 30.42,
          "en": "And whilst you, of course,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 30.42,
          "end": 33.15,
          "en": "might be building projects like this,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 33.15,
          "end": 35.34,
          "en": "that's not always enough.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 35.34,
          "end": 39.87,
          "en": "It's indeed quite common that you need to build projects",
          "zh": ""
        },
        {
          "id": 12,
          "start": 39.87,
          "end": 44.25,
          "en": "where the data is centrally managed on some server",
          "zh": ""
        },
        {
          "id": 13,
          "start": 44.25,
          "end": 47.19,
          "en": "so that users from all over the world",
          "zh": ""
        },
        {
          "id": 14,
          "start": 47.19,
          "end": 49.17,
          "en": "can operate on that data",
          "zh": ""
        },
        {
          "id": 15,
          "start": 49.17,
          "end": 52.83,
          "en": "and can maybe also change that data.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 52.83,
          "end": 54.72,
          "en": "If you are trying to build something",
          "zh": ""
        },
        {
          "id": 17,
          "start": 54.72,
          "end": 57.09,
          "en": "like Facebook or Amazon,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 57.09,
          "end": 59.85,
          "en": "you of course can't manage the data",
          "zh": ""
        },
        {
          "id": 19,
          "start": 59.85,
          "end": 62.13,
          "en": "inside of the React project",
          "zh": ""
        },
        {
          "id": 20,
          "start": 62.13,
          "end": 66.39,
          "en": "because that React project code in the end",
          "zh": ""
        },
        {
          "id": 21,
          "start": 66.39,
          "end": 71.39,
          "en": "gets executed inside of the browsers of your visitors.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 71.61,
          "end": 75.42,
          "en": "So different users from different parts of the world",
          "zh": ""
        },
        {
          "id": 23,
          "start": 75.42,
          "end": 78.53999999999999,
          "en": "each have their own copy of the React project",
          "zh": ""
        },
        {
          "id": 24,
          "start": 78.53999999999999,
          "end": 80.4,
          "en": "running in their browser,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 80.4,
          "end": 82.98,
          "en": "but they can't interact with each other.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 82.98,
          "end": 85.56,
          "en": "They can't exchange data",
          "zh": ""
        },
        {
          "id": 27,
          "start": 85.56,
          "end": 88.95,
          "en": "unless there is some central server,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 88.95,
          "end": 93.95,
          "en": "some central database in between them that can be reached",
          "zh": ""
        },
        {
          "id": 29,
          "start": 94.11,
          "end": 97.2,
          "en": "from all those different locations on the world,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 97.2,
          "end": 99.9,
          "en": "so from all those different React apps",
          "zh": ""
        },
        {
          "id": 31,
          "start": 99.9,
          "end": 101.793,
          "en": "running on different computers.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 102.87,
          "end": 106.32,
          "en": "And therefore, in this course section here,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 106.32,
          "end": 111.32,
          "en": "we'll take a look at data fetching and sending HTTP requests",
          "zh": ""
        },
        {
          "id": 34,
          "start": 111.36,
          "end": 113.7,
          "en": "from inside React apps.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 113.7,
          "end": 118.7,
          "en": "We'll explore how your React apps can get and send data",
          "zh": ""
        },
        {
          "id": 36,
          "start": 118.97999999999999,
          "end": 122.73,
          "en": "from and to such central servers",
          "zh": ""
        },
        {
          "id": 37,
          "start": 122.73,
          "end": 126.18,
          "en": "so that you're not limited to building React apps",
          "zh": ""
        },
        {
          "id": 38,
          "start": 126.18,
          "end": 128.67,
          "en": "that work with local dummy data,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 128.67,
          "end": 131.85,
          "en": "but that you instead can also build apps",
          "zh": ""
        },
        {
          "id": 40,
          "start": 131.85,
          "end": 136.35,
          "en": "that need to communicate with such a central server.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 136.35,
          "end": 139.95,
          "en": "And therefore, in this course section here,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 139.95,
          "end": 144.12,
          "en": "you will learn how you can connect your React app",
          "zh": ""
        },
        {
          "id": 43,
          "start": 144.12,
          "end": 146.57999999999998,
          "en": "to such a backend server,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 146.57999999999998,
          "end": 151.11,
          "en": "to a database that may need to store shared data",
          "zh": ""
        },
        {
          "id": 45,
          "start": 151.11,
          "end": 154.383,
          "en": "created and accessed by different users,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 155.49,
          "end": 158.73,
          "en": "and we will explore how you can fetch data,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 158.73,
          "end": 161.52,
          "en": "so how you can download and use data",
          "zh": ""
        },
        {
          "id": 48,
          "start": 161.52,
          "end": 162.81,
          "en": "in your React app,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 162.81,
          "end": 166.11,
          "en": "and how you can send data from your React app",
          "zh": ""
        },
        {
          "id": 50,
          "start": 166.11,
          "end": 167.67000000000002,
          "en": "to such a server,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 167.67000000000002,
          "end": 171.813,
          "en": "how you can, for example, store user generated data.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}