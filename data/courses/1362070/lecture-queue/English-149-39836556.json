        },
        {
          "id": 86,
          "start": 270.78,
          "end": 273.6,
          "en": "so that this input field here is cleared",
          "zh": ""
        },
        {
          "id": 87,
          "start": 273.6,
          "end": 275.613,
          "en": "after clicking Add Task.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 277.74,
          "end": 280.77,
          "en": "Therefore in there I'll start with that resetting",
          "zh": ""
        },
        {
          "id": 89,
          "start": 280.77,
          "end": 284.223,
          "en": "by setting setEnteredTask to an empty string.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 286.05,
          "end": 288.78,
          "en": "But now we of course also must take care",
