        },
        {
          "id": 74,
          "start": 231.653,
          "end": 234.63,
          "en": "let's go back to this NewTask component",
          "zh": ""
        },
        {
          "id": 75,
          "start": 234.63,
          "end": 236.55,
          "en": "because there we get this button,",
