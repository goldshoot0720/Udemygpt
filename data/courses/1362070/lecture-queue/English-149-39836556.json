        },
        {
          "id": 72,
          "start": 225.96,
          "end": 229.203,
          "en": "that we will manage these tasks in this component here.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 230.82,
          "end": 231.653,
          "en": "But with that,",
