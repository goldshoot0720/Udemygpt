        },
        {
          "id": 79,
          "start": 259.53,
          "end": 262.53,
          "en": "we wanna call this state updating function",
          "zh": ""
        },
        {
          "id": 80,
          "start": 262.53,
          "end": 263.703,
          "en": "provided by useState.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 266.164,
          "end": 268.53,
          "en": "So here I wanna call set is editing",
          "zh": ""
        },
        {
          "id": 82,
          "start": 268.53,
          "end": 273.53,
          "en": "and pass the new state value as a value to set is editing.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 273.6,
          "end": 275.373,
          "en": "So here we'll set this to true.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 276.72,
          "end": 278.04,
          "en": "Initially it's false.",
