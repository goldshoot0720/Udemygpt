    {
      "id": "25600216",
      "title": "Reading & Dispatching From A New Slice",
      "sourceHash": "0d59187cb4e6824f3e68b590621c52849caeb84dcd015488773201c1f0bb74a1",
      "cues": [
        {
          "id": 1,
          "start": 2.05,
          "end": 3.64,
          "en": "Were you successful?",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.64,
          "end": 5.36,
          "en": "Let's do it together.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.36,
          "end": 8.33,
          "en": "And for this, let's maybe start in the App component",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.33,
          "end": 10.04,
          "en": "and render the Auth component,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.04,
          "end": 12.15,
          "en": "if we're not authenticated",
          "zh": ""
        },
        {
          "id": 6,
          "start": 12.15,
          "end": 16.57,
          "en": "and render UserProfile if we are authenticated.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 16.57,
          "end": 19.282,
          "en": "So for this, I'll also import UserProfile",
          "zh": ""
        },
        {
          "id": 8,
          "start": 19.282,
          "end": 23.81,
          "en": "from ./components/UserProfile.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 23.81,
          "end": 25.06,
          "en": "And then here,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 25.06,
          "end": 27.95,
          "en": "we need to tap into our",
          "zh": ""
        },
        {
          "id": 11,
          "start": 27.95,
          "end": 28.88,
          "en": "store",
          "zh": ""
        },
        {
          "id": 12,
          "start": 28.88,
          "end": 31.35,
          "en": "and read a value from there.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 31.35,
          "end": 33.75,
          "en": "And we do that with useSelector.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 33.75,
          "end": 36.55,
          "en": "So I'll import useSelector",
          "zh": ""
        },
        {
          "id": 15,
          "start": 36.55,
          "end": 39.34,
          "en": "from React-Redux",
          "zh": ""
        },
        {
          "id": 16,
          "start": 40.3,
          "end": 42.8,
          "en": "and in the App component function",
          "zh": ""
        },
        {
          "id": 17,
          "start": 42.8,
          "end": 46.8,
          "en": "we therefore call useSelector, pass a function to it",
          "zh": ""
        },
        {
          "id": 18,
          "start": 46.8,
          "end": 50.07,
          "en": "a function which will always receive state as a argument",
          "zh": ""
        },
        {
          "id": 19,
          "start": 50.07,
          "end": 55.07,
          "en": "that's passed in by Redux or by React Redux to be precise.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 55.51,
          "end": 58.98,
          "en": "And then here, I wanna return state.auth",
          "zh": ""
        },
        {
          "id": 21,
          "start": 60.311,
          "end": 65.21,
          "en": ".auth because I picked auth as an identifier here.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 65.21,
          "end": 67.19,
          "en": "And then in my authSlice,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 67.19,
          "end": 69.803,
          "en": "I have this isAuthenticated property.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 70.86,
          "end": 75.263,
          "en": "So it's, state.auth.isAuthenticated.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 76.58,
          "end": 80.66,
          "en": "And that gives me the isAuth value.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 80.66,
          "end": 83.87,
          "en": "Of course, this constant can be named however you want.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 83.87,
          "end": 86.83,
          "en": "And we can use this to check if we're not",
          "zh": ""
        },
        {
          "id": 28,
          "start": 86.83,
          "end": 88.33,
          "en": "hence the exclamation mark.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 88.33,
          "end": 91.99,
          "en": "If we're not authenticated",
          "zh": ""
        },
        {
          "id": 30,
          "start": 91.99,
          "end": 95.064,
          "en": "then I wanna show the Auth component.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 95.064,
          "end": 96.25,
          "en": "Else,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 96.25,
          "end": 97.99199999999999,
          "en": "if isAuth is truthy",
          "zh": ""
        },
        {
          "id": 33,
          "start": 97.99199999999999,
          "end": 100.18299999999999,
          "en": "I wanna render UserProfile.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 103.00999999999999,
          "end": 105.31,
          "en": "And if everything works, if we save",
          "zh": ""
        },
        {
          "id": 35,
          "start": 105.31,
          "end": 107.993,
          "en": "we should still see that Auth form.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 109.03999999999999,
          "end": 112.03999999999999,
          "en": "Now we also got some conditional content to render here",
          "zh": ""
        },
        {
          "id": 37,
          "start": 112.03999999999999,
          "end": 113.61,
          "en": "in the header and therefore",
          "zh": ""
        },
        {
          "id": 38,
          "start": 113.61,
          "end": 115.92,
          "en": "we can go into the Header JS file",
          "zh": ""
        },
        {
          "id": 39,
          "start": 115.92,
          "end": 117.99000000000001,
          "en": "and do the same thing here.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 117.99000000000001,
          "end": 120.76,
          "en": "We import useSelector",
          "zh": ""
        },
        {
          "id": 41,
          "start": 120.76,
          "end": 122.68,
          "en": "from React-Redux",
          "zh": ""
        },
        {
          "id": 42,
          "start": 123.6,
          "end": 124.71,
          "en": "and then here",
          "zh": ""
        },
        {
          "id": 43,
          "start": 126.54,
          "end": 129.73,
          "en": "we create our isAuth property",
          "zh": ""
        },
        {
          "id": 44,
          "start": 129.73,
          "end": 131.2,
          "en": "or constant I mean,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 131.2,
          "end": 135.33,
          "en": "call useSelector and use the same selector logic",
          "zh": ""
        },
        {
          "id": 46,
          "start": 135.33,
          "end": 138.237,
          "en": "or diving into state.auth.isAuthenticated.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 142.42000000000002,
          "end": 145.73,
          "en": "And now we can use isAuth to conditionally render",
          "zh": ""
        },
        {
          "id": 48,
          "start": 145.73,
          "end": 148.94,
          "en": "or not render those list items.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 148.94,
          "end": 150.23,
          "en": "And since in this case",
          "zh": ""
        },
        {
          "id": 50,
          "start": 150.23,
          "end": 153.41,
          "en": "actually the entire navigation is only relevant.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 153.41,
          "end": 155.94,
          "en": "If we are authenticated, we can also just",
          "zh": ""
        },
        {
          "id": 52,
          "start": 155.94,
          "end": 159.051,
          "en": "render the entire nav item conditionally.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 159.051,
          "end": 161.746,
          "en": "If isAuth is truthy",
          "zh": ""
        },
        {
          "id": 54,
          "start": 161.746,
          "end": 162.829,
          "en": "then",
          "zh": ""
        },
        {
          "id": 55,
          "start": 162.829,
          "end": 164,
          "en": "I want to",
          "zh": ""
        },
        {
          "id": 56,
          "start": 164,
          "end": 164.833,
          "en": "render",
          "zh": ""
        },
        {
          "id": 57,
          "start": 164.833,
          "end": 166.49,
          "en": "this nav",
          "zh": ""
        },
        {
          "id": 58,
          "start": 166.49,
          "end": 167.323,
          "en": "like this.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 168.54,
          "end": 172.6,
          "en": "If we now save that and reload,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 172.6,
          "end": 174.04,
          "en": "we don't see anything here",
          "zh": ""
        },
        {
          "id": 61,
          "start": 174.04,
          "end": 176.993,
          "en": "because initially we are not authenticated.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 178.22,
          "end": 180.257,
          "en": "Now I wanna the Login action",
          "zh": ""
        },
        {
          "id": 63,
          "start": 180.257,
          "end": 182.83,
          "en": "if the Login button is clicked",
          "zh": ""
        },
        {
          "id": 64,
          "start": 182.83,
          "end": 186.35,
          "en": "I actually won't even bother to read the user input.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 186.35,
          "end": 188.47,
          "en": "I will not validate it.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 188.47,
          "end": 192.281,
          "en": "You can do all of that, but that's not related to Redux.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 192.281,
          "end": 195.6,
          "en": "So I will just care about the form submission",
          "zh": ""
        },
        {
          "id": 68,
          "start": 195.6,
          "end": 197.173,
          "en": "with the Login button,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 198.55,
          "end": 200.72,
          "en": "hence here at the Auth component",
          "zh": ""
        },
        {
          "id": 70,
          "start": 200.72,
          "end": 205.17000000000002,
          "en": "we wanna add onSubmit listener on the form here",
          "zh": ""
        },
        {
          "id": 71,
          "start": 205.17000000000002,
          "end": 209.01,
          "en": "and then add a new function in the Auth component,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 209.01,
          "end": 210.19,
          "en": "the submit,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 210.19,
          "end": 211.14,
          "en": "or the loginHandler",
          "zh": ""
        },
        {
          "id": 74,
          "start": 214.52,
          "end": 216.57999999999998,
          "en": "where we get to the default event",
          "zh": ""
        },
        {
          "id": 75,
          "start": 216.57999999999998,
          "end": 220.1,
          "en": "which we still should use to prevent the default",
          "zh": ""
        },
        {
          "id": 76,
          "start": 220.1,
          "end": 223.26,
          "en": "to make sure React doesn't send a HTTP request",
          "zh": ""
        },
        {
          "id": 77,
          "start": 223.26,
          "end": 227.16,
          "en": "or the browser sends a HTTP request to be precise.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 227.16,
          "end": 230.36,
          "en": "You'll learn about that in the forms section.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 230.36,
          "end": 232.61,
          "en": "And then with that wired up",
          "zh": ""
        },
        {
          "id": 80,
          "start": 232.61,
          "end": 236.51,
          "en": "in that loginHandler, after preventing the default",
          "zh": ""
        },
        {
          "id": 81,
          "start": 236.51,
          "end": 237.7,
          "en": "I wanna dispatch",
          "zh": ""
        },
        {
          "id": 82,
          "start": 237.7,
          "end": 240.053,
          "en": "that Login action.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 241.09,
          "end": 243.757,
          "en": "Now for this we wanna use the auth actions",
          "zh": ""
        },
        {
          "id": 84,
          "start": 243.757,
          "end": 245.66,
          "en": "which were exporting",
          "zh": ""
        },
        {
          "id": 85,
          "start": 245.66,
          "end": 248.1,
          "en": "and use this patch.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 248.1,
          "end": 250.41,
          "en": "So in the Auth JS file",
          "zh": ""
        },
        {
          "id": 87,
          "start": 250.41,
          "end": 251.869,
          "en": "we import",
          "zh": ""
        },
        {
          "id": 88,
          "start": 251.869,
          "end": 253.978,
          "en": "useDispatch,",
          "zh": ""
        },
        {
          "id": 89,
          "start": 253.978,
          "end": 256.47,
          "en": "from React-Redux.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 256.47,
          "end": 259.42,
          "en": "And in addition, I also wanna import",
          "zh": ""
        },
        {
          "id": 91,
          "start": 259.42,
          "end": 262,
          "en": "from going up one level,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 262,
          "end": 263.819,
          "en": "store index.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 263.819,
          "end": 268.623,
          "en": "And from there, I wanna import the auth actions.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 269.86,
          "end": 272.98199999999997,
          "en": "And then here in the auth component, we execute",
          "zh": ""
        },
        {
          "id": 95,
          "start": 272.98199999999997,
          "end": 277.343,
          "en": "useDispatch to get access to that dispatch function.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 278.34000000000003,
          "end": 279.7,
          "en": "And in the loginHandler",
          "zh": ""
        },
        {
          "id": 97,
          "start": 279.7,
          "end": 282.86,
          "en": "we then use the Dispatch function to dispatch",
          "zh": ""
        },
        {
          "id": 98,
          "start": 282.86,
          "end": 285.81,
          "en": "authActions.login",
          "zh": ""
        },
        {
          "id": 99,
          "start": 287.21,
          "end": 290.6,
          "en": "we execute login because you learned that this is a",
          "zh": ""
        },
        {
          "id": 100,
          "start": 290.6,
          "end": 295.08,
          "en": "action creator returning the actual action object",
          "zh": ""
        },
        {
          "id": 101,
          "start": 295.08,
          "end": 296.723,
          "en": "which should be dispatched.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 298.28,
          "end": 300.169,
          "en": "If we do that and save everything.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 300.169,
          "end": 303.52,
          "en": "If we reload and click on Login",
          "zh": ""
        },
        {
          "id": 104,
          "start": 303.52,
          "end": 305.64,
          "en": "we switched to the login state",
          "zh": ""
        },
        {
          "id": 105,
          "start": 305.64,
          "end": 308.47,
          "en": "as we can tell by the changes on the UI,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 308.47,
          "end": 309.593,
          "en": "so that works.",
          "zh": ""
        },
        {
          "id": 107,
          "start": 310.75,
          "end": 311.89,
          "en": "Last but not least,",
          "zh": ""
        },
        {
          "id": 108,
          "start": 311.89,
          "end": 314.96,
          "en": "let's wire up the Logout button here,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 314.96,
          "end": 318.862,
          "en": "and a for this in the header where we got the logout button",
          "zh": ""
        },
        {
          "id": 110,
          "start": 318.862,
          "end": 322.06,
          "en": "I'll add onClick listener on that button",
          "zh": ""
        },
        {
          "id": 111,
          "start": 323.1,
          "end": 326.6,
          "en": "and then add a function here to the Header component",
          "zh": ""
        },
        {
          "id": 112,
          "start": 326.6,
          "end": 331.6,
          "en": "the logoutHandler, where I wanna dispatch my action.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 332.01,
          "end": 334.09000000000003,
          "en": "So again, just as before",
          "zh": ""
        },
        {
          "id": 114,
          "start": 334.09000000000003,
          "end": 338.14,
          "en": "for this import useDispatch and we import our",
          "zh": ""
        },
        {
          "id": 115,
          "start": 338.14,
          "end": 341.68,
          "en": "authActions from",
          "zh": ""
        },
        {
          "id": 116,
          "start": 341.68,
          "end": 343.633,
          "en": "store index,",
          "zh": ""
        },
        {
          "id": 117,
          "start": 345.24,
          "end": 346.4,
          "en": "we then call",
          "zh": ""
        },
        {
          "id": 118,
          "start": 346.4,
          "end": 350.04,
          "en": "useDispatch in the component function to get access",
          "zh": ""
        },
        {
          "id": 119,
          "start": 350.04,
          "end": 352.93,
          "en": "to that dispatch function.",
          "zh": ""
        },
        {
          "id": 120,
          "start": 352.93,
          "end": 355.73,
          "en": "And then the loginHandler, we then dispatch",
          "zh": ""
        },
        {
          "id": 121,
          "start": 355.73,
          "end": 357.155,
          "en": "we call dispatch",
          "zh": ""
        },
        {
          "id": 122,
          "start": 357.155,
          "end": 358.113,
          "en": "and",
          "zh": ""
        },
        {
          "id": 123,
          "start": 358.113,
          "end": 358.97,
          "en": "to it,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 358.97,
          "end": 361.173,
          "en": "we pass authActions.logout",
          "zh": ""
        },
        {
          "id": 125,
          "start": 362.776,
          "end": 364.796,
          "en": "execute it as a method again",
          "zh": ""
        },
        {
          "id": 126,
          "start": 364.796,
          "end": 369.637,
          "en": "because that then creates that logout action object.",
          "zh": ""
        },
        {
          "id": 127,
          "start": 369.637,
          "end": 371.581,
          "en": "Now we need to wire up the logoutHandler",
          "zh": ""
        },
        {
          "id": 128,
          "start": 371.581,
          "end": 372.414,
          "en": "to onClick",
          "zh": ""
        },
        {
          "id": 129,
          "start": 374.501,
          "end": 377.29200000000003,
          "en": "and we should be good to go.",
          "zh": ""
        },
        {
          "id": 130,
          "start": 377.29200000000003,
          "end": 380.302,
          "en": "If I now click on Logout, I'm locked out.",
          "zh": ""
        },
        {
          "id": 131,
          "start": 380.302,
          "end": 383.09,
          "en": "If I click on Login, I'm logged back in.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 383.09,
          "end": 386.12,
          "en": "So that is working and that is how we can work",
          "zh": ""
        },
        {
          "id": 133,
          "start": 386.12,
          "end": 388.86,
          "en": "with multiple, totally different pieces",
          "zh": ""
        },
        {
          "id": 134,
          "start": 388.86,
          "end": 391.673,
          "en": "of data in one and the same application.",
          "zh": ""
        },
        {
          "id": 135,
          "start": 391.673,
          "end": 393.501,
          "en": "And that is something you will need",
          "zh": ""
        },
        {
          "id": 136,
          "start": 393.501,
          "end": 398.15999999999997,
          "en": "in almost any React application you're going to build.",
          "zh": ""
        },
        {
          "id": 137,
          "start": 398.15999999999997,
          "end": 401.42,
          "en": "You will always just have one Redux store",
          "zh": ""
        },
        {
          "id": 138,
          "start": 401.42,
          "end": 405.74,
          "en": "but then typically multiple different state slices",
