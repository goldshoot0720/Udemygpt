          "zh": ""
        },
        {
          "id": 17,
          "start": 36.55,
          "end": 38.316,
          "en": "We got our error modal here,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 38.316,
          "end": 40.79,
          "en": "which got some props,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 40.79,
          "end": 43.763,
          "en": "and we export this like that.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 44.99,
          "end": 47.1,
          "en": "Now that's the first step.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 47.1,
          "end": 48.78,
          "en": "Now the second step,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 48.78,
          "end": 49.83,
          "en": "is of course to fill",
          "zh": ""
        },
        {
          "id": 23,
          "start": 49.83,
          "end": 51.02,
          "en": "that with some life.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 51.02,
          "end": 53.35,
          "en": "And generally, it's totally up to you,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 53.35,
          "end": 55.77,
          "en": "how you wanna structure your modal.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 55.77,
          "end": 56.72,
          "en": "I actually want",
          "zh": ""
        },
        {
          "id": 27,
          "start": 56.72,
          "end": 58.58,
          "en": "to reuse that card,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 58.58,
          "end": 60.653,
          "en": "so import card from,",
          "zh": ""
        },
        {
