{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "39471884",
      "title": "Animating Element Disappearances / Removal",
      "sourceHash": "e0f34e83fc35dd98905ffda4232c8dd59706e8963256502b7db89967e1a7e075",
      "cues": [
        {
          "id": 1,
          "start": 0.51,
          "end": 2.58,
          "en": "To animate the disappearance",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.58,
          "end": 4.17,
          "en": "of an element in the DOM,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 4.17,
          "end": 8.91,
          "en": "we can add another useful prop to these motion components.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.91,
          "end": 10.86,
          "en": "And that's the exit prop",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.86,
          "end": 14.94,
          "en": "which also takes such a configuration object here.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.94,
          "end": 17.46,
          "en": "And you can probably see a pattern here.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.46,
          "end": 20.34,
          "en": "We have the initial prop for the starting state",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.34,
          "end": 23.19,
          "en": "when the element appears in the DOM.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 23.19,
          "end": 25.65,
          "en": "Then animate to define the state",
          "zh": ""
        },
        {
          "id": 10,
          "start": 25.65,
          "end": 29.79,
          "en": "we want to animate to right after it did appear.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.79,
          "end": 33.96,
          "en": "And then exit, which allows us to define the state",
          "zh": ""
        },
        {
          "id": 12,
          "start": 33.96,
          "end": 35.52,
          "en": "that we want to animate to",
          "zh": ""
        },
        {
          "id": 13,
          "start": 35.52,
          "end": 38.193,
          "en": "when the element is removed from the DOM.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 39.21,
          "end": 42.42,
          "en": "And here I'll just copy and paste the initial state",
          "zh": ""
        },
        {
          "id": 15,
          "start": 42.42,
          "end": 43.65,
          "en": "as my exit state",
          "zh": ""
        },
        {
          "id": 16,
          "start": 43.65,
          "end": 46.38,
          "en": "but of course you could configure this however you want",
          "zh": ""
        },
        {
          "id": 17,
          "start": 46.38,
          "end": 49.26,
          "en": "and Framer Motion would automatically figure out",
          "zh": ""
        },
        {
          "id": 18,
          "start": 49.26,
          "end": 51.603,
          "en": "how to get from here to here.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 53.31,
          "end": 55.2,
          "en": "But with that, if you save that,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 55.2,
          "end": 57.75,
          "en": "you'll notice something strange.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 57.75,
          "end": 60.69,
          "en": "If I opened this modal and then close it,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 60.69,
          "end": 63.153,
          "en": "for example, by clicking on the backdrop,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 63.99,
          "end": 65.82,
          "en": "no animation is played.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 65.82,
          "end": 68.463,
          "en": "It still disappears instantly.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 69.48,
          "end": 72.21000000000001,
          "en": "And the reason for that is that",
          "zh": ""
        },
        {
          "id": 26,
          "start": 72.21000000000001,
          "end": 74.94,
          "en": "just by using this motion component here,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 74.94,
          "end": 79.32,
          "en": "you are not changing how React handles elements.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 79.32,
          "end": 82.23,
          "en": "And React handles elements such that",
          "zh": ""
        },
        {
          "id": 29,
          "start": 82.23,
          "end": 85.59,
          "en": "if they're not returned by a component function anymore;",
          "zh": ""
        },
        {
          "id": 30,
          "start": 85.59,
          "end": 86.94,
          "en": "so the hetero component here,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 86.94,
          "end": 89.46000000000001,
          "en": "if new challenge which includes that modal",
          "zh": ""
        },
        {
          "id": 32,
          "start": 89.46000000000001,
          "end": 93.03,
          "en": "is not part of that returned value anymore",
          "zh": ""
        },
        {
          "id": 33,
          "start": 93.03,
          "end": 96.66,
          "en": "because IsCreatingNewChallenge turned false,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 96.66,
          "end": 100.89,
          "en": "if that's the case, it's instantly removed from the DOM.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 100.89,
          "end": 104.55,
          "en": "And React doesn't ask whether you wanna do that or not.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 104.55,
          "end": 108.243,
          "en": "It does just do that. It does instantly remove it.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 109.2,
          "end": 114,
          "en": "But Framer Motion gives you a way of working around that.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 114,
          "end": 116.31,
          "en": "It gives you a special component",
          "zh": ""
        },
        {
          "id": 39,
          "start": 116.31,
          "end": 119.49000000000001,
          "en": "that you can wrap around code like this",
          "zh": ""
        },
        {
          "id": 40,
          "start": 119.49000000000001,
          "end": 123.333,
          "en": "to disable or control this functionality.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 124.59,
          "end": 127.14,
          "en": "For that Here in the Header.jsx file,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 127.14,
          "end": 131.73,
          "en": "you must import something from Framer Motion",
          "zh": ""
        },
        {
          "id": 43,
          "start": 131.73,
          "end": 134.25,
          "en": "and that something is not motion",
          "zh": ""
        },
        {
          "id": 44,
          "start": 134.25,
          "end": 138.42000000000002,
          "en": "but instead a component provided by a Framer Motion",
          "zh": ""
        },
        {
          "id": 45,
          "start": 138.42000000000002,
          "end": 140.733,
          "en": "that's called animate presence.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 142.74,
          "end": 146.4,
          "en": "This component is meant to be used as a wrapper",
          "zh": ""
        },
        {
          "id": 47,
          "start": 146.4,
          "end": 151.4,
          "en": "around code that conditionally displays or removes elements",
          "zh": ""
        },
        {
          "id": 48,
          "start": 152.04,
          "end": 154.74,
          "en": "if you want to animate those elements,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 154.74,
          "end": 155.76,
          "en": "to be precise,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 155.76,
          "end": 159.273,
          "en": "if you want to animate the disappearance of those elements.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 160.5,
          "end": 165.21,
          "en": "So for that, we can use animate presence as a wrapper here.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 165.21,
          "end": 169.23,
          "en": "And just by doing that, Framer Motion will make sure",
          "zh": ""
        },
        {
          "id": 53,
          "start": 169.23,
          "end": 171.78,
          "en": "that if this code here executes",
          "zh": ""
        },
        {
          "id": 54,
          "start": 171.78,
          "end": 174.993,
          "en": "the elements that are rendered by that code,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 175.92000000000002,
          "end": 179.82,
          "en": "so also that modal are not removed instantly,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 179.82,
          "end": 182.64,
          "en": "but instead it will check if there's some element",
          "zh": ""
        },
        {
          "id": 57,
          "start": 182.64,
          "end": 184.59,
          "en": "that has an exit animation.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 184.59,
          "end": 186.6,
          "en": "And if it finds such an element,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 186.6,
          "end": 189.9,
          "en": "it will play that exit animation first",
          "zh": ""
        },
        {
          "id": 60,
          "start": 189.9,
          "end": 192.963,
          "en": "before removing this and all the other elements.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 194.07,
          "end": 195.69,
          "en": "And therefore, if you save that,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 195.69,
          "end": 199.41,
          "en": "you'll now see that opening plays this animation",
          "zh": ""
        },
        {
          "id": 63,
          "start": 199.41,
          "end": 201.06,
          "en": "but so does closing.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 201.06,
          "end": 202.44,
          "en": "If I click this backdrop,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 202.44,
          "end": 206.79,
          "en": "now we got this nice closing animation, this exit animation",
          "zh": ""
        },
        {
          "id": 66,
          "start": 206.79,
          "end": 210.213,
          "en": "where this modal is pushed down and fades out.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 211.05,
          "end": 213.18,
          "en": "And this now is the case",
          "zh": ""
        },
        {
          "id": 68,
          "start": 213.18,
          "end": 216.39,
          "en": "because of this animate presence component",
          "zh": ""
        },
        {
          "id": 69,
          "start": 216.39,
          "end": 219.15,
          "en": "that's used as a wrapper around the code",
          "zh": ""
        },
        {
          "id": 70,
          "start": 219.15,
          "end": 222.72,
          "en": "that ultimately is responsible for rendering this modal",
          "zh": ""
        },
        {
          "id": 71,
          "start": 222.72,
          "end": 226.82999999999998,
          "en": "where we have this motion component that has this exit prop.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 226.82999999999998,
          "end": 229.503,
          "en": "That's how those things are working together.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}