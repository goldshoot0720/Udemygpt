{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "38345170",
      "title": "Adding JavaScript To A Page & How React Projects Differ",
      "sourceHash": "3f8c3e03b6b6f888afc9117949fa0df4f52f79d4965b60f0512eb1cf3fe6a0f9",
      "cues": [
        {
          "id": 1,
          "start": 2.07,
          "end": 2.94,
          "en": "So let's start",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.94,
          "end": 6.84,
          "en": "by revisiting certain crucial core concepts",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.84,
          "end": 10.05,
          "en": "and things you should know about JavaScript,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.05,
          "end": 13.08,
          "en": "for example, that JavaScript can be executed",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.08,
          "end": 15.06,
          "en": "in many different environments.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.06,
          "end": 17.37,
          "en": "For example, of course, the browser,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.37,
          "end": 19.77,
          "en": "that's where JavaScript originated.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 19.77,
          "end": 22.38,
          "en": "In the end, that's what it was built for",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.38,
          "end": 24,
          "en": "back in the nineties.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 24,
          "end": 27.63,
          "en": "But nowadays, thanks to NodeJS and Deno,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 27.63,
          "end": 31.02,
          "en": "for example, you can also execute JavaScript code",
          "zh": ""
        },
        {
          "id": 12,
          "start": 31.02,
          "end": 32.85,
          "en": "outside of the browser.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 32.85,
          "end": 35.37,
          "en": "This will not be the focus of this course",
          "zh": ""
        },
        {
          "id": 14,
          "start": 35.37,
          "end": 37.32,
          "en": "because this is a React course",
          "zh": ""
        },
        {
          "id": 15,
          "start": 37.32,
          "end": 39.96,
          "en": "and React is a client-side, front-end,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 39.96,
          "end": 42.84,
          "en": "browser-based library in its core",
          "zh": ""
        },
        {
          "id": 17,
          "start": 42.84,
          "end": 45.93,
          "en": "that allows you to build user interfaces",
          "zh": ""
        },
        {
          "id": 18,
          "start": 45.93,
          "end": 48.15,
          "en": "with React and JavaScript.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 48.15,
          "end": 49.89,
          "en": "But it is of course worth knowing",
          "zh": ""
        },
        {
          "id": 20,
          "start": 49.89,
          "end": 53.58,
          "en": "that JavaScript is not limited to the browser.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 53.58,
          "end": 57.09,
          "en": "You can even build mobile apps with JavaScript,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 57.09,
          "end": 59.07,
          "en": "thanks to extra technologies",
          "zh": ""
        },
        {
          "id": 23,
          "start": 59.07,
          "end": 61.74,
          "en": "like Capacitor or React Native,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 61.74,
          "end": 62.85,
          "en": "which by the way,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 62.85,
          "end": 64.56,
          "en": "would be a great next step",
          "zh": ""
        },
        {
          "id": 26,
          "start": 64.56,
          "end": 66.66,
          "en": "after finishing this course.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 66.66,
          "end": 68.67,
          "en": "You can also use React",
          "zh": ""
        },
        {
          "id": 28,
          "start": 68.67,
          "end": 71.1,
          "en": "in conjunction with another tool",
          "zh": ""
        },
        {
          "id": 29,
          "start": 71.1,
          "end": 73.26,
          "en": "or another library you could say,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 73.26,
          "end": 74.88,
          "en": "called React Native,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 74.88,
          "end": 77.07,
          "en": "to build native mobile apps",
          "zh": ""
        },
        {
          "id": 32,
          "start": 77.07,
          "end": 79.26,
          "en": "for Android and iOS.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 79.26,
          "end": 80.1,
          "en": "And I do have",
          "zh": ""
        },
        {
          "id": 34,
          "start": 80.1,
          "end": 82.41,
          "en": "a dedicated course on React Native",
          "zh": ""
        },
        {
          "id": 35,
          "start": 82.41,
          "end": 83.94,
          "en": "if you wanna learn more about that",
          "zh": ""
        },
        {
          "id": 36,
          "start": 83.94,
          "end": 85.8,
          "en": "after finishing this course.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 85.8,
          "end": 89.64,
          "en": "So JavaScript is really versatile, really powerful.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 89.64,
          "end": 91.74,
          "en": "But in this refresher section,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 91.74,
          "end": 93,
          "en": "we are going to focus",
          "zh": ""
        },
        {
          "id": 40,
          "start": 93,
          "end": 95.1,
          "en": "on JavaScript in the browser,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 95.1,
          "end": 96.87,
          "en": "though the general syntax",
          "zh": ""
        },
        {
          "id": 42,
          "start": 96.87,
          "end": 98.16,
          "en": "and rules of course,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 98.16,
          "end": 99.75,
          "en": "are always the same,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 99.75,
          "end": 101.75999999999999,
          "en": "no matter for which environment",
          "zh": ""
        },
        {
          "id": 45,
          "start": 101.75999999999999,
          "end": 104.31,
          "en": "you are writing your JavaScript code.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 104.31,
          "end": 107.43,
          "en": "So since we focus on JavaScript in the browser,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 107.43,
          "end": 109.11,
          "en": "let's explore how JavaScript code",
          "zh": ""
        },
        {
          "id": 48,
          "start": 109.11,
          "end": 111.27000000000001,
          "en": "can be added to a website.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 111.27000000000001,
          "end": 114.36,
          "en": "And here you have two main options",
          "zh": ""
        },
        {
          "id": 50,
          "start": 114.36,
          "end": 117.84,
          "en": "and they both include the special script tag,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 117.84,
          "end": 119.43,
          "en": "the special script element,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 119.43,
          "end": 122.4,
          "en": "which you can add to your HTML code.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 122.4,
          "end": 124.56,
          "en": "You can either put your JavaScript code",
          "zh": ""
        },
        {
          "id": 54,
          "start": 124.56,
          "end": 126.54,
          "en": "between such script tags,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 126.54,
          "end": 128.91,
          "en": "or you can use those script tags",
          "zh": ""
        },
        {
          "id": 56,
          "start": 128.91,
          "end": 131.37,
          "en": "to import JavaScript files,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 131.37,
          "end": 134.37,
          "en": "which then contain your JavaScript code.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 134.37,
          "end": 135.203,
          "en": "Now typically,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 135.203,
          "end": 137.91,
          "en": "we don't use that inline approach",
          "zh": ""
        },
        {
          "id": 60,
          "start": 137.91,
          "end": 139.02,
          "en": "on the left here,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 139.02,
          "end": 142.17000000000002,
          "en": "where the code is between those script tags,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 142.17000000000002,
          "end": 143.55,
          "en": "because this approach",
          "zh": ""
        },
        {
          "id": 63,
          "start": 143.55,
          "end": 145.68,
          "en": "can quickly lead to unmaintainable",
          "zh": ""
        },
        {
          "id": 64,
          "start": 145.68,
          "end": 147.9,
          "en": "and complex HTML files,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 147.9,
          "end": 149.28,
          "en": "and is therefore typically",
          "zh": ""
        },
        {
          "id": 66,
          "start": 149.28,
          "end": 152.64,
          "en": "only used for very short scripts.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 152.64,
          "end": 153.72,
          "en": "Instead, typically,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 153.72,
          "end": 155.37,
          "en": "you have your JavaScript code",
          "zh": ""
        },
        {
          "id": 69,
          "start": 155.37,
          "end": 157.98,
          "en": "in dedicated JavaScript files",
          "zh": ""
        },
        {
          "id": 70,
          "start": 157.98,
          "end": 160.95,
          "en": "because such projects that use this approach",
          "zh": ""
        },
        {
          "id": 71,
          "start": 160.95,
          "end": 163.8,
          "en": "are way easier to maintain.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 163.8,
          "end": 165.96,
          "en": "Therefore, here in this demo project",
          "zh": ""
        },
        {
          "id": 73,
          "start": 165.96,
          "end": 167.13,
          "en": "which I prepared,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 167.13,
          "end": 169.41,
          "en": "we could start in this assets folder",
          "zh": ""
        },
        {
          "id": 75,
          "start": 169.41,
          "end": 171.96,
          "en": "by adding a new sub-folder",
          "zh": ""
        },
        {
          "id": 76,
          "start": 171.96,
          "end": 173.52,
          "en": "that could be called scripts,",
          "zh": ""
        },
        {
          "id": 77,
          "start": 173.52,
          "end": 175.92000000000002,
          "en": "though the name of course doesn't matter.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 175.92000000000002,
          "end": 176.753,
          "en": "And in there,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 176.753,
          "end": 178.86,
          "en": "we can create a JavaScript code file",
          "zh": ""
        },
        {
          "id": 80,
          "start": 178.86,
          "end": 182.4,
          "en": "that could be named app.js.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 182.4,
          "end": 184.86,
          "en": "Though this name also is totally up to you,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 184.86,
          "end": 187.44,
          "en": "it just should end with .js,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 187.44,
          "end": 189.57,
          "en": "so instead of course tells the browser",
          "zh": ""
        },
        {
          "id": 84,
          "start": 189.57,
          "end": 191.34,
          "en": "and also the Code Editor",
          "zh": ""
        },
        {
          "id": 85,
          "start": 191.34,
          "end": 194.253,
          "en": "that this file will contain JavaScript code.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 195.21,
          "end": 197.07,
          "en": "And the Code Editor can therefore,",
          "zh": ""
        },
        {
          "id": 87,
          "start": 197.07,
          "end": 199.35,
          "en": "for example, make sure that the code",
          "zh": ""
        },
        {
          "id": 88,
          "start": 199.35,
          "end": 202.17000000000002,
          "en": "is properly highlighted and formatted.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 202.17000000000002,
          "end": 204.3,
          "en": "Well, and with such a file added here,",
          "zh": ""
        },
        {
          "id": 90,
          "start": 204.3,
          "end": 207.96,
          "en": "you can then import it in the HTML file",
          "zh": ""
        },
        {
          "id": 91,
          "start": 207.96,
          "end": 209.52,
          "en": "by going there",
          "zh": ""
        },
        {
          "id": 92,
          "start": 209.52,
          "end": 212.1,
          "en": "and adding your script tags,",
          "zh": ""
        },
        {
          "id": 93,
          "start": 212.1,
          "end": 214.68,
          "en": "opening and closing script tags.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 214.68,
          "end": 216.96,
          "en": "And you always need both.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 216.96,
          "end": 219.84,
          "en": "You can't use a self-closing script tag",
          "zh": ""
        },
        {
          "id": 96,
          "start": 219.84,
          "end": 221.07,
          "en": "or anything like this.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 221.07,
          "end": 222.54,
          "en": "Instead, you need opening",
          "zh": ""
        },
        {
          "id": 98,
          "start": 222.54,
          "end": 224.1,
          "en": "and closing script tags.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 224.1,
          "end": 225.723,
          "en": "That's a must have.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 226.62,
          "end": 227.73,
          "en": "Now you can add them",
          "zh": ""
        },
        {
          "id": 101,
          "start": 227.73,
          "end": 229.95,
          "en": "anywhere you want in that file.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 229.95,
          "end": 231.51,
          "en": "In the head section,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 231.51,
          "end": 232.98,
          "en": "in the body section,",
          "zh": ""
        },
        {
          "id": 104,
          "start": 232.98,
          "end": 235.47,
          "en": "really, anywhere you want.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 235.47,
          "end": 238.17000000000002,
          "en": "And then you would add the source attribute,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 238.17000000000002,
          "end": 239.97,
          "en": "the src attribute",
          "zh": ""
        },
        {
          "id": 107,
          "start": 239.97,
          "end": 241.71,
          "en": "to point at the file.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 241.71,
          "end": 243.87,
          "en": "In my case, in the assets folder.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 243.87,
          "end": 245.58,
          "en": "And there in the scripts folder",
          "zh": ""
        },
        {
          "id": 110,
          "start": 245.58,
          "end": 247.263,
          "en": "that should be imported.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 248.43,
          "end": 250.23,
          "en": "And now that file would be loaded",
          "zh": ""
        },
        {
          "id": 112,
          "start": 250.23,
          "end": 251.67,
          "en": "as part of this webpage",
          "zh": ""
        },
        {
          "id": 113,
          "start": 251.67,
          "end": 253.89,
          "en": "when the webpage is loaded.",
          "zh": ""
        },
        {
          "id": 114,
          "start": 253.89,
          "end": 255.3,
          "en": "Now it is worth noting that",
          "zh": ""
        },
        {
          "id": 115,
          "start": 255.3,
          "end": 258.03,
          "en": "you can then add extra attributes",
          "zh": ""
        },
        {
          "id": 116,
          "start": 258.03,
          "end": 259.23,
          "en": "to the script tag.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 259.23,
          "end": 261.18,
          "en": "For example, the defer attribute,",
          "zh": ""
        },
        {
          "id": 118,
          "start": 261.18,
          "end": 263.37,
          "en": "to make sure that the script",
          "zh": ""
        },
        {
          "id": 119,
          "start": 263.37,
          "end": 265.08,
          "en": "that will be imported,",
          "zh": ""
        },
        {
          "id": 120,
          "start": 265.08,
          "end": 267.023,
          "en": "will only be executed",
          "zh": ""
        },
        {
          "id": 121,
          "start": 267.023,
          "end": 269.52,
          "en": "after the rest of the HTML document",
          "zh": ""
        },
        {
          "id": 122,
          "start": 269.52,
          "end": 271.92,
          "en": "has been read and parsed.",
          "zh": ""
        },
        {
          "id": 123,
          "start": 271.92,
          "end": 273.36,
          "en": "This ensures that,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 273.36,
          "end": 274.83,
          "en": "if your script code,",
          "zh": ""
        },
        {
          "id": 125,
          "start": 274.83,
          "end": 276.78,
          "en": "for example, needs to work",
          "zh": ""
        },
        {
          "id": 126,
          "start": 276.78,
          "end": 279.27,
          "en": "with some HTML elements,",
          "zh": ""
        },
        {
          "id": 127,
          "start": 279.27,
          "end": 281.85,
          "en": "those HTML elements are available",
          "zh": ""
        },
        {
          "id": 128,
          "start": 281.85,
          "end": 284.90999999999997,
          "en": "when the JavaScript code starts executing.",
          "zh": ""
        },
        {
          "id": 129,
          "start": 284.90999999999997,
          "end": 285.99,
          "en": "Without defer,",
          "zh": ""
        },
        {
          "id": 130,
          "start": 285.99,
          "end": 288.21,
          "en": "it would start executing right away.",
          "zh": ""
        },
        {
          "id": 131,
          "start": 288.21,
          "end": 289.59000000000003,
          "en": "And if you then would try",
          "zh": ""
        },
        {
          "id": 132,
          "start": 289.59000000000003,
          "end": 291.69,
          "en": "to reach out to this unordered list,",
          "zh": ""
        },
        {
          "id": 133,
          "start": 291.69,
          "end": 294.06,
          "en": "for example, this unordered list",
          "zh": ""
        },
        {
          "id": 134,
          "start": 294.06,
          "end": 295.83,
          "en": "might not be available yet",
          "zh": ""
        },
        {
          "id": 135,
          "start": 295.83,
          "end": 297.18,
          "en": "if the script is loaded",
          "zh": ""
        },
        {
          "id": 136,
          "start": 297.18,
          "end": 300,
          "en": "before the list is output here.",
          "zh": ""
        },
        {
          "id": 137,
          "start": 300,
          "end": 302.34,
          "en": "That's why you might want to add defer.",
          "zh": ""
        },
        {
          "id": 138,
          "start": 302.34,
          "end": 304.65,
          "en": "Now in modern JavaScript projects,",
          "zh": ""
        },
        {
          "id": 139,
          "start": 304.65,
          "end": 306.51,
          "en": "it's also quite common",
          "zh": ""
        },
        {
          "id": 140,
          "start": 306.51,
          "end": 308.46,
          "en": "that you have another attribute",
          "zh": ""
        },
        {
          "id": 141,
          "start": 308.46,
