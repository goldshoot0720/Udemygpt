{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "39835980",
      "title": "Vanilla CSS Styles Are NOT Scoped To Components!",
      "sourceHash": "ec7b2375d97b1a05e96e382ca110d677a1b4e6e19be20fffb602e0cb008f6db3",
      "cues": [
        {
          "id": 1,
          "start": 0,
          "end": 2.94,
          "en": "Now, as mentioned in the previous lecture,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.94,
          "end": 6.24,
          "en": "one disadvantage of using Vanilla CSS,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.24,
          "end": 10.59,
          "en": "is that the CSS rules and your CSS code in general,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.59,
          "end": 12.705,
          "en": "is not scoped to the component",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.705,
          "end": 16.053,
          "en": "to which you maybe want it to belong,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.25,
          "end": 20.37,
          "en": "and let me simply show you an example here.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.37,
          "end": 23.04,
          "en": "In that Header.css file,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 23.04,
          "end": 26.31,
          "en": "we got a couple of rules that should affect",
          "zh": ""
        },
        {
          "id": 9,
          "start": 26.31,
          "end": 28.503,
          "en": "the styling of our header here.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 29.4,
          "end": 31.71,
          "en": "For example, also this rule here,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 31.71,
          "end": 35.13,
          "en": "which styles the paragraph that's shown in the header.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 35.13,
          "end": 38.73,
          "en": "Now since we're importing this Header.css file",
          "zh": ""
        },
        {
          "id": 13,
          "start": 38.73,
          "end": 41.43,
          "en": "in the Header.jsx file,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 41.43,
          "end": 45.06,
          "en": "you could think that the rules defined in here",
          "zh": ""
        },
        {
          "id": 15,
          "start": 45.06,
          "end": 49.44,
          "en": "only apply to the JSX code defined in this header component",
          "zh": ""
        },
        {
          "id": 16,
          "start": 49.44,
          "end": 51.42,
          "en": "because it's that component file",
          "zh": ""
        },
        {
          "id": 17,
          "start": 51.42,
          "end": 54.003,
          "en": "where we are importing the CSS file.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 55.11,
          "end": 56.7,
          "en": "But that's not the case.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 56.7,
          "end": 58.2,
          "en": "As I can show you,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 58.2,
          "end": 62.58,
          "en": "by removing this header part in front of the paragraph rule,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 62.58,
          "end": 65.61,
          "en": "so that now I'm just targeting any paragraph",
          "zh": ""
        },
        {
          "id": 22,
          "start": 65.61,
          "end": 67.803,
          "en": "no matter if it's in a header or not.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 68.67,
          "end": 71.1,
          "en": "And if I then temporarily",
          "zh": ""
        },
        {
          "id": 24,
          "start": 71.1,
          "end": 75.18,
          "en": "go to my Authinputs.jsx file here,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 75.18,
          "end": 78.72,
          "en": "and there maybe above my buttons here,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 78.72,
          "end": 81.753,
          "en": "I add a paragraph where I say,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 83.13,
          "end": 85.35300000000001,
          "en": "Some text, just as a demo.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 87.03,
          "end": 89.58,
          "en": "If I do that and I saved it,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 89.58,
          "end": 92.36500000000001,
          "en": "you'll see that this paragraph here,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 92.36500000000001,
          "end": 97.22999999999999,
          "en": "receives exactly the same styling as this paragraph.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 97.22999999999999,
          "end": 99.45,
          "en": "And, of course, I can easily prove that",
          "zh": ""
        },
        {
          "id": 32,
          "start": 99.45,
          "end": 102.27000000000001,
          "en": "by temporarily changing the color",
          "zh": ""
        },
        {
          "id": 33,
          "start": 102.27000000000001,
          "end": 104.85,
          "en": "from this gray color, which I want to have,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 104.85,
          "end": 108.543,
          "en": "to some red color in the Header.css file.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 109.89,
          "end": 113.25,
          "en": "If I do that, you will see that now this,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 113.25,
          "end": 115.71000000000001,
          "en": "and, of course, also this paragraph,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 115.71000000000001,
          "end": 117.87299999999999,
          "en": "both paragraphs are red.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 119.37,
          "end": 124.17,
          "en": "So this bottom paragraph here gets targeted by this rule,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 124.17,
          "end": 126.96,
          "en": "even though that bottom paragraph is defined",
          "zh": ""
        },
        {
          "id": 40,
          "start": 126.96,
          "end": 129.663,
          "en": "in a different component in a different file.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 130.53,
          "end": 133.29,
          "en": "And therefore, it's really important to understand",
          "zh": ""
        },
        {
          "id": 42,
          "start": 133.29,
          "end": 138.24,
          "en": "that even if you do split your CSS code in multiple files,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 138.24,
          "end": 141,
          "en": "and you then do import some of these files",
          "zh": ""
        },
        {
          "id": 44,
          "start": 141,
          "end": 143.19,
          "en": "into certain component files,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 143.19,
          "end": 145.77,
          "en": "the CSS rules in those files",
          "zh": ""
        },
        {
          "id": 46,
          "start": 145.77,
          "end": 149.34,
          "en": "will not be scoped to the components",
          "zh": ""
        },
        {
          "id": 47,
          "start": 149.34,
          "end": 151.92000000000002,
          "en": "to which they belong,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 151.92000000000002,
          "end": 155.76,
          "en": "because they don't really belong to these components.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 155.76,
          "end": 159.03,
          "en": "Instead, if you open the developer tools again,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 159.03,
          "end": 161.55,
          "en": "keep in mind that all these styles",
          "zh": ""
        },
        {
          "id": 51,
          "start": 161.55,
          "end": 163.32,
          "en": "are in the end just injected",
          "zh": ""
        },
        {
          "id": 52,
          "start": 163.32,
          "end": 166.17000000000002,
          "en": "into the head section here by Vite,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 166.17000000000002,
          "end": 169.65,
          "en": "so the header styles and the other styles.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 169.65,
          "end": 171.09,
          "en": "And therefore, of course,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 171.09,
          "end": 174.723,
          "en": "they are applied globally to this page.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 175.65,
          "end": 178.05,
          "en": "And that's not necessarily a problem,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 178.05,
          "end": 180.72,
          "en": "but it is something to keep in mind.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 180.72,
          "end": 184.32,
          "en": "When using this Vanilla CSS approach,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 184.32,
          "end": 186.96,
          "en": "your styles are not scoped,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 186.96,
          "end": 190.23,
          "en": "and therefore here I'll revert this change here,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 190.23,
          "end": 193.353,
          "en": "and set the color back to the color I wanted to have.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 194.31,
          "end": 197.88,
          "en": "And I'll get rid of this paragraph in AuthInputs",
          "zh": ""
        },
        {
          "id": 63,
          "start": 197.88,
          "end": 199.323,
          "en": "which I don't really need,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 200.19,
          "end": 201.78,
          "en": "but you should keep in mind",
          "zh": ""
        },
        {
          "id": 65,
          "start": 201.78,
          "end": 204.12,
          "en": "that this rule, like all these rules,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 204.12,
          "end": 206.76,
          "en": "and all the rules in the index.css file,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 206.76,
          "end": 209.523,
          "en": "will not be scoped to any component.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}