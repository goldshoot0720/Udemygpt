        },
        {
          "id": 11,
          "start": 32.633,
          "end": 32.833,
          "en": "And that already leads to the last part, data.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.833,
          "end": 36.033,
          "en": "We learned how to share data across components",
