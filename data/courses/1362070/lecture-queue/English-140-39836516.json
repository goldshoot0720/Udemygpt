  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "39836516",
      "title": "Splitting Components to Split JSX & Tailwind Styles (for Higher Reusability)",
      "sourceHash": "4b386cd4ff8cdeea3c47e18d425caf19ab568ff33595c596bc0d05df49f768cb",
      "cues": [
        {
          "id": 1,
          "start": 0.96,
          "end": 2.31,
          "en": "So let's now make sure",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.31,
          "end": 5.46,
          "en": "that this content here is not always shown,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.46,
          "end": 8.46,
          "en": "but instead only after we clicked Add Project",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.46,
          "end": 12.3,
          "en": "and that instead we show some fallback content.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.3,
          "end": 16.05,
          "en": "So I'll start by adding the fallback content.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.05,
          "end": 19.797,
          "en": "And for that I'll add a new component, NoProjectSelected.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 23.82,
          "end": 27.69,
          "en": "Sounds like a fitting name because this should be shown",
          "zh": ""
        },
        {
          "id": 8,
          "start": 27.69,
          "end": 31.893,
          "en": "if we're neither adding a project nor have one selected.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 33.63,
          "end": 36.57,
          "en": "And in that file, I'll therefore export a component",
          "zh": ""
        },
        {
          "id": 10,
          "start": 36.57,
          "end": 39.153,
          "en": "function called NoProjectSelected.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 41.19,
          "end": 43.616,
          "en": "And here I'll return a div",
          "zh": ""
        },
        {
          "id": 12,
          "start": 43.616,
          "end": 47.61,
          "en": "which then should display an image,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 47.61,
          "end": 50.64,
          "en": "an image which was part of the starting project.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 50.64,
          "end": 51.843,
          "en": "This image here.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 52.92,
          "end": 57.92,
          "en": "And below that image, a title where I say NoProjectSelected.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 60.03,
          "end": 63.69,
          "en": "And below that title, a paragraph where I say,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 63.69,
          "end": 68.69,
          "en": "select a project or get started with a new one.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 70.32,
          "end": 72.87,
          "en": "And below that I'll add another paragraph",
          "zh": ""
        },
        {
          "id": 19,
          "start": 72.87,
          "end": 76.44,
          "en": "which should then include a button which says,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 76.44,
          "end": 81.03,
          "en": "create new project, which should basically do the same",
          "zh": ""
        },
        {
          "id": 21,
          "start": 81.03,
          "end": 85.863,
          "en": "like this button here, it should display this component.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 88.23,
          "end": 89.43,
          "en": "So that's the markup.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 89.43,
          "end": 91.113,
          "en": "Now for the styling,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 91.95,
          "end": 94.8,
          "en": "I'll add some classes here to that wrapping div.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 94.8,
          "end": 97.9,
          "en": "Most importantly, I'll add some margin to the top",
          "zh": ""
        },
        {
          "id": 26,
          "start": 99,
          "end": 102.363,
          "en": "and make sure that all the text here is centered.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 103.38,
          "end": 105.3,
          "en": "And in addition, I'll give it a width",
          "zh": ""
        },
        {
          "id": 28,
          "start": 105.3,
          "end": 108.843,
          "en": "of 2/3 of the available space.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 110.58,
          "end": 115.17,
          "en": "Then for the image here, I'll import this",
          "zh": ""
        },
        {
          "id": 30,
          "start": 115.17,
          "end": 119.223,
          "en": "no-projects PNG file from the assets folder,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 120.87,
          "end": 124.29,
          "en": "and I'll name it noProjectImage",
          "zh": ""
        },
        {
          "id": 32,
          "start": 124.29,
          "end": 127.83,
          "en": "and import it from going up one level,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 127.83,
          "end": 129.75,
          "en": "diving into the assets folder.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 129.75,
          "end": 134.67,
          "en": "And then there it's this no-projects.png file.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 134.67,
          "end": 136.82999999999998,
          "en": "So then here on this image,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 136.82999999999998,
          "end": 140.553,
          "en": "this imported image should be set as a source.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 142.59,
          "end": 147.48,
          "en": "And the alt text could be an empty task list",
          "zh": ""
        },
        {
          "id": 38,
          "start": 147.48,
          "end": 150.633,
          "en": "because that's in the end what can be seen on this image.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 152.31,
          "end": 155.61,
          "en": "And the H2 element below the image here",
          "zh": ""
        },
        {
          "id": 40,
          "start": 155.61,
          "end": 158.85,
          "en": "should of course also receive some styling",
          "zh": ""
        },
        {
          "id": 41,
          "start": 158.85,
          "end": 161.29,
          "en": "because I wanna make the text slightly bigger",
          "zh": ""
        },
        {
          "id": 42,
          "start": 162.18099999999998,
          "end": 165.573,
          "en": "with the Text XL class and make the font bold.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 166.92000000000002,
          "end": 171.632,
          "en": "Use this text-stone-500 text color class here",
          "zh": ""
        },
        {
          "id": 44,
          "start": 171.632,
          "end": 175.41,
          "en": "and add some margin to the top to have some spacing",
          "zh": ""
        },
        {
          "id": 45,
          "start": 175.41,
          "end": 177.963,
          "en": "between the image and this H2 element.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 179.16,
          "end": 182.43,
          "en": "In addition, I'll also add a margin to the bottom,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 182.43,
          "end": 185.913,
          "en": "and since this is the same margin, we can just use my-4.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 187.56,
          "end": 190.98,
          "en": "Now the image here also needs some classes though.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 190.98,
          "end": 194.58,
          "en": "And here I want to add the w-16 class for some width,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 194.58,
          "end": 196.023,
          "en": "and the same for the height.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 197.25,
          "end": 201.43,
          "en": "Add object contains so that the image does not get distorted",
          "zh": ""
        },
        {
          "id": 52,
          "start": 202.41,
          "end": 205.53300000000002,
          "en": "and mx-auto to make sure that it's centered.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 207.39,
          "end": 210.3,
          "en": "Now this paragraph here, which says,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 210.3,
          "end": 213.93,
          "en": "select a project or get started with a new one,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 213.93,
          "end": 215.73,
          "en": "also needs some styling.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 215.73,
          "end": 216.96,
          "en": "To be precise here,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 216.96,
          "end": 221.763,
          "en": "I wanna change the text color to set it to text-stone-400,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 223.41,
          "end": 225.753,
          "en": "and I want to add some margin to the bottom.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 227.19,
          "end": 230.61,
          "en": "I'll also add some additional margin to the top here",
          "zh": ""
        },
        {
          "id": 60,
          "start": 230.61,
          "end": 233.673,
          "en": "on this paragraph that wraps the button.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 235.05,
          "end": 238.62,
          "en": "And the button then of course also needs some styling.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 238.62,
          "end": 241.32,
          "en": "To be precise here, for this button,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 241.32,
          "end": 244.02,
          "en": "I essentially want to use the same classes",
          "zh": ""
        },
        {
          "id": 64,
          "start": 244.02,
          "end": 248.76,
          "en": "as I have them here in my ProjectsSidebar.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 248.76,
          "end": 252.58,
          "en": "And therefore I'll outsource this into a separate component",
          "zh": ""
        },
        {
          "id": 66,
          "start": 253.47,
          "end": 255.75,
          "en": "so that I don't have to copy and paste",
          "zh": ""
        },
        {
          "id": 67,
          "start": 255.75,
          "end": 258.993,
          "en": "and repeat those Tailwind CSS class names.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 260.07,
          "end": 263.973,
          "en": "So I'll export a component function called Button here,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 265.53,
          "end": 269.16,
          "en": "and return this button markup",
          "zh": ""
        },
        {
          "id": 70,
          "start": 269.16,
          "end": 273.153,
          "en": "from my ProjectsSidebar, this markup.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 274.17,
          "end": 279.17,
          "en": "I'll copy that and return it here in my button component.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 283.02,
          "end": 285.84000000000003,
          "en": "And of course, the content between the button tags",
          "zh": ""
        },
        {
          "id": 73,
          "start": 285.84000000000003,
          "end": 288.15,
          "en": "should be flexible.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 288.15,
          "end": 291,
          "en": "Hence I'll pull out that children prop",
          "zh": ""
        },
        {
          "id": 75,
          "start": 291,
          "end": 293.55,
          "en": "from the incoming props and add that here",
          "zh": ""
        },
        {
          "id": 76,
          "start": 293.55,
          "end": 295.053,
          "en": "between my button tags.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 296.88,
          "end": 301.59,
          "en": "And now with that back in the ProjectsSidebar component,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 301.59,
          "end": 305.7,
          "en": "we can replace this button with our own button",
          "zh": ""
        },
        {
          "id": 79,
          "start": 305.7,
          "end": 308.943,
          "en": "which needs to be imported from the button JSX file.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 310.92,
          "end": 313.953,
          "en": "And we can and should get rid of the class name here now.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 314.94,
          "end": 315.933,
          "en": "Also here.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 317.97,
          "end": 322.97,
          "en": "And then do the same in this NoProjectSelected component.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 324.54,
          "end": 327.15,
          "en": "This button should now also be replaced",
          "zh": ""
        },
        {
          "id": 84,
          "start": 327.15,
          "end": 329.04,
          "en": "with our own custom button,",
          "zh": ""
        },
        {
          "id": 85,
          "start": 329.04,
          "end": 332.43,
          "en": "which is imported from button.jsx.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 332.43,
          "end": 334.173,
          "en": "Also the closing tag.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 335.88,
          "end": 338.403,
          "en": "And therefore we don't need to add classes here.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 340.05,
          "end": 343.53,
          "en": "Now, one thing we should do with this custom button though",
          "zh": ""
        },
        {
          "id": 89,
          "start": 343.53,
          "end": 346.95,
          "en": "is that we should collect all the other props that might be",
          "zh": ""
        },
        {
          "id": 90,
          "start": 346.95,
          "end": 351.087,
          "en": "set on this button component and then spread them",
          "zh": ""
        },
        {
          "id": 91,
          "start": 351.087,
          "end": 355.32,
          "en": "onto this button so that we later can, for example,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 355.32,
          "end": 357.45,
          "en": "also add the unchanged prop.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 357.45,
          "end": 362.45,
          "en": "So this and this should be added to our component here.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 363.99,
          "end": 366.03,
          "en": "Now with that, I wanna see how this",
          "zh": ""
        },
        {
          "id": 95,
          "start": 366.03,
          "end": 369.03,
          "en": "NoProjectSelected component looks like.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 369.03,
          "end": 372.06,
          "en": "And for that we should go back to the app component.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 372.06,
          "end": 375.09,
          "en": "And instead of outputting the new project component here,",
          "zh": ""
        },
        {
          "id": 98,
          "start": 375.09,
          "end": 378.96,
          "en": "we should output the NoProjectSelected component.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 378.96,
          "end": 381.69,
          "en": "And later this should be rendered conditionally.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 381.69,
          "end": 383.94,
          "en": "And we either show this component",
          "zh": ""
        },
        {
          "id": 101,
          "start": 383.94,
          "end": 385.89,
          "en": "or the NewProject component",
          "zh": ""
        },
        {
          "id": 102,
          "start": 385.89,
          "end": 388.653,
          "en": "depending on whether this button here was pressed.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 390.27,
          "end": 393.6,
          "en": "But with that, if we save everything here and go back,",
          "zh": ""
        },
        {
          "id": 104,
          "start": 393.6,
          "end": 396.406,
          "en": "we see this fallback content here",
          "zh": ""
        },
        {
          "id": 105,
          "start": 396.406,
          "end": 400.26,
          "en": "and we got this button here and here.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 400.26,
          "end": 402.18,
          "en": "And now it's time to make sure",
          "zh": ""
        },
        {
          "id": 107,
          "start": 402.18,
          "end": 404.28,
          "en": "that when this button gets pressed,",
          "zh": ""
        },
        {
          "id": 108,
          "start": 404.28,
          "end": 407.523,
          "en": "we actually switch to this NewProject component.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}