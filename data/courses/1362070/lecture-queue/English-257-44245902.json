          "id": 47,
          "start": 143.01,
          "end": 144.66,
          "en": "after running npm install,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 144.66,
          "end": 147.963,
          "en": "you should run npm start in that backend folder.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 149.49,
          "end": 152.01,
          "en": "But then in a separate command prompt",
          "zh": ""
        },
        {
          "id": 50,
          "start": 152.01,
          "end": 153.63,
          "en": "or terminal window,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 153.63,
          "end": 156.51,
          "en": "you should navigate into the main project folder",
          "zh": ""
        },
        {
          "id": 52,
          "start": 156.51,
          "end": 161.19,
          "en": "and also run npm run dev to start that frontend application,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 161.19,
          "end": 162.723,
          "en": "that React application,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 163.62,
          "end": 167.31,
          "en": "because that application is all about loading",
          "zh": ""
        },
        {
          "id": 55,
          "start": 167.31,
          "end": 169.773,
          "en": "and displaying these opinions.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 171.03,
          "end": 175.56,
          "en": "Therefore, if you then visit local host 5173,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 175.56,
          "end": 179.43,
          "en": "you should see a page that looks something like this.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 179.43,
          "end": 182.82,
          "en": "You should see two opinions right from the start,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 182.82,
          "end": 185.7,
          "en": "and these are being fetched from the backend",
          "zh": ""
        },
        {
          "id": 60,
          "start": 185.7,
          "end": 187.86,
          "en": "and are being displayed here.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 187.86,
          "end": 189.42,
          "en": "And you have this form",
          "zh": ""
        },
        {
          "id": 62,
          "start": 189.42,
          "end": 193.14,
          "en": "which can be used to submit a new opinion.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 193.14,
          "end": 195.75,
          "en": "And as you might already be able to guess,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 195.75,
          "end": 198.09,
          "en": "will handle the submission of this form",
          "zh": ""
        },
        {
          "id": 65,
          "start": 198.09,
          "end": 201.12,
          "en": "with help of React's form actions feature.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 201.12,
          "end": 204.243,
          "en": "And that's what we'll get started with in the next lecture.",
          "zh": ""
