{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "44245880",
      "title": "Using User Input",
      "sourceHash": "31c3dc57e69b3010602eb8f1cb141ecdb5e8c090932ab66cfe2ae156a715c180",
      "cues": [
        {
          "id": 1,
          "start": 2.07,
          "end": 3.09,
          "en": "So at the moment,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.09,
          "end": 6.06,
          "en": "all entered values are thrown away",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.06,
          "end": 8.49,
          "en": "if an invalid form is submitted.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.49,
          "end": 12.66,
          "en": "And that's of course not a good user experience.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.66,
          "end": 15.93,
          "en": "Now, to make sure that this is not happening,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.93,
          "end": 20.49,
          "en": "we have to adjust our signup action a little bit.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.49,
          "end": 25.49,
          "en": "And there we should make sure that the state that we return",
          "zh": ""
        },
        {
          "id": 8,
          "start": 25.92,
          "end": 29.553,
          "en": "does not just consist of this errors information,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 30.72,
          "end": 33.87,
          "en": "but that it actually also contains some information",
          "zh": ""
        },
        {
          "id": 10,
          "start": 33.87,
          "end": 36.72,
          "en": "about the entered values.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 36.72,
          "end": 39.6,
          "en": "So the values that have been entered by the user,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 39.6,
          "end": 42.3,
          "en": "because we can then use that information",
          "zh": ""
        },
        {
          "id": 13,
          "start": 42.3,
          "end": 44.19,
          "en": "that's returned in that state",
          "zh": ""
        },
        {
          "id": 14,
          "start": 44.19,
          "end": 48.3,
          "en": "to pre-populate these input fields again,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 48.3,
          "end": 52.353,
          "en": "to make sure that the entered values aren't lost there.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 53.859,
          "end": 58.02,
          "en": "And therefore here I will actually add an entered",
          "zh": ""
        },
        {
          "id": 17,
          "start": 58.02,
          "end": 61.983,
          "en": "values property to my returned state object.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 63.18,
          "end": 65.13,
          "en": "Though of course this doesn't have",
          "zh": ""
        },
        {
          "id": 19,
          "start": 65.13,
          "end": 69.42,
          "en": "to be named entered values, the name is up to you instead.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 69.42,
          "end": 71.34,
          "en": "But here I will name it enteredValues,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 71.34,
          "end": 73.77,
          "en": "and the value will be a nested object",
          "zh": ""
        },
        {
          "id": 22,
          "start": 73.77,
          "end": 78.753,
          "en": "where I want to have all the values I extracted up here.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 79.86,
          "end": 81.46000000000001,
          "en": "So I will simply",
          "zh": ""
        },
        {
          "id": 24,
          "start": 84.4,
          "end": 88.83,
          "en": "pass email, password, confirm password,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 88.83,
          "end": 93.03,
          "en": "first name, last name, role,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 93.03,
          "end": 94.47,
          "en": "acquisition channel,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 94.47,
          "end": 99.393,
          "en": "and terms to this entered values nested object.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 100.59,
          "end": 105.09,
          "en": "And with that done, we can go down to our form",
          "zh": ""
        },
        {
          "id": 29,
          "start": 105.09,
          "end": 108.06,
          "en": "and then for example, go to that email field",
          "zh": ""
        },
        {
          "id": 30,
          "start": 108.06,
          "end": 112.113,
          "en": "and set the default value prop on that input element.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 113.03999999999999,
          "end": 117.27000000000001,
          "en": "Not the value prop, but the default value prop",
          "zh": ""
        },
        {
          "id": 32,
          "start": 117.27000000000001,
          "end": 119.82,
          "en": "because that in the end will define the value",
          "zh": ""
        },
        {
          "id": 33,
          "start": 119.82,
          "end": 123.273,
          "en": "to which this input will be set when the form is reset.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 124.32,
          "end": 127.44,
          "en": "And as mentioned, React does reset the form",
          "zh": ""
        },
        {
          "id": 35,
          "start": 127.44,
          "end": 130.26,
          "en": "whenever the action here is executed.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 130.26,
          "end": 132.18,
          "en": "And that's why I want to change the value",
          "zh": ""
        },
        {
          "id": 37,
          "start": 132.18,
          "end": 134.643,
          "en": "to which this input here is reset.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 135.57,
          "end": 139.91,
          "en": "And I wanna reset it to formState.enteredValues.email",
          "zh": ""
        },
        {
          "id": 39,
          "start": 144.99,
          "end": 148.56,
          "en": "so that the email address that has been entered by the user,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 148.56,
          "end": 151.74,
          "en": "which I do return in my updated state here,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 151.74,
          "end": 155.463,
          "en": "is repopulated into this input field.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 156.6,
          "end": 161.01,
          "en": "Now, it is possible that enteredValues is not defined",
          "zh": ""
        },
        {
          "id": 43,
          "start": 161.01,
          "end": 165,
          "en": "because for example, it's not part of my initial state.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 165,
          "end": 170,
          "en": "There I only have the errors key, no entered values key.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 170.1,
          "end": 175.1,
          "en": "And the same is the case if I did submit a valid form.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 175.35,
          "end": 179.4,
          "en": "So therefore, we should check if entered values exists",
          "zh": ""
        },
        {
          "id": 47,
          "start": 179.4,
          "end": 182.13,
          "en": "by adding a question mark here",
          "zh": ""
        },
        {
          "id": 48,
          "start": 182.13,
          "end": 186.54,
          "en": "so that JavaScript only tries to access this email property",
          "zh": ""
        },
        {
          "id": 49,
          "start": 186.54,
          "end": 189.24,
          "en": "if this is a defined object.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 189.24,
          "end": 192.87,
          "en": "Otherwise undefined will be set as a default value",
          "zh": ""
        },
        {
          "id": 51,
          "start": 192.87,
          "end": 194.82,
          "en": "and that will basically set this input",
          "zh": ""
        },
        {
          "id": 52,
          "start": 194.82,
          "end": 196.383,
          "en": "to an empty input field.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 197.43,
          "end": 200.82,
          "en": "Now I'll migrate the other inputs soon.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 200.82,
          "end": 203.94,
          "en": "First, let's check whether this works as intended",
          "zh": ""
        },
        {
          "id": 55,
          "start": 203.94,
          "end": 206.433,
          "en": "for this email input field here.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 207.32999999999998,
          "end": 209.85,
          "en": "So with that added, if we save this,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 209.85,
          "end": 214.85,
          "en": "if I reload and I enter some email here like this,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 215.16,
          "end": 218.973,
          "en": "and I click sign up, you see I get these error messages,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 220.11,
          "end": 224.28,
          "en": "but now my email input field did not lose its value.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 224.28,
          "end": 226.383,
          "en": "So that's working the way it should.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 227.37,
          "end": 229.74,
          "en": "And therefore we can now use the same approach",
          "zh": ""
        },
        {
          "id": 62,
          "start": 229.74,
          "end": 231.513,
          "en": "for all the other inputs.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 232.41,
          "end": 234.36,
          "en": "Here for the password input,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 234.36,
          "end": 237.993,
          "en": "I want to set it to enteredValues?.password}",
          "zh": ""
        },
        {
          "id": 65,
          "start": 240.325,
          "end": 241.943,
          "en": "For confirm password, it's enteredValues?.confirmPassword}",
          "zh": ""
        },
        {
          "id": 66,
          "start": 246.03,
          "end": 250.52,
          "en": "For the first name, unsurprisingly, it's .firstName}",
          "zh": ""
        },
        {
          "id": 67,
          "start": 252.57,
          "end": 256.443,
          "en": "And for the last name it is .lastName}",
          "zh": ""
        },
        {
          "id": 68,
          "start": 258.06,
          "end": 260.85,
          "en": "Now for the role, we must set the default value",
          "zh": ""
        },
        {
          "id": 69,
          "start": 260.85,
          "end": 263.16,
          "en": "on that select element",
          "zh": ""
        },
        {
          "id": 70,
          "start": 263.16,
          "end": 266.01,
          "en": "because that will then select the right option.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 266.01,
          "end": 267.663,
          "en": "And here it's .role}",
          "zh": ""
        },
        {
          "id": 72,
          "start": 269.201,
          "end": 271.26,
          "en": "For the acquisition channels,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 271.26,
          "end": 272.97,
          "en": "here it's a little bit different.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 272.97,
          "end": 276.723,
          "en": "There on every input we should add defaultChecked,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 278.4,
          "end": 281.013,
          "en": "and then set this to {formState.enteredValues?",
          "zh": ""
        },
        {
          "id": 76,
          "start": 285.177,
          "end": 289.76,
          "en": "acquisitionChannel.includes('google')}",
          "zh": ""
        },
        {
          "id": 77,
          "start": 290.887,
          "end": 293.46,
          "en": "So if the acquisition channel",
          "zh": ""
        },
        {
          "id": 78,
          "start": 293.46,
          "end": 296.13,
          "en": "array includes the word Google,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 296.13,
          "end": 298.653,
          "en": "this Google checkbox should be checked.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 299.85,
          "end": 303.633,
          "en": "And here for friend, I want to check for the value friend.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 304.92,
          "end": 308.16,
          "en": "And for the other input I want to check",
          "zh": ""
        },
        {
          "id": 82,
          "start": 308.16,
          "end": 312.123,
          "en": "for other here, like this.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 313.56,
          "end": 316.08,
          "en": "And here for the terms check box,",
          "zh": ""
        },
        {
          "id": 84,
          "start": 316.08,
          "end": 321.08,
          "en": "it's also the defaultChecked prop that should be added.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 322.682,
          "end": 325.89,
          "en": "And I want to check if {formState.enteredValues?.}",
          "zh": ""
        },
        {
          "id": 86,
          "start": 325.89,
          "end": 330.033,
          "en": "if that's set, if terms is set to true.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 331.74,
          "end": 335.25,
          "en": "So this will be checked if terms is true",
          "zh": ""
        },
        {
          "id": 88,
          "start": 335.25,
          "end": 337.89300000000003,
          "en": "or a truthy value in general.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 339,
          "end": 340.40999999999997,
          "en": "And that should make sure",
          "zh": ""
        },
        {
          "id": 90,
          "start": 340.40999999999997,
          "end": 344.34000000000003,
          "en": "that all the entered values are kept and aren't lost",
          "zh": ""
        },
        {
          "id": 91,
          "start": 344.34000000000003,
          "end": 348.183,
          "en": "just because some invalid value has been entered.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 350.28,
          "end": 354.63,
          "en": "With that, if you reload, if I enter, let's say a password",
          "zh": ""
        },
        {
          "id": 93,
          "start": 354.63,
          "end": 358.95,
          "en": "and a first name and I check this Referred by a friend box",
          "zh": ""
        },
        {
          "id": 94,
          "start": 358.95,
          "end": 360.84,
          "en": "and I click Sign up,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 360.84,
          "end": 364.98,
          "en": "you see these values are all kept,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 364.98,
          "end": 367.02,
          "en": "but I'm also getting some error messages",
          "zh": ""
        },
        {
          "id": 97,
          "start": 367.02,
          "end": 369.873,
          "en": "because well, some fields are invalid.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 370.92,
          "end": 372.81,
          "en": "Now let me switch to a different role here",
          "zh": ""
        },
        {
          "id": 99,
          "start": 372.81,
          "end": 376.83,
          "en": "and all also check the Terms check box and Sign up.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 376.83,
          "end": 379.29,
          "en": "And we got less error messages.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 379.29,
          "end": 381.33,
          "en": "Now, one thing you might notice",
          "zh": ""
        },
        {
          "id": 102,
          "start": 381.33,
          "end": 386.25,
          "en": "is that this dropdown did actually not keep its value.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 386.25,
          "end": 390.25,
          "en": "And to me that seems to be a bug with React here",
          "zh": ""
        },
        {
          "id": 104,
          "start": 391.2,
          "end": 393.96,
          "en": "because I am setting the default value",
          "zh": ""
        },
        {
          "id": 105,
          "start": 393.96,
          "end": 396.33,
          "en": "on that select element correctly here.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 396.33,
          "end": 399.72,
          "en": "But nonetheless, it looks like it always is reset back",
          "zh": ""
        },
        {
          "id": 107,
          "start": 399.72,
          "end": 403.05,
          "en": "to its first option instead of the default value",
          "zh": ""
        },
        {
          "id": 108,
          "start": 403.05,
          "end": 405.24,
          "en": "that's set up here.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 405.24,
          "end": 408.45,
          "en": "So that at the moment, to me, seems to be a problem",
          "zh": ""
        },
        {
          "id": 110,
          "start": 408.45,
          "end": 410.94,
          "en": "with the select element default value",
          "zh": ""
        },
        {
          "id": 111,
          "start": 410.94,
          "end": 413.523,
          "en": "and how use action state works.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 414.87,
          "end": 417.54,
          "en": "Because at the moment there also is no way",
          "zh": ""
        },
        {
          "id": 113,
          "start": 417.54,
          "end": 421.65,
          "en": "of disabling this resetting that's performed",
          "zh": ""
        },
        {
          "id": 114,
          "start": 421.65,
          "end": 423.69,
          "en": "by form actions automatically.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 423.69,
          "end": 426.57,
          "en": "So at the moment, you have to then manage the form state",
          "zh": ""
        },
        {
          "id": 116,
          "start": 426.57,
          "end": 430.04,
          "en": "with use action state and set the values",
          "zh": ""
        },
        {
          "id": 117,
          "start": 430.04,
          "end": 432.39,
          "en": "of the inputs manually if you want to keep them.",
          "zh": ""
        },
        {
          "id": 118,
          "start": 432.39,
          "end": 435.24,
          "en": "And therefore at the moment, I am not aware of a way",
          "zh": ""
        },
        {
          "id": 119,
          "start": 435.24,
          "end": 438.03,
          "en": "that would allow us to keep the value",
          "zh": ""
        },
        {
          "id": 120,
          "start": 438.03,
          "end": 440.193,
          "en": "for this select element here,",
          "zh": ""
        },
        {
          "id": 121,
          "start": 441.06,
          "end": 444.66,
          "en": "but for all the other inputs, it works as expected.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 444.66,
          "end": 447.42,
          "en": "I also want to highlight that this reset button",
          "zh": ""
        },
        {
          "id": 123,
          "start": 447.42,
          "end": 449.193,
          "en": "now also works differently.",
          "zh": ""
        },
        {
          "id": 124,
          "start": 450.21,
          "end": 453.03,
          "en": "If you press it nothing seems to change,",
          "zh": ""
        },
        {
          "id": 125,
          "start": 453.03,
          "end": 454.443,
          "en": "the form isn't reset.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 455.52,
          "end": 457.5,
          "en": "But actually it is, as you can tell",
          "zh": ""
        },
        {
          "id": 127,
          "start": 457.5,
          "end": 460.17,
          "en": "if you uncheck this Terms box, for example,",
          "zh": ""
        },
        {
          "id": 128,
          "start": 460.17,
          "end": 464.73,
          "en": "and you then click Reset, you see it's checked again.",
          "zh": ""
        },
        {
          "id": 129,
          "start": 464.73,
          "end": 468.03,
          "en": "And the reason for this behavior is that reset",
          "zh": ""
        },
        {
          "id": 130,
          "start": 468.03,
          "end": 471.57,
          "en": "resets all these inputs to their default values,",
          "zh": ""
        },
        {
          "id": 131,
          "start": 471.57,
          "end": 475.14,
          "en": "but now I changed those default values.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 475.14,
          "end": 477.96,
          "en": "I changed those default values to make sure",
          "zh": ""
        },
        {
          "id": 133,
          "start": 477.96,
          "end": 480.813,
          "en": "that the entered values are kept around.",
          "zh": ""
        },
        {
          "id": 134,
          "start": 481.98,
          "end": 483.54,
          "en": "So that's worth noting.",
          "zh": ""
        },
        {
          "id": 135,
          "start": 483.54,
          "end": 486.69,
          "en": "If you wanted to empty all those input fields",
          "zh": ""
        },
        {
          "id": 136,
          "start": 486.69,
          "end": 488.46,
          "en": "when the reset button is clicked,",
          "zh": ""
        },
        {
          "id": 137,
          "start": 488.46,
          "end": 491.97,
          "en": "you would have to add some custom logic that does so.",
          "zh": ""
        },
        {
          "id": 138,
          "start": 491.97,
          "end": 494.37,
          "en": "So that does target all these input fields",
          "zh": ""
        },
        {
          "id": 139,
          "start": 494.37,
          "end": 496.803,
          "en": "and sets them to some empty values.",
          "zh": ""
        },
        {
          "id": 140,
          "start": 499.77,
          "end": 503.88,
          "en": "So now with that, we're able to validate these inputs",
          "zh": ""
        },
        {
          "id": 141,
          "start": 503.88,
          "end": 508.08,
          "en": "and we're able to show errors and keep the user input.",
          "zh": ""
        },
        {
          "id": 142,
          "start": 508.08,
          "end": 512.46,
          "en": "Now, of course, if the user enters valid values",
          "zh": ""
        },
        {
          "id": 143,
          "start": 512.46,
          "end": 517.233,
          "en": "into all these fields, so if I quickly do that here.",
          "zh": ""
        },
        {
          "id": 144,
          "start": 519.57,
          "end": 521.73,
          "en": "If I select valid values",
          "zh": ""
        },
        {
          "id": 145,
          "start": 521.73,
          "end": 526.203,
          "en": "and I submit this, then the form is reset again.",
          "zh": ""
        },
        {
          "id": 146,
          "start": 527.85,
          "end": 531.66,
          "en": "Because then in that case, we of course make it through",
          "zh": ""
        },
        {
          "id": 147,
          "start": 531.66,
          "end": 535.74,
          "en": "all these checks and we don't have any errors.",
          "zh": ""
        },
        {
          "id": 148,
          "start": 535.74,
          "end": 538.71,
          "en": "So we make it past this safe check,",
          "zh": ""
        },
        {
          "id": 149,
          "start": 538.71,
          "end": 541.41,
          "en": "and we then return this state object,",
          "zh": ""
        },
        {
          "id": 150,
          "start": 541.41,
          "end": 545.67,
          "en": "which doesn't contain the entered values key anymore.",
          "zh": ""
        },
        {
          "id": 151,
          "start": 545.67,
          "end": 547.41,
          "en": "And therefore all the input fields",
          "zh": ""
        },
        {
          "id": 152,
          "start": 547.41,
          "end": 549.78,
          "en": "are set back to empty values",
          "zh": ""
        },
        {
          "id": 153,
          "start": 549.78,
          "end": 552.33,
          "en": "because there are no values defined",
          "zh": ""
        },
        {
          "id": 154,
          "start": 552.33,
          "end": 554.91,
          "en": "for the entered values key.",
          "zh": ""
        },
        {
          "id": 155,
          "start": 554.91,
          "end": 557.31,
          "en": "And that's indeed the intended behavior.",
          "zh": ""
        },
        {
          "id": 156,
          "start": 557.31,
          "end": 559.62,
          "en": "If it weren't, you simply would have",
          "zh": ""
        },
        {
          "id": 157,
          "start": 559.62,
          "end": 561.6,
          "en": "to add entered values here",
          "zh": ""
        },
        {
          "id": 158,
          "start": 561.6,
          "end": 564.75,
          "en": "and set your desired input values.",
          "zh": ""
        },
        {
          "id": 159,
          "start": 564.75,
          "end": 567.57,
          "en": "But here I wanna reset them all to being empty",
          "zh": ""
        },
        {
          "id": 160,
          "start": 567.57,
          "end": 571.35,
          "en": "because when we submit the form without errors,",
          "zh": ""
        },
        {
          "id": 161,
          "start": 571.35,
          "end": 574.26,
          "en": "we are good to go, so to say.",
          "zh": ""
        },
        {
          "id": 162,
          "start": 574.26,
          "end": 577.8,
          "en": "We would then typically take the entered values,",
          "zh": ""
        },
        {
          "id": 163,
          "start": 577.8,
          "end": 580.56,
          "en": "for example, send them to a backend",
          "zh": ""
        },
        {
          "id": 164,
          "start": 580.56,
          "end": 583.68,
          "en": "and either navigate away from the page",
          "zh": ""
        },
        {
          "id": 165,
          "start": 583.68,
          "end": 587.163,
          "en": "or clear the input fields as we're doing it here.",
          "zh": ""
        },
        {
          "id": 166,
          "start": 588.27,
          "end": 592.02,
          "en": "And that's therefore now how we can use form actions",
          "zh": ""
        },
        {
          "id": 167,
          "start": 592.02,
          "end": 595.41,
          "en": "also in conjunction with this use action state hook",
          "zh": ""
        },
        {
          "id": 168,
          "start": 595.41,
          "end": 599.01,
          "en": "to manage form submissions, input validation,",
          "zh": ""
        },
        {
          "id": 169,
          "start": 599.01,
          "end": 602.463,
          "en": "and the values that have been entered by a user.",
          "zh": ""
        }
      ]
    }
