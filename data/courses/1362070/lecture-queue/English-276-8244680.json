{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "8244680",
      "title": "Working on the Cart Items",
      "sourceHash": "97b5a2e64c66355464f36856bbba43972b66075f97e6477c249765ea88010a77",
      "cues": [
        {
          "id": 1,
          "start": 0.63,
          "end": 2.31,
          "en": "So let's continue by working",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.31,
          "end": 5.04,
          "en": "on the look of these card items.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.04,
          "end": 8.34,
          "en": "And of course, that will be relatively straightforward",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.34,
          "end": 10.2,
          "en": "because for that we'll simply have to add",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.2,
          "end": 12.78,
          "en": "some JSX code here in the card component",
          "zh": ""
        },
        {
          "id": 6,
          "start": 12.78,
          "end": 16.32,
          "en": "or build a separate card item component.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 16.32,
          "end": 17.94,
          "en": "And I'll do the latter.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 17.94,
          "end": 19.86,
          "en": "But of course, you could take either route.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 19.86,
          "end": 22.08,
          "en": "There is no right or wrong here,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 22.08,
          "end": 25.2,
          "en": "but I'll go for a separate card item component",
          "zh": ""
        },
        {
          "id": 11,
          "start": 25.2,
          "end": 28.86,
          "en": "to keep the JSX code of this card component a bit leaner.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 28.86,
          "end": 30.51,
          "en": "But it would definitely be okay",
          "zh": ""
        },
        {
          "id": 13,
          "start": 30.51,
          "end": 33.15,
          "en": "if you would add the card item markup here",
          "zh": ""
        },
        {
          "id": 14,
          "start": 33.15,
          "end": 35.61,
          "en": "in this card component instead.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 35.61,
          "end": 37.71,
          "en": "But here in this new component file,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 37.71,
          "end": 38.67,
          "en": "I'll of course again,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 38.67,
          "end": 41.733,
          "en": "export the cart item component function.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 43.23,
          "end": 46.05,
          "en": "And in this component function,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 46.05,
          "end": 50.04,
          "en": "the main goal then is to return some JSX code.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 50.04,
          "end": 53.58,
          "en": "And here I wanna return a list item,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 53.58,
          "end": 55.44,
          "en": "which should receive a class name",
          "zh": ""
        },
        {
          "id": 22,
          "start": 55.44,
          "end": 58.773,
          "en": "of cart dash item for styling purposes.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 60.21,
          "end": 61.74,
          "en": "And then in the list item,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 61.74,
          "end": 63.48,
          "en": "there should be a paragraph,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 63.48,
          "end": 68.48,
          "en": "which in the end outputs the name of the card item.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 68.49,
          "end": 71.61,
          "en": "And then next to it separated by a dash,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 71.61,
          "end": 74.913,
          "en": "the quantity times the price.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 75.96000000000001,
          "end": 77.457,
          "en": "And of course,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 77.457,
          "end": 79.507,
          "en": "we'll replace that with actual data soon.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 80.4,
          "end": 84.57,
          "en": "And then below that I wanna have another paragraph",
          "zh": ""
        },
        {
          "id": 31,
          "start": 84.57,
          "end": 87,
          "en": "where I wanna have multiple buttons",
          "zh": ""
        },
        {
          "id": 32,
          "start": 87,
          "end": 90.513,
          "en": "that can be clicked to interact with that card item.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 91.47,
          "end": 95.38,
          "en": "One button basically to reduce the quantity",
          "zh": ""
        },
        {
          "id": 34,
          "start": 96.24000000000001,
          "end": 100.8,
          "en": "then another button to increase the quantity.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 100.8,
          "end": 102.33,
          "en": "And between those buttons,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 102.33,
          "end": 105.753,
          "en": "a span where I output the current quantity.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 108.06,
          "end": 111.27000000000001,
          "en": "Now here, I'll not use my custom button component",
          "zh": ""
        },
        {
          "id": 38,
          "start": 111.27000000000001,
          "end": 113.28,
          "en": "because here in this card item",
          "zh": ""
        },
        {
          "id": 39,
          "start": 113.28,
          "end": 115.83,
          "en": "I wanna have a very different button look.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 115.83,
          "end": 117.36,
          "en": "And therefore instead here,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 117.36,
          "end": 121.53,
          "en": "I'll just add a class name to this surrounding paragraph",
          "zh": ""
        },
        {
          "id": 42,
          "start": 121.53,
          "end": 124.71,
          "en": "which should be card dash item, dash actions",
          "zh": ""
        },
        {
          "id": 43,
          "start": 124.71,
          "end": 128.943,
          "en": "which will take care of styling the content in there.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 130.02,
          "end": 133.41,
          "en": "And we now of course need some input data here.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 133.41,
          "end": 134.31,
          "en": "To be precise,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 134.31,
          "end": 138.12,
          "en": "we need the item for which this component is rendered.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 138.12,
          "end": 139.595,
          "en": "And again,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 139.595,
          "end": 141.96,
          "en": "we could either accept and use a single prop",
          "zh": ""
        },
        {
          "id": 49,
          "start": 141.96,
          "end": 145.083,
          "en": "or multiple props for the different attributes.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 145.98,
          "end": 149.1,
          "en": "Now here I'll go for the multi prop approach",
          "zh": ""
        },
        {
          "id": 51,
          "start": 149.1,
          "end": 151.623,
          "en": "to also show you this alternative.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 152.49,
          "end": 157.44299999999998,
          "en": "And here I then would expect to get my name, my quantity,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 159.9,
          "end": 162.04,
          "en": "and my price data",
          "zh": ""
        },
        {
          "id": 54,
          "start": 163.32,
          "end": 166.56,
          "en": "so that here we can output the name.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 166.56,
          "end": 169.45,
          "en": "Here we can output the quantity",
          "zh": ""
        },
        {
          "id": 56,
          "start": 171.54,
          "end": 173.86,
          "en": "and also output that down here",
          "zh": ""
        },
        {
          "id": 57,
          "start": 175.07999999999998,
          "end": 177.633,
          "en": "and here output the price.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 178.65,
          "end": 180.81,
          "en": "Though the price should be formatted",
          "zh": ""
        },
        {
          "id": 59,
          "start": 180.81,
          "end": 183.84,
          "en": "and therefore we can of course import this",
          "zh": ""
        },
        {
          "id": 60,
          "start": 183.84,
          "end": 186.6,
          "en": "currency formatter again",
          "zh": ""
        },
        {
          "id": 61,
          "start": 186.6,
          "end": 190.173,
          "en": "from that formatting JS file, which we added earlier.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 192.284,
          "end": 195.333,
          "en": "And then simply call format on that price here.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 197.13,
          "end": 200.49,
          "en": "And that's essentially it for the moment.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 200.49,
          "end": 202.65,
          "en": "Now in this card component,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 202.65,
          "end": 206.49,
          "en": "I wanna output my card item here in this list.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 206.49,
          "end": 210.72,
          "en": "So this custom card item component we just worked on,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 210.72,
          "end": 213.153,
          "en": "it must be imported of course.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 214.32,
          "end": 216.87,
          "en": "And with that import added here,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 216.87,
          "end": 219.36,
          "en": "it needs that key because all items",
          "zh": ""
        },
        {
          "id": 70,
          "start": 219.36,
          "end": 222.63,
          "en": "in such a list should receive a key as you learned,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 222.63,
          "end": 225.28,
          "en": "the item ID is still a good key",
          "zh": ""
        },
        {
          "id": 72,
          "start": 226.32,
          "end": 230.133,
          "en": "and I then need the name quantity and price.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 231.36,
          "end": 234.6,
          "en": "Now the quick and easy way of passing all the item data,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 234.6,
          "end": 237.18,
          "en": "including name, quantity and price",
          "zh": ""
        },
        {
          "id": 75,
          "start": 237.18,
          "end": 239.28,
          "en": "to that card item component",
          "zh": ""
        },
        {
          "id": 76,
          "start": 239.28,
          "end": 243.75,
          "en": "is to simply spread the item object",
          "zh": ""
        },
        {
          "id": 77,
          "start": 243.75,
          "end": 245.52,
          "en": "onto the card item",
          "zh": ""
        },
        {
          "id": 78,
          "start": 245.52,
          "end": 247.95,
          "en": "because that item object includes a name,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 247.95,
          "end": 249.39,
          "en": "quantity and price.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 249.39,
          "end": 252.21,
          "en": "But since it also includes some extra data",
          "zh": ""
        },
        {
          "id": 81,
          "start": 252.21,
          "end": 254.76,
          "en": "which we don't actually need in there,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 254.76,
          "end": 256.56,
          "en": "even though it wouldn't be a problem",
          "zh": ""
        },
        {
          "id": 83,
          "start": 256.56,
          "end": 259.47,
          "en": "to pass it to this component without needing it,",
          "zh": ""
        },
        {
          "id": 84,
          "start": 259.47,
          "end": 262.86,
          "en": "we could go for a different approach and manually",
          "zh": ""
        },
        {
          "id": 85,
          "start": 262.86,
          "end": 265.533,
          "en": "set name equal to item.name,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 267.448,
          "end": 270.07,
          "en": "quantity equal to item.quantity",
          "zh": ""
        },
        {
          "id": 87,
          "start": 271.65,
          "end": 275.67,
          "en": "and price equal to item.price,",
          "zh": ""
        },
        {
          "id": 88,
          "start": 275.67,
          "end": 276.573,
          "en": "like this.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 278.61,
          "end": 280.8,
          "en": "With that, if you save this,",
          "zh": ""
        },
        {
          "id": 90,
          "start": 280.8,
          "end": 284.883,
          "en": "you should have a nicer output that looks like this here.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 286.86,
          "end": 289.86,
          "en": "But of course those buttons now also should work.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 289.86,
          "end": 291.633,
          "en": "And at the moment they don't.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 292.95,
          "end": 295.29,
          "en": "Now we already have the logic",
          "zh": ""
        },
        {
          "id": 94,
          "start": 295.29,
          "end": 299.34000000000003,
          "en": "for these buttons in place in our card context.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 299.34000000000003,
          "end": 302.58,
          "en": "Here it's add and remove item that should be triggered",
          "zh": ""
        },
        {
          "id": 96,
          "start": 302.58,
          "end": 304.323,
          "en": "when those buttons are pressed.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 305.46,
          "end": 307.62,
          "en": "Now to trigger these functions,",
          "zh": ""
        },
        {
          "id": 98,
          "start": 307.62,
          "end": 308.88,
          "en": "we can, of course again,",
          "zh": ""
        },
        {
          "id": 99,
          "start": 308.88,
          "end": 312,
          "en": "use our context here in the card item.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 312,
          "end": 315.12,
          "en": "Alternatively, to also show you this pattern,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 315.12,
          "end": 316.3,
          "en": "which you already know",
          "zh": ""
        },
        {
          "id": 102,
          "start": 317.153,
          "end": 318,
          "en": "from earlier in the course,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 318,
          "end": 321.42,
          "en": "we could of course also accept extra props",
          "zh": ""
        },
        {
          "id": 104,
          "start": 321.42,
          "end": 323.8,
          "en": "that should get functions as values",
          "zh": ""
        },
        {
          "id": 105,
          "start": 324.93,
          "end": 329.93,
          "en": "on increase and on decrease prop, for example.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 332.19,
          "end": 336.84000000000003,
          "en": "And use these props as values for the on click prop",
          "zh": ""
        },
        {
          "id": 107,
          "start": 336.84000000000003,
          "end": 338.043,
          "en": "on these buttons.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 339.09000000000003,
          "end": 342.54,
          "en": "So on decrease on the minus button,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 342.54,
          "end": 345.663,
          "en": "and on increase on the plus button.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 346.89,
          "end": 347.82,
          "en": "And with that,",
          "zh": ""
        },
        {
          "id": 111,
          "start": 347.82,
          "end": 350.7,
          "en": "this component here would not need to tap",
          "zh": ""
        },
        {
          "id": 112,
          "start": 350.7,
          "end": 352.5,
          "en": "into this context,",
          "zh": ""
        },
        {
          "id": 113,
          "start": 352.5,
          "end": 354.57,
          "en": "even though that also wouldn't be wrong.",
          "zh": ""
        },
        {
          "id": 114,
          "start": 354.57,
          "end": 357.03,
          "en": "But if you want to keep this component a bit leaner,",
          "zh": ""
        },
        {
          "id": 115,
          "start": 357.03,
          "end": 359.1,
          "en": "and you don't want to add the code for",
          "zh": ""
        },
        {
          "id": 116,
          "start": 359.1,
          "end": 360.93,
          "en": "using the context in there,",
          "zh": ""
        },
        {
          "id": 117,
          "start": 360.93,
          "end": 364.23,
          "en": "you could simply accept props like this",
          "zh": ""
        },
        {
          "id": 118,
          "start": 364.23,
          "end": 366.69,
          "en": "and then go to the parent component,",
          "zh": ""
        },
        {
          "id": 119,
          "start": 366.69,
          "end": 371.07,
          "en": "the card component, and set those props here.",
          "zh": ""
        },
        {
          "id": 120,
          "start": 371.07,
          "end": 375.12,
          "en": "On increase should be set equal to something",
          "zh": ""
        },
        {
          "id": 121,
          "start": 375.12,
          "end": 376.533,
          "en": "and on decrease.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 377.64,
          "end": 379.98,
          "en": "And the something of course now should be",
          "zh": ""
        },
        {
          "id": 123,
          "start": 379.98,
          "end": 384.93,
          "en": "a function that does trigger those card context functions,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 384.93,
          "end": 386.883,
          "en": "add item and remove item.",
          "zh": ""
        },
        {
          "id": 125,
          "start": 389.34,
          "end": 393.12,
          "en": "Now the card item already has access to the card context.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 393.12,
          "end": 395.46,
          "en": "So triggering those extra functions",
          "zh": ""
        },
        {
          "id": 127,
          "start": 395.46,
          "end": 399.96,
          "en": "is as simple as passing an anonymous function here",
          "zh": ""
        },
        {
          "id": 128,
          "start": 399.96,
          "end": 401.17,
          "en": "to on increase",
          "zh": ""
        },
        {
          "id": 129,
          "start": 402.18,
          "end": 405.97,
          "en": "and calling card context add item here",
          "zh": ""
        },
        {
          "id": 130,
          "start": 406.86,
          "end": 409.08,
          "en": "and passing this item",
          "zh": ""
        },
        {
          "id": 131,
          "start": 409.08,
          "end": 412.14,
          "en": "for which we're rendering this card item here",
          "zh": ""
        },
        {
          "id": 132,
          "start": 412.14,
          "end": 414.273,
          "en": "as a value to add item.",
          "zh": ""
        },
        {
          "id": 133,
          "start": 415.59000000000003,
          "end": 418.44,
          "en": "And on decrease gets a function",
          "zh": ""
        },
        {
          "id": 134,
          "start": 418.44,
          "end": 422.07,
          "en": "where we call card context remove item",
          "zh": ""
        },
        {
          "id": 135,
          "start": 422.07,
          "end": 425.553,
          "en": "and where we pass the item ID to this function.",
          "zh": ""
        },
        {
          "id": 136,
          "start": 427.5,
          "end": 429.45,
          "en": "And that's simply an alternative,",
          "zh": ""
        },
        {
          "id": 137,
          "start": 429.45,
          "end": 431.22,
          "en": "which has the advantage",
          "zh": ""
        },
        {
          "id": 138,
          "start": 431.22,
