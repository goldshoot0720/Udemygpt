        },
        {
          "id": 15,
          "start": 41.97,
          "end": 42.96,
          "en": "Now actually,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 42.96,
          "end": 45.15,
          "en": "the action which I do wanna trigger here",
          "zh": ""
        },
        {
          "id": 17,
          "start": 45.15,
          "end": 48.87,
          "en": "is almost the same as for the new event route.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 48.87,
          "end": 51.81,
          "en": "We wanna send almost the same kind of request",
          "zh": ""
        },
        {
          "id": 19,
          "start": 51.81,
          "end": 54.39,
          "en": "to just a slightly different URL",
          "zh": ""
        },
        {
          "id": 20,
          "start": 54.39,
          "end": 57.09,
          "en": "with a different request method.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 57.09,
          "end": 59.52,
          "en": "But other than that, it's basically the same action",
          "zh": ""
        },
        {
          "id": 22,
          "start": 59.52,
          "end": 60.48,
          "en": "which I wanna trigger",
          "zh": ""
        },
        {
          "id": 23,
          "start": 60.48,
          "end": 63.81,
          "en": "because it's the same form with the same data.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 63.81,
          "end": 66.66,
          "en": "So it would be great if we could reuse that action",
          "zh": ""
        },
        {
          "id": 25,
          "start": 66.66,
          "end": 69.753,
          "en": "which we're using for creating a new event.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 70.77,
          "end": 72.75,
          "en": "And we can,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 72.75,
          "end": 75.33,
          "en": "for that, I'll grab this code here",
          "zh": ""
        },
        {
          "id": 28,
          "start": 75.33,
          "end": 80.33,
          "en": "where I define and export my action in NewEvent JS.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 80.7,
          "end": 82.74,
          "en": "And I'm adding it to EventForm JS",
          "zh": ""
        },
        {
          "id": 30,
          "start": 82.74,
          "end": 84.87,
          "en": "but I could be adding it to any file.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 84.87,
          "end": 87.87,
          "en": "We could also create a brand new utility file",
          "zh": ""
        },
        {
          "id": 32,
          "start": 87.87,
          "end": 90.18,
          "en": "that stores this action.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 90.18,
          "end": 92.43,
          "en": "Here I'm adding it to EventForm though,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 92.43,
          "end": 94.563,
          "en": "and I now wanna change it a little bit.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 95.4,
          "end": 97.32,
          "en": "I wanna make the code in this action",
          "zh": ""
        },
        {
          "id": 36,
          "start": 97.32,
          "end": 100.05,
          "en": "a bit more dynamic to be able to send",
          "zh": ""
        },
        {
          "id": 37,
          "start": 100.05,
          "end": 102.42,
          "en": "both a request for adding a new event",
          "zh": ""
        },
        {
          "id": 38,
          "start": 102.42,
          "end": 105.15299999999999,
          "en": "as well as for editing an existing event.",
