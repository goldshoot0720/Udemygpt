          "en": "this URL plus the eventId,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 206.73,
          "end": 208.683,
          "en": "if we're editing an existing event.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 210,
          "end": 212.94,
          "en": "So here I'm using this URL variable",
          "zh": ""
        },
        {
          "id": 73,
          "start": 212.94,
          "end": 215.76,
          "en": "and I'm then checking if method is equal to patch,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 215.76,
          "end": 217.82999999999998,
          "en": "which means we're editing an event",
          "zh": ""
        },
        {
          "id": 75,
          "start": 217.82999999999998,
          "end": 221.01,
          "en": "instead of adding an event.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 221.01,
          "end": 223.89,
          "en": "And in that case, I want to get the idea of the event",
          "zh": ""
        },
        {
          "id": 77,
          "start": 223.89,
          "end": 227.22,
          "en": "which we're editing by accessing my params here.",
