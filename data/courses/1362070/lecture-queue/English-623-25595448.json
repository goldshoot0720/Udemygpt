      "cues": [
        {
          "id": 1,
          "start": 2.066,
          "end": 5.666,
          "en": "-: As you work on your React application",
          "zh": ""
        },
        {
          "id": 2,
          "start": 5.666,
          "end": 8.6,
          "en": "and on your React components,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 8.6,
          "end": 11.466,
          "en": "you will notice in any project",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.466,
          "end": 15.8,
          "en": "that your components eventually become bigger and bigger.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 15.8,
          "end": 20.233,
          "en": "As you have more and more logic and JSX code in them.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 20.233,
          "end": 23.766,
          "en": "This is something which will naturally happen.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 23.766,
          "end": 24.2,
          "en": "This is something which will naturally happen.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 24.2,
          "end": 28.266,
          "en": "That is why React has this component concept.",
          "zh": ""
        },
        {
          "id": 9,
