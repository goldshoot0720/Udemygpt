          "id": 17,
          "start": 49.066,
          "end": 51.766,
          "en": "relatively small and manageable,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 51.766,
          "end": 55.266,
          "en": "and you keep its code base small and manageable",
          "zh": ""
        },
        {
          "id": 19,
          "start": 55.266,
          "end": 59.9,
          "en": "and you still can build a complex user interface.",
          "zh": ""
        },
        {
          "id": 20,
