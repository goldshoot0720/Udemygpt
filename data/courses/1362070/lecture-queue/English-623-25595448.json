          "en": "into smaller building blocks,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 33.466,
          "end": 36.533,
          "en": "where every building block, every component",
          "zh": ""
        },
        {
          "id": 12,
          "start": 36.533,
          "end": 40.033,
          "en": "is focused on one core task, you could say.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 40.033,
          "end": 40.266,
          "en": "is focused on one core task, you could say.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 40.266,
          "end": 43.366,
          "en": "And then you build your overall user interface,",
          "zh": ""
