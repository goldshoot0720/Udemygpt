    {
      "id": "15700470",
      "title": "Finishing the Store Hook",
      "sourceHash": "f55a60d8a0c5ef100d09ddacab5c22f6c2335fc97c7c0737c8db862336bf07ea",
      "cues": [
        {
          "id": 1,
          "start": 2.37,
          "end": 4.91,
          "en": "So now we're managing the listeners.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.91,
          "end": 8.7,
          "en": "Now we need to be able to change our state,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 8.7,
          "end": 9.73,
          "en": "and for that,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.73,
          "end": 11.06,
          "en": "we should be able to kind of",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.06,
          "end": 13.74,
          "en": "dispatch actions in our components.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.74,
          "end": 16.715,
          "en": "So the same idea as if we were using Redux.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 16.715,
          "end": 19.3,
          "en": "Hence here in useStore,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 19.3,
          "end": 20.99,
          "en": "I'll add a new constant,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 20.99,
          "end": 23.13,
          "en": "and I'll name it \"dispatch\",",
          "zh": ""
        },
        {
          "id": 10,
          "start": 23.13,
          "end": 27.32,
          "en": "and this should actually be a function,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 27.32,
          "end": 30.317,
          "en": "where I, let's say get a action",
          "zh": ""
        },
        {
          "id": 12,
          "start": 30.317,
          "end": 32.21,
          "en": "and then something should happen",
          "zh": ""
        },
        {
          "id": 13,
          "start": 32.21,
          "end": 33.91,
          "en": "when that action is triggered.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 33.91,
          "end": 35.14,
          "en": "And actually here I just want to get",
          "zh": ""
        },
        {
          "id": 15,
          "start": 35.14,
          "end": 38.84,
          "en": "the name or the identifier of that action",
          "zh": ""
        },
        {
          "id": 16,
          "start": 38.84,
          "end": 40.82,
          "en": "because we'll define the concrete actions",
          "zh": ""
        },
        {
          "id": 17,
          "start": 40.82,
          "end": 41.91,
          "en": "in a different place.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 41.91,
          "end": 44.11,
          "en": "This here is still the overall abstract",
          "zh": ""
        },
        {
          "id": 19,
          "start": 44.11,
          "end": 47.42,
          "en": "definition of our Store Management System.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 47.42,
          "end": 49.24,
          "en": "So here we get some action identifier",
          "zh": ""
        },
        {
          "id": 21,
          "start": 49.24,
          "end": 52.3,
          "en": "and keep in mind that we have this actions object up there.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 52.3,
          "end": 53.806,
          "en": "My idea is that we can later",
          "zh": ""
        },
        {
          "id": 23,
          "start": 53.806,
          "end": 57.3,
          "en": "define concrete usages of our store",
          "zh": ""
        },
        {
          "id": 24,
          "start": 57.3,
          "end": 59.32,
          "en": "with their own actions",
          "zh": ""
        },
        {
          "id": 25,
          "start": 59.32,
          "end": 61.957,
          "en": "and therefore such actions will soon",
          "zh": ""
        },
        {
          "id": 26,
          "start": 61.957,
          "end": 65.62,
          "en": "be registered here in this actions object.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 65.62,
          "end": 67.143,
          "en": "Hence here,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 68.96000000000001,
          "end": 70.93,
          "en": "where we get a action,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 70.93,
          "end": 72.76,
          "en": "I can reach out to actions",
          "zh": ""
        },
        {
          "id": 30,
          "start": 72.76,
          "end": 74.55,
          "en": "for that action identifier,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 74.55,
          "end": 76.31,
          "en": "because that should be a key of that",
          "zh": ""
        },
        {
          "id": 32,
          "start": 76.31,
          "end": 79.718,
          "en": "actions object later once it is registered.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 79.718,
          "end": 82.7,
          "en": "And this action should actually be a function.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 82.7,
          "end": 85.16,
          "en": "So, actions should be an object where",
          "zh": ""
        },
        {
          "id": 35,
          "start": 85.16,
          "end": 88.49,
          "en": "we have keys which match my identifier here",
          "zh": ""
        },
        {
          "id": 36,
          "start": 88.49,
          "end": 90.95,
          "en": "and where the value then is a concrete function,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 90.95,
          "end": 93.303,
          "en": "which is called by me adding parentheses here.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 94.447,
          "end": 99.447,
          "en": "The function which I call here should get my globalState,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 101.15,
          "end": 103.50999999999999,
          "en": "so my current globalState,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 103.50999999999999,
          "end": 105.81,
          "en": "and should return me a newState,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 105.81,
          "end": 108.37,
          "en": "that's essentially all what happened in Redux, right?",
          "zh": ""
        },
        {
          "id": 42,
          "start": 108.37,
          "end": 110.12,
          "en": "In a Redux, in the reducer we in the end",
          "zh": ""
        },
        {
          "id": 43,
          "start": 110.12,
          "end": 112.74000000000001,
          "en": "also got a action, and the reducer then",
          "zh": ""
        },
        {
          "id": 44,
          "start": 113.63,
          "end": 118.00999999999999,
          "en": "checked the action and returned a newState in the end.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 118.00999999999999,
          "end": 120.4,
          "en": "It's the same concept I'm following here",
          "zh": ""
        },
        {
          "id": 46,
          "start": 120.4,
          "end": 122.84,
          "en": "I get a actionIdentifier,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 122.84,
          "end": 126.092,
          "en": "I search for that action in my actions object,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 126.092,
          "end": 128.4,
          "en": "I expect that actions is a function,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 128.4,
          "end": 129.233,
          "en": "which I then execute,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 129.233,
          "end": 130.41,
          "en": "so my reducer function,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 130.41,
          "end": 132.21,
          "en": "so to say, which returns a newState.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 133.288,
          "end": 136.15,
          "en": "That newest state is that what I merged with my old state.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 136.15,
          "end": 139.6,
          "en": "So globalState should then be essentially,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 139.6,
          "end": 141.331,
          "en": "my old copied globalState",
          "zh": ""
        },
        {
          "id": 55,
          "start": 141.331,
          "end": 144.107,
          "en": "merged with everything in the newState,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 144.107,
          "end": 146.273,
          "en": "so that my globalState is a new object",
          "zh": ""
        },
        {
          "id": 57,
          "start": 146.273,
          "end": 149.1,
          "en": "with the old data plus the new data.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 149.1,
          "end": 150.57999999999998,
          "en": "The newState.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 150.57999999999998,
          "end": 151.65,
          "en": "And now we just need to",
          "zh": ""
        },
        {
          "id": 60,
          "start": 151.65,
          "end": 154.768,
          "en": "inform all listeners about that state update.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 154.768,
          "end": 157.3,
          "en": "So I'll go through all my listeners,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 157.3,
          "end": 158.427,
          "en": "so, \"for (const listener of listeners)\"",
          "zh": ""
        },
        {
          "id": 63,
          "start": 160.37,
          "end": 162.19,
          "en": "using a for of loop here,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 162.19,
          "end": 163.92000000000002,
          "en": "and listeners of course,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 163.92000000000002,
          "end": 167.42000000000002,
          "en": "is that global listeners array here,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 167.42000000000002,
          "end": 168.563,
          "en": "and then, keep in mind,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 168.563,
          "end": 171.41,
          "en": "that what we add to listeners is just set state,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 171.41,
          "end": 172.63,
          "en": "so it's a function.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 172.63,
          "end": 175.47,
          "en": "So here I'll simply call listener,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 175.47,
          "end": 177.869,
          "en": "and pass my globalState here.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 177.869,
          "end": 181.313,
          "en": "So my new globalState is what pass to listener.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 182.54,
          "end": 185.59,
          "en": "What this does is that it updates this React state,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 185.59,
          "end": 188.16,
          "en": "because that's where my listener comes from, ultimately,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 188.16,
          "end": 190.04,
          "en": "with the new globalState, and hence,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 190.04,
          "end": 191.838,
          "en": "React will re-render the component",
          "zh": ""
        },
        {
          "id": 76,
          "start": 191.838,
          "end": 193.733,
          "en": "that is using my custom hook here.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 195.9,
          "end": 199.23,
          "en": "Now I know we're still in a relatively abstract world.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 199.23,
          "end": 200.92000000000002,
          "en": "But this was an important first step,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 200.92000000000002,
          "end": 203.97,
          "en": "we're now having an abstract dispatch function,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 203.97,
          "end": 205.413,
          "en": "we're able to register listeners,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 205.413,
          "end": 207.07,
          "en": "this is my custom hook.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 207.07,
          "end": 210.1,
          "en": "Now this custom hook should also return something.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 210.1,
          "end": 213.1,
          "en": "And the something is an array with exactly two elements.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 213.1,
          "end": 215.94,
          "en": "And that's the globalState and dispatch.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 215.94,
          "end": 217.954,
          "en": "And if that looks familiar to you,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 217.954,
          "end": 220.13,
          "en": "then this is exactly what the",
          "zh": ""
        },
        {
          "id": 87,
          "start": 220.13,
          "end": 223.44,
          "en": "built-in useReducer function always returned.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 223.44,
          "end": 225.79,
          "en": "It always returns a state and a dispatch function.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 225.79,
          "end": 229.01,
          "en": "It's just not suited for managing state across components,",
          "zh": ""
        },
        {
          "id": 90,
          "start": 229.01,
          "end": 231.57,
          "en": "which is why I have to build my own version kind of.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 231.57,
          "end": 234.143,
          "en": "But here I returned to globalState and dispatch.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 236.23,
          "end": 238.4,
          "en": "Now, this is one thing I have here,",
          "zh": ""
        },
        {
          "id": 93,
          "start": 238.4,
          "end": 240.96,
          "en": "and I will export this constant hook.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 240.96,
          "end": 242.573,
          "en": "We need something else though.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 243.74,
          "end": 244.94,
          "en": "This custom hook is nice,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 244.94,
          "end": 246.523,
          "en": "but it's still very generic.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 247.46,
          "end": 249.13,
          "en": "For example, right now, we got no way",
          "zh": ""
        },
        {
          "id": 98,
          "start": 249.13,
          "end": 251.26,
          "en": "to change these actions we can call them,",
          "zh": ""
        },
        {
          "id": 99,
          "start": 251.26,
          "end": 252.93,
          "en": "but we can't set them.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 252.93,
          "end": 255.73,
          "en": "So there is another thing I will export from this file,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 255.73,
          "end": 256.812,
          "en": "besides the custom hook.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 256.812,
          "end": 260.19,
          "en": "And that's the initStore function",
          "zh": ""
        },
        {
          "id": 103,
          "start": 260.19,
          "end": 261.633,
          "en": "This function here,",
          "zh": ""
        },
        {
          "id": 104,
          "start": 262.74,
          "end": 264.775,
          "en": "which I also expert, as a named export,",
          "zh": ""
        },
        {
          "id": 105,
          "start": 264.775,
          "end": 268.08,
          "en": "will get some actions which are defined",
          "zh": ""
        },
        {
          "id": 106,
          "start": 268.08,
          "end": 270.04,
          "en": "by you as the developer,",
          "zh": ""
        },
        {
          "id": 107,
          "start": 270.04,
          "end": 272.056,
          "en": "and maybe also an initialState,",
          "zh": ""
        },
        {
          "id": 108,
          "start": 272.056,
          "end": 273.31,
          "en": "so that you can define this too,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 273.31,
          "end": 275.73,
          "en": "because right now globalState is always an empty state,",
          "zh": ""
        },
        {
          "id": 110,
          "start": 275.73,
          "end": 278.21,
          "en": "maybe you have some initialState like we do,",
          "zh": ""
        },
        {
          "id": 111,
          "start": 278.21,
          "end": 281.29,
          "en": "actually, we do have some products initially, for example.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 281.29,
          "end": 283.29,
          "en": "And in here, I will simply check,",
          "zh": ""
        },
        {
          "id": 113,
          "start": 283.29,
          "end": 285.653,
          "en": "if initialState, whoops, initialState,",
          "zh": ""
        },
        {
          "id": 114,
          "start": 287.054,
          "end": 288.6,
          "en": "whoops, that should be always initialState,",
          "zh": ""
        },
        {
          "id": 115,
          "start": 288.6,
          "end": 290.561,
          "en": "so, if initialState is not now,",
          "zh": ""
        },
        {
          "id": 116,
          "start": 290.561,
          "end": 292.473,
          "en": "in which case I'll set globalState",
          "zh": ""
        },
        {
          "id": 117,
          "start": 292.473,
          "end": 296.09000000000003,
          "en": "equal to an object, where I copy the current globalState,",
          "zh": ""
        },
        {
          "id": 118,
          "start": 296.09000000000003,
          "end": 298.78,
          "en": "because keep in mind that you'll share that file,",
          "zh": ""
        },
        {
          "id": 119,
          "start": 298.78,
          "end": 300.3,
          "en": "and you'll share that state.",
          "zh": ""
        },
        {
          "id": 120,
          "start": 300.3,
          "end": 304.93,
          "en": "So just like in Redux, you have multiple reducers",
          "zh": ""
        },
        {
          "id": 121,
          "start": 304.93,
          "end": 306.81,
          "en": "that make up one global store.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 306.81,
          "end": 310.13,
          "en": "So therefore, in Redux, you had to call combined reducers",
          "zh": ""
        },
        {
          "id": 123,
          "start": 310.13,
          "end": 313.14,
          "en": "to create one big store state object,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 313.14,
          "end": 314.258,
          "en": "it's the same what we're doing here.",
          "zh": ""
        },
        {
          "id": 125,
          "start": 314.258,
          "end": 316.733,
          "en": "I merged to be currently having a globalState",
          "zh": ""
        },
        {
          "id": 126,
          "start": 316.733,
          "end": 319.837,
          "en": "with the initialState of this concrete instantiation",
          "zh": ""
        },
        {
          "id": 127,
          "start": 319.837,
          "end": 322.29,
          "en": "of this state, so to say, so that we",
          "zh": ""
        },
        {
          "id": 128,
          "start": 322.29,
          "end": 325.223,
          "en": "could manage multiple things with this global store.",
          "zh": ""
        },
        {
          "id": 129,
          "start": 326.46,
          "end": 329.07,
          "en": "So here, I'll merge in my initialState.",
          "zh": ""
        },
        {
          "id": 130,
          "start": 329.07,
          "end": 332.266,
          "en": "And I'll set actions equal to all the current actions,",
          "zh": ""
        },
        {
          "id": 131,
          "start": 332.266,
          "end": 335.467,
          "en": "and then merge in the userActions.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 336.47,
          "end": 338.17,
          "en": "So now we have our globalState.",
          "zh": ""
        },
        {
          "id": 133,
          "start": 338.17,
          "end": 341.533,
          "en": "We have already userActions all registered here.",
          "zh": ""
        },
        {
          "id": 134,
          "start": 341.533,
          "end": 344.90999999999997,
          "en": "Now we need some place where we can create",
          "zh": ""
        },
        {
          "id": 135,
          "start": 344.90999999999997,
          "end": 347.05,
          "en": "a concrete products store",
          "zh": ""
        },
        {
