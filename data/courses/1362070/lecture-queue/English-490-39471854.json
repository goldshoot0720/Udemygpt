        {
          "id": 17,
          "start": 49.26,
          "end": 52.62,
          "en": "you should be able to see this website here",
          "zh": ""
        },
        {
          "id": 18,
          "start": 52.62,
          "end": 56.25,
          "en": "with this dummies starting screen here.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 56.25,
          "end": 60.78,
          "en": "And then this challenges area here where you got these tabs",
          "zh": ""
        },
        {
          "id": 20,
          "start": 60.78,
          "end": 64.95,
          "en": "and where you can also add a new challenge like learn react",
          "zh": ""
        },
        {
          "id": 21,
          "start": 64.95,
          "end": 69.95,
          "en": "from the ground up, set a date, pick an image, add it",
          "zh": ""
        },
        {
          "id": 22,
          "start": 70.92,
