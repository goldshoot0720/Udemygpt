          "zh": ""
        },
        {
          "id": 3,
          "start": 8.45,
          "end": 11.47,
          "en": "to any backend works in react.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.47,
          "end": 14.7,
          "en": "In our new meetup form component,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 14.7,
          "end": 17.41,
          "en": "we call on add meetup on props",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.41,
          "end": 20.03,
          "en": "to pass our collected data there.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.03,
          "end": 22.43,
          "en": "And in the end therefore we need to go",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.43,
          "end": 25.26,
          "en": "to the component that uses new meetup form",
          "zh": ""
        },
        {
          "id": 9,
          "start": 25.26,
          "end": 27.09,
          "en": "to work with that data.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.09,
          "end": 29.83,
          "en": "And that is our new meetup page.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.83,
          "end": 32.35,
          "en": "There, we have this add meetup handler",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.35,
          "end": 34.75,
          "en": "which gets this collected data.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 34.75,
          "end": 35.92,
          "en": "And therefore it's here",
          "zh": ""
        },
        {
          "id": 14,
          "start": 35.92,
          "end": 39.62,
          "en": "where we now wanna send the request to our API route.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 39.62,
          "end": 42.68,
          "en": "And we can send the request just as we know it,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 42.68,
          "end": 45.25,
          "en": "for example with the built in fetch function",
          "zh": ""
        },
        {
          "id": 17,
          "start": 45.25,
          "end": 48.403,
          "en": "or with a third-party package like axis.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 49.25,
          "end": 51.3,
          "en": "Now here I'll use the fetch function",
          "zh": ""
        },
        {
          "id": 19,
          "start": 51.3,
          "end": 52.9,
          "en": "and I wanna use async await,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 52.9,
          "end": 55.92,
