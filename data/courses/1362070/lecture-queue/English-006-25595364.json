        },
        {
          "id": 12,
          "start": 38.07,
          "end": 39.99,
          "en": "but if you're brand new to React,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 39.99,
          "end": 43.95,
          "en": "I got two possible paths for you.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 43.95,
          "end": 46.38,
          "en": "For one, there is the standard path",
