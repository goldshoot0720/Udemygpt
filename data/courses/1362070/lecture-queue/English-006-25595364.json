        },
        {
          "id": 26,
          "start": 86.4,
          "end": 90.57,
          "en": "to which you find a link attached to this lecture here",
          "zh": ""
        },
        {
          "id": 27,
          "start": 90.57,
          "end": 92.82,
          "en": "so that you can jump right away",
