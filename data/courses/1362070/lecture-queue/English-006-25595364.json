        {
          "id": 15,
          "start": 46.38,
          "end": 50.4,
          "en": "which is my recommendation for most students.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 50.4,
          "end": 53.19,
          "en": "Here, you simply start with lecture one",
          "zh": ""
        },
        {
          "id": 17,
          "start": 53.19,
          "end": 54.6,
          "en": "in section one",
          "zh": ""
        },
        {
          "id": 18,
          "start": 54.6,
          "end": 58.38,
          "en": "and you then complete the course lecture-by-lecture,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 58.38,
          "end": 63.38,
          "en": "section-by-section in the order you find in the curriculum.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 63.72,
          "end": 67.44,
          "en": "This ensures that you learn React from the ground up,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 67.44,
          "end": 70.713,
          "en": "step-by-step and in great detail.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 71.76,
          "end": 75.21000000000001,
