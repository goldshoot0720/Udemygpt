{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "41699612",
      "title": "Grouping Compound Components",
      "sourceHash": "ea0b53db5fc3a260ddd4b1f43453756dd8e5e1ca9ae5d0b3df7a619e8a1c4901",
      "cues": [
        {
          "id": 1,
          "start": 2.13,
          "end": 5.7,
          "en": "So this basic accordion is working,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 5.7,
          "end": 7.11,
          "en": "but we're not done yet.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.11,
          "end": 11.07,
          "en": "It's not just the styling that's not optimal yet.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.07,
          "end": 15.09,
          "en": "Instead, we can also improve the state management logic.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 15.09,
          "end": 17.88,
          "en": "At the moment, we have two functions for opening",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.88,
          "end": 19.92,
          "en": "and closing, but it turns out",
          "zh": ""
        },
        {
          "id": 7,
          "start": 19.92,
          "end": 22.11,
          "en": "that we can merge this into one function,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.11,
          "end": 26.82,
          "en": "the toggleItem function",
          "zh": ""
        },
        {
          "id": 9,
          "start": 26.82,
          "end": 29.13,
          "en": "where I expect to get an ID",
          "zh": ""
        },
        {
          "id": 10,
          "start": 29.13,
          "end": 33.33,
          "en": "and where we then call setOpenItemId.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 33.33,
          "end": 35.91,
          "en": "So our state updating function,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 35.91,
          "end": 38.55,
          "en": "and where we then update the state based",
          "zh": ""
        },
        {
          "id": 13,
          "start": 38.55,
          "end": 41.94,
          "en": "on what was previously stored in that state.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 41.94,
          "end": 45.57,
          "en": "And if we are updating the state based on the old state,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 45.57,
          "end": 49.65,
          "en": "it is considered a good practice to use this function form",
          "zh": ""
        },
        {
          "id": 16,
          "start": 49.65,
          "end": 53.1,
          "en": "of deriving the new state where in this case,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 53.1,
          "end": 58.1,
          "en": "I'll get the previous openItemId as an input automatically",
          "zh": ""
        },
        {
          "id": 18,
          "start": 58.8,
          "end": 63,
          "en": "by React and where we then should return the new state value",
          "zh": ""
        },
        {
          "id": 19,
          "start": 63,
          "end": 64.143,
          "en": "that should be stored.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 65.1,
          "end": 70.1,
          "en": "And that now could be the ID we are receiving here",
          "zh": ""
        },
        {
          "id": 21,
          "start": 70.11,
          "end": 73.23,
          "en": "if that's not what we stored previously",
          "zh": ""
        },
        {
          "id": 22,
          "start": 73.23,
          "end": 75.84,
          "en": "because if the previous ID is equal",
          "zh": ""
        },
        {
          "id": 23,
          "start": 75.84,
          "end": 80.01,
          "en": "to the ID we're receiving here, then we clicked on an item",
          "zh": ""
        },
        {
          "id": 24,
          "start": 80.01,
          "end": 81.69,
          "en": "that was already open.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 81.69,
          "end": 83.49,
          "en": "And in that case, we wanna close it.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 84.96000000000001,
          "end": 89.52,
          "en": "So here the new state I wanna set is a conditional state",
          "zh": ""
        },
        {
          "id": 27,
          "start": 89.52,
          "end": 92.07,
          "en": "where I check if previous ID is equal",
          "zh": ""
        },
        {
          "id": 28,
          "start": 92.07,
          "end": 96.12299999999999,
          "en": "to this ID we received here as a parameter.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 97.22999999999999,
          "end": 100.59,
          "en": "And if that's the case, that means the item was open",
          "zh": ""
        },
        {
          "id": 30,
          "start": 100.59,
          "end": 102.45,
          "en": "and should now be closed.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 102.45,
          "end": 105.96000000000001,
          "en": "So in that case, I'll return null as a new value",
          "zh": ""
        },
        {
          "id": 32,
          "start": 105.96000000000001,
          "end": 107.43299999999999,
          "en": "for the openItemId.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 108.93,
          "end": 112.38,
          "en": "Otherwise, if these IDs are not equal, some other item",
          "zh": ""
        },
        {
          "id": 34,
          "start": 112.38,
          "end": 114.18,
          "en": "or no item was open,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 114.18,
          "end": 117.93,
          "en": "and in that case, I wanna set that received ID",
          "zh": ""
        },
        {
          "id": 36,
          "start": 117.93,
          "end": 119.253,
          "en": "as a new state.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 120.6,
          "end": 124.17,
          "en": "And now we can add that toggleItem function",
          "zh": ""
        },
        {
          "id": 38,
          "start": 124.17,
          "end": 125.943,
          "en": "to our context value.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 127.14,
          "end": 129.27,
          "en": "With that in AccordionItem,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 129.27,
          "end": 132.25,
          "en": "we can simplify this handleClick function",
          "zh": ""
        },
        {
          "id": 41,
          "start": 133.14,
          "end": 134.86,
          "en": "and simply call toggleItem",
          "zh": ""
        },
        {
          "id": 42,
          "start": 136.89,
          "end": 139.59,
          "en": "and pass this ID, which we received",
          "zh": ""
        },
        {
          "id": 43,
          "start": 139.59,
          "end": 141.753,
          "en": "through props to toggleItem.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 142.65,
          "end": 144.15,
          "en": "Of course, for that, we also need",
          "zh": ""
        },
        {
          "id": 45,
          "start": 144.15,
          "end": 147.123,
          "en": "to pull toggleItem out of this context.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 148.14,
          "end": 151.74,
          "en": "And now we could even get rid of this extra function here",
          "zh": ""
        },
        {
          "id": 47,
          "start": 151.74,
          "end": 154.42000000000002,
          "en": "and just grab this code and delete this",
          "zh": ""
        },
        {
          "id": 48,
          "start": 156.12,
          "end": 161.12,
          "en": "and then here set up this handler like that.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 161.49,
          "end": 163.353,
          "en": "That's, of course, optional though.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 164.7,
          "end": 169.62,
          "en": "Now with that, if we save this, this still works as before,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 169.62,
          "end": 171.64,
          "en": "but now we improved the code",
          "zh": ""
        },
        {
          "id": 52,
          "start": 173.7,
          "end": 178.41,
          "en": "and there's one other code improvement we can implement here",
          "zh": ""
        },
        {
          "id": 53,
          "start": 178.41,
          "end": 181.74,
          "en": "because of course, as you can tell, Accordion",
          "zh": ""
        },
        {
          "id": 54,
          "start": 181.74,
          "end": 184.71,
          "en": "and AccordionItem are meant to work together.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 184.71,
          "end": 186.51,
          "en": "After all, that's the idea",
          "zh": ""
        },
        {
          "id": 56,
          "start": 186.51,
          "end": 189.48,
          "en": "behind this Compound Components pattern.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 189.48,
          "end": 191.82,
          "en": "Now, it's kind of obvious that they are meant",
          "zh": ""
        },
        {
          "id": 58,
          "start": 191.82,
          "end": 194.49,
          "en": "to work together because they're in the same folder",
          "zh": ""
        },
        {
          "id": 59,
          "start": 194.49,
          "end": 197.19,
          "en": "and they both start with Accordion.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 197.19,
          "end": 200.19,
          "en": "But we can make it more obvious",
          "zh": ""
        },
        {
          "id": 61,
          "start": 200.19,
          "end": 202.17000000000002,
          "en": "because it is a common pattern",
          "zh": ""
        },
        {
          "id": 62,
          "start": 202.17000000000002,
          "end": 206.64,
          "en": "and a common practice when building such Compound Components",
          "zh": ""
        },
        {
          "id": 63,
          "start": 206.64,
          "end": 210.78,
          "en": "to merge all those component identifiers",
          "zh": ""
        },
        {
          "id": 64,
          "start": 210.78,
          "end": 213.573,
          "en": "into one object you could say.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 214.56,
          "end": 217.05,
          "en": "And it is indeed also quite common",
          "zh": ""
        },
        {
          "id": 66,
          "start": 217.05,
          "end": 221.94,
          "en": "to use the main wrapping function object as an object",
          "zh": ""
        },
        {
          "id": 67,
          "start": 221.94,
          "end": 224.89,
          "en": "to which all the other identifiers should be merged",
          "zh": ""
        },
        {
          "id": 68,
          "start": 225.96,
          "end": 229.29,
          "en": "because in JavaScript, functions are, in the end,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 229.29,
          "end": 234.15,
          "en": "just values, to be precise, they are object values",
          "zh": ""
        },
        {
          "id": 70,
          "start": 234.15,
          "end": 236.4,
          "en": "and therefore, even though you typically",
          "zh": ""
        },
        {
          "id": 71,
          "start": 236.4,
          "end": 238.26,
          "en": "don't do it that often,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 238.26,
          "end": 242.553,
          "en": "you can add properties and methods to your function objects.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 243.72,
          "end": 248.67,
          "en": "And here in the Accordion.jsx file, we can use this feature",
          "zh": ""
        },
        {
          "id": 74,
          "start": 248.67,
          "end": 253.14,
          "en": "to access the accordion function object by its name,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 253.14,
          "end": 255.12,
          "en": "and then instead of calling it",
          "zh": ""
        },
        {
          "id": 76,
          "start": 255.12,
          "end": 260.12,
          "en": "or using it as JSX, we instead simply add a property",
          "zh": ""
        },
        {
          "id": 77,
          "start": 261.33,
          "end": 263.85,
          "en": "by using the dot notation.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 263.85,
          "end": 267.69,
          "en": "And then I'm adding a new property called Item,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 267.69,
          "end": 269.343,
          "en": "that name is up to you though,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 270.6,
          "end": 271.74,
          "en": "and I'll set the value",
          "zh": ""
        },
        {
          "id": 81,
          "start": 271.74,
          "end": 275.703,
          "en": "of that property equal to AccordionItem.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 277.11,
          "end": 280.26,
          "en": "So to my AccordionItem component function,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 280.26,
          "end": 284.913,
          "en": "which I am importing here into this Accordion.jsx file now.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 286.02,
          "end": 289.89,
          "en": "So this AccordionItem component function was now added",
          "zh": ""
        },
        {
          "id": 85,
          "start": 289.89,
          "end": 293.15999999999997,
          "en": "as a value for that Item key",
          "zh": ""
        },
        {
          "id": 86,
          "start": 293.15999999999997,
          "end": 296.283,
          "en": "on the Accordion function component object.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 297.24,
          "end": 301.02,
          "en": "And with that, we can go to the App component",
          "zh": ""
        },
        {
          "id": 88,
          "start": 301.02,
          "end": 306.02,
          "en": "and there we now no longer have to import AccordionItem.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 306.84,
          "end": 309.3,
          "en": "Instead, we only import Accordion",
          "zh": ""
        },
        {
          "id": 90,
          "start": 309.3,
          "end": 314.043,
          "en": "and we now output the item by using Accordion.Item.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 315.54,
          "end": 317.28,
          "en": "And I'm using that everywhere",
          "zh": ""
        },
        {
          "id": 92,
          "start": 317.28,
          "end": 319.713,
          "en": "where I used the other component before.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 320.58,
          "end": 322.68,
          "en": "Now, it will still work as before,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 322.68,
          "end": 326.715,
          "en": "but it now makes it much clearer that this item component",
          "zh": ""
        },
        {
          "id": 95,
          "start": 326.715,
          "end": 329.31,
          "en": "belongs to this accordion component",
          "zh": ""
        },
        {
          "id": 96,
          "start": 329.31,
          "end": 332.08,
          "en": "and should be used inside of the accordion component",
          "zh": ""
        },
        {
          "id": 97,
          "start": 333.09000000000003,
          "end": 335.97,
          "en": "because indeed, if we ever would try",
          "zh": ""
        },
        {
          "id": 98,
          "start": 335.97,
          "end": 339.87,
          "en": "to use this AccordionItem component somewhere else outside",
          "zh": ""
        },
        {
          "id": 99,
          "start": 339.87,
          "end": 343.11,
          "en": "of such an accordion, you would see",
          "zh": ""
        },
        {
          "id": 100,
          "start": 343.11,
          "end": 346.29,
          "en": "that you get an error in your JavaScript console",
          "zh": ""
        },
        {
          "id": 101,
          "start": 346.29,
          "end": 347.79,
          "en": "in your dev tools.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 347.79,
          "end": 350.31,
          "en": "To be precise, you'll get that error,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 350.31,
          "end": 354.43,
          "en": "which we threw ourselves in that custom context hook",
          "zh": ""
        },
        {
          "id": 104,
          "start": 355.83,
          "end": 358.05,
          "en": "that this accordion-related component,",
          "zh": ""
        },
        {
          "id": 105,
          "start": 358.05,
          "end": 360.723,
          "en": "in the end, must be used inside of an accordion.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 361.8,
          "end": 364.35,
          "en": "That's why we also added this custom hook",
          "zh": ""
        },
        {
          "id": 107,
          "start": 364.35,
          "end": 366.99,
          "en": "with this extra check to make sure",
          "zh": ""
        },
        {
          "id": 108,
          "start": 366.99,
          "end": 369.69,
          "en": "that we're not accidentally using AccordionItems",
          "zh": ""
        },
        {
          "id": 109,
          "start": 369.69,
          "end": 373.773,
          "en": "that rely on being wrapped outside of the accordion.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 375.12,
          "end": 378.6,
          "en": "So with that, I'll get rid of that outside AccordionItem",
          "zh": ""
        },
        {
          "id": 111,
          "start": 378.6,
          "end": 381.51,
          "en": "and instead go back to the code we had before",
          "zh": ""
        },
        {
          "id": 112,
          "start": 381.51,
          "end": 384.9,
          "en": "now with this change here where it's much clearer",
          "zh": ""
        },
        {
          "id": 113,
          "start": 384.9,
          "end": 387.423,
          "en": "that the items belong to the accordion.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}