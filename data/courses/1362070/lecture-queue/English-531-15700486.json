  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "15700486",
      "title": "Custom Hook Store Summary",
      "sourceHash": "a4dc2e20ee9c94f22f3cc39b5f3d7895b1fd2b9a55d40834ebe0be1dbee374a4",
      "cues": [
        {
          "id": 1,
          "start": 2.12,
          "end": 3.7,
          "en": "So what we built here in the end",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.7,
          "end": 8.14,
          "en": "is our custom Redux like store implementation.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 8.14,
          "end": 11.39,
          "en": "We're having some variables which are not global,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.39,
          "end": 13.29,
          "en": "not registered on the window object",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.29,
          "end": 16.01,
          "en": "but which do exist in this file here",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.01,
          "end": 19.16,
          "en": "and they only exist once in our application lifetime.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 19.16,
          "end": 21.95,
          "en": "So they're shared in the entire application.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 21.95,
          "end": 25.21,
          "en": "Every modules or every other file",
          "zh": ""
        },
        {
          "id": 9,
          "start": 25.21,
          "end": 27.92,
          "en": "which imports from the store.js file",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.92,
          "end": 31.27,
          "en": "will use the same values which are stored here.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 31.27,
          "end": 34.41,
          "en": "Then in the same file we create our own custom hook.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 34.41,
          "end": 37.25,
          "en": "These variables are defined outside of the hook though",
          "zh": ""
        },
        {
          "id": 13,
          "start": 37.25,
          "end": 38.44,
          "en": "and that's an important thing",
          "zh": ""
        },
        {
          "id": 14,
          "start": 38.44,
          "end": 41.22,
          "en": "because if they were defined inside of the hook",
          "zh": ""
        },
        {
          "id": 15,
          "start": 41.22,
          "end": 43.3,
          "en": "then every component that used",
          "zh": ""
        },
        {
          "id": 16,
          "start": 43.3,
          "end": 46.07,
          "en": "this hook would use its own values.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 46.07,
          "end": 48.31,
          "en": "Since they're defined outside of the hook,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 48.31,
          "end": 50.35,
          "en": "every component that uses our custom hook",
          "zh": ""
        },
        {
          "id": 19,
          "start": 50.35,
          "end": 51.92,
          "en": "uses the same values.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 51.92,
          "end": 55.21,
          "en": "So now we're not just sharing the hook logic",
          "zh": ""
        },
        {
          "id": 21,
          "start": 55.21,
          "end": 58.06,
          "en": "but also some shared data",
          "zh": ""
        },
        {
          "id": 22,
          "start": 58.06,
          "end": 59.83,
          "en": "and sometimes you don't want this,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 59.83,
          "end": 62.7,
          "en": "here we absolutely do want this",
          "zh": ""
        },
        {
          "id": 24,
          "start": 62.7,
          "end": 67.48,
          "en": "because this allows us to globally manage some state,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 67.48,
          "end": 70.01,
          "en": "some actions and listeners,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 70.01,
          "end": 71.9,
          "en": "which are interested in state changes",
          "zh": ""
        },
        {
          "id": 27,
          "start": 71.9,
          "end": 74.41,
          "en": "which in turn are triggered by actions.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 74.41,
          "end": 77.28999999999999,
          "en": "In our useStore hook we're managing all of that.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 77.28999999999999,
          "end": 79.34,
          "en": "We're having our dispatch function in there",
          "zh": ""
        },
        {
          "id": 30,
          "start": 79.34,
          "end": 82.87,
          "en": "which makes sure that whenever we call this patch",
          "zh": ""
        },
        {
          "id": 31,
          "start": 82.87,
          "end": 86.78999999999999,
          "en": "we update our globalState and we call our listeners,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 86.78999999999999,
          "end": 90.14,
          "en": "where our listeners are in the end just setState calls",
          "zh": ""
        },
        {
          "id": 33,
          "start": 90.14,
          "end": 93.7,
          "en": "where we abuse, in quotes because it's not really a hack,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 93.7,
          "end": 96.34,
          "en": "but we're simply using that feature",
          "zh": ""
        },
        {
          "id": 35,
          "start": 96.34,
          "end": 99.39,
          "en": "that when you call that state updating",
          "zh": ""
        },
        {
          "id": 36,
          "start": 99.39,
          "end": 101.437,
          "en": "function useState gives you,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 101.437,
          "end": 104.85300000000001,
          "en": "any component that uses this hook will re-render.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 105.83,
          "end": 107.08,
          "en": "That's what we want here.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 108.27000000000001,
          "end": 110.16,
          "en": "We're register one listener per",
          "zh": ""
        },
        {
          "id": 40,
          "start": 110.16,
          "end": 112.06,
          "en": "component with the help of useEffect",
          "zh": ""
        },
        {
          "id": 41,
          "start": 112.06,
          "end": 114.89,
          "en": "and we un-register it when that component is destroyed",
          "zh": ""
        },
        {
          "id": 42,
          "start": 117.08,
          "end": 120.06,
          "en": "and we then also have a way of initializing",
          "zh": ""
        },
        {
          "id": 43,
          "start": 120.06,
          "end": 122.67,
          "en": "our store which you can call multiple times",
          "zh": ""
        },
        {
          "id": 44,
          "start": 122.67,
          "end": 124.81,
          "en": "because we're not replacing our globalState",
          "zh": ""
        },
        {
          "id": 45,
          "start": 124.81,
          "end": 127.16,
          "en": "or replacing our actions instead we're always",
          "zh": ""
        },
        {
          "id": 46,
          "start": 127.16,
          "end": 129.49,
          "en": "taking the current globalState and the current",
          "zh": ""
        },
        {
          "id": 47,
          "start": 129.49,
          "end": 132.65,
          "en": "actions map to merge in new data.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 132.65,
          "end": 134.22,
          "en": "We're doing this so that you can",
          "zh": ""
        },
        {
          "id": 49,
          "start": 134.22,
          "end": 137.36,
          "en": "create concurrent store and slices,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 137.36,
          "end": 140.57999999999998,
          "en": "just as we're doing it with Redux with multiple reducers,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 140.57999999999998,
          "end": 143.01,
          "en": "where is one slice you manage your products,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 143.01,
          "end": 144.77,
          "en": "maybe in another slice you manage",
          "zh": ""
        },
        {
          "id": 53,
          "start": 144.77,
          "end": 146.98,
          "en": "the user authentication status.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 146.98,
          "end": 148.15,
          "en": "Of course you have to make sure",
          "zh": ""
        },
        {
          "id": 55,
          "start": 148.15,
          "end": 150.85,
          "en": "you avoid name clashes but that's all.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 150.85,
          "end": 153.38,
          "en": "So here I'm then setting up some actions for example,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 153.38,
          "end": 155.14,
          "en": "one action of course only here",
          "zh": ""
        },
        {
          "id": 58,
          "start": 155.14,
          "end": 159.18,
          "en": "and then we call initStore to pass our actions here",
          "zh": ""
        },
        {
          "id": 59,
          "start": 159.18,
          "end": 163.15,
          "en": "and our initial state for this slice of the globalState.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 163.15,
          "end": 165.44,
          "en": "So that will be merged in our globalState",
          "zh": ""
        },
        {
          "id": 61,
          "start": 165.44,
          "end": 167.72,
          "en": "and in our global actions map",
          "zh": ""
        },
        {
          "id": 62,
          "start": 167.72,
          "end": 172.66,
          "en": "and then from anywhere in our project we can use that store",
          "zh": ""
        },
        {
          "id": 63,
          "start": 172.66,
          "end": 175.29,
          "en": "and then either tap into or state",
          "zh": ""
        },
        {
          "id": 64,
          "start": 175.29,
          "end": 178.21699999999998,
          "en": "or use the dispatch function to dispatch an action.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 178.21699999999998,
          "end": 180.03,
          "en": "That's the idea here.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 180.03,
          "end": 182.5,
          "en": "That's roughly, kind of all the idea",
          "zh": ""
        },
        {
          "id": 67,
          "start": 182.5,
          "end": 183.93,
          "en": "how Redux works behind the scenes",
          "zh": ""
        },
        {
          "id": 68,
          "start": 183.93,
          "end": 187.36,
          "en": "but now we rebuilt it totally without Redux",
          "zh": ""
        },
        {
          "id": 69,
          "start": 187.36,
          "end": 189.37,
          "en": "saving that extra dependency",
          "zh": ""
        },
        {
          "id": 70,
          "start": 189.37,
          "end": 191.343,
          "en": "and using react and hooks only.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}