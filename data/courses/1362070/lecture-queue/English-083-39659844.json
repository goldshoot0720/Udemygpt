{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "39659844",
      "title": "Why Immutability Matters - Always!",
      "sourceHash": "c609d08f60082d4aed33a23b36207aff907116a14ca188e57b8821582acec26c",
      "cues": [
        {
          "id": 1,
          "start": 0.63,
          "end": 2.82,
          "en": "So we're almost done, but it would be nice",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.82,
          "end": 5.2,
          "en": "if this rematch button would restart the game",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.15,
          "end": 9.96,
          "en": "and that's thankfully pretty easy to achieve.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.96,
          "end": 11.64,
          "en": "Now, we got the button in there",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.64,
          "end": 14.313,
          "en": "but what does it mean to restart the game?",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.66,
          "end": 17.01,
          "en": "Well, in the end,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.01,
          "end": 21.42,
          "en": "our game is controlled by this gameTurns state.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 21.42,
          "end": 26.31,
          "en": "That's our single source of truth for this entire game.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 26.31,
          "end": 28.14,
          "en": "It's this gameTurns State",
          "zh": ""
        },
        {
          "id": 10,
          "start": 28.14,
          "end": 30.54,
          "en": "which we use to derive the gameBoard.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 30.54,
          "end": 33.93,
          "en": "It's this state which we use to derive the activePlayer",
          "zh": ""
        },
        {
          "id": 12,
          "start": 33.93,
          "end": 37.503,
          "en": "and it's this state which we use to check for a winner.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 38.91,
          "end": 41.91,
          "en": "So this is our single source of truth.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 41.91,
          "end": 45.51,
          "en": "And therefore, restarting the game simply means",
          "zh": ""
        },
        {
          "id": 15,
          "start": 45.51,
          "end": 49.11,
          "en": "that we should reset gameTurns to an empty array",
          "zh": ""
        },
        {
          "id": 16,
          "start": 49.11,
          "end": 52.95,
          "en": "that we should clear this log, so to say,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 52.95,
          "end": 56.16,
          "en": "and all the rest will automatically adjust",
          "zh": ""
        },
        {
          "id": 18,
          "start": 56.16,
          "end": 60.573,
          "en": "since we're deriving all the other data from this state.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 62.04,
          "end": 63.69,
          "en": "So therefore, all we have to do",
          "zh": ""
        },
        {
          "id": 20,
          "start": 63.69,
          "end": 68.69,
          "en": "in the App component is add a new function, handleRematch,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 70.41,
          "end": 75.36,
          "en": "for example, or handleRestart to be a bit clearer.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 75.36,
          "end": 78.57,
          "en": "And in there, I'll set gameTurns",
          "zh": ""
        },
        {
          "id": 23,
          "start": 78.57,
          "end": 80.94,
          "en": "to an empty array like this.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 80.94,
          "end": 81.873,
          "en": "That's all.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 83.4,
          "end": 84.93,
          "en": "Now we just need to make sure",
          "zh": ""
        },
        {
          "id": 26,
          "start": 84.93,
          "end": 86.88,
          "en": "that this function is triggered",
          "zh": ""
        },
        {
          "id": 27,
          "start": 86.88,
          "end": 89.163,
          "en": "from inside the GameOver component.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 90.15,
          "end": 92.00999999999999,
          "en": "So from this button",
          "zh": ""
        },
        {
          "id": 29,
          "start": 92.00999999999999,
          "end": 94.28999999999999,
          "en": "and therefore, in the GameOver component,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 94.28999999999999,
          "end": 97.173,
          "en": "we can accept a prop that could be named onRestart.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 99.36,
          "end": 102.84,
          "en": "And we wanna set this as a value for the onClick prop",
          "zh": ""
        },
        {
          "id": 32,
          "start": 102.84,
          "end": 107.84,
          "en": "on this button so that again, we pass a function",
          "zh": ""
        },
        {
          "id": 33,
          "start": 107.91,
          "end": 110.78999999999999,
          "en": "from outside this component to this button",
          "zh": ""
        },
        {
          "id": 34,
          "start": 110.78999999999999,
          "end": 113.88300000000001,
          "en": "as we did it many times before in this project.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 115.28999999999999,
          "end": 119.16,
          "en": "And now in the App component, we wanna use handleRestart",
          "zh": ""
        },
        {
          "id": 36,
          "start": 119.16,
          "end": 124.16,
          "en": "as a value for the onRestart prop we just used",
          "zh": ""
        },
        {
          "id": 37,
          "start": 125.07,
          "end": 128.043,
          "en": "and added in the GameOver component like this.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 129.75,
          "end": 131.28,
          "en": "And that should be all.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 131.28,
          "end": 135.42,
          "en": "That's all you have to do because we're deriving everything",
          "zh": ""
        },
        {
          "id": 40,
          "start": 135.42,
          "end": 136.983,
          "en": "from this state.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 138.15,
          "end": 143.01,
          "en": "So with that, if I reload and I win and I click rematch,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 143.01,
          "end": 146.97,
          "en": "it kind of looks as if it worked",
          "zh": ""
        },
        {
          "id": 43,
          "start": 146.97,
          "end": 150.03,
          "en": "because that player selection changed,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 150.03,
          "end": 151.92000000000002,
          "en": "but the Game Over screen is still there",
          "zh": ""
        },
        {
          "id": 45,
          "start": 151.92000000000002,
          "end": 155.46,
          "en": "and the game board did not adjust.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 155.46,
          "end": 158.88,
          "en": "And this is the case because we got a bug in this game.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 158.88,
          "end": 162.25,
          "en": "And indeed, it is a bug that can be hard to catch",
          "zh": ""
        },
        {
          "id": 48,
          "start": 163.595,
          "end": 165.42000000000002,
          "en": "but it is a bug that's related",
          "zh": ""
        },
        {
          "id": 49,
          "start": 165.42000000000002,
          "end": 168.393,
          "en": "to how we're updating our gameBoard.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 169.62,
          "end": 172.98,
          "en": "Now, we are deriving the gameBoards dynamically here based",
          "zh": ""
        },
        {
          "id": 51,
          "start": 172.98,
          "end": 174.213,
          "en": "on our gameTurns.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 175.23,
          "end": 176.94,
          "en": "But take a look at this line.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 176.94,
          "end": 179.673,
          "en": "What are we doing in this line here?",
          "zh": ""
        },
        {
          "id": 54,
          "start": 181.11,
          "end": 184.17,
          "en": "Well, we're overriding some inner element",
          "zh": ""
        },
        {
          "id": 55,
          "start": 184.17,
          "end": 186.81,
          "en": "in a nested array in another array",
          "zh": ""
        },
        {
          "id": 56,
          "start": 186.81,
          "end": 190.173,
          "en": "with the symbol of a player that took a certain turn.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 191.37,
          "end": 194.37,
          "en": "The problem is that the gameBoard",
          "zh": ""
        },
        {
          "id": 58,
          "start": 194.37,
          "end": 197.01,
          "en": "where we're overriding this value",
          "zh": ""
        },
        {
          "id": 59,
          "start": 197.01,
          "end": 199.92000000000002,
          "en": "or where we're setting this value is based",
          "zh": ""
        },
        {
          "id": 60,
          "start": 199.92000000000002,
          "end": 201.09,
          "en": "on this initialGameBoard",
          "zh": ""
        },
        {
          "id": 61,
          "start": 202.02,
          "end": 204.69,
          "en": "and that's an array full of arrays.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 204.69,
          "end": 207.93,
          "en": "Now, as I mentioned earlier in this section,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 207.93,
          "end": 212.22,
          "en": "arrays, like objects in JavaScript, are reference values",
          "zh": ""
        },
        {
          "id": 64,
          "start": 212.22,
          "end": 214.65,
          "en": "and that means that they're stored in memory.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 214.65,
          "end": 216.42000000000002,
          "en": "And if we're then using them,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 216.42000000000002,
          "end": 219.06,
          "en": "even if they're stored in different variables,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 219.06,
          "end": 223.653,
          "en": "we're always editing that same object or array in memory.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 224.52,
          "end": 228.63,
          "en": "And therefore, when I set a certain row-column combination",
          "zh": ""
        },
        {
          "id": 69,
          "start": 228.63,
          "end": 230.4,
          "en": "to the player symbol here,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 230.4,
          "end": 234.09300000000002,
          "en": "I'm doing that in that original array in memory.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 235.17000000000002,
          "end": 238.68,
          "en": "Therefore, after restarting the game,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 238.68,
          "end": 242.61,
          "en": "this array here is not reset,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 242.61,
          "end": 246.09,
          "en": "it's still this edited old array.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 246.09,
          "end": 249.21,
          "en": "So now we kind of decoupled the gameBoard",
          "zh": ""
        },
        {
          "id": 75,
          "start": 249.21,
          "end": 253.473,
          "en": "from our gameTurns because of how we update this here.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 254.55,
          "end": 257.7,
          "en": "Now, the solution thankfully is simple.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 257.7,
          "end": 259.86,
          "en": "We just need to create a copy",
          "zh": ""
        },
        {
          "id": 78,
          "start": 259.86,
          "end": 263.91,
          "en": "of the initialGameBoard here and it must be a deep copy.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 263.91,
          "end": 266.64,
          "en": "So not just the outer array",
          "zh": ""
        },
        {
          "id": 80,
          "start": 266.64,
          "end": 270.27,
          "en": "but we also need to copy all the inner arrays.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 270.27,
          "end": 271.65,
          "en": "And we can do this",
          "zh": ""
        },
        {
          "id": 82,
          "start": 271.65,
          "end": 275.64,
          "en": "in a way I already showed you before by calling map here",
          "zh": ""
        },
        {
          "id": 83,
          "start": 275.64,
          "end": 277.98,
          "en": "and then going through all the inner arrays.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 277.98,
          "end": 281.64,
          "en": "And for every inner array, we create such a copy,",
          "zh": ""
        },
        {
          "id": 85,
          "start": 281.64,
          "end": 286.053,
          "en": "which contains the existing array elements spread into it.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 287.90999999999997,
          "end": 289.44,
          "en": "With this, we make sure",
          "zh": ""
        },
        {
          "id": 87,
          "start": 289.44,
          "end": 294.42,
          "en": "that we added a brand new array when we derive the gameBoard",
          "zh": ""
        },
        {
          "id": 88,
          "start": 294.42,
          "end": 298.263,
          "en": "and not that original initial array in memory.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 299.67,
          "end": 301.02,
          "en": "And therefore, now with this,",
          "zh": ""
        },
        {
          "id": 90,
          "start": 301.02,
          "end": 306.02,
          "en": "if we save this and reload here, if I now win like this,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 309.51,
          "end": 311.91,
          "en": "if I click rematch, now this works.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 311.91,
          "end": 315.99,
          "en": "Now we can restart and win again.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 315.99,
          "end": 318.48,
          "en": "And you see that the log also is cleared",
          "zh": ""
        },
        {
          "id": 94,
          "start": 318.48,
          "end": 320.34,
          "en": "if we click rematch.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 320.34,
          "end": 322.59,
          "en": "We also got no error in the console.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 322.59,
          "end": 326.553,
          "en": "And with that, we can now finally restart the game.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}