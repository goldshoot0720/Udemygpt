  "lectures": [
    {
      "id": "35734008",
      "title": "Dynamic Routes & loader()s",
      "sourceHash": "35967722b82530a654d3423b4d3a315ebded74b05775cc2a93421c7995d746c4",
      "cues": [
        {
          "id": 1,
          "start": 2.13,
          "end": 3.45,
          "en": "Okay, let's proceed",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.45,
          "end": 5.67,
          "en": "with this demo website here.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.67,
          "end": 7.35,
          "en": "We got our list of events.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 7.35,
          "end": 11.31,
          "en": "Now if we click on an event, we might wanna load the data",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.31,
          "end": 13.71,
          "en": "for that event, and we wanna make sure",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.71,
          "end": 16.113,
          "en": "that we go to a valid page to begin with.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.25,
          "end": 22.02,
          "en": "Now, we wanna navigate to this event detail page.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.02,
          "end": 25.38,
          "en": "For that, I'll start by going to events list,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 25.38,
          "end": 29.37,
          "en": "and there we first of all wanna convert this anchor element",
          "zh": ""
        },
        {
          "id": 10,
          "start": 29.37,
          "end": 30.9,
          "en": "to a link,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 30.9,
          "end": 35.9,
          "en": "and import link from react-router-dom, of course,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 40.77,
          "end": 43.77,
          "en": "and also convert the closing tack to a link.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 43.77,
          "end": 46.44,
          "en": "And then here, we wanna add a path, of course.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 46.44,
          "end": 50.373,
          "en": "And we wanna make sure that we go to that event ID.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 51.9,
          "end": 55.08,
          "en": "So here I have a relative path relative to the path",
          "zh": ""
        },
        {
          "id": 16,
          "start": 55.08,
          "end": 57.36,
          "en": "of the currently active route.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 57.36,
          "end": 60.24,
          "en": "And that means if we take a look at App.js again,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 60.24,
          "end": 62.49,
          "en": "that if we are on the events page,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 62.49,
          "end": 64.86,
          "en": "and we append the event ID at the end,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 64.86,
          "end": 66.9,
          "en": "we go to this event detail page,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 66.9,
          "end": 70.14,
          "en": "because that route is a child route of this events route.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 70.14,
          "end": 72.93,
          "en": "So this event ID is appended",
          "zh": ""
        },
        {
          "id": 23,
          "start": 72.93,
          "end": 76.56,
          "en": "to this events path, here, in our route definitions.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 76.56,
          "end": 78.99,
          "en": "So we will go to the event detail page",
          "zh": ""
        },
        {
          "id": 25,
          "start": 78.99,
          "end": 82.8,
          "en": "if we set up our links like this and we append the event ID",
          "zh": ""
        },
        {
          "id": 26,
          "start": 82.8,
          "end": 84.51,
          "en": "to the currently active path",
          "zh": ""
        },
        {
          "id": 27,
          "start": 84.51,
          "end": 86.703,
          "en": "when this events list is being rendered.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 88.17,
          "end": 91.38,
          "en": "So that should work with that change made.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 91.38,
          "end": 92.75999999999999,
          "en": "If we click on such an event,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 92.75999999999999,
          "end": 94.713,
          "en": "we go to the event detail page.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 95.75999999999999,
          "end": 97.97999999999999,
          "en": "Now on this event detail page here,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 97.97999999999999,
          "end": 100.92,
          "en": "I want to output the event item here.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 100.92,
          "end": 103.35,
          "en": "A component which I predefined for you,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 103.35,
          "end": 105.60300000000001,
          "en": "and for which I already added some styling.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 106.56,
          "end": 108.18,
          "en": "So in event detail,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 108.18,
          "end": 111.03,
          "en": "instead of showing this dummy content here,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 111.03,
          "end": 113.94,
          "en": "we want to output the event item component.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 113.94,
          "end": 116.28,
          "en": "And here we must set the event prop",
          "zh": ""
        },
        {
          "id": 39,
          "start": 116.28,
          "end": 118.8,
          "en": "and pass the event data for the event",
          "zh": ""
        },
        {
          "id": 40,
          "start": 118.8,
          "end": 122.823,
          "en": "for which we wanna view the details to this event prop.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 123.78,
          "end": 124.8,
          "en": "And that of course means",
          "zh": ""
        },
        {
          "id": 42,
          "start": 124.8,
          "end": 128.133,
          "en": "that we need to load the event details as a first step.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 129.21,
          "end": 130.8,
          "en": "Now, we could do this here",
          "zh": ""
        },
        {
          "id": 44,
          "start": 130.8,
          "end": 133.17,
          "en": "in the component by using the params",
          "zh": ""
        },
        {
          "id": 45,
          "start": 133.17,
          "end": 136.07999999999998,
          "en": "and using useEffect to send the HTTP request,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 136.07999999999998,
          "end": 138.39,
          "en": "but I won't do this here.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 138.39,
          "end": 141.87,
          "en": "Instead, I will add another loader function here",
          "zh": ""
        },
        {
          "id": 48,
          "start": 141.87,
          "end": 143.76,
          "en": "and export it.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 143.76,
          "end": 148.17000000000002,
          "en": "Now this time, a loader function for my event details.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 148.17000000000002,
          "end": 152.04,
          "en": "So I export this, I will convert it to an async function",
          "zh": ""
        },
        {
          "id": 51,
          "start": 152.04,
          "end": 155.553,
          "en": "because I want to use the await keyword in here.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 156.42000000000002,
          "end": 160.02,
          "en": "And now to fetch the data for a single event,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 160.02,
          "end": 164.64,
          "en": "we can use the built in fetch function and send a request",
          "zh": ""
        },
        {
          "id": 54,
          "start": 164.64,
          "end": 168.03,
          "en": "to our dummy backend API server, which we can reach",
          "zh": ""
        },
        {
          "id": 55,
          "start": 168.03,
          "end": 173.03,
          "en": "under HTTP, local host 80 80, and then slash events.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 173.19,
          "end": 178.19,
          "en": "And then the ID of the event for which we wanna load data.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 178.92000000000002,
          "end": 182.28,
          "en": "But how do we get that ID here in the loader?",
          "zh": ""
        },
        {
          "id": 58,
          "start": 182.28,
          "end": 186.24,
          "en": "In the event detail page, we could use the use params hook,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 186.24,
          "end": 188.01,
          "en": "but we can't use this in the loader.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 188.01,
          "end": 191.73,
          "en": "As mentioned before, hooks can't be accessed there.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 191.73,
          "end": 193.23,
          "en": "But you still can get access",
          "zh": ""
        },
        {
          "id": 62,
          "start": 193.23,
          "end": 198.23,
          "en": "to the route parameters that you need because react router,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 198.39,
          "end": 200.94,
          "en": "which calls this loader function for you,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 200.94,
          "end": 203.19,
          "en": "actually passes an object",
          "zh": ""
        },
        {
          "id": 65,
          "start": 203.19,
          "end": 206.52,
          "en": "to this loader function when executing it for you.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 206.52,
          "end": 211.13,
          "en": "And that object contains two important pieces of data:",
          "zh": ""
        },
        {
          "id": 67,
          "start": 211.13,
          "end": 213,
          "en": "A request property,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 213,
          "end": 216.84,
          "en": "which contains a request object, and a params property,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 216.84,
          "end": 220.89,
          "en": "which contains an object with all your route parameters.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 220.89,
          "end": 222.9,
          "en": "Now the request object here",
          "zh": ""
        },
        {
          "id": 71,
          "start": 222.9,
          "end": 227.22,
          "en": "in a loader could be used to access the URL to, for example,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 227.22,
          "end": 230.07,
          "en": "extract query parameters or anything like that.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 230.07,
          "end": 231.453,
          "en": "But here we don't need it.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 232.5,
          "end": 234.09,
          "en": "Instead it's the params object,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 234.09,
          "end": 236.16,
          "en": "which is interesting for us here.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 236.16,
          "end": 237.99,
          "en": "Because with that, we can get access",
          "zh": ""
        },
        {
          "id": 77,
          "start": 237.99,
          "end": 240.45,
          "en": "to all the route parameter values",
          "zh": ""
        },
        {
          "id": 78,
          "start": 240.45,
          "end": 243.62,
          "en": "as we could do it with help of use params.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 243.62,
          "end": 247.77,
          "en": "So here, we have the event ID route parameter.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 247.77,
          "end": 249.69,
          "en": "We have this dynamic segment.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 249.69,
          "end": 252.813,
          "en": "Then from here, we can access params dot event ID.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 254.04,
          "end": 258.09,
          "en": "And that gives us this ID, which we wanna add here",
          "zh": ""
        },
        {
          "id": 83,
          "start": 258.09,
          "end": 260.31,
          "en": "at the end of this URL.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 260.31,
          "end": 261.36,
          "en": "To send a request",
          "zh": ""
        },
        {
          "id": 85,
          "start": 261.36,
          "end": 265.38,
          "en": "to local host 80 80 slash events slash the ID of",
          "zh": ""
        },
        {
          "id": 86,
          "start": 265.38,
          "end": 268.173,
          "en": "the event for which we wanna fetch the details.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 270,
          "end": 275,
          "en": "We then get a response by awaiting this fetch call here.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 276.54,
          "end": 279.63,
          "en": "And now we could again return this response here",
          "zh": ""
        },
        {
          "id": 89,
          "start": 279.63,
          "end": 280.89,
          "en": "as we learned before.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 280.89,
          "end": 284.49,
          "en": "We can return such a response object in our loader.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 284.49,
          "end": 285.72,
          "en": "And if that's all we want to do,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 285.72,
          "end": 289.02,
          "en": "we could, therefore, even return it like this.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 289.02,
          "end": 289.92,
          "en": "And, as mentioned,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 289.92,
          "end": 293.01,
          "en": "react router would automatically wait for the promise",
          "zh": ""
        },
        {
          "id": 95,
          "start": 293.01,
          "end": 296.193,
          "en": "and give us access to the data to which it resolves.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 297.45,
          "end": 301.74,
          "en": "Here, however, I will, first of all, await this",
          "zh": ""
        },
        {
          "id": 97,
          "start": 301.74,
          "end": 305.37,
          "en": "because I still want to check if not response okay.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 305.37,
          "end": 309.01,
          "en": "So if we have a 400-ish or 500-ish error code",
          "zh": ""
        },
        {
          "id": 99,
          "start": 309.9,
          "end": 311.55,
          "en": "And only if that's not the case,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 311.55,
          "end": 313.83,
          "en": "so if we have a successful response,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 313.83,
          "end": 316.383,
          "en": "only in that case I wanna return the response.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 317.25,
          "end": 319.11,
          "en": "Otherwise, just as before,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 319.11,
          "end": 323.76,
          "en": "I wanna throw an error by using the builtin JSON function,",
          "zh": ""
        },
        {
          "id": 104,
          "start": 323.76,
          "end": 326.52,
          "en": "which is provided by react router.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 326.52,
          "end": 329.467,
          "en": "And I will throw an error response where I say,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 329.467,
          "end": 334.467,
          "en": "\"Could not fetch details for selected event.\"",
          "zh": ""
        },
        {
          "id": 107,
          "start": 335.34000000000003,
          "end": 338.43,
          "en": "And I will add this metadata object here",
          "zh": ""
        },
        {
          "id": 108,
          "start": 338.43,
          "end": 340.653,
          "en": "and set the status to 500 again.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 341.82,
          "end": 345.472,
          "en": "Now, you could have more granular error handling,",
          "zh": ""
        },
        {
          "id": 110,
          "start": 345.472,
          "end": 348.72,
          "en": "but that's good enough for this demo.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 348.72,
          "end": 351.03,
          "en": "So with that, we added the loader code.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 351.03,
          "end": 354.99,
          "en": "Now we must register the loader in our route definitions.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 354.99,
          "end": 356.85,
          "en": "And that's super easy to forget,",
          "zh": ""
        },
        {
          "id": 114,
          "start": 356.85,
          "end": 358.56,
          "en": "but it's super important.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 358.56,
          "end": 360.75,
          "en": "Just adding a loader function",
          "zh": ""
        },
        {
          "id": 116,
          "start": 360.75,
          "end": 365.19,
          "en": "to your component file like this won't do anything.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 365.19,
          "end": 368.64300000000003,
          "en": "React router will not look for loaders automatically.",
          "zh": ""
        },
        {
          "id": 118,
          "start": 369.48,
          "end": 371.7,
          "en": "Instead, you have to register it here",
          "zh": ""
        },
        {
          "id": 119,
          "start": 371.7,
          "end": 373.413,
          "en": "when defining your routes.",
          "zh": ""
        },
        {
          "id": 120,
          "start": 374.52,
          "end": 376.56,
          "en": "We have to add the loader property",
          "zh": ""
        },
        {
          "id": 121,
          "start": 376.56,
          "end": 379.17,
          "en": "to the event detail page route,",
          "zh": ""
        },
        {
          "id": 122,
          "start": 379.17,
          "end": 383.61,
          "en": "and then import the loader here from event detail.",
          "zh": ""
        },
        {
          "id": 123,
          "start": 383.61,
          "end": 385.65,
          "en": "And I will again give it an alias,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 385.65,
          "end": 388.35,
          "en": "so that we don't have any name clashes.",
          "zh": ""
        },
        {
          "id": 125,
          "start": 388.35,
          "end": 392.373,
          "en": "And here it's the \"eventDetailLoader,\" like that.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 393.75,
          "end": 397.05,
          "en": "And that is then set as a value",
          "zh": ""
        },
        {
          "id": 127,
          "start": 397.05,
          "end": 400.473,
          "en": "for the loader property of this route definition.",
          "zh": ""
        },
        {
          "id": 128,
          "start": 401.88,
          "end": 404.04,
          "en": "With that, the loader will now be called",
          "zh": ""
        },
        {
          "id": 129,
          "start": 404.04,
          "end": 407.37,
          "en": "whenever we try to visit this event detail page,",
          "zh": ""
        },
        {
          "id": 130,
          "start": 407.37,
          "end": 408.39,
          "en": "and therefore here,",
          "zh": ""
        },
        {
          "id": 131,
          "start": 408.39,
          "end": 411.96,
          "en": "we can now use the use loader data hook to get hold",
          "zh": ""
        },
        {
          "id": 132,
          "start": 411.96,
          "end": 413.58,
          "en": "of that data.",
          "zh": ""
        },
        {
          "id": 133,
          "start": 413.58,
          "end": 415.863,
          "en": "So, of that event detail data.",
          "zh": ""
        },
        {
          "id": 134,
          "start": 416.88,
          "end": 420.09,
          "en": "And with that, we can then use this data object",
          "zh": ""
        },
