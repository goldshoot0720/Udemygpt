        },
        {
          "id": 107,
          "start": 350,
          "end": 354.65999999999997,
          "en": "So onAddTodo should now be added as a prop here,",
          "zh": ""
        },
        {
          "id": 108,
          "start": 354.65999999999997,
          "end": 356.67,
          "en": "and the value for that,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 356.67,
          "end": 359.02,
          "en": "that should now be such a function,",
