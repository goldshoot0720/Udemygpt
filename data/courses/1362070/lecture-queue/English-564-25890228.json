        },
        {
          "id": 93,
          "start": 304.24,
          "end": 306.58,
          "en": "which should be of type string.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 306.58,
          "end": 310.53,
          "en": "Now all the errors are gone because now I'm making it clear",
          "zh": ""
        },
        {
          "id": 95,
          "start": 310.53,
          "end": 313.71,
          "en": "that onAddTodo will be a function,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 313.71,
          "end": 315.9,
          "en": "and that's a function that returns nothing",
