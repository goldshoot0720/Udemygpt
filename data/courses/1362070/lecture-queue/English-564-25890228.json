          "id": 78,
          "start": 259.59,
          "end": 262.7,
          "en": "that gets and argument, a parameter,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 262.7,
          "end": 265.05,
          "en": "because I'm passing argument down there",
          "zh": ""
        },
        {
          "id": 80,
          "start": 265.05,
          "end": 266.823,
          "en": "when I'm calling this function.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 267.93,
          "end": 270.61,
          "en": "Currently we're saying, that onAddTodo",
