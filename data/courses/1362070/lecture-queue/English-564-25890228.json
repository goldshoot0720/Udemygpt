        },
        {
          "id": 131,
          "start": 421.69,
          "end": 424.143,
          "en": "we have to make sure that this shape is correct.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 426.38,
          "end": 429.13,
          "en": "Here it is correct so now we can pass a pointer",
          "zh": ""
        },
        {
          "id": 133,
          "start": 429.13,
          "end": 430.89,
          "en": "at addTodoHandler to newTodo.",
          "zh": ""
        },
        {
          "id": 134,
