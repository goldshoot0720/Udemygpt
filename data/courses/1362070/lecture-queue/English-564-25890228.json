        },
        {
          "id": 82,
          "start": 270.61,
          "end": 273.61,
          "en": "is a function that gets no parameters.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 273.61,
          "end": 275.58,
          "en": "That's my function type definition",
