          "zh": ""
        },
        {
          "id": 57,
          "start": 190.87,
          "end": 193.26,
          "en": "would not create an object",
          "zh": ""
        },
        {
          "id": 58,
          "start": 193.26,
          "end": 195.54,
          "en": "using this Arrow function some texts here",
          "zh": ""
        },
        {
          "id": 59,
          "start": 195.54,
          "end": 197.78,
          "en": "does not create an Arrow function.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 197.78,
          "end": 199.94,
          "en": "Instead, we're here in a part",
          "zh": ""
        },
        {
          "id": 61,
          "start": 199.94,
          "end": 201.94,
          "en": "where we want a type definition,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 201.94,
          "end": 204.5,
          "en": "and this is TypeScript's syntax",
          "zh": ""
        },
        {
          "id": 63,
          "start": 204.5,
          "end": 208.81,
          "en": "for defining the shape of a function,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 208.81,
          "end": 211.653,
          "en": "so for describing a function type.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 212.59,
          "end": 216.21,
          "en": "Here we know that onAddTodo should be of type function",
          "zh": ""
        },
        {
          "id": 66,
          "start": 216.21,
          "end": 219.363,
          "en": "so here I'm describing how this function should look like.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 220.2,
          "end": 223.6,
          "en": "Between the brackets, we would describe the parameters",
          "zh": ""
        },
        {
          "id": 68,
          "start": 223.6,
          "end": 226.69,
          "en": "this function will get and after the Arrow",
          "zh": ""
        },
        {
          "id": 69,
          "start": 226.69,
          "end": 229.883,
          "en": "we describe the return type of this function.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 231.14,
          "end": 234.43,
          "en": "Now here onAddTodo shouldn't return anything",
          "zh": ""
        },
        {
          "id": 71,
          "start": 234.43,
          "end": 236.67000000000002,
          "en": "because when we call this function,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 236.67000000000002,
          "end": 240.36,
          "en": "we're not doing anything with the return value.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 240.36,
          "end": 243.67,
          "en": "We're not storing it in a constant, we're not outputting it",
