      "title": "Deriving Computed Values From Other Computed Values",
      "sourceHash": "28cf74b7e7f94b76e7f6c902e6984aec49eacc38e0cb165ed49eb82dcc029f5c",
      "cues": [
        {
          "id": 1,
          "start": 0.63,
          "end": 2.61,
          "en": "And we can get hold of the symbol",
          "zh": ""
        },
        {
          "id": 2,
