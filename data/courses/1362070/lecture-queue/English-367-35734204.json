  "lectures": [
    {
      "id": "35734204",
      "title": "Implementing the Auth Action",
      "sourceHash": "a831888a3000d95decc6e88e782fceff6a505795012ba510a5cd51116c6fb40f",
      "cues": [
        {
          "id": 1,
          "start": 2.04,
          "end": 3.96,
          "en": "Okay, so now we can switch,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.96,
          "end": 5.73,
          "en": "with help of our routing feature here.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.73,
          "end": 6.84,
          "en": "That's nice.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 6.84,
          "end": 10.5,
          "en": "Now, let's finally focus on authentication,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.5,
          "end": 13.26,
          "en": "and let's make sure that we can authenticate.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.26,
          "end": 16.503,
          "en": "And that all starts with enabling user creation.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.55,
          "end": 20.85,
          "en": "On this dummy backend API, which I'm providing to you,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.85,
          "end": 24.363,
          "en": "there is a route which allows us to create users.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 25.38,
          "end": 27.93,
          "en": "We got this signup route here, where I,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.93,
          "end": 30.42,
          "en": "in the end, then validate the input,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 30.42,
          "end": 34.77,
          "en": "the email, and the password, and I return an error response",
          "zh": ""
        },
        {
          "id": 12,
          "start": 34.77,
          "end": 37.23,
          "en": "if invalid credentials were provided,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 37.23,
          "end": 39.66,
          "en": "if the password is too short, for example.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 39.66,
          "end": 42.603,
          "en": "It must have a middle length of six characters here.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 43.47,
          "end": 46.41,
          "en": "And if everything is valid, then I create a user,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 46.41,
          "end": 49.89,
          "en": "store it in my file here, in this events.json file,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 49.89,
          "end": 51.12,
          "en": "in the end.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 51.12,
          "end": 52.59,
          "en": "We could also use a database,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 52.59,
          "end": 55.11,
          "en": "but for this dummy back and we're using this file.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 55.11,
          "end": 56.7,
          "en": "And I create such a token,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 56.7,
          "end": 59.07,
          "en": "and send that token back to the front end.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 59.07,
          "end": 60.42,
          "en": "That's what's happening here,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 60.42,
          "end": 63.42,
          "en": "when we trigger that signup route on the backend,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 63.42,
          "end": 64.26,
          "en": "to be precise,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 64.26,
          "end": 66.93299999999999,
          "en": "when we send a post request to that signup route.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 68.1,
          "end": 70.23,
          "en": "Now on the front end, this of course means",
          "zh": ""
        },
        {
          "id": 27,
          "start": 70.23,
          "end": 72.57,
          "en": "that if this authForm is submitted,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 72.57,
          "end": 75.45,
          "en": "we want to send such a request.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 75.45,
          "end": 77.01,
          "en": "Now that authForm here,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 77.01,
          "end": 79.11,
          "en": "already uses the form component",
          "zh": ""
        },
        {
          "id": 31,
          "start": 79.11,
          "end": 80.88,
          "en": "provided by React router,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 80.88,
          "end": 83.617,
          "en": "because I want to use React's router's",
          "zh": ""
        },
        {
          "id": 33,
          "start": 83.617,
          "end": 85.388,
          "en": "data fetching and submission features",
          "zh": ""
        },
        {
          "id": 34,
          "start": 85.388,
          "end": 86.46000000000001,
          "en": "you learned about in the Routing section,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 86.46000000000001,
          "end": 89.16,
          "en": "for sending and getting data.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 89.16,
          "end": 91.92,
          "en": "In the auth, we of course must add an action",
          "zh": ""
        },
        {
          "id": 37,
          "start": 91.92,
          "end": 93.84,
          "en": "to our route here,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 93.84,
          "end": 96.93299999999999,
          "en": "an action that is triggered when this form is submitted.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 98.28,
          "end": 101.25,
          "en": "For that, I'll go to my authentication.js file,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 101.25,
          "end": 103.71000000000001,
          "en": "to this authentication page component file,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 103.71000000000001,
          "end": 108.71000000000001,
          "en": "and there, I'll export an async function called action,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 108.9,
          "end": 112.11,
          "en": "as we did it multiple times in the Routing section.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 112.11,
          "end": 113.75999999999999,
          "en": "And that action will be triggered",
          "zh": ""
        },
        {
          "id": 44,
          "start": 113.75999999999999,
          "end": 116.65,
          "en": "whenever this authForm is submitted,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 116.65,
          "end": 120.663,
          "en": "because it is on the same route as this authForm is on.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 122.58,
          "end": 125.97,
          "en": "Now in this action here, we of course must get access",
          "zh": ""
        },
        {
          "id": 47,
          "start": 125.97,
          "end": 128.67,
          "en": "to the form data that was submitted.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 128.67,
          "end": 131.52,
          "en": "And we do that with help of the request object,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 131.52,
          "end": 135.3,
          "en": "that's part of that data package that, we get as a parameter",
          "zh": ""
        },
        {
          "id": 50,
          "start": 135.3,
          "end": 139.47,
          "en": "in this action function, that is executed by React router.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 139.47,
          "end": 141.69,
          "en": "Again, if this is all brand new to you,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 141.69,
          "end": 144,
          "en": "definitely go through the Routing section first.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 144,
          "end": 146.07,
          "en": "I do explain how React router,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 146.07,
          "end": 149.193,
          "en": "and how this action feature works, in detail there.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 150.32999999999998,
          "end": 152.219,
          "en": "So now here we got this request object,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 152.219,
          "end": 157.219,
          "en": "and we now of course, want to get hold of the data",
          "zh": ""
        },
        {
          "id": 57,
          "start": 157.35,
          "end": 160.23,
          "en": "that was submitted with the form.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 160.23,
          "end": 163.713,
          "en": "And we can do that by calling request.formData,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 164.95,
          "end": 165.99,
          "en": "this method.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 165.99,
          "end": 169.26,
          "en": "And we await this, and this gives us a data object,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 169.26,
          "end": 171.001,
          "en": "which we can then use",
          "zh": ""
        },
        {
          "id": 62,
          "start": 171.001,
          "end": 174.123,
          "en": "to search for the email and the password that was entered.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 174.99,
          "end": 177.81,
          "en": "Therefore, we can construct a authData object,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 177.81,
          "end": 181.707,
          "en": "where the email is retrieved with help of dataGet('email').",
          "zh": ""
        },
        {
          "id": 65,
          "start": 182.7,
          "end": 185.37,
          "en": "This get method exists on this data object,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 185.37,
          "end": 187.26,
          "en": "that is returned by formData.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 187.26,
          "end": 188.79,
          "en": "So this gives us the email address",
          "zh": ""
        },
        {
          "id": 68,
          "start": 188.79,
          "end": 190.263,
          "en": "that was entered by the user.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 191.46,
          "end": 193.41,
          "en": "And the password can be retrieved",
          "zh": ""
        },
        {
          "id": 70,
          "start": 193.41,
          "end": 195.873,
          "en": "with data.Get('password'), like this.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 196.86,
          "end": 199.323,
          "en": "So that's how we get this data.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 200.55,
          "end": 203.79,
          "en": "Now of course, we wanna send different requests,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 203.79,
          "end": 206.1,
          "en": "based on the mode this form is in,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 206.1,
          "end": 208.877,
          "en": "if we are in login, or signup mode.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 208.877,
          "end": 211.53,
          "en": "So therefore, we also must take a look",
          "zh": ""
        },
        {
          "id": 76,
          "start": 211.53,
          "end": 214.44,
          "en": "at this query parameter, in our action,",
          "zh": ""
        },
        {
          "id": 77,
          "start": 214.44,
          "end": 217.47,
          "en": "to find out whether a signup, or login request,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 217.47,
          "end": 218.61,
          "en": "should be sent.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 218.61,
          "end": 221.712,
          "en": "Now, thankfully, it's all quite straightforward",
          "zh": ""
        },
        {
          "id": 80,
          "start": 221.712,
          "end": 222.54500000000002,
          "en": "to get hold of that,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 222.54500000000002,
          "end": 226.17000000000002,
          "en": "even though we can't use the useSearchParams here.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 226.17000000000002,
          "end": 229.233,
          "en": "That won't work, because we're not in a component here.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 230.4,
          "end": 234.66,
          "en": "But we can use the built-in URL constructor,",
          "zh": ""
        },
        {
          "id": 84,
          "start": 234.66,
          "end": 236.7,
          "en": "which is provided by the browser,",
          "zh": ""
        },
        {
          "id": 85,
          "start": 236.7,
          "end": 239.553,
          "en": "and pass our request.url to it,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 240.66,
          "end": 243.45,
          "en": "to then access the searchParams object",
          "zh": ""
        },
        {
          "id": 87,
          "start": 243.45,
          "end": 246.903,
          "en": "on that you URL object, that's instantiated here.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 247.8,
          "end": 250.92,
          "en": "So that's how we can get hold of our searchParams here,",
          "zh": ""
        },
        {
          "id": 89,
          "start": 250.92,
          "end": 254.664,
          "en": "on the backend, with some default browser features.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 254.664,
          "end": 256.65,
          "en": "And then, on that searchParams object,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 256.65,
          "end": 260.372,
          "en": "we can also call get, and extract the mode here.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 260.372,
          "end": 263.13,
          "en": "We can also say that if it's undefined,",
          "zh": ""
        },
        {
          "id": 93,
          "start": 263.13,
          "end": 265.92,
          "en": "we maybe wanna use signup as a default,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 265.92,
          "end": 267.54,
          "en": "or login, or whatever you want.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 267.54,
          "end": 269.73,
          "en": "Here I'll go for login.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 269.73,
          "end": 271.35,
          "en": "And therefore here I then have the mode,",
          "zh": ""
        },
        {
          "id": 97,
          "start": 271.35,
          "end": 274.17,
          "en": "which is either equal to login, or signup,",
          "zh": ""
        },
        {
          "id": 98,
          "start": 274.17,
          "end": 278.37,
          "en": "or in general, whichever value mode is set to.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 278.37,
          "end": 280.77,
          "en": "So now we know which mode we are in,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 280.77,
          "end": 283.14,
          "en": "and we can get the data.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 283.14,
          "end": 285.09000000000003,
          "en": "Therefore, now we have everything we need",
          "zh": ""
        },
        {
          "id": 102,
          "start": 285.09000000000003,
          "end": 287.193,
          "en": "to send a request to that backend.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 288.09000000000003,
          "end": 290.55,
          "en": "And I'll do this with my fetch function again,",
          "zh": ""
        },
        {
          "id": 104,
          "start": 290.55,
          "end": 293.49,
          "en": "with the browser's default fetch function.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 293.49,
          "end": 297.09000000000003,
          "en": "The URL is localhost:8080.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 297.09000000000003,
          "end": 299.88,
          "en": "And then we wanna send the request",
          "zh": ""
        },
        {
          "id": 107,
          "start": 299.88,
          "end": 303.21,
          "en": "to either /signup, or /login,",
          "zh": ""
        },
        {
          "id": 108,
          "start": 303.21,
          "end": 305.37,
          "en": "based on which mode we are in,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 305.37,
          "end": 307.707,
          "en": "because /signup, and /login,",
          "zh": ""
        },
        {
          "id": 110,
          "start": 307.707,
          "end": 310.563,
          "en": "are the two routes supported by the dummy backend.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 311.82,
          "end": 315.54,
          "en": "Now conveniently, mode is login or signup.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 315.54,
          "end": 319.053,
          "en": "So we can simply append the mode here, after this URL.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 320.01,
          "end": 322.86,
          "en": "Now of course, users might deliberately enter",
          "zh": ""
        },
        {
          "id": 114,
          "start": 322.86,
          "end": 326.13,
          "en": "some unsupported mode here, like abc.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 326.13,
          "end": 327.6,
          "en": "And to defend against that,",
          "zh": ""
        },
        {
          "id": 116,
          "start": 327.6,
          "end": 331.86,
          "en": "we can simply check if mode is not equal to login,",
          "zh": ""
        },
        {
          "id": 117,
          "start": 331.86,
          "end": 336.54,
          "en": "and mode is not equal to signup, for example.",
          "zh": ""
        },
        {
          "id": 118,
          "start": 336.54,
          "end": 340.44,
          "en": "And if that's the case, we could throw a new error here.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 340.44,
          "end": 344.49,
          "en": "We could throw a new error response, to be precise,",
          "zh": ""
        },
        {
          "id": 120,
          "start": 344.49,
          "end": 349.35,
          "en": "and import the json function from react-router-dom,",
          "zh": ""
        },
        {
          "id": 121,
          "start": 349.35,
          "end": 351.45,
          "en": "as explained in the Routing section,",
          "zh": ""
        },
        {
          "id": 122,
          "start": 351.45,
          "end": 354.78,
          "en": "and then throw an error response here,",
          "zh": ""
        },
        {
          "id": 123,
          "start": 354.78,
          "end": 358.10699999999997,
          "en": "where we for example, say \"Unsupported mode,\"",
          "zh": ""
        },
        {
          "id": 124,
          "start": 359.82,
          "end": 364.82,
          "en": "and where we set the status to 422, for invalid user input.",
          "zh": ""
        },
        {
          "id": 125,
          "start": 367.05,
          "end": 368.82,
          "en": "This is one way of handling this.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 368.82,
          "end": 369.653,
          "en": "Alternatively,",
          "zh": ""
        },
        {
          "id": 127,
          "start": 369.653,
          "end": 371.94,
          "en": "we could simply set the mode to signup,",
          "zh": ""
        },
        {
          "id": 128,
          "start": 371.94,
          "end": 373.56,
          "en": "if it's an unknown value.",
          "zh": ""
        },
        {
          "id": 129,
          "start": 373.56,
          "end": 374.76,
          "en": "That is totally up to you.",
          "zh": ""
        },
        {
          "id": 130,
          "start": 374.76,
          "end": 376.923,
          "en": "Here, I will just throw this error.",
          "zh": ""
        },
        {
          "id": 131,
          "start": 378.42,
          "end": 379.95,
          "en": "Okay, so that's one thing.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 379.95,
          "end": 382.56,
          "en": "Now we're sending this request to this URL,",
          "zh": ""
        },
        {
          "id": 133,
          "start": 382.56,
          "end": 384.39,
          "en": "which incorporates that mode.",
          "zh": ""
        },
        {
          "id": 134,
          "start": 384.39,
          "end": 387.3,
