{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "25890068",
      "title": "Testing User Interaction & State",
      "sourceHash": "d63082bd0842b6d54b41e00359736cabfad4881c21cb93aadf0f196232919391",
      "cues": [
        {
          "id": 1,
          "start": 2.09,
          "end": 4.55,
          "en": "Now, this first test, which we wrote,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.55,
          "end": 8.24,
          "en": "isn't doing too much useful things.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 8.24,
          "end": 11.52,
          "en": "So let's make our component a bit more powerful",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.52,
          "end": 14.94,
          "en": "so that we can test more useful things.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 14.94,
          "end": 16.67,
          "en": "And let's say that in this component",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.67,
          "end": 19.47,
          "en": "we have some state, which should change",
          "zh": ""
        },
        {
          "id": 7,
          "start": 19.47,
          "end": 20.95,
          "en": "if a button is clicked.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.95,
          "end": 22.21,
          "en": "And if that button is clicked",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.21,
          "end": 24.32,
          "en": "some text on the screen changes,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 24.32,
          "end": 27.307,
          "en": "and we want to test whether that works correctly.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 28.29,
          "end": 30.96,
          "en": "So for this, of course, we need to import useState",
          "zh": ""
        },
        {
          "id": 12,
          "start": 31.98,
          "end": 35.02,
          "en": "from React because that is how we can manage state",
          "zh": ""
        },
        {
          "id": 13,
          "start": 35.02,
          "end": 36.98,
          "en": "and functional components.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 36.98,
          "end": 39.283,
          "en": "And then here we can call useState.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 42.961,
          "end": 45.08,
          "en": "And here, I'll just name that state",
          "zh": ""
        },
        {
          "id": 16,
          "start": 45.08,
          "end": 46.233,
          "en": "changedText and setChangedText.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 50.24,
          "end": 52.83,
          "en": "And at the beginning,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 52.83,
          "end": 55.94,
          "en": "this is false because the text has not changed.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 55.94,
          "end": 58.633,
          "en": "But if a button is clicked, the text should change.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 59.51,
          "end": 62.44,
          "en": "So here I'll have a button where I say Change Text",
          "zh": ""
        },
        {
          "id": 21,
          "start": 63.39,
          "end": 65.6,
          "en": "and upon a click on this button,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 65.6,
          "end": 67.75,
          "en": "I want to execute a function.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 67.75,
          "end": 70.02,
          "en": "So I'll add a function to this component,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 70.02,
          "end": 73.58,
          "en": "the changeTextHandler function,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 73.58,
          "end": 76.42,
          "en": "in which I'll simply call setChangedText",
          "zh": ""
        },
        {
          "id": 26,
          "start": 77.746,
          "end": 78.79599999999999,
          "en": "and set this to true.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 80.25,
          "end": 82.44,
          "en": "And it's this changeTextHandler function",
          "zh": ""
        },
        {
          "id": 28,
          "start": 82.44,
          "end": 86.22,
          "en": "which will be connected to this onClick prop here",
          "zh": ""
        },
        {
          "id": 29,
          "start": 87.17,
          "end": 90.84,
          "en": "on this button changeTextHandler.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 90.84,
          "end": 91.673,
          "en": "Like this.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 93.50999999999999,
          "end": 94.92,
          "en": "Now of course we need to do something",
          "zh": ""
        },
        {
          "id": 32,
          "start": 94.92,
          "end": 96.9,
          "en": "when that state changes.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 96.9,
          "end": 99.33,
          "en": "And therefore, I will render this paragraph",
          "zh": ""
        },
        {
          "id": 34,
          "start": 99.33,
          "end": 100.86,
          "en": "at the beginning",
          "zh": ""
        },
        {
          "id": 35,
          "start": 100.86,
          "end": 103.11,
          "en": "so we can render it conditionally and check",
          "zh": ""
        },
        {
          "id": 36,
          "start": 103.11,
          "end": 106.22999999999999,
          "en": "if changed text is false",
          "zh": ""
        },
        {
          "id": 37,
          "start": 106.22999999999999,
          "end": 107.963,
          "en": "with an exclamation mark here.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 108.8,
          "end": 110.47,
          "en": "And if that's the case,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 110.47,
          "end": 112.913,
          "en": "then I will render that.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 114.34,
          "end": 117.77000000000001,
          "en": "Otherwise, if changed text is true,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 117.77000000000001,
          "end": 120.75,
          "en": "hence no exclamation mark,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 120.75,
          "end": 124.093,
          "en": "I'll render 'Changed' here in this paragraph.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 124.95,
          "end": 127.523,
          "en": "That is some code, which we could have here.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 128.61,
          "end": 131.55,
          "en": "Now, if I save that, the component changes",
          "zh": ""
        },
        {
          "id": 45,
          "start": 131.55,
          "end": 133.74,
          "en": "but our test still passes",
          "zh": ""
        },
        {
          "id": 46,
          "start": 133.74,
          "end": 136.52,
          "en": "because the only test we have thus far",
          "zh": ""
        },
        {
          "id": 47,
          "start": 136.52,
          "end": 138.66,
          "en": "doesn't care about that change",
          "zh": ""
        },
        {
          "id": 48,
          "start": 138.66,
          "end": 140.363,
          "en": "we just made to the component.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 141.87,
          "end": 145.25,
          "en": "It just tests where 'Hello world' is still there,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 145.25,
          "end": 146.973,
          "en": "and that's definitely the case.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 148.1,
          "end": 150.82999999999998,
          "en": "But now with that new functionality,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 150.82999999999998,
          "end": 154.3,
          "en": "which we added here, I got at least two ideas",
          "zh": ""
        },
        {
          "id": 53,
          "start": 154.3,
          "end": 156.8,
          "en": "on how we could test this component now",
          "zh": ""
        },
        {
          "id": 54,
          "start": 156.8,
          "end": 160.45,
          "en": "in addition to the test which we already have.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 160.45,
          "end": 162.87,
          "en": "And do you have some ideas as well?",
          "zh": ""
        },
        {
          "id": 56,
          "start": 162.87,
          "end": 164.52,
          "en": "Think about that briefly.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 164.52,
          "end": 166.4,
          "en": "And then after a couple of seconds",
          "zh": ""
        },
        {
          "id": 58,
          "start": 166.4,
          "end": 168.453,
          "en": "I'll share my ideas with you.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 171.68,
          "end": 174.22,
          "en": "The two ideas, which I got here,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 174.22,
          "end": 179.22,
          "en": "are that we can A, test whether we see this text",
          "zh": ""
        },
        {
          "id": 61,
          "start": 179.52,
          "end": 182.4,
          "en": "if the state did not change yet.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 182.4,
          "end": 184.573,
          "en": "So if the button was not clicked.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 185.5,
          "end": 189.17,
          "en": "And if we see this other text here",
          "zh": ""
        },
        {
          "id": 64,
          "start": 189.17,
          "end": 190.963,
          "en": "if the button was clicked.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 192.51,
          "end": 193.96,
          "en": "Because that's important.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 193.96,
          "end": 195.61,
          "en": "When you write tests",
          "zh": ""
        },
        {
          "id": 67,
          "start": 195.61,
          "end": 199.42000000000002,
          "en": "you really want to test all possible scenarios.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 199.42000000000002,
          "end": 202.73,
          "en": "Because otherwise your tests are not worth that much.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 202.73,
          "end": 205.09,
          "en": "Because if you only test one scenario",
          "zh": ""
        },
        {
          "id": 70,
          "start": 205.09,
          "end": 207.07999999999998,
          "en": "then you will never notice,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 207.07999999999998,
          "end": 208.72,
          "en": "or at least not as quickly,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 208.72,
          "end": 211.69,
          "en": "if some other scenario fails because of some change.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 211.69,
          "end": 214.71,
          "en": "So you want to test all possible scenarios,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 214.71,
          "end": 217.223,
          "en": "all possible scenarios that make sense.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 218.39,
          "end": 223.39,
          "en": "So here in this case, I want to write two new tests.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 223.57999999999998,
          "end": 225.79,
          "en": "And definitely feel free to write",
          "zh": ""
        },
        {
          "id": 77,
          "start": 225.79,
          "end": 228.24,
          "en": "at least one of those tests on your own.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 228.24,
          "end": 229.91,
          "en": "The test where we test",
          "zh": ""
        },
        {
          "id": 79,
          "start": 229.91,
          "end": 231.86,
          "en": "whether we see this text",
          "zh": ""
        },
        {
          "id": 80,
          "start": 231.86,
          "end": 234.34,
          "en": "if the button was not clicked.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 234.34,
          "end": 236.24,
          "en": "Because we don't know yet how we can click",
          "zh": ""
        },
        {
          "id": 82,
          "start": 236.24,
          "end": 238.11,
          "en": "the button virtually,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 238.11,
          "end": 241.09,
          "en": "so you won't be able to write that test on your own,",
          "zh": ""
        },
        {
          "id": 84,
          "start": 241.09,
          "end": 243.46,
          "en": "but you should be able to write that other test",
          "zh": ""
        },
        {
          "id": 85,
          "start": 243.46,
          "end": 246.507,
          "en": "on your own, where you check for this paragraph.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 246.507,
          "end": 250.12,
          "en": "Here's a quick pause for you to pause the video",
          "zh": ""
        },
        {
          "id": 87,
          "start": 250.12,
          "end": 253.17,
          "en": "and try writing that first test on your own.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 253.17,
          "end": 256.183,
          "en": "Thereafter we'll write both tests together.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 260.23,
          "end": 261.61,
          "en": "Were are you successful?",
          "zh": ""
        },
        {
          "id": 90,
          "start": 261.61,
          "end": 263.06,
          "en": "Let's write that together",
          "zh": ""
        },
        {
          "id": 91,
          "start": 263.06,
          "end": 266.44,
          "en": "and let's start with that first test here.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 266.44,
          "end": 270.713,
          "en": "Here I want to test that the component renders,",
          "zh": ""
        },
        {
          "id": 93,
          "start": 271.92,
          "end": 273.8,
          "en": "and please note how this reads",
          "zh": ""
        },
        {
          "id": 94,
          "start": 273.8,
          "end": 275.38,
          "en": "like a nice sentence.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 275.38,
          "end": 278.51,
          "en": "Greeting component renders Hello World as a text.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 278.51,
          "end": 281.55,
          "en": "Greeting component renders something else.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 281.55,
          "end": 284.26,
          "en": "And that's how you typically want to name those things.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 284.26,
          "end": 285.99,
          "en": "So that tests you would name",
          "zh": ""
        },
        {
          "id": 99,
          "start": 285.99,
          "end": 288.973,
          "en": "and test name for nice sentences.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 289.92,
          "end": 293.31,
          "en": "And here, I'll then say renders",
          "zh": ""
        },
        {
          "id": 101,
          "start": 295.35,
          "end": 296.71,
          "en": "good to see you",
          "zh": ""
        },
        {
          "id": 102,
          "start": 299.78,
          "end": 303.743,
          "en": "if the button was not clicked.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 305.7,
          "end": 308.91,
          "en": "So here I'm describing what I'm testing.",
          "zh": ""
        },
        {
          "id": 104,
          "start": 308.91,
          "end": 310.92,
          "en": "And this part with the button is of course",
          "zh": ""
        },
        {
          "id": 105,
          "start": 310.92,
          "end": 313.02,
          "en": "important because we will then soon write",
          "zh": ""
        },
        {
          "id": 106,
          "start": 313.02,
          "end": 315.573,
          "en": "another test where we test the opposite.",
          "zh": ""
        },
        {
          "id": 107,
          "start": 317.1,
          "end": 320.65,
          "en": "So here we again, want to arrange, act, and assert.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 320.65,
          "end": 322.34,
          "en": "Arranging is the same as before.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 322.34,
          "end": 323.683,
          "en": "We render greeting.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 324.64,
          "end": 326.26,
          "en": "Acting as the same as before.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 326.26,
          "end": 327.55,
          "en": "We don't do anything.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 327.55,
          "end": 328.8,
          "en": "We don't click the button,",
          "zh": ""
        },
        {
          "id": 113,
          "start": 328.8,
          "end": 330.78,
          "en": "so we don't do anything.",
          "zh": ""
        },
        {
          "id": 114,
          "start": 330.78,
          "end": 333.253,
          "en": "And then asserting is also quite similar.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 334.56,
          "end": 339.56,
          "en": "Here I then want to get my paragraph element",
          "zh": ""
        },
        {
          "id": 116,
          "start": 340.24,
          "end": 343.73,
          "en": "or output element, however you want to name it.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 343.73,
          "end": 346.27,
          "en": "And I want to get it by text.",
          "zh": ""
        },
        {
          "id": 118,
          "start": 346.27,
          "end": 348.37,
          "en": "And we could again match it exactly",
          "zh": ""
        },
        {
          "id": 119,
          "start": 348.37,
          "end": 351.28,
          "en": "or just look for 'good to see you'",
          "zh": ""
        },
        {
          "id": 120,
          "start": 351.28,
          "end": 353.06,
          "en": "without matching it exactly.",
          "zh": ""
        },
        {
          "id": 121,
          "start": 353.06,
          "end": 355.513,
          "en": "And hence I'll set exact here to false.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 357.42,
          "end": 359.63,
          "en": "And then my expectation is",
          "zh": ""
        },
        {
          "id": 123,
          "start": 359.63,
          "end": 362.49,
          "en": "that this element exists in the DOM",
          "zh": ""
        },
        {
          "id": 124,
          "start": 362.49,
          "end": 365.593,
          "en": "so that I'm able to find an element with that test.",
          "zh": ""
        },
        {
          "id": 125,
          "start": 367.66,
          "end": 370.26,
          "en": "Let's remove that second test for now and save this.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 371.22,
          "end": 373.6,
          "en": "Now our tests are executed",
          "zh": ""
        },
        {
          "id": 127,
          "start": 373.6,
          "end": 378.01,
          "en": "and we see that we got two tests and both passed,",
          "zh": ""
        },
        {
          "id": 128,
          "start": 378.01,
          "end": 379.773,
          "en": "which is our expectation.",
          "zh": ""
        },
        {
          "id": 129,
          "start": 380.98,
          "end": 382.95,
          "en": "Now let's write that second test",
          "zh": ""
        },
        {
          "id": 130,
          "start": 382.95,
          "end": 385.11,
          "en": "where we want to click that button.",
          "zh": ""
        },
        {
          "id": 131,
          "start": 385.11,
          "end": 387.7,
          "en": "Here the expectation is that we render",
          "zh": ""
        },
        {
          "id": 132,
          "start": 390.21,
          "end": 392.923,
          "en": "Changed if the button was clicked.",
          "zh": ""
        },
        {
          "id": 133,
          "start": 393.92,
          "end": 396.21,
          "en": "So we render Changed",
          "zh": ""
        },
        {
          "id": 134,
          "start": 396.21,
          "end": 398.713,
          "en": "if the button was clicked.",
          "zh": ""
        },
        {
          "id": 135,
          "start": 400.515,
          "end": 402.515,
          "en": "And then here we write our testing code.",
          "zh": ""
        },
        {
          "id": 136,
          "start": 404.48,
          "end": 406.27,
          "en": "Of course you can also put that into quotes",
          "zh": ""
        },
        {
          "id": 137,
          "start": 406.27,
          "end": 407.39,
          "en": "to make it clearer",
          "zh": ""
        },
