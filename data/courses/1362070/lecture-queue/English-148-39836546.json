  "lectures": [
    {
      "id": "39836546",
      "title": "Adding \"Project Tasks\" & A Tasks Component",
      "sourceHash": "d1b79e21c52a5a699443e97807e7fdda936bd477c656c78cec9b1e1d694b6194",
      "cues": [
        {
          "id": 1,
          "start": 1.02,
          "end": 3.15,
          "en": "So now that we can create,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.15,
          "end": 5.91,
          "en": "and select, and also delete elements,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.91,
          "end": 9.06,
          "en": "the next and final step for this demo project here",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.06,
          "end": 11.193,
          "en": "is to make these tasks work.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.54,
          "end": 15.48,
          "en": "Here, when a project is selected",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.48,
          "end": 17.49,
          "en": "I want to have a list of tasks,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.49,
          "end": 19.92,
          "en": "and, of course, I want to have a input field",
          "zh": ""
        },
        {
          "id": 8,
          "start": 19.92,
          "end": 22.89,
          "en": "that allows me to add new tasks.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.89,
          "end": 24.12,
          "en": "And that's, therefore, the next",
          "zh": ""
        },
        {
          "id": 10,
          "start": 24.12,
          "end": 26.43,
          "en": "and final thing we'll work on.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 26.43,
          "end": 30.123,
          "en": "And for this, I'll start by adding a new tasks component.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 31.02,
          "end": 33.54,
          "en": "And since we're getting a lot of component files here",
          "zh": ""
        },
        {
          "id": 13,
          "start": 33.54,
          "end": 37.17,
          "en": "you could now, definitely, also consider organizing them",
          "zh": ""
        },
        {
          "id": 14,
          "start": 37.17,
          "end": 38.64,
          "en": "into sub folders,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 38.64,
          "end": 41.793,
          "en": "but here I'll keep them all in the main Components folder.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 42.96,
          "end": 45.84,
          "en": "And in this tasks JSX file",
          "zh": ""
        },
        {
          "id": 17,
          "start": 45.84,
          "end": 50.493,
          "en": "I'll export this as a functional component like this.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 51.87,
          "end": 54.423,
          "en": "Now in here, I then want to output a section.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 55.725,
          "end": 59.103,
          "en": "And in that section I wanna have a title where I say tasks.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 60.21,
          "end": 63.9,
          "en": "And below that, a new task area,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 63.9,
          "end": 65.82,
          "en": "which shows me an input field",
          "zh": ""
        },
        {
          "id": 22,
          "start": 65.82,
          "end": 68.013,
          "en": "that allows me to add new tasks.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 69.48,
          "end": 73.59,
          "en": "And then below that a list of tasks.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 73.59,
          "end": 76.2,
          "en": "Or if I don't have any tasks yet,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 76.2,
          "end": 79.62,
          "en": "a paragraph that tells me this project",
          "zh": ""
        },
        {
          "id": 26,
          "start": 79.62,
          "end": 82.863,
          "en": "does not have any tasks yet.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 83.88,
          "end": 86.91,
          "en": "But this paragraph should be shown conditionally,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 86.91,
          "end": 89.78999999999999,
          "en": "just as this list should be shown conditionally",
          "zh": ""
        },
        {
          "id": 29,
          "start": 89.78999999999999,
          "end": 91.563,
          "en": "only if we have tasks.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 93.53999999999999,
          "end": 97.65,
          "en": "Now, before we'll add this task functionality here,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 97.65,
          "end": 99.723,
          "en": "I'll start by adding some styling.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 101.43,
          "end": 104.4,
          "en": "And for that I'll start with this h2 element,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 104.4,
          "end": 108.93,
          "en": "which I'll give text 2xl clause",
          "zh": ""
        },
        {
          "id": 34,
          "start": 108.93,
          "end": 110.67,
          "en": "to make the text a bit bigger,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 110.67,
          "end": 115.38,
          "en": "a font bold clause, and then text stone 700,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 115.38,
          "end": 117.003,
          "en": "and a margin to the bottom.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 119.22,
          "end": 121.65,
          "en": "And for this paragraph here,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 121.65,
          "end": 125.16,
          "en": "I'll set a color of text stone 800,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 125.16,
          "end": 127.113,
          "en": "and also a margin to the bottom.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 130.71,
          "end": 134.4,
          "en": "With that, we can use this tasks component here",
          "zh": ""
        },
        {
          "id": 41,
          "start": 134.4,
          "end": 136.833,
          "en": "in our selected project component.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 137.67000000000002,
          "end": 139.653,
          "en": "Here, instead of this dummy text.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 140.64,
          "end": 143.73,
          "en": "Here, I want to output this tasks component.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 143.73,
          "end": 145.14,
          "en": "And of course, as always,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 145.14,
          "end": 148.14,
          "en": "you must make sure that you are importing tasks",
          "zh": ""
        },
        {
          "id": 46,
          "start": 148.14,
          "end": 150.513,
          "en": "from the tasks JSX file.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 152.79,
          "end": 155.67000000000002,
          "en": "With that, we add this component here",
          "zh": ""
        },
        {
          "id": 48,
          "start": 155.67000000000002,
          "end": 157.98,
          "en": "and therefore you should see tasks,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 157.98,
          "end": 161.643,
          "en": "then this placeholder, and then this text here.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 163.62,
          "end": 166.86,
          "en": "Now, the next step is to replace this placeholder",
          "zh": ""
        },
        {
          "id": 51,
          "start": 166.86,
          "end": 168.24,
          "en": "with an actual input",
          "zh": ""
        },
        {
          "id": 52,
          "start": 168.24,
          "end": 171.603,
          "en": "and a button that can be used to add new tasks.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 172.77,
          "end": 176.13,
          "en": "And for that, here, I'll add another new component",
          "zh": ""
        },
        {
          "id": 54,
          "start": 176.13,
          "end": 178.63,
          "en": "which I'll name new task JSX",
          "zh": ""
        },
        {
          "id": 55,
          "start": 180.96,
          "end": 184.59,
          "en": "Because in that file I'll then add that component function",
          "zh": ""
        },
        {
          "id": 56,
          "start": 184.59,
          "end": 187.14,
          "en": "named NewTask, of course,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 187.14,
          "end": 189.51,
          "en": "where I'll output a div",
          "zh": ""
        },
        {
          "id": 58,
          "start": 189.51,
          "end": 191.613,
          "en": "in which I then want to have an input,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 193.92,
          "end": 197.013,
          "en": "and next to that input a button.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 198.32999999999998,
          "end": 202.29,
          "en": "Now for the input, I'll not use my custom input component",
          "zh": ""
        },
        {
          "id": 61,
          "start": 202.29,
          "end": 204.57,
          "en": "because I don't need a label",
          "zh": ""
        },
        {
          "id": 62,
          "start": 204.57,
          "end": 208.11,
          "en": "because a task should only consist of a single value",
          "zh": ""
        },
        {
          "id": 63,
          "start": 208.11,
          "end": 211.5,
          "en": "which is the text that defines the task.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 211.5,
          "end": 215.073,
          "en": "So we don't need a label as this should be self-explanatory.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 216.51,
          "end": 218.52,
          "en": "Hence, here in the new task component,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 218.52,
          "end": 221.34,
          "en": "we can just output a default input element",
          "zh": ""
        },
        {
          "id": 67,
          "start": 221.34,
          "end": 223.77,
          "en": "and set the type to text.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 223.77,
          "end": 226.833,
          "en": "And then on the button, I'll say Add Task.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 229.86,
          "end": 232.26,
          "en": "Now of course, we also need some styling here.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 232.26,
          "end": 233.57999999999998,
          "en": "And for that on that div,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 233.57999999999998,
          "end": 235.26,
          "en": "I'll add a class name",
          "zh": ""
        },
        {
          "id": 72,
          "start": 235.26,
          "end": 237.78,
          "en": "where I make sure that I'm using Flexbox here",
          "zh": ""
        },
        {
          "id": 73,
          "start": 237.78,
          "end": 240.96,
          "en": "to position these two elements next to each other.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 240.96,
          "end": 243.15,
          "en": "And I wanna center them on the vertical axis",
          "zh": ""
        },
        {
          "id": 75,
          "start": 243.15,
          "end": 245.313,
          "en": "and add some gap between them.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 247.44,
          "end": 249.3,
          "en": "And then on the input,",
          "zh": ""
        },
        {
          "id": 77,
          "start": 249.3,
          "end": 254.057,
          "en": "I wanna make sure that we have a fixed width of 60 rem,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 255.15,
          "end": 256.62,
          "en": "in my case here,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 256.62,
          "end": 259.923,
          "en": "and then some horizontal and some vertical padding,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 261.33,
          "end": 264.033,
          "en": "and then some rounded corners.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 266.16,
          "end": 267.96,
          "en": "And you can probably already see",
          "zh": ""
        },
        {
          "id": 82,
          "start": 267.96,
          "end": 270.45,
          "en": "that there are a couple of Tailwind classes,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 270.45,
          "end": 272.88,
          "en": "which I'm repeating all the time.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 272.88,
          "end": 274.44,
          "en": "And that's typically the case",
          "zh": ""
        },
        {
          "id": 85,
          "start": 274.44,
          "end": 277.32,
          "en": "when working with Tailwind CSS.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 277.32,
          "end": 280.8,
          "en": "You'll use a couple of core classes all the time",
          "zh": ""
        },
        {
          "id": 87,
          "start": 280.8,
          "end": 284.523,
          "en": "and then some more specific classes from time-to-time.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 285.42,
          "end": 287.25,
          "en": "Now here I'll finish this input",
          "zh": ""
        },
        {
          "id": 89,
          "start": 287.25,
          "end": 290.403,
          "en": "by giving it a background color of BG Stone 200.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 292.86,
          "end": 295.26,
          "en": "Now for this button here,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 295.26,
          "end": 299.79,
          "en": "I will give this a text color of Stone 700,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 299.79,
          "end": 302.58,
          "en": "and then make sure that as I hover over this",
          "zh": ""
        },
        {
          "id": 93,
          "start": 302.58,
          "end": 304.233,
          "en": "I pick a darker color.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 306.93,
          "end": 309.33,
          "en": "And that's basically it for now.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 309.33,
          "end": 312.24,
          "en": "Now, we'll use this new task component here",
          "zh": ""
        },
        {
          "id": 96,
          "start": 312.24,
          "end": 317.24,
          "en": "in the tasks component, like this, also by importing it.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 320.61,
          "end": 323.463,
          "en": "And with that added, we should, of course, see it here.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 324.66,
          "end": 327.12,
          "en": "Now, it would be nice to have some margin below it",
          "zh": ""
        },
        {
          "id": 99,
          "start": 327.12,
          "end": 330.81,
          "en": "and therefore I'll actually change this margin bottom here",
          "zh": ""
        },
        {
          "id": 100,
          "start": 330.81,
          "end": 333.3,
          "en": "on this paragraph to margin Y",
          "zh": ""
        },
        {
          "id": 101,
          "start": 333.3,
          "end": 335.793,
          "en": "to add this margin to the top and bottom.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 338.43,
          "end": 339.753,
          "en": "Now this looks nicer.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 340.77,
          "end": 341.61,
          "en": "But now, of course,",
          "zh": ""
        },
        {
          "id": 104,
          "start": 341.61,
          "end": 344.04,
          "en": "we must make sure that this also works,",
          "zh": ""
        },
        {
          "id": 105,
          "start": 344.04,
          "end": 347.46,
          "en": "so that if I enter a task here and I click add task,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 347.46,
          "end": 349.503,
          "en": "we do indeed add it here.",
          "zh": ""
        }
