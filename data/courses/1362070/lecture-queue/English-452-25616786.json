{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "25616786",
      "title": "Adding Nested Paths & Pages (Nested Routes)",
      "sourceHash": "50e299fc8d8411e832912975bf452b014e80f6927c07a53a39743ce45ceabb3b",
      "cues": [
        {
          "id": 1,
          "start": 2.17,
          "end": 4.56,
          "en": "So now we know about this concept",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.56,
          "end": 7.76,
          "en": "of using files in the pages folder",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.76,
          "end": 8.93,
          "en": "for creating routes,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.93,
          "end": 11.25,
          "en": "which then load these different components",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.25,
          "end": 13.01,
          "en": "that live in these files",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.01,
          "end": 17.5,
          "en": "and we also see that this server-side pre-rendering works",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.5,
          "end": 19.09,
          "en": "out of the box.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 19.09,
          "end": 20.4,
          "en": "Now, let's dig a bit deeper",
          "zh": ""
        },
        {
          "id": 9,
          "start": 20.4,
          "end": 23.62,
          "en": "into that file-based routing system though.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 23.62,
          "end": 27.14,
          "en": "For example, there is an important alternative",
          "zh": ""
        },
        {
          "id": 11,
          "start": 27.14,
          "end": 28.6,
          "en": "you should be aware of",
          "zh": ""
        },
        {
          "id": 12,
          "start": 28.6,
          "end": 32,
          "en": "when it comes to organizing your files and folders.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 32,
          "end": 33.62,
          "en": "We've got this index.js file",
          "zh": ""
        },
        {
          "id": 14,
          "start": 33.62,
          "end": 37.53,
          "en": "and that loads the root page or slash nothing",
          "zh": ""
        },
        {
          "id": 15,
          "start": 37.53,
          "end": 42.3,
          "en": "because it's the index.js file directly in the pages folder.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 42.3,
          "end": 44.67,
          "en": "Now, for the news page, /news,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 44.67,
          "end": 46.62,
          "en": "we've got the news.js file.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 46.62,
          "end": 49.06,
          "en": "We always have an alternative",
          "zh": ""
        },
        {
          "id": 19,
          "start": 49.06,
          "end": 51.79,
          "en": "to using such a named file name.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 51.79,
          "end": 55.31,
          "en": "So a file named differently than index.js.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 55.31,
          "end": 58.35,
          "en": "We could also create a news sub-folder",
          "zh": ""
        },
        {
          "id": 22,
          "start": 58.35,
          "end": 61.89,
          "en": "in the pages folder, move news.js in there",
          "zh": ""
        },
        {
          "id": 23,
          "start": 61.89,
          "end": 64.87,
          "en": "and then rename it to index.js",
          "zh": ""
        },
        {
          "id": 24,
          "start": 64.87,
          "end": 67.92,
          "en": "using that special index.js file name again.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 67.92,
          "end": 70.37,
          "en": "Now, this page would still be loaded",
          "zh": ""
        },
        {
          "id": 26,
          "start": 70.37,
          "end": 73.67,
          "en": "by visiting our-domain.com/news",
          "zh": ""
        },
        {
          "id": 27,
          "start": 73.67,
          "end": 75.71000000000001,
          "en": "because we're in the news folder.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 75.71000000000001,
          "end": 77.13,
          "en": "And that's important.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 77.13,
          "end": 81.36,
          "en": "Folders, which you create in your pages folder also act",
          "zh": ""
        },
        {
          "id": 30,
          "start": 81.36,
          "end": 83.42,
          "en": "as path segments.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 83.42,
          "end": 84.66,
          "en": "And it's totally up to you",
          "zh": ""
        },
        {
          "id": 32,
          "start": 84.66,
          "end": 87.81,
          "en": "whether you wanna go with news.js",
          "zh": ""
        },
        {
          "id": 33,
          "start": 87.81,
          "end": 92.7,
          "en": "in the root pages folder or index.js in the news folder.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 92.7,
          "end": 94.28,
          "en": "Now, it does matter though",
          "zh": ""
        },
        {
          "id": 35,
          "start": 94.28,
          "end": 97.19,
          "en": "as soon as you start creating nested paths,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 97.19,
          "end": 98.578,
          "en": "and that's what I wanna do now.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 98.578,
          "end": 100.53,
          "en": "If we wanna have a path",
          "zh": ""
        },
        {
          "id": 38,
          "start": 100.53,
          "end": 105.53,
          "en": "that is something like news.something-important",
          "zh": ""
        },
        {
          "id": 39,
          "start": 106.5,
          "end": 109.92,
          "en": "where something-important is the identifier",
          "zh": ""
        },
        {
          "id": 40,
          "start": 109.92,
          "end": 112.61,
          "en": "of the specific news item you wanna load,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 112.61,
          "end": 116.33,
          "en": "then you need to create a file in such a sub-folder",
          "zh": ""
        },
        {
          "id": 42,
          "start": 116.33,
          "end": 119.85,
          "en": "because otherwise, you can't create such a nested path.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 119.85,
          "end": 122.49,
          "en": "After all, we have two segments here",
          "zh": ""
        },
        {
          "id": 44,
          "start": 122.49,
          "end": 125.82,
          "en": "and if we just create files directly in the pages folder,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 125.82,
          "end": 129.82,
          "en": "we're limited to one segment, the file name.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 129.82,
          "end": 133.15,
          "en": "So therefore, if we want to have such a nested path,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 133.15,
          "end": 134.5,
          "en": "so more than one segment,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 134.5,
          "end": 136.65,
          "en": "we need to create a sub-folder",
          "zh": ""
        },
        {
          "id": 49,
          "start": 136.65,
          "end": 138.82999999999998,
          "en": "and then we can also create the root page",
          "zh": ""
        },
        {
          "id": 50,
          "start": 138.82999999999998,
          "end": 141.53,
          "en": "for that path with index.js",
          "zh": ""
        },
        {
          "id": 51,
          "start": 141.53,
          "end": 146.53,
          "en": "and then create the something-important.js file",
          "zh": ""
        },
        {
          "id": 52,
          "start": 146.66,
          "end": 150.06,
          "en": "as a sibling file to index.js.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 150.06,
          "end": 153.22,
          "en": "So now we have two different pages",
          "zh": ""
        },
        {
          "id": 54,
          "start": 153.22,
          "end": 156.12,
          "en": "that start with /news,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 156.12,
          "end": 159.76,
          "en": "/news/ nothing loads the component in the index.js file,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 159.76,
          "end": 163.03,
          "en": "/news/something-important",
          "zh": ""
        },
        {
          "id": 57,
          "start": 163.03,
          "end": 166.02,
          "en": "will load the component we create in here.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 166.02,
          "end": 169.1,
          "en": "Now, of course, here again we could alternatively also",
          "zh": ""
        },
        {
          "id": 59,
          "start": 169.1,
          "end": 171.37,
          "en": "create another nested sub-folder,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 171.37,
          "end": 174.34,
          "en": "something-important with the index.js file in there.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 174.34,
          "end": 176.6,
          "en": "That would again be the alternative",
          "zh": ""
        },
        {
          "id": 62,
          "start": 176.6,
          "end": 180.23,
          "en": "to using such a named file name in the news folder.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 180.23,
          "end": 182.404,
          "en": "But I hope you get the idea by now.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 182.404,
          "end": 185.38,
          "en": "Now, with that, I could copy this code",
          "zh": ""
        },
        {
          "id": 65,
          "start": 185.38,
          "end": 187.4,
          "en": "from index.js in the news folder",
          "zh": ""
        },
        {
          "id": 66,
          "start": 187.4,
          "end": 191.37,
          "en": "and bring it into the something-important page here",
          "zh": ""
        },
        {
          "id": 67,
          "start": 191.37,
          "end": 194.98,
          "en": "and then name this DetailPage maybe",
          "zh": ""
        },
        {
          "id": 68,
          "start": 194.98,
          "end": 197.59,
          "en": "because that should be the page holding the details",
          "zh": ""
        },
        {
          "id": 69,
          "start": 197.59,
          "end": 199.55,
          "en": "for a specific news item",
          "zh": ""
        },
        {
          "id": 70,
          "start": 199.55,
          "end": 201.02,
          "en": "and this page would now be loaded",
          "zh": ""
        },
        {
          "id": 71,
          "start": 201.02,
          "end": 204.453,
          "en": "for /news/something-important.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 205.35,
          "end": 207.14,
          "en": "And hence, if we save everything",
          "zh": ""
        },
        {
          "id": 73,
          "start": 207.14,
          "end": 211.27,
          "en": "and we visit /news, we see The News page,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 211.27,
          "end": 215.1,
          "en": "and if I visit /news/something-important,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 215.1,
          "end": 218.18,
          "en": "then we see The Detail Page.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 218.18,
          "end": 220.91,
          "en": "So that's how this works.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 220.91,
          "end": 223.64,
          "en": "But there is still another important concept",
          "zh": ""
        },
        {
          "id": 78,
          "start": 223.64,
          "end": 225.523,
          "en": "which we have't touched on yet.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}