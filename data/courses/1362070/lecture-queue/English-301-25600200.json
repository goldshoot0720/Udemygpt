        },
        {
          "id": 87,
          "start": 285.53,
          "end": 287.263,
          "en": "we would have to write otherwise.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 288.31,
          "end": 291.47,
          "en": "Now in these methods here in the reducers map",
