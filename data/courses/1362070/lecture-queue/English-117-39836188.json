        },
        {
          "id": 52,
          "start": 181.29,
          "end": 186.06,
          "en": "to show you your folder structure in the browser.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 186.06,
          "end": 189.21,
          "en": "But you can now dive into this code,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 189.21,
          "end": 192.06,
          "en": "for example, here into your app JSX file,",
