  "lectures": [
    {
      "id": "39499470",
      "title": "Fetching More Data & Testing the Mutation",
      "sourceHash": "1fcc3d8c3e8be71b3125a83094bdec30c261b3e06f873f211c981f50e7f5c585",
      "cues": [
        {
          "id": 1,
          "start": 0.81,
          "end": 1.643,
          "en": "So the goal",
          "zh": ""
        },
        {
          "id": 2,
          "start": 1.643,
          "end": 4.47,
          "en": "is to let the user pick an image here.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 4.47,
          "end": 7.98,
          "en": "And the way this app and this backend here works",
          "zh": ""
        },
        {
          "id": 4,
          "start": 7.98,
          "end": 11.19,
          "en": "is that this backend code in this app.js file",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.19,
          "end": 15.15,
          "en": "in the backend folder actually has a route,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.15,
          "end": 18.09,
          "en": "this event's images route, to which a get request",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.09,
          "end": 21.39,
          "en": "can be sent to get back a list of images",
          "zh": ""
        },
        {
          "id": 8,
          "start": 21.39,
          "end": 23.43,
          "en": "from which the user can choose,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 23.43,
          "end": 26.88,
          "en": "because those actual images that will be displayed",
          "zh": ""
        },
        {
          "id": 10,
          "start": 26.88,
          "end": 31.83,
          "en": "are stored on the backend in that public folder there,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 31.83,
          "end": 34.563,
          "en": "they're not part of the frontend project.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 35.88,
          "end": 39.63,
          "en": "Therefore I can't just include them in my frontend code.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 39.63,
          "end": 44.63,
          "en": "Instead, a request must be sent to this backend route here",
          "zh": ""
        },
        {
          "id": 14,
          "start": 44.7,
          "end": 48.09,
          "en": "so that we get that list of images that we can display",
          "zh": ""
        },
        {
          "id": 15,
          "start": 48.09,
          "end": 51.183,
          "en": "and we can then render that list on the frontend.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 53.31,
          "end": 57.03,
          "en": "Therefore, back here in the frontend code,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 57.03,
          "end": 60.15,
          "en": "in the new event component, we must display",
          "zh": ""
        },
        {
          "id": 18,
          "start": 60.15,
          "end": 62.883,
          "en": "a list of images in the EventForm component.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 64.02,
          "end": 66.18,
          "en": "Now, in the EventForm component,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 66.18,
          "end": 69.39,
          "en": "it's actually this ImagePicker component",
          "zh": ""
        },
        {
          "id": 21,
          "start": 69.39,
          "end": 72.84,
          "en": "that, as the name suggests, is responsible",
          "zh": ""
        },
        {
          "id": 22,
          "start": 72.84,
          "end": 76.8,
          "en": "for showing the user a selection of pickable images",
          "zh": ""
        },
        {
          "id": 23,
          "start": 76.8,
          "end": 79.623,
          "en": "and handling the user selecting an image.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 80.58,
          "end": 83.34,
          "en": "And for that ImagePicker needs an array",
          "zh": ""
        },
        {
          "id": 25,
          "start": 83.34,
          "end": 86.25,
          "en": "of pickable images as an input.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 86.25,
          "end": 89.1,
          "en": "And at the moment this is hardcoded",
          "zh": ""
        },
        {
          "id": 27,
          "start": 89.1,
          "end": 91.56,
          "en": "to always be an empty array,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 91.56,
          "end": 94.11,
          "en": "and that's of course not the data I want here.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 94.11,
          "end": 97.08,
          "en": "Instead that should be that array of images",
          "zh": ""
        },
        {
          "id": 30,
          "start": 97.08,
          "end": 99.723,
          "en": "that's returned by this backend route.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 101.25,
          "end": 103.25999999999999,
          "en": "So in the EventForm component",
          "zh": ""
        },
        {
          "id": 32,
          "start": 103.25999999999999,
          "end": 107.49000000000001,
          "en": "we need to fetch that list of images from the backend.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 107.49000000000001,
          "end": 112.17,
          "en": "And of course, this is a job for React Query again",
          "zh": ""
        },
        {
          "id": 34,
          "start": 112.17,
          "end": 114.42,
          "en": "and here it's the Query hook we need",
          "zh": ""
        },
        {
          "id": 35,
          "start": 114.42,
          "end": 118.08,
          "en": "because I don't want change any data on the backend.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 118.08,
          "end": 120.99,
          "en": "I don't wanna perform a data mutation.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 120.99,
          "end": 124.29,
          "en": "Therefore, instead I just wanna Query for data.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 124.29,
          "end": 129.29,
          "en": "I want to get some data so we can and should use useQuery",
          "zh": ""
        },
        {
          "id": 39,
          "start": 130.89,
          "end": 133.83,
          "en": "here in this EventForm component.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 133.83,
          "end": 137.56,
          "en": "And as before in this section, we must configure this hook",
          "zh": ""
        },
        {
          "id": 41,
          "start": 138.78,
          "end": 143.78,
          "en": "by defining a Query function and a Query key.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 145.82999999999998,
          "end": 147.78,
          "en": "Now, regarding the Query function,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 147.78,
          "end": 150.54,
          "en": "I again prepared something for you,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 150.54,
          "end": 153.81,
          "en": "because attached you find another updated version",
          "zh": ""
        },
        {
          "id": 45,
          "start": 153.81,
          "end": 157.8,
          "en": "of the http.js file, which now also includes",
          "zh": ""
        },
        {
          "id": 46,
          "start": 157.8,
          "end": 160.95,
          "en": "this fetchSelectableImages function",
          "zh": ""
        },
        {
          "id": 47,
          "start": 160.95,
          "end": 164.34,
          "en": "which sends a request to that backend URL,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 164.34,
          "end": 167.91,
          "en": "I just explained to you, where we get that list",
          "zh": ""
        },
        {
          "id": 49,
          "start": 167.91,
          "end": 172.91,
          "en": "of selectable images, and it's now this function",
          "zh": ""
        },
        {
          "id": 50,
          "start": 173.07,
          "end": 175.89,
          "en": "that should be used as a Query function here",
          "zh": ""
        },
        {
          "id": 51,
          "start": 175.89,
          "end": 177.753,
          "en": "in the EventForm component.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 178.86,
          "end": 181.02,
          "en": "So therefore, here I'll import",
          "zh": ""
        },
        {
          "id": 53,
          "start": 181.02,
          "end": 186.02,
          "en": "this fetchSelectableImages function from the http.js file",
          "zh": ""
        },
        {
          "id": 54,
          "start": 187.29,
          "end": 190.443,
          "en": "and then use it as a value for a Query event,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 191.49,
          "end": 194.433,
          "en": "and of course, we also need a Query key here.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 195.45,
          "end": 199.11,
          "en": "And here the Query key can again be something hard coded,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 199.11,
          "end": 201.213,
          "en": "like events-images.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 202.14,
          "end": 205.98,
          "en": "We don't need any dynamic element in here",
          "zh": ""
        },
        {
          "id": 59,
          "start": 205.98,
          "end": 208.11,
          "en": "because the request I wanna send here",
          "zh": ""
        },
        {
          "id": 60,
          "start": 208.11,
          "end": 209.79,
          "en": "will always be the same.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 209.79,
          "end": 214.023,
          "en": "It does not depend on any user input or anything like that.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 215.61,
          "end": 220.41,
          "en": "Hence, we then can use that object returned by useQuery",
          "zh": ""
        },
        {
          "id": 63,
          "start": 220.41,
          "end": 222,
          "en": "to get hold of the data",
          "zh": ""
        },
        {
          "id": 64,
          "start": 222,
          "end": 224.73,
          "en": "which will be that list of images",
          "zh": ""
        },
        {
          "id": 65,
          "start": 224.73,
          "end": 228.72,
          "en": "and also isPending and maybe also isError",
          "zh": ""
        },
        {
          "id": 66,
          "start": 228.72,
          "end": 232.65,
          "en": "to show some alternative information on the screen",
          "zh": ""
        },
        {
          "id": 67,
          "start": 232.65,
          "end": 235.353,
          "en": "if fetching that list of images failed.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 237.87,
          "end": 241.5,
          "en": "But I'll start by using that data, so that list of images",
          "zh": ""
        },
        {
          "id": 69,
          "start": 241.5,
          "end": 246.27,
          "en": "as a value for the images prop on the ImagePicker component",
          "zh": ""
        },
        {
          "id": 70,
          "start": 246.27,
          "end": 249.693,
          "en": "so that we're passing this list of images to this component.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 251.22,
          "end": 253.56,
          "en": "But now I also wanna make sure",
          "zh": ""
        },
        {
          "id": 72,
          "start": 253.56,
          "end": 258.56,
          "en": "that we only show this if we get images to display.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 258.87,
          "end": 262.593,
          "en": "So I'll show it conditionally only if we have data,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 263.64,
          "end": 264.513,
          "en": "like this.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 266.67,
          "end": 269.55,
          "en": "On the other hand I wanna show some loading text",
          "zh": ""
        },
        {
          "id": 76,
          "start": 269.55,
          "end": 274.2,
          "en": "if isPending is true, so that I show a paragraph here,",
          "zh": ""
        },
        {
          "id": 77,
          "start": 274.2,
          "end": 279.003,
          "en": "for example, where I say \"Loading selectable images\"",
          "zh": ""
        },
        {
          "id": 78,
          "start": 280.62,
          "end": 283.98,
          "en": "and if we got an error if isError is true,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 283.98,
          "end": 286.683,
          "en": "we could use this ErrorBlock again,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 287.88,
          "end": 291.27,
          "en": "this custom component which again must be imported",
          "zh": ""
        },
        {
          "id": 81,
          "start": 291.27,
          "end": 296.27,
          "en": "where we then say \"Failed to load selectable images,\"",
          "zh": ""
        },
        {
          "id": 82,
          "start": 296.52,
          "end": 301.52,
          "en": "and then maybe a message of \"Please try again later.\"",
          "zh": ""
        },
        {
          "id": 83,
          "start": 301.68,
          "end": 303.093,
          "en": "or something like that,",
          "zh": ""
        },
        {
          "id": 84,
          "start": 304.41,
          "end": 307.74,
          "en": "so that we're using the different pieces of information",
          "zh": ""
        },
        {
          "id": 85,
          "start": 307.74,
          "end": 311.76,
          "en": "we're getting back from useQuery in our JSX code",
          "zh": ""
        },
        {
          "id": 86,
          "start": 311.76,
          "end": 313.803,
          "en": "in this EventForm component here.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 315.75,
          "end": 317.94,
          "en": "And now with that, if we save that,",
          "zh": ""
        },
        {
          "id": 88,
          "start": 317.94,
          "end": 320.16,
          "en": "you can already see the images are here.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 320.16,
          "end": 322.53,
          "en": "If I reload, they are here again",
          "zh": ""
        },
        {
          "id": 90,
          "start": 322.53,
          "end": 325.413,
          "en": "because they were fetched by useQuery now,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 326.88,
          "end": 330.06,
          "en": "as you can also see in the network tab, if I reload,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 330.06,
          "end": 333.46,
          "en": "this is the request that fetches this list of images",
          "zh": ""
        },
        {
          "id": 93,
          "start": 335.97,
          "end": 339.06,
          "en": "and therefore now here we can create a new event,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 339.06,
          "end": 344.06,
          "en": "like a \"Tech Meetup, Meet awesome people",
          "zh": ""
        },
        {
          "id": 95,
          "start": 344.34000000000003,
          "end": 349.34000000000003,
          "en": "and find new friends.\" where we maybe want this image here.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 352.74,
          "end": 357.063,
          "en": "And then we can pick a date, let's say somewhere in March,",
          "zh": ""
        },
        {
          "id": 97,
          "start": 358.17,
          "end": 363.17,
          "en": "then maybe around 7:00 PM and then maybe in React Street",
          "zh": ""
        },
        {
          "id": 98,
          "start": 365.91,
          "end": 369.873,
          "en": "in some weird address, some place.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 371.04,
          "end": 375.42,
          "en": "If I now click Create nothing happens again,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 375.42,
          "end": 378.45,
          "en": "but this is now the case because it did work.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 378.45,
          "end": 381.81,
          "en": "If I open the dev tools, I now got no error here",
          "zh": ""
        },
        {
          "id": 102,
          "start": 381.81,
          "end": 385.08,
          "en": "and we don't get any error message below here.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 385.08,
          "end": 387.9,
          "en": "Instead, the reason for nothing happening here",
          "zh": ""
        },
        {
          "id": 104,
          "start": 387.9,
          "end": 390.48,
          "en": "just is that we haven't added any code",
          "zh": ""
        },
        {
          "id": 105,
          "start": 390.48,
          "end": 394.98,
          "en": "to do something if that mutation succeeds,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 394.98,
          "end": 397.14300000000003,
          "en": "and that's, therefore, what we'll do next.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}