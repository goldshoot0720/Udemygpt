{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "39649208",
      "title": "Passing Functions as Values to Props",
      "sourceHash": "9cf8f4ea50ae7b26f07937d4120a89e8893045a4b9b6ad04518a9af9938f74be",
      "cues": [
        {
          "id": 1,
          "start": 0.63,
          "end": 3.18,
          "en": "So now that we know how to listen",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.18,
          "end": 7.41,
          "en": "to events and how to run some code when an event occurs",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.41,
          "end": 10.74,
          "en": "the next step is that we wanna change",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.74,
          "end": 12.99,
          "en": "the content below these buttons.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.99,
          "end": 15.15,
          "en": "So here, this content area,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.15,
          "end": 18.15,
          "en": "we wanna update it whenever a button is pressed",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.15,
          "end": 20.883,
          "en": "and we wanna show different content down there.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 21.78,
          "end": 25.62,
          "en": "And for that, we can go back to the app component file,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 25.62,
          "end": 27.9,
          "en": "to the app JSX file",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.9,
          "end": 32.01,
          "en": "because in there it's below this menu area",
          "zh": ""
        },
        {
          "id": 11,
          "start": 32.01,
          "end": 35.52,
          "en": "where I wanna output my Dynamic Content.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 35.52,
          "end": 38.883,
          "en": "So the content that depends on which button was pressed.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 39.87,
          "end": 42.99,
          "en": "But here we of course have custom Components,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 42.99,
          "end": 46.53,
          "en": "we don't have the built-in button component here.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 46.53,
          "end": 47.82,
          "en": "And therefore, of course",
          "zh": ""
        },
        {
          "id": 16,
          "start": 47.82,
          "end": 52.17,
          "en": "in order to set and update this Dynamic Content,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 52.17,
          "end": 54.93,
          "en": "we first of all need to listen",
          "zh": ""
        },
        {
          "id": 18,
          "start": 54.93,
          "end": 57.813,
          "en": "to clicks on our custom button.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 58.95,
          "end": 61.29,
          "en": "Well, for that it's important to keep in mind",
          "zh": ""
        },
        {
          "id": 20,
          "start": 61.29,
          "end": 65.91,
          "en": "that our custom buttons, like all custom Components",
          "zh": ""
        },
        {
          "id": 21,
          "start": 65.91,
          "end": 69.21000000000001,
          "en": "in the end, just wrap Native HTML elements,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 69.21000000000001,
          "end": 72.21000000000001,
          "en": "Native JSX elements to be precise.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 72.21000000000001,
          "end": 75.57300000000001,
          "en": "So built-in Components provided by React.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 76.8,
          "end": 80.34,
          "en": "And those built-in buttons have the built-in onClick prop",
          "zh": ""
        },
        {
          "id": 25,
          "start": 80.34,
          "end": 81.6,
          "en": "for example.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 81.6,
          "end": 86.34,
          "en": "Therefore, in order to make our own tap buttons clickable,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 86.34,
          "end": 91.34,
          "en": "what we ultimately wanna do is we wanna set the value",
          "zh": ""
        },
        {
          "id": 28,
          "start": 91.77,
          "end": 96,
          "en": "for this onClick prop on this built-in button",
          "zh": ""
        },
        {
          "id": 29,
          "start": 96,
          "end": 99.27000000000001,
          "en": "from outside our custom Component,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 99.27000000000001,
          "end": 101.37,
          "en": "from inside the app Component",
          "zh": ""
        },
        {
          "id": 31,
          "start": 101.37,
          "end": 104.13,
          "en": "in this case here to be precise.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 104.13,
          "end": 107.72999999999999,
          "en": "So it would be nice if we could, for example,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 107.72999999999999,
          "end": 112.71000000000001,
          "en": "set an onClick prop on our custom tab button,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 112.71000000000001,
          "end": 113.75999999999999,
          "en": "and then in the end",
          "zh": ""
        },
        {
          "id": 35,
          "start": 113.75999999999999,
          "end": 116.55,
          "en": "accept a function here as a value,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 116.55,
          "end": 118.28999999999999,
          "en": "the function that should be triggered",
          "zh": ""
        },
        {
          "id": 37,
          "start": 118.28999999999999,
          "end": 119.763,
          "en": "when that button is clicked.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 120.72,
          "end": 124.38,
          "en": "But that function, which we set on this onClick prop",
          "zh": ""
        },
        {
          "id": 39,
          "start": 124.38,
          "end": 128.73,
          "en": "should then in the end be forwarded to the built-in element,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 128.73,
          "end": 133.62,
          "en": "which does have this real onClick prop that's built-in",
          "zh": ""
        },
        {
          "id": 41,
          "start": 133.62,
          "end": 137.67000000000002,
          "en": "and where React will make sure that the function you provide",
          "zh": ""
        },
        {
          "id": 42,
          "start": 137.67000000000002,
          "end": 140.013,
          "en": "as a value will get triggered.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 141.24,
          "end": 144.09,
          "en": "Well, and to achieve this, what we can do",
          "zh": ""
        },
        {
          "id": 44,
          "start": 144.09,
          "end": 146.49,
          "en": "is we can simply accept a prop here",
          "zh": ""
        },
        {
          "id": 45,
          "start": 146.49,
          "end": 148.98,
          "en": "that could be named onClick",
          "zh": ""
        },
        {
          "id": 46,
          "start": 148.98,
          "end": 153.603,
          "en": "using object destructuring here to get access to that prop.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 154.74,
          "end": 157.29,
          "en": "And since it's our own custom Component,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 157.29,
          "end": 159.9,
          "en": "this here could be called anything.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 159.9,
          "end": 163.32,
          "en": "The children prop, as you learned is special.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 163.32,
          "end": 167.31,
          "en": "It's provided by React and it must be named children",
          "zh": ""
        },
        {
          "id": 51,
          "start": 167.31,
          "end": 169.5,
          "en": "but that's basically the only prop",
          "zh": ""
        },
        {
          "id": 52,
          "start": 169.5,
          "end": 171.423,
          "en": "where you don't have a choice.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 172.32,
          "end": 175.95,
          "en": "All other props on your own custom Components",
          "zh": ""
        },
        {
          "id": 54,
          "start": 175.95,
          "end": 178.29,
          "en": "can be named whatever you want.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 178.29,
          "end": 183.09,
          "en": "And therefore we could wait for a prop called onClick here",
          "zh": ""
        },
        {
          "id": 56,
          "start": 183.09,
          "end": 184.35,
          "en": "but we could also name it",
          "zh": ""
        },
        {
          "id": 57,
          "start": 184.35,
          "end": 188.403,
          "en": "just click or maybe onSelect or anything like this.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 189.39,
          "end": 193.35,
          "en": "And here to make it clear that this name is up to you,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 193.35,
          "end": 196.89,
          "en": "I'll name it onSelect and I'll deliberately start",
          "zh": ""
        },
        {
          "id": 60,
          "start": 196.89,
          "end": 200.22,
          "en": "with on and then select here",
          "zh": ""
        },
        {
          "id": 61,
          "start": 200.22,
          "end": 203.25,
          "en": "because that's another convention you'll see a lot",
          "zh": ""
        },
        {
          "id": 62,
          "start": 203.25,
          "end": 206.67000000000002,
          "en": "in React projects that props",
          "zh": ""
        },
        {
          "id": 63,
          "start": 206.67000000000002,
          "end": 209.67000000000002,
          "en": "that should in the end receive a function",
          "zh": ""
        },
        {
          "id": 64,
          "start": 209.67000000000002,
          "end": 214.67000000000002,
          "en": "that will be triggered upon an event, should start with on.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 214.74,
          "end": 217.8,
          "en": "Starting with on here makes it clear",
          "zh": ""
        },
        {
          "id": 66,
          "start": 217.8,
          "end": 221.25,
          "en": "that this prop should be set to a function",
          "zh": ""
        },
        {
          "id": 67,
          "start": 221.25,
          "end": 225.69,
          "en": "that will ultimately be triggered based on some event,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 225.69,
          "end": 228.69,
          "en": "whatever that event may be.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 228.69,
          "end": 231.75,
          "en": "It can be a click on some internal button",
          "zh": ""
        },
        {
          "id": 70,
          "start": 231.75,
          "end": 234.93,
          "en": "as we plan to do it here, but it could also",
          "zh": ""
        },
        {
          "id": 71,
          "start": 234.93,
          "end": 239.523,
          "en": "be some HTTP request that finished, anything you need.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 240.39,
          "end": 244.92,
          "en": "But here the goal is to use this onSelect prop",
          "zh": ""
        },
        {
          "id": 73,
          "start": 244.92,
          "end": 248.76,
          "en": "and therefore the function that should be set as a value",
          "zh": ""
        },
        {
          "id": 74,
          "start": 248.76,
          "end": 253.053,
          "en": "on this prop as a value for the onClick prop here.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 254.13,
          "end": 258.33,
          "en": "So therefore, now we can cut this handle click function here",
          "zh": ""
        },
        {
          "id": 76,
          "start": 258.33,
          "end": 260.49,
          "en": "and we can therefore now go to the place",
          "zh": ""
        },
        {
          "id": 77,
          "start": 260.49,
          "end": 263.5,
          "en": "where we're using the TapButton Component",
          "zh": ""
        },
        {
          "id": 78,
          "start": 264.51,
          "end": 267.123,
          "en": "and set this onSelect prop.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 268.26,
          "end": 272.85,
          "en": "And I'll therefore now add this handle click function again",
          "zh": ""
        },
        {
          "id": 80,
          "start": 272.85,
          "end": 277.29,
          "en": "or maybe we should now name it handle select to be in line",
          "zh": ""
        },
        {
          "id": 81,
          "start": 277.29,
          "end": 281.19,
          "en": "with that prop name I chose down there.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 281.19,
          "end": 283.65,
          "en": "And I'll update the text and just also say,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 283.65,
          "end": 287.414,
          "en": "selected in there so that we really see that it's coming",
          "zh": ""
        },
        {
          "id": 84,
          "start": 287.414,
          "end": 291.03,
          "en": "from this function and it's now this function",
          "zh": ""
        },
        {
          "id": 85,
          "start": 291.03,
          "end": 293.943,
          "en": "which will be set as a value for onSelect.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 295.14,
          "end": 298.59000000000003,
          "en": "And what we're therefore doing in the end here",
          "zh": ""
        },
        {
          "id": 87,
          "start": 298.59000000000003,
          "end": 303.59,
          "en": "is we're passing a pointer at this handle select function.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 304.14,
          "end": 305.4,
          "en": "We're passing the function",
          "zh": ""
        },
        {
          "id": 89,
          "start": 305.4,
          "end": 310.2,
          "en": "as a value you could say, to the onSelect prop.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 310.2,
          "end": 312.18,
          "en": "And in our custom Component,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 312.18,
          "end": 315.57,
          "en": "we're then in the end forwarding, you could say,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 315.57,
          "end": 318.183,
          "en": "that function to the onClick prop.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 319.53,
          "end": 322.14,
          "en": "And therefore when this button is clicked,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 322.14,
          "end": 325.32,
          "en": "ultimately it's this handle select function",
          "zh": ""
        },
        {
          "id": 95,
          "start": 325.32,
          "end": 327.873,
          "en": "in the app Component that will be triggered.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 328.92,
          "end": 333.213,
          "en": "And this is a super common and important pattern,",
          "zh": ""
        },
        {
          "id": 97,
          "start": 334.71,
          "end": 336.45,
          "en": "therefore now with that,",
          "zh": ""
        },
        {
          "id": 98,
          "start": 336.45,
          "end": 340.37,
          "en": "we can set this for all our TapButtons.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 342.631,
          "end": 344.4,
          "en": "And if we now save this",
          "zh": ""
        },
        {
          "id": 100,
          "start": 344.4,
          "end": 346.653,
          "en": "and open these developer tools again,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 347.61,
          "end": 349.68,
          "en": "we therefore now see, Hello World",
          "zh": ""
        },
        {
          "id": 102,
          "start": 349.68,
          "end": 352.08299999999997,
          "en": "selected whenever we click a button.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 353.15999999999997,
          "end": 354.78,
          "en": "And therefore at this point",
          "zh": ""
        },
        {
          "id": 104,
          "start": 354.78,
          "end": 357.33,
          "en": "we of course didn't gain a lot",
          "zh": ""
        },
        {
          "id": 105,
          "start": 357.33,
          "end": 359.52,
          "en": "because we were able to output something",
          "zh": ""
        },
        {
          "id": 106,
          "start": 359.52,
          "end": 362.19,
          "en": "in the console before as well.",
          "zh": ""
        },
        {
          "id": 107,
          "start": 362.19,
          "end": 365.1,
          "en": "But we're now prepared to also change",
          "zh": ""
        },
        {
          "id": 108,
          "start": 365.1,
          "end": 368.73,
          "en": "this Dynamic Content here in the app Component",
          "zh": ""
        },
        {
          "id": 109,
          "start": 368.73,
          "end": 371.85,
          "en": "because we're now reacting to that click event",
          "zh": ""
        },
        {
          "id": 110,
          "start": 371.85,
          "end": 372.75,
          "en": "in the end.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 372.75,
          "end": 374.25,
          "en": "In that same Component,",
          "zh": ""
        },
        {
          "id": 112,
          "start": 374.25,
          "end": 377.133,
          "en": "where we then wanna update the content.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 378.3,
          "end": 381.87,
          "en": "Reacting just inside of that tab button Component",
          "zh": ""
        },
        {
          "id": 114,
          "start": 381.87,
          "end": 384.93,
          "en": "would not be enough because from in there,",
          "zh": ""
        },
        {
          "id": 115,
          "start": 384.93,
          "end": 386.58,
          "en": "we wouldn't have access",
          "zh": ""
        },
        {
          "id": 116,
          "start": 386.58,
          "end": 389.7,
          "en": "to this JSX code that includes this content.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 389.7,
          "end": 392.73,
          "en": "Now with this pattern of setting a function",
          "zh": ""
        },
        {
          "id": 118,
          "start": 392.73,
          "end": 395.90999999999997,
          "en": "as a value for a prop on a custom Component,",
          "zh": ""
        },
        {
          "id": 119,
          "start": 395.90999999999997,
          "end": 399.21,
          "en": "we are in the position to update some data",
          "zh": ""
        },
        {
          "id": 120,
          "start": 399.21,
          "end": 401.883,
          "en": "that will affect this JSX code, though.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}