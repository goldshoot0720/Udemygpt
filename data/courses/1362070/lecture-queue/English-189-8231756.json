  "lectures": [
    {
      "id": "8231756",
      "title": "Setting Different Timers Based On The Selected Answer",
      "sourceHash": "494ab3654d4eb4c2bd044a7066d812cae61370ca9608fa3d9a5552a8a324476b",
      "cues": [
        {
          "id": 1,
          "start": 0.81,
          "end": 2.91,
          "en": "Now, this quiz application",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.91,
          "end": 6.81,
          "en": "is slowly but steadily taking shape here.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.81,
          "end": 8.487,
          "en": "We're able to answer those questions",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.487,
          "end": 12.39,
          "en": "and see whether we did pick the right or wrong answer.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.39,
          "end": 15.27,
          "en": "And we got this nice timer here that tells us",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.27,
          "end": 17.34,
          "en": "how much time is remaining.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.34,
          "end": 19.53,
          "en": "At the moment, we'll face a problem though.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 19.53,
          "end": 23.275,
          "en": "If I pick an answer a little bit too late,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 23.275,
          "end": 28.05,
          "en": "well then this timer up here might actually expire",
          "zh": ""
        },
        {
          "id": 10,
          "start": 28.05,
          "end": 30.42,
          "en": "before I learn whether it's right or wrong.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 30.42,
          "end": 32.595,
          "en": "We simply might move along too quickly",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.595,
          "end": 35.79,
          "en": "and as you actually maybe saw here,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 35.79,
          "end": 38.97,
          "en": "we then also seem to run into some problems",
          "zh": ""
        },
        {
          "id": 14,
          "start": 38.97,
          "end": 43.536,
          "en": "where we got multiple timers going on at the same time.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 43.536,
          "end": 47.25,
          "en": "Because whenever we pick an answer,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 47.25,
          "end": 49.427,
          "en": "we are of course also setting a timer here",
          "zh": ""
        },
        {
          "id": 17,
          "start": 49.427,
          "end": 51.9,
          "en": "in the question component.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 51.9,
          "end": 55.11,
          "en": "We're actually setting two nested timers here.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 55.11,
          "end": 57.99,
          "en": "And once this inner timer expired, which happens",
          "zh": ""
        },
        {
          "id": 20,
          "start": 57.99,
          "end": 61.35,
          "en": "after we marked an answer as right or wrong,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 61.35,
          "end": 65.91,
          "en": "we forward the selected answer to the parent component,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 65.91,
          "end": 68.244,
          "en": "which is the quiz component here.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 68.244,
          "end": 72.75,
          "en": "But that of course means that if this timer here expires",
          "zh": ""
        },
        {
          "id": 24,
          "start": 72.75,
          "end": 76.015,
          "en": "before the right or wrong answer",
          "zh": ""
        },
        {
          "id": 25,
          "start": 76.015,
          "end": 79.28999999999999,
          "en": "is forwarded to the parent component,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 79.28999999999999,
          "end": 83.46000000000001,
          "en": "we switch to a different question because the timer expired.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 83.46000000000001,
          "end": 84.53999999999999,
          "en": "And then again,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 84.53999999999999,
          "end": 87.45,
          "en": "because now the actually selected answer",
          "zh": ""
        },
        {
          "id": 29,
          "start": 87.45,
          "end": 90.36,
          "en": "was forwarded to the parent component.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 90.36,
          "end": 91.77,
          "en": "And in the quiz component,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 91.77,
          "end": 94.74000000000001,
          "en": "we got these two different situations",
          "zh": ""
        },
        {
          "id": 32,
          "start": 94.74000000000001,
          "end": 97.832,
          "en": "where we do switch to a different question",
          "zh": ""
        },
        {
          "id": 33,
          "start": 97.832,
          "end": 101.55,
          "en": "because we stored a selected answer.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 101.55,
          "end": 104.75999999999999,
          "en": "One way of moving to the next question",
          "zh": ""
        },
        {
          "id": 35,
          "start": 104.75999999999999,
          "end": 106.65,
          "en": "and storing an answer is",
          "zh": ""
        },
        {
          "id": 36,
          "start": 106.65,
          "end": 110.55,
          "en": "if an answer was skipped because the timer expired.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 110.55,
          "end": 114.12,
          "en": "The other way is of course, that we received an answer",
          "zh": ""
        },
        {
          "id": 38,
          "start": 114.12,
          "end": 117.96000000000001,
          "en": "from the user because an answer was selected.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 117.96000000000001,
          "end": 122.777,
          "en": "And now both things happen if we select an answer too late.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 122.777,
          "end": 127.74,
          "en": "So what we need to do to avoid this problem is",
          "zh": ""
        },
        {
          "id": 41,
          "start": 127.74,
          "end": 132.03,
          "en": "in this question component, we must up update this timer",
          "zh": ""
        },
        {
          "id": 42,
          "start": 132.03,
          "end": 134.862,
          "en": "if the user did select an answer,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 134.862,
          "end": 138.54,
          "en": "so that we start a new timer, so to say,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 138.54,
          "end": 142.35,
          "en": "that only expires after we showed the user",
          "zh": ""
        },
        {
          "id": 45,
          "start": 142.35,
          "end": 144.81,
          "en": "the right or wrong answer.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 144.81,
          "end": 147.09,
          "en": "And if that timer then expires,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 147.09,
          "end": 149.699,
          "en": "I also don't wanna tell the quiz component",
          "zh": ""
        },
        {
          "id": 48,
          "start": 149.699,
          "end": 152.37,
          "en": "that the question was not answered,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 152.37,
          "end": 154.803,
          "en": "because that will then not be the case.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 156.6,
          "end": 161.047,
          "en": "So to update the timer here, once an answer was chosen,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 161.047,
          "end": 164.88,
          "en": "we can add a new computed value here",
          "zh": ""
        },
        {
          "id": 52,
          "start": 164.88,
          "end": 166.59300000000002,
          "en": "in this question component,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 167.76,
          "end": 169.59300000000002,
          "en": "which we could name timer.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 171.66,
          "end": 175.47,
          "en": "And that should be 10,000 milliseconds",
          "zh": ""
        },
        {
          "id": 55,
          "start": 175.47,
          "end": 178.82999999999998,
          "en": "or whatever your default maximum amount of time",
          "zh": ""
        },
        {
          "id": 56,
          "start": 178.82999999999998,
          "end": 182.97,
          "en": "per question should be as one possible value",
          "zh": ""
        },
        {
          "id": 57,
          "start": 182.97,
          "end": 185.403,
          "en": "when this question component gets rendered.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 186.33,
          "end": 188.37,
          "en": "But when this component gets re-rendered",
          "zh": ""
        },
        {
          "id": 59,
          "start": 188.37,
          "end": 193.35,
          "en": "because an answer was selected, I want to change that value.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 193.35,
          "end": 196,
          "en": "So, I'll actually set this to a variable here",
          "zh": ""
        },
        {
          "id": 61,
          "start": 197.04,
          "end": 200.85,
          "en": "and now change it depending on certain conditions.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 200.85,
          "end": 205.11,
          "en": "Because if on this answer state we have here,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 205.11,
          "end": 208.71,
          "en": "if the selected answer is truthy,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 208.71,
          "end": 210.893,
          "en": "so if we have a selected answer,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 210.893,
          "end": 215.1,
          "en": "I want to set the timer to 1000 milliseconds",
          "zh": ""
        },
        {
          "id": 66,
          "start": 215.1,
          "end": 218.52,
          "en": "because I'll reveal the correct or right answer",
          "zh": ""
        },
        {
          "id": 67,
          "start": 218.52,
          "end": 220.923,
          "en": "after those 1000 milliseconds.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 222.133,
          "end": 227.133,
          "en": "If then thereafter, answer is correct is not equal to null.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 228.72,
          "end": 232.74,
          "en": "So if we have the information, whether it is correct or not,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 232.74,
          "end": 235.68,
          "en": "I want to set the timer to 2000 milliseconds",
          "zh": ""
        },
        {
          "id": 71,
          "start": 235.68,
          "end": 238.23,
          "en": "because that's then the time it'll take",
          "zh": ""
        },
        {
          "id": 72,
          "start": 238.23,
          "end": 241.29,
          "en": "until we move to the next question.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 241.29,
          "end": 244.32,
          "en": "And of course, 1000 and 2000 therefore",
          "zh": ""
        },
        {
          "id": 74,
          "start": 244.32,
          "end": 248.013,
          "en": "are the same values I have down there for my timers.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 250.5,
          "end": 252.87,
          "en": "And with that, we can and should use",
          "zh": ""
        },
        {
          "id": 76,
          "start": 252.87,
          "end": 255.50900000000001,
          "en": "those computed timer values",
          "zh": ""
        },
        {
          "id": 77,
          "start": 255.50900000000001,
          "end": 259.653,
          "en": "as values for the timeout prop on the question timer.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 260.94,
          "end": 263.55,
          "en": "And therefore, whenever timer changes",
          "zh": ""
        },
        {
          "id": 79,
          "start": 263.55,
          "end": 266.37,
          "en": "inside of the question timer component,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 266.37,
          "end": 269.16,
          "en": "a new interval and timeout will be started",
          "zh": ""
        },
        {
          "id": 81,
          "start": 269.16,
          "end": 271.92,
          "en": "and the progress will be updated accordingly.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 271.92,
          "end": 274.02,
          "en": "Because timeout is received",
          "zh": ""
        },
        {
          "id": 83,
          "start": 274.02,
          "end": 278.853,
          "en": "as a prop here and used as a dependency on our timeout here.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 280.5,
          "end": 284.97,
          "en": "Now in addition, I'll also accept a mode prop",
          "zh": ""
        },
        {
          "id": 85,
          "start": 284.97,
          "end": 287.19,
          "en": "in this question timer component",
          "zh": ""
        },
        {
          "id": 86,
          "start": 287.19,
          "end": 290.61,
          "en": "because I wanna set this mode prop here",
          "zh": ""
        },
        {
          "id": 87,
          "start": 290.61,
          "end": 295.578,
          "en": "as a class name simply for styling purposes, therefore.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 295.578,
          "end": 299.79,
          "en": "Because I prepared the index CSS file such that",
          "zh": ""
        },
        {
          "id": 89,
          "start": 299.79,
          "end": 302.67,
          "en": "if we set answered answered as a mode here,",
          "zh": ""
        },
        {
          "id": 90,
          "start": 302.67,
          "end": 306.03,
          "en": "the progress bar will receive a different color,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 306.03,
          "end": 308.473,
          "en": "which I simply want to use to show the user",
          "zh": ""
        },
        {
          "id": 92,
          "start": 308.473,
          "end": 311.34,
          "en": "that something changed.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 311.34,
          "end": 315.42,
          "en": "And therefore, in the question component on question timer,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 315.42,
          "end": 319.29,
          "en": "I'll now set this mode prop to my answer state,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 319.29,
          "end": 322.953,
          "en": "since that will be answered or correct or wrong.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 324.84,
          "end": 327.18,
          "en": "With that, if we save this, if I reload,",
          "zh": ""
        },
        {
          "id": 97,
          "start": 327.18,
          "end": 328.405,
          "en": "if I pick an answer,",
          "zh": ""
        },
        {
          "id": 98,
          "start": 328.405,
          "end": 332.15999999999997,
          "en": "you see the color changed, but we still seem",
          "zh": ""
        },
        {
          "id": 99,
          "start": 332.15999999999997,
          "end": 334.53,
          "en": "to be facing some problems here.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 334.53,
          "end": 336.12,
          "en": "For example, I still switched",
          "zh": ""
        },
        {
          "id": 101,
          "start": 336.12,
          "end": 340.05,
          "en": "to a different question thereafter unexpectedly,",
          "zh": ""
        },
        {
          "id": 102,
          "start": 340.05,
          "end": 343.38,
          "en": "and the color of the progress bar changes,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 343.38,
          "end": 346.56,
          "en": "but you also see the progress bar does not update here.",
          "zh": ""
        },
        {
          "id": 104,
          "start": 346.56,
          "end": 349.38,
          "en": "So, there seem to be some problems here.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 349.38,
          "end": 352.62,
          "en": "And one problem simply is that we don't reset",
          "zh": ""
        },
        {
          "id": 106,
          "start": 352.62,
          "end": 356.34000000000003,
          "en": "the interval whenever the timeout changes.",
          "zh": ""
        },
        {
          "id": 107,
          "start": 356.34000000000003,
          "end": 358.89,
          "en": "And therefore this interval is not in line",
          "zh": ""
        },
        {
          "id": 108,
          "start": 358.89,
          "end": 361.65,
          "en": "with the new timer and the new max value",
          "zh": ""
        },
        {
          "id": 109,
          "start": 361.65,
          "end": 362.883,
          "en": "of the progress bar.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 364.05,
          "end": 365.88,
          "en": "The easiest way of fixing this,",
          "zh": ""
        },
        {
          "id": 111,
          "start": 365.88,
          "end": 369.27,
          "en": "is to again add a key here to question timer",
          "zh": ""
        },
        {
          "id": 112,
          "start": 369.27,
          "end": 371.82,
          "en": "and to set this equal to timer,",
          "zh": ""
        },
        {
          "id": 113,
          "start": 371.82,
          "end": 374.19,
          "en": "so that when we change the timer value,",
          "zh": ""
        },
        {
          "id": 114,
          "start": 374.19,
          "end": 377.91,
          "en": "we destroy and recreate the question timer component",
          "zh": ""
        },
        {
          "id": 115,
          "start": 377.91,
          "end": 381.123,
          "en": "and force the interval to be recreated, therefore.",
          "zh": ""
        },
        {
          "id": 116,
          "start": 382.71,
          "end": 384.3,
          "en": "Now, the other issue was",
          "zh": ""
        },
        {
          "id": 117,
          "start": 384.3,
          "end": 387.36,
          "en": "that we still skipped a question thereafter",
          "zh": ""
        },
        {
          "id": 118,
          "start": 387.36,
          "end": 389.07,
          "en": "and that happens because",
          "zh": ""
        },
        {
          "id": 119,
          "start": 389.07,
          "end": 391.59,
          "en": "whenever this timer expires in there,",
          "zh": ""
        },
        {
          "id": 120,
          "start": 391.59,
          "end": 395.90999999999997,
          "en": "we still trigger this on skip answer function.",
          "zh": ""
        },
        {
          "id": 121,
          "start": 395.90999999999997,
          "end": 398.717,
          "en": "But I only want to trigger this function",
          "zh": ""
        },
        {
          "id": 122,
          "start": 398.717,
          "end": 402.087,
          "en": "if no answer was selected.",
          "zh": ""
        },
        {
          "id": 123,
          "start": 402.087,
          "end": 404.596,
          "en": "Therefore, here in the question component,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 404.596,
          "end": 409.596,
          "en": "we can for example, go down here and check if answer,",
          "zh": ""
        },
        {
          "id": 125,
          "start": 409.83,
          "end": 413.34000000000003,
          "en": "selected answer is equal to an empty string,",
          "zh": ""
        },
        {
          "id": 126,
          "start": 413.34000000000003,
          "end": 416.28,
          "en": "which means no answer has been selected.",
          "zh": ""
        },
        {
          "id": 127,
          "start": 416.28,
          "end": 418.65,
          "en": "In which case the value for on timeout",
          "zh": ""
        },
        {
          "id": 128,
          "start": 418.65,
          "end": 421.32,
          "en": "should indeed be on skip answer.",
          "zh": ""
        },
        {
          "id": 129,
          "start": 421.32,
          "end": 424.59,
          "en": "Otherwise, here I want to have null.",
          "zh": ""
        },
        {
          "id": 130,
          "start": 424.59,
          "end": 427.56,
          "en": "I don't want to have a value for on timeout,",
          "zh": ""
        },
        {
          "id": 131,
          "start": 427.56,
          "end": 431.043,
          "en": "because I don't want to execute any function in that case.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 432.09,
          "end": 434.202,
          "en": "If I save this and reload,",
          "zh": ""
        },
        {
          "id": 133,
          "start": 434.202,
          "end": 438.21,
          "en": "now I can log in a question, we got new timers expiring",
          "zh": ""
        },
        {
          "id": 134,
          "start": 438.21,
          "end": 440.46,
          "en": "and we then move on to the next question",
          "zh": ""
        },
        {
          "id": 135,
