  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "40272482",
      "title": "What Happens When Context Values Change?",
      "sourceHash": "d0a30a99837b94c1c7eaa881f8faf48307859ba32317e17705dc22539788264b",
      "cues": [
        {
          "id": 1,
          "start": 0.45,
          "end": 3.51,
          "en": "Now, there's one other thing you must know",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.51,
          "end": 8.51,
          "en": "about consuming and using context values in components.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 8.85,
          "end": 11.58,
          "en": "And that is something which you might actually",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.58,
          "end": 13.35,
          "en": "already have guessed.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.35,
          "end": 18.35,
          "en": "When you do access a context value in a component",
          "zh": ""
        },
        {
          "id": 6,
          "start": 18.54,
          "end": 23.54,
          "en": "and that value then changes the component function",
          "zh": ""
        },
        {
          "id": 7,
          "start": 23.58,
          "end": 26.55,
          "en": "that accesses the context value,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 26.55,
          "end": 30.33,
          "en": "will get re-executed by React,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 30.33,
          "end": 35.07,
          "en": "just as the component function would also get re-executed",
          "zh": ""
        },
        {
          "id": 10,
          "start": 35.07,
          "end": 39.84,
          "en": "if it would be using some internal state that was updated",
          "zh": ""
        },
        {
          "id": 11,
          "start": 39.84,
          "end": 43.473,
          "en": "or if its parent component were executed again.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 44.31,
          "end": 47.4,
          "en": "Just as a component function gets re-executed",
          "zh": ""
        },
        {
          "id": 13,
          "start": 47.4,
          "end": 49.95,
          "en": "by React in such situations,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 49.95,
          "end": 52.38,
          "en": "it also gets re-executed",
          "zh": ""
        },
        {
          "id": 15,
          "start": 52.38,
          "end": 56.1,
          "en": "if a component function uses the useContext hook",
          "zh": ""
        },
        {
          "id": 16,
          "start": 56.1,
          "end": 59.94,
          "en": "and therefore is connected to some context value.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 59.94,
          "end": 63.51,
          "en": "And that value changes because, of course,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 63.51,
          "end": 67.35,
          "en": "the component must be executed again in such situations",
          "zh": ""
        },
        {
          "id": 19,
          "start": 67.35,
          "end": 71.01,
          "en": "because otherwise, the UI wouldn't be updated.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 71.01,
          "end": 75.36,
          "en": "And that's why React will re-execute a component function",
          "zh": ""
        },
        {
          "id": 21,
          "start": 75.36,
          "end": 79.11,
          "en": "if it's connected context value changes so that",
          "zh": ""
        },
        {
          "id": 22,
          "start": 79.11,
          "end": 81.06,
          "en": "that component function can then",
          "zh": ""
        },
        {
          "id": 23,
          "start": 81.06,
          "end": 83.733,
          "en": "produce some new user interface.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}