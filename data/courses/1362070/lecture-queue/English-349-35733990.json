      "cues": [
        {
          "id": 1,
          "start": 2.04,
          "end": 3.63,
          "en": "Now of course this error page",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.63,
          "end": 5.22,
          "en": "here isn't too beautiful",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.22,
          "end": 6.84,
          "en": "and too helpful.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 6.84,
          "end": 7.673,
          "en": "And they offer",
          "zh": ""
        },
        {
          "id": 5,
          "start": 7.673,
          "end": 8.94,
          "en": "to improve it a little bit.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 8.94,
          "end": 10.41,
          "en": "As a first step,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 10.41,
          "end": 12.39,
          "en": "you find a new component attached",
          "zh": ""
        },
        {
          "id": 8,
          "start": 12.39,
          "end": 13.424,
          "en": "to this lecture.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 13.424,
          "end": 17.46,
          "en": "And that's the page content .js file.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 17.46,
          "end": 18.417,
          "en": "It's a little helper component",
          "zh": ""
        },
        {
          "id": 11,
          "start": 18.417,
          "end": 20.486,
          "en": "that provides us some styling",
          "zh": ""
        },
        {
          "id": 12,
          "start": 20.486,
          "end": 24.168,
          "en": "which I'll use to render it here,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 24.168,
          "end": 26.1,
          "en": "on this error page.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 26.1,
          "end": 28.8,
          "en": "For that we must import page content",
          "zh": ""
        },
        {
          "id": 15,
          "start": 28.8,
          "end": 32.373,
          "en": "from and then components page content.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 34.273,
          "end": 36.15,
          "en": "And here we can set a title property",
          "zh": ""
        },
        {
          "id": 17,
          "start": 36.15,
          "end": 36.983,
          "en": "and set it",
          "zh": ""
        },
        {
          "id": 18,
          "start": 36.983,
          "end": 39.06,
          "en": "to an error occurred.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 39.06,
          "end": 40.8,
          "en": "And we can then also pass some content",
          "zh": ""
        },
        {
          "id": 20,
          "start": 40.8,
          "end": 41.633,
          "en": "between the opening",
          "zh": ""
        },
        {
          "id": 21,
          "start": 41.633,
          "end": 42.466,
          "en": "and closing tags",
          "zh": ""
        },
        {
          "id": 22,
          "start": 42.466,
          "end": 43.5,
          "en": "of page content.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 43.5,
          "end": 44.58,
          "en": "And for example,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 44.58,
          "end": 45.87,
          "en": "add a paragraph where we",
          "zh": ""
        },
        {
          "id": 25,
          "start": 45.87,
          "end": 48.123,
          "en": "say something went wrong.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 49.29,
          "end": 50.7,
          "en": "Now this looks a bit nicer,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 50.7,
          "end": 52.86,
          "en": "but we can still improve it.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 52.86,
          "end": 53.974,
          "en": "For example, we might want",
          "zh": ""
        },
        {
          "id": 29,
          "start": 53.974,
          "end": 55.53,
          "en": "to differentiate",
          "zh": ""
        },
        {
          "id": 30,
          "start": 55.53,
          "end": 57.93,
          "en": "between 4 0 4 errors",
          "zh": ""
        },
        {
          "id": 31,
          "start": 57.93,
          "end": 59.31,
          "en": "and other errors",
          "zh": ""
        },
        {
          "id": 32,
          "start": 59.31,
          "end": 60.51,
          "en": "like the one we have here",
          "zh": ""
        },
        {
          "id": 33,
          "start": 60.51,
          "end": 61.74,
          "en": "from our loader,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 61.74,
          "end": 63.75,
          "en": "where we actually have an error",
          "zh": ""
        },
        {
          "id": 35,
          "start": 63.75,
          "end": 64.693,
          "en": "message that we might",
          "zh": ""
        },
        {
          "id": 36,
          "start": 64.693,
          "end": 65.646,
          "en": "wanna display instead",
          "zh": ""
        },
        {
          "id": 37,
          "start": 65.646,
          "end": 68.13,
          "en": "of the default error message",
          "zh": ""
        },
        {
          "id": 38,
          "start": 68.13,
          "end": 70.08,
          "en": "I defined here.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 70.08,
          "end": 72,
          "en": "So to differentiate between errors",
          "zh": ""
        },
        {
          "id": 40,
          "start": 72,
          "end": 74.01,
          "en": "what we can do is instead",
          "zh": ""
        },
        {
          "id": 41,
          "start": 74.01,
          "end": 75.402,
          "en": "of throwing a object,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 75.402,
          "end": 76.973,
          "en": "we can throw a response",
          "zh": ""
        },
        {
          "id": 43,
          "start": 76.973,
          "end": 79.11,
          "en": "by again creating a new response.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 79.11,
          "end": 81.15,
          "en": "And then we can include some data",
          "zh": ""
        },
        {
          "id": 45,
          "start": 81.15,
          "end": 83.19,
          "en": "into that response.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 83.19,
          "end": 84.45,
          "en": "For this, we have",
          "zh": ""
        },
        {
          "id": 47,
          "start": 84.45,
          "end": 85.73400000000001,
          "en": "to call JSON stringify",
          "zh": ""
        },
        {
          "id": 48,
          "start": 85.73400000000001,
          "end": 87.96000000000001,
          "en": "if we want to pass an object",
          "zh": ""
        },
        {
          "id": 49,
          "start": 87.96000000000001,
          "end": 88.793,
          "en": "to the response.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 88.793,
          "end": 90.48,
          "en": "And then we could add",
          "zh": ""
        },
        {
          "id": 51,
          "start": 90.48,
          "end": 91.74,
          "en": "a message prop and say",
          "zh": ""
        },
        {
          "id": 52,
          "start": 91.74,
          "end": 93.783,
          "en": "could not fetch events.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 95.16,
          "end": 96.42,
          "en": "And now we can add",
          "zh": ""
        },
        {
          "id": 54,
          "start": 96.42,
          "end": 97.74000000000001,
          "en": "this second argument",
          "zh": ""
        },
        {
          "id": 55,
          "start": 97.74000000000001,
          "end": 99.39,
          "en": "to the response constructor",
          "zh": ""
        },
        {
          "id": 56,
          "start": 99.39,
          "end": 101.28,
          "en": "and set the status, for example,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 101.28,
          "end": 102.99000000000001,
          "en": "to 500 to indicate",
          "zh": ""
        },
        {
          "id": 58,
          "start": 102.99000000000001,
          "end": 104.31,
          "en": "that something went wrong",
          "zh": ""
        },
        {
          "id": 59,
          "start": 104.31,
          "end": 105.66,
          "en": "on the back end.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 105.66,
          "end": 107.00999999999999,
          "en": "That's just one example.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 107.00999999999999,
          "end": 108.93,
          "en": "In this case, it's an incorrect URL,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 108.93,
          "end": 111.45,
          "en": "but we could set this status code.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 111.45,
          "end": 112.41,
          "en": "Now I'm doing this",
          "zh": ""
        },
        {
          "id": 64,
          "start": 112.41,
          "end": 114.24000000000001,
          "en": "because you can actually get hold",
          "zh": ""
        },
        {
          "id": 65,
          "start": 114.24000000000001,
          "end": 115.35300000000001,
          "en": "of the data that's being thrown",
          "zh": ""
        },
        {
          "id": 66,
          "start": 115.35300000000001,
          "end": 116.582,
          "en": "as an error inside",
          "zh": ""
        },
        {
          "id": 67,
          "start": 116.582,
          "end": 119.281,
          "en": "of the component that's being rendered",
          "zh": ""
        },
        {
          "id": 68,
          "start": 119.281,
          "end": 121.77,
          "en": "as an error element.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 121.77,
          "end": 123.51,
          "en": "And for that React-Router-Dom",
          "zh": ""
        },
        {
          "id": 70,
          "start": 123.51,
          "end": 125.335,
          "en": "gives you another special hook",
          "zh": ""
        },
        {
          "id": 71,
          "start": 125.335,
          "end": 128.94,
          "en": "which we import from react-router-dom.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 128.94,
          "end": 132.063,
          "en": "And that's the use route error hook.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 133.32,
          "end": 135.69,
          "en": "This gives us an error object",
          "zh": ""
        },
        {
          "id": 74,
          "start": 135.69,
          "end": 137.28,
          "en": "if you want to call it like this.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 137.28,
          "end": 138.113,
          "en": "And the shape",
          "zh": ""
        },
        {
          "id": 76,
          "start": 138.113,
          "end": 139.8,
          "en": "of that object now depends",
          "zh": ""
        },
        {
          "id": 77,
          "start": 139.8,
          "end": 142.525,
          "en": "on whether you threw a response",
          "zh": ""
        },
        {
          "id": 78,
          "start": 142.525,
          "end": 144.42000000000002,
          "en": "or any other kind",
          "zh": ""
        },
        {
          "id": 79,
          "start": 144.42000000000002,
          "end": 146.133,
          "en": "of object or data.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 147.27,
          "end": 149.07,
          "en": "If you threw a response",
          "zh": ""
        },
        {
          "id": 81,
          "start": 149.07,
          "end": 150.87,
          "en": "as I'm doing it here now,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 150.87,
          "end": 153.903,
          "en": "this error object will include",
          "zh": ""
        },
        {
          "id": 83,
          "start": 153.903,
          "end": 155.82999999999998,
          "en": "a status",
          "zh": ""
        },
        {
          "id": 84,
          "start": 157.11,
          "end": 157.94299999999998,
          "en": "field.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 157.94299999999998,
          "end": 160.05,
          "en": "which actually reflects the status",
          "zh": ""
        },
        {
          "id": 86,
          "start": 160.05,
          "end": 162.36,
          "en": "of the response you threw.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 162.36,
          "end": 164.7,
          "en": "In my case, that would be 500",
          "zh": ""
        },
        {
          "id": 88,
          "start": 164.7,
          "end": 166.863,
          "en": "because that's the status I set here.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 167.754,
          "end": 169.45499999999998,
          "en": "If you threw any other kind",
          "zh": ""
        },
        {
          "id": 90,
          "start": 169.45499999999998,
          "end": 170.935,
          "en": "of object, like a regular",
          "zh": ""
        },
        {
          "id": 91,
          "start": 170.935,
          "end": 172.394,
          "en": "JavaScript object,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 172.394,
          "end": 175.553,
          "en": "then this error object would already",
          "zh": ""
        },
        {
          "id": 93,
          "start": 175.553,
          "end": 177.9,
          "en": "be that thrown object.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 177.9,
          "end": 178.98,
          "en": "So then there would not",
          "zh": ""
        },
        {
          "id": 95,
          "start": 178.98,
          "end": 181.8,
          "en": "be this special status property.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 181.8,
          "end": 183.09,
          "en": "But that's why you might wanna",
          "zh": ""
        },
        {
          "id": 97,
          "start": 183.09,
          "end": 184.71,
          "en": "throw responses instead",
          "zh": ""
        },
        {
          "id": 98,
          "start": 184.71,
          "end": 186.36,
          "en": "of regular objects",
          "zh": ""
        },
        {
          "id": 99,
          "start": 186.36,
          "end": 187.8,
          "en": "because it does allow you to",
          "zh": ""
        },
        {
          "id": 100,
          "start": 187.8,
          "end": 190.11,
          "en": "include this extra status property,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 190.11,
          "end": 192.045,
          "en": "this extra status field, which helps",
          "zh": ""
        },
        {
          "id": 102,
          "start": 192.045,
          "end": 194.114,
          "en": "with building a generic error",
          "zh": ""
        },
        {
          "id": 103,
          "start": 194.114,
          "end": 196.293,
          "en": "handling component.",
          "zh": ""
        },
        {
          "id": 104,
          "start": 197.28,
          "end": 198.85399999999998,
          "en": "Because now an error JS",
          "zh": ""
        },
        {
          "id": 105,
          "start": 198.85399999999998,
          "end": 200.605,
          "en": "in this error page,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 200.605,
          "end": 202.35,
          "en": "we can",
          "zh": ""
        },
        {
          "id": 107,
          "start": 202.35,
          "end": 204.25,
          "en": "create our title",
          "zh": ""
        },
        {
          "id": 108,
          "start": 205.56,
          "end": 207.42000000000002,
          "en": "and our message",
          "zh": ""
        },
        {
          "id": 109,
          "start": 207.42000000000002,
          "end": 210.03,
          "en": "and set these two default values,",
          "zh": ""
        },
        {
          "id": 110,
          "start": 210.03,
          "end": 211.02,
          "en": "but override them",
          "zh": ""
        },
        {
          "id": 111,
          "start": 211.02,
          "end": 212.371,
          "en": "with more fitting values based",
          "zh": ""
        },
        {
          "id": 112,
          "start": 212.371,
          "end": 214.413,
          "en": "on which error we have.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 215.49,
          "end": 216.69,
          "en": "So we could, for example,",
          "zh": ""
        },
        {
          "id": 114,
          "start": 216.69,
          "end": 219.813,
          "en": "have these default values here,",
          "zh": ""
        },
        {
          "id": 115,
          "start": 220.8,
          "end": 221.73,
          "en": "but then we can check",
          "zh": ""
        },
        {
          "id": 116,
          "start": 221.73,
          "end": 225.66,
          "en": "if error dot status is maybe 500,",
          "zh": ""
        },
        {
          "id": 117,
          "start": 225.66,
          "end": 227.141,
          "en": "in which case we might want",
          "zh": ""
        },
        {
          "id": 118,
          "start": 227.141,
          "end": 229.71,
          "en": "to keep the title.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 229.71,
          "end": 230.7,
          "en": "But set the message",
          "zh": ""
        },
        {
          "id": 120,
          "start": 230.7,
          "end": 233.373,
          "en": "to error.data.message.",
          "zh": ""
        },
        {
          "id": 121,
          "start": 234.66,
          "end": 236.519,
          "en": "Now error.data gives us access",
          "zh": ""
        },
        {
          "id": 122,
          "start": 236.519,
          "end": 237.352,
          "en": "to the",
          "zh": ""
        },
        {
          "id": 123,
          "start": 237.352,
          "end": 239.43,
          "en": "data that's included",
          "zh": ""
        },
        {
          "id": 124,
          "start": 239.43,
          "end": 240.96,
          "en": "in this error response",
          "zh": ""
        },
        {
          "id": 125,
          "start": 240.96,
          "end": 241.98,
          "en": "that was thrown.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 241.98,
          "end": 243.42,
          "en": "So, to this object here,",
          "zh": ""
        },
        {
          "id": 127,
          "start": 243.42,
          "end": 244.253,
          "en": "in my case,",
          "zh": ""
        },
        {
          "id": 128,
          "start": 244.253,
          "end": 246.78,
          "en": "And that object has a message",
          "zh": ""
        },
        {
          "id": 129,
          "start": 246.78,
          "end": 247.613,
          "en": "and we can assume",
          "zh": ""
        },
        {
          "id": 130,
          "start": 247.613,
          "end": 248.67,
          "en": "that most objects",
          "zh": ""
        },
        {
          "id": 131,
          "start": 248.67,
          "end": 249.69,
          "en": "that are included",
          "zh": ""
        },
        {
          "id": 132,
          "start": 249.69,
          "end": 251.34,
          "en": "in error responses will",
          "zh": ""
        },
        {
          "id": 133,
          "start": 251.34,
          "end": 253.32,
          "en": "have message properties.",
          "zh": ""
        },
        {
          "id": 134,
          "start": 253.32,
          "end": 254.52,
          "en": "That's why I'm accessing",
          "zh": ""
        },
        {
          "id": 135,
          "start": 254.52,
          "end": 255.36,
          "en": "the data object",
          "zh": ""
        },
        {
          "id": 136,
          "start": 255.36,
          "end": 256.65,
          "en": "of the error response",
          "zh": ""
        },
        {
          "id": 137,
          "start": 256.65,
          "end": 258.453,
          "en": "and then the message property here.",
          "zh": ""
        },
        {
          "id": 138,
          "start": 260.31,
          "end": 261.27,
          "en": "But we could, for example,",
          "zh": ""
        },
        {
          "id": 139,
          "start": 261.27,
          "end": 262.98,
          "en": "also check if the error status",
          "zh": ""
        },
        {
          "id": 140,
          "start": 262.98,
          "end": 264.66,
          "en": "is maybe 4 0 4,",
          "zh": ""
        },
        {
          "id": 141,
          "start": 264.66,
          "end": 266.4,
          "en": "which is the default status set",
          "zh": ""
        },
        {
          "id": 142,
          "start": 266.4,
          "end": 268.05,
          "en": "by React router if you enter",
          "zh": ""
        },
