        {
          "id": 30,
          "start": 93.15,
          "end": 95.94,
          "en": "Now, as always, for this section here,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 95.94,
          "end": 98.22,
          "en": "I prepared a starting project,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 98.22,
          "end": 101.00999999999999,
          "en": "a local and a CodeSandbox version.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 101.00999999999999,
          "end": 102.57,
          "en": "In the local version, as always,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 102.57,
          "end": 105.42,
          "en": "you need to run 'npm' install and 'npm' run dev.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 105.42,
          "end": 108.27000000000001,
          "en": "In the CodeSandbox version, you don't need to do that.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 108.27000000000001,
          "end": 111.57,
          "en": "And once you got this project started up",
          "zh": ""
        },
        {
          "id": 37,
          "start": 111.57,
          "end": 113.91,
          "en": "you should see a screen like this,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 113.91,
          "end": 117.63,
          "en": "if you visit the running development server.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 117.63,
          "end": 119.49000000000001,
          "en": "So not a lot on it,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 119.49000000000001,
          "end": 122.37,
          "en": "because that's what we're going to build together",
          "zh": ""
        },
        {
          "id": 41,
          "start": 122.37,
          "end": 123.9,
          "en": "throughout this section.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 123.9,
          "end": 125.97,
          "en": "Because as mentioned we're going to",
          "zh": ""
        },
        {
          "id": 43,
          "start": 125.97,
          "end": 128.7,
          "en": "build this project from scratch.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 128.7,
          "end": 132.15,
          "en": "And we're therefore going to use effects again,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 132.15,
          "end": 135.03,
          "en": "because we'll need them for this project.",
          "zh": ""
        },
        {
          "id": 46,
