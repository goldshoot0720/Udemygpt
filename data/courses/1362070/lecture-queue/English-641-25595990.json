        {
          "id": 42,
          "start": 100.93299999999999,
          "end": 101.1,
          "en": "but that it's better to define it upfront.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 101.1,
          "end": 102.93299999999999,
          "en": "And therefore that's what I'll do.",
