{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "39837070",
      "title": "Using A Custom Hook in Multiple Components",
      "sourceHash": "9efb04b13ead8c42f919b3c3aa8afd0e550f9432c07bde11a88bc2a77644a603",
      "cues": [
        {
          "id": 1,
          "start": 0.54,
          "end": 2.19,
          "en": "Now as explained before,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.19,
          "end": 6.12,
          "en": "the idea behind creating custom hooks like this",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.12,
          "end": 9.81,
          "en": "is of course to get leaner components",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.81,
          "end": 13.2,
          "en": "because you can outsource some state and logic",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.2,
          "end": 14.793,
          "en": "into those custom hooks.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.75,
          "end": 20.25,
          "en": "But another reason for creating and using custom hooks",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.25,
          "end": 24.69,
          "en": "is of course also that you can share them across components",
          "zh": ""
        },
        {
          "id": 8,
          "start": 24.69,
          "end": 29.37,
          "en": "if multiple components have fairly similar logic",
          "zh": ""
        },
        {
          "id": 9,
          "start": 29.37,
          "end": 30.693,
          "en": "that can be outsourced.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 31.89,
          "end": 34.26,
          "en": "For example, in this application here",
          "zh": ""
        },
        {
          "id": 11,
          "start": 34.26,
          "end": 37.32,
          "en": "in the available places component",
          "zh": ""
        },
        {
          "id": 12,
          "start": 37.32,
          "end": 42.32,
          "en": "we also have this code where we fetch some data,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 42.6,
          "end": 45.36,
          "en": "manage a loading and an error state",
          "zh": ""
        },
        {
          "id": 14,
          "start": 45.36,
          "end": 48.84,
          "en": "and then store the data once it's there.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 48.84,
          "end": 52.02,
          "en": "And we do all that with useEffect and useState.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 52.02,
          "end": 55.14,
          "en": "And therefore here we in the end have logic",
          "zh": ""
        },
        {
          "id": 17,
          "start": 55.14,
          "end": 57.33,
          "en": "that is fairly similar",
          "zh": ""
        },
        {
          "id": 18,
          "start": 57.33,
          "end": 59.583,
          "en": "to what we're doing in useFetch.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 60.78,
          "end": 63.39,
          "en": "There's just one important difference",
          "zh": ""
        },
        {
          "id": 20,
          "start": 63.39,
          "end": 67.8,
          "en": "because here I'm then also taking that data that I'm getting",
          "zh": ""
        },
        {
          "id": 21,
          "start": 67.8,
          "end": 72.27,
          "en": "and I am combining it with the position of the user",
          "zh": ""
        },
        {
          "id": 22,
          "start": 72.27,
          "end": 77.27,
          "en": "to sort these places, which I am fetching by distance.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 77.37,
          "end": 79.32,
          "en": "But let's worry about that later",
          "zh": ""
        },
        {
          "id": 24,
          "start": 79.32,
          "end": 82.98,
          "en": "because since the rest of the logic is fairly similar,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 82.98,
          "end": 87.69,
          "en": "we can of course also import useFetch here",
          "zh": ""
        },
        {
          "id": 26,
          "start": 87.69,
          "end": 90.03,
          "en": "in available places",
          "zh": ""
        },
        {
          "id": 27,
          "start": 90.03,
          "end": 92.49000000000001,
          "en": "and import that from the hooks folder",
          "zh": ""
        },
        {
          "id": 28,
          "start": 92.49000000000001,
          "end": 95.643,
          "en": "and there from the useFetch JS file.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 97.14,
          "end": 101.07300000000001,
          "en": "And we can call useFetch here in this component.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 102.50999999999999,
          "end": 105.96000000000001,
          "en": "Now, useFetch, as you saw in the previous lectures",
          "zh": ""
        },
        {
          "id": 31,
          "start": 105.96000000000001,
          "end": 110.00999999999999,
          "en": "needs a fetch function and an initial value",
          "zh": ""
        },
        {
          "id": 32,
          "start": 110.00999999999999,
          "end": 111.393,
          "en": "as an input then.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 112.74000000000001,
          "end": 116.43,
          "en": "And here in available places, the initial value",
          "zh": ""
        },
        {
          "id": 34,
          "start": 116.43,
          "end": 119.43,
          "en": "should be an array and the fetch function",
          "zh": ""
        },
        {
          "id": 35,
          "start": 119.43,
          "end": 122.163,
          "en": "is this fetch available places function.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 123.87,
          "end": 128.87,
          "en": "So therefore here we can pass fetch available places",
          "zh": ""
        },
        {
          "id": 37,
          "start": 129.84,
          "end": 134.583,
          "en": "to this hook and this empty array as an initial value.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 136.41,
          "end": 139.29,
          "en": "And then as a result, we get back an object",
          "zh": ""
        },
        {
          "id": 39,
          "start": 139.29,
          "end": 143.31,
          "en": "from which we can extract isFetching error,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 143.31,
          "end": 146.37,
          "en": "the fetched data and if we need it,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 146.37,
          "end": 150.303,
          "en": "also the set fetched data state updating function.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 152.43,
          "end": 156.81,
          "en": "And therefore we can now get rid of the state",
          "zh": ""
        },
        {
          "id": 43,
          "start": 156.81,
          "end": 159.36,
          "en": "we managed in there before",
          "zh": ""
        },
        {
          "id": 44,
          "start": 159.36,
          "end": 164.36,
          "en": "and we might wanna rename fetched data to available places",
          "zh": ""
        },
        {
          "id": 45,
          "start": 164.52,
          "end": 167.94299999999998,
          "en": "since that's the name we used for that state here before.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 169.05,
          "end": 171.48,
          "en": "And we might wanna update set fetched data",
          "zh": ""
        },
        {
          "id": 47,
          "start": 171.48,
          "end": 174.333,
          "en": "to set available places therefore.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 176.7,
          "end": 180.3,
          "en": "And we can of course also get rid of this useEffect call",
          "zh": ""
        },
        {
          "id": 49,
          "start": 180.3,
          "end": 184.08,
          "en": "though here I wanna keep this code around",
          "zh": ""
        },
        {
          "id": 50,
          "start": 184.08,
          "end": 188.07,
          "en": "where I'm calculating my distance.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 188.07,
          "end": 191.25,
          "en": "I'll cut that and temporarily store that here",
          "zh": ""
        },
        {
          "id": 52,
          "start": 191.25,
          "end": 193.143,
          "en": "so that we can use it later.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 194.04,
          "end": 198.25,
          "en": "But with that, we can delete useEffect here like this",
          "zh": ""
        },
        {
          "id": 54,
          "start": 199.392,
          "end": 201.603,
          "en": "and therefore have a much leaner component.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 203.1,
          "end": 206.13,
          "en": "And this component also would work now.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 206.13,
          "end": 208.44,
          "en": "If I comment out this code",
          "zh": ""
        },
        {
          "id": 57,
          "start": 208.44,
          "end": 211.473,
          "en": "so that we don't break this component here,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 213.18,
          "end": 214.98,
          "en": "and I save this,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 214.98,
          "end": 217.35,
          "en": "you will see that if I reload here",
          "zh": ""
        },
        {
          "id": 60,
          "start": 217.35,
          "end": 221.52,
          "en": "fetching those available places works just fine.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 221.52,
          "end": 222.96,
          "en": "We got no error here.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 222.96,
          "end": 226.14,
          "en": "Instead, the data is fetched and it is now fetched",
          "zh": ""
        },
        {
          "id": 63,
          "start": 226.14,
          "end": 227.973,
          "en": "with help of our custom hook.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 229.07999999999998,
          "end": 231.12,
          "en": "And as I also mentioned before,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 231.12,
          "end": 234.32999999999998,
          "en": "the usage of useFetch in this component",
          "zh": ""
        },
        {
          "id": 66,
          "start": 234.32999999999998,
          "end": 238.143,
          "en": "is totally independent from the usage in the app component.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 239.46,
          "end": 242.04,
          "en": "When I update the state in the app component,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 242.04,
          "end": 245.67,
          "en": "because I for example, add a new place here,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 245.67,
          "end": 249.39,
          "en": "that does not affect the available places",
          "zh": ""
        },
        {
          "id": 70,
          "start": 249.39,
          "end": 251.07,
          "en": "because as mentioned before,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 251.07,
          "end": 253.32,
          "en": "we have independent state values",
          "zh": ""
        },
        {
          "id": 72,
          "start": 253.32,
          "end": 257.133,
          "en": "created through independent copies of this useFetch hook.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 258.39,
          "end": 260.22,
          "en": "So that all works.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 260.22,
          "end": 263.58299999999997,
          "en": "But how can we bring back that sorting logic now?",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}