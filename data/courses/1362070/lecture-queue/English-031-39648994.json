{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "39648994",
      "title": "JSX & React Components [Core Concept]",
      "sourceHash": "7389e23e240de8cb2f0d81a671ce1307d096027e670fe1671c4d8dfe64f7bd32",
      "cues": [
        {
          "id": 1,
          "start": 0.45,
          "end": 2.67,
          "en": "So now with that starting project",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.67,
          "end": 3.57,
          "en": "up and running,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 3.57,
          "end": 6.39,
          "en": "you'll find a couple of files and folders",
          "zh": ""
        },
        {
          "id": 4,
          "start": 6.39,
          "end": 8.1,
          "en": "in that Project folder.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 8.1,
          "end": 8.97,
          "en": "For example,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 8.97,
          "end": 12.87,
          "en": "you'll find an index.html file in that folder.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 12.87,
          "end": 15.12,
          "en": "But if you open that file,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 15.12,
          "end": 17.55,
          "en": "you'll see that it's pretty empty, though.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 17.55,
          "end": 20.49,
          "en": "It only contains some basic markup,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 20.49,
          "end": 24.42,
          "en": "but it definitely does not contain the HTML code",
          "zh": ""
        },
        {
          "id": 11,
          "start": 24.42,
          "end": 27.03,
          "en": "that's responsible for displaying",
          "zh": ""
        },
        {
          "id": 12,
          "start": 27.03,
          "end": 29.52,
          "en": "the content we're seeing on the screen,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 29.52,
          "end": 32.37,
          "en": "the image, the title, and so on.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 32.37,
          "end": 33.96,
          "en": "And the reason for that, of course,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 33.96,
          "end": 38.67,
          "en": "is that React is rendering this content on the screen,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 38.67,
          "end": 40.47,
          "en": "that React is responsible",
          "zh": ""
        },
        {
          "id": 17,
          "start": 40.47,
          "end": 43.17,
          "en": "for bringing something onto the screen.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 43.17,
          "end": 46.74,
          "en": "And we can see in that index.html file,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 46.74,
          "end": 50.1,
          "en": "that it does indeed load a JavaScript file.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 50.1,
          "end": 53.46,
          "en": "It includes this index.jsx file.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 53.46,
          "end": 58.05,
          "en": "Now, let's ignore that strange extension .jsx for now,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 58.05,
          "end": 60.84,
          "en": "and instead take a look at that file.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 60.84,
          "end": 62.07,
          "en": "As we can see here,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 62.07,
          "end": 66.63,
          "en": "we find it in this src, this source folder.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 66.63,
          "end": 68.07,
          "en": "And if we open it,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 68.07,
          "end": 71.76,
          "en": "we do indeed find some JavaScript code in that file.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 71.76,
          "end": 75.57,
          "en": "But we still don't see anything that seems to be related",
          "zh": ""
        },
        {
          "id": 28,
          "start": 75.57,
          "end": 79.11,
          "en": "to that image or title we're seeing on the website.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 79.11,
          "end": 83.4,
          "en": "Instead, besides other things which we will explore later,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 83.4,
          "end": 88.4,
          "en": "this file imports something from the App.jsx file.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 88.92,
          "end": 92.28,
          "en": "And this file finally does contain",
          "zh": ""
        },
        {
          "id": 32,
          "start": 92.28,
          "end": 96.09,
          "en": "the markup for the content we're seeing on the screen.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 96.09,
          "end": 99.21000000000001,
          "en": "Though this file actually contains code,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 99.21000000000001,
          "end": 103.11,
          "en": "that might be a bit confusing if you take a closer look",
          "zh": ""
        },
        {
          "id": 35,
          "start": 103.11,
          "end": 107.03999999999999,
          "en": "because it seems to contain HTML code",
          "zh": ""
        },
        {
          "id": 36,
          "start": 107.03999999999999,
          "end": 109.22999999999999,
          "en": "inside of a JavaScript function,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 109.22999999999999,
          "end": 111.9,
          "en": "so inside of JavaScript code.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 111.9,
          "end": 116.9,
          "en": "And it also got this strange extension .jsx.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 117.03,
          "end": 121.17,
          "en": "Well, this file, as well as the index.jsx file,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 121.17,
          "end": 125.58,
          "en": "has this extension because it is a JavaScript file",
          "zh": ""
        },
        {
          "id": 41,
          "start": 125.58,
          "end": 129.18,
          "en": "that uses non-standard JavaScript syntax.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 129.18,
          "end": 130.29,
          "en": "To be precise,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 130.29,
          "end": 134.7,
          "en": "it uses a JavaScript syntax extension called JSX",
          "zh": ""
        },
        {
          "id": 44,
          "start": 134.7,
          "end": 136.68,
          "en": "which conveniently simply stands",
          "zh": ""
        },
        {
          "id": 45,
          "start": 136.68,
          "end": 139.32,
          "en": "for JavaScript Syntax Extension.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 139.32,
          "end": 142.62,
          "en": "And this extension allows developers",
          "zh": ""
        },
        {
          "id": 47,
          "start": 142.62,
          "end": 146.94,
          "en": "to describe and create HTML elements",
          "zh": ""
        },
        {
          "id": 48,
          "start": 146.94,
          "end": 151.913,
          "en": "by writing HTML markup code inside of JavaScript files.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 152.79,
          "end": 156.3,
          "en": "And since React will be about describing",
          "zh": ""
        },
        {
          "id": 50,
          "start": 156.3,
          "end": 161.07,
          "en": "and creating user interfaces and parts of user interfaces,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 161.07,
          "end": 163.323,
          "en": "this is a very useful feature.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 164.16,
          "end": 166.17000000000002,
          "en": "But whilst it is a nice feature",
          "zh": ""
        },
        {
          "id": 53,
          "start": 166.17000000000002,
          "end": 170.49,
          "en": "and therefore used in basically all React projects,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 170.49,
          "end": 174.15,
          "en": "and also many non-React projects,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 174.15,
          "end": 178.17000000000002,
          "en": "it is a feature that's not supported by browsers.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 178.17000000000002,
          "end": 183.06,
          "en": "So the code you see in the index.jsx and App.jsx files",
          "zh": ""
        },
        {
          "id": 57,
          "start": 183.06,
          "end": 185.91,
          "en": "would not work in browsers.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 185.91,
          "end": 189.75,
          "en": "Instead, the code you write as a React developer",
          "zh": ""
        },
        {
          "id": 59,
          "start": 189.75,
          "end": 194.31,
          "en": "is transformed behind the scenes by the development server,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 194.31,
          "end": 198.12,
          "en": "in this case here, before it reaches the browser.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 198.12,
          "end": 202.71,
          "en": "It's transformed to code that does work in the browser.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 202.71,
          "end": 206.7,
          "en": "But as a developer, thanks to this JSX extension,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 206.7,
          "end": 208.95,
          "en": "you have this more convenient way",
          "zh": ""
        },
        {
          "id": 64,
          "start": 208.95,
          "end": 212.01,
          "en": "of describing the user interface.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 212.01,
          "end": 217.01,
          "en": "But what's really important about this App.jsx file is",
          "zh": ""
        },
        {
          "id": 66,
          "start": 217.17000000000002,
          "end": 221.01,
          "en": "that what we can see here is a React Component.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 221.01,
          "end": 224.94,
          "en": "It is such a Component I mentioned in previous lectures.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 224.94,
          "end": 226.23,
          "en": "And as you can see,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 226.23,
          "end": 231.23,
          "en": "in React, a Component is really just a JavaScript function.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 232.05,
          "end": 234.3,
          "en": "Though in order to be recognized",
          "zh": ""
        },
        {
          "id": 71,
          "start": 234.3,
          "end": 237.06,
          "en": "and used as a Component by React,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 237.06,
          "end": 241.89,
          "en": "it's a function that must follow two important rules.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 241.89,
          "end": 246.89,
          "en": "The function name must start with an uppercase character",
          "zh": ""
        },
        {
          "id": 74,
          "start": 246.9,
          "end": 251.9,
          "en": "and the function must return a renderable value,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 251.91,
          "end": 255.93,
          "en": "typically the to-be-rendered HTML markup.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 255.93,
          "end": 259.02,
          "en": "So this JSX code you see here.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 259.02,
          "end": 261.09,
          "en": "And that's really all.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 261.09,
          "end": 265.05,
          "en": "This is how Components are created in React.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 265.05,
          "end": 268.23,
          "en": "You create a regular JavaScript function,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 268.23,
          "end": 269.49,
          "en": "give it a suitable name",
          "zh": ""
        },
        {
          "id": 81,
          "start": 269.49,
          "end": 272.13,
          "en": "that starts with an uppercase character",
          "zh": ""
        },
        {
          "id": 82,
          "start": 272.13,
          "end": 274.86,
          "en": "and returns some JSX code.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 274.86,
          "end": 275.82,
          "en": "And with that,",
          "zh": ""
        },
        {
          "id": 84,
          "start": 275.82,
          "end": 280.413,
          "en": "let's now finally create our first custom Component.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}