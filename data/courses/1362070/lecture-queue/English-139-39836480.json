  "lectures": [
    {
      "id": "39836480",
      "title": "Styling Buttons & Inputs with Tailwind CSS",
      "sourceHash": "50e30de17a61157cb1caca454a6d1c3e345b02fe9fccd9782f46585491cdcabd",
      "cues": [
        {
          "id": 1,
          "start": 0.84,
          "end": 3.273,
          "en": "Now to improve the styling here,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.38,
          "end": 6.87,
          "en": "I'll go back to my new project.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.87,
          "end": 10.56,
          "en": "And on this div, which wraps everything here",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.56,
          "end": 15.56,
          "en": "I'll add a width of 35rem.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 15.75,
          "end": 20.75,
          "en": "And this is how you can use Tailwind to set a custom value.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 20.94,
          "end": 23.49,
          "en": "So a custom width in this case",
          "zh": ""
        },
        {
          "id": 7,
          "start": 23.49,
          "end": 26.58,
          "en": "it's a special syntax supported by Tailwind,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 26.58,
          "end": 30.12,
          "en": "where you can include the value you wanna have",
          "zh": ""
        },
        {
          "id": 9,
          "start": 30.12,
          "end": 32.07,
          "en": "in that class name.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 32.07,
          "end": 33.63,
          "en": "And behind the scenes Tailwind",
          "zh": ""
        },
        {
          "id": 11,
          "start": 33.63,
          "end": 36.93,
          "en": "will then generate this class for you.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 36.93,
          "end": 38.55,
          "en": "That can be very useful",
          "zh": ""
        },
        {
          "id": 13,
          "start": 38.55,
          "end": 41.28,
          "en": "if you wanna assign a certain value",
          "zh": ""
        },
        {
          "id": 14,
          "start": 41.28,
          "end": 43.863,
          "en": "that's not built into Tailwind.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 44.91,
          "end": 48.76,
          "en": "And in addition, I'll add margin-top 16 here",
          "zh": ""
        },
        {
          "id": 16,
          "start": 49.71,
          "end": 53.01,
          "en": "so that this all gets pushed down a little bit",
          "zh": ""
        },
        {
          "id": 17,
          "start": 53.01,
          "end": 56.13,
          "en": "and is basically on the same level as this title here",
          "zh": ""
        },
        {
          "id": 18,
          "start": 56.13,
          "end": 57.273,
          "en": "in the sidebar.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 59.22,
          "end": 61.38,
          "en": "Now of course, we also need to style the content",
          "zh": ""
        },
        {
          "id": 20,
          "start": 61.38,
          "end": 64.29,
          "en": "in this new project component though.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 64.29,
          "end": 67.92,
          "en": "And here I'll start with my menu,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 67.92,
          "end": 70.11,
          "en": "where I also will add a class name here",
          "zh": ""
        },
        {
          "id": 23,
          "start": 70.11,
          "end": 72.69,
          "en": "to enable Flexbox here.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 72.69,
          "end": 75.42,
          "en": "Add items-center to make sure that these elements",
          "zh": ""
        },
        {
          "id": 25,
          "start": 75.42,
          "end": 77.733,
          "en": "are centered on the vertical axis,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 78.96000000000001,
          "end": 82.14,
          "en": "and add justify-end to push them all the way",
          "zh": ""
        },
        {
          "id": 27,
          "start": 82.14,
          "end": 84.69,
          "en": "to the end of the horizontal axis,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 84.69,
          "end": 86.253,
          "en": "so all the way to the right.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 87.09,
          "end": 90.536,
          "en": "Add a little bit of gap between those elements",
          "zh": ""
        },
        {
          "id": 30,
          "start": 90.536,
          "end": 94.14,
          "en": "and a vertical margin to the top and bottom of one rem",
          "zh": ""
        },
        {
          "id": 31,
          "start": 94.14,
          "end": 96.08,
          "en": "with my-4.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 98.85,
          "end": 102.27000000000001,
          "en": "With that, those buttons sit here.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 102.27000000000001,
          "end": 104.68,
          "en": "Now of course, I also wanna make sure",
          "zh": ""
        },
        {
          "id": 34,
          "start": 104.68,
          "end": 107.553,
          "en": "that these buttons look more like buttons.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 109.47,
          "end": 112.74000000000001,
          "en": "And for that, I'll start with the first button here,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 112.74000000000001,
          "end": 115.68,
          "en": "the cancel button, which I'll give a class name",
          "zh": ""
        },
        {
          "id": 37,
          "start": 115.68,
          "end": 120,
          "en": "of text-stone-800 to give it a dark gray button,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 120,
          "end": 123.3,
          "en": "not black color and a hover style",
          "zh": ""
        },
        {
          "id": 39,
          "start": 123.3,
          "end": 126.419,
          "en": "where all set it to a darker gray color,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 126.419,
          "end": 128.643,
          "en": "an almost black color.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 130.35,
          "end": 132.93,
          "en": "With that, of course this button doesn't look too different",
          "zh": ""
        },
        {
          "id": 42,
          "start": 132.93,
          "end": 134.52,
          "en": "but it's now the second button,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 134.52,
          "end": 136.89,
          "en": "which I'll style differently.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 136.89,
          "end": 140.22,
          "en": "The first button is meant to be a rather flat",
          "zh": ""
        },
        {
          "id": 45,
          "start": 140.22,
          "end": 141.93,
          "en": "not too obvious button",
          "zh": ""
        },
        {
          "id": 46,
          "start": 141.93,
          "end": 145.2,
          "en": "because it cancels the creation of a project,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 145.2,
          "end": 147.78300000000002,
          "en": "but the save button should be more obvious.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 148.8,
          "end": 150.78,
          "en": "Therefore, here we of course also need",
          "zh": ""
        },
        {
          "id": 49,
          "start": 150.78,
          "end": 153.78,
          "en": "to add some classes to it.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 153.78,
          "end": 156.48,
          "en": "And I'll start by adding a background color,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 156.48,
          "end": 159.18,
          "en": "a dark gray background color,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 159.18,
          "end": 162.3,
          "en": "and give it a text color of text-stone-50,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 162.3,
          "end": 164.583,
          "en": "so an almost white text color.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 166.44,
          "end": 169.17000000000002,
          "en": "Upon hovering, I wanna change the background color",
          "zh": ""
        },
        {
          "id": 55,
          "start": 169.17000000000002,
          "end": 170.97,
          "en": "to an even darker gray,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 170.97,
          "end": 174.93,
          "en": "the same gray I used for the text on the first button.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 174.93,
          "end": 177.66,
          "en": "And in addition, maybe here at the beginning",
          "zh": ""
        },
        {
          "id": 58,
          "start": 177.66,
          "end": 179.85,
          "en": "though the position doesn't matter,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 179.85,
          "end": 182.16,
          "en": "I'll add some margin to the left and right",
          "zh": ""
        },
        {
          "id": 60,
          "start": 182.16,
          "end": 183.79,
          "en": "and to the top and bottom",
          "zh": ""
        },
        {
          "id": 61,
          "start": 184.68,
          "end": 187.39,
          "en": "and give this button rounded corners like this",
          "zh": ""
        },
        {
          "id": 62,
          "start": 189.24,
          "end": 193.86599999999999,
          "en": "so that in the end, this here is my list of classes",
          "zh": ""
        },
        {
          "id": 63,
          "start": 193.86599999999999,
          "end": 196.743,
          "en": "that are added to the second button.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 198.6,
          "end": 200.063,
          "en": "With that, if I save that",
          "zh": ""
        },
        {
          "id": 65,
          "start": 200.063,
          "end": 203.16,
          "en": "this is the button with this nice hover effect.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 203.16,
          "end": 206.28300000000002,
          "en": "And we can therefore next work on these inputs here.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 207.32999999999998,
          "end": 208.35,
          "en": "Now for the inputs,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 208.35,
          "end": 211.82999999999998,
          "en": "we of course have to go to the Input.jsx file.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 211.82999999999998,
          "end": 214.713,
          "en": "And in there I'll start with the paragraph.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 215.73,
          "end": 219.87,
          "en": "On that paragraph, I'll add the flex class again",
          "zh": ""
        },
        {
          "id": 71,
          "start": 219.87,
          "end": 221.73,
          "en": "to again use Flexbox.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 221.73,
          "end": 224.76,
          "en": "But now make sure that Flexbox positions elements",
          "zh": ""
        },
        {
          "id": 73,
          "start": 224.76,
          "end": 228.273,
          "en": "along the vertical axis by adding flex-col,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 229.2,
          "end": 232.503,
          "en": "adding some gap and some margin to the top and bottom,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 234.48,
          "end": 238.353,
          "en": "and then on the label here, we also need some classes.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 239.22,
          "end": 241.44,
          "en": "For example, I want to make the text smaller",
          "zh": ""
        },
        {
          "id": 77,
          "start": 241.44,
          "end": 244.08,
          "en": "by adding the text-sm class,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 244.08,
          "end": 246.153,
          "en": "which reduces the font size.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 247.83,
          "end": 250.803,
          "en": "I'll make it bold and uppercase though,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 251.94,
          "end": 253.59,
          "en": "and I'll change the color",
          "zh": ""
        },
        {
          "id": 81,
          "start": 253.59,
          "end": 257.493,
          "en": "to a middle grayish color, I guess.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 259.89,
          "end": 262.89300000000003,
          "en": "So that if we save that the labels look like this.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 264.18,
          "end": 266.34,
          "en": "Now the inputs are pretty hard to see",
          "zh": ""
        },
        {
          "id": 84,
          "start": 266.34,
          "end": 268.473,
          "en": "and therefore we also wanna style those.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 269.4,
          "end": 272.04,
          "en": "I'll start with the text area",
          "zh": ""
        },
        {
          "id": 86,
          "start": 272.04,
          "end": 274.02,
          "en": "and I'll give it a class of w-full",
          "zh": ""
        },
        {
          "id": 87,
          "start": 274.02,
          "end": 276.963,
          "en": "to make sure that it takes the entire available width.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 278.67,
          "end": 283.67,
          "en": "Give it a padding in all directions of 0.25rem",
          "zh": ""
        },
        {
          "id": 89,
          "start": 284.19,
          "end": 286.233,
          "en": "with the p-1 class.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 288.54,
          "end": 292.74,
          "en": "A border to the bottom with a width of two pixels",
          "zh": ""
        },
        {
          "id": 91,
          "start": 292.74,
          "end": 294.903,
          "en": "with border-b-2,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 296.1,
          "end": 301.1,
          "en": "rounded corners, and a border color of stone-300",
          "zh": ""
        },
        {
          "id": 93,
          "start": 303.42,
          "end": 305.763,
          "en": "by adding border-stone-300.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 310.62,
          "end": 313.74,
          "en": "In addition, I wanna have a background color of stone-200",
          "zh": ""
        },
        {
          "id": 95,
          "start": 313.74,
          "end": 315.783,
          "en": "with bg-stone-200,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 316.71,
          "end": 319.83299999999997,
          "en": "and a text color of text-stone-600.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 322.59,
          "end": 325.304,
          "en": "Last but not least, I also wanna set a certain style",
          "zh": ""
        },
        {
          "id": 98,
          "start": 325.304,
          "end": 328.14,
          "en": "when this input gets focused.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 328.14,
          "end": 331.38,
          "en": "For example, I want to disable the default outline",
          "zh": ""
        },
        {
          "id": 100,
          "start": 331.38,
          "end": 333.573,
          "en": "with focus outline-none,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 335.01,
          "end": 339,
          "en": "and instead make sure that the border color changes",
          "zh": ""
        },
        {
          "id": 102,
          "start": 339,
          "end": 343.173,
          "en": "if we focus with focus border-stone-600.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 345.93,
          "end": 348.205,
          "en": "So with that, I got many classes on that text area",
          "zh": ""
        },
        {
          "id": 104,
          "start": 348.205,
          "end": 350.90999999999997,
          "en": "but now the text area looks like that",
          "zh": ""
        },
        {
          "id": 105,
          "start": 350.90999999999997,
          "end": 353.253,
          "en": "and therefore I'd say quite decent.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 354.93,
          "end": 359.67,
          "en": "Now I do want to apply the exact same classes to my input,",
          "zh": ""
        },
        {
          "id": 107,
          "start": 359.67,
          "end": 362.25,
          "en": "and therefore I'll grab that string",
          "zh": ""
        },
        {
          "id": 108,
          "start": 362.25,
          "end": 365.52,
          "en": "and actually store it in a constant,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 365.52,
          "end": 368.673,
          "en": "classes could be a fitting name, like this.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 370.86,
          "end": 374.88,
          "en": "And now just assign my classes here to the text area",
          "zh": ""
        },
        {
          "id": 111,
          "start": 374.88,
          "end": 378.693,
          "en": "and then thereafter also like this to the input.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 380.25,
          "end": 383.49,
          "en": "So that this here is my finished Input component",
          "zh": ""
        },
        {
          "id": 113,
          "start": 383.49,
          "end": 386.01,
          "en": "with all those classes here being added",
          "zh": ""
        },
        {
          "id": 114,
          "start": 386.01,
          "end": 388.803,
          "en": "to both the text area and the input.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 390.3,
          "end": 392.49,
          "en": "And therefore if we save this now,",
          "zh": ""
        },
        {
          "id": 116,
          "start": 392.49,
          "end": 395.223,
          "en": "that's looking quite decent here, I'd say.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 396.78,
          "end": 398.94,
          "en": "The next step, therefore of course,",
          "zh": ""
        },
        {
          "id": 118,
          "start": 398.94,
          "end": 401.88,
          "en": "is to make sure that we open this",
          "zh": ""
        },
        {
          "id": 119,
          "start": 401.88,
          "end": 404.44,
          "en": "when this add project button is clicked",
          "zh": ""
        },
        {
          "id": 120,
          "start": 405.36,
          "end": 408.51,
          "en": "and that we show some fallback content",
          "zh": ""
        },
        {
          "id": 121,
          "start": 408.51,
          "end": 411.36,
          "en": "if the button was not clicked yet.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 411.36,
          "end": 415.17,
          "en": "And thereafter, of course, that we fetch the values entered",
          "zh": ""
        },
        {
          "id": 123,
          "start": 415.17,
          "end": 419.13,
          "en": "by the user and we actually create a new project.",
          "zh": ""
        },
        {
          "id": 124,
          "start": 419.13,
          "end": 421.833,
          "en": "But let's start with the fallback content.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}