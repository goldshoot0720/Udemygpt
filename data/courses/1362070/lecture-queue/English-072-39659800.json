{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "39659800",
      "title": "Lifting State Up [Core Concept]",
      "sourceHash": "b8279870ee3035736fcb149ac09d1d1ca44ee2d9e372a60f804e4a1ce7dbd525",
      "cues": [
        {
          "id": 1,
          "start": 2.1,
          "end": 5.52,
          "en": "So now that we have this basic game board,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 5.52,
          "end": 9.09,
          "en": "it's time to make sure that we actually switch",
          "zh": ""
        },
        {
          "id": 3,
          "start": 9.09,
          "end": 10.5,
          "en": "between these two players",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.5,
          "end": 13.41,
          "en": "so that they take different turns",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.41,
          "end": 16.08,
          "en": "and that we place the symbol of the player",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.08,
          "end": 18.63,
          "en": "who's currently active on a button",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.63,
          "end": 20.73,
          "en": "when the button is pressed.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.73,
          "end": 23.55,
          "en": "And in addition, it would also be nice",
          "zh": ""
        },
        {
          "id": 9,
          "start": 23.55,
          "end": 26.7,
          "en": "if the active player would be highlighted,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 26.7,
          "end": 29.07,
          "en": "for example by placing a border",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.07,
          "end": 31.263,
          "en": "around the player name up here.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.73,
          "end": 37.73,
          "en": "Now I did actually already prepare some CSS styles for that.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 38.31,
          "end": 42.21,
          "en": "There is a highlight-player CSS class",
          "zh": ""
        },
        {
          "id": 14,
          "start": 42.21,
          "end": 46.59,
          "en": "that can be added to this ordered list",
          "zh": ""
        },
        {
          "id": 15,
          "start": 46.59,
          "end": 48.363,
          "en": "that has the player's id.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 49.35,
          "end": 51.78,
          "en": "And if that class is added here,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 51.78,
          "end": 55.08,
          "en": "the active player is highlighted.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 55.08,
          "end": 58.05,
          "en": "And the active player is highlighted",
          "zh": ""
        },
        {
          "id": 19,
          "start": 58.05,
          "end": 62.49,
          "en": "with help of another CSS class, the active class,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 62.49,
          "end": 65.01,
          "en": "that should be placed on the list item",
          "zh": ""
        },
        {
          "id": 21,
          "start": 65.01,
          "end": 68.43,
          "en": "of the player that is currently active.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 68.43,
          "end": 71.03999999999999,
          "en": "And this has one important implication.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 71.03999999999999,
          "end": 73.28999999999999,
          "en": "It means that we need to know",
          "zh": ""
        },
        {
          "id": 24,
          "start": 73.28999999999999,
          "end": 76.5,
          "en": "about the currently active player",
          "zh": ""
        },
        {
          "id": 25,
          "start": 76.5,
          "end": 79.28999999999999,
          "en": "in both this Player component",
          "zh": ""
        },
        {
          "id": 26,
          "start": 79.28999999999999,
          "end": 81.78,
          "en": "and in the GameBoard component",
          "zh": ""
        },
        {
          "id": 27,
          "start": 81.78,
          "end": 85.53,
          "en": "because here we need the symbol of the active player.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 85.53,
          "end": 87.48,
          "en": "And here in the Player component,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 87.48,
          "end": 92.00999999999999,
          "en": "we want to add a CSS class to this list item dynamically.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 92.00999999999999,
          "end": 93.6,
          "en": "And that's of course a problem",
          "zh": ""
        },
        {
          "id": 31,
          "start": 93.6,
          "end": 96.45,
          "en": "because these are two separate components.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 96.45,
          "end": 97.65,
          "en": "How can we make sure",
          "zh": ""
        },
        {
          "id": 33,
          "start": 97.65,
          "end": 101.03999999999999,
          "en": "that they both have access to the information",
          "zh": ""
        },
        {
          "id": 34,
          "start": 101.03999999999999,
          "end": 103.83,
          "en": "which player is currently active.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 103.83,
          "end": 107.75999999999999,
          "en": "Well, in cases like this, which are super common,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 107.75999999999999,
          "end": 110.49000000000001,
          "en": "we need to do something which is called,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 110.49000000000001,
          "end": 112.95,
          "en": "lifting the state up.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 112.95,
          "end": 115.77000000000001,
          "en": "Instead of managing the information",
          "zh": ""
        },
        {
          "id": 39,
          "start": 115.77000000000001,
          "end": 119.07,
          "en": "which player is currently active in the GameBoard",
          "zh": ""
        },
        {
          "id": 40,
          "start": 119.07,
          "end": 120.63,
          "en": "or the Player component,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 120.63,
          "end": 123.6,
          "en": "which would not be enough for the reasons mentioned,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 123.6,
          "end": 125.58,
          "en": "we need to manage the state",
          "zh": ""
        },
        {
          "id": 43,
          "start": 125.58,
          "end": 128.37,
          "en": "in the closest ancestor component",
          "zh": ""
        },
        {
          "id": 44,
          "start": 128.37,
          "end": 131.16,
          "en": "that has access to both components",
          "zh": ""
        },
        {
          "id": 45,
          "start": 131.16,
          "end": 132.96,
          "en": "that need that information.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 132.96,
          "end": 135.69,
          "en": "So in this case, the App component.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 135.69,
          "end": 140.19,
          "en": "Because the App component can then pass the information",
          "zh": ""
        },
        {
          "id": 48,
          "start": 140.19,
          "end": 141.96,
          "en": "which player is currently active",
          "zh": ""
        },
        {
          "id": 49,
          "start": 141.96,
          "end": 146.643,
          "en": "to both the Player and the GameBoard components via props.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 147.48,
          "end": 152.41,
          "en": "So therefore, we should add some state here with useState",
          "zh": ""
        },
        {
          "id": 51,
          "start": 153.96,
          "end": 158.433,
          "en": "in the App component and manage the active player here.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 160.77,
          "end": 162.78,
          "en": "Now here we could start by making sure",
          "zh": ""
        },
        {
          "id": 53,
          "start": 162.78,
          "end": 165.6,
          "en": "that the player with the symbol X",
          "zh": ""
        },
        {
          "id": 54,
          "start": 165.6,
          "end": 167.883,
          "en": "is the active player initially,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 170.57999999999998,
          "end": 174.54,
          "en": "and we can add a setActivePlayer state updating function",
          "zh": ""
        },
        {
          "id": 56,
          "start": 174.54,
          "end": 177.483,
          "en": "to then change that active player state.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 179.49,
          "end": 181.17,
          "en": "Now we need a function",
          "zh": ""
        },
        {
          "id": 58,
          "start": 181.17,
          "end": 185.16,
          "en": "that should be executed whenever we wanna switch turns",
          "zh": ""
        },
        {
          "id": 59,
          "start": 185.16,
          "end": 187.61,
          "en": "and therefore we could name it handleSelectSquare",
          "zh": ""
        },
        {
          "id": 60,
          "start": 189.78,
          "end": 193.53,
          "en": "because in the end, it is after selecting a square",
          "zh": ""
        },
        {
          "id": 61,
          "start": 193.53,
          "end": 196.473,
          "en": "in our grid that we wanna change turns.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 197.67000000000002,
          "end": 198.93,
          "en": "And in that function,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 198.93,
          "end": 201.72,
          "en": "we wanna update the active player state",
          "zh": ""
        },
        {
          "id": 64,
          "start": 201.72,
          "end": 204.15,
          "en": "by calling setActivePlayer.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 204.15,
          "end": 206.61,
          "en": "And we wanna check if it's currently an X,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 206.61,
          "end": 208.17000000000002,
          "en": "we wanna change it to O.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 208.17000000000002,
          "end": 210.57,
          "en": "If it's an O, we want to change it to X",
          "zh": ""
        },
        {
          "id": 68,
          "start": 210.57,
          "end": 213.72,
          "en": "and therefore the new state depends on the old state",
          "zh": ""
        },
        {
          "id": 69,
          "start": 213.72,
          "end": 215.55,
          "en": "and therefore just as before,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 215.55,
          "end": 219.16,
          "en": "we should pass this function here to setActivePlayer",
          "zh": ""
        },
        {
          "id": 71,
          "start": 220.02,
          "end": 222.09,
          "en": "and we get the currently active player",
          "zh": ""
        },
        {
          "id": 72,
          "start": 222.09,
          "end": 225,
          "en": "as an input automatically as you learned.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 225,
          "end": 228.78,
          "en": "And then here we could check with a turnery expression",
          "zh": ""
        },
        {
          "id": 74,
          "start": 228.78,
          "end": 231.66,
          "en": "if the currently active player is the player",
          "zh": ""
        },
        {
          "id": 75,
          "start": 231.66,
          "end": 233.57999999999998,
          "en": "with the symbol X,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 233.57999999999998,
          "end": 237.54,
          "en": "in which case we want to set the new state to an O.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 237.54,
          "end": 240.813,
          "en": "And otherwise if it is an O, we wanna set it to an X.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 242.7,
          "end": 244.77,
          "en": "Now we just also need to make sure",
          "zh": ""
        },
        {
          "id": 79,
          "start": 244.77,
          "end": 248.34,
          "en": "that handleSelectSquare gets executed",
          "zh": ""
        },
        {
          "id": 80,
          "start": 248.34,
          "end": 250.92,
          "en": "when a square was selected.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 250.92,
          "end": 254.04,
          "en": "And of course, squares do get selected here",
          "zh": ""
        },
        {
          "id": 82,
          "start": 254.04,
          "end": 256.203,
          "en": "in our GameBoard component.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 257.82,
          "end": 261.45,
          "en": "Therefore, in there it makes sense to accept some props",
          "zh": ""
        },
        {
          "id": 84,
          "start": 261.45,
          "end": 264.06,
          "en": "and use props destructuring here",
          "zh": ""
        },
        {
          "id": 85,
          "start": 264.06,
          "end": 267.36,
          "en": "to get a prop that could be named onSelectSquare",
          "zh": ""
        },
        {
          "id": 86,
          "start": 269.79,
          "end": 271.17,
          "en": "or something like this.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 271.17,
          "end": 272.58,
          "en": "The name, of course, is up to you",
          "zh": ""
        },
        {
          "id": 88,
          "start": 272.58,
          "end": 274.203,
          "en": "because it's your component.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 275.22,
          "end": 277.71,
          "en": "And I wanna call this function",
          "zh": ""
        },
        {
          "id": 90,
          "start": 277.71,
          "end": 280.02,
          "en": "from inside handleSelectSquare",
          "zh": ""
        },
        {
          "id": 91,
          "start": 280.02,
          "end": 281.94,
          "en": "because this function is triggered",
          "zh": ""
        },
        {
          "id": 92,
          "start": 281.94,
          "end": 284.973,
          "en": "if a square was selected by clicking this button.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 286.14,
          "end": 288.46,
          "en": "And here we then wanna call onSelectSquare",
          "zh": ""
        },
        {
          "id": 94,
          "start": 290.1,
          "end": 292.86,
          "en": "so that in the end we're executing a function",
          "zh": ""
        },
        {
          "id": 95,
          "start": 292.86,
          "end": 296.52,
          "en": "that's defined outside of this GameBoard component",
          "zh": ""
        },
        {
          "id": 96,
          "start": 296.52,
          "end": 299.15999999999997,
          "en": "from inside this GameBoard component",
          "zh": ""
        },
        {
          "id": 97,
          "start": 299.15999999999997,
          "end": 302.04,
          "en": "because the value for this onSelectSquare prop,",
          "zh": ""
        },
        {
          "id": 98,
          "start": 302.04,
          "end": 303.51,
          "en": "of course should be a function",
          "zh": ""
        },
        {
          "id": 99,
          "start": 303.51,
          "end": 306.06,
          "en": "and we're executing this function here.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 306.06,
          "end": 309,
          "en": "But the function that will be executed is now defined",
          "zh": ""
        },
        {
          "id": 101,
          "start": 309,
          "end": 310.47,
          "en": "in the App component",
          "zh": ""
        },
        {
          "id": 102,
          "start": 310.47,
          "end": 311.37,
          "en": "because there,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 311.37,
          "end": 313.92,
          "en": "it's this handleSelectSquare function we added",
          "zh": ""
        },
        {
          "id": 104,
          "start": 313.92,
          "end": 315.96,
          "en": "just a couple of minutes ago.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 315.96,
          "end": 317.55,
          "en": "So this should be the value",
          "zh": ""
        },
        {
          "id": 106,
          "start": 317.55,
          "end": 321.55,
          "en": "that's set for this newly added onSelectSquare prop",
          "zh": ""
        },
        {
          "id": 107,
          "start": 322.89,
          "end": 323.733,
          "en": "like this.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 324.6,
          "end": 328.38,
          "en": "And with that, this code here should execute",
          "zh": ""
        },
        {
          "id": 109,
          "start": 328.38,
          "end": 330.69,
          "en": "whenever one of these buttons is pressed",
          "zh": ""
        },
        {
          "id": 110,
          "start": 330.69,
          "end": 332.04,
          "en": "because we make sure",
          "zh": ""
        },
        {
          "id": 111,
          "start": 332.04,
          "end": 335.43,
          "en": "that we execute this handleSelectSquare function",
          "zh": ""
        },
        {
          "id": 112,
          "start": 335.43,
          "end": 337.773,
          "en": "from inside the GameBoard component.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 339.72,
          "end": 343.65,
          "en": "And with that, we're switching the active player",
          "zh": ""
        },
        {
          "id": 114,
          "start": 343.65,
          "end": 348.24,
          "en": "and we can now therefore do two important things.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 348.24,
          "end": 353.24,
          "en": "First, we can add a class name here to this ordered list",
          "zh": ""
        },
        {
          "id": 116,
          "start": 353.25,
          "end": 357.15,
          "en": "and add this highlight-players",
          "zh": ""
        },
        {
          "id": 117,
          "start": 357.15,
          "end": 361.39,
          "en": "or highlight-player as it's called CSS class here",
          "zh": ""
        },
        {
          "id": 118,
          "start": 362.58,
          "end": 363.963,
          "en": "to this ordered list.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 364.8,
          "end": 367.41,
          "en": "And then we wanna pass the information",
          "zh": ""
        },
        {
          "id": 120,
          "start": 367.41,
          "end": 371.213,
          "en": "whether it's this or this player that's currently active",
          "zh": ""
        },
        {
          "id": 121,
          "start": 371.213,
          "end": 373.95,
          "en": "to this Player component.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 373.95,
          "end": 377.1,
          "en": "So that in there, we get this information,",
          "zh": ""
        },
        {
          "id": 123,
          "start": 377.1,
          "end": 380.11,
          "en": "let's say through an isActive prop",
          "zh": ""
        },
        {
          "id": 124,
          "start": 381.03,
          "end": 383.07,
          "en": "that we can add and destructure here",
          "zh": ""
        },
        {
          "id": 125,
          "start": 383.07,
          "end": 385.02,
          "en": "in the Player component.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 385.02,
          "end": 388.41,
          "en": "And we can use this as active prop now here",
          "zh": ""
        },
        {
          "id": 127,
          "start": 388.41,
          "end": 392.47,
          "en": "to add a class name dynamically to this list item",
          "zh": ""
        },
        {
          "id": 128,
          "start": 393.33,
          "end": 395.79,
          "en": "by checking if isActive is true.",
          "zh": ""
        },
        {
          "id": 129,
          "start": 395.79,
          "end": 396.78,
          "en": "And if that's the case,",
          "zh": ""
        },
        {
          "id": 130,
          "start": 396.78,
          "end": 401.37,
          "en": "we want to add the active class, otherwise it's undefined",
          "zh": ""
        },
        {
          "id": 131,
          "start": 401.37,
          "end": 404.193,
          "en": "because otherwise I don't want to add any class.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 406.29,
          "end": 409.65,
          "en": "So with that, we're adding this active class conditionally",
          "zh": ""
        },
        {
          "id": 133,
          "start": 409.65,
          "end": 411.033,
          "en": "to this list item.",
          "zh": ""
        },
        {
          "id": 134,
          "start": 411.96,
          "end": 413.79,
          "en": "And back in the App component,",
          "zh": ""
        },
        {
          "id": 135,
          "start": 413.79,
          "end": 414.65999999999997,
          "en": "we now just have",
          "zh": ""
        },
        {
          "id": 136,
          "start": 414.65999999999997,
          "end": 419.28,
          "en": "to add this newly accepted isActive prop here",
          "zh": ""
        },
        {
