        },
        {
          "id": 80,
          "start": 234.9,
          "end": 237.03,
          "en": "And of course there would be alternative ways",
          "zh": ""
        },
        {
          "id": 81,
          "start": 237.03,
          "end": 239.67000000000002,
          "en": "of writing this code but I chose an approach",
