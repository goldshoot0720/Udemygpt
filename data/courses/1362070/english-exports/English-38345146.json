          "id": 57,
          "start": 161.49,
          "end": 164.46,
          "en": "clicked and then in this function,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 164.46,
          "end": 167.04,
          "en": "I'm in the end ensuring that the clicked button",
