          "id": 123,
          "start": 375.57,
          "end": 377.79,
          "en": "and JavaScript code.",
          "zh": ""
        },
        {
          "id": 124,
          "start": 377.79,
          "end": 380.04,
          "en": "And if you then take a look at this HTML code",
          "zh": ""
        },
        {
          "id": 125,
          "start": 380.04,
          "end": 383.13,
          "en": "you'll see that in here in this app.js file,",
          "zh": ""
        },
        {
          "id": 126,
          "start": 383.13,
          "end": 386.73,
          "en": "we in the end got all the HTML code with this header",
          "zh": ""
        },
        {
          "id": 127,
          "start": 386.73,
          "end": 390.33,
          "en": "and these buttons and this unordered list,",
          "zh": ""
        },
        {
          "id": 128,
          "start": 390.33,
          "end": 393.81,
          "en": "that we before found in this index HTML file",
          "zh": ""
        },
        {
          "id": 129,
          "start": 393.81,
          "end": 396.69,
          "en": "when working with vanilla JavaScript.",
          "zh": ""
        },
        {
          "id": 130,
          "start": 396.69,
          "end": 399.54,
          "en": "Now it's all that one single JavaScript file,",
          "zh": ""
        },
        {
          "id": 131,
