          "id": 18,
          "start": 50.07,
          "end": 53.88,
          "en": "cloud-based code editor and development environment",
          "zh": ""
        },
        {
          "id": 19,
          "start": 53.88,
          "end": 57.9,
          "en": "which allows you to, for example, work on React projects",
          "zh": ""
        },
        {
          "id": 20,
          "start": 57.9,
