        {
          "id": 3,
          "start": 8.16,
          "end": 11.61,
          "en": "like React is better, because React offers",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.61,
          "end": 14.97,
          "en": "a simpler mental model and provides an easier way",
          "zh": ""
        },
        {
          "id": 5,
          "start": 14.97,
          "end": 17.97,
          "en": "of building complex web applications",
