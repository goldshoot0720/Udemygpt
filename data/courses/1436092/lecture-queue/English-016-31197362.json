        },
        {
          "id": 3,
          "start": 6.75,
          "end": 9.46,
          "en": "which is the container of text input and button,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.46,
          "end": 12.433,
          "en": "to control how these two elements are positioned,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.34,
          "end": 16.06,
          "en": "because you learned flex box is a concept",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.06,
          "end": 18.62,
          "en": "that is applied to container elements",
