        },
        {
          "id": 35,
          "start": 105.05,
          "end": 106.94,
          "en": "in depth in the next lecture,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 106.94,
          "end": 109.82,
          "en": "but justify content basically controls",
          "zh": ""
        },
        {
          "id": 37,
          "start": 109.82,
          "end": 114.19,
          "en": "how these elements are distributed in the row or column",
          "zh": ""
        },
        {
          "id": 38,
          "start": 114.19,
          "end": 117.62299999999999,
          "en": "depending on what the value here is that they are part of.",
