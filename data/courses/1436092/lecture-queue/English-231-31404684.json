        },
        {
          "id": 63,
          "start": 171.09,
          "end": 175.78,
          "en": "you find an asset zip file which holds three PNG files",
          "zh": ""
        },
        {
          "id": 64,
          "start": 175.78,
          "end": 178.11,
          "en": "which you can just drag and drop",
