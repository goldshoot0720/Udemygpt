      "sourceHash": "7f89012f53c96bc1a84985b9ee1570e5a98060873775a2e338378bf59a40ddcf",
      "cues": [
        {
          "id": 1,
          "start": 2.04,
          "end": 3.14,
          "en": "So let's now see",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.14,
          "end": 5.87,
          "en": "how we can send push notifications.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.87,
          "end": 9.5,
          "en": "And before we add some code to send push notifications",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.5,
          "end": 11.11,
          "en": "from inside this app",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.11,
          "end": 14.52,
          "en": "I wanna show you a nice service provided by Expo",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.52,
          "end": 17.573,
          "en": "which you can use for testing push notifications.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.44,
          "end": 22.52,
          "en": "You also find this service in the official Expo docs",
          "zh": ""
        },
        {
          "id": 8,
          "start": 23.8,
          "end": 28.34,
          "en": "and use this push notification tool provided by Expo,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 28.34,
          "end": 33.34,
          "en": "which you can also find by visiting expo.dev/notifications.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 33.52,
          "end": 36.67,
          "en": "And in this tool, you can enter such a push token",
          "zh": ""
        },
        {
          "id": 11,
          "start": 36.67,
          "end": 39.543,
          "en": "which we saw in the terminal a couple of seconds ago.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 40.6,
          "end": 43.06,
          "en": "And then also add a title, body,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 43.06,
          "end": 45.48,
          "en": "some extra data you might want to deliver.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 45.48,
          "end": 50.1,
          "en": "And some other settings to test sending push notifications",
          "zh": ""
        },
        {
          "id": 15,
          "start": 50.1,
          "end": 54.57,
          "en": "to specific devices, which have your app installed on them,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 54.57,
          "end": 56.423,
          "en": "with help of this testing tool.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 57.58,
          "end": 59.29,
          "en": "So therefore what I will do here",
          "zh": ""
        },
        {
          "id": 18,
          "start": 59.29,
          "end": 63.74,
          "en": "is I will grab this push token from my device,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 63.74,
          "end": 66.37,
          "en": "from my real iPhone device here.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 66.37,
          "end": 69.74,
          "en": "And I will insert this here in this push token field.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 69.74,
          "end": 74.14,
          "en": "The full token, including this ExponentPushToken part.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 74.14,
          "end": 75.78,
          "en": "We don't need the access token,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 75.78,
          "end": 80.423,
          "en": "but I'll add a title of Test and a body of This is a test!",
          "zh": ""
        },
        {
          "id": 24,
          "start": 82.21000000000001,
          "end": 84.32,
          "en": "I'll ignore all the other fields.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 84.32,
          "end": 87.21000000000001,
          "en": "And then I'll try to send a notification.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 87.21000000000001,
          "end": 89.32,
          "en": "So now here on my iPhone",
          "zh": ""
        },
        {
          "id": 27,
          "start": 89.32,
          "end": 92.87,
          "en": "let's see whether I get this notification when testing this.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 92.87,
          "end": 93.97999999999999,
          "en": "Here it is.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 93.97999999999999,
          "end": 96.02000000000001,
          "en": "This notification which appeared here",
          "zh": ""
        },
        {
          "id": 30,
          "start": 96.02000000000001,
          "end": 97.72999999999999,
          "en": "is this push notification",
          "zh": ""
        },
        {
          "id": 31,
          "start": 97.72999999999999,
          "end": 102.25,
          "en": "sent with help of this testing service provided by Expo.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 102.25,
          "end": 103.93,
          "en": "So that did work here.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 103.93,
          "end": 106.52000000000001,
          "en": "We did get this push notification",
          "zh": ""
        },
        {
          "id": 34,
          "start": 106.52000000000001,
          "end": 110.03999999999999,
          "en": "and this already shows us we can configure our device",
          "zh": ""
        },
        {
          "id": 35,
          "start": 110.03999999999999,
          "end": 112.47999999999999,
          "en": "for getting push notifications",
          "zh": ""
        },
        {
          "id": 36,
          "start": 112.47999999999999,
          "end": 116.49000000000001,
          "en": "and how we can send such testing notifications.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 116.49000000000001,
          "end": 118.53,
          "en": "But of course, testing is nice.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 118.53,
          "end": 123.53,
          "en": "We might also want to send notifications from inside device.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 123.81,
          "end": 125.66,
          "en": "We also might want to send",
          "zh": ""
        },
        {
          "id": 40,
          "start": 125.66,
          "end": 128.17,
          "en": "notifications programmatically instead,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 128.17,
          "end": 130.93,
          "en": "and that's of course also possible.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 130.93,
          "end": 131.763,
          "en": "Now when it comes",
          "zh": ""
        },
        {
          "id": 43,
          "start": 131.763,
          "end": 134.81,
          "en": "to sending push notifications programmatically,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 134.81,
          "end": 137.21,
          "en": "my strong recommendation is to take a look",
          "zh": ""
        },
        {
          "id": 45,
          "start": 137.21,
          "end": 138.96,
          "en": "at the official documentation,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 138.96,
          "end": 140.57999999999998,
          "en": "because as mentioned before,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 140.57999999999998,
          "end": 142.61,
          "en": "there you also learn how to do this",
          "zh": ""
        },
        {
          "id": 48,
          "start": 142.61,
          "end": 145.69,
          "en": "from inside your back end code, which you might have.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 145.69,
          "end": 149.71,
          "en": "And very often it will be your back end code that decides",
          "zh": ""
        },
        {
          "id": 50,
          "start": 149.71,
          "end": 152.42000000000002,
          "en": "that some push notification should be delivered",
          "zh": ""
        },
        {
          "id": 51,
          "start": 152.42000000000002,
          "end": 155.04,
          "en": "to one or multiple devices.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 155.04,
          "end": 156.96,
          "en": "But since we don't have a back end here",
          "zh": ""
        },
        {
          "id": 53,
          "start": 156.96,
          "end": 159.03,
          "en": "and this is not a back end course,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 159.03,
          "end": 161.26,
          "en": "we will use a different approach.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 161.26,
          "end": 164.9,
          "en": "And we will send a HTTP request to this endpoint",
          "zh": ""
        },
        {
          "id": 56,
          "start": 164.9,
          "end": 167.393,
          "en": "to trigger such a push notification.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 168.28,
          "end": 169.66,
          "en": "We could be doing this",
          "zh": ""
        },
        {
          "id": 58,
          "start": 169.66,
          "end": 172.15,
          "en": "from inside some back end code as well, by the way.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 172.15,
          "end": 175.52,
          "en": "You can talk to this endpoint from any code base,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 175.52,
          "end": 177.82999999999998,
          "en": "from your front end or your back end,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 177.82999999999998,
          "end": 180.34,
          "en": "but you can also do it from the front end,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 180.34,
          "end": 181.773,
          "en": "which is very useful here.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 182.87,
          "end": 184.51,
          "en": "And therefore, what I'll do",
          "zh": ""
        },
        {
          "id": 64,
          "start": 184.51,
          "end": 188.38,
          "en": "is back in App.js in my app component",
          "zh": ""
        },
        {
          "id": 65,
          "start": 188.38,
          "end": 192.79,
          "en": "I'll add a new function, sendPushNotificationHandler.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 196.13,
          "end": 199.42000000000002,
          "en": "And I'll connect this to a new button which I'm adding,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 199.42000000000002,
          "end": 203.683,
          "en": "which has a title of Send Push Notification.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 204.77,
          "end": 208.71,
          "en": "And on this button, I'll add the onPress prop",
          "zh": ""
        },
        {
          "id": 69,
          "start": 208.71,
          "end": 212.2,
          "en": "and trigger the sendPushNotificationHandler function",
          "zh": ""
        },
        {
          "id": 70,
          "start": 212.2,
          "end": 213.153,
          "en": "we just added.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 214.2,
          "end": 217.74,
          "en": "And in this function, I now wanna set up the code",
          "zh": ""
        },
        {
          "id": 72,
          "start": 217.74,
          "end": 219.76,
          "en": "for sending that notification",
          "zh": ""
        },
        {
          "id": 73,
          "start": 219.76,
          "end": 222.69299999999998,
          "en": "with help of that API endpoint I just showed you.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 223.53,
          "end": 226.67000000000002,
          "en": "Now for this, we need to send the HTTP request",
          "zh": ""
        },
        {
          "id": 75,
          "start": 226.67000000000002,
          "end": 229.28,
          "en": "and we can do this with the Axios library,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 229.28,
          "end": 231.5,
          "en": "which we used before in the course.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 231.5,
          "end": 233.4,
          "en": "Or to mix things up,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 233.4,
          "end": 236.31,
          "en": "we can also do this with the builtin fetch function,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 236.31,
          "end": 238.54,
          "en": "which is built into React Native",
          "zh": ""
        },
        {
          "id": 80,
          "start": 238.54,
          "end": 241.2,
          "en": "or into JavaScript to be precise",
          "zh": ""
        },
        {
          "id": 81,
          "start": 241.2,
          "end": 243.703,
          "en": "and it's supported by React Native.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 244.93,
          "end": 248.17,
          "en": "This fetch function, despite its name,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 248.17,
          "end": 250.42,
          "en": "cannot just be used for fetching data",
          "zh": ""
        },
        {
          "id": 84,
          "start": 250.42,
          "end": 252.38,
          "en": "but also for as sending requests.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 252.38,
          "end": 255.27,
          "en": "And it wants a string that contains a URL",
          "zh": ""
        },
        {
          "id": 86,
          "start": 255.27,
          "end": 257.65,
          "en": "to which a request should be sent.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 257.65,
          "end": 261.21,
          "en": "And in our case, that is this URL here.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 261.21,
          "end": 264.11,
          "en": "Expo's push service endpoint here.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 264.11,
          "end": 265.703,
          "en": "So we paste this in here.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 267.33,
          "end": 269.44,
          "en": "You can then also pass a second argument",
          "zh": ""
        },
        {
          "id": 91,
          "start": 269.44,
          "end": 272.55,
          "en": "to the fetch function to configure this request.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 272.55,
          "end": 274.56,
          "en": "And we need to configure it here",
          "zh": ""
        },
        {
          "id": 93,
          "start": 274.56,
          "end": 278.62,
          "en": "because we must set the request method to post.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 278.62,
          "end": 281.36,
          "en": "And we should also add a Content-Type header",
          "zh": ""
        },
        {
          "id": 95,
          "start": 281.36,
          "end": 284.963,
          "en": "which we set to application/json as a value.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 286.07,
          "end": 288.79,
          "en": "So therefore, here in this object",
          "zh": ""
        },
        {
          "id": 97,
          "start": 288.79,
          "end": 291.58,
          "en": "which we pass as a second argument to fetch",
          "zh": ""
        },
        {
          "id": 98,
          "start": 291.58,
          "end": 296.51,
          "en": "we can add the method property and set it to post,",
          "zh": ""
        },
        {
          "id": 99,
          "start": 296.51,
          "end": 299.02,
          "en": "add the headers property,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 299.02,
          "end": 302.53,
          "en": "and add the Content-Type header here",
          "zh": ""
        },
        {
          "id": 101,
          "start": 302.53,
          "end": 305.363,
          "en": "and set it to a value of application/json.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 306.36,
          "end": 309.44,
          "en": "And then we should also add a body property",
          "zh": ""
        },
        {
          "id": 103,
          "start": 309.44,
          "end": 312.06,
          "en": "to define the actual request body.",
          "zh": ""
        },
        {
          "id": 104,
          "start": 312.06,
          "end": 315.01,
          "en": "Now this request body must be JSON format",
          "zh": ""
        },
        {
          "id": 105,
          "start": 315.01,
          "end": 317.58,
          "en": "so we can use the built-in JSON object",
          "zh": ""
        },
        {
          "id": 106,
          "start": 317.58,
          "end": 319.26,
          "en": "to call the stringify method",
          "zh": ""
        },
        {
          "id": 107,
          "start": 319.26,
          "end": 323.41,
          "en": "and convert a JavaScript object into JSON string.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 323.41,
          "end": 325.89,
          "en": "So here I'm passing an object to stringify.",
          "zh": ""
        },
        {
          "id": 109,
          "start": 325.89,
          "end": 329.71,
          "en": "And object now supports a couple of properties.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 329.71,
          "end": 333.58299999999997,
          "en": "For example, the to, and the title, and the body properties.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 334.5,
          "end": 335.59000000000003,
          "en": "Again, you can learn more",
          "zh": ""
        },
        {
          "id": 112,
          "start": 335.59000000000003,
          "end": 338.62,
          "en": "about all the configuration options in the official docs",
          "zh": ""
        },
        {
          "id": 113,
          "start": 338.62,
          "end": 341.24,
          "en": "if you want to dive really deeply into this,",
          "zh": ""
        },
        {
          "id": 114,
          "start": 341.24,
          "end": 345.36,
          "en": "but title, body, and to are three essential properties",
          "zh": ""
        },
        {
          "id": 115,
          "start": 345.36,
          "end": 349.31,
          "en": "which need to be set up to deliver your push notification",
          "zh": ""
        },
        {
          "id": 116,
          "start": 349.31,
          "end": 350.74,
          "en": "to a certain device,",
          "zh": ""
        },
        {
          "id": 117,
          "start": 350.74,
          "end": 354.14300000000003,
          "en": "and set a certain title and message body.",
          "zh": ""
        },
        {
          "id": 118,
          "start": 355.19,
          "end": 358,
          "en": "Now to should be such a push token.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 358,
          "end": 359.473,
          "en": "We'll set it in a second.",
          "zh": ""
        },
        {
          "id": 120,
          "start": 360.64,
          "end": 364.823,
          "en": "title can be Test - sent from a device!",
          "zh": ""
        },
        {
          "id": 121,
          "start": 366.62,
          "end": 370.793,
          "en": "And body can be This is a test! or anything like this.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 371.93,
          "end": 375.7,
          "en": "Now the push token, the address of the device",
          "zh": ""
        },
        {
          "id": 123,
          "start": 375.7,
          "end": 377.71,
          "en": "to which we wanna send the message",
          "zh": ""
        },
        {
          "id": 124,
          "start": 377.71,
          "end": 381.54,
          "en": "is typically something that would be stored in a database.",
          "zh": ""
        },
        {
          "id": 125,
          "start": 381.54,
          "end": 383.89,
          "en": "So typically, when getting that push token",
          "zh": ""
        },
        {
          "id": 126,
          "start": 383.89,
          "end": 386.57,
          "en": "in the configuration function,",
          "zh": ""
        },
        {
          "id": 127,
          "start": 386.57,
          "end": 388.93,
          "en": "once you've got your push token data here",
          "zh": ""
        },
        {
          "id": 128,
          "start": 388.93,
          "end": 391.39,
          "en": "you would typically store the push token",
          "zh": ""
        },
        {
          "id": 129,
          "start": 391.39,
          "end": 392.843,
          "en": "that belongs to a certain device",
          "zh": ""
        },
        {
          "id": 130,
          "start": 392.843,
          "end": 397.34000000000003,
          "en": "and therefore to a certain user in a database.",
          "zh": ""
        },
        {
          "id": 131,
          "start": 397.34000000000003,
          "end": 399.13,
          "en": "And then when you later decide",
          "zh": ""
        },
        {
          "id": 132,
          "start": 399.13,
          "end": 402.83,
          "en": "that you need to send a notification to that device",
          "zh": ""
        },
        {
          "id": 133,
          "start": 402.83,
          "end": 406.6,
          "en": "and to that user, you would get the token from the database",
          "zh": ""
        },
        {
          "id": 134,
          "start": 406.6,
