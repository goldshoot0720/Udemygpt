        },
        {
          "id": 39,
          "start": 115.61,
          "end": 118.78999999999999,
          "en": "So therefore here in this dummy app which I prepared,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 118.78999999999999,
          "end": 120.71,
          "en": "I wanna add this navigator.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 120.71,
          "end": 122.63,
          "en": "So hence in a new terminal tab,",
