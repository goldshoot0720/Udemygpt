        },
        {
          "id": 34,
          "start": 96.78,
          "end": 100.38,
          "en": "This allows us to add such a side drawer to our app.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 100.38,
          "end": 101.67,
          "en": "And as always,",
