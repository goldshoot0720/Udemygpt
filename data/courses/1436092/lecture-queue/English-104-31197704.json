        },
        {
          "id": 104,
          "start": 327.88,
          "end": 331.22,
          "en": "and therefore, I will simply import WelcomeScreen",
          "zh": ""
        },
        {
          "id": 105,
          "start": 331.22,
          "end": 333.26,
          "en": "from screens WelcomeScreen,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 333.26,
          "end": 336.42,
          "en": "and then point at this WelcomeScreen here.",
