        },
        {
          "id": 95,
          "start": 258.51,
          "end": 260.7,
          "en": "but I wanna keep this component DOM,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 260.7,
          "end": 263.25,
          "en": "and instead let the parent component",
