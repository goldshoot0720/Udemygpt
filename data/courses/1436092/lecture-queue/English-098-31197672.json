        },
        {
          "id": 150,
          "start": 478.43,
          "end": 480.16,
          "en": "So that is working.",
          "zh": ""
        },
        {
          "id": 151,
          "start": 480.16,
          "end": 484.01,
          "en": "Please also note how React Navigation automatically",
          "zh": ""
        },
        {
          "id": 152,
          "start": 484.01,
          "end": 487.5,
