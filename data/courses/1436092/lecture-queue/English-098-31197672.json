        },
        {
          "id": 146,
          "start": 465.05,
          "end": 468.37,
          "en": "it's just handled differently internally.",
          "zh": ""
        },
        {
          "id": 147,
          "start": 468.37,
          "end": 470.21,
          "en": "And therefore, if we save this now",
