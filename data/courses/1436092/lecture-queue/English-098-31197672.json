        },
        {
          "id": 140,
          "start": 445.5,
          "end": 449.17,
          "en": "So before this component function has finished execution.",
          "zh": ""
        },
        {
          "id": 141,
          "start": 449.17,
          "end": 453.58,
          "en": "Or to be precise, you wanna run this effect simultaneously",
