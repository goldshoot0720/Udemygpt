  "lectures": [
    {
      "id": "31197904",
      "title": "Adding Dummy Expense Data",
      "lectureOrder": 130,
      "videoOrder": 126,
      "sourceHash": "8f35d44f0f579d717b11bd1fb913aa5bacf23b7790b81005af0fd23e2be2a9e9",
      "cues": [
        {
          "id": 1,
          "start": 2.17,
          "end": 4.6,
          "en": "So let's now add some dummy expenses.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.6,
          "end": 5.745,
          "en": "Later, we will, of course add",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.745,
          "end": 10.143,
          "en": "functionality that allows users to add their own expenses.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.22,
          "end": 14.3,
          "en": "Now, to add some dummy expenses, I'll just",
          "zh": ""
        },
        {
          "id": 5,
          "start": 14.3,
          "end": 17.46,
          "en": "go to Expenses Output for now",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.46,
          "end": 20.97,
          "en": "and add a constant here, 'dummy expenses.'",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.97,
          "end": 23.57,
          "en": "Which is an array full of objects.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 23.57,
          "end": 26.523,
          "en": "And every object will represent one expense.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 27.38,
          "end": 30.74,
          "en": "Now, here, every object should then have an ID because",
          "zh": ""
        },
        {
          "id": 10,
          "start": 30.74,
          "end": 32.76,
          "en": "every expense should have a unique ID",
          "zh": ""
        },
        {
          "id": 11,
          "start": 32.76,
          "end": 35.67,
          "en": "by which we can identify the expense.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 35.67,
          "end": 39.44,
          "en": "This will also be important for editing or deleting it.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 39.44,
          "end": 42.28,
          "en": "And I will simply use e1 for the first expense,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 42.28,
          "end": 45.063,
          "en": "e2 for the second expense, and so on.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 46.15,
          "end": 50.81,
          "en": "Then every expansion of a title or a description",
          "zh": ""
        },
        {
          "id": 16,
          "start": 50.81,
          "end": 53.84,
          "en": "which later can be entered by the user.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 53.84,
          "end": 56.75,
          "en": "For the moment I'll enter some dummy text myself.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 56.75,
          "end": 58.713,
          "en": "Like a pair of shoes.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 60.3,
          "end": 62.78,
          "en": "And then we need the amount.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 62.78,
          "end": 65.51,
          "en": "The amount can be any value you want, but it",
          "zh": ""
        },
        {
          "id": 21,
          "start": 65.51,
          "end": 68.313,
          "en": "it be a number like 59.99.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 69.58,
          "end": 70.84,
          "en": "And here for this app,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 70.84,
          "end": 73.76,
          "en": "we will assume that this is in US dollars.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 73.76,
          "end": 76.507,
          "en": "Or any other currency you want, in the end",
          "zh": ""
        },
        {
          "id": 25,
          "start": 76.507,
          "end": 80.48,
          "en": "this only matters here in summary where I output",
          "zh": ""
        },
        {
          "id": 26,
          "start": 80.48,
          "end": 83.84,
          "en": "a dollar sign. And later when we output the expenses",
          "zh": ""
        },
        {
          "id": 27,
          "start": 83.84,
          "end": 84.713,
          "en": "in our list.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 85.97,
          "end": 87.61,
          "en": "Now we also should add a date.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 87.61,
          "end": 90.61,
          "en": "Because that date will be needed to differentiate",
          "zh": ""
        },
        {
          "id": 30,
          "start": 90.61,
          "end": 93.78999999999999,
          "en": "between recent and all expenses.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 93.78999999999999,
          "end": 97.37,
          "en": "Recent should be the last seven days, at least in this app.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 97.37,
          "end": 100.58,
          "en": "And we need a date to find out which expenses are",
          "zh": ""
        },
        {
          "id": 33,
          "start": 100.58,
          "end": 102.33,
          "en": "part of that period.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 102.33,
          "end": 104.33,
          "en": "And hence, here we add a date.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 104.33,
          "end": 107.75,
          "en": "And this date can be set by constructing a new date",
          "zh": ""
        },
        {
          "id": 36,
          "start": 107.75,
          "end": 109.731,
          "en": "With the builtin date object that is",
          "zh": ""
        },
        {
          "id": 37,
          "start": 109.731,
          "end": 112.25999999999999,
          "en": "available in JavaScript.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 112.25999999999999,
          "end": 114.719,
          "en": "And to this, we can pass a date formatted",
          "zh": ""
        },
        {
          "id": 39,
          "start": 114.719,
          "end": 117.3,
          "en": "in the following way where we say",
          "zh": ""
        },
        {
          "id": 40,
          "start": 117.3,
          "end": 121.32,
          "en": "2021-12-19",
          "zh": ""
        },
        {
          "id": 41,
          "start": 121.32,
          "end": 123.72,
          "en": "to add an expense that occurred",
          "zh": ""
        },
        {
          "id": 42,
          "start": 123.72,
          "end": 127.46,
          "en": "on the 19th, December, 2021.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 127.46,
          "end": 130.59,
          "en": "You can of course pick any date you want.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 130.59,
          "end": 133.33,
          "en": "And now, according to this logic I'll add a couple of",
          "zh": ""
        },
        {
          "id": 45,
          "start": 133.33,
          "end": 135.77,
          "en": "other expenses as well.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 135.77,
          "end": 140.1,
          "en": "For example, a pair of trousers, here for let's say",
          "zh": ""
        },
        {
          "id": 47,
          "start": 140.1,
          "end": 143.13,
          "en": "89.29.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 143.13,
          "end": 147.3,
          "en": "And let's say this occurred in January 2022.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 149.99,
          "end": 154.4,
          "en": "And then I'll copy this and add another expense here.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 154.4,
          "end": 158.4,
          "en": "Where I say some bananas",
          "zh": ""
        },
        {
          "id": 51,
          "start": 158.4,
          "end": 162.31,
          "en": "and that's let's say 5.99.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 162.31,
          "end": 167.31,
          "en": "And that occurred, let's say again, in December 2021.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 169.12,
          "end": 172.31,
          "en": "Maybe the 1st December.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 172.31,
          "end": 175.65,
          "en": "Then I add a fourth expense here.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 175.65,
          "end": 176.97,
          "en": "That could be",
          "zh": ""
        },
        {
          "id": 56,
          "start": 178.32,
          "end": 181.25,
          "en": "a book and that maybe cost",
          "zh": ""
        },
        {
          "id": 57,
          "start": 181.25,
          "end": 184.5,
          "en": "like 14.99.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 184.5,
          "end": 187.47,
          "en": "And here we say that this occurred in",
          "zh": ""
        },
        {
          "id": 59,
          "start": 187.47,
          "end": 189.78,
          "en": "February 2022.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 189.78,
          "end": 192.79,
          "en": "Let's say February the 19th.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 192.79,
          "end": 195.34,
          "en": "And I will add one last expense here.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 195.34,
          "end": 196.494,
          "en": "And this is",
          "zh": ""
        },
        {
          "id": 63,
          "start": 196.494,
          "end": 198.37,
          "en": "five,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 198.37,
          "end": 199.951,
          "en": "where I bought",
          "zh": ""
        },
        {
          "id": 65,
          "start": 199.951,
          "end": 202.95,
          "en": "another book because I'm really creative,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 202.95,
          "end": 206.63,
          "en": "let's say for 18.59.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 206.63,
          "end": 211.183,
          "en": "And this occurred on February 18th, 2022.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 212.75,
          "end": 214.73,
          "en": "So now I got some dummy expenses with",
          "zh": ""
        },
        {
          "id": 69,
          "start": 214.73,
          "end": 216.53,
          "en": "some dummy data set up.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 216.53,
          "end": 220.52,
          "en": "And we can now pass those expenses as expenses here",
          "zh": ""
        },
        {
          "id": 71,
          "start": 220.52,
          "end": 222.663,
          "en": "to the Expenses Summary component.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 223.52,
          "end": 226.75,
          "en": "Now, again, normally we would receive",
          "zh": ""
        },
        {
          "id": 73,
          "start": 226.75,
          "end": 230.273,
          "en": "those expenses from outside through the expenses prop",
          "zh": ""
        },
        {
          "id": 74,
          "start": 230.273,
          "end": 234.1,
          "en": "from the All Expenses and Recent Expenses components.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 234.1,
          "end": 236.053,
          "en": "And that's how we will do it later.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 236.89,
          "end": 240.4,
          "en": "For the moment, I will just add the dummy expenses here",
          "zh": ""
        },
        {
          "id": 77,
          "start": 240.4,
          "end": 243.53,
          "en": "and use those dummy expenses here as a value",
          "zh": ""
        },
        {
          "id": 78,
          "start": 243.53,
          "end": 247.24,
          "en": "for the expenses prop of the Expenses Summary.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 247.24,
          "end": 250.7,
          "en": "But that is just something we will do temporarily.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 250.7,
          "end": 252.29,
          "en": "Now for the period name,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 252.29,
          "end": 254.109,
          "en": "I will set this from outside though,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 254.109,
          "end": 257.204,
          "en": "and I will use the Expenses Output component",
          "zh": ""
        },
        {
          "id": 83,
          "start": 257.204,
          "end": 260.343,
          "en": "in All Expenses and Recent Expenses.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 261.26,
          "end": 264.43,
          "en": "So here in All Expenses, we can return the",
          "zh": ""
        },
        {
          "id": 85,
          "start": 264.43,
          "end": 268.023,
          "en": "Expenses Output component we just worked on.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 268.86,
          "end": 271.16,
          "en": "And for this, we of course must import it",
          "zh": ""
        },
        {
          "id": 87,
          "start": 271.16,
          "end": 272.77,
          "en": "from the components folder.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 272.77,
          "end": 274.81,
          "en": "And we can get rid of that text import,",
          "zh": ""
        },
        {
          "id": 89,
          "start": 274.81,
          "end": 276.83,
          "en": "which we had here before.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 276.83,
          "end": 279.525,
          "en": "And we can now set this expenses period to,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 279.525,
          "end": 284.525,
          "en": "let's say, Total because that's the total for all",
          "zh": ""
        },
        {
          "id": 92,
          "start": 284.64,
          "end": 286.553,
          "en": "the expenses in this component.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 287.73,
          "end": 291.81,
          "en": "And then we can do the same here in Recent Expenses.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 291.81,
          "end": 296.46,
          "en": "Get rid of the text import and instead output Expenses",
          "zh": ""
        },
        {
          "id": 95,
          "start": 296.46,
          "end": 299.96,
          "en": "Output here. And import that of course,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 299.96,
          "end": 304.22,
          "en": "and set the expenses period here to Last 7 Days",
          "zh": ""
        },
        {
          "id": 97,
          "start": 304.22,
          "end": 306.81,
          "en": "Because that will be my recent expenses.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 306.81,
          "end": 310.14,
          "en": "For the moment, please keep in mind that we have no logic",
          "zh": ""
        },
        {
          "id": 99,
          "start": 310.14,
          "end": 313.32,
          "en": "for actually filtering for the recent expenses.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 313.32,
          "end": 316.08,
          "en": "For the moment with our dummy expenses set up",
          "zh": ""
        },
        {
          "id": 101,
          "start": 316.08,
          "end": 319.718,
          "en": "in Expenses Output we will always output all the expenses.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 319.718,
          "end": 322.471,
          "en": "This will change later.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 322.471,
          "end": 326.64,
          "en": "So with that, we're yet another step closer to our",
          "zh": ""
        },
        {
          "id": 104,
          "start": 326.64,
          "end": 328.72,
          "en": "first intermediate result.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 328.72,
          "end": 331.796,
          "en": "As a next step, let's now work on this expenses list,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 331.796,
          "end": 335.853,
          "en": "before we then finally can see something on the screen.",
          "zh": ""
        }
      ]
    }
