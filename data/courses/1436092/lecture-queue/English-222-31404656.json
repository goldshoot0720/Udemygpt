          "end": 107.27000000000001,
          "en": "and then a project name at the end.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 107.27000000000001,
          "end": 110.24000000000001,
          "en": "So here I will choose com.academind.rncourse",
          "zh": ""
        },
        {
          "id": 41,
          "start": 110.24000000000001,
          "end": 112.453,
          "en": "because my company is named Academind.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 113.53999999999999,
          "end": 116.25,
