        },
        {
          "id": 28,
          "start": 76.06,
          "end": 77.63,
          "en": "so that you can go back",
          "zh": ""
        },
        {
          "id": 29,
          "start": 77.63,
          "end": 80.18,
          "en": "because otherwise there is no going back,",
