        },
        {
          "id": 3,
          "start": 9.33,
          "end": 11.26,
          "en": "And for this here in App.js,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.26,
          "end": 14.98,
          "en": "I wanna start with the AllPlaces screen.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 14.98,
          "end": 17.6,
          "en": "Besides setting the headerRight option here,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.6,
          "end": 21.12,
          "en": "we can also set the title option to give this a title",
