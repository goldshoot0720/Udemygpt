        },
        {
          "id": 3,
          "start": 8.44,
          "end": 10.29,
          "en": "There, once the signup succeeded,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.29,
          "end": 12.32,
          "en": "I want to call the authenticate function",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.32,
          "end": 15.38,
          "en": "in the Context to pass the token that we received",
