          "zh": ""
        },
        {
          "id": 14,
          "start": 36.9,
          "end": 38.963,
          "en": "to tap into our Context here,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 39.84,
          "end": 42.55,
          "en": "store that in a constant or variable,",
