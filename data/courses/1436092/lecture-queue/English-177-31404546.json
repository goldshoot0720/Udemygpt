        },
        {
          "id": 23,
          "start": 63.2,
          "end": 66.01,
          "en": "And for that in auth.js in util,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 66.01,
          "end": 68.48,
          "en": "we must make sure that we extract the token",
          "zh": ""
        },
        {
          "id": 25,
          "start": 68.48,
          "end": 70.7,
          "en": "from the response we're getting.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 70.7,
          "end": 72.81,
          "en": "So here in the authenticate function",
          "zh": ""
        },
        {
          "id": 27,
          "start": 72.81,
          "end": 75.56,
          "en": "in the auth file in the util folder",
          "zh": ""
        },
        {
          "id": 28,
          "start": 75.56,
          "end": 77.92,
          "en": "we get this response,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 77.92,
