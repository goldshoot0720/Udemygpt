          "en": "so that we still make sure that all the available space,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 120.38,
          "end": 122.97,
          "en": "minus the area that is reserved for the notch,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 122.97,
