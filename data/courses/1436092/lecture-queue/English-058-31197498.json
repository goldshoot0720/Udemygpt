        {
          "id": 25,
          "start": 67.21,
          "end": 69.113,
          "en": "my entire screen content.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 70.23,
          "end": 75.23,
          "en": "So here we can import the safe area view from React Native.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 75.71000000000001,
          "end": 78.92,
          "en": "And then we use this view by simply wrapping it",
          "zh": ""
        },
        {
          "id": 28,
          "start": 78.92,
          "end": 81.26,
          "en": "around our main content.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 81.26,
          "end": 83.8,
          "en": "Now I'll go inside of the linear gradient",
