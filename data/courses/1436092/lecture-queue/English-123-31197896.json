        },
        {
          "id": 73,
          "start": 190.07,
          "end": 192.14,
          "en": "and to make it a bit easier for you",
          "zh": ""
        },
        {
          "id": 74,
          "start": 192.14,
          "end": 193.73,
          "en": "you find this attached,",
