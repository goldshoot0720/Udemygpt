        },
        {
          "id": 34,
          "start": 85.08,
          "end": 86.98,
          "en": "And I don't want that.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 86.98,
          "end": 89.83,
          "en": "You could disable it if you don't want a header",
          "zh": ""
        },
        {
          "id": 36,
          "start": 89.83,
          "end": 91.41,
          "en": "but here I do want a header",
          "zh": ""
        },
        {
          "id": 37,
          "start": 91.41,
          "end": 93.83,
          "en": "and therefore I'll definitely not disable it",
          "zh": ""
        },
        {
          "id": 38,
          "start": 93.83,
          "end": 95,
          "en": "for this screen,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 95,
          "end": 97.07,
          "en": "but just for this first screen",
          "zh": ""
        },
        {
          "id": 40,
          "start": 97.07,
          "end": 99.85,
          "en": "which is in the end that screen, that component",
