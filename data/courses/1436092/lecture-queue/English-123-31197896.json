        },
        {
          "id": 90,
          "start": 235.36,
          "end": 236.44,
          "en": "which we can set",
          "zh": ""
        },
        {
          "id": 91,
          "start": 236.44,
          "end": 239.433,
          "en": "which allows us to set the background color of the header.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 240.44,
          "end": 245.079,
          "en": "And here, I want to use my global styles object",
