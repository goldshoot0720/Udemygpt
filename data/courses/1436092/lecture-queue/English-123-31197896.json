        },
        {
          "id": 25,
          "start": 62.86,
          "end": 65.4,
          "en": "because for manage expense,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 65.4,
          "end": 66.76,
          "en": "for this screen,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 66.76,
          "end": 70.58,
