        },
        {
          "id": 119,
          "start": 327.53,
          "end": 329.48,
          "en": "are well visible,",
          "zh": ""
        },
        {
          "id": 120,
          "start": 329.48,
          "end": 332.06,
          "en": "that we can see them really well",
          "zh": ""
        },
        {
          "id": 121,
          "start": 332.06,
          "end": 336.58,
          "en": "and therefore we can add a tab bar active tint color",
