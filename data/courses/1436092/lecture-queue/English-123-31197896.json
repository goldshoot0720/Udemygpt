        },
        {
          "id": 44,
          "start": 110.22999999999999,
          "end": 112.193,
          "en": "there we will still have a header.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 113.47,
          "end": 117.33,
          "en": "Now I also wanna change the styling of the header here",
          "zh": ""
        },
        {
          "id": 46,
          "start": 117.33,
          "end": 118.97999999999999,
          "en": "and for this, we will have to go",
          "zh": ""
        },
        {
          "id": 47,
          "start": 118.97999999999999,
          "end": 120.77,
          "en": "to the bottom tabs navigator",
          "zh": ""
        },
        {
          "id": 48,
          "start": 120.77,
          "end": 122.31,
          "en": "because we're hiding the header",
