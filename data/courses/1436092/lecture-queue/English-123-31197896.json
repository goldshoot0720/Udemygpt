        },
        {
          "id": 53,
          "start": 131.58,
          "end": 134.44,
          "en": "And here I wanna have the same styling for all my screens",
          "zh": ""
        },
        {
          "id": 54,
          "start": 134.44,
          "end": 136.04,
          "en": "so for both tabs,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 136.04,
          "end": 138.95,
          "en": "hence I will apply the styling for the header",
          "zh": ""
        },
        {
          "id": 56,
          "start": 138.95,
          "end": 141.4,
          "en": "with help of the screen options prop",
