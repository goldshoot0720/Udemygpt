        },
        {
          "id": 146,
          "start": 415.64,
          "end": 419.003,
          "en": "the splash screen until we tried to fetch a token.",
          "zh": ""
        },
        {
          "id": 147,
          "start": 420.04,
          "end": 422.32,
          "en": "To achieve this, we can cut useEffect",
          "zh": ""
        },
        {
          "id": 148,
          "start": 422.32,
          "end": 425,
          "en": "and remove it from AuthContextProvider",
          "zh": ""
        },
        {
          "id": 149,
          "start": 425,
          "end": 428.743,
          "en": "and instead add it here in App.js in the App component.",
          "zh": ""
        },
        {
          "id": 150,
          "start": 429.65,
          "end": 431.27,
          "en": "And of course, therefore make sure",
          "zh": ""
        },
        {
          "id": 151,
          "start": 431.27,
          "end": 434.64,
          "en": "that you import useEffect from react here",
          "zh": ""
        },
        {
          "id": 152,
          "start": 434.64,
          "end": 438.96,
          "en": "and that you also import AsyncStorage here",
