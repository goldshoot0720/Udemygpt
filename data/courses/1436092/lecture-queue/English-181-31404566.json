          "id": 153,
          "start": 438.96,
          "end": 440.023,
          "en": "in this component.",
          "zh": ""
        },
        {
          "id": 154,
          "start": 441.62,
          "end": 444.48,
          "en": "And then here, in the App component,",
          "zh": ""
        },
        {
          "id": 155,
          "start": 444.48,
          "end": 448.19,
          "en": "we, of course, can't call setAuthToken like this",
          "zh": ""
        },
        {
          "id": 156,
          "start": 448.19,
          "end": 451.463,
          "en": "but instead, we wanna update our context here.",
          "zh": ""
        },
        {
          "id": 157,
          "start": 452.32,
          "end": 454.15,
          "en": "Now, since I am in the component here",
          "zh": ""
        },
        {
          "id": 158,
          "start": 454.15,
          "end": 455.95,
          "en": "where the context is provided,",
          "zh": ""
        },
        {
          "id": 159,
          "start": 455.95,
          "end": 458.61,
          "en": "we can't tap into our context here though",
          "zh": ""
        },
        {
          "id": 160,
          "start": 458.61,
          "end": 460.08,
          "en": "and therefore, a workaround here",
          "zh": ""
        },
        {
          "id": 161,
          "start": 460.08,
          "end": 462.28,
          "en": "could be to add another component,",
          "zh": ""
        },
        {
          "id": 162,
          "start": 462.28,
          "end": 463.88,
          "en": "which could be named Root",
