        },
        {
          "id": 135,
          "start": 384.66,
          "end": 386.69,
          "en": "and I then restart it,",
          "zh": ""
        },
        {
          "id": 136,
          "start": 386.69,
          "end": 390.53,
          "en": "we should be able to move forward",
          "zh": ""
        },
        {
          "id": 137,
          "start": 390.53,
          "end": 392.29,
          "en": "to the welcome screen automatically",
          "zh": ""
        },
        {
          "id": 138,
          "start": 392.29,
          "end": 394.68,
          "en": "because we are logged in automatically.",
          "zh": ""
        },
        {
          "id": 139,
          "start": 394.68,
          "end": 395.623,
          "en": "Here we go.",
          "zh": ""
        },
        {
          "id": 140,
          "start": 397.12,
          "end": 398.94,
          "en": "Now, what you will notice, of course,",
          "zh": ""
        },
        {
          "id": 141,
          "start": 398.94,
          "end": 402.22,
          "en": "is that briefly, we saw the login screen",
          "zh": ""
        },
        {
          "id": 142,
          "start": 402.22,
          "end": 404.85,
          "en": "because that was actually the first screen loaded",
          "zh": ""
        },
        {
          "id": 143,
          "start": 404.85,
          "end": 407.75,
          "en": "before fetching the token finished.",
          "zh": ""
        },
        {
          "id": 144,
          "start": 407.75,
          "end": 411.74,
          "en": "Now, to avoid this flickering, to get rid of that,",
          "zh": ""
        },
        {
          "id": 145,
          "start": 411.74,
          "end": 415.64,
          "en": "what we can do is prolong the loading screen of our app,",
