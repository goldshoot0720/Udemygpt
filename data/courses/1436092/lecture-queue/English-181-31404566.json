        },
        {
          "id": 242,
          "start": 695.05,
          "end": 697.91,
          "en": "and therefore, we are not logged in automatically.",
          "zh": ""
        },
        {
          "id": 243,
          "start": 697.91,
          "end": 701.71,
          "en": "And that's how we can persist that token on the device",
          "zh": ""
        },
        {
          "id": 244,
          "start": 701.71,
          "end": 704.363,
          "en": "so that we keep a user logged in.",
          "zh": ""
        }
      ]
    }
