  "lectures": [
    {
      "id": "31197488",
      "title": "Handling User Input & Showing an Alert Dialog",
      "lectureOrder": 58,
      "videoOrder": 55,
      "sourceHash": "4419759867536f0a243cbffaa70e5f5d62fc613b66e15481af05a3357495cc15",
      "cues": [
        {
          "id": 1,
          "start": 2.02,
          "end": 3.06,
          "en": "So let's now add",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.06,
          "end": 6.79,
          "en": "this input validation logic here.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.79,
          "end": 8.7,
          "en": "For this I'll first of all,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.7,
          "end": 11.16,
          "en": "create a chosenNumber constant,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.16,
          "end": 14.38,
          "en": "where I wanna convert the enteredNumber of state,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.38,
          "end": 17.72,
          "en": "that I have here, which is a string to a number.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.72,
          "end": 20.09,
          "en": "And this conversion can be performed",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.09,
          "end": 23.81,
          "en": "by using the built in parseInt function.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 23.81,
          "end": 27.45,
          "en": "This function is globally available in JavaScript,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.45,
          "end": 28.94,
          "en": "in React Native apps,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 28.94,
          "end": 32.22,
          "en": "just as it is globally available in the browser.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.22,
          "end": 33.86,
          "en": "So you can't just call it like this,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 33.86,
          "end": 37.913,
          "en": "and to parseInt, you pass the entered number.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 39.07,
          "end": 41.66,
          "en": "This will convert this string to a number,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 41.66,
          "end": 44.6,
          "en": "or at least it will try to convert it.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 44.6,
          "end": 47.53,
          "en": "This would fail if something is entered",
          "zh": ""
        },
        {
          "id": 17,
          "start": 47.53,
          "end": 49.62,
          "en": "that is not convertible to a number,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 49.62,
          "end": 52.51,
          "en": "like non-digit characters.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 52.51,
          "end": 55.31,
          "en": "Therefore, I next wanna add a if statement here,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 55.31,
          "end": 58,
          "en": "where I check if this is maybe not a number,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 58,
          "end": 59.343,
          "en": "if the conversion failed.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 60.29,
          "end": 61.16,
          "en": "This can be done",
          "zh": ""
        },
        {
          "id": 23,
          "start": 61.16,
          "end": 64.39,
          "en": "with the built in isNot a number function,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 64.39,
          "end": 66.74,
          "en": "which is also globally available,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 66.74,
          "end": 68.49,
          "en": "and to which I passed chosenNumber.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 69.81,
          "end": 71.24,
          "en": "This will return true,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 71.24,
          "end": 73.13,
          "en": "if chosenNumber is not a number,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 73.13,
          "end": 74.57300000000001,
          "en": "so if the conversion failed.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 75.5,
          "end": 77.78999999999999,
          "en": "Now, I also wanna add a couple of other checks,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 77.78999999999999,
          "end": 80.03,
          "en": "because if this check fails,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 80.03,
          "end": 83.6,
          "en": "or one of the other checks which I am about to add,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 83.6,
          "end": 86.37,
          "en": "in that case, I wanna show an alert.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 86.37,
          "end": 89.28999999999999,
          "en": "Show alert, that's what we'll do soon.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 89.28999999999999,
          "end": 91.31,
          "en": "So the other checks I wanna perform,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 91.31,
          "end": 93.61,
          "en": "are separated by an or,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 93.61,
          "end": 97.22,
          "en": "because I wanna show the alert if this is not a number,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 97.22,
          "end": 100.58,
          "en": "or if chosenNumber is a number,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 100.58,
          "end": 103.4,
          "en": "but it's smaller or equal than zero.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 103.4,
          "end": 106.24000000000001,
          "en": "So if it's zero or smaller than that,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 106.24000000000001,
          "end": 107.96000000000001,
          "en": "that would also be invalid,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 107.96000000000001,
          "end": 110.723,
          "en": "and I wanna show an alert in that case as well.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 111.59,
          "end": 113.24000000000001,
          "en": "Or I wanna show an alert,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 113.24000000000001,
          "end": 116.78,
          "en": "if chosenNumber is greater than 99.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 116.78,
          "end": 119.253,
          "en": "If it's too big, I also wanna show an alert.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 120.26,
          "end": 122.24,
          "en": "Now I also wanna return thereafter",
          "zh": ""
        },
        {
          "id": 46,
          "start": 122.24,
          "end": 124.44,
          "en": "to make sure that this function,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 124.44,
          "end": 126.95,
          "en": "does not continue its execution,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 126.95,
          "end": 128.93,
          "en": "if we make it into if statement.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 128.93,
          "end": 132.943,
          "en": "So that we cancel this function's execution.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 134.21,
          "end": 137.48,
          "en": "But how can we now show such an alert?",
          "zh": ""
        },
        {
          "id": 51,
          "start": 137.48,
          "end": 139.57,
          "en": "That would also be interesting.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 139.57,
          "end": 142.363,
          "en": "And here React Native got us covered.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 143.3,
          "end": 147.403,
          "en": "React Native exposes and alert API.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 148.45,
          "end": 152.38,
          "en": "Now, this is now not a component which we display,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 152.38,
          "end": 155.13,
          "en": "but instead alert is an object",
          "zh": ""
        },
        {
          "id": 56,
          "start": 155.13,
          "end": 159.76,
          "en": "that holds a method that we can call to show an alert.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 159.76,
          "end": 162.98,
          "en": "To be precise, the alert method.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 162.98,
          "end": 164.79,
          "en": "It also has the prompt method,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 164.79,
          "end": 167.3,
          "en": "which would display a dialogue,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 167.3,
          "end": 170.38,
          "en": "where we can enter a value.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 170.38,
          "end": 172.68,
          "en": "But here I'm interested in the alert method,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 172.68,
          "end": 175.25,
          "en": "which shows a Dialog which we can only confirm",
          "zh": ""
        },
        {
          "id": 63,
          "start": 175.25,
          "end": 177.17000000000002,
          "en": "by pressing a button.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 177.17000000000002,
          "end": 179.07,
          "en": "Now this alert method here,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 179.07,
          "end": 180.98,
          "en": "wants a couple of arguments.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 180.98,
          "end": 184,
          "en": "The first one is the title,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 184,
          "end": 186.23,
          "en": "the second one will be the message,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 186.23,
          "end": 188.92,
          "en": "and the third one allows us to configure the buttons",
          "zh": ""
        },
        {
          "id": 69,
          "start": 188.92,
          "end": 191.33,
          "en": "that will be part of that alert.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 191.33,
          "end": 193.6,
          "en": "And this alert method by the way,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 193.6,
          "end": 196.71,
          "en": "will create a Native Alert Dialog,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 196.71,
          "end": 198.48,
          "en": "as you will see in a couple of minutes.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 198.48,
          "end": 201.32,
          "en": "So it will use the Native Alert API,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 201.32,
          "end": 205.61,
          "en": "built into the IOS and Android platforms.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 205.61,
          "end": 208.59,
          "en": "So here I'll say \"Invalid Number\" as a title,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 208.59,
          "end": 210.24,
          "en": "and then as a message I'll say,",
          "zh": ""
        },
        {
          "id": 77,
          "start": 210.24,
          "end": 215.153,
          "en": "Number has to be a number, between one and 99.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 216.72,
          "end": 217.96,
          "en": "And then as a last step,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 217.96,
          "end": 219.42000000000002,
          "en": "we can pass an array,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 219.42000000000002,
          "end": 222.81,
          "en": "where we configure the buttons that should be shown.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 222.81,
          "end": 226.12,
          "en": "And you can actually add multiple buttons to the alert,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 226.12,
          "end": 228.78,
          "en": "but here I will only add one.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 228.78,
          "end": 230.5,
          "en": "And the button is defined,",
          "zh": ""
        },
        {
          "id": 84,
          "start": 230.5,
          "end": 232.84,
          "en": "by adding an object to this array.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 232.84,
          "end": 234.38,
          "en": "And in this object,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 234.38,
          "end": 236.4,
          "en": "every button then has a text,",
          "zh": ""
        },
        {
          "id": 87,
          "start": 236.4,
          "end": 238.9,
          "en": "which is the caption of this button.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 238.9,
          "end": 241.02,
          "en": "In this case 'Okay'",
          "zh": ""
        },
        {
          "id": 89,
          "start": 241.02,
          "end": 243.06,
          "en": "And it has a style.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 243.06,
          "end": 246.87,
          "en": "And this style can be default, destructive, or cancel,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 246.87,
          "end": 248.36,
          "en": "and this will basically influence",
          "zh": ""
        },
        {
          "id": 92,
          "start": 248.36,
          "end": 250,
          "en": "which text color is used,",
          "zh": ""
        },
        {
          "id": 93,
          "start": 250,
          "end": 252.95,
          "en": "if the text is bold, things like this.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 252.95,
          "end": 255.29,
          "en": "And here I will use destructive,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 255.29,
          "end": 258.48,
          "en": "but feel free to play around with these different styles,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 258.48,
          "end": 262.63,
          "en": "to see how the look changes as you change the style.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 262.63,
          "end": 263.9,
          "en": "Last but not least,",
          "zh": ""
        },
        {
          "id": 98,
          "start": 263.9,
          "end": 267.21,
          "en": "you also can add onPress property,",
          "zh": ""
        },
        {
          "id": 99,
          "start": 267.21,
          "end": 269.72,
          "en": "which allows you to point at a function",
          "zh": ""
        },
        {
          "id": 100,
          "start": 269.72,
          "end": 271.14,
          "en": "that should be executed,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 271.14,
          "end": 272.84000000000003,
          "en": "when that button is clicked.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 272.84000000000003,
          "end": 275.6,
          "en": "So when that button on this alert is clicked.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 275.6,
          "end": 276.97,
          "en": "And I do wanna do that,",
          "zh": ""
        },
        {
          "id": 104,
          "start": 276.97,
          "end": 279.24,
          "en": "because I wanna reset the input",
          "zh": ""
        },
        {
          "id": 105,
          "start": 279.24,
          "end": 281.29,
          "en": "once this button is clicked.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 281.29,
          "end": 284.55,
          "en": "So that if an invalid value was provided,",
          "zh": ""
        },
        {
          "id": 107,
          "start": 284.55,
          "end": 285.99,
          "en": "we show the alert,",
          "zh": ""
        },
        {
          "id": 108,
          "start": 285.99,
          "end": 290.49,
          "en": "and once the alert is confirmed and handled by the user,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 290.49,
          "end": 292.37,
          "en": "I wanna reset the input,",
          "zh": ""
        },
        {
          "id": 110,
          "start": 292.37,
          "end": 294.823,
          "en": "to get rid of the invalid input value.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 295.94,
          "end": 298.05,
          "en": "For this we can add a new function,",
          "zh": ""
        },
        {
          "id": 112,
          "start": 298.05,
          "end": 301.34,
          "en": "Maybe here, the exact position doesn't matter,",
          "zh": ""
        },
        {
          "id": 113,
          "start": 301.34,
          "end": 304.683,
          "en": "which is the resetInputHandler.",
          "zh": ""
        },
        {
          "id": 114,
          "start": 306.54,
          "end": 310.71,
          "en": "And here I will set my entered number to an empty string.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 310.71,
          "end": 313.48,
          "en": "To set this back to an empty string,",
          "zh": ""
        },
        {
          "id": 116,
          "start": 313.48,
          "end": 316.05,
          "en": "which also was our initial state.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 316.05,
          "end": 318.73,
          "en": "And since we bind enteredNumber,",
          "zh": ""
        },
        {
          "id": 118,
          "start": 318.73,
          "end": 321.24,
          "en": "to the value of text input,",
          "zh": ""
        },
        {
          "id": 119,
          "start": 321.24,
          "end": 323.17,
          "en": "if we change enteredNumber,",
          "zh": ""
        },
        {
          "id": 120,
          "start": 323.17,
          "end": 326.07,
          "en": "if we change this state as we do it here,",
          "zh": ""
        },
        {
          "id": 121,
          "start": 326.07,
          "end": 329.253,
          "en": "the value in the input will be changed.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 330.14,
          "end": 333.76,
          "en": "So therefore, now we can point at resetInputHandler,",
          "zh": ""
        },
        {
          "id": 123,
          "start": 333.76,
          "end": 336.64,
          "en": "like this, and now the input will be reset,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 336.64,
          "end": 339.68,
          "en": "whenever this Dialog is confirmed.",
          "zh": ""
        },
        {
          "id": 125,
          "start": 339.68,
          "end": 341.48,
          "en": "Now last but not least,",
          "zh": ""
        },
        {
          "id": 126,
          "start": 341.48,
          "end": 344.9,
          "en": "I will also connect this reset button,",
          "zh": ""
        },
        {
          "id": 127,
          "start": 344.9,
          "end": 348.99,
          "en": "to this newly added resetInputHandler function,",
          "zh": ""
        },
        {
          "id": 128,
          "start": 348.99,
          "end": 350.8,
          "en": "by adding the onPress prop,",
          "zh": ""
        },
        {
          "id": 129,
          "start": 350.8,
          "end": 355.35,
          "en": "and pointing at resetInputHandler here as well.",
          "zh": ""
        },
        {
          "id": 130,
          "start": 355.35,
          "end": 357.4,
          "en": "This is not related to the alert,",
          "zh": ""
        },
        {
          "id": 131,
          "start": 357.4,
          "end": 359.313,
          "en": "but it's also something we need to do.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 360.43,
          "end": 362.3,
          "en": "So now we should show an alert,",
          "zh": ""
        },
        {
          "id": 133,
          "start": 362.3,
          "end": 364.373,
          "en": "if the value is invalid,",
          "zh": ""
        },
        {
          "id": 134,
          "start": 364.373,
          "end": 368.53,
          "en": "otherwise, I'll just log valid number for the moment.",
          "zh": ""
        },
        {
          "id": 135,
          "start": 368.53,
          "end": 369.5,
          "en": "In the future,",
          "zh": ""
        },
        {
          "id": 136,
