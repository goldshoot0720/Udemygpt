          "zh": ""
        },
        {
          "id": 82,
          "start": 247.42,
          "end": 250.083,
          "en": "when using the useNavigation hook for example.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 251.26,
          "end": 253.487,
          "en": "So that's how we can get hold of this object here",
          "zh": ""
        },
        {
          "id": 84,
          "start": 253.487,
          "end": 257.36,
          "en": "in the screen options and then of course in header right,",
          "zh": ""
        },
        {
          "id": 85,
          "start": 257.36,
          "end": 260.25,
          "en": "which is inside of that screen options function.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 260.25,
          "end": 262.33,
          "en": "In this on press function here",
          "zh": ""
        },
        {
          "id": 87,
          "start": 262.33,
          "end": 264.76,
