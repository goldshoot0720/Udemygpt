          "end": 48.45,
          "en": "instead it's used inside of some other screen,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 48.45,
          "end": 50.17,
          "en": "but therefore this component",
          "zh": ""
        },
        {
          "id": 19,
          "start": 50.17,
          "end": 53.29,
          "en": "actually doesn't receive the navigation prop",
          "zh": ""
        },
        {
          "id": 20,
          "start": 53.29,
          "end": 56.77,
          "en": "provided by the React Navigation package.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 56.77,
          "end": 60.16,
