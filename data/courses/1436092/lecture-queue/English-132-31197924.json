          "end": 90.37,
          "en": "which then has this navigate method",
          "zh": ""
        },
        {
          "id": 31,
          "start": 90.37,
          "end": 93.243,
          "en": "which we can use to navigate to a different screen.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 94.12,
          "end": 97.87,
          "en": "So with this navigation object provided by this hook",
          "zh": ""
        },
        {
          "id": 33,
          "start": 97.87,
          "end": 100.77000000000001,
          "en": "inside of the expense press handler function",
          "zh": ""
        },
        {
          "id": 34,
          "start": 100.77000000000001,
          "end": 103.06,
          "en": "we can call navigation dot navigate",
          "zh": ""
        },
        {
          "id": 35,
          "start": 103.93,
          "end": 106.81,
