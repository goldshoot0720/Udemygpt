        },
        {
          "id": 24,
          "start": 68.06,
          "end": 73.06,
          "en": "We can import it from at React Navigation slash native",
          "zh": ""
        },
        {
          "id": 25,
          "start": 73.18,
          "end": 77.01,
          "en": "and from there we can import the useNavigation hook.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 77.01,
          "end": 81.32,
          "en": "This hook can now be executed here",
          "zh": ""
        },
        {
          "id": 27,
          "start": 81.32,
          "end": 82.86,
          "en": "in this component function",
          "zh": ""
        },
        {
          "id": 28,
          "start": 82.86,
          "end": 85.73,
          "en": "in the expense item component function",
          "zh": ""
        },
        {
          "id": 29,
          "start": 85.73,
          "end": 87.93,
