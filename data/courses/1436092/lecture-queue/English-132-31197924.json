          "zh": ""
        },
        {
          "id": 3,
          "start": 7.78,
          "end": 9.09,
          "en": "Well, in that case,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.09,
          "end": 12.13,
          "en": "I wanna open this Manage Expense screen.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.13,
          "end": 14.193,
          "en": "We wanna navigate to that screen.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.53,
          "end": 18.8,
          "en": "And therefore, for example here in expense item",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.8,
          "end": 20.78,
          "en": "in the expense press handler",
