          "end": 22.92,
          "en": "we wanna call the navigate method",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.92,
          "end": 25.383,
          "en": "that is provided by React Navigation.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 26.27,
          "end": 28.21,
