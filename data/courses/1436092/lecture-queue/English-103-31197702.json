          "zh": ""
        },
        {
          "id": 61,
          "start": 180.655,
          "end": 182.76,
          "en": "from React Native so that we can add",
          "zh": ""
        },
        {
          "id": 62,
          "start": 183.918,
          "end": 186.974,
          "en": "our styles object here with Style Sheet create.",
