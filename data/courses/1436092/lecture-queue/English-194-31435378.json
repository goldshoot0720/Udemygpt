        },
        {
          "id": 14,
          "start": 30.89,
          "end": 32.71,
          "en": "and no background color,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 32.71,
          "end": 35.67,
          "en": "and actually a button that is a combination of text",
          "zh": ""
        },
        {
          "id": 16,
          "start": 35.67,
          "end": 36.793,
          "en": "and an I icon.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 37.92,
          "end": 38.753,
          "en": "So for this here,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 38.753,
          "end": 41.87,
          "en": "I have my OutlinedButton Component function,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 41.87,
          "end": 43.21,
          "en": "which of course,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 43.21,
          "end": 45.603,
          "en": "is exported as always.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 46.49,
          "end": 47.323,
          "en": "And then in there,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 47.323,
          "end": 49.25,
          "en": "we can return the Pressable Component,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 49.25,
          "end": 51.77,
          "en": "which we need to register presses.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 51.77,
          "end": 53.34,
          "en": "And in there, as I said,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 53.34,
          "end": 57.15,
          "en": "I want to have a combination of icon and text,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 57.15,
          "end": 61,
          "en": "hence from at Expo vector icons,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 61,
          "end": 64.51,
          "en": "I will again, import Ionicons here.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 64.51,
          "end": 65.91,
          "en": "So that inside of pressable,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 65.91,
          "end": 67.33,
          "en": "we can render an icon,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 67.33,
          "end": 68.53,
          "en": "and then next to it,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 68.53,
          "end": 72.8,
          "en": "the text with the text component exposed by React Native.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 72.8,
          "end": 75.32,
          "en": "Now we need some configuration from outside.",
