          "zh": ""
        },
        {
          "id": 8,
          "start": 18.14,
          "end": 20.043,
          "en": "to practice this again as well.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 20.89,
          "end": 21.91,
          "en": "Now for that,",
          "zh": ""
        },
