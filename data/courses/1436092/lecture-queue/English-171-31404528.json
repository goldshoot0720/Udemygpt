  "lectures": [
    {
      "id": "31404528",
      "title": "Controlling Signup & Login Screens",
      "lectureOrder": 175,
      "videoOrder": 171,
      "sourceHash": "70b398b1eb2158505629b79bb88dedb27039877275e42c58e6a9ab6794e27fa3",
      "cues": [
        {
          "id": 1,
          "start": 2.095,
          "end": 3.82,
          "en": "[Maximilian Schwarzmüller] So, as a first step",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.82,
          "end": 6.84,
          "en": "let's make sure that we can actually switch",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.84,
          "end": 9.32,
          "en": "to the signup page here.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.32,
          "end": 11.49,
          "en": "Now to make sure that we can do that.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.49,
          "end": 13.17,
          "en": "We need to go back to our code",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.17,
          "end": 16.522,
          "en": "and actually work in the AuthContent.js file,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 16.522,
          "end": 19.42,
          "en": "AuthContent.js because in that file,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 19.42,
          "end": 21.17,
          "en": "we get this FlatButton.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 21.17,
          "end": 22.75,
          "en": "So this custom button,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 22.75,
          "end": 26.23,
          "en": "which says create a new user or log in instead,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 26.23,
          "end": 29.033,
          "en": "and that is this button we see here below the form.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 30.01,
          "end": 32.56,
          "en": "Now I wanna make sure that when this button is clicked,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 32.56,
          "end": 34.5,
          "en": "we switch to the signup form.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 34.5,
          "end": 36.63,
          "en": "And if it's clicked on the signup form,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 36.63,
          "end": 39.32,
          "en": "we switch back to the login form.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 39.32,
          "end": 40.8,
          "en": "Now to implement this,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 40.8,
          "end": 43.734,
          "en": "we already have a switchAuthModeHandler,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 43.734,
          "end": 46.21,
          "en": "which is triggered when this button is pressed",
          "zh": ""
        },
        {
          "id": 19,
          "start": 46.21,
          "end": 49.653,
          "en": "but this switchAuthModeHandler has no code in it.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 50.86,
          "end": 54.64,
          "en": "Now, thankfully, switching is pretty easy though.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 54.64,
          "end": 57.31,
          "en": "We are getting a, isLogin prop",
          "zh": ""
        },
        {
          "id": 22,
          "start": 57.31,
          "end": 59.16,
          "en": "in this AuthContent component.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 59.16,
          "end": 62.23,
          "en": "And you might remember that this isLogin prop",
          "zh": ""
        },
        {
          "id": 24,
          "start": 62.23,
          "end": 66.05,
          "en": "is set here in the login screen component",
          "zh": ""
        },
        {
          "id": 25,
          "start": 66.05,
          "end": 68.283,
          "en": "but not in the signup screen component.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 69.18,
          "end": 71.59,
          "en": "So it's false for the signup screen",
          "zh": ""
        },
        {
          "id": 27,
          "start": 71.59,
          "end": 74.67,
          "en": "but true for the LoginScreen.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 74.67,
          "end": 78.24,
          "en": "And they offer this islogin prop is true or false",
          "zh": ""
        },
        {
          "id": 29,
          "start": 78.24,
          "end": 80.52,
          "en": "and it can be used here to find out",
          "zh": ""
        },
        {
          "id": 30,
          "start": 80.52,
          "end": 82.46000000000001,
          "en": "to which page we want navigate",
          "zh": ""
        },
        {
          "id": 31,
          "start": 82.46000000000001,
          "end": 84.82300000000001,
          "en": "to the signup or login page.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 85.82,
          "end": 88.953,
          "en": "So here we can check if isLogin is true.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 88.953,
          "end": 90.21000000000001,
          "en": "And if it is true,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 90.21000000000001,
          "end": 93.75,
          "en": "we know that we want to go to the signup page instead.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 93.75,
          "end": 98.75,
          "en": "Now to get to the signup page, we can use the navigation API",
          "zh": ""
        },
        {
          "id": 36,
          "start": 99.2,
          "end": 102.09,
          "en": "from the react navigation package.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 102.09,
          "end": 105.66,
          "en": "Now we don't get the navigation prop here",
          "zh": ""
        },
        {
          "id": 38,
          "start": 105.66,
          "end": 107.72,
          "en": "in this AuthContent component",
          "zh": ""
        },
        {
          "id": 39,
          "start": 107.72,
          "end": 109.99000000000001,
          "en": "because this is not a screen component.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 109.99000000000001,
          "end": 113.67,
          "en": "It's used in a screen, but it's not loaded as a screen",
          "zh": ""
        },
        {
          "id": 41,
          "start": 113.67,
          "end": 115.75999999999999,
          "en": "but you learned how you can still get access",
          "zh": ""
        },
        {
          "id": 42,
          "start": 115.75999999999999,
          "end": 118.71000000000001,
          "en": "to the navigation object in components",
          "zh": ""
        },
        {
          "id": 43,
          "start": 118.71000000000001,
          "end": 120.92,
          "en": "when working with react navigation,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 120.92,
          "end": 123.24,
          "en": "which we are in this app here.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 123.24,
          "end": 127.193,
          "en": "You can use a special hook provided by react navigation.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 128.12,
          "end": 132.763,
          "en": "So, from @react-navigation/native,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 135.07,
          "end": 138.24,
          "en": "we can import the useNavigation hook",
          "zh": ""
        },
        {
          "id": 48,
          "start": 139.66,
          "end": 143.043,
          "en": "and then this hook can be executed here.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 144.386,
          "end": 147.85,
          "en": "And we get hold of the navigation object.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 147.85,
          "end": 149.95,
          "en": "And this navigation object is important",
          "zh": ""
        },
        {
          "id": 51,
          "start": 149.95,
          "end": 153.02,
          "en": "because this navigation object gives us methods",
          "zh": ""
        },
        {
          "id": 52,
          "start": 153.02,
          "end": 154.483,
          "en": "for navigating around.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 155.49,
          "end": 157.91,
          "en": "For example, early in the course already,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 157.91,
          "end": 161.02,
          "en": "we saw that we can use the navigate method here.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 161.02,
          "end": 163.39,
          "en": "Now, if we have a brief look at App.js,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 163.39,
          "end": 166.84,
          "en": "we see the names of our pages, of our screens",
          "zh": ""
        },
        {
          "id": 57,
          "start": 166.84,
          "end": 169.53,
          "en": "and we see that the LoginScreen is named Login",
          "zh": ""
        },
        {
          "id": 58,
          "start": 169.53,
          "end": 172.07,
          "en": "and the SignupScreen is name Signup.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 172.07,
          "end": 175.88,
          "en": "So if I wanna navigate to the Signup screen here,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 175.88,
          "end": 178.793,
          "en": "I can navigate to Signup like this.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 179.93,
          "end": 183.16,
          "en": "And in the else case, if isLogin is false.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 183.16,
          "end": 185.77,
          "en": "So if we are on the Signup screen,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 185.77,
          "end": 189.29,
          "en": "we can simply call navigation navigate Login",
          "zh": ""
        },
        {
          "id": 64,
          "start": 189.29,
          "end": 191.69,
          "en": "to go to the login screen.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 191.69,
          "end": 193.72,
          "en": "If we do that and we save this,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 193.72,
          "end": 196.803,
          "en": "this button will work now and we can switch between screens.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 198.6,
          "end": 199.74,
          "en": "So that is working.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 199.74,
          "end": 202.36,
          "en": "But I also wanna show you an alternative.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 202.36,
          "end": 205.92000000000002,
          "en": "There is nothing wrong with this flow, which we have here.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 205.92000000000002,
          "end": 209.3,
          "en": "Where we go forth and back, which is nice",
          "zh": ""
        },
        {
          "id": 71,
          "start": 209.3,
          "end": 213.25,
          "en": "but maybe you also just want to replace the current screen",
          "zh": ""
        },
        {
          "id": 72,
          "start": 213.25,
          "end": 214.29,
          "en": "with the average screen.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 214.29,
          "end": 216.93,
          "en": "So you don't wanna have this back button here,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 216.93,
          "end": 219.71,
          "en": "even though there is nothing wrong with it.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 219.71,
          "end": 222.4,
          "en": "If you would wanna do something like this,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 222.4,
          "end": 227.05,
          "en": "you can also call replace instead of navigate.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 227.05,
          "end": 229.32999999999998,
          "en": "It also navigates to a different screen",
          "zh": ""
        },
        {
          "id": 78,
          "start": 229.32999999999998,
          "end": 231.24,
          "en": "but it doesn't give you a back button.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 231.24,
          "end": 233.24,
          "en": "That's the difference.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 233.24,
          "end": 236.41,
          "en": "It doesn't add the new screen to the stack of screens",
          "zh": ""
        },
        {
          "id": 81,
          "start": 236.41,
          "end": 238.73,
          "en": "but instead it replaces the current screen",
          "zh": ""
        },
        {
          "id": 82,
          "start": 238.73,
          "end": 239.92000000000002,
          "en": "with the new screen.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 239.92000000000002,
          "end": 242.77,
          "en": "So there is no going forth and back.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 242.77,
          "end": 245.16,
          "en": "If you use replace instead of navigate,",
          "zh": ""
        },
        {
          "id": 85,
          "start": 245.16,
          "end": 248.01,
          "en": "you still get the animation, but there is no back button.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 248.9,
          "end": 249.86,
          "en": "It's up to you.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 249.86,
          "end": 252.63,
          "en": "What you prefer, which mode you will prefer.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 252.63,
          "end": 255.96,
          "en": "But I just wanted to show you this replace method as well,",
          "zh": ""
        },
        {
          "id": 89,
          "start": 255.96,
          "end": 259.69,
          "en": "which you can use with the stack navigator here.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 259.69,
          "end": 262.74,
          "en": "And with that, we are able to switch between pages.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 262.74,
          "end": 265.93,
          "en": "Therefore we can now reach this Signup page",
          "zh": ""
        },
        {
          "id": 92,
          "start": 265.93,
          "end": 268.45,
          "en": "and therefore we can now make sure",
          "zh": ""
        },
        {
          "id": 93,
          "start": 268.45,
          "end": 271.89,
          "en": "that we actually do something if we entered valid data",
          "zh": ""
        },
        {
          "id": 94,
          "start": 271.89,
          "end": 273.6,
          "en": "and that we do send a request",
          "zh": ""
        },
        {
          "id": 95,
          "start": 273.6,
          "end": 276.783,
          "en": "to our backend to create a new user there.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}
