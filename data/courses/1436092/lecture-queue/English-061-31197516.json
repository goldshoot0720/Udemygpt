        },
        {
          "id": 3,
          "start": 7.08,
          "end": 9.61,
          "en": "and we added our reusable colors,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.61,
          "end": 12.07,
          "en": "it's time to work on the other features",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.07,
          "end": 15.1,
          "en": "that should be implemented into this game screen.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.1,
          "end": 19.89,
