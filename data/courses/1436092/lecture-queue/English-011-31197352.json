        },
        {
          "id": 118,
          "start": 335.81,
          "end": 338.29,
          "en": "but you do this either in line,",
          "zh": ""
        },
        {
          "id": 119,
          "start": 338.29,
          "end": 340.52,
          "en": "essentially by using props",
          "zh": ""
        },
        {
          "id": 120,
          "start": 340.52,
          "end": 343.97,
          "en": "on those core components that are provided",
          "zh": ""
        },
        {
          "id": 121,
          "start": 343.97,
          "end": 347.5,
          "en": "or with help of these SyleSheet objects",
          "zh": ""
        },
        {
          "id": 122,
          "start": 347.5,
          "end": 349.4,
          "en": "or this SyleSheet object",
          "zh": ""
        },
        {
          "id": 123,
          "start": 349.4,
          "end": 351.703,
          "en": "which you already saw in the code before.",
          "zh": ""
        },
        {
          "id": 124,
          "start": 352.82,
          "end": 356.25,
          "en": "You therefore. write your styling in JavaScript.",
          "zh": ""
        },
        {
          "id": 125,
          "start": 356.25,
          "end": 359.64,
          "en": "And hence, you have no extra styling language.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 359.64,
          "end": 363.15,
          "en": "It's all JavaScript, but the React Native team",
          "zh": ""
        },
        {
          "id": 127,
          "start": 363.15,
          "end": 366.84,
          "en": "gives you a lot of JavaScript properties",
          "zh": ""
        },
        {
          "id": 128,
          "start": 366.84,
          "end": 370.3,
          "en": "which you can set and pass to those core elements,",
          "zh": ""
        },
        {
          "id": 129,
