        },
        {
          "id": 93,
          "start": 259.23,
          "end": 260.93,
          "en": "by a React Native.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 260.93,
          "end": 263.6,
          "en": "That's why we work with those core components",
