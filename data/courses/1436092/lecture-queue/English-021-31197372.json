      "sourceHash": "690519c977692ed4e2ffd26fc74a79f259192e5997e82f3739387830b36924cc",
      "cues": [
        {
          "id": 1,
          "start": 2.082,
          "end": 3.69,
          "en": "Outputting the data in a list",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.69,
          "end": 5.84,
          "en": "as we're doing it here is nice",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.84,
          "end": 8.7,
          "en": "but it would also be nice to have some styling",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.7,
          "end": 10.77,
          "en": "on those list items.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.77,
          "end": 12.58,
          "en": "And therefore, that's what I wanna do next,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 12.58,
          "end": 15.6,
          "en": "of course feel free to also pause the video here",
          "zh": ""
        },
        {
          "id": 7,
          "start": 15.6,
          "end": 17.73,
          "en": "and practice this on your own.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 17.73,
          "end": 20.65,
          "en": "Apply some styling, any styling of your choice",
          "zh": ""
        },
        {
          "id": 9,
          "start": 20.65,
          "end": 23.8,
          "en": "to these individual list items,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 23.8,
          "end": 25.33,
          "en": "and then compare your solution",
          "zh": ""
        },
        {
          "id": 11,
          "start": 25.33,
          "end": 27.583,
          "en": "to mine to see how I style this.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 28.89,
          "end": 30.71,
          "en": "Now, here's what I will do.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 30.71,
          "end": 33.55,
          "en": "I will create a new object that keeps",
          "zh": ""
        },
        {
          "id": 14,
          "start": 33.55,
          "end": 36.78,
          "en": "or that holds the styles for those list items.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 36.78,
          "end": 39.23,
          "en": "And I'll name it, goal item.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 39.23,
          "end": 40.82,
          "en": "The name is up to you though,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 40.82,
          "end": 44.72,
          "en": "here in this style sheet object, and then in this object",
          "zh": ""
        },
        {
          "id": 18,
          "start": 44.72,
          "end": 48.18,
          "en": "which defines the styles for this identifier, you can set up",
          "zh": ""
        },
        {
          "id": 19,
          "start": 48.18,
          "end": 52.35,
          "en": "any styles you want, and I'll give every goal item",
          "zh": ""
        },
        {
          "id": 20,
          "start": 52.35,
          "end": 54.1,
          "en": "a little bit of margin, for example",
          "zh": ""
        },
        {
          "id": 21,
          "start": 54.1,
          "end": 58.193,
          "en": "so that we have some spacing around it, maybe eight pixels.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 59.5,
          "end": 63.73,
          "en": "I also wanna add a border radius here",
          "zh": ""
        },
        {
          "id": 23,
          "start": 63.73,
          "end": 66.14,
          "en": "so that we have rounded corners",
          "zh": ""
        },
        {
          "id": 24,
          "start": 66.14,
          "end": 70.76,
          "en": "and this also wants a value, that's defined as a number.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 70.76,
          "end": 72.863,
          "en": "And here I'll set this to six pixels.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 74.21000000000001,
          "end": 76.99,
          "en": "Now to make sure that we can see this radius,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 76.99,
          "end": 80.66,
          "en": "I will give this a background color",
          "zh": ""
        },
        {
          "id": 28,
          "start": 80.66,
          "end": 84.395,
          "en": "so that this item has an overall background color",
          "zh": ""
        },
        {
          "id": 29,
          "start": 84.395,
          "end": 88.75,
          "en": "of a specific hex code that I prepared ahead of time",
          "zh": ""
        },
        {
          "id": 30,
          "start": 88.75,
          "end": 93.593,
          "en": "which is five E zero A C C, which is a nice purple color.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 95.81,
          "end": 98.22,
          "en": "I also wanna have some padding in here",
          "zh": ""
        },
        {
          "id": 32,
          "start": 98.22,
          "end": 101.2,
          "en": "so I'll actually add it next to the margin",
          "zh": ""
        },
        {
          "id": 33,
          "start": 101.2,
          "end": 102.50999999999999,
          "en": "not because it's required",
          "zh": ""
        },
        {
          "id": 34,
          "start": 102.50999999999999,
          "end": 104.703,
          "en": "but to keep those related values together.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 105.68,
          "end": 109.11,
          "en": "And I'll add a padding of, let's say eight pixels as well.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 109.11,
          "end": 111.513,
          "en": "So that we have some inner spacing as well.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 112.46000000000001,
          "end": 115.84,
          "en": "And last but not least, I also want to add a color here",
          "zh": ""
        },
        {
          "id": 38,
          "start": 115.84,
          "end": 119.57,
          "en": "and I'll set this to white and this will be the text color.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 119.57,
          "end": 122.61,
          "en": "So again, you see the property names are pretty similar",
          "zh": ""
        },
        {
          "id": 40,
          "start": 122.61,
          "end": 124.6,
          "en": "to what you know from CSS.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 124.6,
          "end": 128.12,
          "en": "We of course have this camel casing instead of using dashes",
          "zh": ""
        },
        {
          "id": 42,
          "start": 128.12,
          "end": 130.91,
          "en": "because dashes are not supported in JavaScript",
          "zh": ""
        },
        {
          "id": 43,
          "start": 130.91,
          "end": 134.123,
          "en": "but besides that, the names should look familiar.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 135.19,
          "end": 137.87,
          "en": "Now we can assign this goal item style",
          "zh": ""
        },
        {
          "id": 45,
          "start": 137.87,
          "end": 140.03,
          "en": "to our text items here.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 140.03,
          "end": 142.54,
          "en": "So here we can add the style prop",
          "zh": ""
        },
        {
          "id": 47,
          "start": 142.54,
          "end": 144.673,
          "en": "and set this equal to styles.goalItem.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 146.37,
          "end": 149.12,
          "en": "And I'll reformat this to make it a bit easier to read.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 150.13,
          "end": 151.71,
          "en": "With that, if we save this,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 151.71,
          "end": 154.163,
          "en": "this updates and we see our items here.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 155.17000000000002,
          "end": 160.07999999999998,
          "en": "What you will see is that we got this changed styling",
          "zh": ""
        },
        {
          "id": 52,
          "start": 160.07999999999998,
          "end": 163.94,
          "en": "but actually on iOS, the rounded corners are missing.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 163.94,
          "end": 165.543,
          "en": "We only have them on Android.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 166.61,
          "end": 168.77,
          "en": "Now, why are they missing here?",
          "zh": ""
        },
        {
          "id": 55,
          "start": 168.77,
          "end": 172.72,
          "en": "And what can we do to fix the styling there as well?",
          "zh": ""
        },
        {
          "id": 56,
          "start": 172.72,
          "end": 174.39,
          "en": "This is a good time to talk",
          "zh": ""
        },
        {
          "id": 57,
          "start": 174.39,
          "end": 178.12,
          "en": "about the differences between the two platforms.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 178.12,
          "end": 181.43,
          "en": "The idea behind React Native is that you can write code",
          "zh": ""
        },
        {
          "id": 59,
          "start": 181.43,
          "end": 185.75,
          "en": "with React that will actually give you native mobile apps",
          "zh": ""
        },
        {
          "id": 60,
          "start": 185.75,
          "end": 188.2,
          "en": "for multiple target platforms.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 188.2,
          "end": 190.43,
          "en": "So you don't need to write different code",
          "zh": ""
        },
        {
          "id": 62,
          "start": 190.43,
          "end": 193.2,
          "en": "to target different platforms,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 193.2,
          "end": 196,
          "en": "but one of the same code base can get you there.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 196,
          "end": 197.9,
          "en": "Now this is generally true,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 197.9,
          "end": 200.62,
          "en": "but as you will also learn later in the course,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 200.62,
          "end": 202.66,
          "en": "sometimes there are differences",
          "zh": ""
        },
        {
          "id": 67,
          "start": 202.66,
          "end": 205.56,
          "en": "and sometimes you need to make tiny code adjustments",
          "zh": ""
        },
        {
          "id": 68,
          "start": 205.56,
          "end": 209.2,
          "en": "to target all platforms in the right way.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 209.2,
          "end": 211.09,
          "en": "And for example, here, we got a difference.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 211.09,
          "end": 212.9,
          "en": "The rounded corners are missing",
          "zh": ""
        },
        {
          "id": 71,
          "start": 212.9,
          "end": 216.72,
          "en": "on iOS because we added our styling here",
          "zh": ""
        },
        {
          "id": 72,
          "start": 216.72,
          "end": 219.46,
          "en": "that applies the rounded corners directly",
          "zh": ""
        },
        {
          "id": 73,
          "start": 219.46,
          "end": 221.72,
          "en": "on this text component.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 221.72,
          "end": 222.91,
          "en": "Now it turns out",
          "zh": ""
        },
        {
          "id": 75,
          "start": 222.91,
          "end": 227.67000000000002,
          "en": "that this text component is translated by React Native",
          "zh": ""
        },
        {
          "id": 76,
          "start": 227.67000000000002,
          "end": 232.113,
          "en": "to a fitting native widget, a native UI element.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 233.07,
          "end": 235.73,
          "en": "And the element to which it is translated",
          "zh": ""
        },
        {
          "id": 78,
          "start": 235.73,
          "end": 238.98,
          "en": "in case of Android seems to be an element",
          "zh": ""
        },
        {
          "id": 79,
          "start": 238.98,
          "end": 241.47,
          "en": "where corners can be rounded.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 241.47,
          "end": 242.61,
          "en": "But in case of iOS,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 242.61,
          "end": 246.69,
          "en": "it looks like the underlying native text output element",
          "zh": ""
        },
        {
          "id": 82,
          "start": 246.69,
          "end": 249.77,
          "en": "does not support rounded corners.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 249.77,
          "end": 252.76,
          "en": "And that's why border radius has no effect",
          "zh": ""
        },
        {
          "id": 84,
          "start": 252.76,
          "end": 254.453,
          "en": "on the text elements on iOS.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 255.58,
          "end": 257.19,
          "en": "Now to work around that,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 257.19,
          "end": 260.713,
          "en": "we can wrap our text here in a view.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 261.69,
          "end": 265.29,
          "en": "So in this more generic container element,",
          "zh": ""
        },
        {
          "id": 88,
          "start": 265.29,
          "end": 269.02,
          "en": "this is also translated to a fitting underlying element.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 269.02,
          "end": 272.15,
          "en": "And it turns out that the underlying element",
          "zh": ""
        },
        {
          "id": 90,
          "start": 272.15,
          "end": 276.2,
          "en": "to which view is compiled by React Native is an element",
          "zh": ""
        },
        {
          "id": 91,
          "start": 276.2,
          "end": 280.52,
          "en": "that supports surrounded corners on both platforms.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 280.52,
          "end": 281.69,
          "en": "How do I know that?",
          "zh": ""
        },
        {
          "id": 93,
          "start": 281.69,
          "end": 283.94,
          "en": "From the official docs and experience",
          "zh": ""
        },
        {
          "id": 94,
          "start": 283.94,
          "end": 286.09000000000003,
          "en": "and I'm explaining it to you in this course",
          "zh": ""
        },
        {
          "id": 95,
          "start": 286.09000000000003,
          "end": 288.803,
          "en": "so that you don't have to find it out the hard way.",
          "zh": ""
        },
        {
          "id": 96,
          "start": 289.9,
          "end": 291.57,
          "en": "So what we can do now is",
          "zh": ""
        },
        {
          "id": 97,
          "start": 291.57,
          "end": 294.36,
          "en": "we can grab our style assignment here",
          "zh": ""
        },
        {
          "id": 98,
          "start": 294.36,
          "end": 296.11,
          "en": "and add this on this view",
          "zh": ""
        },
        {
          "id": 99,
          "start": 296.11,
          "end": 298.96,
          "en": "and also add the key here on this view,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 298.96,
          "end": 301.28,
          "en": "because now the view is the main element",
          "zh": ""
        },
        {
          "id": 101,
          "start": 301.28,
          "end": 303.56,
          "en": "that's output here in the list.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 303.56,
          "end": 306.4,
          "en": "The text now is a nested element.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 306.4,
          "end": 308.11,
          "en": "We still need the text",
          "zh": ""
        },
        {
          "id": 104,
          "start": 308.11,
          "end": 310.58,
          "en": "because we still have some text to output.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 310.58,
          "end": 314.19,
          "en": "And as you learned before, text must go between text text",
          "zh": ""
        },
        {
          "id": 106,
          "start": 315.05,
          "end": 316.78,
          "en": "but the styling is now applied",
          "zh": ""
        },
        {
          "id": 107,
          "start": 316.78,
          "end": 320.49,
          "en": "to the more versatile view element.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 320.49,
          "end": 322.96,
          "en": "If we do that and we save everything",
          "zh": ""
        },
        {
          "id": 109,
          "start": 322.96,
          "end": 326.87,
          "en": "we now see the rounded corners on iOS as well.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 326.87,
          "end": 328.46,
          "en": "What we also see though",
          "zh": ""
        },
        {
          "id": 111,
          "start": 328.46,
          "end": 331.55,
          "en": "is that the text is no longer white.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 331.55,
          "end": 335.43,
          "en": "Now we still have the color white setting here",
          "zh": ""
        },
        {
          "id": 113,
          "start": 335.43,
          "end": 338.9,
          "en": "but this is part of the goal item, which now",
          "zh": ""
        },
        {
          "id": 114,
          "start": 338.9,
          "end": 343.35,
          "en": "is actually assigned to this view here, not to the text",
          "zh": ""
        },
        {
          "id": 115,
          "start": 344.32,
          "end": 349.32,
          "en": "and unlike in CSS for the web, the styles don't cascade.",
          "zh": ""
        },
        {
          "id": 116,
          "start": 349.67,
          "end": 352.09000000000003,
          "en": "That's another important learning here.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 352.09000000000003,
          "end": 356.87,
          "en": "We do have this CSS like property language here",
          "zh": ""
        },
        {
          "id": 118,
          "start": 356.87,
          "end": 358.46,
          "en": "if you wanna call it like that,",
          "zh": ""
        },
        {
          "id": 119,
          "start": 358.46,
          "end": 362.29,
          "en": "these CSS like property names, but it's not CSS.",
          "zh": ""
        },
        {
          "id": 120,
          "start": 362.29,
          "end": 364.11,
          "en": "It never was.",
          "zh": ""
        },
        {
          "id": 121,
          "start": 364.11,
          "end": 367.42,
          "en": "So therefore core CSS characteristics",
          "zh": ""
        },
        {
          "id": 122,
          "start": 367.42,
          "end": 371.99,
          "en": "like the cascading nature of CSS, where child elements",
          "zh": ""
        },
        {
          "id": 123,
          "start": 371.99,
          "end": 375.74,
          "en": "and descendant elements, inherit styles from parent",
          "zh": ""
        },
        {
          "id": 124,
          "start": 375.74,
          "end": 378.38,
          "en": "and ancestor elements is not part",
          "zh": ""
        },
        {
          "id": 125,
          "start": 378.38,
          "end": 380.69,
          "en": "of React Native's styling approach.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 380.69,
          "end": 383.81,
          "en": "We don't have style inheritance here.",
          "zh": ""
        },
        {
          "id": 127,
          "start": 383.81,
          "end": 386.21,
          "en": "So if we assign a text color to the view,",
          "zh": ""
        },
        {
          "id": 128,
          "start": 386.21,
          "end": 388.74,
          "en": "this does not affect this text",
          "zh": ""
        },
        {
          "id": 129,
          "start": 388.74,
          "end": 391.94,
          "en": "or the text inside this text text to be precise",
          "zh": ""
        },
        {
          "id": 130,
          "start": 391.94,
          "end": 395.03,
          "en": "because that's a totally standalone element.",
          "zh": ""
        },
        {
          "id": 131,
          "start": 395.03,
          "end": 396.85,
          "en": "It is not related to this view.",
          "zh": ""
        },
        {
          "id": 132,
          "start": 396.85,
          "end": 399.69,
          "en": "It does not inherit any styles from that view.",
          "zh": ""
        },
        {
          "id": 133,
          "start": 399.69,
          "end": 402.81,
          "en": "So setting the text color on this view does nothing",
          "zh": ""
        },
        {
          "id": 134,
          "start": 402.81,
          "end": 406.437,
          "en": "to the text inside that text element.",
          "zh": ""
        },
        {
          "id": 135,
          "start": 406.437,
          "end": 407.57,
          "en": "Therefore, what we need to do",
          "zh": ""
        },
        {
          "id": 136,
          "start": 407.57,
          "end": 410.76,
          "en": "is add another style object here,",
          "zh": ""
        },
        {
          "id": 137,
          "start": 410.76,
          "end": 414.12,
          "en": "the goal text, that sounds like a fitting name.",
          "zh": ""
        },
        {
          "id": 138,
          "start": 414.12,
          "end": 416.39,
          "en": "And we set our text color on that",
          "zh": ""
        },
        {
          "id": 139,
          "start": 416.39,
          "end": 419.28,
          "en": "and remove it from goal item on the view.",
