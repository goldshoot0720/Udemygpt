        },
        {
          "id": 149,
          "start": 444.94,
          "end": 446.36,
          "en": "And this is really important.",
          "zh": ""
        },
        {
          "id": 150,
          "start": 446.36,
          "end": 448.18,
          "en": "This is something you must understand",
          "zh": ""
        },
        {
          "id": 151,
          "start": 448.18,
          "end": 452.59000000000003,
          "en": "about styling and about targeting different platforms.",
