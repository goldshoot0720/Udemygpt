        },
        {
          "id": 43,
          "start": 131.83,
          "end": 133.533,
          "en": "for displaying this log.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 134.81,
          "end": 137.34,
          "en": "So now we update these guessRounds",
