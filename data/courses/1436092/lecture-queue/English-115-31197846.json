      "cues": [
        {
          "id": 1,
          "start": 2.07,
          "end": 7.07,
          "en": "So that was how we can manage app wide state with context.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 7.07,
          "end": 10.29,
          "en": "And if that's all you're interested in, you can stop here.",
          "zh": ""
