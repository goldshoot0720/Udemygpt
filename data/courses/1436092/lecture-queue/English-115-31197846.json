        },
        {
          "id": 76,
          "start": 242.4,
          "end": 245.483,
          "en": "this store which we just created and exported.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 246.4,
          "end": 247.95,
          "en": "I'm importing this here.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 247.95,
          "end": 250.3,
          "en": "And then to this provider, we pass it",
          "zh": ""
        },
        {
          "id": 79,
          "start": 250.3,
          "end": 254.53,
          "en": "by setting the store prop to this store we just imported.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 254.53,
          "end": 257.04,
          "en": "And that's all we have to do here in app.js with that",
          "zh": ""
        },
        {
          "id": 81,
          "start": 257.04,
          "end": 259.86,
          "en": "we're providing this store to our app.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 259.86,
          "end": 261.54,
          "en": "And now the different parts of the app",
          "zh": ""
        },
        {
          "id": 83,
          "start": 261.54,
