          "zh": ""
        },
        {
          "id": 12,
          "start": 37.48,
          "end": 40.55,
          "en": "in depth in my react complete guide course.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 40.55,
          "end": 42.74,
          "en": "So besides the official docs",
          "zh": ""
        },
        {
          "id": 14,
          "start": 42.74,
