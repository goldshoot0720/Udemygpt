        },
        {
          "id": 36,
          "start": 109.72,
          "end": 112.3,
          "en": "we will create a so-called redux store",
          "zh": ""
        },
        {
          "id": 37,
          "start": 112.3,
          "end": 114.11,
          "en": "which is kind of comparable",
