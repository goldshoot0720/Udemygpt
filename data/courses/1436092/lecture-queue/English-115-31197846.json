        {
          "id": 3,
          "start": 10.29,
          "end": 13.07,
          "en": "You don't need to use or dive into redux.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 13.07,
          "end": 15.26,
          "en": "You can totally ignore it.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 15.26,
          "end": 16.85,
          "en": "But if you are using redux",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.85,
          "end": 19.55,
          "en": "the rest of this section is for you because we",
