  "lectures": [
    {
      "id": "31197712",
      "title": "App Finishing Touches",
      "lectureOrder": 112,
      "videoOrder": 108,
      "sourceHash": "a8339673fbe064cf48fbf08f281ccaf065e77acc393333d660ea6b2b9605663b",
      "cues": [
        {
          "id": 1,
          "start": 2.33,
          "end": 3.73,
          "en": "Regarding the fine tuning,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.73,
          "end": 6.76,
          "en": "I wanna work on that drawer.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.76,
          "end": 8.98,
          "en": "I wanna give it this brown",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.98,
          "end": 11.61,
          "en": "or some brown background color overall.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.61,
          "end": 16.06,
          "en": "And I wanna change the colors of the selected items.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.06,
          "end": 18.35,
          "en": "And we did learn how we can configure this",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.35,
          "end": 21.41,
          "en": "so we can simply apply what we learned here.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 21.41,
          "end": 23.6,
          "en": "Of course, feel free to do this a on your own first",
          "zh": ""
        },
        {
          "id": 9,
          "start": 23.6,
          "end": 25.273,
          "en": "before we then do it together.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 26.46,
          "end": 28.4,
          "en": "I will apply my settings",
          "zh": ""
        },
        {
          "id": 11,
          "start": 28.4,
          "end": 31.15,
          "en": "by going to the screen options of the draw navigator",
          "zh": ""
        },
        {
          "id": 12,
          "start": 31.15,
          "end": 33.69,
          "en": "because I want to have these style options applied",
          "zh": ""
        },
        {
          "id": 13,
          "start": 33.69,
          "end": 37.263,
          "en": "to all the screens that are part of the drawer navigator.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 40.172,
          "end": 42.977,
          "en": "And I will set the drawerContentStyle.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 45.6,
          "end": 48.57,
          "en": "To an object where I set the background color",
          "zh": ""
        },
        {
          "id": 16,
          "start": 48.57,
          "end": 50.563,
          "en": "to a dark brown.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 51.87,
          "end": 52.703,
          "en": "Like this.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 54,
          "end": 57.263,
          "en": "If I do that, the drawer has this brown background.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 58.35,
          "end": 61.08,
          "en": "Now, of course I wanna change the, the colors",
          "zh": ""
        },
        {
          "id": 20,
          "start": 61.08,
          "end": 64.4,
          "en": "of my drawer items because otherwise I can't see them.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 64.4,
          "end": 68.15,
          "en": "And to achieve this, we can add the drawerInactiveTintColor",
          "zh": ""
        },
        {
          "id": 22,
          "start": 69.28999999999999,
          "end": 71.12,
          "en": "and set this to 'white'.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 71.12,
          "end": 74.02,
          "en": "So that's the color, our text and I icons will have,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 74.02,
          "end": 75.353,
          "en": "if they're not selected.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 76.33,
          "end": 77.81,
          "en": "If items are selected,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 77.81,
          "end": 80.21000000000001,
          "en": "I wanna change the text and background color",
          "zh": ""
        },
        {
          "id": 27,
          "start": 80.21000000000001,
          "end": 82.483,
          "en": "and therefore we can set the drawerActiveTintColor.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 83.8,
          "end": 88.07,
          "en": "Let's say to a dark brown actually.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 88.07,
          "end": 90.43,
          "en": "Because I will set the drawActiveBackgroundColor",
          "zh": ""
        },
        {
          "id": 30,
          "start": 91.86,
          "end": 93.93,
          "en": "to a light brown.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 93.93,
          "end": 96.22999999999999,
          "en": "To let's say this brown",
          "zh": ""
        },
        {
          "id": 32,
          "start": 96.22999999999999,
          "end": 98.63,
          "en": "or maybe a different one, we'll see.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 98.63,
          "end": 101.41,
          "en": "If I save this, that's how it looks.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 101.41,
          "end": 104.46000000000001,
          "en": "Not too good, so actually I will switch to",
          "zh": ""
        },
        {
          "id": 35,
          "start": 104.46000000000001,
          "end": 108.9,
          "en": "a way lighter color for the background of active items.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 108.9,
          "end": 112.00999999999999,
          "en": "And with that, that's the look I want here.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 112.00999999999999,
          "end": 113.37,
          "en": "Of course, feel free to",
          "zh": ""
        },
        {
          "id": 38,
          "start": 113.37,
          "end": 116.22,
          "en": "come up with a totally different look if you prefer that.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 117.36,
          "end": 118.86,
          "en": "I also want to add some icons",
          "zh": ""
        },
        {
          "id": 40,
          "start": 118.86,
          "end": 121.29,
          "en": "and the icons should be different for the screens.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 121.29,
          "end": 122.73,
          "en": "Hence we don't do it here",
          "zh": ""
        },
        {
          "id": 42,
          "start": 122.73,
          "end": 126.35,
          "en": "in the general screen options on the overall navigator.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 126.35,
          "end": 129.69,
          "en": "But instead in the screen specific options.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 129.69,
          "end": 131.6,
          "en": "Here for the categories screen.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 131.6,
          "end": 133.621,
          "en": "We can add a drawer icon and you learn",
          "zh": ""
        },
        {
          "id": 46,
          "start": 133.621,
          "end": 137.3,
          "en": "that this is a function, react component function",
          "zh": ""
        },
        {
          "id": 47,
          "start": 137.3,
          "end": 139.97,
          "en": "where you receive some props automatically",
          "zh": ""
        },
        {
          "id": 48,
          "start": 139.97,
          "end": 143.96,
          "en": "by the drawer navigator, like the color and the size.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 143.96,
          "end": 146.39,
          "en": "And then we can render our own icons.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 146.39,
          "end": 150.55,
          "en": "And for this, I will use the good old Ionicons set again",
          "zh": ""
        },
        {
          "id": 51,
          "start": 151.74099999999999,
          "end": 153.84,
          "en": "from '@expo/vector-icons'",
          "zh": ""
        },
        {
          "id": 52,
          "start": 153.84,
          "end": 155.89,
          "en": "which we used before already.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 155.89,
          "end": 157.28300000000002,
          "en": "Get my Ionicons.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 158.17000000000002,
          "end": 160.96,
          "en": "And then choose some fitting icons here.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 160.96,
          "end": 164.22,
          "en": "And for this here, I'll add render Ionicons.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 164.22,
          "end": 166.46,
          "en": "Set the color=(color)",
          "zh": ""
        },
        {
          "id": 57,
          "start": 166.46,
          "end": 169.757,
          "en": "add the size=(size).",
          "zh": ""
        },
        {
          "id": 58,
          "start": 171.26,
          "end": 173.75,
          "en": "And now the icon I do wanna render",
          "zh": ""
        },
        {
          "id": 59,
          "start": 173.75,
          "end": 177.27,
          "en": "for the categories is a list icon.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 177.27,
          "end": 180.47,
          "en": "Of course feel free to browse through all the Ionicons,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 180.47,
          "end": 182.67,
          "en": "on this expo/vector-icons page",
          "zh": ""
        },
        {
          "id": 62,
          "start": 182.67,
          "end": 185.08,
          "en": "to find the icon you like most.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 185.08,
          "end": 186.193,
          "en": "I will go with that.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 187.12,
          "end": 189.57,
          "en": "And then copy that to my other screen",
          "zh": ""
        },
        {
          "id": 65,
          "start": 189.57,
          "end": 191.24,
          "en": "to the favorites screen",
          "zh": ""
        },
        {
          "id": 66,
          "start": 191.24,
          "end": 194.11,
          "en": "and add some options there as well.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 194.11,
          "end": 196.49,
          "en": "And here I wanna use that star icon,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 196.49,
          "end": 198.31,
          "en": "since that is about favorites.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 198.31,
          "end": 200.18,
          "en": "This screen is about favorites,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 200.18,
          "end": 202.963,
          "en": "so that star icon should make a lot of sense.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 203.82999999999998,
          "end": 205.62,
          "en": "With that we got the icons added",
          "zh": ""
        },
        {
          "id": 72,
          "start": 206.45499999999998,
          "end": 207.59,
          "en": "and now here we can see them.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 207.59,
          "end": 210.12,
          "en": "And I think that looks quite decent.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 210.12,
          "end": 211.86,
          "en": "At least that's the look I want",
          "zh": ""
        },
        {
          "id": 75,
          "start": 211.86,
          "end": 213.97,
          "en": "as mentioned you can of course go",
          "zh": ""
        },
        {
          "id": 76,
          "start": 213.97,
          "end": 216.23,
          "en": "with a different look and feel.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 216.23,
          "end": 219.24,
          "en": "Now we don't have any favorites at this point of time.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 219.24,
          "end": 222.27,
          "en": "And that is something you could add right now",
          "zh": ""
        },
        {
          "id": 79,
          "start": 222.27,
          "end": 224.88,
          "en": "but it's actually a feature I will work on",
          "zh": ""
        },
        {
          "id": 80,
          "start": 224.88,
          "end": 226.66,
          "en": "in the next course section.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 226.66,
          "end": 230.503,
          "en": "When we dive into app wide state management.",
          "zh": ""
        }
      ]
    }
