          "zh": ""
        },
        {
          "id": 33,
          "start": 88.93,
          "end": 90.513,
          "en": "from React Native as you know.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 91.52,
          "end": 93.47999999999999,
          "en": "And here in this style sheet,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 93.47999999999999,
          "end": 97.31,
          "en": "we can add our inputs row for example,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 97.31,
          "end": 101.64,
