        },
        {
          "id": 3,
          "start": 8.42,
          "end": 11.23,
          "en": "Now the layout is of course not controlled inside",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.23,
          "end": 13.07,
          "en": "of the input component,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.07,
          "end": 15.45,
          "en": "but inside of the expense form component instead",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.45,
          "end": 18.49,
          "en": "because now it is about positioning those inputs",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.49,
          "end": 21.563,
          "en": "and also position them in relation to each other.",
