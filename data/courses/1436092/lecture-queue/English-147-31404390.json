        },
        {
          "id": 28,
          "start": 76.78999999999999,
          "end": 79.48,
          "en": "so these two input elements are positioned",
          "zh": ""
        },
        {
          "id": 29,
          "start": 79.48,
          "end": 80.463,
          "en": "next to each other.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 81.32,
          "end": 82.61,
          "en": "For that in expense form,",
          "zh": ""
        },
        {
          "id": 31,
