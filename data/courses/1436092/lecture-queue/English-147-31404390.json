          "zh": ""
        },
        {
          "id": 22,
          "start": 60.4,
          "end": 62.67,
          "en": "a view that only holds these two elements",
          "zh": ""
        },
        {
          "id": 23,
          "start": 62.67,
          "end": 65,
          "en": "that should sit next to each other,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 65,
          "end": 66.443,
          "en": "so date and amount.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 67.47,
          "end": 70.53999999999999,
          "en": "And then after adding that view here,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 70.53999999999999,
          "end": 74.41,
          "en": "we wanna give this view a flex direction of row,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 74.41,
          "end": 76.78999999999999,
          "en": "to make sure that it's child items,",
