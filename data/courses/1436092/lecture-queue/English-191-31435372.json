          "en": "on this ImagePicker component,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.2,
          "end": 9,
          "en": "and for this we can add the ImagePicker component function",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9,
          "end": 13.86,
          "en": "here of course like this, and then return some JSX code",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.86,
          "end": 16.57,
          "en": "that defines the user interface.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.57,
          "end": 18.97,
