          "en": "Well, because of permissions.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 358.04,
          "end": 361.66,
          "en": "On Android it asked automatically for permissions,",
          "zh": ""
        },
        {
          "id": 116,
          "start": 361.66,
          "end": 363.7,
          "en": "on iOS that's not happening,",
          "zh": ""
        },
        {
          "id": 117,
          "start": 363.7,
          "end": 366.313,
          "en": "there we need to manage this ourselves.",
          "zh": ""
        }
      ]
    }
