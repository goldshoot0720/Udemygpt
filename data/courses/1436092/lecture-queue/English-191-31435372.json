          "end": 284.723,
          "en": "we should see this Take Image button.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 285.73,
          "end": 289.57,
          "en": "Now, if we press this button, nothing happens though.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 289.57,
          "end": 292.89,
          "en": "Instead after some time we get a warning here",
          "zh": ""
        },
        {
          "id": 93,
          "start": 292.89,
          "end": 294.96,
          "en": "that we had some promise rejection,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 294.96,
          "end": 299.03,
          "en": "so an error in the end that was not handled.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 299.03,
          "end": 301.98,
          "en": "On Android, it's different.",
