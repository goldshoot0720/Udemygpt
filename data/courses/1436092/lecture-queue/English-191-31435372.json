        },
        {
          "id": 98,
          "start": 306.68,
          "end": 308.41,
          "en": "And we can press Allow,",
          "zh": ""
        },
        {
          "id": 99,
          "start": 308.41,
          "end": 312.623,
          "en": "and if we do that, then indeed the camera does open up.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 313.6,
          "end": 315.64,
          "en": "Now we'll take care about iOS in a second,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 315.64,
          "end": 318.08299999999997,
          "en": "but here on Android I can now confirm this.",
          "zh": ""
        },
        {
          "id": 102,
          "start": 318.96,
          "end": 321.183,
          "en": "Then here we got this editing screen,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 322.05,
          "end": 324.32,
          "en": "we confirm it by clicking Crop.",
          "zh": ""
        },
        {
          "id": 104,
          "start": 324.32,
          "end": 327.27,
          "en": "And now the image was taken, we see no preview yet",
          "zh": ""
        },
        {
          "id": 105,
