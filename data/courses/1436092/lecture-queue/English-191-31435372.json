          "en": "but I want to make sure",
          "zh": ""
        },
        {
          "id": 9,
          "start": 25.54,
          "end": 28.33,
          "en": "that in the end we have a wrapper View here,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 28.33,
          "end": 33.33,
          "en": "which of course must be imported from react-native.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 35.26,
          "end": 38.02,
          "en": "And in that View, I want to have another View",
          "zh": ""
        },
        {
          "id": 12,
          "start": 38.02,
          "end": 39.23,
          "en": "that will be responsible",
          "zh": ""
        },
        {
          "id": 13,
