        },
        {
          "id": 43,
          "start": 140.27,
          "end": 142.603,
          "en": "to have some nice rounded corners.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 144.47,
          "end": 147.07999999999998,
          "en": "I also wanna have some padding of let's say 12 pixels",
