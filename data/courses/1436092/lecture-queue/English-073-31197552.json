        },
        {
          "id": 56,
          "start": 177.11,
          "end": 179.5,
          "en": "I also wanna make sure that these two text items",
          "zh": ""
        },
        {
          "id": 57,
          "start": 179.5,
          "end": 181.58,
          "en": "sit next to each other in a row,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 181.58,
          "end": 183.13,
          "en": "and therefore the flexDirection",
          "zh": ""
        },
        {
          "id": 59,
          "start": 184.22,
