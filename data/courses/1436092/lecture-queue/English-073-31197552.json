        },
        {
          "id": 35,
          "start": 116.92,
          "end": 118.82,
          "en": "In my case, I wanna style the border",
          "zh": ""
        },
        {
          "id": 36,
          "start": 118.82,
          "end": 121.35,
          "en": "by adding a border color here.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 121.35,
          "end": 125.43,
          "en": "And for that, I'll choose my colors constant,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 125.43,
          "end": 128.44,
          "en": "which is imported from that constants folder.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 128.44,
          "end": 130.963,
          "en": "And I wanna use a dark primary shade.",
