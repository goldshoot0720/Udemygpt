        },
        {
          "id": 16,
          "start": 46.56,
          "end": 49.19,
          "en": "And I will also import Text here,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 49.19,
          "end": 51.38,
          "en": "because inside that view,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 51.38,
          "end": 56.38,
          "en": "I wanna have a text where I say hashtag,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 58.27,
          "end": 62.24,
          "en": "and then roundNumber, let's say,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 62.24,
          "end": 65.583,
          "en": "and roundNumber should be a prop which we receive.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 66.81,
          "end": 71.81,
          "en": "And then another text where I output the opponent's guess,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 74.05,
          "end": 77.63,
          "en": "which I also expect to guess as prop, as a prop,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 77.63,
          "end": 80.523,
          "en": "and therefore that's the guess prop, like this.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 81.45,
          "end": 83.74,
          "en": "So now these are the two pieces of information",
          "zh": ""
        },
        {
          "id": 25,
          "start": 83.74,
          "end": 86.81,
          "en": "which I wanna output in this GuessLogItem.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 86.81,
          "end": 89.96000000000001,
          "en": "And I wanna render one instance of this component",
