        },
        {
          "id": 29,
          "start": 96.49000000000001,
          "end": 98.64,
          "en": "Now, of course we wanna style this.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 98.64,
          "end": 101.89,
          "en": "So I'll import the style sheet from react-native,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 101.89,
          "end": 103.77000000000001,
          "en": "and then create my styles here",
          "zh": ""
        },
        {
          "id": 32,
          "start": 103.77000000000001,
          "end": 107.833,
          "en": "with StyleSheet.create, like this,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 109.97,
          "end": 114.24000000000001,
          "en": "and then here, we can give this a name of ListItem,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 114.24000000000001,
          "end": 116.92,
          "en": "and apply any styles of your choice.",
