          "en": "I show the number of the round,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 30.83,
          "end": 34.13,
          "en": "and I also show the actual value",
          "zh": ""
        },
        {
          "id": 12,
          "start": 34.13,
          "end": 36.363,
          "en": "that was guessed in that guessing round.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 37.2,
          "end": 39.09,
          "en": "Hence, I wanna add a view here",
          "zh": ""
        },
        {
          "id": 14,
          "start": 40.14,
          "end": 43.31,
