      "sourceHash": "71234cb436df2d2373530d600f9e423b77b028a01027990cafd99508efd19324",
      "cues": [
        {
          "id": 1,
          "start": 2.5,
          "end": 5.46,
          "en": "And to manage this ourselves,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 5.46,
          "end": 8.85,
          "en": "we got more functions exposed by expo-image-picker",
          "zh": ""
        },
        {
          "id": 3,
          "start": 8.85,
          "end": 10.77,
          "en": "that help us with that.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.77,
          "end": 15.523,
          "en": "For example, there, we got the useCameraPermissions hook.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 16.44,
          "end": 19.883,
          "en": "This is a hook which we can execute here in ImagePicker.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 20.92,
          "end": 22.35,
          "en": "What this hook gives us",
          "zh": ""
        },
        {
          "id": 7,
          "start": 22.35,
          "end": 26.01,
          "en": "is an array with two values,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 26.01,
          "end": 28.46,
          "en": "and the first value is the cameraPermissionStatus",
          "zh": ""
        },
        {
          "id": 9,
          "start": 32.94,
          "end": 36.66,
          "en": "or cameraPermissionInformation,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 36.66,
          "end": 39.82,
          "en": "and then a requestPermission function.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 39.82,
          "end": 42.53,
          "en": "And of course the latter, this function here,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 42.53,
          "end": 44.88,
          "en": "is very important for us here on iOS",
          "zh": ""
        },
        {
          "id": 13,
          "start": 44.88,
          "end": 47.913,
          "en": "where we didn't have the appropriate permissions.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 48.78,
          "end": 50,
          "en": "What I will do here",
          "zh": ""
        },
        {
          "id": 15,
          "start": 50,
          "end": 51.633,
          "en": "is I will add another function,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 51.633,
          "end": 53.38,
          "en": "another async function,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 53.38,
          "end": 55.99,
          "en": "because we will have to await something,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 55.99,
          "end": 59.963,
          "en": "which I'll name verifyPermissions, like this.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 61.4,
          "end": 64.58,
          "en": "In here, I wanna check if we already have permission",
          "zh": ""
        },
        {
          "id": 20,
          "start": 64.58,
          "end": 65.65,
          "en": "to use the camera",
          "zh": ""
        },
        {
          "id": 21,
          "start": 65.65,
          "end": 67.6,
          "en": "because the first time we're using it,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 67.6,
          "end": 69.64,
          "en": "we will have to grant permissions,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 69.64,
          "end": 71.9,
          "en": "but for a subsequent uses,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 71.9,
          "end": 74.12,
          "en": "we of course already have permissions",
          "zh": ""
        },
        {
          "id": 25,
          "start": 74.12,
          "end": 77.83,
          "en": "and we then don't wanna try to request permission again.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 77.83,
          "end": 79.22,
          "en": "Therefore, here,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 79.22,
          "end": 84.22,
          "en": "I will check my cameraPermissionInformation object here",
          "zh": ""
        },
        {
          "id": 28,
          "start": 84.3,
          "end": 86.5,
          "en": "and dive into the status property",
          "zh": ""
        },
        {
          "id": 29,
          "start": 86.5,
          "end": 88.48,
          "en": "that exists on this object",
          "zh": ""
        },
        {
          "id": 30,
          "start": 89.52,
          "end": 93.07,
          "en": "and compare it to one of the built-in statuses.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 93.07,
          "end": 96.18,
          "en": "We can get a list of all these built-in statuses",
          "zh": ""
        },
        {
          "id": 32,
          "start": 96.18,
          "end": 98.12,
          "en": "that are handled by Expo",
          "zh": ""
        },
        {
          "id": 33,
          "start": 98.12,
          "end": 103.12,
          "en": "by importing the PermissionStatus enum here",
          "zh": ""
        },
        {
          "id": 34,
          "start": 103.56,
          "end": 105.473,
          "en": "from expo-image-picker,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 106.39,
          "end": 108.75200000000001,
          "en": "and then we can use this here in the comparison,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 108.75200000000001,
          "end": 110.07,
          "en": "PermissionStatus,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 110.07,
          "end": 112.62,
          "en": "and check if the status is undetermined,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 112.62,
          "end": 114.4,
          "en": "which means we don't know yet",
          "zh": ""
        },
        {
          "id": 39,
          "start": 114.4,
          "end": 115.91,
          "en": "if we have access or not,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 115.91,
          "end": 118.47999999999999,
          "en": "if we have the permission to use the camera.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 118.47999999999999,
          "end": 120.2,
          "en": "And this would be the case",
          "zh": ""
        },
        {
          "id": 42,
          "start": 120.2,
          "end": 122.853,
          "en": "because the user hasn't been asked yet.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 123.91,
          "end": 126.82,
          "en": "In that case, we want to call requestPermission,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 126.82,
          "end": 128.27,
          "en": "this function here,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 128.27,
          "end": 130.44,
          "en": "to get that permission.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 130.44,
          "end": 132.97,
          "en": "And that is an asynchronous function",
          "zh": ""
        },
        {
          "id": 47,
          "start": 132.97,
          "end": 134.9,
          "en": "because it will open a dialog",
          "zh": ""
        },
        {
          "id": 48,
          "start": 134.9,
          "end": 136.94,
          "en": "and wait for the user's response;",
          "zh": ""
        },
        {
          "id": 49,
          "start": 136.94,
          "end": 138.77,
          "en": "therefore, it returns a promise,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 138.77,
          "end": 140.77,
          "en": "and that's why I used async here",
          "zh": ""
        },
        {
          "id": 51,
          "start": 140.77,
          "end": 142.373,
          "en": "so that we cannot await this,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 143.25,
          "end": 146.78,
          "en": "and then we get the permissionResponse here in the end.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 146.78,
          "end": 149.36,
          "en": "And now the user either gave us permission",
          "zh": ""
        },
        {
          "id": 54,
          "start": 149.36,
          "end": 151.97,
          "en": "or he or she declined it.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 151.97,
          "end": 156.88,
          "en": "Either way, we can return permissionResponse.granted here,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 156.88,
          "end": 158.41,
          "en": "which is a property that's true",
          "zh": ""
        },
        {
          "id": 57,
          "start": 158.41,
          "end": 160.24,
          "en": "if the permission has been granted,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 160.24,
          "end": 161.84,
          "en": "and false otherwise,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 161.84,
          "end": 165.25,
          "en": "so that verifyPermissions in the end returns a promise",
          "zh": ""
        },
        {
          "id": 60,
          "start": 165.25,
          "end": 167.5,
          "en": "that resolves to true or false",
          "zh": ""
        },
        {
          "id": 61,
          "start": 167.5,
          "end": 170,
          "en": "depending on whether we got the permission or not.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 170.92000000000002,
          "end": 173.93,
          "en": "But maybe the status wasn't undetermined,",
          "zh": ""
        },
        {
          "id": 63,
          "start": 173.93,
          "end": 176.07,
          "en": "maybe we didn't have to ask.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 176.07,
          "end": 177,
          "en": "In this case,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 177,
          "end": 179.81,
          "en": "the promise returned by verifyPermissions",
          "zh": ""
        },
        {
          "id": 66,
          "start": 179.81,
          "end": 182.11,
          "en": "should also yield true or false",
          "zh": ""
        },
        {
          "id": 67,
          "start": 182.11,
          "end": 185.03,
          "en": "to tell us whether we have the permission or not.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 185.03,
          "end": 188.12,
          "en": "And therefore we might want to add a never check here",
          "zh": ""
        },
        {
          "id": 69,
          "start": 188.12,
          "end": 191.82,
          "en": "where we check if the cameraPermissionInformation.status",
          "zh": ""
        },
        {
          "id": 70,
          "start": 191.82,
          "end": 195.67,
          "en": "is equal to one of the other built-in statuses,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 195.67,
          "end": 197.61,
          "en": "denied status,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 197.61,
          "end": 200.413,
          "en": "which means we don't have permission.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 201.27,
          "end": 202.103,
          "en": "In this case,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 202.103,
          "end": 204.91,
          "en": "I wanna show an alert that tells the user",
          "zh": ""
        },
        {
          "id": 75,
          "start": 204.91,
          "end": 208.31,
          "en": "that we won't be able to continue with the app here",
          "zh": ""
        },
        {
          "id": 76,
          "start": 208.31,
          "end": 211.18,
          "en": "because some core functionality,",
          "zh": ""
        },
        {
          "id": 77,
          "start": 211.18,
          "end": 213.64,
          "en": "the feature of taking images,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 213.64,
          "end": 216.52,
          "en": "is blocked because of permissions.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 216.52,
          "end": 218.47,
          "en": "Therefore, I'll use the Alert API,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 218.47,
          "end": 221.23,
          "en": "which is imported from React Native,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 221.23,
          "end": 223.43,
          "en": "to show an alert dialog",
          "zh": ""
        },
        {
          "id": 82,
          "start": 223.43,
          "end": 227.517,
          "en": "where I say, \"Insufficient Permissions,\"",
          "zh": ""
        },
        {
          "id": 83,
          "start": 230.37,
          "end": 235.24,
          "en": "and then I'll say, \"You need to grant camera permissions",
          "zh": ""
        },
        {
          "id": 84,
          "start": 235.24,
          "end": 236.75,
          "en": "to use this app,\"",
          "zh": ""
        },
        {
          "id": 85,
          "start": 236.75,
          "end": 239.56,
          "en": "so the user may deny that",
          "zh": ""
        },
        {
          "id": 86,
          "start": 239.56,
          "end": 242.73,
          "en": "but then the app is not usable.",
          "zh": ""
        },
        {
          "id": 87,
          "start": 242.73,
          "end": 244.66,
          "en": "And then I will return false",
          "zh": ""
        },
        {
          "id": 88,
          "start": 244.66,
          "end": 247.81,
          "en": "because verifyPermissions should return true",
          "zh": ""
        },
        {
          "id": 89,
          "start": 247.81,
          "end": 251.23,
          "en": "if camera access was granted, and false otherwise",
          "zh": ""
        },
        {
          "id": 90,
          "start": 251.23,
          "end": 252.063,
          "en": "and in this case,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 252.063,
          "end": 255.13,
          "en": "we don't have the permission to use the camera.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 255.13,
          "end": 257.26,
          "en": "If we make it into neither of these if-checks,",
          "zh": ""
        },
        {
          "id": 93,
          "start": 257.26,
          "end": 260.81,
          "en": "we know that we're not in undetermined state",
          "zh": ""
        },
        {
          "id": 94,
          "start": 260.81,
          "end": 262.76,
          "en": "and it was not denied,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 262.76,
          "end": 265.4,
          "en": "so we do have the permission to use the camera",
          "zh": ""
        },
        {
          "id": 96,
          "start": 265.4,
          "end": 267.253,
          "en": "and hence I'll return true here.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 268.41,
          "end": 271.69,
          "en": "And now with this verifyPermissions helper function",
          "zh": ""
        },
        {
          "id": 98,
          "start": 271.69,
          "end": 275.05,
          "en": "added here, back and takeImageHandler,",
          "zh": ""
        },
        {
          "id": 99,
          "start": 275.05,
          "end": 277.043,
          "en": "we can use this helper function here.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 277.89,
          "end": 281.37,
          "en": "We can await the result of calling verifyPermissions",
          "zh": ""
        },
        {
          "id": 101,
          "start": 281.37,
          "end": 284.1,
          "en": "which will request permissions if needed,",
          "zh": ""
        },
        {
          "id": 102,
          "start": 284.1,
          "end": 287.69,
          "en": "or give us the current permission status otherwise.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 287.69,
          "end": 289.23,
          "en": "And therefore, what we get back",
          "zh": ""
        },
        {
          "id": 104,
          "start": 289.23,
          "end": 290.63,
          "en": "is a Boolean that's true",
          "zh": ""
        },
        {
          "id": 105,
          "start": 290.63,
          "end": 293,
          "en": "if we have permission to use the camera,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 293,
          "end": 294.88,
          "en": "and false otherwise.",
          "zh": ""
        },
        {
          "id": 107,
          "start": 294.88,
          "end": 297.73,
          "en": "Hence, I'll store the result in a constant",
          "zh": ""
        },
        {
          "id": 108,
          "start": 297.73,
          "end": 299.123,
          "en": "named hasPermission,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 300.46,
          "end": 305.27,
          "en": "and then I'll check if hasPermission is false",
          "zh": ""
        },
        {
          "id": 110,
          "start": 305.27,
          "end": 306.81,
          "en": "if we don't have the permission,",
          "zh": ""
        },
        {
          "id": 111,
          "start": 306.81,
          "end": 308.273,
          "en": "hence the exclamation mark,",
          "zh": ""
        },
        {
          "id": 112,
          "start": 309.34,
          "end": 311.37,
          "en": "in which case we can't proceed.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 311.37,
          "end": 312.93,
          "en": "So then I'll just return",
          "zh": ""
        },
        {
          "id": 114,
          "start": 312.93,
          "end": 315.35,
          "en": "to cancel the execution of this function",
          "zh": ""
        },
        {
          "id": 115,
          "start": 315.35,
          "end": 317.8,
          "en": "so that we don't try to launch the camera",
          "zh": ""
        },
        {
          "id": 116,
          "start": 317.8,
          "end": 321.17,
          "en": "because we don't have permission to do so anyways.",
          "zh": ""
        },
        {
          "id": 117,
          "start": 321.17,
          "end": 324.1,
          "en": "Otherwise, however, we should be able to continue.",
          "zh": ""
        },
        {
          "id": 118,
          "start": 324.1,
          "end": 326.04,
          "en": "And now with those changes made,",
          "zh": ""
        },
        {
          "id": 119,
          "start": 326.04,
          "end": 329.95,
          "en": "if we reload on Android,",
          "zh": ""
        },
        {
          "id": 120,
          "start": 329.95,
          "end": 330.93,
          "en": "nothing changes",
          "zh": ""
        },
        {
          "id": 121,
          "start": 330.93,
          "end": 333.54,
          "en": "because we granted permission before anyways.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 333.54,
          "end": 336.23,
          "en": "However, if you didn't grant permission before,",
          "zh": ""
        },
        {
          "id": 123,
          "start": 336.23,
          "end": 339.27,
          "en": "or if you haven't made a choice before, to be precise,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 339.27,
          "end": 341.26,
          "en": "you now will see a dialog again",
          "zh": ""
        },
        {
          "id": 125,
          "start": 341.26,
          "end": 343.63,
          "en": "and that dialog might look a bit different",
          "zh": ""
        },
        {
          "id": 126,
          "start": 343.63,
          "end": 345.303,
          "en": "from what it looked before,",
          "zh": ""
        },
        {
          "id": 127,
          "start": 346.48,
          "end": 350.273,
          "en": "but on iOS, now we also get this dialog.",
          "zh": ""
        },
        {
          "id": 128,
          "start": 351.38,
          "end": 354.82,
          "en": "Now, actually here, I'm getting a different dialog",
          "zh": ""
        },
        {
          "id": 129,
          "start": 354.82,
          "end": 356.31,
          "en": "than you might be getting",
          "zh": ""
        },
        {
          "id": 130,
          "start": 356.31,
          "end": 359.87,
          "en": "because I actually already granted permissions",
          "zh": ""
        },
        {
          "id": 131,
          "start": 359.87,
          "end": 362.16,
          "en": "behind the scenes when I prepared this module,",
          "zh": ""
        },
        {
          "id": 132,
          "start": 362.16,
          "end": 365.17,
          "en": "so my Expo Go app already has the permission,",
          "zh": ""
        },
        {
          "id": 133,
          "start": 365.17,
          "end": 367.41,
          "en": "and keep in mind that during development,",
          "zh": ""
        },
        {
          "id": 134,
          "start": 367.41,
          "end": 369.93,
          "en": "this app is hosted by Expo Go,",
          "zh": ""
        },
        {
          "id": 135,
          "start": 369.93,
          "end": 373.51,
          "en": "so therefore, I now just need to confirm it like this,",
          "zh": ""
        },
        {
          "id": 136,
          "start": 373.51,
          "end": 374.87,
          "en": "but with that,",
          "zh": ""
        },
        {
