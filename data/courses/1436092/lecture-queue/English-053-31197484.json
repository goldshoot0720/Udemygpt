        },
        {
          "id": 99,
          "start": 308.06,
          "end": 311.01,
          "en": "where you can see all the React Native source code",
          "zh": ""
        },
        {
          "id": 100,
          "start": 311.01,
          "end": 312.66,
          "en": "when we had a look at the button.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 313.55,
          "end": 317.67,
          "en": "If you have a look at the image background JS file here,",
