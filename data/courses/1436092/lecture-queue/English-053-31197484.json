        },
        {
          "id": 93,
          "start": 286.48,
          "end": 288.743,
          "en": "And that's the image style.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 289.58,
          "end": 291.68,
          "en": "Now we already added style here.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 291.68,
          "end": 295.06,
          "en": "But what you have to understand is that image background,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 295.06,
          "end": 298.15999999999997,
          "en": "this component provided by react native",
