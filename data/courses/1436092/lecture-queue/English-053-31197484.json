        },
        {
          "id": 97,
          "start": 298.15999999999997,
          "end": 303.16,
          "en": "is actually under the hood, a combination of components.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 303.82,
          "end": 308.06,
          "en": "We saw that before in the React Native GitHub repository",
