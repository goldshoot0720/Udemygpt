        },
        {
          "id": 89,
          "start": 272.89,
          "end": 276.56,
          "en": "Not entirely transparent, of course, but to some extent",
          "zh": ""
        },
        {
          "id": 90,
          "start": 276.56,
          "end": 280.103,
          "en": "so that the gradient shimmers through the image.",
          "zh": ""
        },
        {
          "id": 91,
          "start": 281.15999999999997,
          "end": 284.27,
          "en": "And this can be achieved with another special prop",
