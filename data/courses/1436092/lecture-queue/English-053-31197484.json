        },
        {
          "id": 22,
          "start": 74.63,
          "end": 76.86,
          "en": "And now on this image background,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 76.86,
          "end": 81.61,
          "en": "just as on the normal image we have to add a source.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 81.61,
          "end": 84.21000000000001,
          "en": "And this source should provide the image",
