          "zh": ""
        },
        {
          "id": 15,
          "start": 40.62,
          "end": 42.75,
          "en": "And it turns out that we can easily achieve this",
          "zh": ""
        },
        {
          "id": 16,
          "start": 42.75,
          "end": 44.6,
          "en": "by taking the relevant code,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 44.6,
          "end": 47.57,
          "en": "putting it into a separate Component.",
