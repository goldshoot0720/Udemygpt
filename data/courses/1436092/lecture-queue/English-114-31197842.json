        },
        {
          "id": 8,
          "start": 18.58,
          "end": 20.51,
          "en": "On the Meals Overviewscreen,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 20.51,
          "end": 24.495,
          "en": "so when we select a category on this screen here,",
