          "zh": ""
        },
        {
          "id": 58,
          "start": 165.55,
          "end": 167.69,
          "en": "and named the prop Displayed Meals,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 167.69,
          "end": 169.773,
          "en": "here I just went with Items.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 171.05,
          "end": 174.49,
          "en": "And that should already be all we need to do here.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 174.49,
          "end": 175.72,
          "en": "We then output this Meal Item",
          "zh": ""
        },
        {
          "id": 62,
          "start": 175.72,
          "end": 177.286,
          "en": "so actually there's one more thing",
