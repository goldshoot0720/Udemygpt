        },
        {
          "id": 70,
          "start": 196.34,
          "end": 198.31,
          "en": "And for this we have to import it",
          "zh": ""
        },
        {
          "id": 71,
          "start": 198.31,
          "end": 200.97,
          "en": "from the Components Meal List folder,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 200.97,
          "end": 203.66,
          "en": "and then the Meals List file,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 203.66,
          "end": 205.94,
          "en": "and we can get rid of these unused imports here",
          "zh": ""
        },
        {
          "id": 74,
          "start": 205.94,
          "end": 208.24,
          "en": "which we don't need anymore,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 208.24,
          "end": 212.39,
          "en": "and now we pass these Displayed Meals here to Meals List,",
