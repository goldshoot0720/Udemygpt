          "zh": ""
        },
        {
          "id": 77,
          "start": 216.47,
          "end": 219.803,
          "en": "And with that if we reload everything,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 220.69,
          "end": 223.32999999999998,
          "en": "we should still be able to get our list of meals here",
          "zh": ""
        },
        {
          "id": 79,
          "start": 223.32999999999998,
          "end": 225.87,
          "en": "once we choose a category as before.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 225.87,
          "end": 226.92000000000002,
          "en": "This all works,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 226.92000000000002,
          "end": 229.723,
          "en": "and we can still visit the detail screen.",
          "zh": ""
        },
        {
          "id": 82,
          "start": 230.61,
          "end": 233.38,
          "en": "So that's great, this all works as expected.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 233.38,
          "end": 236.23,
          "en": "But now with that newly added Component,",
          "zh": ""
        },
        {
          "id": 84,
          "start": 236.23,
          "end": 238.03,
          "en": "we can go to the Favorites screen,",
          "zh": ""
        },
        {
          "id": 85,
          "start": 238.03,
          "end": 241.17,
          "en": "and use that Component there as well.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 241.17,
          "end": 246.17,
          "en": "Here we can now actually output our Meals List like this,",
          "zh": ""
        },
        {
          "id": 87,
          "start": 247.92,
          "end": 250.703,
          "en": "and we don't need to import the text anymore therefore,",
          "zh": ""
        },
        {
          "id": 88,
          "start": 252.07,
          "end": 256.5,
          "en": "and we set this Items prop to our Favorited Meals.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 256.5,
          "end": 258.5,
          "en": "And to get our Favorited Meals,",
          "zh": ""
        },
        {
          "id": 90,
          "start": 258.5,
          "end": 260.95,
          "en": "we again can use the useContext hook,",
