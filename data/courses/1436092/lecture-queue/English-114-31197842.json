          "en": "in the Meals Overview screen Component.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 87.78,
          "end": 90.12,
          "en": "Starting here with the return statement,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 90.12,
          "end": 93.1,
          "en": "where we return a view with a flat list,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 93.1,
          "end": 95.68,
          "en": "and then including this render meal item function",
          "zh": ""
        },
        {
          "id": 35,
          "start": 95.68,
          "end": 97.32900000000001,
          "en": "which is used by flat list,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 97.32900000000001,
          "end": 99.38,
          "en": "we cut all of that,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 99.38,
          "end": 102.12,
          "en": "from the Meals Overview screen Component,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 102.12,
          "end": 103.77000000000001,
          "en": "and instead add this here,",
          "zh": ""
        },
        {
          "id": 39,
