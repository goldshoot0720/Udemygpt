      "sourceHash": "7eee29fff2210b321c08b814450c0e039aa86dbc20055acf5e2922fc3a7539d8",
      "cues": [
        {
          "id": 1,
          "start": 2.27,
          "end": 5.15,
          "en": "So let's now work on this place form.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 5.15,
          "end": 6.58,
          "en": "And on this place form,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.58,
          "end": 8.88,
          "en": "there are various things I wanna do.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.88,
          "end": 11.18,
          "en": "I wanna get a title for every place",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.18,
          "end": 14.19,
          "en": "which should be some text, which is entered by the user.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.19,
          "end": 17.56,
          "en": "But then I also want to allow the user to take a photo",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.56,
          "end": 20.98,
          "en": "and I wanna show a preview of that taken photo",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.98,
          "end": 24.74,
          "en": "so that the user could also replace it with a different one",
          "zh": ""
        },
        {
          "id": 9,
          "start": 24.74,
          "end": 27.36,
          "en": "if he or she wanted to do that.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.36,
          "end": 30.019,
          "en": "Therefore here in place form,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 30.019,
          "end": 33.9,
          "en": "it's now time to replace this dummy placeholder code",
          "zh": ""
        },
        {
          "id": 12,
          "start": 33.9,
          "end": 36.61,
          "en": "with the actual UI code.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 36.61,
          "end": 39.25,
          "en": "And for this, I'll start with a scroll view",
          "zh": ""
        },
        {
          "id": 14,
          "start": 39.25,
          "end": 42.85,
          "en": "because we will actually add multiple elements",
          "zh": ""
        },
        {
          "id": 15,
          "start": 42.85,
          "end": 44.14,
          "en": "to this screen.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 44.14,
          "end": 47.15,
          "en": "And I wanna ensure that we can always reach all of them",
          "zh": ""
        },
        {
          "id": 17,
          "start": 47.15,
          "end": 50.16,
          "en": "and that we therefore have a scrollable view.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 50.16,
          "end": 52.52,
          "en": "Hence, I'll wrap this with a scroll view.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 52.52,
          "end": 54.86,
          "en": "A scroll view instead of flat list",
          "zh": ""
        },
        {
          "id": 20,
          "start": 54.86,
          "end": 58.81,
          "en": "because we'll not have a super long list of multiple items.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 58.81,
          "end": 62.93,
          "en": "We'll just have a clearly defined UI that might be too big",
          "zh": ""
        },
        {
          "id": 22,
          "start": 62.93,
          "end": 65.88,
          "en": "for small device screens.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 65.88,
          "end": 69.39,
          "en": "But now inside this scroll view, I'll add a view",
          "zh": ""
        },
        {
          "id": 24,
          "start": 69.39,
          "end": 72.84,
          "en": "which wraps a text, which will be used as a label",
          "zh": ""
        },
        {
          "id": 25,
          "start": 72.84,
          "end": 76.27,
          "en": "and then a text input to which that label belongs",
          "zh": ""
        },
        {
          "id": 26,
          "start": 76.27,
          "end": 78.82,
          "en": "which allows the user to enter something.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 78.82,
          "end": 81.35,
          "en": "And that something should be the title,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 81.35,
          "end": 85.7,
          "en": "hence, I'll give this a text of title to act as a label",
          "zh": ""
        },
        {
          "id": 29,
          "start": 85.7,
          "end": 87.41,
          "en": "for this input.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 87.41,
          "end": 90.27,
          "en": "And on this input, I then wanna listen",
          "zh": ""
        },
        {
          "id": 31,
          "start": 90.27,
          "end": 91.85,
          "en": "to changes to the text",
          "zh": ""
        },
        {
          "id": 32,
          "start": 91.85,
          "end": 94.77000000000001,
          "en": "so that we can store the entered text.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 94.77000000000001,
          "end": 97.02000000000001,
          "en": "I'll do that with help of state,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 97.02000000000001,
          "end": 99.4,
          "en": "as we did it before in this course as well.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 99.4,
          "end": 103.273,
          "en": "And here , I in the end got my entered title,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 108.84,
          "end": 113.113,
          "en": "and my set entered title state updating function.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 114.18,
          "end": 119.18,
          "en": "And I will add a helper function, change title handler,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 121.87,
          "end": 124.98,
          "en": "which should be executed on change text.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 124.98,
          "end": 127.8,
          "en": "So that's the function at which I'll point here,",
          "zh": ""
        },
        {
          "id": 40,
          "start": 127.8,
          "end": 130.69,
          "en": "and there, we will receive the entered text",
          "zh": ""
        },
        {
          "id": 41,
          "start": 130.69,
          "end": 135.04,
          "en": "as a argument automatically, passed in by react-native.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 135.04,
          "end": 138.02,
          "en": "And we can then call set entered title",
          "zh": ""
        },
        {
          "id": 43,
          "start": 138.02,
          "end": 142.69,
          "en": "and pass this entered text as a new value for this state.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 142.69,
          "end": 145.22,
          "en": "Then I will also pass this value back",
          "zh": ""
        },
        {
          "id": 45,
          "start": 145.22,
          "end": 148.36,
          "en": "into text input through value prop.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 148.36,
          "end": 151.173,
          "en": "So here I will point at entered title.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 152.16,
          "end": 153.12,
          "en": "And now with that,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 153.12,
          "end": 156.34300000000002,
          "en": "we will be able to register key strokes in this input.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 157.87,
          "end": 162.18,
          "en": "Now, if we save that, we will have this input here",
          "zh": ""
        },
        {
          "id": 50,
          "start": 162.18,
          "end": 166.24,
          "en": "but it's almost impossible to see because it has no styling.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 166.24,
          "end": 169.05,
          "en": "The label also is black and that of course,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 169.05,
          "end": 171.04,
          "en": "doesn't get us anywhere.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 171.04,
          "end": 174.49,
          "en": "Hence we will need to take care about styling here",
          "zh": ""
        },
        {
          "id": 54,
          "start": 174.49,
          "end": 176.65,
          "en": "in the place form component.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 176.65,
          "end": 179.8,
          "en": "And we can do this by adding this good old styles object",
          "zh": ""
        },
        {
          "id": 56,
          "start": 179.8,
          "end": 182.18,
          "en": "with the style sheet object here",
          "zh": ""
        },
        {
          "id": 57,
          "start": 182.18,
          "end": 184.93,
          "en": "style sheet create to be precise.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 184.93,
          "end": 187.23,
          "en": "And then we can add some general styling",
          "zh": ""
        },
        {
          "id": 59,
          "start": 187.23,
          "end": 189.26,
          "en": "for the overall form.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 189.26,
          "end": 191.71,
          "en": "So which will be added to this scroll view",
          "zh": ""
        },
        {
          "id": 61,
          "start": 191.71,
          "end": 194.24,
          "en": "that holds the overall form.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 194.24,
          "end": 197.35,
          "en": "And then also set up some styling for labels",
          "zh": ""
        },
        {
          "id": 63,
          "start": 197.35,
          "end": 201.483,
          "en": "like this title text and for the input that we have here.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 202.78,
          "end": 205.6,
          "en": "Now, for the overall forum, I'll set this to flex one",
          "zh": ""
        },
        {
          "id": 65,
          "start": 205.6,
          "end": 209.38,
          "en": "so that it takes all the available space if possible.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 209.38,
          "end": 212.025,
          "en": "And I'll add some padding so that we have some spacing",
          "zh": ""
        },
        {
          "id": 67,
          "start": 212.025,
          "end": 215.463,
          "en": "to the edges of the device screen.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 216.72,
          "end": 219.98,
          "en": "And for the label, I'll give this a font weight of bold",
          "zh": ""
        },
        {
          "id": 69,
          "start": 219.98,
          "end": 223.93,
          "en": "to make it bold, and add a margin to the bottom of four",
          "zh": ""
        },
        {
          "id": 70,
          "start": 223.93,
          "end": 225.45,
          "en": "so that there is some space",
          "zh": ""
        },
        {
          "id": 71,
          "start": 225.45,
          "end": 228.913,
          "en": "between the label and the actual input element.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 229.8,
          "end": 231.77,
          "en": "And we can then add a color",
          "zh": ""
        },
        {
          "id": 73,
          "start": 231.77,
          "end": 234.68,
          "en": "which is imported from the colors constant.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 234.68,
          "end": 238.67000000000002,
          "en": "Hence of course is always, this import must be added.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 238.67000000000002,
          "end": 243.59,
          "en": "And here, I will use the primary 500 color",
          "zh": ""
        },
        {
          "id": 76,
          "start": 247.84,
          "end": 250.3,
          "en": "and then work on the input.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 250.3,
          "end": 253.7,
          "en": "Now, for the input, I wanna add a margin vertical.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 253.7,
          "end": 258.03,
          "en": "So top and bottom of eight and a padding horizontal.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 258.03,
          "end": 261.05,
          "en": "So a inner distance to the left and right of four,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 261.05,
          "end": 262.78,
          "en": "and a padding vertical,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 262.78,
          "end": 265.703,
          "en": "so inner distance to top and bottom of eight,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 266.88,
          "end": 269.1,
          "en": "and then ramp up the font size a little bit",
          "zh": ""
        },
        {
          "id": 83,
          "start": 269.1,
          "end": 273.32,
          "en": "and set it to 16, the default would be 14.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 273.32,
          "end": 276.48,
          "en": "And then add a border bottom color here,",
          "zh": ""
        },
        {
          "id": 85,
          "start": 276.48,
          "end": 279.11,
          "en": "and a border bottom within a second step",
          "zh": ""
        },
        {
          "id": 86,
          "start": 279.11,
          "end": 283.79,
          "en": "where the color should be primary 700 let's say,",
          "zh": ""
        },
        {
          "id": 87,
          "start": 283.79,
          "end": 286.983,
          "en": "and then the border bottom width is two.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 288.17,
          "end": 290.69,
          "en": "And I'll give this a background color",
          "zh": ""
        },
        {
          "id": 89,
          "start": 290.69,
          "end": 295.69,
          "en": "of let's say colors.primary100, which is a light blue.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 298.2,
          "end": 303.04,
          "en": "Now, we can assign those style objects that we defined here",
          "zh": ""
        },
        {
          "id": 91,
          "start": 303.04,
          "end": 306.583,
          "en": "to these elements here in our JSX code.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 307.66,
          "end": 312.36,
          "en": "So the outer scroll view receives a style prop,",
          "zh": ""
        },
        {
          "id": 93,
          "start": 312.36,
          "end": 315.963,
          "en": "which is, or which points at the form style.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 317.42,
          "end": 320.83,
          "en": "This text here receives the style prop",
          "zh": ""
        },
        {
          "id": 95,
          "start": 320.83,
          "end": 323.82,
          "en": "where we use the label style object",
          "zh": ""
        },
        {
          "id": 96,
          "start": 323.82,
          "end": 328.02,
          "en": "and the text input, of course, uses the input style prop",
          "zh": ""
        },
        {
          "id": 97,
          "start": 328.02,
          "end": 329.313,
          "en": "or a style object.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 330.42,
          "end": 332.233,
          "en": "With all that set up and saved,",
          "zh": ""
        },
        {
          "id": 99,
          "start": 332.233,
          "end": 334.6,
          "en": "this is what we should get here.",
          "zh": ""
        },
        {
          "id": 100,
          "start": 334.6,
          "end": 336.95,
          "en": "So now we can enter a title here,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 336.95,
          "end": 339.7,
          "en": "and we can see that we can enter something there,",
          "zh": ""
        },
        {
          "id": 102,
          "start": 339.7,
          "end": 341.713,
          "en": "which is quite useful.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 343.22,
          "end": 345.29,
          "en": "So now with that, that's the first step",
          "zh": ""
        },
        {
          "id": 104,
          "start": 345.29,
          "end": 347.5,
          "en": "but of course that's not the only one",
          "zh": ""
        },
        {
          "id": 105,
          "start": 347.5,
          "end": 349.84000000000003,
          "en": "and it's also not new.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 349.84000000000003,
          "end": 351.17,
          "en": "In the next lecture.",
          "zh": ""
        },
        {
          "id": 107,
          "start": 351.17,
          "end": 354.72,
          "en": "We're finally going to get started with taking pictures",
          "zh": ""
        },
        {
          "id": 108,
          "start": 354.72,
          "end": 357.513,
          "en": "and showing a preview of the image taken.",
          "zh": ""
        }
      ]
    }
