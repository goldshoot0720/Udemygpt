        },
        {
          "id": 85,
          "start": 251.14,
          "end": 254.533,
          "en": "some state that tells us whether we have a problem or not.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 255.47,
          "end": 259.61,
          "en": "And, therefore, I will name this state here,",
          "zh": ""
        },
        {
          "id": 87,
          "start": 259.61,
          "end": 263.43,
          "en": "error and setError is the state updating function.",
