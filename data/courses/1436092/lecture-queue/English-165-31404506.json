          "zh": ""
        },
        {
          "id": 31,
          "start": 86.92,
          "end": 88.313,
          "en": "and copy it in here.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 89.15,
          "end": 91.99,
          "en": "We could also create a shared base component",
          "zh": ""
        },
        {
          "id": 33,
          "start": 91.99,
          "end": 94.963,
          "en": "but to keep things simple, I'll just copy and paste.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 95.83,
          "end": 99.17,
          "en": "And then we have the ErrorOverlay component here,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 99.17,
          "end": 102.09,
          "en": "where I don't wanna have an activity indicator",
