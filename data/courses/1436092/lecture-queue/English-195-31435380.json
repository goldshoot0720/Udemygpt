          "zh": ""
        },
        {
          "id": 19,
          "start": 59.98,
          "end": 63.01,
          "en": "I wanna show a preview by rendering a little map,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 63.01,
          "end": 65.83,
          "en": "where we highlight the user's location.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 65.83,
          "end": 69.313,
          "en": "And for this we'll use Google Maps as an example, soon.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 70.22,
          "end": 72.19,
