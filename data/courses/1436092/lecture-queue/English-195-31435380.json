        },
        {
          "id": 24,
          "start": 77.74,
          "end": 80.11,
          "en": "And below that view with the preview,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 80.11,
          "end": 81.44,
          "en": "I want to have another view",
          "zh": ""
        },
        {
          "id": 26,
          "start": 81.44,
          "end": 85.09,
          "en": "with two buttons next to each other.",
