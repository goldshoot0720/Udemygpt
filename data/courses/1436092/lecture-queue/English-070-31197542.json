        },
        {
          "id": 117,
          "start": 329.04,
          "end": 330.45,
          "en": "this will execute again",
          "zh": ""
        },
        {
          "id": 118,
          "start": 330.45,
          "end": 331.89,
          "en": "but it will not execute",
          "zh": ""
        },
        {
          "id": 119,
          "start": 331.89,
          "end": 334.56,
          "en": "If this component was already on the UI",
          "zh": ""
        },
        {
          "id": 120,
          "start": 334.56,
          "end": 336.32,
          "en": "and now just updated",
          "zh": ""
        },
        {
          "id": 121,
          "start": 336.32,
          "end": 338.913,
          "en": "because for example a new guess was made.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 340.15,
          "end": 341.96,
          "en": "So therefore this effect function",
          "zh": ""
        },
        {
          "id": 123,
          "start": 341.96,
          "end": 345.72,
          "en": "is now perfect for resetting min boundary to one",
          "zh": ""
        },
        {
          "id": 124,
          "start": 345.72,
          "end": 347.93,
          "en": "and max to 100",
          "zh": ""
        },
        {
          "id": 125,
          "start": 347.93,
          "end": 348.763,
          "en": "because with that,",
          "zh": ""
        },
        {
          "id": 126,
