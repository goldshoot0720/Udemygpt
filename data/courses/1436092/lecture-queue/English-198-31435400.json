          "en": "you will find the MapView package,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 43.41,
          "end": 46.33,
          "en": "which is a package that helps with rendering maps,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 46.33,
          "end": 48.53,
          "en": "Apple Maps, or Google Maps",
          "zh": ""
        },
        {
          "id": 19,
          "start": 48.53,
          "end": 51.35,
          "en": "as part of your React Native apps.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 51.35,
