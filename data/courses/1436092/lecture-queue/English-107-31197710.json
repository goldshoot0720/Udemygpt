        },
        {
          "id": 81,
          "start": 229.92000000000002,
          "end": 233.21,
          "en": "or a favorites screen which we have yet to add",
          "zh": ""
        },
        {
          "id": 82,
          "start": 233.21,
          "end": 236.473,
          "en": "which would show us all the favorites we have in this app.",
