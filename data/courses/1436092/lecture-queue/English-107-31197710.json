        },
        {
          "id": 51,
          "start": 139.18,
          "end": 142.16,
          "en": "And then, also install these extra dependencies needed",
          "zh": ""
        },
        {
          "id": 52,
          "start": 142.16,
          "end": 143.273,
          "en": "by the drawer.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 144.19,
          "end": 147.05,
          "en": "So I will then install these extra dependencies.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 147.05,
          "end": 150.28,
          "en": "And because of this bug which we saw before,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 150.28,
          "end": 151.24,
          "en": "I will make sure",
          "zh": ""
        },
        {
          "id": 56,
          "start": 151.24,
          "end": 155.8,
          "en": "that of the react-native-reanimated dependency,",
