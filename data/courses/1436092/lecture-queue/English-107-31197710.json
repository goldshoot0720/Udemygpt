      "cues": [
        {
          "id": 1,
          "start": 2.347,
          "end": 4.64,
          "en": "[Maximilian Schwarzmuller] Now I'm back in the meals app",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.64,
          "end": 7.41,
          "en": "which we worked on earlier in the course,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.41,
          "end": 9.8,
          "en": "because now I wanna build up on what we learned",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.8,
          "end": 12.04,
          "en": "about these other navigators",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.04,
          "end": 15.58,
          "en": "and combine it with the stack navigator which we have here",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.58,
          "end": 18.16,
          "en": "to dive into nested navigators,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.16,
          "end": 20.98,
          "en": "which are basically combined navigators",
