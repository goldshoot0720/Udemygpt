          "end": 392.69,
          "en": "And we create a new entry",
          "zh": ""
        },
        {
          "id": 132,
          "start": 392.69,
          "end": 395.42,
          "en": "by using the place model we defined",
          "zh": ""
        },
        {
          "id": 133,
