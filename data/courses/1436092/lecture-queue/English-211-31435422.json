        },
        {
          "id": 129,
          "start": 385.67,
          "end": 387.11,
          "en": "So then for every data point,",
          "zh": ""
        },
        {
          "id": 130,
          "start": 387.11,
          "end": 391.02,
          "en": "I push a new entry into my places array.",
          "zh": ""
        },
        {
          "id": 131,
