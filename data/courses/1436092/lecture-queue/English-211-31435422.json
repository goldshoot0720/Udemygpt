          "zh": ""
        },
        {
          "id": 3,
          "start": 4.94,
          "end": 7.35,
          "en": "And for this I'm back here in database JS",
          "zh": ""
        },
        {
          "id": 4,
          "start": 7.35,
          "end": 11,
          "en": "and it will add a new utility function in there.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11,
          "end": 13.38,
          "en": "The function fetchPlaces",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.37,
          "end": 16.69,
          "en": "which will do what the name suggests",
          "zh": ""
        },
        {
          "id": 7,
