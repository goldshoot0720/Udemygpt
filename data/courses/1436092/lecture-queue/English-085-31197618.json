          "zh": ""
        },
        {
          "id": 10,
          "start": 36.82,
          "end": 41.26,
          "en": "Now for this I'm back here on Android and iOS portrait mode,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 41.26,
          "end": 43.44,
          "en": "but now let's say there are certain elements",
          "zh": ""
        },
        {
          "id": 12,
          "start": 43.44,
