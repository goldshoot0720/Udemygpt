          "en": "here in on:click I'll",
          "zh": ""
        },
        {
          "id": 10,
          "start": 41.64,
          "end": 47.06,
          "en": "trigger saveData which is a function I have yet to add so let's do that",
          "zh": ""
        },
        {
          "id": 11,
          "start": 47.06,
          "end": 48.88,
          "en": "quickly here we have",
          "zh": ""
        },
        {
          "id": 12,
          "start": 50.34,
          "end": 55.36,
          "en": "saveData and I'm not accepting any event object in here because that would be my",
          "zh": ""
        },
        {
          "id": 13,
