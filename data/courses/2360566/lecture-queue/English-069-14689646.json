        },
        {
          "id": 40,
          "start": 152.07999999999998,
          "end": 154.15,
          "en": "So my custom cancel event.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 155.55,
          "end": 160.68,
          "en": "And up there, I simply connect this button not to submit form, but to cancel.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 160.92000000000002,
          "end": 163.29,
          "en": "Now, please note that I do.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 163.98,
          "end": 164.45,
          "en": "Event.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 164.46,
          "end": 166.5,
          "en": "Emit my own cancel event here.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 166.5,
          "end": 171.84,
          "en": "When we click that custom cancel button, that's the same event I'm forwarding here from the modal,",
          "zh": ""
        },
        {
          "id": 46,
