          "zh": ""
        },
        {
          "id": 25,
          "start": 91.37,
          "end": 94.13,
          "en": "Therefore, type submit doesn't submit the form.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 94.58,
          "end": 96.16,
