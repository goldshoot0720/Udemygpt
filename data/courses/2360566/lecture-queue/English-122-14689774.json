      "sourceHash": "88b16339b7012f8078addebdc99325ae3aaacc42c5af37eae825af1b66ce3d4a",
      "cues": [
        {
          "id": 1,
          "start": 2.06,
          "end": 3.56,
          "en": "Now, it's not just a model.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.56,
          "end": 9.85,
          "en": "It's also the entire meetup grid where we add our meetups, where we render our meetup items.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 9.94,
          "end": 13.28,
          "en": "I want to animate the appearance of these items as well.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 13.28,
          "end": 17.78,
          "en": "Now, just as before, we can't add transition on a meetup item here.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 17.78,
          "end": 20.9,
          "en": "Instead, we add that on the lowest possible level.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 20.9,
          "end": 24.14,
          "en": "So in the meetup item component on this article here.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 24.17,
          "end": 29.32,
          "en": "Now, in just as before, I need to import that transition which I want to use.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 29.33,
          "end": 32.9,
          "en": "So let's import from svelte transition.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 33.8,
          "end": 35.57,
          "en": "Tren session.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 35.57,
          "end": 38.5,
          "en": "And of course, it's up to you which animation you want to use.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 38.51,
          "end": 40.67,
          "en": "Maybe let's try scale here.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 40.88,
          "end": 48.44,
          "en": "So I'm importing scale and now all we have to do is we have to go to our article and add transition",
          "zh": ""
        },
        {
          "id": 13,
          "start": 48.44,
          "end": 49.46,
          "en": "scale.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 49.46,
          "end": 54.56,
          "en": "You could configure it, but I'll actually go with the defaults and see how it looks.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 54.56,
          "end": 57.41,
          "en": "Let's go to favorites and they animate out.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 57.44,
          "end": 59.48,
          "en": "Let's go to all and they're back.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 59.48,
          "end": 61.43,
          "en": "Now let's add a new one quickly.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 62.09,
          "end": 62.96,
          "en": "Here.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 65.15,
          "end": 66.5,
          "en": "There's some dummy data.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 66.77,
          "end": 67.82,
          "en": "If I hit save.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 68.58,
          "end": 71.52,
          "en": "This also kind of scales in, but not really.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 71.52,
          "end": 74.91,
          "en": "It just popped in and I saw something scale down there.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 76.02,
          "end": 80.84,
          "en": "Reason for that is if we go to our meetup grid that we have no key thus far.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 80.85,
          "end": 83.16,
          "en": "That didn't really hurt us, but now it's a problem.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 83.16,
          "end": 89.43,
          "en": "Now we have that issue that swelled things that things changed at the end of the list and it doesn't",
          "zh": ""
        },
        {
          "id": 26,
          "start": 89.43,
          "end": 91.78999999999999,
          "en": "recognize that we added element at the beginning.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 91.8,
          "end": 99.03,
          "en": "This is easily fixed by adding a key here and the key could be our meetup ID, which is a unique identifier.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 99.03,
          "end": 104.78999999999999,
          "en": "So after adding that key here, which is super important and that's a great example where we see that",
          "zh": ""
        },
        {
          "id": 29,
          "start": 104.78999999999999,
          "end": 106.05,
          "en": "a key makes a difference.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 106.05,
          "end": 111.78,
          "en": "So after adding that key, now if we add a random item here.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 113.6,
          "end": 119.12,
          "en": "Now this scales in, but the other items are just jumping around and you learn what you can do about",
          "zh": ""
        },
        {
          "id": 32,
          "start": 119.12,
          "end": 120.11,
          "en": "that as well.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 120.12,
          "end": 122.87,
          "en": "You can add the animate directive.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 122.9,
          "end": 129.8,
          "en": "So if we go to the meetup item again in there we can import flip from.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 130.6,
          "end": 131.68,
          "en": "Svelte.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 132.33,
          "end": 133.38,
          "en": "Animate.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 133.53,
          "end": 139.82999999999998,
          "en": "And with that imported here we go down to the article where we also added the transition and we add",
          "zh": ""
        },
        {
          "id": 38,
          "start": 139.82999999999998,
          "end": 141.87,
          "en": "animate colon flip.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 142.98,
          "end": 145.52,
          "en": "Now, however, we're facing a problem.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 145.53,
          "end": 150.93,
          "en": "I'm getting an error that an element that uses the animate directive must be the immediate child of",
          "zh": ""
        },
        {
          "id": 41,
          "start": 150.93,
          "end": 152.67000000000002,
          "en": "a keyed each block.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 153.18,
          "end": 156.75,
          "en": "Now that's simply a restriction which svelte has at the moment.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 156.84,
          "end": 164.26,
          "en": "Unfortunately, where transition works just fine on an element that is somewhere nested below each block.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 164.28,
          "end": 167.07,
          "en": "Animate has to be on a direct child.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 167.46,
          "end": 169.29,
          "en": "Now we can we can fix that.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 169.29,
          "end": 174.66,
          "en": "However, we can go to our meetup grid where we have that each loop in the end.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 175.66,
          "end": 179.75,
          "en": "And we can wrap every meetup here in a div if we want to.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 179.77,
          "end": 184.36,
          "en": "So let's add an extra div and put our meetup item in there.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 184.72,
          "end": 189.89,
          "en": "Now on that div, let's add the transition and this flip animation thing.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 189.91,
          "end": 195.79,
          "en": "So let's grab scale and flip these to imports from meetup item and remove them there.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 195.82,
          "end": 203.84,
          "en": "Let's also remove the transition here and let's instead go to the meetup grid and add both to this div.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 203.86,
          "end": 206.29,
          "en": "So first of all, let's add the imports up there.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 206.53,
          "end": 215.38,
          "en": "And then on that div, which I just added, let's add transition scale and animate flip.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 215.62,
          "end": 221.62,
          "en": "Now if we save that, we go back and I check the filter that still works as before.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 221.65,
          "end": 222.94,
          "en": "It looks as before.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 222.94,
          "end": 225.16,
          "en": "And now if I add a new item here.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 226.32,
          "end": 227.16,
          "en": "Like this.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 227.19,
          "end": 229.8,
          "en": "You see the other items also move around a bit.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 231.56,
          "end": 233.18,
          "en": "Now, please note.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 233.78,
          "end": 236.57,
          "en": "The disassembly is a workaround we have to use for now.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 236.6,
          "end": 241.55,
          "en": "There isn't really a way around that, but it is the only way of making this work at the moment.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 241.58,
          "end": 244.24,
          "en": "Now of course these animations are way too slow.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 244.25,
          "end": 251.09,
          "en": "So actually here I'll configure flip and set a duration of, let's say 300 so that this is way faster.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 251.12,
          "end": 253.01,
          "en": "Now let's give this another try here.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 254.64,
          "end": 255.48,
          "en": "Let's.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 257.25,
          "end": 259.11,
          "en": "Add a new item.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 259.35,
          "end": 260.1,
          "en": "Here it is.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 260.13,
          "end": 264.61,
          "en": "And the other items are moving around now way faster than they did before.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 264.63,
          "end": 266.13,
          "en": "And this now looks way better.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 266.13,
          "end": 270.54,
          "en": "And now if I delete the item like this one, all the works in the other direction.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 270.54,
          "end": 271.05,
          "en": "Of course.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 271.05,
          "end": 275.46,
          "en": "Now you see items are also moving around when I delete an item.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 275.61,
          "end": 278.74,
          "en": "So that is all working and that is all nice.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 278.76,
          "end": 280.2,
          "en": "This is a little workaround.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 280.2,
          "end": 281.82,
          "en": "You simply have to memorize.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 281.82,
          "end": 287.55,
          "en": "This might change in the future, I'm not sure, but at the moment you can only use animate on a direct",
          "zh": ""
        },
        {
          "id": 77,
          "start": 287.55,
          "end": 289.71,
          "en": "child of each for transition.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 289.71,
          "end": 291.15,
          "en": "This was not required.",
          "zh": ""
        }
      ]
