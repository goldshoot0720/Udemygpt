      "sourceHash": "26747a93428f0de000fee1de2860389ec24377a5275eb93483bb239ad10f1ece",
      "cues": [
        {
          "id": 1,
          "start": 2.1,
          "end": 7.86,
          "en": "Now would be even sweeter to show a loading spinner whilst we are waiting for the data and to have a",
          "zh": ""
        },
        {
          "id": 2,
          "start": 7.86,
          "end": 8.6,
          "en": "real effect.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 8.61,
          "end": 12.12,
          "en": "I'll add a timeout here because Firebase is too fast.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 12.21,
          "end": 17.86,
          "en": "Where we wait a second and only after a second I do set the loaded meetups.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 17.88,
          "end": 19.62,
          "en": "Now again, this is deliberate.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 19.62,
          "end": 20.58,
          "en": "To slow it down.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.58,
          "end": 24.63,
          "en": "Firebase would be faster and you wouldn't do that in a production ready application.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 24.63,
          "end": 26.97,
          "en": "It's just here for demo purposes.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 26.97,
          "end": 32.01,
          "en": "So here we're waiting for the data and seeing that blank screen is not the best user experience.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 32.22,
          "end": 34.47,
          "en": "So let's add a loading spinner now.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 34.47,
          "end": 39.27,
          "en": "And for this I want to add a loading spinner instead of that meetup grid.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 39.27,
          "end": 47.4,
          "en": "If we are still loading data, we can add a is loading variable, which initially is false or actually",
          "zh": ""
        },
        {
          "id": 13,
          "start": 47.4,
          "end": 50.37,
          "en": "which initially is true because I sent my request right away.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 50.4,
          "end": 53.31,
          "en": "So when this page when this app loads, this should be true.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 53.31,
          "end": 57,
          "en": "And then here, once I got my response and once I'm in here.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 57,
          "end": 64.44,
          "en": "So once I got it with my additional slowdown here, I said is loading back to false or to false for",
          "zh": ""
        },
        {
          "id": 17,
          "start": 64.44,
          "end": 65.61,
          "en": "the first time here actually.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 65.61,
          "end": 67.26,
          "en": "And the same if we got an error.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 67.65,
          "end": 71.91,
          "en": "Now I want to show a loading message if we are waiting for data to arrive.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 71.91,
          "end": 79.92,
