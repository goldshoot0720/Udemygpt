        },
        {
          "id": 36,
          "start": 136.59,
          "end": 138.72,
          "en": "So this will be set to the opposite of this result.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 138.72,
          "end": 141.09,
          "en": "Hence it will be set to true if it's not empty.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 141.18,
          "end": 146.64,
