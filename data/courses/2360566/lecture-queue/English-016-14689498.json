        },
        {
          "id": 7,
          "start": 32.27,
          "end": 34.85,
          "en": "But we'll do this together thereafter, of course.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 34.85,
          "end": 36.05,
          "en": "And not just that.",
