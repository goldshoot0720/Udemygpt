        },
        {
          "id": 30,
          "start": 123.47,
          "end": 124.64,
          "en": "description.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 125.3,
          "end": 127.52,
          "en": "And that is it for for now.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 127.52,
          "end": 129.98,
          "en": "But of course, that alone doesn't do the trick.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 129.98,
          "end": 136.82,
          "en": "Now that we have these bindable, these settable variables, we need to set them.",
          "zh": ""
