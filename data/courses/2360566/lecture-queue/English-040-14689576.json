          "id": 24,
          "start": 99.38,
          "end": 101.63,
          "en": "Let's do the same for subtitle here.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 101.66,
          "end": 104.45,
          "en": "Let's do the same for the image source here.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 104.45,
          "end": 109.03999999999999,
          "en": "The variable name is image URL and for the alt text I'll use the title again.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 109.16,
          "end": 111.65,
          "en": "These quotation marks here are optional.",
          "zh": ""
