          "en": "and put it into the store file instead",
          "zh": ""
        },
        {
          "id": 12,
          "start": 45.14,
          "end": 46.9,
          "en": "and have all your heavy lifting,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 47.12,
