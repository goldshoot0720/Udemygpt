    {
      "id": "15853268",
      "title": "Accessing Object Data",
      "lectureOrder": 46,
      "videoOrder": 37,
      "sourceHash": "a20ac852ec166c653455b2489154595dae647b44fba045f782b5096ddcd920ef",
      "cues": [
        {
          "id": 1,
          "start": 2.39,
          "end": 6.69,
          "en": "So we're adding our log entries to the log entries array which is great,",
          "zh": "所以我們把紀錄項目加到 logEntries 陣列，那很好，"
        },
        {
          "id": 2,
          "start": 6.71,
          "end": 13.25,
          "en": "now let's say for some reason, maybe in another part of your code or maybe here, you need some data from",
          "zh": "現在讓我們說，因為某個理由，也許在你程式碼的另一部分，或也許在這裡，你需要一些資料，來自"
        },
        {
          "id": 3,
          "start": 13.25,
          "end": 14.18,
          "en": "your log entry.",
          "zh": "你的紀錄項目。"
        },
        {
          "id": 4,
          "start": 14.21,
          "end": 19.38,
