        {
          "id": 43,
          "start": 111.336,
          "end": 113.50999999999999,
          "en": "side with the help of node JS means.",
          "zh": "端藉由 Node.js 表示。"
        },
        {
          "id": 44,
          "start": 113.50999999999999,
          "end": 115.63,
          "en": "On a machine that is connected to the Internet,",
          "zh": "在一台連上網際網路的機器上，"
        },
        {
          "id": 45,
          "start": 115.63,
          "end": 117.53,
          "en": "which might be serving webpages,",
          "zh": "它也許正在提供網頁，"
        },
        {
          "id": 46,
          "start": 117.53,
          "end": 118.97999999999999,
          "en": "but which doesn't run code.",
          "zh": "但它不執行程式碼。"
        },
        {
          "id": 47,
          "start": 118.97999999999999,
          "end": 122.079,
          "en": "Directly on the machines of the end users and the",
          "zh": "直接在終端使用者的機器上，而"
        },
        {
          "id": 48,
          "start": 122.142,
          "end": 125.43,
          "en": "client side part is really the origin of JavaScript.",
          "zh": "用戶端這部分真的是 JavaScript 的起源。"
        },
        {
          "id": 49,
          "start": 125.43,
          "end": 129.545,
          "en": "And as you learn different browser vendors so different companies",
          "zh": "而如你所學，不同的瀏覽器廠商，也就是不同公司"
