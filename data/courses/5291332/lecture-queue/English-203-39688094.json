        },
        {
          "id": 36,
          "start": 109.2,
          "end": 111.93,
          "en": "This is not a prompt engineering module,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 111.93,
          "end": 113.88,
          "en": "so I won't dive into the details",
          "zh": ""
        },
        {
          "id": 38,
          "start": 113.88,
          "end": 117.99000000000001,
          "en": "behind writing correct prompts in DALL-E 2.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 117.99000000000001,
          "end": 119.88,
          "en": "You can find some inspiration",
          "zh": ""
        },
        {
          "id": 40,
          "start": 119.88,
          "end": 123.24,
          "en": "already down here in these example pictures.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 123.24,
          "end": 126.27,
          "en": "So, basically, you can just write normal phrases",
          "zh": ""
        },
        {
          "id": 42,
          "start": 126.27,
          "end": 128.85,
          "en": "containing lots of keywords and details",
          "zh": ""
        },
        {
          "id": 43,
          "start": 128.85,
          "end": 130.32,
          "en": "to describe the picture,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 130.32,
          "end": 132.423,
          "en": "the image that you want to generate.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 133.41,
          "end": 134.4,
          "en": "Let's get started.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 134.4,
          "end": 136.74,
          "en": "Therefore, with our first image,",
