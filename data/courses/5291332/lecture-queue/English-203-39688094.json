          "end": 101.72999999999999,
          "en": "that we saw in Midjourney.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 101.72999999999999,
          "end": 104.4,
          "en": "You only have your message box here",
          "zh": ""
        },
        {
          "id": 34,
          "start": 104.4,
          "end": 105.78,
          "en": "where you can add your prompts,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 105.78,
          "end": 108.18299999999999,
          "en": "and then generate your images.",
