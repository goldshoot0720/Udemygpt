          "zh": ""
        },
        {
          "id": 26,
          "start": 80.28,
          "end": 83.34,
          "en": "to write compelling cover letters.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 83.34,
          "end": 86.31,
          "en": "These cover letters enhance your CV,",
