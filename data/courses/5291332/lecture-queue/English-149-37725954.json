        },
        {
          "id": 32,
          "start": 101.72999999999999,
          "end": 105.18,
          "en": "We should think about the video style.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 105.18,
          "end": 108.50999999999999,
          "en": "In my case, I wanna target a younger audience,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 108.50999999999999,
          "end": 110.91,
          "en": "and therefore I wanna have a very engaging",
