          "zh": ""
        },
        {
          "id": 12,
          "start": 37.05,
          "end": 39.93,
          "en": "but this should be specifically a YouTube video.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 39.93,
          "end": 41.7,
          "en": "And we just tell ChatGPT",
          "zh": ""
        },
        {
          "id": 14,
