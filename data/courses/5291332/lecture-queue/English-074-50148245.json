          "end": 75.599,
          "en": "things that could be improved, like this here,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 75.879,
          "end": 78.719,
          "en": "where it's analyzing the output and",
          "zh": ""
        },
        {
          "id": 29,
