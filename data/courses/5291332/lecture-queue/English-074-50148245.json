          "zh": ""
        },
        {
          "id": 12,
          "start": 30.099,
          "end": 33,
          "en": "remove emojis from here. You can do all that, and you",
          "zh": ""
        },
        {
          "id": 13,
          "start": 33.079,
          "end": 35.86,
          "en": "might wanna do all that. But you",
          "zh": ""
        },
        {
          "id": 14,
          "start": 35.899,
          "end": 38.499,
          "en": "can also ask the",
          "zh": ""
        },
        {
          "id": 15,
          "start": 38.559,
          "end": 39.579,
          "en": "AI to",
          "zh": ""
        },
        {
          "id": 16,
