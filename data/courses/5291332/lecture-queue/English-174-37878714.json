        },
        {
          "id": 68,
          "start": 191.94,
          "end": 193.38,
          "en": "This looks really amazing.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 193.38,
          "end": 196.68,
          "en": "If you look at the eyes, if you look at the sun, the hair,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 196.68,
