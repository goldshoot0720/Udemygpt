        {
          "id": 44,
          "start": 123.939,
          "end": 126.779,
          "en": "can choose the voice you want ChatGPT",
          "zh": ""
        },
        {
          "id": 45,
          "start": 126.779,
          "end": 129.699,
          "en": "to use. Once you confirmed all",
          "zh": ""
        },
        {
          "id": 46,
