        },
        {
          "id": 33,
          "start": 84.48,
          "end": 85.313,
          "en": "And of course,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 85.313,
          "end": 88.02,
          "en": "depending on how well we know this code",
