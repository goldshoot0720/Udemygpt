        {
          "id": 24,
          "start": 79.5,
          "end": 84.39,
          "en": "and even omitted the formatting which is not what I want.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 84.39,
          "end": 87.78,
          "en": "Therefore, I'll tweak this prompt here",
          "zh": ""
        },
        {
          "id": 26,
          "start": 87.78,
          "end": 89.91,
          "en": "and I'll remove this other text part",
          "zh": ""
        },
        {
          "id": 27,
          "start": 89.91,
          "end": 93.783,
          "en": "and just ask for the code without extra explanations.",
          "zh": ""
        },
        {
          "id": 28,
