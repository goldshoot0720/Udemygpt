        },
        {
          "id": 50,
          "start": 170.722,
          "end": 172.594,
          "en": "It's self-reflective,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 172.594,
          "end": 175.637,
          "en": "it uses the laddering technique to split up a problem",
