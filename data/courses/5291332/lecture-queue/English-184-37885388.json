          "en": "or not that over styled compared to version 5.1.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 226.47,
          "end": 228.09,
          "en": "And by comparing the results,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 228.09,
          "end": 232.41,
          "en": "we indeed see that both created great looking images",
          "zh": ""
        },
        {
          "id": 72,
          "start": 232.41,
          "end": 235.05,
          "en": "of this path through the forest.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 235.05,
          "end": 238.14,
          "en": "But if we directly compare the colors",
          "zh": ""
        },
        {
          "id": 74,
          "start": 238.14,
