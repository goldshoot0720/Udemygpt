          "zh": ""
        },
        {
          "id": 22,
          "start": 83.28,
          "end": 86.64,
          "en": "we can select the four different alternatives now,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 86.64,
          "end": 89.7,
          "en": "directly in here in this editing window.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 89.7,
          "end": 92.34,
