        },
        {
          "id": 51,
          "start": 153.42000000000002,
          "end": 155.133,
          "en": "we can't install that library.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 156.12,
          "end": 158.76,
          "en": "And this library makes using the API",
          "zh": ""
        },
        {
          "id": 53,
          "start": 158.76,
          "end": 160.53,
          "en": "a lot easier for us.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 160.53,
          "end": 164.19,
          "en": "Having installed these different tools is very important.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 164.19,
          "end": 167.46,
          "en": "We'll, of course, install the OpenAI library together.",
