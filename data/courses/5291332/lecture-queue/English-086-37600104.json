      "cues": [
        {
          "id": 1,
          "start": 2.1,
          "end": 4.2,
          "en": "Now, another special technique",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.2,
          "end": 8.43,
          "en": "I wanna take a look at here is laddering prompting.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 8.43,
          "end": 12.9,
          "en": "And the idea here is to break up a complex problem",
          "zh": ""
        },
        {
          "id": 4,
          "start": 12.9,
          "end": 17.9,
          "en": "that would probably require a very long and detailed prompt,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 17.94,
          "end": 22.94,
          "en": "which could lead to ChatGPT to lose context",
          "zh": ""
        },
        {
          "id": 6,
          "start": 23.37,
          "end": 28.37,
          "en": "and to lose information and produce a suboptimal response,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 28.38,
          "end": 31.44,
          "en": "to take such a problem and instead split it up",
          "zh": ""
        },
        {
          "id": 8,
          "start": 31.44,
          "end": 34.83,
          "en": "into multiple smaller problems and prompts,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 34.83,
          "end": 39.06,
          "en": "which you then send step-by-step to ChatGPT,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 39.06,
          "end": 43.83,
          "en": "so that you get solutions for different smaller prompts,",
          "zh": ""
