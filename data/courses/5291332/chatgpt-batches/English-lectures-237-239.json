          "id": 3,
          "start": 6.96,
          "end": 9.27,
          "en": "but I did now test it off screen",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.27,
          "end": 11.88,
          "en": "and whilst testing it off screen,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.88,
          "end": 15.69,
          "en": "I saw that the difficulty does not work correctly.",
