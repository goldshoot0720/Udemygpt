          "zh": ""
        },
        {
          "id": 5,
          "start": 11.87,
          "end": 13.24,
          "en": "How can we find those?",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.25,
          "end": 15.53,
          "en": "How can we see how often it occurs?",
          "zh": ""
        },
        {
          "id": 7,
          "start": 15.53,
          "end": 20.66,
          "en": "This is a slightly different question because we might have a line that contains the same pattern multiple",
