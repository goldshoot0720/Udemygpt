        },
        {
          "id": 121,
          "start": 371.3,
          "end": 373.38,
          "en": "And zero plus one is one.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 373.38,
          "end": 374.7,
          "en": "And we have one in D.",
          "zh": ""
        },
        {
          "id": 123,
          "start": 374.78,
          "end": 375.98,
          "en": "We are not going to change it.",
          "zh": ""
        },
        {
          "id": 124,
          "start": 375.98,
          "end": 378.86,
          "en": "So after second iteration our solution will be like this.",
          "zh": ""
        },
        {
          "id": 125,
          "start": 378.86,
          "end": 385.97,
          "en": "From e to A we can come through B and it's going to take the seven unit from E to B, we are coming",
