        },
        {
          "id": 109,
          "start": 332.82,
          "end": 334.9,
          "en": "Now from c we can go to d.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 334.94,
          "end": 339.7,
          "en": "Now the distance in the d is one and the edge between these vertices is one.",
          "zh": ""
        },
        {
          "id": 111,
          "start": 339.7,
          "end": 343.98,
          "en": "So infinity plus one is infinity which is greater than the one.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 343.98,
          "end": 345.5,
          "en": "That's why we are not going to update it.",
          "zh": ""
        },
        {
          "id": 113,
          "start": 345.54,
          "end": 347.74,
          "en": "We will continue to the next vertex.",
          "zh": ""
        },
        {
          "id": 114,
          "start": 347.74,
          "end": 349.38,
          "en": "Now the next vertex is d.",
          "zh": ""
        },
        {
          "id": 115,
          "start": 349.42,
          "end": 351.82,
          "en": "Now the distance in d is one.",
          "zh": ""
        },
        {
          "id": 116,
          "start": 351.86,
          "end": 355.18,
          "en": "Now the edge from d to b is negative two.",
