        },
        {
          "id": 4,
          "start": 15.92,
          "end": 17.69,
          "en": "Now let's see them one by one.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 17.72,
          "end": 24.38,
          "en": "Now the case one is we want to delete a string whose prefix is same as the prefix of some other word",
