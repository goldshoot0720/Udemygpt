        },
        {
          "id": 174,
          "start": 483.302,
          "end": 486.6,
          "en": "but it's a bit beyond the scope of this crash course.",
          "zh": ""
        },
        {
          "id": 175,
          "start": 486.6,
          "end": 489.09,
          "en": "The important takeaway here simply is",
          "zh": ""
        },
        {
          "id": 176,
          "start": 489.09,
