          "zh": ""
        },
        {
          "id": 8,
          "start": 16.62,
          "end": 17.67,
          "en": "So, as a first step,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 17.67,
          "end": 19.14,
          "en": "we can pass a pointer",
