          "zh": ""
        },
        {
          "id": 3,
          "start": 3.6,
          "end": 5.07,
          "en": "And now, we just need to make sure",
          "zh": ""
        },
        {
          "id": 4,
          "start": 5.07,
          "end": 8.34,
          "en": "that handlePlayerNameChange gets triggered",
