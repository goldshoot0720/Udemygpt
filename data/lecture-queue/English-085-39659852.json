          "zh": ""
        },
        {
          "id": 44,
          "start": 123.06,
          "end": 126.18,
          "en": "equal to the symbol of the player who won,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 126.18,
          "end": 128.43,
          "en": "we can use this players' state here",
          "zh": ""
        },
        {
          "id": 46,
          "start": 128.43,
          "end": 130.74,
          "en": "to derive the name of the player,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 130.74,
          "end": 134.19,
          "en": "who won by dynamically accessing a property.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 134.19,
          "end": 136.05,
          "en": "And the property we want to access",
          "zh": ""
        },
        {
          "id": 49,
          "start": 136.05,
          "end": 138.75,
          "en": "is stored in firstSquareSymbol",
          "zh": ""
        },
        {
          "id": 50,
          "start": 138.75,
          "end": 142.38,
          "en": "because that's either an X or an O.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 142.38,
          "end": 145.743,
          "en": "And these are exactly the two properties we have here.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 146.94,
          "end": 147.84,
          "en": "And that again,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 147.84,
          "end": 150.69,
          "en": "is some standard JavaScript syntax",
          "zh": ""
        },
        {
          "id": 54,
          "start": 150.69,
          "end": 153.12,
          "en": "for dynamically accessing a property",
          "zh": ""
        },
        {
          "id": 55,
          "start": 153.12,
          "end": 154.41,
          "en": "where the property name",
          "zh": ""
        },
        {
          "id": 56,
          "start": 154.41,
          "end": 155.43,
          "en": "is not hard coded",
          "zh": ""
        },
        {
          "id": 57,
          "start": 155.43,
          "end": 157.923,
          "en": "but stored in some variable or constant.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 159.24,
          "end": 160.92000000000002,
          "en": "And with that all out of the way,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 160.92000000000002,
          "end": 164.04,
          "en": "if we save this and reload,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 164.04,
          "end": 167.05,
          "en": "we should be able to win",
          "zh": ""
