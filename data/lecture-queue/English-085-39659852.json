          "zh": ""
        },
        {
          "id": 21,
          "start": 59.04,
          "end": 62.28,
          "en": "Because in handlePlayerNameChange,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 62.28,
          "end": 65.26,
          "en": "we expect the symbol as a first parameter",
          "zh": ""
        },
        {
          "id": 23,
          "start": 66.12,
          "end": 68.78999999999999,
          "en": "and then the new name as a second parameter.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 68.78999999999999,
          "end": 70.77,
          "en": "And, therefore, in the player component,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 70.77,
