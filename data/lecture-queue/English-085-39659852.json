        },
        {
          "id": 16,
          "start": 42.42,
          "end": 43.713,
          "en": "and accept it here.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 45.03,
          "end": 47.76,
          "en": "And then here in this handleEditClick function",
