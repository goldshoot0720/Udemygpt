  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "39836178",
      "title": "Module Introduction",
      "sourceHash": "f353655d5fb6b93d3d8beffb929f148b1cc7ea4275e55a2084bc78f7a30d291a",
      "cues": [
        {
          "id": 1,
          "start": 0.6,
          "end": 2.37,
          "en": "Like all developers,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.37,
          "end": 4.26,
          "en": "as a React developer,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 4.26,
          "end": 6.6,
          "en": "you will eventually write code",
          "zh": ""
        },
        {
          "id": 4,
          "start": 6.6,
          "end": 9,
          "en": "that contains errors and bugs,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 9,
          "end": 10.92,
          "en": "because we all do.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 10.92,
          "end": 14.01,
          "en": "And therefore in this course section",
          "zh": ""
        },
        {
          "id": 7,
          "start": 14.01,
          "end": 18.75,
          "en": "you will learn how to efficiently debug your React apps,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 18.75,
          "end": 22.35,
          "en": "so how to find and fix errors.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.35,
          "end": 24.75,
          "en": "And we're going to get started",
          "zh": ""
        },
        {
          "id": 10,
          "start": 24.75,
          "end": 29.25,
          "en": "by taking a closer look at those error messages",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.25,
          "end": 31.38,
          "en": "React sometimes shows you,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 31.38,
          "end": 34.5,
          "en": "so that you can make sense of these error messages,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 34.5,
          "end": 39.3,
          "en": "and so that they actually help you find and fix errors.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 39.3,
          "end": 41.16,
          "en": "But we're not going to stop there,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 41.16,
          "end": 46.16,
          "en": "because some errors don't actually produce error messages.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 46.71,
          "end": 49.83,
          "en": "Instead, unfortunately, as a developer,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 49.83,
          "end": 52.11,
          "en": "you sometimes also write code",
          "zh": ""
        },
        {
          "id": 18,
          "start": 52.11,
          "end": 54.827,
          "en": "that leads to logical errors,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 54.827,
          "end": 58.05,
          "en": "and therefore in this section you will also learn",
          "zh": ""
        },
        {
          "id": 20,
          "start": 58.05,
          "end": 61.14,
          "en": "how you can find and fix such errors",
          "zh": ""
        },
        {
          "id": 21,
          "start": 61.14,
          "end": 63.6,
          "en": "with help of the browser developer tools",
          "zh": ""
        },
        {
          "id": 22,
          "start": 63.6,
          "end": 65.58,
          "en": "and the browser debugger.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 65.58,
          "end": 67.44,
          "en": "In addition, in this section,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 67.44,
          "end": 70.89,
          "en": "you will also learn about React's Strict Mode,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 70.89,
          "end": 72.9,
          "en": "how you can enable that mode,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 72.9,
          "end": 75.45,
          "en": "and why you might want to do that.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 75.45,
          "end": 77.1,
          "en": "And last but not least,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 77.1,
          "end": 80.58,
          "en": "we'll also take a look at the React DevTools,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 80.58,
          "end": 82.86,
          "en": "and you will learn how to install these tools",
          "zh": ""
        },
        {
          "id": 30,
          "start": 82.86,
          "end": 84.693,
          "en": "and what you can do with them.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}