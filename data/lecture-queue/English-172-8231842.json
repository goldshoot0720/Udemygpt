{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "8231842",
      "title": "Understanding Effect Dependencies",
      "sourceHash": "f10ff8a8a4bca7531b68be7b42d08bd5ebeb554c16b4e201e049cd318f112701",
      "cues": [
        {
          "id": 1,
          "start": 0.66,
          "end": 3.36,
          "en": "Effect dependencies are in the end",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.36,
          "end": 7.05,
          "en": "simply prop or state values",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.05,
          "end": 10.71,
          "en": "that are used inside of this effect function.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.71,
          "end": 12.18,
          "en": "So put in our words,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.18,
          "end": 15.15,
          "en": "any value that causes the component function",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.15,
          "end": 16.89,
          "en": "to execute again,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 16.89,
          "end": 20.01,
          "en": "which is the case in the end for props and state,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.01,
          "end": 22.5,
          "en": "any such value is a dependency",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.5,
          "end": 24.783,
          "en": "if it's used inside of useEffect.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 25.83,
          "end": 28.62,
          "en": "Any other value like refs",
          "zh": ""
        },
        {
          "id": 11,
          "start": 28.62,
          "end": 31.8,
          "en": "or as we have it here in the app component function",
          "zh": ""
        },
        {
          "id": 12,
          "start": 31.8,
          "end": 35.28,
          "en": "objects and methods that are built into the browser,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 35.28,
          "end": 39.55,
          "en": "any such value are not considered dependencies",
          "zh": ""
        },
        {
          "id": 14,
          "start": 40.44,
          "end": 43.95,
          "en": "because useEffect only cares about dependencies",
          "zh": ""
        },
        {
          "id": 15,
          "start": 43.95,
          "end": 47.37,
          "en": "that would cause the component function to execute again.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 47.37,
          "end": 49.2,
          "en": "And why is that the case?",
          "zh": ""
        },
        {
          "id": 17,
          "start": 49.2,
          "end": 52.26,
          "en": "Well, because this effect function should run",
          "zh": ""
        },
        {
          "id": 18,
          "start": 52.26,
          "end": 55.41,
          "en": "whenever the component function executed",
          "zh": ""
        },
        {
          "id": 19,
          "start": 55.41,
          "end": 57.903,
          "en": "if one of its dependencies changed.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 59.25,
          "end": 61.71,
          "en": "Now as explained earlier, with an empty array,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 61.71,
          "end": 63.12,
          "en": "that will never be the case",
          "zh": ""
        },
        {
          "id": 22,
          "start": 63.12,
          "end": 65.7,
          "en": "because if you don't have any dependencies,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 65.7,
          "end": 68.16,
          "en": "they also can't change.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 68.16,
          "end": 70.41,
          "en": "Therefore, in the app component function,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 70.41,
          "end": 73.983,
          "en": "this effect function here only executed once.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 75.24,
          "end": 76.8,
          "en": "But now in the modal component,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 76.8,
          "end": 80.01,
          "en": "we're using the open prop in this effect function",
          "zh": ""
        },
        {
          "id": 28,
          "start": 80.01,
          "end": 85.01,
          "en": "and this prop or the value we receive through that prop",
          "zh": ""
        },
        {
          "id": 29,
          "start": 85.38,
          "end": 87.06,
          "en": "can, of course, change",
          "zh": ""
        },
        {
          "id": 30,
          "start": 87.06,
          "end": 89.55,
          "en": "and it will change in this application.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 89.55,
          "end": 91.53,
          "en": "It will change from false,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 91.53,
          "end": 94.8,
          "en": "which is its initial value, to true",
          "zh": ""
        },
        {
          "id": 33,
          "start": 94.8,
          "end": 97.053,
          "en": "if we start to remove a place.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 99.06,
          "end": 102.24000000000001,
          "en": "Now, at the moment, with an empty dependencies array,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 102.24000000000001,
          "end": 105.36,
          "en": "this effect function would never run again.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 105.36,
          "end": 109.92,
          "en": "And as a result, if I saved this, we got rid of this error,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 109.92,
          "end": 112.83,
          "en": "but I also can't click on these items",
          "zh": ""
        },
        {
          "id": 38,
          "start": 112.83,
          "end": 115.71000000000001,
          "en": "or I can click on them, but nothing happens,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 115.71000000000001,
          "end": 117.75,
          "en": "the modal doesn't open.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 117.75,
          "end": 119.31,
          "en": "And why would it open?",
          "zh": ""
        },
        {
          "id": 41,
          "start": 119.31,
          "end": 122.31,
          "en": "The effect function isn't executing again",
          "zh": ""
        },
        {
          "id": 42,
          "start": 122.31,
          "end": 124.653,
          "en": "and therefore showModal isn't called.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 125.85,
          "end": 129.39,
          "en": "Hence, we have to add open as a dependency here,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 129.39,
          "end": 131.22,
          "en": "so the open prop here,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 131.22,
          "end": 134.04,
          "en": "and that makes sure that this effect function",
          "zh": ""
        },
        {
          "id": 46,
          "start": 134.04,
          "end": 135.45,
          "en": "will now run again",
          "zh": ""
        },
        {
          "id": 47,
          "start": 135.45,
          "end": 138.69,
          "en": "whenever the modal component function executed",
          "zh": ""
        },
        {
          "id": 48,
          "start": 138.69,
          "end": 141.483,
          "en": "and the value of the open prop changed.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 142.44,
          "end": 147.12,
          "en": "So if it was true and is again true, this will not run.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 147.12,
          "end": 149.49,
          "en": "If it was true and is now false,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 149.49,
          "end": 151.893,
          "en": "this will run and vice versa.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 153.3,
          "end": 155.49,
          "en": "And therefore with open added here,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 155.49,
          "end": 158.91,
          "en": "if you now save that code and you reload,",
          "zh": ""
        },
        {
          "id": 54,
          "start": 158.91,
          "end": 162.06,
          "en": "you'll see that now clicking on these items",
          "zh": ""
        },
        {
          "id": 55,
          "start": 162.06,
          "end": 164.61,
          "en": "does indeed open that dialog again.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 164.61,
          "end": 166.89,
          "en": "And we can close it, we can confirm it.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 166.89,
          "end": 168.66,
          "en": "That all works.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 168.66,
          "end": 172.44,
          "en": "But now it works with help of useEffect",
          "zh": ""
        },
        {
          "id": 59,
          "start": 172.44,
          "end": 175.2,
          "en": "and it therefore made this modal component",
          "zh": ""
        },
        {
          "id": 60,
          "start": 175.2,
          "end": 178.353,
          "en": "a bit leaner compared to how it looked before.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}