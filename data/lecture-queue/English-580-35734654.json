{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "35734654",
      "title": "Passing Data to Components with Props",
      "sourceHash": "4b6eb901e2c079ed668c787585ca1426a9411f6c9e362e1ca25c022f6b4fd1dc",
      "cues": [
        {
          "id": 1,
          "start": 2.07,
          "end": 4.56,
          "en": "Now when reusing components.",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.56,
          "end": 7.56,
          "en": "So using one at the same component multiple times",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.56,
          "end": 9.45,
          "en": "as we're doing it with Post.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.45,
          "end": 12.661,
          "en": "There's also another important React feature you",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.661,
          "end": 16.5,
          "en": "must know to make those reused components more useful",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.5,
          "end": 19.32,
          "en": "because at the moment the component we have here,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 19.32,
          "end": 20.67,
          "en": "the Post component,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.67,
          "end": 23.88,
          "en": "is of course still fairly static.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 23.88,
          "end": 27.21,
          "en": "Sure it has this random name that's being output",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.21,
          "end": 28.043,
          "en": "but in the end here",
          "zh": ""
        },
        {
          "id": 11,
          "start": 28.043,
          "end": 31.83,
          "en": "we also just have a static choice between two names.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 31.83,
          "end": 35.25,
          "en": "This component isn't really useful yet.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 35.25,
          "end": 38.22,
          "en": "Later when we're able to create posts",
          "zh": ""
        },
        {
          "id": 14,
          "start": 38.22,
          "end": 41.49,
          "en": "and store them in some database and fetch them from there",
          "zh": ""
        },
        {
          "id": 15,
          "start": 41.49,
          "end": 44.82,
          "en": "we wanna be able to reuse that component",
          "zh": ""
        },
        {
          "id": 16,
          "start": 44.82,
          "end": 46.56,
          "en": "with different names",
          "zh": ""
        },
        {
          "id": 17,
          "start": 46.56,
          "end": 50.82,
          "en": "and different text values that are coming from a database",
          "zh": ""
        },
        {
          "id": 18,
          "start": 50.82,
          "end": 51.75,
          "en": "for example,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 51.75,
          "end": 54.453,
          "en": "so that are not hard coded into the code.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 55.71,
          "end": 58.05,
          "en": "Well we don't have the database part yet.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 58.05,
          "end": 60.45,
          "en": "We don't have any data fetching yet,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 60.45,
          "end": 63.24,
          "en": "but we can still start preparing this component to",
          "zh": ""
        },
        {
          "id": 23,
          "start": 63.24,
          "end": 67.863,
          "en": "be more useful by adding a feature called Props to it.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 68.97,
          "end": 70.92,
          "en": "For that I'll first of all get rid of that",
          "zh": ""
        },
        {
          "id": 25,
          "start": 70.92,
          "end": 73.8,
          "en": "randomness code because I don't need it anymore",
          "zh": ""
        },
        {
          "id": 26,
          "start": 73.8,
          "end": 76.98,
          "en": "and instead I wanna make sure that both the name",
          "zh": ""
        },
        {
          "id": 27,
          "start": 76.98,
          "end": 80.64,
          "en": "and the text here can actually be configured",
          "zh": ""
        },
        {
          "id": 28,
          "start": 80.64,
          "end": 84.93,
          "en": "from inside the place where this component is being used.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 84.93,
          "end": 89.22,
          "en": "So from inside the app component in this case here.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 89.22,
          "end": 92.64,
          "en": "So it would be great if we could use the Post component here",
          "zh": ""
        },
        {
          "id": 31,
          "start": 92.64,
          "end": 95.43,
          "en": "or anywhere else in the app, doesn't matter.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 95.43,
          "end": 98.13,
          "en": "And we could pass different values",
          "zh": ""
        },
        {
          "id": 33,
          "start": 98.13,
          "end": 102.45,
          "en": "to that component just as you can pass different arguments",
          "zh": ""
        },
        {
          "id": 34,
          "start": 102.45,
          "end": 104.00999999999999,
          "en": "to one at the same function",
          "zh": ""
        },
        {
          "id": 35,
          "start": 104.00999999999999,
          "end": 106.173,
          "en": "if you're calling a function in your code.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 107.31,
          "end": 111.36,
          "en": "If you have an add function that takes two numbers",
          "zh": ""
        },
        {
          "id": 37,
          "start": 111.36,
          "end": 114.42,
          "en": "and returns the sum of those two numbers",
          "zh": ""
        },
        {
          "id": 38,
          "start": 114.42,
          "end": 117.66,
          "en": "then in JavaScript you can call this function",
          "zh": ""
        },
        {
          "id": 39,
          "start": 117.66,
          "end": 120.42,
          "en": "with different arguments, right?",
          "zh": ""
        },
        {
          "id": 40,
          "start": 120.42,
          "end": 122.223,
          "en": "That's how JavaScript works.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 124.11,
          "end": 124.98,
          "en": "Now it would be nice",
          "zh": ""
        },
        {
          "id": 42,
          "start": 124.98,
          "end": 127.44,
          "en": "if you could do the same thing with components",
          "zh": ""
        },
        {
          "id": 43,
          "start": 127.44,
          "end": 131.19,
          "en": "and pass different values to one at the same component",
          "zh": ""
        },
        {
          "id": 44,
          "start": 131.19,
          "end": 134.733,
          "en": "and that's where this Props feature comes into play.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 135.75,
          "end": 139.92000000000002,
          "en": "React allows you to add your own attributes called Props",
          "zh": ""
        },
        {
          "id": 46,
          "start": 139.92000000000002,
          "end": 141.36,
          "en": "to your components.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 141.36,
          "end": 143.179,
          "en": "For example here,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 143.179,
          "end": 147.66,
          "en": "an author prop which could be Maximilian in my case here,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 147.66,
          "end": 150.78,
          "en": "and then maybe a text or a body prop,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 150.78,
          "end": 153.327,
          "en": "which could be \"React.js is awesome.\"",
          "zh": ""
        },
        {
          "id": 51,
          "start": 154.2,
          "end": 157.17000000000002,
          "en": "And then the second time we use the Post",
          "zh": ""
        },
        {
          "id": 52,
          "start": 157.17000000000002,
          "end": 160.2,
          "en": "we could set a different author like Manuel",
          "zh": ""
        },
        {
          "id": 53,
          "start": 160.2,
          "end": 165.177,
          "en": "and give it a body like \"Check out the full course.\"",
          "zh": ""
        },
        {
          "id": 54,
          "start": 167.49,
          "end": 170.73,
          "en": "So now I'm using the same Post component function here",
          "zh": ""
        },
        {
          "id": 55,
          "start": 170.73,
          "end": 174.273,
          "en": "with different values set for author and body.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 175.74,
          "end": 178.41,
          "en": "This alone won't do the trick though.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 178.41,
          "end": 180.24,
          "en": "If we save all files,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 180.24,
          "end": 182.493,
          "en": "we now got no content on the screen.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 183.36,
          "end": 185.46,
          "en": "Because whilst we're passing data",
          "zh": ""
        },
        {
          "id": 60,
          "start": 185.46,
          "end": 189.42,
          "en": "to the post component with our custom attributes here,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 189.42,
          "end": 191.76,
          "en": "so with that feature called Props",
          "zh": ""
        },
        {
          "id": 62,
          "start": 191.76,
          "end": 196.05,
          "en": "we're not using these values inside of the Post component.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 196.05,
          "end": 198.72,
          "en": "How would React know where the author",
          "zh": ""
        },
        {
          "id": 64,
          "start": 198.72,
          "end": 201.03,
          "en": "or body information should be output",
          "zh": ""
        },
        {
          "id": 65,
          "start": 201.03,
          "end": 202.953,
          "en": "if it should be output at all?",
          "zh": ""
        },
        {
          "id": 66,
          "start": 203.82,
          "end": 204.93,
          "en": "Well, it doesn't.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 204.93,
          "end": 208.77,
          "en": "That's why we have to tell React how to treat those props.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 208.77,
          "end": 210.363,
          "en": "But how do we tell React?",
          "zh": ""
        },
        {
          "id": 69,
          "start": 211.2,
          "end": 213.45,
          "en": "Well again if you have a regular function",
          "zh": ""
        },
        {
          "id": 70,
          "start": 213.45,
          "end": 214.8,
          "en": "like the add function,",
          "zh": ""
        },
        {
          "id": 71,
          "start": 214.8,
          "end": 216.72,
          "en": "you receive parameters",
          "zh": ""
        },
        {
          "id": 72,
          "start": 216.72,
          "end": 219.12,
          "en": "and you can work with these parameters then.",
          "zh": ""
        },
        {
          "id": 73,
          "start": 219.12,
          "end": 221.613,
          "en": "A and B in this simple example.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 222.63,
          "end": 224.46,
          "en": "It's the same with custom components.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 224.46,
          "end": 228.51,
          "en": "There you receive a parameter, a single parameter though,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 228.51,
          "end": 231.51,
          "en": "and the value for this parameter will be passed",
          "zh": ""
        },
        {
          "id": 77,
          "start": 231.51,
          "end": 233.216,
          "en": "to this function by React",
          "zh": ""
        },
        {
          "id": 78,
          "start": 233.216,
          "end": 236.73,
          "en": "which should make sense because I mentioned before already",
          "zh": ""
        },
        {
          "id": 79,
          "start": 236.73,
          "end": 240.333,
          "en": "that React will be executing your component functions.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 241.44,
          "end": 243.66,
          "en": "So here we can receive this parameter",
          "zh": ""
        },
        {
          "id": 81,
          "start": 243.66,
          "end": 244.95,
          "en": "and I'll name it props,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 244.95,
          "end": 246.24,
          "en": "though the name is up to you",
          "zh": ""
        },
        {
          "id": 83,
          "start": 246.24,
          "end": 250.68,
          "en": "because it will be an object using this concept called props",
          "zh": ""
        },
        {
          "id": 84,
          "start": 250.68,
          "end": 252.39,
          "en": "in the React world.",
          "zh": ""
        },
        {
          "id": 85,
          "start": 252.39,
          "end": 254.43,
          "en": "So this is simply a name made up",
          "zh": ""
        },
        {
          "id": 86,
          "start": 254.43,
          "end": 257.52,
          "en": "by the React team that we get this props,",
          "zh": ""
        },
        {
          "id": 87,
          "start": 257.52,
          "end": 260.88,
          "en": "this property collection object here",
          "zh": ""
        },
        {
          "id": 88,
          "start": 260.88,
          "end": 264.45,
          "en": "as an argument in this function.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 264.45,
          "end": 267.15,
          "en": "So this will always be an object what we get here.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 267.15,
          "end": 270.06,
          "en": "And the special thing about this object is",
          "zh": ""
        },
        {
          "id": 91,
          "start": 270.06,
          "end": 274.26,
          "en": "that it will have all these custom attributes that were set",
          "zh": ""
        },
        {
          "id": 92,
          "start": 274.26,
          "end": 276.99,
          "en": "on the component as property names,",
          "zh": ""
        },
        {
          "id": 93,
          "start": 276.99,
          "end": 279.303,
          "en": "so as keys that we can access.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 280.29,
          "end": 281.123,
          "en": "So here",
          "zh": ""
        },
        {
          "id": 95,
          "start": 281.123,
          "end": 284.52,
          "en": "since I'm setting author and body on my custom component",
          "zh": ""
        },
        {
          "id": 96,
          "start": 284.52,
          "end": 286.60699999999997,
          "en": "I can access props.author",
          "zh": ""
        },
        {
          "id": 97,
          "start": 286.60699999999997,
          "end": 290.609,
          "en": "and props.body on this props object that's passed",
          "zh": ""
        },
        {
          "id": 98,
          "start": 290.609,
          "end": 294.813,
          "en": "into this component function automatically by React.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 296.25,
          "end": 297.08299999999997,
          "en": "So therefore here",
          "zh": ""
        },
        {
          "id": 100,
          "start": 297.08299999999997,
          "end": 300.39,
          "en": "in the place where I wanna output the author name,",
          "zh": ""
        },
        {
          "id": 101,
          "start": 300.39,
          "end": 302.58,
          "en": "I can output props.author,",
          "zh": ""
        },
        {
          "id": 102,
          "start": 302.58,
          "end": 304.8,
          "en": "and here where I wanna output the text",
          "zh": ""
        },
        {
          "id": 103,
          "start": 304.8,
          "end": 309.273,
          "en": "I can output props.body and remove this code here.",
          "zh": ""
        },
        {
          "id": 104,
          "start": 310.65,
          "end": 314.01,
          "en": "And with this simple yet important change",
          "zh": ""
        },
        {
          "id": 105,
          "start": 314.01,
          "end": 318.78,
          "en": "and by using this super important feature called Props,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 318.78,
          "end": 320.881,
          "en": "we can save all our code files",
          "zh": ""
        },
        {
          "id": 107,
          "start": 320.881,
          "end": 323.16,
          "en": "and we got our two components back,",
          "zh": ""
        },
        {
          "id": 108,
          "start": 323.16,
          "end": 325.68,
          "en": "but now this time configured",
          "zh": ""
        },
        {
          "id": 109,
          "start": 325.68,
          "end": 327.453,
          "en": "with different values.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 328.47,
          "end": 330.45,
          "en": "So it's the same component function,",
          "zh": ""
        },
        {
          "id": 111,
          "start": 330.45,
          "end": 332.61,
          "en": "it's a single component function",
          "zh": ""
        },
        {
          "id": 112,
          "start": 332.61,
          "end": 335.22,
          "en": "used with different configurations",
          "zh": ""
        },
        {
          "id": 113,
          "start": 335.22,
          "end": 338.49,
          "en": "with different values for these props.",
          "zh": ""
        },
        {
          "id": 114,
          "start": 338.49,
          "end": 341.76,
          "en": "And thanks to us using this props feature inside",
          "zh": ""
        },
        {
          "id": 115,
          "start": 341.76,
          "end": 343.17,
          "en": "of the component function,",
          "zh": ""
        },
        {
          "id": 116,
          "start": 343.17,
          "end": 344.52,
          "en": "we therefore do see",
          "zh": ""
        },
        {
          "id": 117,
          "start": 344.52,
          "end": 347.01,
          "en": "this different content on the screen.",
          "zh": ""
        },
        {
          "id": 118,
          "start": 347.01,
          "end": 350.922,
          "en": "And that's how you make components reusable.",
          "zh": ""
        },
        {
          "id": 119,
          "start": 350.922,
          "end": 352.56,
          "en": "Now as mentioned before,",
          "zh": ""
        },
        {
          "id": 120,
          "start": 352.56,
          "end": 355.552,
          "en": "not all components must be reusable,",
          "zh": ""
        },
        {
          "id": 121,
          "start": 355.552,
          "end": 360.15,
          "en": "and some components might not need any props at all.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 360.15,
          "end": 362.61,
          "en": "But that's up to you as a developer.",
          "zh": ""
        },
        {
          "id": 123,
          "start": 362.61,
          "end": 364.53,
          "en": "You can build your own components",
          "zh": ""
        },
        {
          "id": 124,
          "start": 364.53,
          "end": 367.35,
          "en": "and if you have a certain component that should be used",
          "zh": ""
        },
        {
          "id": 125,
          "start": 367.35,
          "end": 370.35,
          "en": "in different places with different values",
          "zh": ""
        },
        {
          "id": 126,
          "start": 370.35,
          "end": 372.843,
          "en": "this props feature is your friend.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}