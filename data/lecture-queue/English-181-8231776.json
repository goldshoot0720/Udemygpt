          "zh": ""
        },
        {
          "id": 3,
          "start": 5.28,
          "end": 8.25,
          "en": "here in the quiz component.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.25,
          "end": 10.35,
          "en": "Now a lot of logic is missing",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.35,
