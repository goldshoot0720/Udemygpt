        },
        {
          "id": 117,
          "start": 365.19,
          "end": 369.81,
          "en": "for the currently active question index, then the answers,",
          "zh": ""
        },
        {
          "id": 118,
          "start": 369.81,
          "end": 372,
          "en": "and then we can map this list",
          "zh": ""
        },
        {
          "id": 119,
          "start": 372,
          "end": 376.92,
          "en": "of answers so this list of strings to a list",
          "zh": ""
        },
        {
          "id": 120,
          "start": 376.92,
          "end": 381.3,
          "en": "of JSX components as you learned it early in this course.",
          "zh": ""
        },
        {
          "id": 121,
          "start": 381.3,
          "end": 382.92,
          "en": "Here, we'll get the answer",
          "zh": ""
        },
        {
          "id": 122,
          "start": 382.92,
          "end": 385.77,
          "en": "in this function and for every answer,",
          "zh": ""
        },
        {
          "id": 123,
          "start": 385.77,
          "end": 387.69,
          "en": "I want to output a list item",
