  "lectures": [
    {
      "id": "25600334",
      "title": "Redux & Side Effects (and Asynchronous Code)",
      "sourceHash": "b1ffea6351ed54364ca5af7f0598cb64e540d5ecd3e93b1ce05c83402f236235",
      "cues": [
        {
          "id": 1,
          "start": 2.11,
          "end": 3.5,
          "en": "Now let's start with",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.5,
          "end": 5.872,
          "en": "looking at asynchronous code",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.872,
          "end": 8.32,
          "en": "and side effects in general,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.32,
          "end": 9.911,
          "en": "even if they should be synchronous,",
          "zh": ""
        },
        {
          "id": 5,
          "start": 9.911,
          "end": 14.39,
          "en": "even if the code should be synchronous, and Redux.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.39,
          "end": 17.19,
          "en": "Because there is one super important rule.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.19,
          "end": 19.001,
          "en": "Your reducer functions",
          "zh": ""
        },
        {
          "id": 8,
          "start": 19.001,
          "end": 21.11,
          "en": "must be pure,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 21.11,
          "end": 23.93,
          "en": "side-effect free, and synchronous.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 23.93,
          "end": 26.967,
          "en": "So your reducer functions should take some input",
          "zh": ""
        },
        {
          "id": 11,
          "start": 26.967,
          "end": 29.45,
          "en": "in the case of the Redux reducer,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 29.45,
          "end": 31.38,
          "en": "the old state and the action,",
          "zh": ""
        },
        {
          "id": 13,
          "start": 31.38,
          "end": 33.494,
          "en": "and then produce some output.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 33.494,
          "end": 34.86,
          "en": "And that's,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 34.86,
          "end": 36.91,
          "en": "by the way not just the case for",
          "zh": ""
        },
        {
          "id": 16,
          "start": 36.91,
          "end": 38.87,
          "en": "Redux reducer function.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 38.87,
          "end": 42.181,
          "en": "The reducer function you pass to use reducer,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 42.181,
          "end": 44.11,
          "en": "is react hook,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 44.11,
          "end": 45.57,
          "en": "works in the same way.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 45.57,
          "end": 47.93,
          "en": "It has nothing to do with redux,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 47.93,
          "end": 50.923,
          "en": "but it just general reducer concept",
          "zh": ""
        },
        {
          "id": 22,
          "start": 50.923,
          "end": 52.564,
          "en": "that you have a pure,",
          "zh": ""
        },
        {
          "id": 23,
          "start": 52.564,
          "end": 54.865,
          "en": "side effects synchronous function",
          "zh": ""
        },
        {
          "id": 24,
          "start": 54.865,
          "end": 56.384,
          "en": "that takes input and",
          "zh": ""
        },
        {
          "id": 25,
          "start": 56.384,
          "end": 58.082,
          "en": "produces some output.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 58.082,
          "end": 59.91,
          "en": "And for the same input,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 59.91,
          "end": 61.01,
          "en": "for the same values,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 61.01,
          "end": 64.029,
          "en": "it will always produce the same output,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 64.029,
          "end": 67.306,
          "en": "without any side effects that happen along the way",
          "zh": ""
        },
        {
          "id": 30,
          "start": 67.306,
          "end": 71.2,
          "en": "without any asynchronous code that blocks it.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 71.2,
          "end": 74.78,
          "en": "No code of that kind must be part of your",
          "zh": ""
        },
        {
          "id": 32,
          "start": 74.78,
          "end": 76.197,
          "en": "reducer functions.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 76.197,
          "end": 79.465,
          "en": "But of course, that brings up an important question",
          "zh": ""
        },
        {
          "id": 34,
          "start": 79.465,
          "end": 81.127,
          "en": "when working with redux,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 81.127,
          "end": 83.53,
          "en": "when we dispatch some action",
          "zh": ""
        },
        {
          "id": 36,
          "start": 83.53,
          "end": 85.28,
          "en": "that would involve a side effect,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 85.28,
          "end": 87.80799999999999,
          "en": "like HTTP request that should be sent,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 87.80799999999999,
          "end": 90.03999999999999,
          "en": "where should we then put",
          "zh": ""
        },
        {
          "id": 39,
          "start": 90.03999999999999,
          "end": 91.706,
          "en": "the side effect code?",
          "zh": ""
        },
        {
          "id": 40,
          "start": 91.706,
          "end": 95.39,
          "en": "Where should we put our asynchronous code",
          "zh": ""
        },
        {
          "id": 41,
          "start": 95.39,
          "end": 97.3,
          "en": "when working with redux?",
          "zh": ""
        },
        {
          "id": 42,
          "start": 97.3,
          "end": 98.726,
          "en": "Because the reducer function",
          "zh": ""
        },
        {
          "id": 43,
          "start": 98.726,
          "end": 100.404,
          "en": "is clearly the wrong place",
          "zh": ""
        },
        {
          "id": 44,
          "start": 100.404,
          "end": 102.84,
          "en": "as we just learned.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 102.84,
          "end": 104.69,
          "en": "The answer to this question is",
          "zh": ""
        },
        {
          "id": 46,
          "start": 104.69,
          "end": 106.727,
          "en": "that we have two possible places",
          "zh": ""
        },
        {
          "id": 47,
          "start": 106.727,
          "end": 109.336,
          "en": "where we can put our side effects.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 109.336,
          "end": 112.28,
          "en": "We can put our side effects",
          "zh": ""
        },
        {
          "id": 49,
          "start": 112.28,
          "end": 114.30799999999999,
          "en": "possibly asynchronous code",
          "zh": ""
        },
        {
          "id": 50,
          "start": 114.30799999999999,
          "end": 116.449,
          "en": "directly into the component",
          "zh": ""
        },
        {
          "id": 51,
          "start": 116.449,
          "end": 119.42,
          "en": "with user fact for example,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 119.42,
          "end": 122.76,
          "en": "so just as we did it before in this course,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 122.76,
          "end": 125.53,
          "en": "and then we only dispatch an action",
          "zh": ""
        },
        {
          "id": 54,
          "start": 125.53,
          "end": 128.02,
          "en": "once that side effect is done",
          "zh": ""
        },
        {
          "id": 55,
          "start": 128.02,
          "end": 131.869,
          "en": "so Redux doesn't know anything about that side effect,",
          "zh": ""
        },
        {
          "id": 56,
          "start": 131.869,
          "end": 133.09,
          "en": "or, and",
          "zh": ""
        },
        {
          "id": 57,
          "start": 133.09,
          "end": 134.494,
          "en": "that will be new",
          "zh": ""
        },
        {
          "id": 58,
          "start": 134.494,
          "end": 139.03,
          "en": "we write our own action creator functions,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 139.03,
          "end": 142.17000000000002,
          "en": "so we don't use the automatically generated ones",
          "zh": ""
        },
        {
          "id": 60,
          "start": 142.17000000000002,
          "end": 144,
          "en": "redux toolkit gives us",
          "zh": ""
        },
        {
          "id": 61,
          "start": 144,
          "end": 146.523,
          "en": "but instead we write our own action creators.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 146.523,
          "end": 148.82999999999998,
          "en": "And it turns out that",
          "zh": ""
        },
        {
          "id": 63,
          "start": 148.82999999999998,
          "end": 150.562,
          "en": "for those action creators",
          "zh": ""
        },
        {
          "id": 64,
          "start": 150.562,
          "end": 153.16,
          "en": "redux actually has a solution",
          "zh": ""
        },
        {
          "id": 65,
          "start": 153.16,
          "end": 154.3,
          "en": "that allows us to",
          "zh": ""
        },
        {
          "id": 66,
          "start": 154.3,
          "end": 155.98,
          "en": "perform side effects",
          "zh": ""
        },
        {
          "id": 67,
          "start": 155.98,
          "end": 160.98,
          "en": "and run asynchronous tasks as part of this action creators",
          "zh": ""
        },
        {
          "id": 68,
          "start": 161.5,
          "end": 163.89,
          "en": "without changing the reducer function",
          "zh": ""
        },
        {
          "id": 69,
          "start": 163.89,
          "end": 167.59,
          "en": "because that function must stay side effect free.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 167.59,
          "end": 169.57,
          "en": "Now we are going to have a look at both",
          "zh": ""
        },
        {
          "id": 71,
          "start": 169.57,
          "end": 171.69,
          "en": "approaches in this course",
          "zh": ""
        },
        {
          "id": 72,
          "start": 171.69,
          "end": 172.582,
          "en": "section,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 172.582,
          "end": 173.415,
          "en": "And",
          "zh": ""
        },
        {
          "id": 74,
          "start": 173.415,
          "end": 174.77,
          "en": "to have a look at that,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 174.77,
          "end": 176.018,
          "en": "We are going to start",
          "zh": ""
        },
        {
          "id": 76,
          "start": 176.018,
          "end": 177.321,
          "en": "by setting up another",
          "zh": ""
        },
        {
          "id": 77,
          "start": 177.321,
          "end": 179.595,
          "en": "React-Redux application.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 179.595,
          "end": 182.34,
          "en": "We are going to do that in the next",
          "zh": ""
        },
        {
          "id": 79,
          "start": 182.34,
          "end": 184.56,
          "en": "two lectures and you can therefore",
          "zh": ""
        },
        {
          "id": 80,
          "start": 184.56,
          "end": 186.32,
          "en": "skip those two lectures",
          "zh": ""
        },
        {
          "id": 81,
          "start": 186.32,
          "end": 187.78,
          "en": "if you don't wanna repeat",
          "zh": ""
        },
        {
          "id": 82,
