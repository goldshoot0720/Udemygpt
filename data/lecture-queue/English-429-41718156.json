  "lectures": [
    {
      "id": "41718156",
      "title": "Handling \"Not Found\" States",
      "sourceHash": "046147a726820a517eb1065cff91378e884e8bd28e59694391843df07f9be82d",
      "cues": [
        {
          "id": 1,
          "start": 0.45,
          "end": 2.04,
          "en": "Now, since we're already talking",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.04,
          "end": 4.95,
          "en": "about errors, there's another kind of error",
          "zh": ""
        },
        {
          "id": 3,
          "start": 4.95,
          "end": 6.57,
          "en": "that could occur.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 6.57,
          "end": 10.74,
          "en": "What happens if a user enters an invalid URL?",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.74,
          "end": 12.63,
          "en": "Something like my-meals,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 12.63,
          "end": 15.72,
          "en": "which is a path we're not supporting here.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 15.72,
          "end": 20.07,
          "en": "In that case, we get this default 404 page",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.07,
          "end": 22.47,
          "en": "with which you might be happy, of course,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.47,
          "end": 24.48,
          "en": "no need to change it.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 24.48,
          "end": 27.57,
          "en": "But if you want to, you can change it.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 27.57,
          "end": 32.57,
          "en": "And to do that, you can add a not-found.js file, like this.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 33.78,
          "end": 37.62,
          "en": "And again, you can add that anywhere in your app folder",
          "zh": ""
        },
        {
          "id": 13,
          "start": 37.62,
          "end": 42.183,
          "en": "and it'll automatically cover any sibling and nested pages.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 43.47,
          "end": 45.33,
          "en": "So if I add it here on the root level,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 45.33,
          "end": 48.45,
          "en": "we can simply catch all not-found errors",
          "zh": ""
        },
        {
          "id": 16,
          "start": 48.45,
          "end": 52.47,
          "en": "that might be generated from anywhere in this application.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 52.47,
          "end": 54.9,
          "en": "If you would want to be more granular",
          "zh": ""
        },
        {
          "id": 18,
          "start": 54.9,
          "end": 57.96,
          "en": "and maybe show more granular error messages,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 57.96,
          "end": 60.51,
          "en": "you could nest it into some other folder.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 60.51,
          "end": 63.78,
          "en": "Now, here, I will go with that global level.",
          "zh": ""
        },
        {
          "id": 21,
          "start": 63.78,
          "end": 66.54,
          "en": "And then, again export a function here,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 66.54,
          "end": 68.133,
          "en": "which I'll name NotFound.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 69.33,
          "end": 72.72,
          "en": "And then here, I'll simply return a main element",
          "zh": ""
        },
        {
          "id": 24,
          "start": 72.72,
          "end": 75.51,
          "en": "with a class name of not-found,",
          "zh": ""
        },
        {
          "id": 25,
          "start": 75.51,
          "end": 77.94,
          "en": "which is another CSS class I prepared",
          "zh": ""
        },
        {
          "id": 26,
          "start": 77.94,
          "end": 80.64,
          "en": "in that globals.css file.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 80.64,
          "end": 83.55,
          "en": "And I'll then add a title of Not found.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 83.55,
          "end": 86.28,
          "en": "And I'll, below that, output a text,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 86.28,
          "end": 90.42,
          "en": "where I'll say, \"Unfortunately, we could not find",
          "zh": ""
        },
        {
          "id": 30,
          "start": 90.42,
          "end": 93.807,
          "en": "the requested page or resource.\"",
          "zh": ""
        },
        {
          "id": 31,
          "start": 95.31,
          "end": 96.143,
          "en": "Like this.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 97.62,
          "end": 101.16,
          "en": "And with that edit, you'll see that now, for invalid pages,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 101.16,
          "end": 104.193,
          "en": "we see our custom Not Found page here.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 105.39,
          "end": 107.75999999999999,
          "en": "But with that, I'll now go back to my meals",
          "zh": ""
        },
        {
          "id": 35,
          "start": 107.75999999999999,
          "end": 110.46000000000001,
          "en": "because, as a next step, I want to make sure",
          "zh": ""
        },
        {
          "id": 36,
          "start": 110.46000000000001,
          "end": 112.71000000000001,
          "en": "that we cannot just see all meals,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 112.71000000000001,
          "end": 115.713,
          "en": "but that we can also browse the meal details.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}