{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "39659768",
      "title": "Concept Repetition: Splitting Components & Building Reusable Components",
      "sourceHash": "cd754d7e3067a6dac295edd34106ef0cf8523642e055bd1a47f42f986a467319",
      "cues": [
        {
          "id": 1,
          "start": 0.36,
          "end": 1.44,
          "en": "So let's make sure",
          "zh": ""
        },
        {
          "id": 2,
          "start": 1.44,
          "end": 3.78,
          "en": "that we have an edit button here",
          "zh": ""
        },
        {
          "id": 3,
          "start": 3.78,
          "end": 7.2,
          "en": "next to these player names and symbols.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 7.2,
          "end": 10.74,
          "en": "And for that I'll actually wrap these spans here",
          "zh": ""
        },
        {
          "id": 5,
          "start": 10.74,
          "end": 12.243,
          "en": "with another span,",
          "zh": ""
        },
        {
          "id": 6,
          "start": 13.41,
          "end": 18.03,
          "en": "which I'll give a className of player.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.03,
          "end": 20.553,
          "en": "And I'll do the same down here for Player 2.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 21.6,
          "end": 24.72,
          "en": "And also close that span of course.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 24.72,
          "end": 27.54,
          "en": "And I'm doing this for styling purposes",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.54,
          "end": 31.56,
          "en": "because now next to that span here, which I just added,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 31.56,
          "end": 35.1,
          "en": "I want to add a button which says Edit.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 35.1,
          "end": 37.713,
          "en": "Of course also for the second player.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 38.91,
          "end": 41.13,
          "en": "With that, I got this added button here",
          "zh": ""
        },
        {
          "id": 14,
          "start": 41.13,
          "end": 44.4,
          "en": "which of course at the moment doesn't do anything.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 44.4,
          "end": 48.09,
          "en": "Now, before we're going to add any logic here,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 48.09,
          "end": 51.48,
          "en": "there's one thing you might already recognize",
          "zh": ""
        },
        {
          "id": 17,
          "start": 51.48,
          "end": 55.35,
          "en": "about this App component and this player markup here.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 55.35,
          "end": 59.22,
          "en": "We are essentially repeating the same markup",
          "zh": ""
        },
        {
          "id": 19,
          "start": 59.22,
          "end": 61.26,
          "en": "in two places.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 61.26,
          "end": 63.99,
          "en": "And that's always a good indicator",
          "zh": ""
        },
        {
          "id": 21,
          "start": 63.99,
          "end": 67.83,
          "en": "that we might want to create a separate component here.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 67.83,
          "end": 70.32,
          "en": "Because repeating markup like this is annoying",
          "zh": ""
        },
        {
          "id": 23,
          "start": 70.32,
          "end": 73.62,
          "en": "because whenever we change anything about that structure,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 73.62,
          "end": 75.57,
          "en": "let's say the correct class name here",
          "zh": ""
        },
        {
          "id": 25,
          "start": 75.57,
          "end": 78.24,
          "en": "would not be player but player info,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 78.24,
          "end": 81.39,
          "en": "then we have to do that in two places.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 81.39,
          "end": 84.93,
          "en": "That's annoying and quickly leads to errors.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 84.93,
          "end": 88.17,
          "en": "That's why instead of repeating markup like this,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 88.17,
          "end": 91.44,
          "en": "it would be better to create a separate component.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 91.44,
          "end": 94.02000000000001,
          "en": "And for that, of course, we can and should create",
          "zh": ""
        },
        {
          "id": 31,
          "start": 94.02000000000001,
          "end": 97.44,
          "en": "a components folder in that source folder.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 97.44,
          "end": 99.18,
          "en": "And in that components folder,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 99.18,
          "end": 102.72999999999999,
          "en": "we could create a Player.jsx file",
          "zh": ""
        },
        {
          "id": 34,
          "start": 103.74000000000001,
          "end": 106.35,
          "en": "or PlayerInfo or anything like that.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 106.35,
          "end": 108.18299999999999,
          "en": "Here, I'll just name it Player.",
          "zh": ""
        },
        {
          "id": 36,
          "start": 109.14,
          "end": 110.22,
          "en": "And in there, of course,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 110.22,
          "end": 113.31,
          "en": "we want to export a component function",
          "zh": ""
        },
        {
          "id": 38,
          "start": 113.31,
          "end": 115.953,
          "en": "which also should be named Player here.",
          "zh": ""
        },
        {
          "id": 39,
          "start": 117.24000000000001,
          "end": 119.61,
          "en": "Now of course, as you know, the name is up to you",
          "zh": ""
        },
        {
          "id": 40,
          "start": 119.61,
          "end": 121.35,
          "en": "but I think Player describes",
          "zh": ""
        },
        {
          "id": 41,
          "start": 121.35,
          "end": 123.603,
          "en": "the purpose of this component really well.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 125.4,
          "end": 127.68,
          "en": "Now here we wanna return some markup",
          "zh": ""
        },
        {
          "id": 43,
          "start": 127.68,
          "end": 132,
          "en": "and we have to return something renderable, as you learned.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 132,
          "end": 134.04,
          "en": "And the markup that should be returned here",
          "zh": ""
        },
        {
          "id": 45,
          "start": 134.04,
          "end": 135.66,
          "en": "in this Player component",
          "zh": ""
        },
        {
          "id": 46,
          "start": 135.66,
          "end": 137.76,
          "en": "of course should be this markup,",
          "zh": ""
        },
        {
          "id": 47,
          "start": 137.76,
          "end": 139.36,
          "en": "which we're currently repeating.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 140.67000000000002,
          "end": 144.48,
          "en": "Hence, we can cut this here from App.jsx",
          "zh": ""
        },
        {
          "id": 49,
          "start": 144.48,
          "end": 149.163,
          "en": "and move that here into our Player component like this.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 150.27,
          "end": 151.8,
          "en": "But we, of course, now have to make",
          "zh": ""
        },
        {
          "id": 51,
          "start": 151.8,
          "end": 153.36,
          "en": "this component configurable",
          "zh": ""
        },
        {
          "id": 52,
          "start": 153.36,
          "end": 157.143,
          "en": "so that we don't always say Player 1 and X.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 158.07,
          "end": 161.4,
          "en": "Therefore we want to use props here as you learned.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 161.4,
          "end": 164.01,
          "en": "And we could accept a name prop here",
          "zh": ""
        },
        {
          "id": 55,
          "start": 164.01,
          "end": 166.62,
          "en": "and a symbol prop here.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 166.62,
          "end": 168.93,
          "en": "Because these are the two pieces of data",
          "zh": ""
        },
        {
          "id": 57,
          "start": 168.93,
          "end": 170.853,
          "en": "that in the end make up a player.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 172.064,
          "end": 173.04,
          "en": "And with that here",
          "zh": ""
        },
        {
          "id": 59,
          "start": 173.04,
          "end": 175.35,
          "en": "we can output the player name",
          "zh": ""
        },
        {
          "id": 60,
          "start": 175.35,
          "end": 178.173,
          "en": "and below that, the symbol.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 179.64,
          "end": 182.85,
          "en": "Now, with that, we can go back to the App component",
          "zh": ""
        },
        {
          "id": 62,
          "start": 182.85,
          "end": 186.36,
          "en": "and delete this second markup block here",
          "zh": ""
        },
        {
          "id": 63,
          "start": 186.36,
          "end": 190.71,
          "en": "and instead import our Player component",
          "zh": ""
        },
        {
          "id": 64,
          "start": 190.71,
          "end": 193.86,
          "en": "from ./components",
          "zh": ""
        },
        {
          "id": 65,
          "start": 193.86,
          "end": 196.143,
          "en": "and then there Player.jsx.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 198.69,
          "end": 200.64,
          "en": "And then here in this order of list,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 200.64,
          "end": 203.97,
          "en": "we can and should output the Player component like this.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 203.97,
          "end": 207.09,
          "en": "We can write it as a self-closing component",
          "zh": ""
        },
        {
          "id": 69,
          "start": 207.09,
          "end": 209.73,
          "en": "because currently it's not built",
          "zh": ""
        },
        {
          "id": 70,
          "start": 209.73,
          "end": 212.52,
          "en": "such that we could pass any data",
          "zh": ""
        },
        {
          "id": 71,
          "start": 212.52,
          "end": 215.25,
          "en": "between the component opening and closing tags.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 215.25,
          "end": 217.56,
          "en": "We're not using the special children prop",
          "zh": ""
        },
        {
          "id": 73,
          "start": 217.56,
          "end": 219.15,
          "en": "in the Player component.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 219.15,
          "end": 220.44,
          "en": "So therefore, here we can use it",
          "zh": ""
        },
        {
          "id": 75,
          "start": 220.44,
          "end": 221.88,
          "en": "as a self-closing component.",
          "zh": ""
        },
        {
          "id": 76,
          "start": 221.88,
          "end": 225.12,
          "en": "And then just set the name prop",
          "zh": ""
        },
        {
          "id": 77,
          "start": 225.12,
          "end": 228.48,
          "en": "and set this to Player 1 here for the moment",
          "zh": ""
        },
        {
          "id": 78,
          "start": 228.48,
          "end": 231.213,
          "en": "and the symbol prop and set this to X.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 232.26,
          "end": 233.88,
          "en": "And now we can repeat this",
          "zh": ""
        },
        {
          "id": 80,
          "start": 233.88,
          "end": 237.03300000000002,
          "en": "and use the symbol O and Player 2 here.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 238.23,
          "end": 241.41,
          "en": "Now with that, we of course got the same output as before",
          "zh": ""
        },
        {
          "id": 82,
          "start": 241.41,
          "end": 243.09,
          "en": "and it's still static.",
          "zh": ""
        },
        {
          "id": 83,
          "start": 243.09,
          "end": 245.4,
          "en": "This button still doesn't do anything",
          "zh": ""
        },
        {
          "id": 84,
          "start": 245.4,
          "end": 247.83,
          "en": "but we improved our code",
          "zh": ""
        },
        {
          "id": 85,
          "start": 247.83,
          "end": 249.78,
          "en": "and we're now finally ready",
          "zh": ""
        },
        {
          "id": 86,
          "start": 249.78,
          "end": 252.033,
          "en": "to make this added button here work.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}