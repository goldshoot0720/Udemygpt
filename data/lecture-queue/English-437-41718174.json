          "en": "the content that's sent by the user,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 98.75999999999999,
          "end": 100.28999999999999,
          "en": "which is exactly what we can do",
          "zh": ""
        },
        {
          "id": 34,
          "start": 100.28999999999999,
          "end": 102.333,
          "en": "with help of this xss package.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 104.00999999999999,
          "end": 105.53999999999999,
          "en": "So therefore, now with that installed,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 105.53999999999999,
          "end": 107.65,
          "en": "we can restart the development server",
