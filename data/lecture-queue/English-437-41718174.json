          "zh": ""
        },
        {
          "id": 45,
          "start": 144.75,
          "end": 147.36,
          "en": "where I set lower to true",
          "zh": ""
        },
        {
          "id": 46,
          "start": 147.36,
          "end": 150.903,
          "en": "so that it forces all characters to be lowercase.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 152.64,
          "end": 153.84300000000002,
          "en": "That's the first step.",
          "zh": ""
        },
        {
          "id": 48,
          "start": 154.86,
          "end": 156.03,
          "en": "As a next step,",
          "zh": ""
