        },
        {
          "id": 17,
          "start": 48.39,
          "end": 51.12,
          "en": "and install a extra package,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 51.12,
          "end": 56.12,
          "en": "a package called slugify that will do what its name implies,",
          "zh": ""
        },
        {
          "id": 19,
