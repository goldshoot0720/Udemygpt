          "end": 59.85,
          "en": "but that's not the only package I'll install.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 59.85,
          "end": 63.42,
          "en": "Instead, I'll also install a package called xss,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 63.42,
          "end": 65.13,
          "en": "which will help us protect against",
          "zh": ""
        },
        {
          "id": 22,
          "start": 65.13,
          "end": 66.963,
          "en": "cross-site scripting attacks.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 68.1,
          "end": 69.63,
          "en": "Because you must not forget",
          "zh": ""
        },
        {
          "id": 24,
          "start": 69.63,
          "end": 73.71000000000001,
          "en": "that we're storing user-generated content",
          "zh": ""
        },
        {
          "id": 25,
          "start": 73.71000000000001,
          "end": 76.5,
          "en": "and I'm then outputting these instructions",
          "zh": ""
        },
        {
          "id": 26,
          "start": 76.5,
          "end": 80.91,
          "en": "that are generated by the user as HTML,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 80.91,
          "end": 82.77,
          "en": "here in that \"meal\" detail page,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 82.77,
          "end": 86.013,
          "en": "I'm outputting those instructions as HTML.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 87.53999999999999,
          "end": 91.98,
          "en": "So we are vulnerable to cross-site scripting attacks",
          "zh": ""
        },
        {
          "id": 30,
          "start": 91.98,
          "end": 94.25999999999999,
          "en": "and that's why we should protect against them",
