{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "25616840",
      "title": "More on Static Site Generation (SSG)",
      "sourceHash": "72aaddf3eb53b4f1475b3ed9cfe6a705d7ba39a7b6eca52f053676ec97fa8977",
      "cues": [
        {
          "id": 1,
          "start": 2.07,
          "end": 4.66,
          "en": "Now to fully understand getStaticProps",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.66,
          "end": 6.58,
          "en": "and also see what we can do with it,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.58,
          "end": 11.58,
          "en": "let's quit the dev server for now and run npm run build.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.67,
          "end": 13.49,
          "en": "This is the build command which you need",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.49,
          "end": 18.12,
          "en": "to run before you deploy your NextJS site.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 18.12,
          "end": 20.18,
          "en": "Now, we are not going to deploy here",
          "zh": ""
        },
        {
          "id": 7,
          "start": 20.18,
          "end": 23.22,
          "en": "but running it is still helpful and interesting.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 23.22,
          "end": 24.96,
          "en": "If we run npm run build here",
          "zh": ""
        },
        {
          "id": 9,
          "start": 24.96,
          "end": 27.72,
          "en": "to build that production build,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.72,
          "end": 30.09,
          "en": "to create that production build,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 30.09,
          "end": 31.503,
          "en": "we see some output here.",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.74,
          "end": 35.24,
          "en": "And in this output, we see what it did",
          "zh": ""
        },
        {
          "id": 13,
          "start": 35.24,
          "end": 38.78,
          "en": "and that it generated some static pages, for example,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 38.78,
          "end": 41.06,
          "en": "four pages to be precise.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 41.06,
          "end": 43.933,
          "en": "And we see which pages it generated.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 44.77,
          "end": 47.77,
          "en": "And what we see here is that it generated the root page",
          "zh": ""
        },
        {
          "id": 17,
          "start": 47.77,
          "end": 49.76,
          "en": "for slash nothing,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 49.76,
          "end": 53.438,
          "en": "the dynamic page for /meetupId,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 53.438,
          "end": 56.59,
          "en": "a 404 page, which is actually generates",
          "zh": ""
        },
        {
          "id": 20,
          "start": 56.59,
          "end": 59.07,
          "en": "for us automatically by default",
          "zh": ""
        },
        {
          "id": 21,
          "start": 59.07,
          "end": 62.46,
          "en": "in case we enter a invalid URL.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 62.46,
          "end": 65.34,
          "en": "And the new-meetup page.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 65.34,
          "end": 69.88,
          "en": "And then we got these icons here next to the pages.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 69.88,
          "end": 73.73,
          "en": "A filled dot and three empty dots.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 73.73,
          "end": 76.21000000000001,
          "en": "If we scroll down, we see a legend here",
          "zh": ""
        },
        {
          "id": 26,
          "start": 76.21000000000001,
          "end": 77.97,
          "en": "and we learn that a filled dot",
          "zh": ""
        },
        {
          "id": 27,
          "start": 77.97,
          "end": 81.37,
          "en": "is a statically generated site,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 81.37,
          "end": 85.08,
          "en": "that's what SSG stands for, Static Site Generation,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 85.08,
          "end": 88.87,
          "en": "which was automatically generated as HTML",
          "zh": ""
        },
        {
          "id": 30,
          "start": 88.87,
          "end": 92.57,
          "en": "and JSON, which is then used for pre-fetching data",
          "zh": ""
        },
        {
          "id": 31,
          "start": 92.57,
          "end": 95.893,
          "en": "once the page turned into a single page application.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 96.75,
          "end": 100.083,
          "en": "The empty dot stands for Static Generation.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 101.03999999999999,
          "end": 102.55,
          "en": "That's almost the same.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 102.55,
          "end": 106.11,
          "en": "The only difference is that here we got no initial props.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 106.11,
          "end": 109.78999999999999,
          "en": "So we have no initial data that was fetched",
          "zh": ""
        },
        {
          "id": 36,
          "start": 109.78999999999999,
          "end": 111.66,
          "en": "and indeed, only for the root page,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 111.66,
          "end": 113,
          "en": "we are fetching data",
          "zh": ""
        },
        {
          "id": 38,
          "start": 113,
          "end": 116.03999999999999,
          "en": "because that is the page where we added getStaticProps",
          "zh": ""
        },
        {
          "id": 39,
          "start": 116.03999999999999,
          "end": 118.8,
          "en": "and that's why we have the filled dot here.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 118.8,
          "end": 121.06,
          "en": "Now, we will work on some other pages later,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 121.06,
          "end": 124.58,
          "en": "to be precise, we will work on the meetupId page soon",
          "zh": ""
        },
        {
          "id": 42,
          "start": 124.58,
          "end": 126.74,
          "en": "but, for example, the new-meetup page",
          "zh": ""
        },
        {
          "id": 43,
          "start": 126.74,
          "end": 128.972,
          "en": "does not need any data fetching.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 128.972,
          "end": 133.17,
          "en": "There, we, in the end, only render our form",
          "zh": ""
        },
        {
          "id": 45,
          "start": 133.17,
          "end": 135.23,
          "en": "and we don't need any data here,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 135.23,
          "end": 137.62,
          "en": "we don't fetch any data from a server",
          "zh": ""
        },
        {
          "id": 47,
          "start": 137.62,
          "end": 139.65,
          "en": "and therefore, the new-meetup page",
          "zh": ""
        },
        {
          "id": 48,
          "start": 139.65,
          "end": 143.52,
          "en": "will always stay a static page with no content.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 143.52,
          "end": 145.59,
          "en": "So that is fine.",
          "zh": ""
        },
        {
          "id": 50,
          "start": 145.59,
          "end": 150.04,
          "en": "But we will turn the meetupId page into a SSG page later",
          "zh": ""
        },
        {
          "id": 51,
          "start": 150.04,
          "end": 151.05,
          "en": "but for the moment,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 151.05,
          "end": 152.89,
          "en": "we see that only the starting page,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 152.89,
          "end": 157.15,
          "en": "the root page is such a statically generated site.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 157.15,
          "end": 160.32,
          "en": "Now, with that, let's start the development server again",
          "zh": ""
        },
        {
          "id": 55,
          "start": 160.32,
          "end": 162.87,
          "en": "and let's think about potential problems",
          "zh": ""
        },
        {
          "id": 56,
          "start": 162.87,
          "end": 166.42000000000002,
          "en": "we could be facing when using getStaticProps.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 166.42000000000002,
          "end": 168.53,
          "en": "And one pretty big problem,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 168.53,
          "end": 171.55,
          "en": "which we could face in some websites,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 171.55,
          "end": 173.35,
          "en": "depending on what we're doing",
          "zh": ""
        },
        {
          "id": 60,
          "start": 173.35,
          "end": 177.02,
          "en": "is that the data here could be outdated.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 177.02,
          "end": 179.3,
          "en": "This page, as I mentioned, is generated",
          "zh": ""
        },
        {
          "id": 62,
          "start": 179.3,
          "end": 181.18,
          "en": "during the build process.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 181.18,
          "end": 183.13,
          "en": "So thereafter, we deploy it.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 183.13,
          "end": 186.2,
          "en": "If we then add more meetups to our database,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 186.2,
          "end": 189.81,
          "en": "this pre-generated page would not know about them.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 189.81,
          "end": 193.18,
          "en": "And if we don't add any client-side data fetching,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 193.18,
          "end": 196.82,
          "en": "we would always just see the outdated meetups here.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 196.82,
          "end": 199.32999999999998,
          "en": "And this could, of course, be a problem.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 199.32999999999998,
          "end": 202.38,
          "en": "Now, we can always rebuild our site",
          "zh": ""
        },
        {
          "id": 70,
          "start": 202.38,
          "end": 205.36,
          "en": "and redeploy when our data changes.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 205.36,
          "end": 208.26,
          "en": "And for some websites, like personal blogs,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 208.26,
          "end": 209.924,
          "en": "this is a great alternative",
          "zh": ""
        },
        {
          "id": 73,
          "start": 209.924,
          "end": 213.57,
          "en": "because there data doesn't change too frequently",
          "zh": ""
        },
        {
          "id": 74,
          "start": 213.57,
          "end": 216.44,
          "en": "but if data does change more frequently,",
          "zh": ""
        },
        {
          "id": 75,
          "start": 216.44,
          "end": 218.3,
          "en": "there is a extra property,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 218.3,
          "end": 221.23,
          "en": "which we can add to this returned object.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 221.23,
          "end": 225.04,
          "en": "And that's the revalidate property.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 225.04,
          "end": 228.75,
          "en": "When we add this property to the object returned",
          "zh": ""
        },
        {
          "id": 79,
          "start": 228.75,
          "end": 232.68,
          "en": "by getStaticProps, we unlock a feature",
          "zh": ""
        },
        {
          "id": 80,
          "start": 232.68,
          "end": 235.971,
          "en": "called incremental Static Generation.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 235.971,
          "end": 238.82999999999998,
          "en": "Revalidate wants a number,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 238.82999999999998,
          "end": 241.9,
          "en": "let's say 10, and this number is the number",
          "zh": ""
        },
        {
          "id": 83,
          "start": 241.9,
          "end": 244.76,
          "en": "of seconds NextJS will wait",
          "zh": ""
        },
        {
          "id": 84,
          "start": 244.76,
          "end": 247.41,
          "en": "until it regenerates this page",
          "zh": ""
        },
        {
          "id": 85,
          "start": 247.41,
          "end": 249.313,
          "en": "for an incoming request.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 250.34,
          "end": 254.01,
          "en": "That means that with revalidate set to some number,",
          "zh": ""
        },
        {
          "id": 87,
          "start": 254.01,
          "end": 257.72,
          "en": "this page will not just be generated",
          "zh": ""
        },
        {
          "id": 88,
          "start": 257.72,
          "end": 259.34,
          "en": "during the build process.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 259.34,
          "end": 262.36,
          "en": "It will be generated there but not just",
          "zh": ""
        },
        {
          "id": 90,
          "start": 262.36,
          "end": 265.94,
          "en": "but it will also be generated every couple of seconds",
          "zh": ""
        },
        {
          "id": 91,
          "start": 265.94,
          "end": 269.2,
          "en": "on the server, at least if there are requests",
          "zh": ""
        },
        {
          "id": 92,
          "start": 269.2,
          "end": 270.602,
          "en": "for this page.",
          "zh": ""
        },
        {
          "id": 93,
          "start": 270.602,
          "end": 275.52,
          "en": "So that means that this page, with revalidate set to 10,",
          "zh": ""
        },
        {
          "id": 94,
          "start": 275.52,
          "end": 278.3,
          "en": "would be regenerated on the server",
          "zh": ""
        },
        {
          "id": 95,
          "start": 278.3,
          "end": 282.14,
          "en": "at least every 10 seconds if there are requests coming in",
          "zh": ""
        },
        {
          "id": 96,
          "start": 282.14,
          "end": 283.5,
          "en": "for this page.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 283.5,
          "end": 286.34000000000003,
          "en": "And then these regenerated pages",
          "zh": ""
        },
        {
          "id": 98,
          "start": 286.34000000000003,
          "end": 290.06,
          "en": "would replace the old pre-generated pages.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 290.06,
          "end": 292.46,
          "en": "And with that, you would ensure that your data",
          "zh": ""
        },
        {
          "id": 100,
          "start": 292.46,
          "end": 295.84000000000003,
          "en": "is never older than 10 seconds.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 295.84000000000003,
          "end": 297.5,
          "en": "And therefore, the number of seconds",
          "zh": ""
        },
        {
          "id": 102,
          "start": 297.5,
          "end": 298.79,
          "en": "you wanna use here depends",
          "zh": ""
        },
        {
          "id": 103,
          "start": 298.79,
          "end": 301.51,
          "en": "on your data update frequency.",
          "zh": ""
        },
        {
          "id": 104,
          "start": 301.51,
          "end": 305.1,
          "en": "If your data changes once every hour,",
          "zh": ""
        },
        {
          "id": 105,
          "start": 305.1,
          "end": 309.29,
          "en": "then setting this to 3600 might be great.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 309.29,
          "end": 313.63,
          "en": "If it changes all the time, one second might be better.",
          "zh": ""
        },
        {
          "id": 107,
          "start": 313.63,
          "end": 315.84,
          "en": "But whatever you set this number to,",
          "zh": ""
        },
        {
          "id": 108,
          "start": 315.84,
          "end": 318.403,
          "en": "you will ensure that this page will occasionally",
          "zh": ""
        },
        {
          "id": 109,
          "start": 318.403,
          "end": 323.403,
          "en": "be re pre-generated on the server after deployment",
          "zh": ""
        },
        {
          "id": 110,
          "start": 324.317,
          "end": 326.74,
          "en": "so that you don't have to redeploy",
          "zh": ""
        },
        {
          "id": 111,
          "start": 326.74,
          "end": 331.37,
          "en": "and rebuild all the time just because some data changed.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 331.37,
          "end": 333.57,
          "en": "It doesn't really matter to us here,",
          "zh": ""
        },
        {
          "id": 113,
          "start": 333.57,
          "end": 336.9,
          "en": "especially not as long as we're just using this dummy array",
          "zh": ""
        },
        {
          "id": 114,
          "start": 336.9,
          "end": 340.03,
          "en": "but it is an important feature you should know about",
          "zh": ""
        },
        {
          "id": 115,
          "start": 340.03,
          "end": 342.293,
          "en": "and that is how you can set it.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}