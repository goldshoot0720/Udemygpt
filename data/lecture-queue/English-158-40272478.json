{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "40272478",
      "title": "A Different Way Of Consuming Context",
      "sourceHash": "49cf3db40b8b0cea3629c6d134261f85517ee336e6f9ece9a45359cf681cd68f",
      "cues": [
        {
          "id": 1,
          "start": 0.12,
          "end": 2.28,
          "en": "Now, before we'll use context",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.28,
          "end": 7.28,
          "en": "in more places of this app and get rid of unnecessary props",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.41,
          "end": 10.86,
          "en": "and prop drilling in other parts of the app,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 10.86,
          "end": 15.12,
          "en": "I wanna quickly explore another way of accessing",
          "zh": ""
        },
        {
          "id": 5,
          "start": 15.12,
          "end": 20.12,
          "en": "and reading context because, of course, you can do that",
          "zh": ""
        },
        {
          "id": 6,
          "start": 20.28,
          "end": 24.51,
          "en": "with help of the useContext hook because as you learned,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 24.51,
          "end": 27.15,
          "en": "this hook does kind of connect",
          "zh": ""
        },
        {
          "id": 8,
          "start": 27.15,
          "end": 29.67,
          "en": "a component function to the context",
          "zh": ""
        },
        {
          "id": 9,
          "start": 29.67,
          "end": 34.44,
          "en": "and make that context value available in that function.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 34.44,
          "end": 38.19,
          "en": "And I'll also say right away that this hook,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 38.19,
          "end": 41.88,
          "en": "the useContext hook is the standard way,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 41.88,
          "end": 44.82,
          "en": "the standard approach you should use",
          "zh": ""
        },
        {
          "id": 13,
          "start": 44.82,
          "end": 49.53,
          "en": "for getting access to context in a component.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 49.53,
          "end": 52.65,
          "en": "But there also is an alternative,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 52.65,
          "end": 55.35,
          "en": "which I also wanna introduce you to",
          "zh": ""
        },
        {
          "id": 16,
          "start": 55.35,
          "end": 59.4,
          "en": "because you might encounter it in other React projects",
          "zh": ""
        },
        {
          "id": 17,
          "start": 59.4,
          "end": 60.93,
          "en": "you might be working on",
          "zh": ""
        },
        {
          "id": 18,
          "start": 60.93,
          "end": 65.93,
          "en": "especially if those projects have a slightly older code base",
          "zh": ""
        },
        {
          "id": 19,
          "start": 67.08,
          "end": 70.56,
          "en": "because there's a special component you can access",
          "zh": ""
        },
        {
          "id": 20,
          "start": 70.56,
          "end": 73.08,
          "en": "on that context object,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 73.08,
          "end": 76.77,
          "en": "just as we could access the provider component",
          "zh": ""
        },
        {
          "id": 22,
          "start": 76.77,
          "end": 79.2,
          "en": "on that context object.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 79.2,
          "end": 82.44,
          "en": "That provider component is required",
          "zh": ""
        },
        {
          "id": 24,
          "start": 82.44,
          "end": 87.44,
          "en": "to provide a context value to all interested components.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 88.05,
          "end": 91.14,
          "en": "But besides that provider component,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 91.14,
          "end": 95.22,
          "en": "this CartContext or any context object",
          "zh": ""
        },
        {
          "id": 27,
          "start": 95.22,
          "end": 99.50999999999999,
          "en": "also offers another component you could use,",
          "zh": ""
        },
        {
          "id": 28,
          "start": 99.50999999999999,
          "end": 102.063,
          "en": "the Consumer component.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 102.96000000000001,
          "end": 107.96000000000001,
          "en": "The Consumer component can be used to wrap JSX code",
          "zh": ""
        },
        {
          "id": 30,
          "start": 109.41,
          "end": 113.313,
          "en": "that should have access to a context value with it.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 114.36,
          "end": 116.55,
          "en": "Now, that Consumer component",
          "zh": ""
        },
        {
          "id": 32,
          "start": 116.55,
          "end": 119.91,
          "en": "then needs a special kind of child though,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 119.91,
          "end": 122.85,
          "en": "some special kind of content that's passed",
          "zh": ""
        },
        {
          "id": 34,
          "start": 122.85,
          "end": 125.47,
          "en": "between its opening and closing tax",
          "zh": ""
        },
        {
          "id": 35,
          "start": 126.33,
          "end": 130.05,
          "en": "because what you must pass as content here",
          "zh": ""
        },
        {
          "id": 36,
          "start": 130.05,
          "end": 132.3,
          "en": "is actually a function.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 132.3,
          "end": 137.3,
          "en": "So output between curly braces, since it's not JSX code,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 137.7,
          "end": 140.28,
          "en": "but instead a JavaScript expression,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 140.28,
          "end": 143.7,
          "en": "you should pass a function as a child",
          "zh": ""
        },
        {
          "id": 40,
          "start": 143.7,
          "end": 147.423,
          "en": "between the opening and closing Consumer component tags.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 148.53,
          "end": 151.65,
          "en": "And that function will, under the hood,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 151.65,
          "end": 154.65,
          "en": "be executed by React.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 154.65,
          "end": 158.67000000000002,
          "en": "And that function will then automatically receive",
          "zh": ""
        },
        {
          "id": 44,
          "start": 158.67000000000002,
          "end": 163.07999999999998,
          "en": "the context value which you are consuming here",
          "zh": ""
        },
        {
          "id": 45,
          "start": 163.07999999999998,
          "end": 164.403,
          "en": "as a parameter.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 165.24,
          "end": 168.51,
          "en": "And its then this function that should return",
          "zh": ""
        },
        {
          "id": 47,
          "start": 168.51,
          "end": 173.51,
          "en": "the actual JSX code that should be output by that component,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 173.7,
          "end": 176.073,
          "en": "so by that cart component here.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 178.38,
          "end": 181.8,
          "en": "So this function is essentially an extra wrapper",
          "zh": ""
        },
        {
          "id": 50,
          "start": 181.8,
          "end": 185.22,
          "en": "that's required by that Consumer component",
          "zh": ""
        },
        {
          "id": 51,
          "start": 185.22,
          "end": 188.31,
          "en": "to make that consumed context available",
          "zh": ""
        },
        {
          "id": 52,
          "start": 188.31,
          "end": 191.4,
          "en": "in that component's JSX code.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 191.4,
          "end": 196.32,
          "en": "And we could now move this totalPrice calculation",
          "zh": ""
        },
        {
          "id": 54,
          "start": 196.32,
          "end": 198.54,
          "en": "into this function, therefore,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 198.54,
          "end": 201.69,
          "en": "so that we can calculate the total price",
          "zh": ""
        },
        {
          "id": 56,
          "start": 201.69,
          "end": 205.8,
          "en": "based on that consumed cart context.",
          "zh": ""
        },
        {
          "id": 57,
          "start": 205.8,
          "end": 208.71,
          "en": "And I would just have to adjust it here",
          "zh": ""
        },
        {
          "id": 58,
          "start": 208.71,
          "end": 213.71,
          "en": "and access cardCtx.items also down there in the JSX code.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 216.9,
          "end": 220.07999999999998,
          "en": "And with that, we could then also get rid",
          "zh": ""
        },
        {
          "id": 60,
          "start": 220.07999999999998,
          "end": 222,
          "en": "of the useContext hook",
          "zh": ""
        },
        {
          "id": 61,
          "start": 222,
          "end": 227,
          "en": "and instead consume and use that context value like this.",
          "zh": ""
        },
        {
          "id": 62,
          "start": 227.01,
          "end": 231.54,
          "en": "And this would also work absolutely fine as you see",
          "zh": ""
        },
        {
          "id": 63,
          "start": 231.54,
          "end": 234.39,
          "en": "if you preview this application.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 234.39,
          "end": 236.52,
          "en": "We can still edit this cart",
          "zh": ""
        },
        {
          "id": 65,
          "start": 236.52,
          "end": 239.523,
          "en": "and you still see that the UI gets updated.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 240.48,
          "end": 244.2,
          "en": "But of course, this approach is a bit more cumbersome",
          "zh": ""
        },
        {
          "id": 67,
          "start": 244.2,
          "end": 246.21,
          "en": "and also harder to read",
          "zh": ""
        },
        {
          "id": 68,
          "start": 246.21,
          "end": 250.56,
          "en": "and it's therefore not the default approach you should use.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 250.56,
          "end": 253.41,
          "en": "It's just an approach I wanna show you",
          "zh": ""
        },
        {
          "id": 70,
          "start": 253.41,
          "end": 258.27,
          "en": "because you might encounter it in other React projects.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 258.27,
          "end": 260.91,
          "en": "But here for this project and, of course,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 260.91,
          "end": 263.97,
          "en": "I'll actually get rid of this approach here,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 263.97,
          "end": 266.88,
          "en": "I'll get rid of that Consumer component",
          "zh": ""
        },
        {
          "id": 74,
          "start": 266.88,
          "end": 269.01,
          "en": "and all the code we wrote",
          "zh": ""
        },
        {
          "id": 75,
          "start": 269.01,
          "end": 272.90999999999997,
          "en": "and I'll go back to using the useContext hook",
          "zh": ""
        },
        {
          "id": 76,
          "start": 272.90999999999997,
          "end": 276.99,
          "en": "because that should be the default approach you are using",
          "zh": ""
        },
        {
          "id": 77,
          "start": 276.99,
          "end": 281.37,
          "en": "for accessing context values because it's cleaner,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 281.37,
          "end": 284.43,
          "en": "less code to write, easier to read,",
          "zh": ""
        },
        {
          "id": 79,
          "start": 284.43,
          "end": 286.40999999999997,
          "en": "and simply the most modern",
          "zh": ""
        },
        {
          "id": 80,
          "start": 286.40999999999997,
          "end": 290.343,
          "en": "and best practice way of accessing context values.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 291.45,
          "end": 293.61,
          "en": "But since you might encounter it",
          "zh": ""
        },
        {
          "id": 82,
          "start": 293.61,
          "end": 295.53,
          "en": "out there in other projects,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 295.53,
          "end": 299.343,
          "en": "you should also be aware of that Consumer component.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}