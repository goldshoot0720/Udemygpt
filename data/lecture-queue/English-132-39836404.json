{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "39836404",
      "title": "Sharing State Across Components",
      "sourceHash": "f1718b84fdf6ea0e502d3d8b8b9b48f7623a26af8bb8ba6f349fb2f92593d97c",
      "cues": [
        {
          "id": 1,
          "start": 0.84,
          "end": 3.18,
          "en": "Now to forward the correct information",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.18,
          "end": 6.66,
          "en": "to the modal, we should replace this result prop",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.66,
          "end": 8.501,
          "en": "with a different prop now",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.501,
          "end": 12.984,
          "en": "because now we know how much time is remaining here",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.984,
          "end": 16.77,
          "en": "and I want to pass that remaining time to result modal",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.77,
          "end": 19.56,
          "en": "so that we can use it there to, for example,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 19.56,
          "end": 21.579,
          "en": "calculate a score.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 21.579,
          "end": 26.13,
          "en": "Hence I'll add a prop here, remaining time,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 26.13,
          "end": 29.973,
          "en": "which gets this time remaining state as a value.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 32.58,
          "end": 35.43,
          "en": "Now inside of result modal, we can and should",
          "zh": ""
        },
        {
          "id": 11,
          "start": 35.43,
          "end": 38.991,
          "en": "now destructure that prop remaining time",
          "zh": ""
        },
        {
          "id": 12,
          "start": 38.991,
          "end": 41.927,
          "en": "and now use it to calculate a score",
          "zh": ""
        },
        {
          "id": 13,
          "start": 41.927,
          "end": 45.16,
          "en": "or find out if the user lost.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 45.16,
          "end": 48.84,
          "en": "For that I'll add a new computed value here",
          "zh": ""
        },
        {
          "id": 15,
          "start": 48.84,
          "end": 50.97,
          "en": "and store it in a constant.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 50.97,
          "end": 55.342,
          "en": "And I'll name this constant user lost,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 55.342,
          "end": 60.24,
          "en": "which should be true if remaining time",
          "zh": ""
        },
        {
          "id": 18,
          "start": 60.24,
          "end": 63.063,
          "en": "is smaller or equal than zero.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 64.05,
          "end": 65.4,
          "en": "Because if that's the case,",
          "zh": ""
        },
        {
          "id": 20,
          "start": 65.4,
          "end": 67.17,
          "en": "we know that the timer expired",
          "zh": ""
        },
        {
          "id": 21,
          "start": 67.17,
          "end": 69.81,
          "en": "and we did not stop it in time",
          "zh": ""
        },
        {
          "id": 22,
          "start": 69.81,
          "end": 74.67,
          "en": "and now we can use user lost to output you lost here",
          "zh": ""
        },
        {
          "id": 23,
          "start": 74.67,
          "end": 77.883,
          "en": "conditionally if user lost is true.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 79.71000000000001,
          "end": 82.35,
          "en": "So this h2 element with the text, \"You lost\"",
          "zh": ""
        },
        {
          "id": 25,
          "start": 82.35,
          "end": 84.663,
          "en": "is shown if user lost is true.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 86.377,
          "end": 89.78999999999999,
          "en": "Now that we've got the remaining time, we can also output",
          "zh": ""
        },
        {
          "id": 27,
          "start": 89.78999999999999,
          "end": 91.39,
          "en": "that remaining time down here",
          "zh": ""
        },
        {
          "id": 28,
          "start": 92.49000000000001,
          "end": 95.03999999999999,
          "en": "though I'm getting it in milliseconds here",
          "zh": ""
        },
        {
          "id": 29,
          "start": 95.03999999999999,
          "end": 96.93,
          "en": "because that's how we're managing it",
          "zh": ""
        },
        {
          "id": 30,
          "start": 96.93,
          "end": 98.55,
          "en": "in Timer Challenge",
          "zh": ""
        },
        {
          "id": 31,
          "start": 98.55,
          "end": 100.92,
          "en": "and I need it in seconds here.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 100.92,
          "end": 103.77000000000001,
          "en": "So we need to divide it by 1000",
          "zh": ""
        },
        {
          "id": 33,
          "start": 103.77000000000001,
          "end": 106.5,
          "en": "and we should probably also format it",
          "zh": ""
        },
        {
          "id": 34,
          "start": 106.5,
          "end": 109.473,
          "en": "a little bit to present it in a nice way.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 110.72999999999999,
          "end": 115.675,
          "en": "Therefore I'll get my formatted remaining time here",
          "zh": ""
        },
        {
          "id": 36,
          "start": 115.675,
          "end": 120.675,
          "en": "by dividing remaining time by 1000,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 122.88,
          "end": 125.22,
          "en": "and then on the result of that division,",
          "zh": ""
        },
        {
          "id": 38,
          "start": 125.22,
          "end": 129.9,
          "en": "we can call to fixed a method built into JavaScript",
          "zh": ""
        },
        {
          "id": 39,
          "start": 129.9,
          "end": 134.223,
          "en": "to always show exactly two decimal places on that number",
          "zh": ""
        },
        {
          "id": 40,
          "start": 134.223,
          "end": 137.4,
          "en": "so that we don't output a super long number",
          "zh": ""
        },
        {
          "id": 41,
          "start": 137.4,
          "end": 139.293,
          "en": "with a lot of decimal places.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 140.4,
          "end": 143.1,
          "en": "And it's now this formatted remaining time",
          "zh": ""
        },
        {
          "id": 43,
          "start": 143.1,
          "end": 145.15,
          "en": "that can and should be output down there.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 146.13,
          "end": 149.52,
          "en": "With that, we should get rid of this result prop here",
          "zh": ""
        },
        {
          "id": 45,
          "start": 149.52,
          "end": 151.143,
          "en": "which we no longer receive.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 152.01,
          "end": 155.49,
          "en": "And if we save that and reload, if I start this",
          "zh": ""
        },
        {
          "id": 47,
          "start": 155.49,
          "end": 159.57,
          "en": "and let it expire, I get this pop up,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 159.57,
          "end": 161.49,
          "en": "which is not what I was looking for",
          "zh": ""
        },
        {
          "id": 49,
          "start": 161.49,
          "end": 164.1,
          "en": "because it tells me that there is one second left",
          "zh": ""
        },
        {
          "id": 50,
          "start": 164.1,
          "end": 166.961,
          "en": "and I don't see you lost here.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 166.961,
          "end": 169.083,
          "en": "Now why is that the case?",
          "zh": ""
        },
        {
          "id": 52,
          "start": 170.49,
          "end": 173.37,
          "en": "That happens because in timer challenge",
          "zh": ""
        },
        {
          "id": 53,
          "start": 173.37,
          "end": 176.31,
          "en": "we set the time remaining back to the initial time",
          "zh": ""
        },
        {
          "id": 54,
          "start": 176.31,
          "end": 180.33,
          "en": "remaining, so the target time times 1000,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 180.33,
          "end": 183,
          "en": "right when the timer expired.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 183,
          "end": 185.1,
          "en": "So the time remaining at this point",
          "zh": ""
        },
        {
          "id": 57,
          "start": 185.1,
          "end": 187.5,
          "en": "isn't this negative time anymore.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 187.5,
          "end": 190.35,
          "en": "Instead it's back to this initial time.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 190.35,
          "end": 195.344,
          "en": "So what we wanna do instead is not reset the time here",
          "zh": ""
        },
        {
          "id": 60,
          "start": 195.344,
          "end": 199.048,
          "en": "but instead we should add a new function here,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 199.048,
          "end": 202.763,
          "en": "handle reset could be the name,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 202.763,
          "end": 206.74,
          "en": "and reset the time remaining in there.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 206.74,
          "end": 209.97,
          "en": "And now we can pass handle reset",
          "zh": ""
        },
        {
          "id": 64,
          "start": 209.97,
          "end": 212.463,
          "en": "through a prop two result modal.",
          "zh": ""
        },
        {
          "id": 65,
          "start": 213.39,
          "end": 215.97,
          "en": "On reset could be the prop name",
          "zh": ""
        },
        {
          "id": 66,
          "start": 215.97,
          "end": 217.953,
          "en": "and then point at handle reset,",
          "zh": ""
        },
        {
          "id": 67,
          "start": 219.3,
          "end": 222.32999999999998,
          "en": "and trigger that from inside the result model",
          "zh": ""
        },
        {
          "id": 68,
          "start": 222.32999999999998,
          "end": 225.363,
          "en": "as we did it many times before in this course already.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 226.92000000000002,
          "end": 229.98,
          "en": "So in here we now can and should destructure",
          "zh": ""
        },
        {
          "id": 70,
          "start": 229.98,
          "end": 231.88,
          "en": "that on reset prop",
          "zh": ""
        },
        {
          "id": 71,
          "start": 233.013,
          "end": 237.671,
          "en": "and it should be triggered when this dialogue is closed,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 237.671,
          "end": 241.08,
          "en": "which of course happens when this button here is clicked",
          "zh": ""
        },
        {
          "id": 73,
          "start": 241.08,
          "end": 243.423,
          "en": "and this form therefore is submitted.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 244.65,
          "end": 247.8,
          "en": "So we can add the on submit prop here to the form",
          "zh": ""
        },
        {
          "id": 75,
          "start": 247.8,
          "end": 250.62,
          "en": "which is another prop built into React",
          "zh": ""
        },
        {
          "id": 76,
          "start": 250.62,
          "end": 253.503,
          "en": "and supported by default, by the form element.",
          "zh": ""
        },
        {
          "id": 77,
          "start": 254.34,
          "end": 256.92,
          "en": "It will be triggered whenever the form is submitted,",
          "zh": ""
        },
        {
          "id": 78,
          "start": 256.92,
          "end": 259.98,
          "en": "which is the case when this button in this form is clicked.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 259.98,
          "end": 263.142,
          "en": "And here I wanna point at on reset.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 263.142,
          "end": 265.74,
          "en": "With that, if we save this,",
          "zh": ""
        },
        {
          "id": 81,
          "start": 265.74,
          "end": 268.86,
          "en": "if I reload and start this and let it expire,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 268.86,
          "end": 273.437,
          "en": "now I see you lost and I got zero seconds left here",
          "zh": ""
        },
        {
          "id": 83,
          "start": 273.437,
          "end": 277.683,
          "en": "and if I close this, it is reset and I can restart it.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 278.82,
          "end": 281.67,
          "en": "So now this is working as it should here,",
          "zh": ""
        },
        {
          "id": 85,
          "start": 281.67,
          "end": 284.28,
          "en": "but of course now I also wanna show a score",
          "zh": ""
        },
        {
          "id": 86,
          "start": 284.28,
          "end": 286.573,
          "en": "if we stop the timer in time",
          "zh": ""
        },
        {
          "id": 87,
          "start": 286.573,
          "end": 289.74,
          "en": "because then you see indeed I don't see you lost",
          "zh": ""
        },
        {
          "id": 88,
          "start": 289.74,
          "end": 291.75,
          "en": "and I get the correct time left.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 291.75,
          "end": 293.1,
          "en": "But I now also wanna show",
          "zh": ""
        },
        {
          "id": 90,
          "start": 293.1,
          "end": 296.283,
          "en": "a little success message here and my score.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}