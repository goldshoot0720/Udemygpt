      "cues": [
        {
          "id": 1,
          "start": 1.966,
          "end": 4.5,
          "en": "Maximilian: So we got this JSX code here",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.5,
          "end": 8.266,
          "en": "which is basically HTML code inside of JavaScript.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 8.266,
          "end": 12.7,
          "en": "Indeed, JSX stands for JavaScript XML",
          "zh": ""
        },
        {
          "id": 4,
          "start": 12.7,
          "end": 17.1,
          "en": "because HTML in the end is XML, you could say.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 17.1,
          "end": 20.266,
          "en": "So we got this HTML code in JavaScript.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 20.266,
          "end": 22.7,
          "en": "And again, this is really important.",
          "zh": ""
        },
        {
          "id": 7,
