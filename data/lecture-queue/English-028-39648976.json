      "sourceHash": "e9c93edb7ee2b7e2df25978ce3b9ef28aa63a9de5cdd8c28317c1a42dee7f154",
      "cues": [
        {
          "id": 1,
          "start": 0.36,
          "end": 3.84,
          "en": "In this React Essentials Course Section,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.84,
          "end": 5.07,
          "en": "we are going to build",
          "zh": ""
        },
        {
          "id": 3,
          "start": 5.07,
          "end": 8.73,
          "en": "this beautiful demo web application,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 8.73,
          "end": 11.79,
          "en": "with React and from the ground up.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 11.79,
          "end": 14.31,
          "en": "And as you can see, this website has",
          "zh": ""
        },
        {
          "id": 6,
          "start": 14.31,
          "end": 18.9,
          "en": "both static as well as dynamic interactive content.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.9,
          "end": 20.85,
          "en": "And therefore, along the way,",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.85,
          "end": 22.86,
          "en": "whilst building this website,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 22.86,
          "end": 27.54,
          "en": "you will learn about the most important React features,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 27.54,
          "end": 29.97,
          "en": "the essentials you'll always need,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.97,
          "end": 33.78,
          "en": "no matter which React app of whichever complexity",
          "zh": ""
        },
        {
          "id": 12,
          "start": 33.78,
          "end": 35.25,
          "en": "you're going to build.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 35.25,
          "end": 37.38,
          "en": "And we'll get started by taking a look",
          "zh": ""
        },
        {
          "id": 14,
          "start": 37.38,
          "end": 40.95,
          "en": "at one of the most important React concepts you can learn.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 40.95,
          "end": 43.95,
          "en": "We'll get started by exploring Components,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 43.95,
          "end": 47.64,
          "en": "and a couple of related concepts like JSX,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 47.64,
          "end": 48.84,
          "en": "working with Props,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 48.84,
          "end": 50.64,
          "en": "and what all these things are,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 50.64,
          "end": 54.57,
          "en": "and how to work with them as a React developer.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 54.57,
          "end": 57.93,
          "en": "You will also learn how to work with data",
          "zh": ""
        },
        {
          "id": 21,
          "start": 57.93,
          "end": 62.04,
          "en": "in your React apps, how to output data, for example.",
          "zh": ""
        },
        {
          "id": 22,
          "start": 62.04,
          "end": 65.85,
          "en": "And you will learn how to make your React apps interactive",
          "zh": ""
        },
        {
          "id": 23,
          "start": 65.85,
          "end": 69.53999999999999,
          "en": "by reacting to user events like button clicks,",
          "zh": ""
        },
        {
          "id": 24,
          "start": 69.53999999999999,
          "end": 71.78999999999999,
          "en": "and by diving into another",
          "zh": ""
        },
        {
          "id": 25,
          "start": 71.78999999999999,
          "end": 74.78999999999999,
          "en": "crucial React concept called State,",
          "zh": ""
        },
        {
          "id": 26,
          "start": 74.78999999999999,
          "end": 78.57,
          "en": "which will be super important for turning static websites",
          "zh": ""
        },
        {
          "id": 27,
          "start": 78.57,
          "end": 81.36,
          "en": "into dynamic interactive websites.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 81.36,
          "end": 83.7,
          "en": "And therefore, by the end of this section,",
          "zh": ""
        },
        {
          "id": 29,
          "start": 83.7,
          "end": 85.86,
          "en": "you'll know about all these",
          "zh": ""
        },
        {
          "id": 30,
          "start": 85.86,
          "end": 89.91,
          "en": "crucial fundamental React concepts and how to use them.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 89.91,
          "end": 92.85,
          "en": "You'll be able to build basic React apps,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 92.85,
          "end": 96.9,
          "en": "both static and dynamic interactive ones, of course,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 96.9,
          "end": 100.86,
          "en": "and you need no prior React knowledge to get started,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 100.86,
          "end": 103.77000000000001,
          "en": "you just need that basic JavaScript knowledge",
          "zh": ""
        },
        {
          "id": 35,
          "start": 103.77000000000001,
          "end": 106.863,
          "en": "because that's, of course, assumed for this entire course.",
          "zh": ""
        }
      ]
    }
