          "zh": ""
        },
        {
          "id": 23,
          "start": 67.98,
          "end": 71.73,
          "en": "though I wanna point out that this project here",
          "zh": ""
        },
        {
          "id": 24,
          "start": 71.73,
          "end": 76.35,
          "en": "actually contains kind of two projects, you could say.",
