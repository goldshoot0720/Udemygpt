        },
        {
          "id": 186,
          "start": 622.5,
          "end": 624.63,
          "en": "so this is allowed in JavaScript,",
          "zh": ""
        },
        {
          "id": 187,
          "start": 624.63,
          "end": 627.603,
          "en": "but you won't clash with built-in props.",
