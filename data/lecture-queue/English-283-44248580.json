  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "44248580",
      "title": "Migrating To Form Actions",
      "sourceHash": "c67572dafd66e37fa4396f2921d8275ddb224a7da2373338c8451814b724e4fe",
      "cues": [
        {
          "id": 1,
          "start": 0.63,
          "end": 2.49,
          "en": "So in this section here,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.49,
          "end": 4.68,
          "en": "in the Checkout component,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 4.68,
          "end": 6.9,
          "en": "we actually handled the submission",
          "zh": ""
        },
        {
          "id": 4,
          "start": 6.9,
          "end": 10.983,
          "en": "of this checkout form manually with the onSubmit prop.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.03,
          "end": 16.14,
          "en": "And we then extracted those entered values",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.14,
          "end": 19.62,
          "en": "in that function, in that handleSubmit function",
          "zh": ""
        },
        {
          "id": 7,
          "start": 19.62,
          "end": 22.41,
          "en": "by constructing a FormData object",
          "zh": ""
        },
        {
          "id": 8,
          "start": 22.41,
          "end": 24.93,
          "en": "by then getting hold of the event.target,",
          "zh": ""
        },
        {
          "id": 9,
          "start": 24.93,
          "end": 25.92,
          "en": "which is the form,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 25.92,
          "end": 29.61,
          "en": "and by then collecting that FormData like this.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.61,
          "end": 31.17,
          "en": "And that, of course, all works,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 31.17,
          "end": 35.1,
          "en": "but you did, of course, also learn about form actions",
          "zh": ""
        },
        {
          "id": 13,
          "start": 35.1,
          "end": 36.45,
          "en": "earlier in this course.",
          "zh": ""
        },
        {
          "id": 14,
          "start": 36.45,
          "end": 38.01,
          "en": "And, therefore, we could, of course,",
          "zh": ""
        },
        {
          "id": 15,
          "start": 38.01,
          "end": 40.41,
          "en": "also handled this form submission",
          "zh": ""
        },
        {
          "id": 16,
          "start": 40.41,
          "end": 42.54,
          "en": "with help of form actions.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 42.54,
          "end": 44.74,
          "en": "And that's the other of what I wanna do now.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 45.93,
          "end": 50.043,
          "en": "Now, migrating actually isn't too difficult.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 50.88,
          "end": 53.79,
          "en": "We can start by giving this handleSubmit function",
          "zh": ""
        },
        {
          "id": 20,
          "start": 53.79,
          "end": 54.623,
          "en": "a different name,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 54.623,
          "end": 55.95,
          "en": "which is not mandatory",
          "zh": ""
        },
        {
          "id": 22,
          "start": 55.95,
          "end": 57.51,
          "en": "but which we can do",
          "zh": ""
        },
        {
          "id": 23,
          "start": 57.51,
          "end": 60.39,
          "en": "to make it clear that it is a form action.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 60.39,
          "end": 62.573,
          "en": "And I'll name it checkoutAction.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 65.7,
          "end": 68.85,
          "en": "And then I'll use this function.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 68.85,
          "end": 70.14,
          "en": "And down there,",
          "zh": ""
        },
        {
          "id": 27,
          "start": 70.14,
          "end": 73.74,
          "en": "I'll actually not set this onSubmit prop",
          "zh": ""
        },
        {
          "id": 28,
          "start": 73.74,
          "end": 74.97,
          "en": "on my form anymore.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 74.97,
          "end": 77.43,
          "en": "But instead, I'll set the action prop",
          "zh": ""
        },
        {
          "id": 30,
          "start": 77.43,
          "end": 79.44,
          "en": "to this renamed function,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 79.44,
          "end": 82.083,
          "en": "so to the checkoutAction function.",
          "zh": ""
        },
        {
          "id": 32,
          "start": 84.33,
          "end": 87.96000000000001,
          "en": "Now, as you learned earlier in the course,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 87.96000000000001,
          "end": 91.08,
          "en": "when triggering this as a form action,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 91.08,
          "end": 94.95,
          "en": "you will get a FormData object as an input.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 94.95,
          "end": 96.6,
          "en": "And I'm naming it FD,",
          "zh": ""
        },
        {
          "id": 36,
          "start": 96.6,
          "end": 99.45,
          "en": "since this was also the name I used down here",
          "zh": ""
        },
        {
          "id": 37,
          "start": 99.45,
          "end": 102.18299999999999,
          "en": "when I created that form data manually.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 103.47,
          "end": 105.33,
          "en": "So by switching to a form action,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 105.33,
          "end": 107.763,
          "en": "I can actually get rid of some code here.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 110.4,
          "end": 113.55,
          "en": "Now, I'm still extracting my customerData like this then,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 113.55,
          "end": 117.15,
          "en": "and I'm still sending a request thereafter.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 117.15,
          "end": 119.78999999999999,
          "en": "And sendRequest is still that function",
          "zh": ""
        },
        {
          "id": 43,
          "start": 119.78999999999999,
          "end": 123.84,
          "en": "that's provided by my custom HTTP hook here.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 123.84,
          "end": 126.21,
          "en": "It's this function here,",
          "zh": ""
        },
        {
          "id": 45,
          "start": 126.21,
          "end": 128.43,
          "en": "which in the end is an async function,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 128.43,
          "end": 130.653,
          "en": "so a function that returns a promise.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 131.97,
          "end": 134.34,
          "en": "So, of course, we can also turn this",
          "zh": ""
        },
        {
          "id": 48,
          "start": 134.34,
          "end": 138.3,
          "en": "into an async form action and await this,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 138.3,
          "end": 140.91,
          "en": "though this actually won't make a difference",
          "zh": ""
        },
        {
          "id": 50,
          "start": 140.91,
          "end": 143.67000000000002,
          "en": "if we don't use the form status anywhere,",
          "zh": ""
        },
        {
          "id": 51,
          "start": 143.67000000000002,
          "end": 146.1,
          "en": "if we don't use useSubmit",
          "zh": ""
        },
        {
          "id": 52,
          "start": 146.1,
          "end": 147.42000000000002,
          "en": "or anything like that.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 147.42000000000002,
          "end": 150.243,
          "en": "But for the moment, let's just keep it like this.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 152.52,
          "end": 154.53,
          "en": "And with those changes made,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 154.53,
          "end": 156.42000000000002,
          "en": "if I now go back to my page here",
          "zh": ""
        },
        {
          "id": 56,
          "start": 156.42000000000002,
          "end": 159.32999999999998,
          "en": "and add a couple of items to the cart,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 159.32999999999998,
          "end": 161.133,
          "en": "I can go to the Checkout page,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 162.42000000000002,
          "end": 165.16,
          "en": "enter my name and some email address",
          "zh": ""
        },
        {
          "id": 59,
          "start": 166.05,
          "end": 167.94299999999998,
          "en": "and some street,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 170.07,
          "end": 170.91,
          "en": "like this,",
          "zh": ""
        },
        {
          "id": 61,
          "start": 170.91,
          "end": 173.43,
          "en": "and if I click Submit Order,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 173.43,
          "end": 175.95,
          "en": "I got this Success! Popup thereafter.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 175.95,
          "end": 177.78,
          "en": "The cart is reset.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 177.78,
          "end": 179.31,
          "en": "And if I go to my backend",
          "zh": ""
        },
        {
          "id": 65,
          "start": 179.31,
          "end": 181.71,
          "en": "and take a look at the orders.json file,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 181.71,
          "end": 185.823,
          "en": "I can see that order here at the very bottom of this page.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 186.99,
          "end": 191.223,
          "en": "So that worked now with the help of form actions.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}