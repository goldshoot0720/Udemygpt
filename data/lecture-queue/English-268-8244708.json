          "end": 670.83,
          "en": "is the set loadedMeals function,",
          "zh": ""
        },
        {
          "id": 205,
          "start": 670.83,
          "end": 673.56,
          "en": "which is provided by the useState hook",
          "zh": ""
        },
        {
          "id": 206,
          "start": 673.56,
          "end": 677.703,
          "en": "and which is guaranteed by React to never change.",
          "zh": ""
        },
        {
          "id": 207,
          "start": 679.17,
          "end": 681.39,
          "en": "Therefore, this should work like this",
          "zh": ""
        },
        {
          "id": 208,
