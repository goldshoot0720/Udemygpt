{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "41718140",
      "title": "Using Client Components Efficiently",
      "sourceHash": "9a1c6fe8df74e02a906d691b35fffcb8a1322a902d018625d400a65e9cc53d5d",
      "cues": [
        {
          "id": 1,
          "start": 0.51,
          "end": 4.26,
          "en": "So now that we finished this starting page,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 4.26,
          "end": 7.92,
          "en": "let's as a next step work on this community page.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.92,
          "end": 11.64,
          "en": "And for that page, it's actually quite straightforward.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.64,
          "end": 13.08,
          "en": "I just wanna populate it",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.08,
          "end": 16.29,
          "en": "with some dummy content.",
          "zh": ""
        },
        {
          "id": 6,
          "start": 16.29,
          "end": 17.477,
          "en": "And therefore attached,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 17.477,
          "end": 20.67,
          "en": "you'll find my finished page.js file",
          "zh": ""
        },
        {
          "id": 8,
          "start": 20.67,
          "end": 23.19,
          "en": "and you can simply replace yours with it.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 23.19,
          "end": 26.16,
          "en": "So replace your community page.js file",
          "zh": ""
        },
        {
          "id": 10,
          "start": 26.16,
          "end": 28.023,
          "en": "with the one you find attached.",
          "zh": ""
        },
        {
          "id": 11,
          "start": 28.95,
          "end": 33.12,
          "en": "Attached you will also find a page.module.css file,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 33.12,
          "end": 35.07,
          "en": "which you should also add next",
          "zh": ""
        },
        {
          "id": 13,
          "start": 35.07,
          "end": 36.99,
          "en": "to the community page.js file",
          "zh": ""
        },
        {
          "id": 14,
          "start": 36.99,
          "end": 39.633,
          "en": "so that the required styles are available.",
          "zh": ""
        },
        {
          "id": 15,
          "start": 40.95,
          "end": 43.29,
          "en": "Now in that page.js file, you then see",
          "zh": ""
        },
        {
          "id": 16,
          "start": 43.29,
          "end": 46.59,
          "en": "that I got a community component function exported there.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 46.59,
          "end": 48.06,
          "en": "And in that component,",
          "zh": ""
        },
        {
          "id": 18,
          "start": 48.06,
          "end": 50.34,
          "en": "I'm just outputting some dummy text",
          "zh": ""
        },
        {
          "id": 19,
          "start": 50.34,
          "end": 52.053,
          "en": "and some images in the end.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 53.25,
          "end": 55.29,
          "en": "So that if you save everything,",
          "zh": ""
        },
        {
          "id": 21,
          "start": 55.29,
          "end": 58.68,
          "en": "the community page should look something like this,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 58.68,
          "end": 62.16,
          "en": "simply outputting some dummy fallback text.",
          "zh": ""
        },
        {
          "id": 23,
          "start": 62.16,
          "end": 64.32,
          "en": "Because of course the main logic",
          "zh": ""
        },
        {
          "id": 24,
          "start": 64.32,
          "end": 68.73,
          "en": "of this overall demo project will be related to the meals.",
          "zh": ""
        },
        {
          "id": 25,
          "start": 68.73,
          "end": 71.19,
          "en": "It's there where we'll fetch data",
          "zh": ""
        },
        {
          "id": 26,
          "start": 71.19,
          "end": 73.8,
          "en": "and add new meals and so on.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 73.8,
          "end": 76.08,
          "en": "And we'll get back to that soon.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 76.08,
          "end": 80.13,
          "en": "That's why here I just provided some dummy content for you.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 80.13,
          "end": 83.03999999999999,
          "en": "Now with that community page populated,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 83.03999999999999,
          "end": 85.41,
          "en": "there's one thing about the header",
          "zh": ""
        },
        {
          "id": 31,
          "start": 85.41,
          "end": 87.87,
          "en": "or about this navigation specifically",
          "zh": ""
        },
        {
          "id": 32,
          "start": 87.87,
          "end": 89.553,
          "en": "that I'd like to improve.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 90.53999999999999,
          "end": 93.75,
          "en": "We currently don't see which page is active.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 93.75,
          "end": 95.34,
          "en": "I am on the community page,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 95.34,
          "end": 99.53999999999999,
          "en": "but this link here is not highlighted when I'm on it",
          "zh": ""
        },
        {
          "id": 36,
          "start": 99.53999999999999,
          "end": 101.82300000000001,
          "en": "and it would be nice if it were highlighted.",
          "zh": ""
        },
        {
          "id": 37,
          "start": 103.02000000000001,
          "end": 105.6,
          "en": "And to achieve this, we can go back",
          "zh": ""
        },
        {
          "id": 38,
          "start": 105.6,
          "end": 108.09,
          "en": "to this main header component",
          "zh": ""
        },
        {
          "id": 39,
          "start": 108.09,
          "end": 110.22999999999999,
          "en": "where we have this navigation",
          "zh": ""
        },
        {
          "id": 40,
          "start": 111.12,
          "end": 114.39,
          "en": "and edit this link a little bit.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 114.39,
          "end": 115.35,
          "en": "To be precise,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 115.35,
          "end": 119.58,
          "en": "I wanna add a class conditionally to that link",
          "zh": ""
        },
        {
          "id": 43,
          "start": 119.58,
          "end": 121.17,
          "en": "depending on whether the page",
          "zh": ""
        },
        {
          "id": 44,
          "start": 121.17,
          "end": 124.32300000000001,
          "en": "to which this link leads is the active page or not.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 125.52,
          "end": 128.94,
          "en": "Now for that, in that main-header.module.css file,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 128.94,
          "end": 132.63,
          "en": "I did prepare a CSS class called active",
          "zh": ""
        },
        {
          "id": 47,
          "start": 132.63,
          "end": 134.88,
          "en": "that can be added to a link",
          "zh": ""
        },
        {
          "id": 48,
          "start": 134.88,
          "end": 137.49,
          "en": "to give it some active styling.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 137.49,
          "end": 140.46,
          "en": "Therefore all we have to do here is find out",
          "zh": ""
        },
        {
          "id": 50,
          "start": 140.46,
          "end": 143.73,
          "en": "whether this should be marked as active or not.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 143.73,
          "end": 146.91,
          "en": "And we can find out whether that's the case or not",
          "zh": ""
        },
        {
          "id": 52,
          "start": 146.91,
          "end": 149.55,
          "en": "by taking a look at the current path name.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 149.55,
          "end": 151.743,
          "en": "So the part after the domain.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 152.82,
          "end": 154.86,
          "en": "For example, for this community link,",
          "zh": ""
        },
        {
          "id": 55,
          "start": 154.86,
          "end": 158.43,
          "en": "the path is /community.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 158.43,
          "end": 161.79,
          "en": "Hence we know that if the path is equal to this path,",
          "zh": ""
        },
        {
          "id": 57,
          "start": 161.79,
          "end": 163.89,
          "en": "this link here should be marked as active.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 164.91,
          "end": 166.07999999999998,
          "en": "For the meals page",
          "zh": ""
        },
        {
          "id": 59,
          "start": 166.07999999999998,
          "end": 167.85,
          "en": "and the meals related pages,",
          "zh": ""
        },
        {
          "id": 60,
          "start": 167.85,
          "end": 171.93,
          "en": "we know that this link here should be marked as active",
          "zh": ""
        },
        {
          "id": 61,
          "start": 171.93,
          "end": 175.8,
          "en": "if we are on /meals or /mealsshare",
          "zh": ""
        },
        {
          "id": 62,
          "start": 175.8,
          "end": 178.02,
          "en": "or some other nested page.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 178.02,
          "end": 182.553,
          "en": "So if the currently active path starts with /meals.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 183.99,
          "end": 185.16,
          "en": "And therefore we just need",
          "zh": ""
        },
        {
          "id": 65,
          "start": 185.16,
          "end": 188.46,
          "en": "to get hold of the currently active path.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 188.46,
          "end": 192.3,
          "en": "And that thankfully is also quite straightforward to do",
          "zh": ""
        },
        {
          "id": 67,
          "start": 192.3,
          "end": 196.89,
          "en": "because NextJS gives you a use path name hook,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 196.89,
          "end": 199.563,
          "en": "which you can import from next navigation.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 201,
          "end": 204.51,
          "en": "And this hook gives you the currently active path.",
          "zh": ""
        },
        {
          "id": 70,
          "start": 204.51,
          "end": 206.613,
          "en": "So the part after the domain.",
          "zh": ""
        },
        {
          "id": 71,
          "start": 208.11,
          "end": 210.09,
          "en": "And with that path available,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 210.09,
          "end": 214.74,
          "en": "we can then set this meals link here to active",
          "zh": ""
        },
        {
          "id": 73,
          "start": 214.74,
          "end": 219.66,
          "en": "if the path which I'm getting from usePathname,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 219.66,
          "end": 223.72,
          "en": "if that path starts with /meals",
          "zh": ""
        },
        {
          "id": 75,
          "start": 224.57999999999998,
          "end": 227.64,
          "en": "so that this link here is marked as active,",
          "zh": ""
        },
        {
          "id": 76,
          "start": 227.64,
          "end": 229.53,
          "en": "no matter if we're on the meals page",
          "zh": ""
        },
        {
          "id": 77,
          "start": 229.53,
          "end": 230.79,
          "en": "or some nested page.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 230.79,
          "end": 232.39,
          "en": "That's why I'm using startsWith.",
          "zh": ""
        },
        {
          "id": 79,
          "start": 235.703,
          "end": 237.39,
          "en": "Now if that yields true,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 237.39,
          "end": 239.79,
          "en": "I want to add the active CSS class.",
          "zh": ""
        },
        {
          "id": 81,
          "start": 239.79,
          "end": 241.23,
          "en": "However, not like this,",
          "zh": ""
        },
        {
          "id": 82,
          "start": 241.23,
          "end": 243.45,
          "en": "but since we're using CSS modules,",
          "zh": ""
        },
        {
          "id": 83,
          "start": 243.45,
          "end": 245.58,
          "en": "instead like this.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 245.58,
          "end": 248.52,
          "en": "And otherwise I'll add undefined as a class",
          "zh": ""
        },
        {
          "id": 85,
          "start": 248.52,
          "end": 250.383,
          "en": "so that no class is added.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 252.96,
          "end": 256.71,
          "en": "Well, and now we can repeat that process on the other link",
          "zh": ""
        },
        {
          "id": 87,
          "start": 256.71,
          "end": 260.31,
          "en": "and simply copy that class name code over there.",
          "zh": ""
        },
        {
          "id": 88,
          "start": 260.31,
          "end": 261.84,
          "en": "Here I just want to check",
          "zh": ""
        },
        {
          "id": 89,
          "start": 261.84,
          "end": 264.69,
          "en": "whether the path starts with community",
          "zh": ""
        },
        {
          "id": 90,
          "start": 264.69,
          "end": 267.75,
          "en": "or since we don't have any nested pages here,",
          "zh": ""
        },
        {
          "id": 91,
          "start": 267.75,
          "end": 270.843,
          "en": "if the path is equal to /community.",
          "zh": ""
        },
        {
          "id": 92,
          "start": 272.01,
          "end": 274.5,
          "en": "And then I still want to add the active class",
          "zh": ""
        },
        {
          "id": 93,
          "start": 274.5,
          "end": 276.093,
          "en": "or no class at all.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 278.43,
          "end": 279.9,
          "en": "Now if we do that though,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 279.9,
          "end": 282.09000000000003,
          "en": "you'll be greeted by an error",
          "zh": ""
        },
        {
          "id": 96,
          "start": 282.09000000000003,
          "end": 283.26,
          "en": "because it turns out",
          "zh": ""
        },
        {
          "id": 97,
          "start": 283.26,
          "end": 287.90999999999997,
          "en": "that usePathname also only works in client components.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 287.90999999999997,
          "end": 291.65999999999997,
          "en": "And that's by the way, a convenient feature of NextJS.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 291.65999999999997,
          "end": 294.27,
          "en": "It will tell you if you're using a feature",
          "zh": ""
        },
        {
          "id": 100,
          "start": 294.27,
          "end": 296.61,
          "en": "that doesn't work in server components",
          "zh": ""
        },
        {
          "id": 101,
          "start": 296.61,
          "end": 298.11,
          "en": "in a server component",
          "zh": ""
        },
        {
          "id": 102,
          "start": 298.11,
          "end": 301.353,
          "en": "so that you can then add that use client directive.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 303.33,
          "end": 306.33,
          "en": "So here the fix is to add use client",
          "zh": ""
        },
        {
          "id": 104,
          "start": 306.33,
          "end": 307.863,
          "en": "at the top of this header.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 309.54,
          "end": 311.7,
          "en": "But here's something to keep in mind.",
          "zh": ""
        },
        {
          "id": 106,
          "start": 311.7,
          "end": 313.74,
          "en": "Whilst you can do that",
          "zh": ""
        },
        {
          "id": 107,
          "start": 313.74,
          "end": 315.54,
          "en": "and the error will then go away",
          "zh": ""
        },
        {
          "id": 108,
          "start": 315.54,
          "end": 319.11,
          "en": "and you can now see that the active link is highlighted,",
          "zh": ""
        },
        {
          "id": 109,
          "start": 319.11,
          "end": 321.09,
          "en": "whilst that all works,",
          "zh": ""
        },
        {
          "id": 110,
          "start": 321.09,
          "end": 324.84,
          "en": "you typically wanna add use client",
          "zh": ""
        },
        {
          "id": 111,
          "start": 324.84,
          "end": 328.68,
          "en": "as far down the component tree as possible",
          "zh": ""
        },
        {
          "id": 112,
          "start": 328.68,
          "end": 331.47,
          "en": "so that you really only turn the components",
          "zh": ""
        },
        {
          "id": 113,
          "start": 331.47,
          "end": 332.90999999999997,
          "en": "that need to be converted",
          "zh": ""
        },
        {
          "id": 114,
          "start": 332.90999999999997,
          "end": 336,
          "en": "to client components into client components",
          "zh": ""
        },
        {
          "id": 115,
          "start": 336,
          "end": 338.46,
          "en": "so that the majority of your components",
          "zh": ""
        },
        {
          "id": 116,
          "start": 338.46,
          "end": 340.5,
          "en": "can stay server components",
          "zh": ""
        },
        {
          "id": 117,
          "start": 340.5,
          "end": 342.81,
          "en": "and are rendered on the server",
          "zh": ""
        },
        {
          "id": 118,
          "start": 342.81,
          "end": 347.19,
          "en": "so that you don't lose those server component advantages",
          "zh": ""
        },
        {
          "id": 119,
          "start": 347.19,
          "end": 349.77,
          "en": "for most of your components.",
          "zh": ""
        },
        {
          "id": 120,
          "start": 349.77,
          "end": 351.3,
          "en": "And therefore here,",
          "zh": ""
        },
        {
          "id": 121,
          "start": 351.3,
          "end": 354.48,
          "en": "since this header component contains quite a lot of markup",
          "zh": ""
        },
        {
          "id": 122,
          "start": 354.48,
          "end": 357.6,
          "en": "that does not need to be a client component,",
          "zh": ""
        },
        {
          "id": 123,
          "start": 357.6,
          "end": 359.193,
          "en": "I'll take a different approach.",
          "zh": ""
        },
        {
          "id": 124,
          "start": 360.03,
          "end": 361.98,
          "en": "I'll add a new component file,",
          "zh": ""
        },
        {
          "id": 125,
          "start": 361.98,
          "end": 365.76,
          "en": "nav-link.js sounds like a fitting name.",
          "zh": ""
        },
        {
          "id": 126,
          "start": 365.76,
          "end": 370.653,
          "en": "And I'll add a nav-link.module.css file next to it.",
          "zh": ""
        },
        {
          "id": 127,
          "start": 372.3,
          "end": 374.73,
          "en": "And the idea in this JavaScript file",
          "zh": ""
        },
        {
          "id": 128,
          "start": 374.73,
          "end": 377.25,
          "en": "now is to export a component function",
          "zh": ""
        },
        {
          "id": 129,
          "start": 377.25,
          "end": 378.88,
          "en": "that can be called NavLink",
          "zh": ""
        },
        {
          "id": 130,
          "start": 380.01,
          "end": 383.64,
          "en": "that should simply output that NavLink.",
          "zh": ""
        },
        {
          "id": 131,
          "start": 383.64,
          "end": 385.95,
          "en": "So in the main-header.js file,",
          "zh": ""
        },
        {
          "id": 132,
          "start": 385.95,
          "end": 389.283,
          "en": "I'll simply grab this link here and only that.",
          "zh": ""
        },
        {
          "id": 133,
          "start": 390.45,
          "end": 392.58,
          "en": "I'll cut it",
          "zh": ""
        },
        {
          "id": 134,
          "start": 392.58,
          "end": 394.023,
          "en": "and return it here.",
          "zh": ""
        },
        {
          "id": 135,
          "start": 395.52,
          "end": 398.13,
          "en": "Now for that we must import the link component",
          "zh": ""
        },
        {
          "id": 136,
          "start": 398.13,
          "end": 400.08,
          "en": "from next link",
          "zh": ""
        },
