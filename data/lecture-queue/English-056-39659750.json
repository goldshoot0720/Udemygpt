  "lectures": [
    {
      "id": "39659750",
      "title": "Problem: Props Are Not Forwarded To Inner Elements",
      "sourceHash": "a730c8bdd313aa19ab14c40a1e386fce0ad4532bbaa2f9d5f0f9c348cbcfee77",
      "cues": [
        {
          "id": 1,
          "start": 0.6,
          "end": 3.3,
          "en": "At this point in this section,",
          "zh": ""
        },
