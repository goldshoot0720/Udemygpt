          "zh": ""
        },
        {
          "id": 3,
          "start": 6.9,
          "end": 11.43,
          "en": "and we got a code base that could absolutely stay this way.",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.43,
          "end": 13.55,
          "en": "But before we'll dive into",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.55,
          "end": 16.83,
          "en": "the next project we're going to build,",
          "zh": ""
        },
        {
          "id": 6,
