        },
        {
          "id": 149,
          "start": 470.4,
          "end": 471.87,
          "en": "Now, very important,",
          "zh": ""
        },
        {
          "id": 150,
          "start": 471.87,
          "end": 474.5,
          "en": "when you work with multiple slices,",
          "zh": ""
        },
        {
          "id": 151,
          "start": 474.5,
          "end": 478.23,
          "en": "you still only have one Redux store,",
          "zh": ""
        },
        {
          "id": 152,
          "start": 478.23,
          "end": 481.85,
          "en": "so you still only call configureStore once.",
          "zh": ""
        },
        {
          "id": 153,
          "start": 481.85,
          "end": 483.84,
          "en": "This does not change.",
          "zh": ""
        },
        {
          "id": 154,
          "start": 483.84,
          "end": 488.84,
          "en": "And this store only has one root reducer here",
          "zh": ""
        },
        {
          "id": 155,
          "start": 489.08,
          "end": 492.8,
          "en": "but as I briefly explained earlier,",
          "zh": ""
        },
        {
          "id": 156,
          "start": 492.8,
          "end": 496.17,
          "en": "this reducer actually does not just take",
