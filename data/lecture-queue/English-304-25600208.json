        },
        {
          "id": 143,
          "start": 446.92,
          "end": 449.763,
          "en": "set isAuthenticated to false.",
          "zh": ""
        },
        {
          "id": 144,
          "start": 450.72,
          "end": 454.753,
          "en": "And that could be our slice for the auth part.",
