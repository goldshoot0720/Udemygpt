        },
        {
          "id": 44,
          "start": 143.54,
          "end": 146.07,
          "en": "These items and the logout button",
          "zh": ""
        },
        {
          "id": 45,
          "start": 146.07,
          "end": 151.07,
          "en": "should only be displayed if we are logged in in Redux",
