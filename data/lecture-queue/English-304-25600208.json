        },
        {
          "id": 159,
          "start": 504.23,
          "end": 507.08,
          "en": "where you can then have any key names of your choice,",
          "zh": ""
        },
        {
          "id": 160,
          "start": 507.08,
          "end": 508.89,
          "en": "for example, counter",
          "zh": ""
        },
        {
          "id": 161,
          "start": 508.89,
          "end": 512.33,
          "en": "and then point at your different reducers.",
