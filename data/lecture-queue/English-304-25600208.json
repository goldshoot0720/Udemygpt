        },
        {
          "id": 38,
          "start": 123.56,
          "end": 126.63,
          "en": "We do this in a separate course section",
          "zh": ""
        },
        {
          "id": 39,
          "start": 126.63,
          "end": 130.58,
          "en": "because there's more to it than a little bit of Redux usage",
          "zh": ""
        },
        {
          "id": 40,
          "start": 130.58,
          "end": 133.873,
          "en": "but I wanna make sure that when we click Login,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 134.72,
          "end": 137.91,
          "en": "we do switch into some login mode",
          "zh": ""
        },
        {
          "id": 42,
          "start": 137.91,
          "end": 140.62,
          "en": "and for example, what we see here",
