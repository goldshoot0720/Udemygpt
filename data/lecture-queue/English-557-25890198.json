        },
        {
          "id": 63,
          "start": 214.24099999999999,
          "end": 216.63,
          "en": "in which we'll work now.",
          "zh": ""
        },
        {
          "id": 64,
          "start": 216.63,
          "end": 219.27,
          "en": "And for this here, I'll first of all,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 219.27,
          "end": 221.874,
          "en": "cd into this react-ts folder.",
