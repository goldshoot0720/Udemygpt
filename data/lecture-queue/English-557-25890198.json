        },
        {
          "id": 94,
          "start": 310.758,
          "end": 314.659,
          "en": "Before with just React and Vanilla JavaScript,",
          "zh": ""
        },
        {
          "id": 95,
          "start": 314.659,
          "end": 316.75,
          "en": "we just had this dev server,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 316.75,
          "end": 318.209,
          "en": "which takes our JavaScript code,",
          "zh": ""
        },
        {
          "id": 97,
          "start": 318.209,
          "end": 320.749,
          "en": "bundles all the files together,",
          "zh": ""
        },
        {
          "id": 98,
          "start": 320.749,
          "end": 324.6,
          "en": "and provides certain optimization steps.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 324.6,
          "end": 327.26800000000003,
          "en": "Now we still have all of that, but in addition,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 327.26800000000003,
          "end": 329.921,
          "en": "we have that extra TypeScript",
          "zh": ""
        },
        {
          "id": 101,
          "start": 329.921,
          "end": 333.2,
          "en": "to JavaScript compilation step,",
          "zh": ""
        },
        {
          "id": 102,
          "start": 333.2,
          "end": 335.688,
          "en": "which also takes place behind the scenes.",
          "zh": ""
        },
        {
          "id": 103,
          "start": 335.688,
          "end": 340.688,
          "en": "So we don't need to convert our TypeScript files manually",
          "zh": ""
        },
        {
          "id": 104,
          "start": 341.1,
          "end": 342.43,
          "en": "to JavaScript here.",
          "zh": ""
        },
        {
          "id": 105,
          "start": 342.43,
          "end": 344.65,
          "en": "We don't need to compile them manually",
          "zh": ""
        },
        {
          "id": 106,
          "start": 344.65,
          "end": 346.558,
          "en": "or call the compiler manually",
          "zh": ""
        },
        {
          "id": 107,
          "start": 346.558,
          "end": 348.646,
          "en": "that happens behind the scenes.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 348.646,
          "end": 352.84000000000003,
          "en": "It would also happen automatically if you build your code",
          "zh": ""
        },
        {
          "id": 109,
          "start": 352.84000000000003,
          "end": 356.63,
          "en": "for production by running npm run build.",
          "zh": ""
        },
        {
          "id": 110,
          "start": 356.63,
          "end": 358.45,
          "en": "That's just a little side note,",
          "zh": ""
        },
        {
          "id": 111,
          "start": 358.45,
          "end": 359.883,
          "en": "which I wanted to add here.",
          "zh": ""
        },
        {
          "id": 112,
