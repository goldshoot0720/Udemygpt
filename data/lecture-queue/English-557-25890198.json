          "id": 3,
          "start": 10.96,
          "end": 14.86,
          "en": "And for this, we need to create a new React project",
          "zh": ""
        },
        {
          "id": 4,
          "start": 14.86,
          "end": 17.33,
          "en": "where we get this development server",
          "zh": ""
        },
        {
          "id": 5,
          "start": 17.33,
          "end": 19.73,
