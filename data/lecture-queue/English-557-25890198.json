        },
        {
          "id": 60,
          "start": 204.279,
          "end": 208.76,
          "en": "and I'll delete that node_modules folder there.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 208.76,
          "end": 211.76,
          "en": "And now we have these two folders side by side",
          "zh": ""
        },
        {
          "id": 62,
          "start": 211.76,
          "end": 214.24099999999999,
          "en": "and it's, of course, the react-ts folder",
