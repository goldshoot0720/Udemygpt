        },
        {
          "id": 51,
          "start": 171.78,
          "end": 175.543,
          "en": "Now let's wait for dev to finish and then we'll continue.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 176.466,
          "end": 178.59,
          "en": "Now here, it did finish.",
          "zh": ""
        },
        {
          "id": 53,
          "start": 178.59,
          "end": 183.3,
          "en": "And with that, I got this new react-ts sub folder.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 183.3,
          "end": 185.93,
          "en": "And what I'll do now is I'll create another folder",
