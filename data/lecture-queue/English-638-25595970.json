        },
        {
          "id": 30,
          "start": 78.4,
          "end": 79.9,
          "en": "So even if that would happen",
          "zh": ""
        },
        {
          "id": 31,
          "start": 79.9,
          "end": 82.233,
          "en": "we wouldn't reach the desired result",
          "zh": ""
        },
        {
          "id": 32,
          "start": 82.233,
          "end": 84.1,
          "en": "but we don't even need to think about that",
          "zh": ""
        },
        {
          "id": 33,
          "start": 84.1,
          "end": 86.5,
          "en": "because it is not happening.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 86.5,
          "end": 86.633,
          "en": "because it is not happening.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 86.633,
          "end": 89.5,
          "en": "This ExpenseItem component function currently",
          "zh": ""
        },
        {
          "id": 36,
          "start": 89.5,
          "end": 93.5,
          "en": "is not called a second time after the initial rendering",
