        },
        {
          "id": 43,
          "start": 113.1,
          "end": 116.63300000000001,
          "en": "This here, is the default import.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 116.63300000000001,
          "end": 117.1,
          "en": "This here, is the default import.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 117.1,
          "end": 118.366,
          "en": "Now, we can add a comma",
          "zh": ""
        },
        {
          "id": 46,
          "start": 118.366,
          "end": 121.766,
          "en": "and curly braces and between the curly braces",
          "zh": ""
        },
        {
          "id": 47,
          "start": 121.766,
          "end": 125.6,
          "en": "we can now extract specifically named things",
          "zh": ""
        },
        {
          "id": 48,
          "start": 125.6,
          "end": 128.166,
          "en": "from the React library.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 128.166,
          "end": 128.766,
          "en": "from the React library.",
          "zh": ""
        },
        {
          "id": 50,
