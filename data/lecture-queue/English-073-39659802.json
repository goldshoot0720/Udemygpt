{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "39659802",
      "title": "Avoid Intersecting States!",
      "sourceHash": "f5ee10873ac5087ee6e835ce910eb7572975590c6266b62badeb78e3a68bcb20",
      "cues": [
        {
          "id": 1,
          "start": 0.72,
          "end": 2.52,
          "en": "Now before we'll start working",
          "zh": ""
        },
        {
          "id": 2,
          "start": 2.52,
          "end": 4.05,
          "en": "on that winning condition",
          "zh": ""
        },
        {
          "id": 3,
          "start": 4.05,
          "end": 6.06,
          "en": "or making sure that the same button",
          "zh": ""
        },
        {
          "id": 4,
          "start": 6.06,
          "end": 8.73,
          "en": "can't be clicked multiple times",
          "zh": ""
        },
        {
          "id": 5,
          "start": 8.73,
          "end": 12.36,
          "en": "I wanna work on that log that should be shown",
          "zh": ""
        },
        {
          "id": 6,
          "start": 12.36,
          "end": 14.46,
          "en": "below this game board,",
          "zh": ""
        },
        {
          "id": 7,
          "start": 14.46,
          "end": 17.88,
          "en": "because working on that will also allow us",
          "zh": ""
        },
        {
          "id": 8,
          "start": 17.88,
          "end": 20.91,
          "en": "to improve the code of this application",
          "zh": ""
        },
        {
          "id": 9,
          "start": 20.91,
          "end": 23.46,
          "en": "and the structure of the application.",
          "zh": ""
        },
        {
          "id": 10,
          "start": 23.46,
          "end": 27.45,
          "en": "Because whilst everything might look great right now,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 27.45,
          "end": 32.45,
          "en": "we're actually on the edge of writing suboptimal React code,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 32.79,
          "end": 36.24,
          "en": "especially if we plan to add more features.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 36.24,
          "end": 39.21,
          "en": "Now to show you what's suboptimal,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 39.21,
          "end": 41.7,
          "en": "let's add a new log component",
          "zh": ""
        },
        {
          "id": 15,
          "start": 41.7,
          "end": 44.94,
          "en": "because we'll need that component anyways.",
          "zh": ""
        },
        {
          "id": 16,
          "start": 44.94,
          "end": 47.31,
          "en": "So I'll add a new log JSX file",
          "zh": ""
        },
        {
          "id": 17,
          "start": 47.31,
          "end": 50.85,
          "en": "and in there I'll log component function",
          "zh": ""
        },
        {
          "id": 18,
          "start": 50.85,
          "end": 52.563,
          "en": "which of course is exported.",
          "zh": ""
        },
        {
          "id": 19,
          "start": 54.18,
          "end": 58.23,
          "en": "And the idea behind this log component here",
          "zh": ""
        },
        {
          "id": 20,
          "start": 58.23,
          "end": 63.09,
          "en": "is in the end that it's simply outputs an ordered list",
          "zh": ""
        },
        {
          "id": 21,
          "start": 63.09,
          "end": 65.76,
          "en": "with an ID of log for styling reasons",
          "zh": ""
        },
        {
          "id": 22,
          "start": 65.76,
          "end": 69.87,
          "en": "where we output information about the different turns",
          "zh": ""
        },
        {
          "id": 23,
          "start": 69.87,
          "end": 72,
          "en": "we had in our game thus far",
          "zh": ""
        },
        {
          "id": 24,
          "start": 72,
          "end": 74.7,
          "en": "so that we can simply see which turns",
          "zh": ""
        },
        {
          "id": 25,
          "start": 74.7,
          "end": 76.8,
          "en": "were taken by the different players",
          "zh": ""
        },
        {
          "id": 26,
          "start": 76.8,
          "end": 78.93,
          "en": "whilst playing that game.",
          "zh": ""
        },
        {
          "id": 27,
          "start": 78.93,
          "end": 81.87,
          "en": "And that of course means that we need to manage",
          "zh": ""
        },
        {
          "id": 28,
          "start": 81.87,
          "end": 85.17,
          "en": "some dynamic array of turns here.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 85.17,
          "end": 88.86,
          "en": "An array that grows with every button click.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 88.86,
          "end": 91.92,
          "en": "And that of course means that we can't really manage",
          "zh": ""
        },
        {
          "id": 31,
          "start": 91.92,
          "end": 95.00999999999999,
          "en": "that state here because that information,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 95.00999999999999,
          "end": 96.96000000000001,
          "en": "which button was clicked,",
          "zh": ""
        },
        {
          "id": 33,
          "start": 96.96000000000001,
          "end": 100.14,
          "en": "is generated here in the game board component.",
          "zh": ""
        },
        {
          "id": 34,
          "start": 100.14,
          "end": 105.14,
          "en": "So we again, need to lift state up to the app component",
          "zh": ""
        },
        {
          "id": 35,
          "start": 105.24000000000001,
          "end": 107.94,
          "en": "because that's the component that has access",
          "zh": ""
        },
        {
          "id": 36,
          "start": 107.94,
          "end": 111.21000000000001,
          "en": "to both the game board and the log component",
          "zh": ""
        },
        {
          "id": 37,
          "start": 111.21000000000001,
          "end": 112.473,
          "en": "which I wanna use here.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 114.24000000000001,
          "end": 116.5,
          "en": "And for that of course, we should also import",
          "zh": ""
        },
        {
          "id": 39,
          "start": 118.2,
          "end": 122.943,
          "en": "log from dot slash Components log JSX.",
          "zh": ""
        },
        {
          "id": 40,
          "start": 124.32,
          "end": 126.09,
          "en": "So we need to lift state up,",
          "zh": ""
        },
        {
          "id": 41,
          "start": 126.09,
          "end": 129.701,
          "en": "and therefore here we can use \"useState\"",
          "zh": ""
        },
        {
          "id": 42,
          "start": 129.701,
          "end": 132.123,
          "en": "to manage an array of turn data.",
          "zh": ""
        },
        {
          "id": 43,
          "start": 133.59,
          "end": 137.16,
          "en": "And here we could then have our game turns",
          "zh": ""
        },
        {
          "id": 44,
          "start": 137.16,
          "end": 140.373,
          "en": "and a set game turns function.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 141.78,
          "end": 144.6,
          "en": "And now whenever a square was selected,",
          "zh": ""
        },
        {
          "id": 46,
          "start": 144.6,
          "end": 147.81,
          "en": "we wanna add a new turn to this array.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 147.81,
          "end": 148.98,
          "en": "Now conveniently,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 148.98,
          "end": 152.04,
          "en": "we got this handle select square function here,",
          "zh": ""
        },
        {
          "id": 49,
          "start": 152.04,
          "end": 155.31,
          "en": "so therefore in there we can call \"setGameTurns.\"",
          "zh": ""
        },
        {
          "id": 50,
          "start": 155.31,
          "end": 157.26,
          "en": "And now we just need some information",
          "zh": ""
        },
        {
          "id": 51,
          "start": 157.26,
          "end": 159.78,
          "en": "about the turn that took place.",
          "zh": ""
        },
        {
          "id": 52,
          "start": 159.78,
          "end": 163.44,
          "en": "But before we make sure that this information gets here",
          "zh": ""
        },
        {
          "id": 53,
          "start": 163.44,
          "end": 165.63,
          "en": "let's pause for a second.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 165.63,
          "end": 168.39,
          "en": "Does this approach make sense?",
          "zh": ""
        },
        {
          "id": 55,
          "start": 168.39,
          "end": 171.99,
          "en": "Because after all, we also got another place",
          "zh": ""
        },
        {
          "id": 56,
          "start": 171.99,
          "end": 175.29,
          "en": "where we're storing information about the turns",
          "zh": ""
        },
        {
          "id": 57,
          "start": 175.29,
          "end": 178.14,
          "en": "that already took place, at least in some way.",
          "zh": ""
        },
        {
          "id": 58,
          "start": 178.14,
          "end": 180.63,
          "en": "And that's the game board component.",
          "zh": ""
        },
        {
          "id": 59,
          "start": 180.63,
          "end": 183.63,
          "en": "Here we are updating our game board",
          "zh": ""
        },
        {
          "id": 60,
          "start": 183.63,
          "end": 186.63,
          "en": "and we do that for every click on a button.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 186.63,
          "end": 190.89,
          "en": "So of course with that game board, we are in the end",
          "zh": ""
        },
        {
          "id": 62,
          "start": 190.89,
          "end": 194.64,
          "en": "reflecting the different turns that took place.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 194.64,
          "end": 197.94,
          "en": "We just don't know in which order they were clicked",
          "zh": ""
        },
        {
          "id": 64,
          "start": 197.94,
          "end": 200.4,
          "en": "but we know that this button was clicked,",
          "zh": ""
        },
        {
          "id": 65,
          "start": 200.4,
          "end": 202.02,
          "en": "and this button was clicked,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 202.02,
          "end": 205.38,
          "en": "and we know which player clicked which button.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 205.38,
          "end": 207.93,
          "en": "So we already got a lot of information",
          "zh": ""
        },
        {
          "id": 68,
          "start": 207.93,
          "end": 210.213,
          "en": "stored in this state here.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 211.89,
          "end": 216.89,
          "en": "And adding a new state to store kind of the same information",
          "zh": ""
        },
        {
          "id": 70,
          "start": 216.96,
          "end": 219.96,
          "en": "just with a little bit of extra data",
          "zh": ""
        },
        {
          "id": 71,
          "start": 219.96,
          "end": 224.96,
          "en": "is something you typically wanna avoid as a React developer.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 225.45,
          "end": 227.88,
          "en": "And that will not always be easy",
          "zh": ""
        },
        {
          "id": 73,
          "start": 227.88,
          "end": 230.31,
          "en": "and will also require some practice.",
          "zh": ""
        },
        {
          "id": 74,
          "start": 230.31,
          "end": 232.2,
          "en": "And it's also not the end of the world",
          "zh": ""
        },
        {
          "id": 75,
          "start": 232.2,
          "end": 236.28,
          "en": "if you start managing the same data with multiple states",
          "zh": ""
        },
        {
          "id": 76,
          "start": 236.28,
          "end": 238.86,
          "en": "but it is something you typically wanna avoid",
          "zh": ""
        },
        {
          "id": 77,
          "start": 238.86,
          "end": 242.16,
          "en": "and therefore we are going to avoid it here.",
          "zh": ""
        },
        {
          "id": 78,
          "start": 242.16,
          "end": 244.26,
          "en": "So instead of adding this state",
          "zh": ""
        },
        {
          "id": 79,
          "start": 244.26,
          "end": 246.84,
          "en": "and having this game board state here,",
          "zh": ""
        },
        {
          "id": 80,
          "start": 246.84,
          "end": 250.44,
          "en": "it makes more sense to lift that state",
          "zh": ""
        },
        {
          "id": 81,
          "start": 250.44,
          "end": 253.56,
          "en": "that manages the current information",
          "zh": ""
        },
        {
          "id": 82,
          "start": 253.56,
          "end": 256.23,
          "en": "about the progress of our game",
          "zh": ""
        },
        {
          "id": 83,
          "start": 256.23,
          "end": 261.09,
          "en": "up from the game board component to the app component.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 261.09,
          "end": 263.43,
          "en": "Because again, it's this app component",
          "zh": ""
        },
        {
          "id": 85,
          "start": 263.43,
          "end": 266.34,
          "en": "that then has access to both the log,",
          "zh": ""
        },
        {
          "id": 86,
          "start": 266.34,
          "end": 268.35,
          "en": "which needs this information,",
          "zh": ""
        },
        {
          "id": 87,
          "start": 268.35,
          "end": 271.56,
          "en": "and to the game board component which also needs information",
          "zh": ""
        },
        {
          "id": 88,
          "start": 271.56,
          "end": 273.93,
          "en": "about the current state of the game.",
          "zh": ""
        },
        {
          "id": 89,
          "start": 273.93,
          "end": 277.92,
          "en": "It is however, now not the game board state",
          "zh": ""
        },
        {
          "id": 90,
          "start": 277.92,
          "end": 279.36,
          "en": "that I wanna lift up",
          "zh": ""
        },
        {
          "id": 91,
          "start": 279.36,
          "end": 282.33,
          "en": "because that state is missing information",
          "zh": ""
        },
        {
          "id": 92,
          "start": 282.33,
          "end": 286.02,
          "en": "about the order in which these buttons were clicked",
          "zh": ""
        },
        {
          "id": 93,
          "start": 286.02,
          "end": 288.603,
          "en": "which is important information for the lock.",
          "zh": ""
        },
        {
          "id": 94,
          "start": 289.65,
          "end": 293.15999999999997,
          "en": "And I'll therefore comment out this game board state here.",
          "zh": ""
        },
        {
          "id": 95,
          "start": 293.15999999999997,
          "end": 294.51,
          "en": "We could also delete it,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 294.51,
          "end": 296.64300000000003,
          "en": "but I'll keep it here for reference.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 297.57,
          "end": 302.34,
          "en": "And I'll instead switch to this game turns state here.",
          "zh": ""
        },
        {
          "id": 98,
          "start": 302.34,
          "end": 307.11,
          "en": "Because as you will see, we can manage this information",
          "zh": ""
        },
        {
          "id": 99,
          "start": 307.11,
          "end": 310.08,
          "en": "about these different button clicks as a list",
          "zh": ""
        },
        {
          "id": 100,
          "start": 310.08,
          "end": 314.46,
          "en": "and then derive both the information we need for the log",
          "zh": ""
        },
        {
          "id": 101,
          "start": 314.46,
          "end": 317.94,
          "en": "as well as the information we need for the game board",
          "zh": ""
        },
        {
          "id": 102,
          "start": 317.94,
          "end": 320.64300000000003,
          "en": "from such an array of game turns.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}