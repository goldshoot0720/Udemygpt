{
  "version": 1,
  "courseId": 1362070,
  "sourceLanguage": "en",
  "targetLanguage": "zh-TW",
  "lectures": [
    {
      "id": "39836198",
      "title": "Using the React DevTools (Browser Extension)",
      "sourceHash": "e9e05d4e514c1174ba2ba03f9c18c65c98e1f93736c5d4ac08eacdb8730e087c",
      "cues": [
        {
          "id": 1,
          "start": 0.57,
          "end": 3.33,
          "en": "Now last but not least in this section,",
          "zh": ""
        },
        {
          "id": 2,
          "start": 3.33,
          "end": 6.63,
          "en": "I wanna introduce you to an extra extension",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.63,
          "end": 9.27,
          "en": "you can install into your browser",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.27,
          "end": 13.53,
          "en": "to also make your life as a React developer a bit easier.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 13.53,
          "end": 15.54,
          "en": "And that extension can be found",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.54,
          "end": 18.45,
          "en": "if you search for React devtools.",
          "zh": ""
        },
        {
          "id": 7,
          "start": 18.45,
          "end": 21.57,
          "en": "Because it's this React Developer Tools extension",
          "zh": ""
        },
        {
          "id": 8,
          "start": 21.57,
          "end": 23.043,
          "en": "I wanna introduce you to.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 24.12,
          "end": 25.95,
          "en": "Now, if you don't have that extension yet,",
          "zh": ""
        },
        {
          "id": 10,
          "start": 25.95,
          "end": 29.46,
          "en": "you'll find an install button here right on this page,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 29.46,
          "end": 31.38,
          "en": "which will add it to your browser,",
          "zh": ""
        },
        {
          "id": 12,
          "start": 31.38,
          "end": 33.96,
          "en": "to the Chrome browser here.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 33.96,
          "end": 36.21,
          "en": "And with that extension added,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 36.21,
          "end": 38.55,
          "en": "if you open your developer tools",
          "zh": ""
        },
        {
          "id": 15,
          "start": 38.55,
          "end": 43.55,
          "en": "in a non-private tab, you'll find two new tabs,",
          "zh": ""
        },
        {
          "id": 16,
          "start": 43.68,
          "end": 48.68,
          "en": "two new pages you can visit in your browser devtools.",
          "zh": ""
        },
        {
          "id": 17,
          "start": 48.69,
          "end": 52.32,
          "en": "Now we'll take a look at this profiler page here",
          "zh": ""
        },
        {
          "id": 18,
          "start": 52.32,
          "end": 54.24,
          "en": "a little bit later in the course,",
          "zh": ""
        },
        {
          "id": 19,
          "start": 54.24,
          "end": 57.78,
          "en": "because this feature of the React Developer Tools",
          "zh": ""
        },
        {
          "id": 20,
          "start": 57.78,
          "end": 61.32,
          "en": "is primarily about finding and fixing",
          "zh": ""
        },
        {
          "id": 21,
          "start": 61.32,
          "end": 64.62,
          "en": "performance issues in your React application,",
          "zh": ""
        },
        {
          "id": 22,
          "start": 64.62,
          "end": 66.48,
          "en": "and we'll therefore take a closer look",
          "zh": ""
        },
        {
          "id": 23,
          "start": 66.48,
          "end": 68.58,
          "en": "at this tab later in the course",
          "zh": ""
        },
        {
          "id": 24,
          "start": 68.58,
          "end": 71.37,
          "en": "when we, in general, take a closer look",
          "zh": ""
        },
        {
          "id": 25,
          "start": 71.37,
          "end": 75.003,
          "en": "at React performance and how to improve and optimize it.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 75.84,
          "end": 77.73,
          "en": "For now, it's this components tab",
          "zh": ""
        },
        {
          "id": 27,
          "start": 77.73,
          "end": 80.16,
          "en": "that's interesting to us instead.",
          "zh": ""
        },
        {
          "id": 28,
          "start": 80.16,
          "end": 84.51,
          "en": "In this tab, you find your applications component tree.",
          "zh": ""
        },
        {
          "id": 29,
          "start": 84.51,
          "end": 87.45,
          "en": "So the app component with the header, user input,",
          "zh": ""
        },
        {
          "id": 30,
          "start": 87.45,
          "end": 89.82300000000001,
          "en": "and results components as children.",
          "zh": ""
        },
        {
          "id": 31,
          "start": 90.72,
          "end": 93.3,
          "en": "And if you hover over one of these components,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 93.3,
          "end": 95.85,
          "en": "it's also highlighted on the left.",
          "zh": ""
        },
        {
          "id": 33,
          "start": 95.85,
          "end": 100.2,
          "en": "So you quickly see which part of the UI is controlled",
          "zh": ""
        },
        {
          "id": 34,
          "start": 100.2,
          "end": 102.6,
          "en": "and rendered by which component,",
          "zh": ""
        },
        {
          "id": 35,
          "start": 102.6,
          "end": 105.50999999999999,
          "en": "which can be very useful for analyzing",
          "zh": ""
        },
        {
          "id": 36,
          "start": 105.50999999999999,
          "end": 108.93,
          "en": "and understanding more complex component trees,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 108.93,
          "end": 111.513,
          "en": "and more complex user interfaces.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 112.74000000000001,
          "end": 114.69,
          "en": "If you click on this gear icon here,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 114.69,
          "end": 116.94,
          "en": "you can also control the appearance",
          "zh": ""
        },
        {
          "id": 40,
          "start": 116.94,
          "end": 118.62,
          "en": "of the developer tools.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 118.62,
          "end": 122.1,
          "en": "For example, the color mode, the display density,",
          "zh": ""
        },
        {
          "id": 42,
          "start": 122.1,
          "end": 124.38,
          "en": "and then also for this components tree,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 124.38,
          "end": 127.86,
          "en": "also if the component tree should be expanded by default,",
          "zh": ""
        },
        {
          "id": 44,
          "start": 127.86,
          "end": 130.14,
          "en": "and a couple of other things as well.",
          "zh": ""
        },
        {
          "id": 45,
          "start": 130.14,
          "end": 132.72,
          "en": "Simply play around with these settings",
          "zh": ""
        },
        {
          "id": 46,
          "start": 132.72,
          "end": 135.57,
          "en": "to get a feeling for what they're doing.",
          "zh": ""
        },
        {
          "id": 47,
          "start": 135.57,
          "end": 138.54,
          "en": "But if you now click on one of those components,",
          "zh": ""
        },
        {
          "id": 48,
          "start": 138.54,
          "end": 142.23,
          "en": "you also learn more about that component.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 142.23,
          "end": 146.94,
          "en": "For example, you also see which props a component accepts,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 146.94,
          "end": 150.63,
          "en": "and which type of prop values you're getting there.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 150.63,
          "end": 153.06,
          "en": "For example, that the user input component",
          "zh": ""
        },
        {
          "id": 52,
          "start": 153.06,
          "end": 154.95,
          "en": "accepts an on change prop,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 154.95,
          "end": 159.3,
          "en": "which is a function, the handle change function.",
          "zh": ""
        },
        {
          "id": 54,
          "start": 159.3,
          "end": 161.31,
          "en": "Whereas user input on the other hand",
          "zh": ""
        },
        {
          "id": 55,
          "start": 161.31,
          "end": 164.88,
          "en": "is an object with the following properties.",
          "zh": ""
        },
        {
          "id": 56,
          "start": 164.88,
          "end": 167.88,
          "en": "And you can even edit those properties",
          "zh": ""
        },
        {
          "id": 57,
          "start": 167.88,
          "end": 170.94,
          "en": "and see those changes reflected in the UI,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 170.94,
          "end": 174.21,
          "en": "in case you wanna play around with those values,",
          "zh": ""
        },
        {
          "id": 59,
          "start": 174.21,
          "end": 176.55,
          "en": "and simply see how different values",
          "zh": ""
        },
        {
          "id": 60,
          "start": 176.55,
          "end": 178.473,
          "en": "lead to different results.",
          "zh": ""
        },
        {
          "id": 61,
          "start": 180.3,
          "end": 184.68,
          "en": "If a component manages state, like the app component,",
          "zh": ""
        },
        {
          "id": 62,
          "start": 184.68,
          "end": 188.58,
          "en": "you will also see that here under hooks.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 188.58,
          "end": 190.74,
          "en": "There, you see that the app component",
          "zh": ""
        },
        {
          "id": 64,
          "start": 190.74,
          "end": 193.71,
          "en": "in this app uses the use state hook",
          "zh": ""
        },
        {
          "id": 65,
          "start": 193.71,
          "end": 197.46,
          "en": "to create one state, one state value,",
          "zh": ""
        },
        {
          "id": 66,
          "start": 197.46,
          "end": 200.28,
          "en": "and you can also edit that state value here.",
          "zh": ""
        },
        {
          "id": 67,
          "start": 200.28,
          "end": 203.28,
          "en": "For example, I could change the duration to 12 here,",
          "zh": ""
        },
        {
          "id": 68,
          "start": 203.28,
          "end": 206.403,
          "en": "and see how that is reflected in the UI.",
          "zh": ""
        },
        {
          "id": 69,
          "start": 207.63,
          "end": 210.36,
          "en": "And therefore, this components tab here",
          "zh": ""
        },
        {
          "id": 70,
          "start": 210.36,
          "end": 213.84,
          "en": "in the React devtools is a great place",
          "zh": ""
        },
        {
          "id": 71,
          "start": 213.84,
          "end": 218.84,
          "en": "to quickly understand how your component tree looks like,",
          "zh": ""
        },
        {
          "id": 72,
          "start": 219.15,
          "end": 223.74,
          "en": "which part of the UI is controlled by which component,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 223.74,
          "end": 227.82,
          "en": "and you can also use it to edit your component tree,",
          "zh": ""
        },
        {
          "id": 74,
          "start": 227.82,
          "end": 231.36,
          "en": "and quickly get a feeling for how changes",
          "zh": ""
        },
        {
          "id": 75,
          "start": 231.36,
          "end": 235.173,
          "en": "to props or a state might be reflected on the UI.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}