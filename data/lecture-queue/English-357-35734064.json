  "lectures": [
    {
      "id": "35734064",
      "title": "Validating User Input & Outputting Validation Errors",
      "sourceHash": "f1f6b88d149f27a7f5448f02a87dc687a00ac8d31ddbd3db2885bab042c1d8d5",
      "cues": [
        {
          "id": 1,
          "start": 2.4,
          "end": 5.07,
          "en": "Now when we had a look at this back-end code",
          "zh": ""
        },
        {
          "id": 2,
          "start": 5.07,
          "end": 7.77,
          "en": "before when I added this timeout code,",
          "zh": ""
        },
        {
          "id": 3,
          "start": 7.77,
          "end": 11.37,
          "en": "this delay, I also mentioned that I do validate",
          "zh": ""
        },
        {
          "id": 4,
          "start": 11.37,
          "end": 14.82,
          "en": "the user input here on the back-end.",
          "zh": ""
        },
        {
          "id": 5,
          "start": 14.82,
          "end": 17.37,
          "en": "And I of course have this validation code",
          "zh": ""
        },
        {
          "id": 6,
          "start": 17.37,
          "end": 21.21,
          "en": "so that no incorrect data gets stored in my database",
          "zh": ""
        },
        {
          "id": 7,
          "start": 21.21,
          "end": 24.093,
          "en": "or in this case, in this file, which I'm using here.",
          "zh": ""
        },
        {
          "id": 8,
          "start": 25.44,
          "end": 28.38,
          "en": "Now I also have some validation on the front-end.",
          "zh": ""
        },
        {
          "id": 9,
          "start": 28.38,
          "end": 30.24,
          "en": "On my forum inputs here",
          "zh": ""
        },
        {
          "id": 10,
          "start": 30.24,
          "end": 33.39,
          "en": "I have these default HTML attributes,",
          "zh": ""
        },
        {
          "id": 11,
          "start": 33.39,
          "end": 36,
          "en": "which in this case ensure that I can't submit",
          "zh": ""
        },
        {
          "id": 12,
          "start": 36,
          "end": 38.19,
          "en": "empty input values.",
          "zh": ""
        },
        {
          "id": 13,
          "start": 38.19,
          "end": 42.15,
          "en": "But you should never rely on just client side validation,",
          "zh": ""
        },
        {
          "id": 14,
          "start": 42.15,
          "end": 44.79,
          "en": "you should always have server side validation",
          "zh": ""
        },
        {
          "id": 15,
          "start": 44.79,
          "end": 47.49,
          "en": "because client side validation can, for example",
          "zh": ""
        },
        {
          "id": 16,
          "start": 47.49,
          "end": 50.76,
          "en": "be turned off and disabled with the dev tools,",
          "zh": ""
        },
        {
          "id": 17,
          "start": 50.76,
          "end": 52.503,
          "en": "with the browser dev tools.",
          "zh": ""
        },
        {
          "id": 18,
          "start": 53.4,
          "end": 54.99,
          "en": "Nonetheless, it's good to have both",
          "zh": ""
        },
        {
          "id": 19,
          "start": 54.99,
          "end": 57.48,
          "en": "to provide a good user experience.",
          "zh": ""
        },
        {
          "id": 20,
          "start": 57.48,
          "end": 60,
          "en": "But I of course want to show the user",
          "zh": ""
        },
        {
          "id": 21,
          "start": 60,
          "end": 62.79,
          "en": "any errors, any validation errors",
          "zh": ""
        },
        {
          "id": 22,
          "start": 62.79,
          "end": 64.62,
          "en": "that I gathered on the back-end",
          "zh": ""
        },
        {
          "id": 23,
          "start": 64.62,
          "end": 68.49,
          "en": "in case some validation errors were detected here.",
          "zh": ""
        },
        {
          "id": 24,
          "start": 68.49,
          "end": 70.65,
          "en": "For example, because the user did",
          "zh": ""
        },
        {
          "id": 25,
          "start": 70.65,
          "end": 72.783,
          "en": "disable client side validation.",
          "zh": ""
        },
        {
          "id": 26,
          "start": 73.83,
          "end": 77.01,
          "en": "And to do that, I wanna leverage the fact",
          "zh": ""
        },
        {
          "id": 27,
          "start": 77.01,
          "end": 81.75,
          "en": "that on the back-end I'm sending back an error response",
          "zh": ""
        },
        {
          "id": 28,
          "start": 81.75,
          "end": 85.05,
          "en": "with status code 422 if I found",
          "zh": ""
        },
        {
          "id": 29,
          "start": 85.05,
          "end": 86.973,
          "en": "some validation errors there.",
          "zh": ""
        },
        {
          "id": 30,
          "start": 87.84,
          "end": 89.7,
          "en": "On the front-end,",
          "zh": ""
        },
        {
          "id": 31,
          "start": 89.7,
          "end": 93,
          "en": "in the new event page component file here,",
          "zh": ""
        },
        {
          "id": 32,
          "start": 93,
          "end": 94.8,
          "en": "for example, in this action",
          "zh": ""
        },
        {
          "id": 33,
          "start": 94.8,
          "end": 96.81,
          "en": "where I do submit to the data,",
          "zh": ""
        },
        {
          "id": 34,
          "start": 96.81,
          "end": 101.81,
          "en": "I wanna react to such potential back-end validation errors.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 102.45,
          "end": 107.43,
          "en": "And I wanna react by not showing my default error page",
          "zh": ""
        },
        {
          "id": 36,
          "start": 107.43,
          "end": 111.3,
          "en": "so I don't want to throw an error response,",
          "zh": ""
        },
        {
          "id": 37,
          "start": 111.3,
          "end": 114.96000000000001,
          "en": "but instead I wanna show such validation errors here",
          "zh": ""
        },
        {
          "id": 38,
          "start": 114.96000000000001,
          "end": 118.59,
          "en": "right above this form because that makes more sense",
          "zh": ""
        },
        {
          "id": 39,
          "start": 118.59,
          "end": 120.33,
          "en": "than showing an error page",
          "zh": ""
        },
        {
          "id": 40,
          "start": 120.33,
          "end": 123.21,
          "en": "because that would discard all the values entered",
          "zh": ""
        },
        {
          "id": 41,
          "start": 123.21,
          "end": 127.263,
          "en": "by the user and not really offer a good user experience.",
          "zh": ""
        },
        {
          "id": 42,
          "start": 128.91,
          "end": 130.98,
          "en": "Therefore, I wanna stay on this page,",
          "zh": ""
        },
        {
          "id": 43,
          "start": 130.98,
          "end": 133.56,
          "en": "but I wanna output some data.",
          "zh": ""
        },
        {
          "id": 44,
          "start": 133.56,
          "end": 138,
          "en": "And you can easily do this in actions by returning the data",
          "zh": ""
        },
        {
          "id": 45,
          "start": 138,
          "end": 142.923,
          "en": "you wanna output above the forum or anywhere in your routes.",
          "zh": ""
        },
        {
          "id": 46,
          "start": 144.06,
          "end": 147.54,
          "en": "For that, I will simply check if my response status code",
          "zh": ""
        },
        {
          "id": 47,
          "start": 147.54,
          "end": 151.23,
          "en": "is equal to 422, which is that validation status code",
          "zh": ""
        },
        {
          "id": 48,
          "start": 151.23,
          "end": 155.64,
          "en": "I'm setting on the back-end in case of validation errors.",
          "zh": ""
        },
        {
          "id": 49,
          "start": 155.64,
          "end": 158.61,
          "en": "And if I have that status code,",
          "zh": ""
        },
        {
          "id": 50,
          "start": 158.61,
          "end": 163.17000000000002,
          "en": "then I want to return my response.",
          "zh": ""
        },
        {
          "id": 51,
          "start": 163.17000000000002,
          "end": 165.78,
          "en": "So I'm not returning and redirecting,",
          "zh": ""
        },
        {
          "id": 52,
          "start": 165.78,
          "end": 168.39,
          "en": "and I'm not throwing an error response,",
          "zh": ""
        },
        {
          "id": 53,
          "start": 168.39,
          "end": 171.9,
          "en": "but I'm returning the response I got back from the back-end",
          "zh": ""
        },
        {
          "id": 54,
          "start": 171.9,
          "end": 176.613,
          "en": "if I have this 422 status code on the response.",
          "zh": ""
        },
        {
          "id": 55,
          "start": 177.51,
          "end": 180.903,
          "en": "Now what does returning a response in an action due though?",
          "zh": ""
        },
        {
          "id": 56,
          "start": 181.74,
          "end": 185.19,
          "en": "Well, just as we can return responses in loaders",
          "zh": ""
        },
        {
          "id": 57,
          "start": 185.19,
          "end": 189.57,
          "en": "and then use the response data in our components and pages,",
          "zh": ""
        },
        {
          "id": 58,
          "start": 189.57,
          "end": 192.51,
          "en": "we can also use returned action data",
          "zh": ""
        },
        {
          "id": 59,
          "start": 192.51,
          "end": 195.39,
          "en": "in our pages and components.",
          "zh": ""
        },
        {
          "id": 60,
          "start": 195.39,
          "end": 198.03,
          "en": "It's just less common but it's very common",
          "zh": ""
        },
        {
          "id": 61,
          "start": 198.03,
          "end": 201.51,
          "en": "for such validation error responses",
          "zh": ""
        },
        {
          "id": 62,
          "start": 201.51,
          "end": 204.93,
          "en": "where you don't wanna show an error page.",
          "zh": ""
        },
        {
          "id": 63,
          "start": 204.93,
          "end": 208.07999999999998,
          "en": "We can go to the event form component,",
          "zh": ""
        },
        {
          "id": 64,
          "start": 208.07999999999998,
          "end": 209.61,
          "en": "which is in the end rendered",
          "zh": ""
        },
        {
          "id": 65,
          "start": 209.61,
          "end": 213.54,
          "en": "by the new event page component here.",
          "zh": ""
        },
        {
          "id": 66,
          "start": 213.54,
          "end": 215.52,
          "en": "And in that event form component",
          "zh": ""
        },
        {
          "id": 67,
          "start": 215.52,
          "end": 219.3,
          "en": "I can use another provided by a react-router-dom.",
          "zh": ""
        },
        {
          "id": 68,
          "start": 219.3,
          "end": 222.57,
          "en": "And that's the use action data hook,",
          "zh": ""
        },
        {
          "id": 69,
          "start": 222.57,
          "end": 225.45,
          "en": "which almost sounds like use loader data,",
          "zh": ""
        },
        {
          "id": 70,
          "start": 225.45,
          "end": 227.64,
          "en": "which is no coincidence because it does",
          "zh": ""
        },
        {
          "id": 71,
          "start": 227.64,
          "end": 229.77,
          "en": "basically the same thing.",
          "zh": ""
        },
        {
          "id": 72,
          "start": 229.77,
          "end": 233.82,
          "en": "It gives us access to the data returned by our action,",
          "zh": ""
        },
        {
          "id": 73,
          "start": 233.82,
          "end": 237.09,
          "en": "in this case, not by the loader, but by the action",
          "zh": ""
        },
        {
          "id": 74,
          "start": 237.09,
          "end": 240.6,
          "en": "and it gives us access to the closest action.",
          "zh": ""
        },
        {
          "id": 75,
          "start": 240.6,
          "end": 242.79,
          "en": "So I can use this in this component here",
          "zh": ""
        },
        {
          "id": 76,
          "start": 242.79,
          "end": 244.89,
          "en": "even though it's not the page component",
          "zh": ""
        },
        {
          "id": 77,
          "start": 244.89,
          "end": 247.41,
          "en": "because it's rendered by the page component",
          "zh": ""
        },
        {
          "id": 78,
          "start": 247.41,
          "end": 249.45,
          "en": "for which this action was defined",
          "zh": ""
        },
        {
          "id": 79,
          "start": 249.45,
          "end": 251.793,
          "en": "where I return that response.",
          "zh": ""
        },
        {
          "id": 80,
          "start": 253.41,
          "end": 258.3,
          "en": "So with that, in event form, I get this data object here",
          "zh": ""
        },
        {
          "id": 81,
          "start": 258.3,
          "end": 261.15,
          "en": "and if I return a response in an action",
          "zh": ""
        },
        {
          "id": 82,
          "start": 261.15,
          "end": 263.55,
          "en": "this response is automatically parsed",
          "zh": ""
        },
        {
          "id": 83,
          "start": 263.55,
          "end": 268.55,
          "en": "by React router for me, just as it is the case for loaders.",
          "zh": ""
        },
        {
          "id": 84,
          "start": 268.59,
          "end": 272.04,
          "en": "And therefore here, this data is the data I return",
          "zh": ""
        },
        {
          "id": 85,
          "start": 272.04,
          "end": 275.94,
          "en": "on my back-end in case of validation errors.",
          "zh": ""
        },
        {
          "id": 86,
          "start": 275.94,
          "end": 279.21,
          "en": "And that would be an object with a general message",
          "zh": ""
        },
        {
          "id": 87,
          "start": 279.21,
          "end": 283.8,
          "en": "and a nested errors object, which has different keys",
          "zh": ""
        },
        {
          "id": 88,
          "start": 283.8,
          "end": 288.24,
          "en": "for the different inputs with more detailed error messages,",
          "zh": ""
        },
        {
          "id": 89,
          "start": 288.24,
          "end": 289.79,
          "en": "if you wanna call it like this.",
          "zh": ""
        },
        {
          "id": 90,
          "start": 290.90999999999997,
          "end": 293.49,
          "en": "So therefore, here in event form",
          "zh": ""
        },
        {
          "id": 91,
          "start": 293.49,
          "end": 295.71,
          "en": "inside of my form, for example,",
          "zh": ""
        },
        {
          "id": 92,
          "start": 295.71,
          "end": 297.84000000000003,
          "en": "I could check if data is set",
          "zh": ""
        },
        {
          "id": 93,
          "start": 297.84000000000003,
          "end": 300.33,
          "en": "because it will not be set if we haven't submitted",
          "zh": ""
        },
        {
          "id": 94,
          "start": 300.33,
          "end": 301.92,
          "en": "the form yet, for example",
          "zh": ""
        },
        {
          "id": 95,
          "start": 301.92,
          "end": 304.5,
          "en": "because that data is coming from an action,",
          "zh": ""
        },
        {
          "id": 96,
          "start": 304.5,
          "end": 307.14,
          "en": "you must not forget this.",
          "zh": ""
        },
        {
          "id": 97,
          "start": 307.14,
          "end": 309.87,
          "en": "So I check if I have data, if I submitted the form",
          "zh": ""
        },
        {
          "id": 98,
          "start": 309.87,
          "end": 312.15,
          "en": "and the action returns some data.",
          "zh": ""
        },
        {
          "id": 99,
          "start": 312.15,
          "end": 315.81,
          "en": "And then I check if I have this errors object,",
          "zh": ""
        },
        {
          "id": 100,
          "start": 315.81,
          "end": 319.05,
          "en": "this nested errors object on my data.",
          "zh": ""
        },
        {
          "id": 101,
          "start": 319.05,
          "end": 323.17,
          "en": "In which case I want to return or output an unordered list",
          "zh": ""
        },
        {
          "id": 102,
          "start": 324.75,
          "end": 328.77,
          "en": "where I then use Object.values,",
          "zh": ""
        },
        {
          "id": 103,
          "start": 328.77,
          "end": 333.39,
          "en": "a function built into JavaScript to basically loop",
          "zh": ""
        },
        {
          "id": 104,
          "start": 333.39,
          "end": 336.65999999999997,
          "en": "through all my keys in this errors object",
          "zh": ""
        },
        {
          "id": 105,
          "start": 336.65999999999997,
          "end": 339.51,
          "en": "and map my data here,",
          "zh": ""
        },
        {
          "id": 106,
          "start": 339.51,
          "end": 342.15999999999997,
          "en": "the data that's stored for these different keys",
          "zh": ""
        },
        {
          "id": 107,
          "start": 343.8,
          "end": 345.39300000000003,
          "en": "to list items.",
          "zh": ""
        },
        {
          "id": 108,
          "start": 347.31,
          "end": 349.77,
          "en": "Every list item receives the special key prop",
          "zh": ""
        },
        {
          "id": 109,
          "start": 349.77,
          "end": 353.52,
          "en": "which is expected by React, and I set it equal",
          "zh": ""
        },
        {
          "id": 110,
          "start": 353.52,
          "end": 355.62,
          "en": "to the error message I'm having here,",
          "zh": ""
        },
        {
          "id": 111,
          "start": 355.62,
          "end": 357.903,
          "en": "and I output the error message.",
          "zh": ""
        },
        {
          "id": 112,
          "start": 360,
          "end": 362.85,
          "en": "So that's how I'm outputting these validation errors",
          "zh": ""
        },
        {
          "id": 113,
          "start": 362.85,
          "end": 365.04,
          "en": "I could be getting from the back-end.",
          "zh": ""
        },
        {
          "id": 114,
          "start": 365.04,
          "end": 367.2,
          "en": "And to show you how this works",
          "zh": ""
        },
        {
          "id": 115,
          "start": 367.2,
          "end": 370.203,
          "en": "I will submit this form without any values entered.",
          "zh": ""
        },
        {
          "id": 116,
          "start": 371.07,
          "end": 374.04,
          "en": "For that, I'll first of all inspect it in my dev tools",
          "zh": ""
        },
        {
          "id": 117,
          "start": 374.04,
          "end": 376.35,
          "en": "and remove these special attributes",
          "zh": ""
        },
        {
          "id": 118,
          "start": 376.35,
          "end": 378.33,
          "en": "that would normally prevent me",
          "zh": ""
        },
        {
          "id": 119,
          "start": 378.33,
          "end": 381.69,
          "en": "from submitting invalid values.",
          "zh": ""
        },
        {
          "id": 120,
          "start": 381.69,
          "end": 385.23,
          "en": "If I disable it like this, I will be able to submit the form",
          "zh": ""
        },
        {
          "id": 121,
          "start": 385.23,
          "end": 387.81,
          "en": "without having entered correct values.",
          "zh": ""
        },
        {
          "id": 122,
          "start": 387.81,
          "end": 391.053,
          "en": "So that's what I'm doing here for all these inputs.",
          "zh": ""
        },
        {
          "id": 123,
          "start": 392.04,
          "end": 393.81,
          "en": "And now if I click Save,",
          "zh": ""
        },
        {
          "id": 124,
          "start": 393.81,
          "end": 398.46,
          "en": "you see that here I'm getting these error messages",
          "zh": ""
        },
        {
          "id": 125,
          "start": 398.46,
          "end": 400.29,
          "en": "and that's coming from my action",
          "zh": ""
        },
        {
          "id": 126,
          "start": 400.29,
          "end": 402.12,
          "en": "where I return that response",
          "zh": ""
        },
        {
          "id": 127,
          "start": 402.12,
          "end": 403.95,
          "en": "which I'm getting from the back-end,",
          "zh": ""
        },
        {
          "id": 128,
          "start": 403.95,
          "end": 406.47,
          "en": "and I'm then picking up that return data",
          "zh": ""
        },
        {
          "id": 129,
          "start": 406.47,
          "end": 409.44,
          "en": "from the action with help of use action data,",
          "zh": ""
        },
        {
          "id": 130,
          "start": 409.44,
          "end": 411.21,
          "en": "and I'm outputting the data",
          "zh": ""
        },
        {
          "id": 131,
          "start": 411.21,
          "end": 415.323,
          "en": "that's part of that return response here in my JSX code.",
          "zh": ""
        }
      ]
    }
  ],
  "errors": []
}