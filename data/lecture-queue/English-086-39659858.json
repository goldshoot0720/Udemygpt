          "en": "this game is finished.",
          "zh": ""
        },
        {
          "id": 3,
          "start": 6.27,
          "end": 9.51,
          "en": "Now I just wanna improve the code a little bit,",
          "zh": ""
        },
        {
          "id": 4,
          "start": 9.51,
          "end": 12.78,
          "en": "and to be precise, I wanna improve the code",
          "zh": ""
        },
        {
          "id": 5,
          "start": 12.78,
          "end": 15.72,
          "en": "by cleaning up this app component a little bit",
          "zh": ""
        },
        {
          "id": 6,
          "start": 15.72,
          "end": 18.18,
          "en": "because it contains a lot of logic.",
