        },
        {
          "id": 34,
          "start": 101.22,
          "end": 103.71000000000001,
          "en": "And it's the same idea as before.",
          "zh": ""
        },
        {
          "id": 35,
          "start": 103.71000000000001,
          "end": 106.71000000000001,
          "en": "So here, outside the component function,",
