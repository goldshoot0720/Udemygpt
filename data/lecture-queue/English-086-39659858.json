        },
        {
          "id": 37,
          "start": 110.7,
          "end": 112.59,
          "en": "that would also be possible.",
          "zh": ""
        },
        {
          "id": 38,
          "start": 112.59,
          "end": 115.35,
          "en": "It doesn't have to be in that file here,",
          "zh": ""
        },
        {
          "id": 39,
          "start": 115.35,
          "end": 118.77000000000001,
          "en": "but here I'll keep these things together in the same file",
          "zh": ""
        },
        {
          "id": 40,
          "start": 118.77000000000001,
          "end": 121.23,
          "en": "since they are closely related.",
          "zh": ""
        },
        {
          "id": 41,
          "start": 121.23,
          "end": 124.893,
