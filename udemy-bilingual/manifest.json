{
  "manifest_version": 3,
  "name": "Udemy 中英雙語特效字幕",
  "version": "2.5.0",
  "description": "React、Flutter、Node.js、React Native、CSS、Svelte、NativeScript、Remix、Angular、Next.js、Vue、Ionic、JavaScript：台灣繁體中文＋英文同步字幕。",
  "browser_specific_settings": {
    "gecko": {
      "id": "udemy-bilingual@local.personal",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "export.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "https://www.udemy.com/*",
    "https://*.udemycdn.com/*",
    "https://udemy-captions.s3.amazonaws.com/*"
  ],
  "background": {
    "scripts": [
      "courses.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.udemy.com/course/react-the-complete-guide-incl-redux/learn/*",
        "https://www.udemy.com/course/learn-flutter-dart-to-build-ios-android-apps/learn/*",
        "https://www.udemy.com/course/nodejs-the-complete-guide/learn/*",
        "https://www.udemy.com/course/react-native-the-practical-guide/learn/*",
        "https://www.udemy.com/course/css-the-complete-guide-incl-flexbox-grid-sass/learn/*",
        "https://www.udemy.com/course/sveltejs-the-complete-guide/learn/*",
        "https://www.udemy.com/course/nativescript-angular-build-native-ios-android-web-apps/learn/*",
        "https://www.udemy.com/course/remix-course/learn/*",
        "https://www.udemy.com/course/the-complete-guide-to-angular-2/learn/*",
        "https://www.udemy.com/course/nextjs-react-the-complete-guide/learn/*",
        "https://www.udemy.com/course/vuejs-2-the-complete-guide/learn/*",
        "https://www.udemy.com/course/ionic-2-the-practical-guide-to-building-ios-android-apps/learn/*",
        "https://www.udemy.com/course/javascript-the-complete-guide-2020-beginner-advanced/learn/*"
      ],
      "js": [
        "vendor/opencc.js",
        "subtitle-core.js",
        "courses.js",
        "course-time.js",
        "export-panel.js",
        "export.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
