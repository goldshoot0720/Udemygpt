{
  "manifest_version": 3,
  "name": "Udemy 中英雙語特效字幕",
  "version": "2.7.3",
  "description": "React、Flutter、Node.js、React Native、CSS、Svelte、NativeScript、Remix、Angular、Next.js、Vue、Ionic、JavaScript、ChatGPT：台灣繁體中文＋英文同步字幕。",
  "browser_specific_settings": {
    "gecko": {
      "id": "udemy-bilingual@local.personal",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "export.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "https://www.udemy.com/*",
    "https://*.udemycdn.com/*",
    "https://udemy-captions.s3.amazonaws.com/*"
  ],
  "background": {
    "scripts": [
      "courses.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.udemy.com/course/*/learn/*"
      ],
      "js": [
        "vendor/opencc.js",
        "subtitle-core.js",
        "courses.js",
        "course-time.js",
        "export-panel.js",
        "export.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
