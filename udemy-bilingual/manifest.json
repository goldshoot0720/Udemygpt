{
  "manifest_version": 3,
  "name": "Udemy 中英雙語特效字幕",
  "version": "2.0.0",
  "description": "React 完整指南：繁體中文＋英文同步字幕、淡入效果、React 關鍵字提示。",
  "browser_specific_settings": {
    "gecko": {
      "id": "udemy-bilingual@local.personal",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.udemy.com/*",
    "https://*.udemycdn.com/*",
    "https://udemy-captions.s3.amazonaws.com/*"
  ],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{
    "matches": ["https://www.udemy.com/course/react-the-complete-guide-incl-redux/learn/*"],
    "js": ["vendor/opencc.js", "subtitle-core.js", "content.js"],
    "run_at": "document_idle"
  }]
}
