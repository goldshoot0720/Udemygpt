{
  "manifest_version": 3,
  "name": "Udemy 中英雙語特效字幕",
  "version": "2.1.0",
  "description": "React、Claude Code、Codex、Flutter、Node.js、React Native、CSS：台灣繁體中文＋英文同步字幕。",
  "browser_specific_settings": {
    "gecko": {
      "id": "udemy-bilingual@local.personal",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.udemy.com/*",
    "https://*.udemycdn.com/*",
    "https://udemy-captions.s3.amazonaws.com/*"
  ],
  "background": { "scripts": ["courses.js", "background.js"] },
  "content_scripts": [{
    "matches": [
      "https://www.udemy.com/course/react-the-complete-guide-incl-redux/learn/*",
      "https://www.udemy.com/course/claude-code-the-practical-guide/learn/*",
      "https://www.udemy.com/course/codex-the-practical-guide/learn/*",
      "https://www.udemy.com/course/learn-flutter-dart-to-build-ios-android-apps/learn/*",
      "https://www.udemy.com/course/nodejs-the-complete-guide/learn/*",
      "https://www.udemy.com/course/react-native-the-practical-guide/learn/*",
      "https://www.udemy.com/course/css-the-complete-guide-incl-flexbox-grid-sass/learn/*"
    ],
    "js": ["vendor/opencc.js", "subtitle-core.js", "courses.js", "content.js"],
    "run_at": "document_idle"
  }]
}
